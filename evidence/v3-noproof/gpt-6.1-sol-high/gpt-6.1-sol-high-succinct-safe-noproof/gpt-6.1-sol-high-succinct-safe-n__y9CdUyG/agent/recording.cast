[485.866754, "o", "\u001b[?2004hroot@72ee28273f52:/workspace/challenge# "]
[487.488059, "i", "python3 - <<'PY'\nL8 = 0x0101010101010101\nH8 = 0x8080808080808080\nM16 = 0x00ff00ff00ff00ff\nL16 = 0x0001000100010001\nMASK = (1 << 64) - 1\n\ndef swar_count(x):\n    nz = ((((x | H8) - L8) & MASK) | x) & H8\n    return (((nz >> 7) * L8) & MASK) >> 56\n\ndef swar_sum(x):\n    pairs = (x & M16) + ((x >> 8) & M16)\n    return (((pairs * L16) & MASK) >> 48) & 0xffff\n\ndef model_count(x):\n    return sum(1 for i in range(8) if ((x >> (8*i)) & 0xff) != 0)\n\ndef model_sum(x):\n    return sum((x >> (8*i)) & 0xff for i in range(8))\n\nfor x in range(1 << 16):\n    assert swar_count(x) == model_count(x), (hex(x), swar_count(x), model_count(x))\n    assert swar_sum(x) == model_sum(x), (hex(x), swar_sum(x), model_sum(x))\n\nvalues = [0, 1, 0xff, 0x100, 0x0101010101010101, 0x8080808080808080, 0xffffffffffffffff, 0x8000000000000000, 0x7fffffffffffffff]\nfor x in values:\n    assert swar_count(x) == model_count(x), hex(x)\n    assert swar_sum(x) == model_sum(x), hex(x)\n    assert 0 <= model_count(x) <= 8\n    assert 0 <= model_sum(x) <= 2040\n\nfor amount in [0, 1, 2, (1 << 64) - 1]:\n    debit = amount // 2 + 8 * 256 + 8 * 255\n    assert debit < (1 << 64)\nprint('SWAR/model checks passed')\nPY\n"]
