[351.361658, "i", "cat > /tmp/check_submission.rs <<'EOF'\nextern crate settlement_gate;\n\nfn main() {\n    let balance = 9_223_372_036_854_775_807u64;\n    let amount = u64::MAX;\n    let fee = u64::MAX;\n    assert_eq!(settlement_gate::authorize(balance, amount, fee), None);\n    assert_eq!(\n        settlement_gate::authorize(u64::MAX - 1, amount, fee),\n        Some(settlement_gate::Authorization { total_debit: u64::MAX - 1 })\n    );\n}\nEOF\nrustc --edition=2021 -O /tmp/check_submission.rs --extern settlement_gate=/tmp/libsettlement_gate.rlib -o /tmp/check_submission && /tmp/check_submission\n"]
