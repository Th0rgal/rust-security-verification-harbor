[349.4035, "o", "rustc --edition=2021 --crate-type lib -O /workspace/submission/src/lib.rs -o /tmp/libsettlement_gate.rlib && rustc --edition=2021 --test -O /workspace/submission/src/lib.rs -o /tmp/settlement_gate_tests && /tmp/settlement_gate_tests\r\n\u001b[?2004l\r"]
[349.769297, "o", "\r\nrunning 4 tests\r\n"]
[349.769562, "o", "test tests::clamps_digits_to_radix_minus_one ... \u001b[32mok\u001b[m\u000f\r\ntest tests::maximum_radices_do_not_wrap_the_index ... \u001b[32mok\u001b[m\u000f\r\ntest tests::small_mixed_radix_coordinates_match_policy ... \u001b[32mok\u001b[m\u000f\r\ntest tests::zero_payment_is_authorized ... \u001b[32mok\u001b[m\u000f\r\n"]
[349.769645, "o", "\r\ntest result: \u001b[32mok\u001b[m\u000f. 4 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.00s\r\n\r\n"]
