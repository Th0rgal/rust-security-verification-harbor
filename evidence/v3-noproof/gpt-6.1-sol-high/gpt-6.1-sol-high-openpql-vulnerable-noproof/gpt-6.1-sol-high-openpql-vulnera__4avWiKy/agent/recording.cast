[349.181758, "o", "        let d0: u64 = clamp_digit(a0, b0);\r\n\u001b[?2004l\r"]
[349.181802, "o", "\u001b[?2004h> "]
[349.181959, "o", "        let d1: u64 = clamp_digit(a1, b1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.182148, "o", "        let d2: u64 = clamp_digit(a2, b2);\r\n\u001b[?2004l\r"]
[349.182237, "o", "\u001b[?2004h> "]
[349.182372, "o", "        let d3: u64 = clamp_digit(a3, b3);\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.182415, "o", "> "]
[349.18254, "o", "        let o2: u64 = b3;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.182646, "o", "        let o1: u64 = b2 * o2;\r\n\u001b[?2004l\r"]
[349.182679, "o", "\u001b[?2004h> "]
[349.182825, "o", "        let o0: u64 = b1 * o1;\r\n\u001b[?2004l\r"]
[349.182862, "o", "\u001b[?2004h> "]
[349.183135, "o", "        let raw_idx: u64 = d0 * o0 + d1 * o1 + d2 * o2 + d3;\r\n\u001b[?2004l\r"]
[349.183172, "o", "\u001b[?2004h> "]
[349.183256, "o", "        raw_idx\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.183288, "o", "> "]
[349.183544, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[349.183714, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub mod settlement {\r\n\u001b[?2004l\r\u001b[?2004h>     use crate::mixed_radix;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.183857, "o", "    use crate::Authorization;\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.183896, "o", "> \r\n\u001b[?2004l\r"]
[349.183924, "o", "\u001b[?2004h> "]
[349.184176, "o", "    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.184214, "o", "> "]
[349.184361, "o", "    pub struct OpenPqlQuote {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.184566, "o", "        pub principal_share: u64,\r\n\u001b[?2004l\r"]
[349.184732, "o", "\u001b[?2004h> "]
[349.184772, "o", "        pub encoded_idx: u64,\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.184801, "o", "> "]
[349.185053, "o", "        pub index_surcharge: u64,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.185132, "o", "        pub total_debit: u64,\r\n\u001b[?2004l\r"]
[349.185163, "o", "\u001b[?2004h> "]
[349.185374, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.185413, "o", "    #[inline]\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.185446, "o", "> "]
[349.185771, "o", "    pub fn build_quote(amount: u64, fee: u64) -> Option<OpenPqlQuote> {\r\n\u001b[?2004l\r"]
[349.185809, "o", "\u001b[?2004h> "]
[349.186026, "o", "        let principal_share: u64 = amount >> 1u64;\r\n\u001b[?2004l\r"]
[349.186064, "o", "\u001b[?2004h> "]
[349.186352, "o", "        let encoded_idx: u64 = mixed_radix::encode(amount, fee);\r\n\u001b[?2004l\r"]
[349.18639, "o", "\u001b[?2004h> "]
[349.186644, "o", "        let index_surcharge: u64 = encoded_idx >> 1u64;\r\n\u001b[?2004l\r"]
[349.186683, "o", "\u001b[?2004h> "]
[349.186978, "o", "        let total_debit: u64 = principal_share + index_surcharge;\r\n\u001b[?2004l\r"]
[349.187019, "o", "\u001b[?2004h> "]
[349.187207, "o", "        Some(OpenPqlQuote {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.18733, "o", "            principal_share,\r\n\u001b[?2004l\r"]
[349.187501, "o", "\u001b[?2004h>             encoded_idx,\r\n\u001b[?2004l\r"]
[349.187539, "o", "\u001b[?2004h> "]
[349.187768, "o", "            index_surcharge,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.187886, "o", "            total_debit,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.18804, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[349.188081, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.188114, "o", "\u001b[?2004h"]
[349.188142, "o", "> "]
[349.188444, "o", "    #[inline]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.188656, "o", "    pub fn verify_affordability(balance: u64, quote: OpenPqlQuote) -> Option<Authorization> {\r\n\u001b[?2004l\r"]
[349.188752, "o", "\u001b[?2004h> "]
[349.188937, "o", "        if quote.total_debit <= balance {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.18909, "o", "            Some(Authorization {\r\n\u001b[?2004l\r"]
[349.189126, "o", "\u001b[?2004h> "]
[349.189351, "o", "                total_debit: quote.total_debit,\r\n\u001b[?2004l\r"]
[349.189388, "o", "\u001b[?2004h> "]
[349.189538, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.189688, "o", "        } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.189825, "o", "            None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.189865, "o", "        }\r\n\u001b[?2004l\r"]
[349.189894, "o", "\u001b[?2004h> "]
[349.190169, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.190493, "o", "/// Authorize an OpenPQL 4-level mixed-radix settlement against `balance`.\r\n\u001b[?2004l\r"]
[349.190588, "o", "\u001b[?2004h> ///\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.190787, "o", "/// In exact integer arithmetic:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.190946, "o", "/// - For `i in {0, 1, 2, 3}`:\r\n\u001b[?2004l\r"]
[349.190984, "o", "\u001b[?2004h> "]
[349.191262, "o", "///   - `b_i = ((fee >> (16 * i)) & 0xFFFF) + 1` in `[1, 65536]`\r\n\u001b[?2004l\r"]
[349.1913, "o", "\u001b[?2004h> "]
[349.191585, "o", "///   - `a_i = (amount >> (16 * i)) & 0xFFFF` in `[0, 65535]`\r\n\u001b[?2004l\r"]
[349.191627, "o", "\u001b[?2004h> "]
[349.191825, "o", "///   - `d_i = min(a_i, b_i - 1)`\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.192149, "o", "/// - Suffix-product offsets: `o2 = b3`, `o1 = b2 * o2`, `o0 = b1 * o1`\r\n\u001b[?2004l\r"]
[349.192269, "o", "\u001b[?2004h> "]
[349.192442, "o", "/// - `encoded_idx = d0 * o0 + d1 * o1 + d2 * o2 + d3`\r\n\u001b[?2004l\r"]
[349.192535, "o", "\u001b[?2004h> "]
[349.19278, "o", "/// - `total_debit = floor(amount / 2) + floor(encoded_idx / 2)`\r\n\u001b[?2004l\r"]
[349.192828, "o", "\u001b[?2004h> ///"]
[349.19286, "o", "\r\n\u001b[?2004l\r"]
[349.192889, "o", "\u001b[?2004h> "]
[349.193166, "o", "/// The payment is authorized iff `total_debit <= balance`.\r\n\u001b[?2004l\r"]
[349.193202, "o", "\u001b[?2004h> "]
[349.193592, "o", "/// Production code in this crate operates on `u64` words only (`u128` is not used).\r\n\u001b[?2004l\r"]
[349.193678, "o", "\u001b[?2004h> "]
[349.19399, "o", "pub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {\r\n\u001b[?2004l\r"]
[349.194111, "o", "\u001b[?2004h> "]
[349.194381, "o", "    let quote: settlement::OpenPqlQuote = settlement::build_quote(amount, fee)?;\r\n\u001b[?2004l\r"]
[349.194557, "o", "\u001b[?2004h> "]
[349.194695, "o", "    settlement::verify_affordability(balance, quote)\r\n\u001b[?2004l\r"]
[349.194875, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.194955, "o", "#[cfg(test)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.195134, "o", "> mod tests {\r\n"]
[349.195223, "o", "\u001b[?2004l\r\u001b[?2004h>     use super::*;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.1954, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.195493, "o", "    #[test]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.195674, "o", "    fn zero_payment_is_authorized() {\r\n\u001b[?2004l\r"]
[349.195765, "o", "\u001b[?2004h> "]
[349.195983, "o", "        assert_eq!(authorize(0, 0, 0), Some(Authorization { total_debit: 0 }));\r\n\u001b[?2004l\r"]
[349.196106, "o", "\u001b[?2004h>     }\r\n"]
[349.196226, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.19639, "o", "    #[test]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.196555, "o", "    fn small_mixed_radix_coordinates_match_policy() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.19673, "o", "> "]
[349.196873, "o", "        let fee: u64 = 0x0003_0003_0003_0003;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.197051, "o", "        let amount: u64 = 0x0001_0002_0001_0002;\r\n\u001b[?2004l\r"]
[349.197205, "o", "\u001b[?2004h> "]
[349.19729, "o", "        assert_eq!(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.197517, "o", "            authorize(140_741_783_355_469, amount, fee),\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.197681, "o", "> "]
[349.197736, "o", "            Some(Authorization {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.197961, "o", "                total_debit: 140_741_783_355_469\r\n\u001b[?2004l\r"]
[349.198091, "o", "\u001b[?2004h>             })"]
[349.198244, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.198402, "o", "        );\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.198679, "o", "        assert_eq!(authorize(140_741_783_355_468, amount, fee), None);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.198773, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.198947, "o", "    #[test]\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.199038, "o", "> "]
[349.199208, "o", "    fn clamps_digits_to_radix_minus_one() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.199305, "o", "        assert_eq!(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.199529, "o", "            authorize(50, 100, 0),\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.199615, "o", "> "]
[349.19979, "o", "            Some(Authorization { total_debit: 50 })\r\n\u001b[?2004l\r"]
[349.199878, "o", "\u001b[?2004h>         );\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.200051, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.200137, "o", "\u001b[?2004h>     #[test]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.200362, "o", "    fn maximum_radices_do_not_wrap_the_index() {\r\n\u001b[?2004l\r"]
[349.20049, "o", "\u001b[?2004h> "]
[349.200601, "o", "        let max = u64::MAX;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.200768, "o", "        assert_eq!(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.200971, "o", "            authorize(u64::MAX / 2, max, max),\r\n\u001b[?2004l\r"]
[349.201064, "o", "\u001b[?2004h>             None\r\n\u001b[?2004l\r"]
[349.201231, "o", "\u001b[?2004h>         );\r\n"]
[349.201321, "o", "\u001b[?2004l\r\u001b[?2004h>         assert_eq!(\r\n\u001b[?2004l\r"]
[349.201504, "o", "\u001b[?2004h> "]
[349.20159, "o", "            authorize(u64::MAX - 1, max, max),\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.201762, "o", "> "]
[349.201929, "o", "            Some(Authorization { total_debit: u64::MAX - 1 })\r\n\u001b[?2004l\r"]
[349.202066, "o", "\u001b[?2004h>         );\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[349.202144, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[349.202322, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[349.204354, "o", "\u001b[?2004hroot@12c7fc84e5ce:/workspace/challenge# "]
