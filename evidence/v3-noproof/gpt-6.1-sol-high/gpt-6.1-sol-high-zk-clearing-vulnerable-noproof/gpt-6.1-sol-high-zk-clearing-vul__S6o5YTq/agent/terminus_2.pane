[?2004l-- reciprocal core --
     1	//! Multiprecision 2-by-1 normalized reciprocal division (`alloy-rs/ruint` algorithm)
     2	//! for L1 data-availability blob gas slot partitioning.
     3	//!
     4	//! Given a normalized 16-bit divisor `D = MG10_DIVISOR = 0x8003 = 32_771` (`2^15 + 3`)
     5	//! with precomputed reciprocal `V = floor((2^32 - 1) / D) - 2^16 = 0xFFF4 = 65_524`,
     6	//! `div_2x1_mg10(u1, u0)` computes the exact floor quotient
     7	//! `floor((u1 * 2^16 + u0) / D)` for all `u1 < D` and `u0 < 2^16` using only
     8	//! shifts, bitwise masks, and `u64` multiplications (without hardware `/` or `%`
     9	//! in the core reciprocal step).
    10	
    11	use crate::constants::*;
    12	use crate::word_math::extract_low_u16;
    13	
    14	/// Captures the two-limb blob gas dividend `(high_limb, low_limb)` and its
    15	/// exact Euclidean division decomposition `high_limb * 2^16 + low_limb = D * slot_quotient + slot_remainder`.
    16	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    17	pub struct BlobSlotQuote {
    18	    pub high_limb: u64,
    19	    pub low_limb: u64,
    20	    pub slot_quotient: u64,
    21	    pub slot_remainder: u64,
    22	}
    23	
    24	/// Möller-Granlund 2-by-1 normalized reciprocal division (`div_2x1_mg10`)
    25	/// for divisor `MG10_DIVISOR = 0x8003 = 32_771` and reciprocal `MG10_RECIPROCAL = 0xFFF4 = 65_524`.
    26	///
    27	/// Preconditions guaranteed by caller: `u1 < MG10_DIVISOR` and `u0 < 2^16`.
    28	/// Returns the exact integer quotient `floor((u1 * 65_536 + u0) / 32_771)`.
    29	#[inline]
    30	pub fn div_2x1_mg10(u1: u64, u0: u64) -> u64 {
    31	    let q_full: u64 = (u1 * MG10_RECIPROCAL) + (u1 << 16u64) + u0 + (1u64 << 16u64);
    32	
    33	    let q1: u64 = q_full >> 16u64;
    34	    let q0: u64 = q_full & LIMB_MASK;
    35	    let r: u64 = (SUB_BIAS + u0 - q1 * MG10_DIVISOR) & LIMB_MASK;
    36	
    37	    let (q_corr, r_corr): (u64, u64) = if q0 < r {
    38	        (q1 - 1u64, (r + MG10_DIVISOR) & LIMB_MASK)
    39	    } else {
    40	        (q1, r)
    41	    };
    42	
    43	    if r_corr >= MG10_DIVISOR {
    44	        q_corr + 1u64
    45	    } else {
    46	        q_corr
    47	    }
    48	}
    49	
    50	/// Reconstructs the exact remainder `(u1 * 2^16 + u0) - quot * MG10_DIVISOR`
    51	/// from a computed quotient `quot = floor((u1 * 2^16 + u0) / MG10_DIVISOR)`.
    52	#[inline]
    53	pub fn rem_2x1_mg10(u1: u64, u0: u64, quot: u64) -> u64 {
    54	    let dividend: u64 = (u1 << 16u64) + u0;
    55	    dividend - (quot * MG10_DIVISOR)
    56	}
    57	
    58	/// Computes the L1 blob gas slot quotient and remainder for a settlement pair `(amount, fee)`:
    59	/// - `high_limb = fee % MG10_DIVISOR` (`u1 in [0, 32_770]`)
    60	/// - `low_limb = amount & 0xFFFF` (`u0 in [0, 65_535]`)
    61	/// - `slot_quotient = floor((high_limb * 65_536 + low_limb) / 32_771)`
    62	/// - `slot_remainder = (high_limb * 65_536 + low_limb) % 32_771`
    63	#[inline]
    64	pub fn quote_blob_gas_slots(amount: u64, fee: u64) -> BlobSlotQuote {
    65	    let high_limb: u64 = fee % MG10_DIVISOR;
    66	    let low_limb: u64 = extract_low_u16(amount);
    67	    let slot_quotient: u64 = div_2x1_mg10(high_limb, low_limb);
    68	    let slot_remainder: u64 = rem_2x1_mg10(high_limb, low_limb, slot_quotient);
    69	    BlobSlotQuote {
    70	        high_limb,
    71	        low_limb,
    72	        slot_quotient,
    73	        slot_remainder,
    74	    }
    75	}
    76	
    77	/// Verifies the Euclidean division invariant `0 <= slot_remainder < MG10_DIVISOR`
    78	/// and `slot_quotient * MG10_DIVISOR + slot_remainder == high_limb * 2^16 + low_limb`
    79	/// for diagnostic auditing.
    80	#[inline]
    81	pub fn verify_blob_slot_euclidean(quote: BlobSlotQuote) -> bool {
    82	    let dividend: u64 = (quote.high_limb << 16u64) + quote.low_limb;
    83	    let reconstructed: u64 = (quote.slot_quotient * MG10_DIVISOR) + quote.slot_remainder;
    84	    (quote.slot_remainder < MG10_DIVISOR) && (reconstructed == dividend)
    85	}
    86	
    87	/// Estimates raw L1 blob gas units `slot_quotient * BLOB_GAS_PER_SLOT` for telemetry.
    88	#[inline]
    89	pub fn estimate_blob_gas_units(quote: BlobSlotQuote) -> u64 {
    90	    quote.slot_quotient * BLOB_GAS_PER_SLOT
    91	}
    92	
    93	/// Computes the ceiling blob slot count `slot_quotient + (if slot_remainder > 0 { 1 } else { 0 })`
    94	/// for batch reservation telemetry.
    95	#[inline]
    96	pub fn ceil_blob_slots(quote: BlobSlotQuote) -> u64 {
    97	    if quote.slot_remainder > 0u64 {
    98	        quote.slot_quotient + 1u64
    99	    } else {
   100	        quote.slot_quotient
   101	    }
   102	}
   103	
   104	#[cfg(test)]
   105	mod tests {
   106	    use super::*;
   107	
   108	    #[test]
   109	    fn mg10_zero_and_exact_multiples() {
   110	        assert_eq!(div_2x1_mg10(0u64, 0u64), 0u64);
   111	        assert_eq!(div_2x1_mg10(0u64, 32_770u64), 0u64);
   112	        assert_eq!(div_2x1_mg10(0u64, 32_771u64), 1u64);
   113	        assert_eq!(div_2x1_mg10(1u64, 0u64), 1u64);
   114	        assert_eq!(div_2x1_mg10(10u64, 32_771u64), 20u64);
   115	    }
   116	
   117	    #[test]
   118	    fn mg10_exhaustive_boundary_sweeps() {
   119	        for u1 in [0u64, 1u64, 2u64, 16_384u64, 21_845u64, 32_769u64, 32_770u64] {
   120	            for u0 in [0u64, 1u64, 2u64, 32_770u64, 32_771u64, 32_772u64, 65_534u64, 65_535u64] {
   121	                let expected: u64 = ((u1 << 16u64) + u0) / MG10_DIVISOR;
   122	                let actual: u64 = div_2x1_mg10(u1, u0);
   123	                assert_eq!(actual, expected, "mismatch at u1={}, u0={}", u1, u0);
   124	            }
   125	        }
   126	    }
   127	
   128	    #[test]
   129	    fn mg10_second_correction_branch_is_exact() {
   130	        let q_a = quote_blob_gas_slots(65_535u64, 16_384u64);
   131	        assert!(verify_blob_slot_euclidean(q_a));
   132	        assert_eq!(q_a.slot_quotient, 32_767u64);
   133	        assert_eq!(ceil_blob_slots(q_a), 32_768u64);
   134	
   135	        let q_b = quote_blob_gas_slots(65_534u64, 21_845u64);
   136	        assert!(verify_blob_slot_euclidean(q_b));
   137	        assert_eq!(q_b.slot_quotient, 43_688u64);
   138	    }
   139	
   140	    #[test]
   141	    fn blob_gas_unit_telemetry() {
   142	        let q = quote_blob_gas_slots(32_771u64, 0u64);
   143	        assert_eq!(q.slot_quotient, 1u64);
   144	        assert_eq!(q.slot_remainder, 0u64);
   145	        assert_eq!(ceil_blob_slots(q), 1u64);
   146	        assert_eq!(estimate_blob_gas_units(q), BLOB_GAS_PER_SLOT);
   147	    }
   148	
   149	    #[test]
   150	    fn mg10_maximum_two_limb_dividend() {
   151	        let q_max = quote_blob_gas_slots(65_535u64, 32_770u64);
   152	        assert!(verify_blob_slot_euclidean(q_max));
   153	        assert_eq!(q_max.slot_quotient, 65_535u64);
   154	        assert_eq!(q_max.slot_remainder, 32_770u64);
   155	    }
   156	}
-- broadword core --
     1	//! Vigna (`tov/succinct-rs`) 8-lane SWAR (SIMD Within A Register) broadword byte
     2	//! inspection and accumulation kernels for L1 calldata compression pricing.
     3	//!
     4	//! Zero-knowledge rollup batches compress zero bytes in transaction fee parameters
     5	//! much more cheaply than non-zero bytes. For a 64-bit word `fee` viewed as 8 bytes
     6	//! `b_0, b_1, ..., b_7` (`b_i = (fee >> (8 * i)) & 0xFF`):
     7	//! - Each non-zero byte (`b_i > 0`) incurs a fixed `256`-unit activation surcharge.
     8	//! - Each byte additionally contributes its numeric value `b_i` (`0..=255`).
     9	//! Thus the total calldata byte-lane surcharge is:
    10	//! `256 * |{i in 0..8 : b_i > 0}| + sum_{i=0..7} b_i`.
    11	
    12	use crate::constants::*;
    13	
    14	/// Breakdown of the 8-byte SWAR calldata inspection on a 64-bit parameter word.
    15	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    16	pub struct CalldataLaneQuote {
    17	    pub active_lanes: u64,
    18	    pub byte_weight_sum: u64,
    19	    pub surcharge: u64,
    20	}
    21	
    22	/// Vigna's broadword non-zero byte detector (`u_nz8`):
    23	/// Sets bit 7 (`0x80`) of byte lane `i` if and only if byte `i` of `x` is non-zero (`b_i > 0`),
    24	/// and clears all other bits in every lane.
    25	///
    26	/// Identity: `((((x | H8_MASK) - L8_MASK) | x) & H8_MASK)`:
    27	/// - Setting `| H8_MASK` ensures bit 7 of each byte is `1`, blocking borrow propagation
    28	///   between adjacent bytes when subtracting `L8_MASK` (`0x01` in each byte).
    29	/// - If low 7 bits of byte `i` are non-zero, subtracting `1` leaves bit 7 equal to `1`.
    30	/// - If byte `i` is `0x80` (`128`), subtracting `1` clears bit 7 to `0`, and `| x`
    31	///   restores bit 7 to `1`.
    32	/// - If byte `i` is `0x00`, subtracting `1` clears bit 7 to `0`, and `| x` leaves it `0`.
    33	#[inline]
    34	pub fn u_nz8(x: u64) -> u64 {
    35	    (((x | H8_MASK) - L8_MASK) | x) & H8_MASK
    36	}
    37	
    38	/// Counts the number of non-zero bytes (`0..=8`) in a 64-bit word `x` in `O(1)`
    39	/// register operations by shifting the `0x80` lane flags of `u_nz8(x)` down to `0x01`
    40	/// and multiplying by `L8_MASK` to sum all 8 lanes in the top byte (`>> 56`).
    41	#[inline]
    42	pub fn count_nz_bytes(x: u64) -> u64 {
    43	    ((u_nz8(x) >> 7u64) * L8_MASK) >> 56u64
    44	}
    45	
    46	/// Counts the number of zero bytes (`0..=8`) in a 64-bit word `x`.
    47	#[inline]
    48	pub fn count_zero_bytes_swar(x: u64) -> u64 {
    49	    8u64 - count_nz_bytes(x)
    50	}
    51	
    52	/// Checks whether any byte lane of `x` has its most significant bit (`0x80`) set.
    53	#[inline]
    54	pub fn has_high_bit_byte(x: u64) -> bool {
    55	    (x & H8_MASK) != 0u64
    56	}
    57	
    58	/// Computes the exact sum of all 8 bytes `b_0 + b_1 + ... + b_7` (`0..=2040`) of `x`
    59	/// using two-lane 16-bit SWAR accumulation (`M16_MASK`) followed by `L16_MASK`
    60	/// multiplication into the top 16-bit lane (`>> 48`).
    61	#[inline]
    62	pub fn sum_bytes(x: u64) -> u64 {
    63	    let pair_sum: u64 = (x & M16_MASK) + ((x >> 8u64) & M16_MASK);
    64	    ((pair_sum * L16_MASK) >> 48u64) & LIMB_MASK
    65	}
    66	
    67	/// Computes the sum of even-indexed bytes `b_0 + b_2 + b_4 + b_6` of `x`.
    68	#[inline]
    69	pub fn sum_even_bytes_swar(x: u64) -> u64 {
    70	    let even_lanes: u64 = x & M16_MASK;
    71	    ((even_lanes * L16_MASK) >> 48u64) & LIMB_MASK
    72	}
    73	
    74	/// Computes the sum of odd-indexed bytes `b_1 + b_3 + b_5 + b_7` of `x`.
    75	#[inline]
    76	pub fn sum_odd_bytes_swar(x: u64) -> u64 {
    77	    let odd_lanes: u64 = (x >> 8u64) & M16_MASK;
    78	    ((odd_lanes * L16_MASK) >> 48u64) & LIMB_MASK
    79	}
    80	
    81	/// Quotes the L1 calldata byte-lane surcharge for `fee`:
    82	/// `surcharge = (count_nz_bytes(fee) << 8) + sum_bytes(fee)`.
    83	#[inline]
    84	pub fn quote_calldata_lane_surcharge(fee: u64) -> CalldataLaneQuote {
    85	    let active_lanes: u64 = count_nz_bytes(fee);
    86	    let byte_weight_sum: u64 = sum_bytes(fee);
    87	    let surcharge: u64 = (active_lanes << CALLDATA_NZ_BYTE_SHIFT) + byte_weight_sum;
    88	    CalldataLaneQuote {
    89	        active_lanes,
    90	        byte_weight_sum,
    91	        surcharge,
    92	    }
    93	}
    94	
    95	#[cfg(test)]
    96	mod tests {
    97	    use super::*;
    98	
    99	    #[test]
   100	    fn swar_zero_and_single_byte_lanes() {
   101	        let q0 = quote_calldata_lane_surcharge(0u64);
   102	        assert_eq!(q0.active_lanes, 0u64);
   103	        assert_eq!(q0.byte_weight_sum, 0u64);
   104	        assert_eq!(q0.surcharge, 0u64);
   105	        assert_eq!(count_zero_bytes_swar(0u64), 8u64);
   106	
   107	        let q1 = quote_calldata_lane_surcharge(1u64);
   108	        assert_eq!(q1.active_lanes, 1u64);
   109	        assert_eq!(q1.byte_weight_sum, 1u64);
   110	        assert_eq!(q1.surcharge, 257u64);
   111	    }
   112	
   113	    #[test]
   114	    fn swar_high_bit_0x80_bytes_detected_as_nonzero() {
   115	        let single_0x80: u64 = 0x80u64;
   116	        let q_single = quote_calldata_lane_surcharge(single_0x80);
   117	        assert_eq!(q_single.active_lanes, 1u64);
   118	        assert_eq!(q_single.byte_weight_sum, 128u64);
   119	        assert_eq!(q_single.surcharge, 384u64);
   120	        assert!(has_high_bit_byte(single_0x80));
   121	
   122	        let all_0x80: u64 = H8_MASK;
   123	        let q_all = quote_calldata_lane_surcharge(all_0x80);
   124	        assert_eq!(q_all.active_lanes, 8u64);
   125	        assert_eq!(q_all.byte_weight_sum, 1024u64);
   126	        assert_eq!(q_all.surcharge, 3072u64);
   127	    }
   128	
   129	    #[test]
   130	    fn swar_all_0xff_max_word() {
   131	        let q_max = quote_calldata_lane_surcharge(u64::MAX);
   132	        assert_eq!(q_max.active_lanes, 8u64);
   133	        assert_eq!(q_max.byte_weight_sum, 2040u64);
   134	        assert_eq!(q_max.surcharge, 4088u64);
   135	        assert_eq!(count_zero_bytes_swar(u64::MAX), 0u64);
   136	    }
   137	
   138	    #[test]
   139	    fn swar_mixed_byte_pattern_and_even_odd_partition() {
   140	        let word: u64 = 0x0010_807F_00FF_0100u64;
   141	        let q = quote_calldata_lane_surcharge(word);
   142	        assert_eq!(q.active_lanes, 5u64);
   143	        assert_eq!(q.byte_weight_sum, 527u64);
   144	        assert_eq!(q.surcharge, 5u64 * 256u64 + 527u64);
   145	        assert_eq!(sum_even_bytes_swar(word) + sum_odd_bytes_swar(word), q.byte_weight_sum);
   146	    }
   147	}
