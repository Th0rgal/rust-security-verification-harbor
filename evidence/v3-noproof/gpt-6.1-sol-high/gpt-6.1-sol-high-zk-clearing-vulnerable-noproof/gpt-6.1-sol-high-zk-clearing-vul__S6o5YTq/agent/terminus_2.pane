[?2004l     1	//! Multi-stage rollup batch clearing pipeline and settlement ticket gate.
     2	//!
     3	//! Coordinates the protocol surcharge subsystems across `word_math`, `fee_schedule`,
     4	//! `liquidity_pool`, `reciprocal_div`, `broadword_swar`, `montgomery_field`,
     5	//! `goldilocks_field`, and `transcript_codec` to price and authorize a batch
     6	//! clearing request `(balance, amount, fee)`.
     7	//!
     8	//! The combined protocol surcharge is added to the transfer principal `amount`
     9	//! via checked `u64` addition, and the resulting `ClearingTicket` is committed
    10	//! if and only if `total_debit <= balance`.
    11	
    12	use crate::Authorization;
    13	use crate::broadword_swar::{CalldataLaneQuote, quote_calldata_lane_surcharge};
    14	use crate::fee_schedule::{FeeQuote, evaluate_settlement_fee};
    15	use crate::goldilocks_field::{GoldilocksQuote, quote_bridge_verifier_fee};
    16	use crate::liquidity_pool::{PoolReserveQuote, quote_flash_lp_retention};
    17	use crate::montgomery_field::{ProverLevyQuote, quote_prover_transcript_levy};
    18	use crate::reciprocal_div::{BlobSlotQuote, quote_blob_gas_slots};
    19	use crate::transcript_codec::decode_domain_tag;
