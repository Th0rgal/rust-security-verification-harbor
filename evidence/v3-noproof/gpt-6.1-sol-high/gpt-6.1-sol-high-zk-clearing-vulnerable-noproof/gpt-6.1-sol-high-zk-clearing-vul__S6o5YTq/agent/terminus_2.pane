[?2004l-- montgomery core --
     1	//! `Plonky3` BabyBear (`P = 2_013_265_921 = 2^31 - 2^27 + 1`) 64-bit Montgomery
     2	//! reduction and STARK prover transcript commitment levy calculator.
     3	//!
     4	//! For radix `R = 2^32 = 4_294_967_296` and prime `P = 2_013_265_921`:
     5	//! - `R^{-1} mod P = 943_718_400`
     6	//! - `MU = -P^{-1} mod R = 2_281_701_377`
     7	//! Given a 64-bit packed transcript state `x < P * R`:
     8	//! 1. `t = ((x mod R) * MU) mod R`
     9	//! 2. `u = t * P` (so `x - u` is an exact multiple of `R = 2^32` in `(-P * R, P * R)`)
    10	//! 3. If `x < u`, `(x - u) / R + P` is computed in `u64` via
    11	//!    `P + (x.wrapping_sub(u) / R) - R`; otherwise `(x - u) / R`.
    12	//! The result equals `(x * R^{-1}) mod P` in `[0, P - 1]`.
    13	
    14	use crate::constants::*;
    15	
    16	/// Captures the packed 64-bit transcript state, Montgomery quotient limb `t`,
    17	/// and canonical BabyBear field element `prover_levy in [0, BABYBEAR_P - 1]`.
    18	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    19	pub struct ProverLevyQuote {
    20	    pub packed_transcript: u64,
    21	    pub monty_t: u64,
    22	    pub prover_levy: u64,
    23	}
    24	
    25	/// Packs the low 32-bit limb of `amount` (`amount mod 2^32`) and the canonical
    26	/// BabyBear residue of `fee` (`fee mod P`) into a 64-bit transcript integer
    27	/// `x = (amount % 2^32) + (fee % P) * 2^32 < P * 2^32`.
    28	#[inline]
    29	pub fn pack_transcript(amount: u64, fee: u64) -> u64 {
    30	    (amount % LIMB_BASE) + (fee % BABYBEAR_P) * LIMB_BASE
    31	}
    32	
    33	/// Computes the 32-bit Montgomery reduction multiplier `t = ((x mod 2^32) * MU) mod 2^32`.
    34	#[inline]
    35	pub fn monty_quotient(x: u64) -> u64 {
    36	    ((x % LIMB_BASE) * BABYBEAR_MU) % LIMB_BASE
    37	}
    38	
    39	/// Performs 64-bit BabyBear Montgomery reduction on `x < BABYBEAR_P * 2^32`,
    40	/// returning `(x * 943_718_400) mod 2_013_265_921` in pure `u64` arithmetic.
    41	#[inline]
    42	pub fn monty_reduce(x: u64) -> u64 {
    43	    let t: u64 = monty_quotient(x);
    44	    let u: u64 = BABYBEAR_P * t;
    45	    let diff: u64 = x.wrapping_sub(u);
    46	    let hi: u64 = diff / LIMB_BASE;
    47	    if x < u {
    48	        BABYBEAR_P + hi - LIMB_BASE
    49	    } else {
    50	        hi
    51	    }
    52	}
    53	
    54	/// Performs Montgomery multiplication `(a * b * R^{-1}) mod BABYBEAR_P`
    55	/// for two BabyBear field elements `a, b < BABYBEAR_P`.
    56	#[inline]
    57	pub fn monty_mul_babybear(a: u64, b: u64) -> u64 {
    58	    let prod: u64 = (a % BABYBEAR_P) * (b % BABYBEAR_P);
    59	    monty_reduce(prod)
    60	}
    61	
    62	/// Canonical modular addition `(a + b) mod BABYBEAR_P` for `a, b < BABYBEAR_P`.
    63	#[inline]
    64	pub fn canonical_add_babybear(a: u64, b: u64) -> u64 {
    65	    let sum: u64 = a + b;
    66	    if sum >= BABYBEAR_P {
    67	        sum - BABYBEAR_P
    68	    } else {
    69	        sum
    70	    }
    71	}
    72	
    73	/// Canonical modular subtraction `(a - b) mod BABYBEAR_P` for `a, b < BABYBEAR_P`.
    74	#[inline]
    75	pub fn canonical_sub_babybear(a: u64, b: u64) -> u64 {
    76	    if a >= b {
    77	        a - b
    78	    } else {
    79	        (a + BABYBEAR_P) - b
    80	    }
    81	}
    82	
    83	/// Quotes the STARK prover transcript commitment levy for `(amount, fee)`:
    84	/// `prover_levy = monty_reduce(pack_transcript(amount, fee))`.
    85	#[inline]
    86	pub fn quote_prover_transcript_levy(amount: u64, fee: u64) -> ProverLevyQuote {
    87	    let packed_transcript: u64 = pack_transcript(amount, fee);
    88	    let monty_t: u64 = monty_quotient(packed_transcript);
    89	    let prover_levy: u64 = monty_reduce(packed_transcript);
    90	    ProverLevyQuote {
    91	        packed_transcript,
    92	        monty_t,
    93	        prover_levy,
    94	    }
    95	}
    96	
    97	#[cfg(test)]
    98	mod tests {
    99	    use super::*;
   100	
   101	    #[test]
   102	    fn monty_reduce_zero_and_multiples_of_p() {
   103	        assert_eq!(monty_reduce(0u64), 0u64);
   104	        assert_eq!(monty_reduce(BABYBEAR_P), 0u64);
   105	        assert_eq!(monty_reduce(BABYBEAR_P * 42u64), 0u64);
   106	    }
   107	
   108	    #[test]
   109	    fn monty_reduce_radix_r_gives_one() {
   110	        assert_eq!(monty_reduce(LIMB_BASE), 1u64);
   111	        let q = quote_prover_transcript_levy(0u64, 1u64);
   112	        assert_eq!(q.prover_levy, 1u64);
   113	    }
   114	
   115	    #[test]
   116	    fn monty_reduce_underflow_branch_and_non_underflow_branch() {
   117	        let q_under = quote_prover_transcript_levy(1u64, 0u64);
   118	        assert_eq!(q_under.prover_levy, 943_718_400u64);
   119	
   120	        assert_eq!(monty_reduce(BABYBEAR_P), 0u64);
   121	
   122	        let q_high = quote_prover_transcript_levy(u64::MAX, BABYBEAR_P - 1u64);
   123	        assert_eq!(q_high.prover_levy, 1_069_547_521u64);
   124	    }
   125	
   126	    #[test]
   127	    fn canonical_babybear_ring_operations() {
   128	        assert_eq!(canonical_add_babybear(BABYBEAR_P - 1u64, 2u64), 1u64);
   129	        assert_eq!(canonical_sub_babybear(1u64, 2u64), BABYBEAR_P - 1u64);
   130	        let r_mod_p: u64 = LIMB_BASE % BABYBEAR_P;
   131	        assert_eq!(monty_mul_babybear(17u64, r_mod_p), 17u64);
   132	    }
   133	}
