    22	/// Itemized multi-stage surcharge breakdown for a rollup clearing operation.
    23	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    24	pub struct ClearingBreakdown {
    25	    pub net_bps_fee: u64,
    26	    pub flash_lp_fee: u64,
    27	    pub blob_slot_quotient: u64,
    28	    pub calldata_surcharge: u64,
    29	    pub prover_levy: u64,
    30	    pub domain_surcharge: u64,
    31	    pub base_surcharge: u64,
    32	    pub bridge_surcharge: u64,
    33	}
    34	
    35	/// Validated clearing settlement ticket ready for balance conservation check.
    36	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    37	pub struct ClearingTicket {
    38	    pub principal: u64,
    39	    pub net_bps_fee: u64,
    40	    pub flash_lp_fee: u64,
    41	    pub blob_slot_quotient: u64,
    42	    pub calldata_surcharge: u64,
    43	    pub prover_levy: u64,
    44	    pub domain_surcharge: u64,
    45	    pub bridge_surcharge: u64,
    46	    pub total_surcharge: u64,
    47	    pub total_debit: u64,
    48	}
    49	
    50	/// Evaluates all protocol surcharge stages for `(amount, fee)` and packages them into
    51	/// a `ClearingBreakdown`.
    52	#[inline]
    53	pub fn compute_clearing_breakdown(amount: u64, fee: u64) -> ClearingBreakdown {
    54	    let notional_sum: WordSum = add_u64_with_carry(amount, fee);
    55	    let fee_quote: FeeQuote = evaluate_settlement_fee(notional_sum);
    56	    let flash_quote: PoolReserveQuote = quote_flash_lp_retention(amount, fee);
    57	    let blob_quote: BlobSlotQuote = quote_blob_gas_slots(amount, fee);
    58	    let lane_quote: CalldataLaneQuote = quote_calldata_lane_surcharge(fee);
    59	    let levy_quote: ProverLevyQuote = quote_prover_transcript_levy(amount, fee);
    60	    let bridge_quote: GoldilocksQuote = quote_bridge_verifier_fee(amount, fee);
    61	    let domain_surcharge: u64 = decode_domain_tag(fee);
    62	
    63	    let net_bps_fee: u64 = fee_quote.net_fee;
    64	    let flash_lp_fee: u64 = flash_quote.lp_retention;
    65	    let blob_slot_quotient: u64 = blob_quote.slot_quotient;
    66	    let calldata_surcharge: u64 = lane_quote.surcharge;
    67	    let prover_levy: u64 = levy_quote.prover_levy;
    68	    let bridge_surcharge: u64 = bridge_quote.bridge_fee;
    69	
    70	    let base_surcharge: u64 = net_bps_fee
    71	        + flash_lp_fee
    72	        + blob_slot_quotient
    73	        + calldata_surcharge
    74	        + prover_levy
    75	        + domain_surcharge;
    76	
    77	    ClearingBreakdown {
    78	        net_bps_fee,
    79	        flash_lp_fee,
    80	        blob_slot_quotient,
    81	        calldata_surcharge,
    82	        prover_levy,
    83	        domain_surcharge,
    84	        base_surcharge,
    85	        bridge_surcharge,
    86	    }
    87	}
    88	
    89	/// Assembles a `ClearingTicket` from `amount` and `breakdown`, returning `None`
    90	/// if `amount + breakdown.base_surcharge + breakdown.bridge_surcharge` exceeds `u64::MAX`.
    91	#[inline]
    92	pub fn assemble_clearing_ticket(
    93	    amount: u64,
    94	    breakdown: ClearingBreakdown,
    95	) -> Option<ClearingTicket> {
    96	    let total_surcharge: u64 = breakdown
    97	        .base_surcharge
    98	        .checked_add(breakdown.bridge_surcharge)?;
    99	    let total_debit: u64 = amount.checked_add(total_surcharge)?;
   100	    Some(ClearingTicket {
   101	        principal: amount,
   102	        net_bps_fee: breakdown.net_bps_fee,
   103	        flash_lp_fee: breakdown.flash_lp_fee,
   104	        blob_slot_quotient: breakdown.blob_slot_quotient,
   105	        calldata_surcharge: breakdown.calldata_surcharge,
   106	        prover_levy: breakdown.prover_levy,
   107	        domain_surcharge: breakdown.domain_surcharge,
   108	        bridge_surcharge: breakdown.bridge_surcharge,
   109	        total_surcharge,
   110	        total_debit,
   111	    })
   112	}
   113	
   114	/// Quotes a complete `ClearingTicket` for `(amount, fee)`.
   115	#[inline]
   116	pub fn quote_clearing_ticket(amount: u64, fee: u64) -> Option<ClearingTicket> {
   117	    let breakdown: ClearingBreakdown = compute_clearing_breakdown(amount, fee);
   118	    assemble_clearing_ticket(amount, breakdown)
   119	}
   120	
   121	/// Commits a `ClearingTicket` against `balance`, authorizing iff `ticket.total_debit <= balance`.
   122	#[inline]
   123	pub fn commit_clearing_ticket(balance: u64, ticket: ClearingTicket) -> Option<Authorization> {
   124	    if ticket.total_debit <= balance {
   125	        Some(Authorization {
   126	            total_debit: ticket.total_debit,
   127	        })
   128	    } else {
   129	        None
   130	    }
   131	}
   132	
   133	/// Computes the post-settlement remaining account balance for telemetry, saturating at zero.
   134	#[inline]
   135	pub fn preview_remaining_balance(balance: u64, ticket: ClearingTicket) -> u64 {
   136	    balance.saturating_sub(ticket.total_debit)
   137	}
   138	
   139	/// Verifies internal surcharge conservation on an assembled `ClearingTicket`.
   140	#[inline]
   141	pub fn verify_ticket_conservation(ticket: ClearingTicket) -> bool {
   142	    let recomputed_base: u64 = ticket.net_bps_fee
   143	        + ticket.flash_lp_fee
   144	        + ticket.blob_slot_quotient
   145	        + ticket.calldata_surcharge
   146	        + ticket.prover_levy
   147	        + ticket.domain_surcharge;
   148	    (recomputed_base.wrapping_add(ticket.bridge_surcharge) == ticket.total_surcharge)
   149	        && (ticket.principal.wrapping_add(ticket.total_surcharge) == ticket.total_debit)
   150	}
