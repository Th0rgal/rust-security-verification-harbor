     1	//! `recmo/goldilocks` 128-bit prime field reduction (`P_G = 2^64 - 2^32 + 1`)
     2	//! for cross-chain L1 bridge verification fee quotes.
     3	//!
     4	//! Because `2^64 ≡ 2^32 - 1 = EPS (mod P_G)`, a 128-bit integer `x_lo + x_hi * 2^64`
     5	//! is reduced modulo `P_G` in pure `u64` arithmetic by splitting `x_hi` into its
     6	//! high 32-bit limb `x_hi_hi = x_hi >> 32` and low 32-bit limb `x_hi_lo = x_hi & EPS`:
     7	//! 1. Subtract `x_hi_hi` from `x_lo` (compensating by `-EPS` on borrow).
     8	//! 2. Add `x_hi_lo * EPS` (compensating by `+EPS` on 64-bit carry).
     9	//! 3. Canonicalize into `[0, P_G - 1]` by subtracting `P_G` if `r >= P_G`.
    10	
    11	use crate::constants::*;
    12	
    13	/// Bridge verifier fee quote produced by Goldilocks 128-bit reduction.
    14	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    15	pub struct GoldilocksQuote {
    16	    pub folded_low: u64,
    17	    pub canonical_residue: u64,
    18	    pub bridge_fee: u64,
    19	}
    20	
    21	/// Performs the first Goldilocks folding step `x_lo - (x_hi >> 32) mod 2^64`,
    22	/// returning `(r0, borrow)`.
    23	#[inline]
    24	pub fn reduce_goldilocks_step1(x_lo: u64, x_hi: u64) -> (u64, bool) {
    25	    let x_hi_hi: u64 = x_hi >> 32u64;
    26	    x_lo.overflowing_sub(x_hi_hi)
    27	}
    28	
    29	/// Reduces a 128-bit value `(x_lo, x_hi)` modulo the Goldilocks prime
    30	/// `GOLDILOCKS_P = 0xFFFF_FFFF_0000_0001` in pure `u64` arithmetic.
    31	#[inline]
    32	pub fn reduce_goldilocks_128(x_lo: u64, x_hi: u64) -> u64 {
    33	    let x_hi_lo: u64 = x_hi & GOLDILOCKS_EPS;
    34	    let (t0, borrow): (u64, bool) = reduce_goldilocks_step1(x_lo, x_hi);
    35	    let t1: u64 = if borrow {
    36	        t0.wrapping_add(GOLDILOCKS_P)
    37	    } else {
    38	        t0
    39	    };
    40	    let prod: u64 = x_hi_lo * GOLDILOCKS_EPS;
    41	    let (t2, carry): (u64, bool) = t1.overflowing_add(prod);
    42	    let t3: u64 = if carry {
    43	        t2.wrapping_add(GOLDILOCKS_EPS)
    44	    } else {
    45	        t2
    46	    };
    47	    if t3 >= GOLDILOCKS_P {
    48	        t3 - GOLDILOCKS_P
    49	    } else {
    50	        t3
    51	    }
    52	}
    53	
    54	/// Canonicalizes a single 64-bit word `x` modulo `GOLDILOCKS_P`.
    55	#[inline]
    56	pub fn canonicalize_goldilocks_u64(x: u64) -> u64 {
    57	    if x >= GOLDILOCKS_P {
    58	        x - GOLDILOCKS_P
    59	    } else {
    60	        x
    61	    }
    62	}
    63	
    64	/// Canonical modular addition `(a + b) mod GOLDILOCKS_P` for `a, b < GOLDILOCKS_P`.
    65	#[inline]
    66	pub fn add_goldilocks_mod(a: u64, b: u64) -> u64 {
    67	    reduce_goldilocks_128(a.wrapping_add(b), if a.wrapping_add(b) < a { 1u64 } else { 0u64 })
    68	}
    69	
    70	/// Canonical modular subtraction `(a - b) mod GOLDILOCKS_P` for `a, b < GOLDILOCKS_P`.
    71	#[inline]
    72	pub fn sub_goldilocks_mod(a: u64, b: u64) -> u64 {
    73	    let ca: u64 = canonicalize_goldilocks_u64(a);
    74	    let cb: u64 = canonicalize_goldilocks_u64(b);
    75	    if ca >= cb {
    76	        ca - cb
    77	    } else {
    78	        (GOLDILOCKS_P - cb) + ca
    79	    }
    80	}
    81	
    82	/// Folds a 64-bit commitment word with a 32-bit challenge scalar in the Goldilocks field.
    83	#[inline]
    84	pub fn fold_goldilocks_challenge(commitment: u64, challenge_u32: u64) -> u64 {
    85	    let scalar: u64 = challenge_u32 & LOW32_MASK;
    86	    let lo_limb: u64 = commitment & LOW32_MASK;
    87	    let hi_limb: u64 = commitment >> 32u64;
    88	    let prod_lo: u64 = lo_limb * scalar;
    89	    let prod_hi: u64 = hi_limb * scalar;
    90	    let x_lo: u64 = prod_lo.wrapping_add(prod_hi << 32u64);
    91	    let carry: u64 = if x_lo < prod_lo { 1u64 } else { 0u64 };
    92	    let x_hi: u64 = (prod_hi >> 32u64) + carry;
    93	    reduce_goldilocks_128(x_lo, x_hi)
    94	}
    95	
    96	/// Quotes a cross-chain bridge verifier fee from `(amount, fee)` in the Goldilocks field.
    97	#[inline]
    98	pub fn quote_bridge_verifier_fee(amount: u64, fee: u64) -> GoldilocksQuote {
    99	    let (folded_low, _borrow): (u64, bool) = reduce_goldilocks_step1(amount, fee);
   100	    let canonical_residue: u64 = reduce_goldilocks_128(amount, fee);
   101	    let bridge_fee: u64 = canonical_residue;
   102	    GoldilocksQuote {
   103	        folded_low,
   104	        canonical_residue,
   105	        bridge_fee,
   106	    }
   107	}
