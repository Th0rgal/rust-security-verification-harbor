     1	//! Protocol basis-point settlement fee and tier rebate schedule calculator.
     2	//!
     3	//! Given a 65-bit combined notional `sum = add_u64_with_carry(amount, fee)`:
     4	//! 1. The gross settlement fee is the ceiling basis-point quotient
     5	//!    `gross_fee = ceil((amount + fee) / BPS_DENOM)` (`BPS_DENOM = 10_000`).
     6	//! 2. The tier rebate is the floor 10% discount
     7	//!    `rebate = floor(gross_fee / REBATE_DIVISOR)` (`REBATE_DIVISOR = 10`).
     8	//! 3. The net protocol settlement fee is `net_fee = gross_fee - rebate`.
     9	
    10	use crate::constants::*;
    11	use crate::word_math::{WordSum, ceil_div_bps_u64, floor_div_bps_u64, is_institutional_notional};
    12	
    13	/// Active protocol fee schedule parameters.
    14	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    15	pub struct FeeSchedule {
    16	    pub bps_denom: u64,
    17	    pub rebate_divisor: u64,
    18	    pub maker_cap_divisor: u64,
    19	}
    20	
    21	/// Complete two-stage fee quote (`gross_fee`, `rebate`, `net_fee`).
    22	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    23	pub struct FeeQuote {
    24	    pub gross_fee: u64,
    25	    pub rebate: u64,
    26	    pub net_fee: u64,
    27	}
    28	
    29	/// Returns the canonical protocol fee schedule configuration.
    30	#[inline]
    31	pub fn default_schedule() -> FeeSchedule {
    32	    FeeSchedule {
    33	        bps_denom: BPS_DENOM,
    34	        rebate_divisor: REBATE_DIVISOR,
    35	        maker_cap_divisor: MAKER_REBATE_CAP_DIVISOR,
    36	    }
    37	}
    38	
    39	/// Computes the 10% floor tier rebate `floor(gross_fee / REBATE_DIVISOR)`.
    40	#[inline]
    41	pub fn compute_tier_rebate(gross_fee: u64) -> u64 {
    42	    gross_fee / REBATE_DIVISOR
    43	}
    44	
    45	/// Computes a capped passive maker rebate `min(floor(gross_fee / 10), floor(cap_basis / 5))`
    46	/// used by order-book analytics.
    47	#[inline]
    48	pub fn compute_capped_maker_rebate(gross_fee: u64, cap_basis: u64) -> u64 {
    49	    let base_rebate: u64 = gross_fee / REBATE_DIVISOR;
    50	    let max_rebate: u64 = cap_basis / MAKER_REBATE_CAP_DIVISOR;
    51	    if base_rebate <= max_rebate {
    52	        base_rebate
    53	    } else {
    54	        max_rebate
    55	    }
    56	}
    57	
    58	/// Evaluates the active clearing protocol fee quote (`gross_fee`, `rebate`, `net_fee`)
    59	/// from a 65-bit notional sum `sum = amount + fee` using ceiling basis-point division
    60	/// and floor tier rebate.
    61	#[inline]
    62	pub fn evaluate_settlement_fee(sum: WordSum) -> FeeQuote {
    63	    let gross_fee: u64 = ceil_div_bps_u64(sum);
    64	    let rebate: u64 = compute_tier_rebate(gross_fee);
    65	    let net_fee: u64 = gross_fee - rebate;
    66	    FeeQuote {
    67	        gross_fee,
    68	        rebate,
    69	        net_fee,
    70	    }
    71	}
    72	
    73	/// Evaluates a passive liquidity floor fee quote (`floor((amount + fee) / 10_000)`)
    74	/// for pool reserve telemetry.
    75	#[inline]
    76	pub fn evaluate_passive_floor_fee(sum: WordSum) -> FeeQuote {
    77	    let gross_fee: u64 = floor_div_bps_u64(sum);
    78	    let rebate: u64 = compute_tier_rebate(gross_fee);
    79	    let net_fee: u64 = gross_fee - rebate;
    80	    FeeQuote {
    81	        gross_fee,
    82	        rebate,
    83	        net_fee,
    84	    }
    85	}
    86	
    87	/// Computes the rounding spread (`ceil_quote.net_fee - floor_quote.net_fee`)
    88	/// between active ceiling settlement and passive floor settlement.
    89	#[inline]
    90	pub fn compute_fee_rounding_spread(sum: WordSum) -> u64 {
    91	    let ceil_q: FeeQuote = evaluate_settlement_fee(sum);
    92	    let floor_q: FeeQuote = evaluate_passive_floor_fee(sum);
    93	    ceil_q.net_fee - floor_q.net_fee
    94	}
    95	
    96	/// Classifies the fee tier code (`0 = zero`, `1 = retail`, `2 = institutional`)
    97	/// for batch telemetry reporting.
    98	#[inline]
    99	pub fn classify_settlement_tier(sum: WordSum) -> u64 {
   100	    if !sum.high_carry && sum.low_word == 0u64 {
   101	        0u64
   102	    } else if is_institutional_notional(sum) {
   103	        2u64
   104	    } else {
   105	        1u64
   106	    }
   107	}
   108	
   109	#[cfg(test)]
   110	mod tests {
   111	    use super::*;
   112	    use crate::word_math::add_u64_with_carry;
   113	
   114	    #[test]
   115	    fn settlement_fee_and_rebate_rounding() {
   116	        let s = add_u64_with_carry(100_000u64, 25_000u64);
   117	        let q = evaluate_settlement_fee(s);
   118	        assert_eq!(q.gross_fee, 13u64);
   119	        assert_eq!(q.rebate, 1u64);
   120	        assert_eq!(q.net_fee, 12u64);
   121	
   122	        let pf = evaluate_passive_floor_fee(s);
   123	        assert_eq!(pf.gross_fee, 12u64);
   124	        assert_eq!(pf.rebate, 1u64);
   125	        assert_eq!(pf.net_fee, 11u64);
   126	        assert_eq!(compute_fee_rounding_spread(s), 1u64);
   127	    }
   128	
   129	    #[test]
   130	    fn capped_maker_rebate_and_default_schedule() {
   131	        let sched = default_schedule();
   132	        assert_eq!(sched.bps_denom, 10_000u64);
   133	        assert_eq!(compute_capped_maker_rebate(100u64, 30u64), 6u64);
   134	        assert_eq!(compute_capped_maker_rebate(100u64, 100u64), 10u64);
   135	    }
   136	
   137	    #[test]
   138	    fn settlement_tier_classification() {
   139	        assert_eq!(classify_settlement_tier(add_u64_with_carry(0u64, 0u64)), 0u64);
   140	        assert_eq!(classify_settlement_tier(add_u64_with_carry(50_000u64, 100u64)), 1u64);
   141	        assert_eq!(classify_settlement_tier(add_u64_with_carry(INSTITUTIONAL_BAND_MIN, 0u64)), 2u64);
   142	    }
   143	}
-- pool core --
     1	//! Concentrated-liquidity reserve accounting, protocol treasury split, and
     2	//! flash-settlement repayment calculators.
     3	
     4	use crate::constants::*;
     5	use crate::fee_schedule::FeeQuote;
     6	use crate::word_math::{add_u64_with_carry, ceil_div_flash_u64, floor_div_flash_u64};
     7	
     8	/// Breakdown of protocol net fee between treasury reserve and liquidity providers.
     9	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    10	pub struct PoolReserveQuote {
    11	    pub treasury_cut: u64,
    12	    pub lp_retention: u64,
    13	}
    14	
    15	/// Repayment receipt for an atomic flash-liquidity draw.
    16	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    17	pub struct FlashLoanReceipt {
    18	    pub principal: u64,
    19	    pub flash_levy: u64,
    20	    pub total_repayment: u64,
    21	}
    22	
    23	/// Splits `quote.net_fee` between the protocol treasury (`floor(net_fee / 4)`)
    24	/// and liquidity providers (`net_fee - treasury_cut`).
    25	#[inline]
    26	pub fn split_pool_reserve(quote: FeeQuote) -> PoolReserveQuote {
    27	    let treasury_cut: u64 = quote.net_fee / TREASURY_CUT_DIVISOR;
    28	    let lp_retention: u64 = quote.net_fee - treasury_cut;
    29	    PoolReserveQuote {
    30	        treasury_cut,
    31	        lp_retention,
    32	    }
    33	}
    34	
    35	/// Returns the liquidity-provider retention share from a `FeeQuote`.
    36	#[inline]
    37	pub fn quote_lp_retention(quote: FeeQuote) -> u64 {
    38	    let split: PoolReserveQuote = split_pool_reserve(quote);
    39	    split.lp_retention
    40	}
    41	
    42	/// Computes the ceiling flash-settlement levy `ceil((principal + surcharge) / 5_000)`
    43	/// in pure `u64` arithmetic.
    44	#[inline]
    45	pub fn assess_flash_fee_ceil(principal: u64, surcharge: u64) -> u64 {
    46	    let sum = add_u64_with_carry(principal, surcharge);
    47	    ceil_div_flash_u64(sum)
    48	}
    49	
    50	/// Quotes the protocol treasury cut (`floor(flash_levy / 4)`) and liquidity-provider
    51	/// retention (`flash_levy - treasury_cut`) on the ceiling flash-settlement levy.
    52	#[inline]
    53	pub fn quote_flash_lp_retention(principal: u64, surcharge: u64) -> PoolReserveQuote {
    54	    let flash_levy: u64 = assess_flash_fee_ceil(principal, surcharge);
    55	    let treasury_cut: u64 = flash_levy / TREASURY_CUT_DIVISOR;
    56	    let lp_retention: u64 = flash_levy - treasury_cut;
    57	    PoolReserveQuote {
    58	        treasury_cut,
    59	        lp_retention,
    60	    }
    61	}
    62	
    63	/// Computes the floor flash-settlement levy `floor((principal + surcharge) / 5_000)`
    64	/// in pure `u64` arithmetic.
    65	#[inline]
    66	pub fn assess_flash_fee_floor(principal: u64, surcharge: u64) -> u64 {
    67	    let sum = add_u64_with_carry(principal, surcharge);
    68	    floor_div_flash_u64(sum)
    69	}
    70	
    71	/// Quotes a complete flash-loan repayment receipt if `principal + flash_levy` fits in `u64`.
    72	#[inline]
    73	pub fn quote_flash_repayment(principal: u64, surcharge: u64) -> Option<FlashLoanReceipt> {
    74	    let flash_levy: u64 = assess_flash_fee_ceil(principal, surcharge);
    75	    let total_repayment: u64 = principal.checked_add(flash_levy)?;
    76	    Some(FlashLoanReceipt {
    77	        principal,
    78	        flash_levy,
    79	        total_repayment,
    80	    })
    81	}
    82	
    83	/// Verifies whether a pool reserve after crediting `lp_retention` satisfies a target
    84	/// solvency floor `min_reserve`.
    85	#[inline]
    86	pub fn check_pool_reserve_solvency(current_reserve: u64, quote: FeeQuote, min_reserve: u64) -> bool {
    87	    let lp_share: u64 = quote_lp_retention(quote);
    88	    match current_reserve.checked_add(lp_share) {
    89	        Some(updated) => updated >= min_reserve,
    90	        None => true,
    91	    }
    92	}
    93	
    94	#[cfg(test)]
    95	mod tests {
    96	    use super::*;
    97	    use crate::fee_schedule::evaluate_settlement_fee;
    98	
    99	    #[test]
   100	    fn reserve_split_conserves_net_fee() {
   101	        let sum = add_u64_with_carry(500_000u64, 50_000u64);
   102	        let q = evaluate_settlement_fee(sum);
   103	        let split = split_pool_reserve(q);
   104	        assert_eq!(split.treasury_cut + split.lp_retention, q.net_fee);
   105	        assert_eq!(quote_lp_retention(q), split.lp_retention);
   106	        assert!(check_pool_reserve_solvency(1_000u64, q, 1_030u64));
   107	    }
   108	
   109	    #[test]
   110	    fn flash_repayment_receipt_and_overflow_guard() {
   111	        let r = quote_flash_repayment(100_000u64, 1u64).unwrap();
   112	        assert_eq!(r.flash_levy, 21u64);
   113	        assert_eq!(r.total_repayment, 100_021u64);
   114	        let flp = quote_flash_lp_retention(100_000u64, 1u64);
   115	        assert_eq!(flp.treasury_cut, 5u64);
   116	        assert_eq!(flp.lp_retention, 16u64);
   117	        assert_eq!(assess_flash_fee_floor(100_000u64, 1u64), 20u64);
   118	        assert_eq!(quote_flash_repayment(u64::MAX, 1u64), None);
   119	    }
   120	}
