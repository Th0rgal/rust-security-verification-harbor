     1	//! 64-bit word carry/borrow tracking and 128-bit carry-folded quotient kernels.
     2	//!
     3	//! Because two `u64` inputs `lhs` and `rhs` can sum to `[0, 2 * 2^64 - 2]`,
     4	//! computing exact floor and ceiling quotients `floor((lhs + rhs) / D)` and
     5	//! `ceil((lhs + rhs) / D)` without `u128` requires tracking the 1-bit carry flag
     6	//! across the `2^64` word boundary and folding `2^64 = Q_64 * D + R_64`.
     7	
     8	use crate::constants::*;
     9	
    10	/// Represents the exact 65-bit sum `low_word + (high_carry as u64) * 2^64`
    11	/// of two 64-bit unsigned words.
    12	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    13	pub struct WordSum {
    14	    pub low_word: u64,
    15	    pub high_carry: bool,
    16	}
    17	
    18	/// Represents the 64-bit wrapped difference `lhs.wrapping_sub(rhs)` together
    19	/// with an explicit underflow borrow indicator (`lhs < rhs`).
    20	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    21	pub struct WordDiff {
    22	    pub diff_word: u64,
    23	    pub underflow_borrow: bool,
    24	}
    25	
    26	/// Adds two `u64` words in 64-bit register arithmetic and captures the 64-bit
    27	/// overflow carry flag (`low_word < lhs`).
    28	#[inline]
    29	pub fn add_u64_with_carry(lhs: u64, rhs: u64) -> WordSum {
    30	    let low_word: u64 = lhs.wrapping_add(rhs);
    31	    let high_carry: bool = low_word < lhs;
    32	    WordSum {
    33	        low_word,
    34	        high_carry,
    35	    }
    36	}
    37	
    38	/// Subtracts `rhs` from `lhs` in 64-bit register arithmetic and captures the
    39	/// underflow borrow flag (`lhs < rhs`).
    40	#[inline]
    41	pub fn sub_u64_with_borrow(lhs: u64, rhs: u64) -> WordDiff {
    42	    let diff_word: u64 = lhs.wrapping_sub(rhs);
    43	    let underflow_borrow: bool = lhs < rhs;
    44	    WordDiff {
    45	        diff_word,
    46	        underflow_borrow,
    47	    }
    48	}
    49	
    50	/// Extracts the low 16-bit limb `word & 0xFFFF` (`word mod 2^16`).
    51	#[inline]
    52	pub fn extract_low_u16(word: u64) -> u64 {
    53	    word & LIMB_MASK
    54	}
    55	
    56	/// Extracts the low 32-bit limb `word & 0xFFFF_FFFF` (`word mod 2^32`).
    57	#[inline]
    58	pub fn extract_low_u32(word: u64) -> u64 {
    59	    word & LOW32_MASK
    60	}
    61	
    62	/// Extracts the high 32-bit limb `word >> 32` (`floor(word / 2^32)`).
    63	#[inline]
    64	pub fn extract_high_u32(word: u64) -> u64 {
    65	    word >> 32u64
    66	}
    67	
    68	/// Recombines a 32-bit low limb and 32-bit high limb into a 64-bit word.
    69	#[inline]
    70	pub fn pack_u32_limbs(low_u32: u64, high_u32: u64) -> u64 {
    71	    (low_u32 & LOW32_MASK) | ((high_u32 & LOW32_MASK) << 32u64)
    72	}
    73	
    74	/// Classifies whether a 65-bit combined notional `sum` meets or exceeds
    75	/// `INSTITUTIONAL_BAND_MIN`.
    76	#[inline]
    77	pub fn is_institutional_notional(sum: WordSum) -> bool {
    78	    if sum.high_carry {
    79	        true
    80	    } else {
    81	        sum.low_word >= INSTITUTIONAL_BAND_MIN
    82	    }
    83	}
    84	
    85	/// Computes the exact remainder `(lhs + rhs) mod BPS_DENOM` (`BPS_DENOM = 10_000`)
    86	/// over the full 65-bit `WordSum` range in pure `u64` arithmetic.
    87	#[inline]
    88	pub fn rem_bps_u64(sum: WordSum) -> u64 {
    89	    if sum.high_carry {
    90	        ((sum.low_word % BPS_DENOM) + U64_MOD_BPS_REM) % BPS_DENOM
    91	    } else {
    92	        sum.low_word % BPS_DENOM
    93	    }
    94	}
    95	
    96	/// Computes the exact floor quotient `floor((lhs + rhs) / BPS_DENOM)` (`BPS_DENOM = 10_000`)
    97	/// over the full 65-bit `WordSum` range using pure `u64` carry folding.
    98	#[inline]
    99	pub fn floor_div_bps_u64(sum: WordSum) -> u64 {
   100	    if sum.high_carry {
   101	        let folded_rem: u64 = (sum.low_word % BPS_DENOM) + U64_MOD_BPS_REM;
   102	        U64_MOD_BPS_QUOT + (sum.low_word / BPS_DENOM) + (folded_rem / BPS_DENOM)
   103	    } else {
   104	        sum.low_word / BPS_DENOM
   105	    }
   106	}
   107	
   108	/// Computes the ceiling quotient `ceil((lhs + rhs) / BPS_DENOM)` (`BPS_DENOM = 10_000`),
   109	/// equivalent in exact integer arithmetic to `floor((lhs + rhs + 9_999) / 10_000)`,
   110	/// over the full 65-bit `WordSum` range using pure `u64` arithmetic.
   111	#[inline]
   112	pub fn ceil_div_bps_u64(sum: WordSum) -> u64 {
   113	    if sum.high_carry {
   114	        let folded_rem: u64 = (sum.low_word % BPS_DENOM) + U64_MOD_BPS_REM;
   115	        U64_MOD_BPS_QUOT + (sum.low_word / BPS_DENOM) + ((folded_rem + BPS_MAX_REM) / BPS_DENOM)
   116	    } else {
   117	        let biased: u64 = sum.low_word.wrapping_add(BPS_MAX_REM);
   118	        if biased < sum.low_word {
   119	            (sum.low_word / BPS_DENOM) + (((sum.low_word % BPS_DENOM) + BPS_MAX_REM) / BPS_DENOM)
   120	        } else {
   121	            biased / BPS_DENOM
   122	        }
   123	    }
   124	}
   125	
   126	/// Computes the exact floor quotient `floor((lhs + rhs) / FLASH_DENOM)` (`FLASH_DENOM = 5_000`)
   127	/// over the full 65-bit `WordSum` range in pure `u64` arithmetic.
   128	#[inline]
   129	pub fn floor_div_flash_u64(sum: WordSum) -> u64 {
   130	    if sum.high_carry {
   131	        let folded_rem: u64 = (sum.low_word % FLASH_DENOM) + U64_MOD_FLASH_REM;
   132	        U64_MOD_FLASH_QUOT + (sum.low_word / FLASH_DENOM) + (folded_rem / FLASH_DENOM)
   133	    } else {
   134	        sum.low_word / FLASH_DENOM
   135	    }
   136	}
   137	
   138	/// Computes the exact ceiling quotient `ceil((lhs + rhs) / FLASH_DENOM)` (`FLASH_DENOM = 5_000`),
   139	/// equivalent to `floor((lhs + rhs + 4_999) / 5_000)`, in pure `u64` arithmetic.
   140	#[inline]
   141	pub fn ceil_div_flash_u64(sum: WordSum) -> u64 {
   142	    if sum.high_carry {
   143	        let folded_rem: u64 = (sum.low_word % FLASH_DENOM) + U64_MOD_FLASH_REM;
   144	        U64_MOD_FLASH_QUOT + (sum.low_word / FLASH_DENOM) + ((folded_rem + FLASH_MAX_REM) / FLASH_DENOM)
   145	    } else {
   146	        let biased: u64 = sum.low_word.wrapping_add(FLASH_MAX_REM);
   147	        if biased < sum.low_word {
   148	            (sum.low_word / FLASH_DENOM) + ((biased + U64_MOD_FLASH_REM) / FLASH_DENOM)
   149	        } else {
   150	            biased / FLASH_DENOM
   151	        }
   152	    }
   153	}
