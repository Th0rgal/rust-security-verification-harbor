[614.87421, "o", "\r\n\u001b[?2004l\r-- word_math.rs part 1 --\r\n\u001b[?2004h"]
[614.874257, "o", "root@f42cb2236dfa:/workspace/challenge# nl -ba /workspace/challenge/src/word_math.rs | sed -n '1,180p'"]
[614.874559, "o", "\r\n"]
