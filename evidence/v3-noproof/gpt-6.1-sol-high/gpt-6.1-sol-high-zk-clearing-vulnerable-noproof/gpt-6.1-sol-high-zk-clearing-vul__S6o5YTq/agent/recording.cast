[142.975925, "o", "\t        })\r\n   128\t    } else {\r\n   129\t"]
[142.976024, "o", "        None\r\n   130\t    }\r\n   131\t}\r\n   132\t\r\n   133\t/// Computes the post-settlement remaining account balance for telemetry, saturating at zero.\r\n   134\t#[inline]\r\n   135\tpub fn preview_remaining_balance(balance: u64, ticket: ClearingTicket) -> u64 {\r\n   136\t    balance.saturating_sub(ticket.total_debit)"]
[142.976254, "o", "\r\n   137\t}\r\n   138\t\r\n   139"]
