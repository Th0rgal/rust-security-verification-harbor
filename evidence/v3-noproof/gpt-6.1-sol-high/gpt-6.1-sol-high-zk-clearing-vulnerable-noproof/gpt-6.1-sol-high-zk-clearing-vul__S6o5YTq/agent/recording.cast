[468.293133, "i", "cd /workspace/challenge && mkdir -p examples && cat > examples/check.rs <<'EOF'\nuse settlement_gate::broadword_swar::*;\nuse settlement_gate::clearing_pipeline::*;\nuse settlement_gate::goldilocks_field::*;\nuse settlement_gate::word_math::*;\nfn ref_bytes(x:u64)->(u64,u64,u64){let mut n=0;let mut s=0;for i in 0..8{let b=(x>>(8*i))&255;s+=b;if b!=0{n+=1}};(n,s,(n<<8)+s)}\nfn ref_mod128(lo:u64,hi:u64,p:u128)->u64{(((lo as u128)+((hi as u128)<<64))%p) as u64}\nfn main(){\n let vals=[0,1,2,3,90,255,256,9999,10000,32771,65535,1u64<<32,u64::MAX/2,u64::MAX-1000,u64::MAX-1,u64::MAX];\n for &x in &vals {let q=quote_calldata_lane_surcharge(x);let r=ref_bytes(x);assert_eq!((q.active_lanes,q.byte_weight_sum,q.surcharge),r,\"byte mismatch x={x}\");}\n for &a in &vals {for &f in &vals {let q=quote_bridge_verifier_fee(a,f);let rr=ref_mod128(a,f,0xffff_ffff_0000_0001u128);assert_eq!(q.bridge_fee,rr,\"gold mismatch a={a} f={f} got={} want={rr}\",q.bridge_fee);let _=compute_clearing_breakdown(a,f);}}\n println!(\"differential checks passed\");\n}\nEOF\ncargo run --release --example check\nrm -f examples/check.rs; rmdir examples 2>/dev/null || true\n"]
