[418.150544, "o", "\u001b[K\u001b[0m\u001b[1m\u001b[38;5;9merror\u001b[0m\u001b[0m\u001b[1m: format argument must be a string literal\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m--> \u001b[0m\u001b[0mexamples/check.rs:14:137\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m14\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0m for &x in &vals {let q=quote_calldata_lane_surcharge(x);let r=ref_bytes(x);assert_eq!((q.active_lanes,q.byte_weight_sum,q.surcharge),r,(x,q,r));}\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m                                                                                                                                         \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;9m^^^^^^^\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;14mhelp\u001b[0m\u001b[0m: you might be missing a string literal to format with\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m14\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m| \u001b[0m\u001b[0m for &x in &vals {let q=quote_calldata_lane_surcharge(x);let r=ref_bytes(x);assert_eq!((q.active_lanes,q.byte_weight_sum,q.surcharge),r,\u001b[0m\u001b[0m\u001b[38;5;10m\"{}\", \u001b[0m\u001b[0m(x,q,r));}\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m                                                                                                                                         \u001b[0m\u001b[0m\u001b[38;5;10m+++++\u001b[0m\r\n\r\n\u001b[0m\u001b[1m\u001b[38;5;9merror\u001b[0m\u001b[0m\u001b[1m: format argument must be a string literal\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m--> \u001b[0m\u001b[0mexamples/check.rs:15:217\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m15\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m...\u001b[0m\u001b[0mod128(a,f,0xffff_ffff_0000_0001u128);assert_eq!(q.bridge_fee,rr,(a,f,q.bridge_fee,rr));let t=quote_clearing_ticket(a,f);if let Some(t)=t {assert_eq!(\u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m...\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m                                                                    \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;9m^^^^^^^^^^^^^^^^^^^^^\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;14mhelp\u001b[0m\u001b[0m: you might be missing a string literal to format with\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m15\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m| \u001b[0m\u001b[0m for &a in &vals {for &f in &vals {let s=add_u64_with_carry(a,f);let b=compute_clearing_breakdown(a,f);let q=quote_bridge_verifier_fee(a,f);let rr=ref_mod128(a,f,0xffff_ffff_0000_0001u128);assert_eq!(q.bridge_fee,rr,\u001b[0m\u001b[0m\u001b[38;5;10m\"{}\", \u001b[0m\u001b[0m(a,f,q.bridge_fee,rr));let t=quote_clearing_ticket(a,f);if let Some(t)=t {assert_eq!(t.total_debit,a.checked_add(t.total_surcharge).unwrap());}let _=s;let _=b;}}\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m                                                                                                                                                                                                                         \u001b[0m\u001b[0m\u001b[38;5;10m+++++\u001b[0m\r\n\r\n\u001b[1m\u001b[36m    Building\u001b[0m [=============>               ] 1/2: check(example)                                                                                            