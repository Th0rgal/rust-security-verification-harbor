[615.817846, "o", "root@f42cb2236dfa:/workspace/challenge# "]
[615.817892, "o", "nl -ba /workspace/challenge/src/clearing_pipeline.rs | sed -n '1,190p'"]
[615.818362, "o", "\r\n\u001b[?2004l\r"]
[615.823639, "o", "     1"]
[615.824224, "o", "\t//! Multi-stage rollup batch clearing pipeline and settlement ticket gate.\r\n     2\t//!\r\n     3\t//! Coordinates the protocol surcharge subsystems across `word_math`, `fee_schedule`,\r\n     4\t//! `liquidity_pool`, `reciprocal_div`, `broadword_swar`, `montgomery_field`,\r\n     5\t//! `goldilocks_field`, and `transcript_codec` to price and authorize a batch\r\n     6\t//! clearing request `(balance, amount, fee)`.\r\n     7\t//!\r\n     8\t//! The combined protocol surcharge is added to the transfer principal `amount`\r\n     9\t//! via checked `u64` addition, and the resulting `ClearingTicket` is committed\r\n    10\t//! if and only if `total_debit <= balance`.\r\n    11\t"]
[615.824468, "o", "\r\n    12\tuse crate::Authorization;\r\n    13\tuse crate::broadword_swar::{CalldataLaneQuote, quote_calldata_lane_surcharge};\r\n    14\tuse crate::fee_schedule::{FeeQuote, evaluate_settlement_fee};\r\n    15\t"]
[615.824714, "o", "use crate::goldilocks_field::{GoldilocksQuote, quote_bridge_verifier_fee};\r\n    16\tuse crate::liquidity_pool::{PoolReserveQuote, quote_flash_lp_retention};\r\n    17\tuse crate::montgomery_field::{ProverLevyQuote, quote_prover_transcript_levy};\r\n    18\tuse crate::reciprocal_div::{BlobSlotQuote, quote_blob_gas_slots};\r\n    19\tuse crate::transcript_codec::decode_domain_tag;\r\n    20\tuse crate::word_math::{WordSum, add_u64_with_carry};\r\n    21"]
[615.825045, "o", "\t\r\n    22\t/// Itemized multi-stage surcharge breakdown for a rollup clearing operation.\r\n    23\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    24\tpub struct ClearingBreakdown {\r\n    25\t    pub net_bps_fee: u64,\r\n    26\t    pub flash_lp_fee: u64,\r\n    27\t"]
[615.825717, "o", "    pub blob_slot_quotient: u64,\r\n    28\t    pub calldata_surcharge: u64,\r\n    29\t    pub prover_levy: u64,\r\n    30\t    pub domain_surcharge: u64,\r\n    31\t    pub base_surcharge: u64,\r\n    32\t    pub bridge_surcharge: u64,\r\n    33\t}\r\n    34\t\r\n    35\t/// Validated clearing settlement ticket ready for balance conservation check."]
[615.825785, "o", "\r\n    36\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    37\tpub struct ClearingTicket {\r\n    38\t    pub principal: u64,\r\n    39\t    pub net_bps_fee: u64,\r\n    40\t    pub flash_lp_fee: u64,\r\n    41\t    pub blob_slot_quotient: u64,\r\n    42\t"]
[615.825847, "o", "    pub calldata_surcharge: u64,\r\n    43"]
[615.82631, "o", "\t    pub prover_levy: u64,\r\n    44"]
[615.826961, "o", "\t    pub domain_surcharge: u64,\r\n    45\t    pub bridge_surcharge: u64,\r\n    46\t    pub total_surcharge: u64,\r\n    47\t    pub total_debit: u64,"]
[615.827024, "o", "\r\n    48\t}\r\n    49\t\r\n    50\t/// Evaluates all protocol surcharge stages for `(amount, fee)` and packages them into\r\n    51\t/// a `ClearingBreakdown`.\r\n    52\t#[inline]\r\n    53\tpub fn compute_clearing_breakdown(amount: u64, fee: u64) -> ClearingBreakdown {\r\n    54\t    let notional_sum: WordSum = add_u64_with_carry(amount, fee);\r\n    55\t    let fee_quote: FeeQuote = evaluate_settlement_fee(notional_sum);\r\n    56\t    let flash_quote: PoolReserveQuote = quote_flash_lp_retention(amount, fee);\r\n    57\t    let blob_quote: BlobSlotQuote = quote_blob_gas_slots(amount, fee);\r\n    58\t    let lane_quote: CalldataLaneQuote = quote_calldata_lane_surcharge(fee);\r\n    59\t    let levy_quote: ProverLevyQuote = quote_prover_transcript_levy(amount, fee);\r\n    60\t    let bridge_quote: GoldilocksQuote = quote_bridge_verifier_fee(amount, fee);\r\n    61\t    let domain_surcharge: u64 = decode_domain_tag(fee);\r\n    62\t\r\n    63\t    let net_bps_fee: u64 = fee_quote.net_fee;\r\n    64\t    let flash_lp_fee: u64 = flash_quote.lp_retention;\r\n    65\t    let blob_slot_quotient: u64 = blob_quote.slot_quotient;\r\n    66\t    let calldata_surcharge: u64 = lane_quote.surcharge;\r\n    67\t    let prover_levy: u64 = levy_quote.prover_levy;\r\n    68\t    let bridge_surcharge: u64 = bridge_quote.bridge_fee;\r\n    69\t\r\n    70\t    let base_surcharge: u64 = net_bps_fee\r\n    71\t        + flash_lp_fee\r\n    72\t        + blob_slot_quotient\r\n    73\t        + calldata_surcharge\r\n    74\t        + prover_levy\r\n    75\t        + domain_surcharge;\r\n    76\t\r\n    77\t    ClearingBreakdown {\r\n    78\t        net_bps_fee,\r\n    79\t        flash_lp_fee,\r\n    80\t        blob_slot_quotient,\r\n    81\t        calldata_surcharge,\r\n    82\t        prover_levy,\r\n    83\t        domain_surcharge,\r\n    84\t        base_surcharge,\r\n    85\t        bridge_surcharge,\r\n    86\t    }\r\n    87\t}\r\n    88\t\r\n    89\t/// Assembles a `ClearingTicket` from `amount` and `breakdown`, returning `None`\r\n    90\t/// if `amount + breakdown.base_surcharge + breakdown.bridge_surcharge` exceeds `u64::MAX`.\r\n    91\t#[inline]\r\n    92\tpub fn assemble_clearing_ticket(\r\n    93\t    amount: u64,\r\n    94\t    breakdown: ClearingBreakdown,\r\n    95\t) -> Option<ClearingTicket> {\r\n    96\t    let total_surcharge: u64 = breakdown\r\n    97\t        .base_surcharge\r\n    98\t        .checked_add(breakdown.bridge_surcharge)?;\r\n    99\t    let total_debit: u64 = amount.checked_add(total_surcharge)?;\r\n   100\t    Some(ClearingTicket {\r\n   101\t        principal: amount,\r\n   102\t        net_bps_fee: breakdown.net_bps_fee,\r\n   103\t        flash_lp_fee: breakdown.flash_lp_fee,\r\n   104\t        blob_slot_quotient: breakdown.blob_slot_quotient,\r\n   105\t        calldata_surcharge: breakdown.calldata_surcharge,\r\n   106\t        prover_levy: breakdown.prover_levy,\r\n   107\t        domain_surcharge: breakdown.domain_surcharge,\r\n   108\t        bridge_surcharge: breakdown.bridge_surcharge,\r\n   109\t        total_surcharge,\r\n   110\t        total_debit,\r\n   111\t    })\r\n   112\t}\r\n   113\t\r\n   114\t/// Quotes a complete `ClearingTicket` for `(amount, fee)`.\r\n   115\t#[inline]\r\n   116\tpub fn quote_clearing_ticket(amount: u64, fee: u64) -> Option<ClearingTicket> {\r\n   117\t    let breakdown: ClearingBreakdown = compute_clearing_breakdown(amount, fee);\r\n   118\t    assemble_clearing_ticket(amount, breakdown)\r\n   119\t}\r\n   120\t\r\n   121\t/// Commits a `ClearingTicket` against `balance`, authorizing iff `ticket.total_debit <= balance`.\r\n   122\t#[inline]\r\n   123\tpub fn commit_clearing_ticket(balance: u64, ticket: ClearingTicket) -> Option<Authorization> {\r\n   124\t    if ticket.total_debit <= balance {\r\n   125\t        Some(Authorization {\r\n   126\t            total_debit: ticket.total_debit,\r\n   127\t        })\r\n   128\t    } else {\r\n   129\t        None\r\n   130\t    }\r\n   131\t}\r\n   132\t\r\n   133\t/// Computes the post-settlement remaining account balance for telemetry, saturating at zero.\r\n   134\t#[inline]\r\n   135\tpub fn preview_remaining_balance(balance: u64, ticket: ClearingTicket) -> u64 {\r\n   136\t    balance.saturating_sub(ticket.total_debit)\r\n   137\t}\r\n   138\t\r\n   139\t/// Verifies internal "]
[615.82811, "o", "surcharge conservation on an assembled `ClearingTicket`.\r\n   140\t#[inline]\r\n   141\tpub fn verify_ticket_conservation(ticket: ClearingTicket) -> bool {\r\n   142\t    let recomputed_base: u64 = ticket.net_bps_fee\r\n   143\t        + ticket.flash_lp_fee\r\n   144\t        + ticket.blob_slot_quotient\r\n   145\t        + ticket.calldata_surcharge\r\n   146\t        + ticket.prover_levy\r\n   147\t        + ticket.domain_surcharge;\r\n   148\t    (recomputed_base.wrapping_add(ticket.bridge_surcharge) == ticket.total_surcharge)\r\n   149\t        && (ticket.principal.wrapping_add(ticket.total_surcharge) == ticket.total_debit)\r\n   150\t}\r\n   151\t\r\n   152\t#[cfg(test)]\r\n   153\tmod tests {\r\n   154\t    use super::*;\r\n   155\t\r\n   156\t    #[test]\r\n   157\t    fn zero_transfer_breakdown_carries_default_domain_tag() {\r\n   158\t        let b = compute_clearing_breakdown(0u64, 0u64);\r\n   159\t        assert_eq!(b.net_bps_fee, 0u64);\r\n   160\t        assert_eq!(b.flash_lp_fee, 0u64);\r\n   161\t        assert_eq!(b.blob_slot_quotient, 0u64);\r\n   162\t        assert_eq!(b.calldata_surcharge, 0u64);\r\n   163\t        assert_eq!(b.prover_levy, 0u64);\r\n   164\t        assert_eq!(b.domain_surcharge, 90u64);\r\n   165\t        assert_eq!(b.base_surcharge, 90u64);\r\n   166\t        assert_eq!(b.bridge_surcharge, 0u64);\r\n   167\t    }\r\n   168\t\r\n   169\t    #[test]\r\n   170\t    fn ticket_overflow_rejected_near_u64_max() {\r\n   171\t        assert_eq!(quote_clearing_ticket(u64::MAX, 1u64), None);\r\n   172\t        assert_eq!(quote_clearing_ticket(u64::MAX, u64::MAX), None);\r\n   173\t    }\r\n   174\t\r\n   175\t    #[test]\r\n   176\t    fn remaining_balance_preview_and_ticket_conservation() {\r\n   177\t        let t = quote_clearing_ticket(0u64, 1u64).unwrap();\r\n   178\t        assert_eq!(t.total_debit, 4_294_967_557u64);\r\n   179\t        assert!(verify_ticket_conservation(t));\r\n   180\t        assert_eq!(preview_remaining_balance(4_294_967_600u64, t), 43u64);\r\n   181\t        assert_eq!(preview_remaining_balance(200u64, t), 0u64);\r\n   182\t    }\r\n   183\t}\r\n"]
