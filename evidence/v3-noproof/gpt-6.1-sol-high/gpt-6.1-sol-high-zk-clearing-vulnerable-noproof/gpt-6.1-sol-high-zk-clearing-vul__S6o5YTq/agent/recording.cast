[615.279006, "o", "printf '%s\\n' '-- word_math.rs part 2 --'\r\n\u001b[?2004l\r-- word_math.rs part 2 --\r\n\u001b[?2004hroot@f42cb2236dfa:/workspace/challenge# nl -ba /workspace/challenge/src/word_math.rs | sed -n '181,360p'\r\n\u001b[?2004l\r"]
[615.27942, "o", "   181\t        assert_eq!(extract_low_u32(w), 0x9ABC_DEF0u64);\r\n   182"]
[615.279464, "o", "\t        assert_eq!(extract_high_u32(w), 0x1234_5678u64);\r\n   183\t        assert_eq!(pack_u32_limbs(extract_low_u32(w), extract_high_u32(w)), w);\r\n   184"]
[615.279497, "o", "\t    }\r\n   185"]
[615.279534, "o", "\t\r\n   186\t"]
[615.279573, "o", "    #[test]\r\n   187\t    fn bps_floor_and_ceil_at_zero_and_u64_max() {"]
[615.279605, "o", "\r\n   188\t        let z = add_u64_with_carry(0u64, 0u64);\r\n"]
[615.279642, "o", "   189\t        assert_eq!(floor_div_bps_u64(z), 0u64);\r\n   190"]
[615.279672, "o", "\t        assert_eq!(ceil_div_bps_u64(z), 0u64);\r\n   191"]
[615.279712, "o", "\t        assert_eq!(rem_bps_u64(z), 0u64);\r\n   192\t"]
[615.279744, "o", "\r\n   193\t        let one = add_u64_with_carry(1u64, 0u64);\r\n"]
[615.279778, "o", "   194\t        assert_eq!(floor_div_bps_u64(one), 0u64);\r\n"]
[615.279805, "o", "   195\t        assert_eq!(ceil_div_bps_u64(one), 1u64);\r\n"]
[615.279834, "o", "   196\t        assert_eq!(rem_bps_u64(one), 1u64);"]
[615.279861, "o", "\r\n   197\t\r\n"]
[615.279891, "o", "   198\t        let at_max = add_u64_with_carry(0u64, u64::MAX);\r\n"]
[615.279925, "o", "   199\t"]
[615.279964, "o", "        assert_eq!(floor_div_bps_u64(at_max), 1_844_674_407_370_955u64);\r\n   200\t        assert_eq!(ceil_div_bps_u64(at_max), 1_844_674_407_370_956u64);"]
[615.279993, "o", "\r\n   201\t        assert_eq!(rem_bps_u64(at_max), 1_615u64);\r\n"]
[615.280021, "o", "   202\t    }"]
[615.280051, "o", "\r\n   203\t\r\n"]
[615.280081, "o", "   204\t    #[test]\r\n"]
[615.280108, "o", "   205\t    fn bps_carry_folding_above_u64_max() {\r\n"]
[615.280136, "o", "   206\t        let wrapped = add_u64_with_carry(10_000u64, u64::MAX);\r\n"]
[615.280161, "o", "   207\t        assert!(wrapped.high_carry);"]
[615.280194, "o", "\r\n   208\t        assert_eq!(floor_div_bps_u64(wrapped), 1_844_674_407_370_956u64);"]
[615.280219, "o", "\r\n   209\t        assert_eq!(ceil_div_bps_u64(wrapped), 1_844_674_407_370_957u64);\r\n"]
[615.281188, "o", "   210\t        assert_eq!(rem_bps_u64(wrapped), 1_615u64);\r\n   211\t\r\n   212\t        let double_max = add_u64_with_carry(u64::MAX, u64::MAX);\r\n   213\t        assert_eq!(floor_div_bps_u64(double_max), 3_689_348_814_741_910u64);\r\n   214\t        assert_eq!(ceil_div_bps_u64(double_max), 3_689_348_814_741_911u64);\r\n   215\t    }\r\n   216\t\r\n   217\t    #[test]\r\n   218\t    fn flash_floor_and_ceil_across_boundaries() {\r\n   219\t        let s = add_u64_with_carry(0u64, u64::MAX - 500u64);\r\n   220\t        assert_eq!(ceil_div_flash_u64(s), 3_689_348_814_741_911u64);\r\n   221\t        assert_eq!(floor_div_flash_u64(s), 3_689_348_814_741_910u64);\r\n   222\t\r\n   223\t        let s_hi = add_u64_with_carry(u64::MAX, 5_000u64);\r\n   224\t        assert!(is_institutional_notional(s_hi));\r\n   225\t        assert_eq!(floor_div_flash_u64(s_hi), 3_689_348_814_741_911u64);\r\n   226\t        assert_eq!(ceil_div_flash_u64(s_hi), 3_689_348_814_741_912u64);\r\n   227\t    }\r\n   228\t}\r\n\u001b[?2004hroot@f42cb2236dfa:/workspace/challenge# "]
[615.542987, "i", "printf '%s\\n' '-- goldilocks_field.rs --'\nnl -ba /workspace/challenge/src/goldilocks_field.rs | sed -n '1,125p'\n"]
[615.543422, "o", "printf '%s\\n' '-- goldilocks_field.rs --'"]
[615.545885, "o", "\r\n\u001b[?2004l\r"]
[615.54617, "o", "-- goldilocks_field.rs --\r\n\u001b[?2004hroot@f42cb2236dfa:/workspace/challenge# nl -ba /workspace/challenge/src/goldilocks_field.rs | sed -n '1,125p'\r\n\u001b[?2004l\r"]
[615.577361, "o", "     1\t//! `recmo/goldilocks` 128-bit prime field reduction (`P_G = 2^64 - 2^32 + 1`)\r\n     2\t//! for cross-chain L1 bridge verification fee quotes.\r\n     3\t//!"]
[615.577639, "o", "\r\n     4\t//! Because `2^64 ≡ 2^32 - 1 = EPS (mod P_G)`, a 128-bit integer `x_lo + x_hi * 2^64`\r\n     5\t//! is reduced modulo `P_G` in pure `u64` arithmetic by splitting `x_hi` into its\r\n     6\t//! high 32-bit limb `x_hi_hi = x_hi >> 32` and low 32-bit limb `x_hi_lo = x_hi & EPS`:\r\n     7"]
[615.577819, "o", "\t//! 1. Subtract `x_hi_hi` from `x_lo` (compensating by `-EPS` on borrow).\r\n     8\t//! 2. Add `x_hi_lo * EPS` (compensating by `+EPS` on 64-bit carry).\r\n     9\t//! 3. Canonicalize into `[0, P_G - 1]` by subtracting `P_G` if `r >= P_G`.\r\n    10\t\r\n    11\tuse crate::constants::*;\r\n    12\t\r\n    13\t/// Bridge verifier fee quote produced by Goldilocks 128-bit reduction.\r\n    14\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    15\tpub struct GoldilocksQuote {\r\n    16\t    pub folded_low: u64,\r\n    17\t    pub canonical_residue: u64,\r\n    18\t    pub bridge_fee: u64,\r\n    19\t}"]
[615.577927, "o", "\r\n    20\t\r\n    21\t/// Performs the first Goldilocks folding step `x_lo - (x_hi >> 32) mod 2^64`,\r\n    22\t/// returning `(r0, borrow)`.\r\n    23\t#[inline]\r\n    24\tpub fn reduce_goldilocks_step1(x_lo: u64, x_hi: u64) -> (u64, bool) {\r\n    25\t    let x_hi_hi: u64 = x_hi >> 32u64;\r\n    26\t    x_lo.overflowing_sub(x_hi_hi)\r\n    27\t}\r\n"]
[615.578219, "o", "    28\t\r\n    29\t/// Reduces a 128-bit value `(x_lo, x_hi)` modulo the Goldilocks prime\r\n    30\t/// `GOLDILOCKS_P = 0xFFFF_FFFF_0000_0001` in pure `u64` arithmetic.\r\n    31\t#[inline]\r\n    32\tpub fn reduce_goldilocks_128(x_lo: u64, x_hi: u64) -> u64 {\r\n"]
[615.578276, "o", "    33\t    let x_hi_lo: u64 = x_hi & GOLDILOCKS_EPS;\r\n    34\t    let (t0, borrow): (u64, bool) = reduce_goldilocks_step1(x_lo, x_hi);\r\n    35\t    let t1: u64 = if borrow {\r\n    36\t        t0.wrapping_add(GOLDILOCKS_P)\r\n    37\t    } else {\r\n    38\t        t0\r\n    39\t    };\r\n    40\t    let prod: u64 = x_hi_lo * GOLDILOCKS_EPS;\r\n    41\t    let (t2, carry): (u64, bool) = t1.overflowing_add(prod);\r\n    42\t    let t3: u64 = if carry {\r\n    43\t        t2.wrapping_add(GOLDILOCKS_EPS)\r\n    44\t    } else {\r\n    45\t        t2\r\n    46\t    };"]
[615.578493, "o", "\r\n    47\t    if t3 >= GOLDILOCKS_P {\r\n    48\t        t3 - GOLDILOCKS_P"]
[615.578593, "o", "\r\n    49\t    } else {\r\n    50\t        t3\r\n    51\t    }\r\n    52\t}\r\n    53\t\r\n    54\t/// Canonicalizes a single 64-bit word `x` modulo `GOLDILOCKS_P`.\r\n    55\t#[inline]\r\n    56\tpub fn canonicalize_goldilocks_u64(x: u64) -> u64 {\r\n    57\t    if x >= GOLDILOCKS_P {\r\n    58\t        x - GOLDILOCKS_P\r\n    59\t    } else {"]
[615.579072, "o", "\r\n    60\t        x\r\n    61\t    }\r\n    62\t}\r\n    63\t\r\n    64\t/// Canonical modular addition `(a + b) mod GOLDILOCKS_P` for `a, b < GOLDILOCKS_P`.\r\n    65\t#[inline]\r\n    66\tpub fn add_goldilocks_mod(a: u64, b: u64) -> u64 {\r\n    67\t    reduce_goldilocks_128(a.wrapping_add(b), if a.wrapping_add(b) < a { 1u64 } else { 0u64 })\r\n    68\t}\r\n    69\t\r\n    70\t/// Canonical modular subtraction `(a - b) mod GOLDILOCKS_P` for `a, b < GOLDILOCKS_P`.\r\n    71\t#[inline]\r\n"]
[615.579131, "o", "    72\tpub fn sub_goldilocks_mod(a: u64, b: u64) -> u64 {\r\n    73\t    let ca: u64 = canonicalize_goldilocks_u64(a);\r\n    74\t    let cb: u64 = canonicalize_goldilocks_u64(b);\r\n    75\t    if ca >= cb {\r\n    76\t        ca - cb\r\n    77\t    } else {\r\n    78\t        (GOLDILOCKS_P - cb) + ca\r\n    79\t    }\r\n    80\t}\r\n    81\t\r\n    82\t/// Folds a 64-bit commitment word with a 32-bit challenge scalar in the Goldilocks field.\r\n    83\t#[inline]\r\n    84\tpub fn fold_goldilocks_challenge(commitment: u64, challenge_u32: u64) -> u64 {\r\n    85\t    let scalar: u64 = challenge_u32 & LOW32_MASK;\r\n    86\t    let lo_limb: u64 = commitment & LOW32_MASK;\r\n"]
[615.579218, "o", "    87\t    let hi_limb: u64 = commitment >> 32u64;\r\n    88\t    let prod_lo: u64 = lo_limb * scalar;\r\n"]
[615.579275, "o", "    89\t    let prod_hi: u64 = hi_limb * scalar;\r\n    90\t    let x_lo: u64 = prod_lo.wrapping_add(prod_hi << 32u64);\r\n    91\t    let carry: u64 = if x_lo < prod_lo { 1u64 } else { 0u64 };\r\n    92\t    let x_hi: u64 = (prod_hi >> 32u64) + carry;\r\n    93"]
[615.579357, "o", "\t    reduce_goldilocks_128(x_lo, x_hi)\r\n    94\t}\r\n    95\t\r\n"]
[615.579606, "o", "    96\t/// Quotes a cross-chain bridge verifier fee from `(amount, fee)` in the Goldilocks field.\r\n    97\t#[inline]\r\n    98\tpub fn quote_bridge_verifier_fee(amount: u64, fee: u64) -> GoldilocksQuote {\r\n    99\t    let (folded_low, _borrow): (u64, bool) = reduce_goldilocks_step1(amount, fee);\r\n   100\t    let canonical_residue: u64 = reduce_goldilocks_128(amount, fee);\r\n   101\t"]
[615.580007, "o", "    let bridge_fee: u64 = canonical_residue;\r\n   102\t    GoldilocksQuote {\r\n   103\t        folded_low,\r\n   104\t        canonical_residue,\r\n   105\t        bridge_fee,\r\n   106\t    }\r\n   107\t}\r\n   108\t\r\n   109\t#[cfg(test)]\r\n   110\tmod tests {\r\n   111\t    use super::*;\r\n   112\t\r\n   113\t    #[test]\r\n   114\t    fn goldilocks_canonicalization_at_modulus_boundary() {\r\n   115\t        assert_eq!(reduce_goldilocks_128(0u64, 0u64), 0u64);\r\n   116\t        assert_eq!(reduce_goldilocks_128(GOLDILOCKS_P, 0u64), 0u64);\r\n   117\t"]
[615.580104, "o", "        assert_eq!(reduce_goldilocks_128(0u64, 1u64), GOLDILOCKS_EPS);\r\n   118\t        assert_eq!(reduce_goldilocks_128(0u64, 4_294_967_296u64), GOLDILOCKS_P - 1u64);\r\n   119\t        assert_eq!(reduce_goldilocks_128(1u64, 4_294_967_296u64), 0u64);"]
[615.580176, "o", "\r\n   120\t        assert_eq!(canonicalize_goldilocks_u64(GOLDILOCKS_P + 5u64), 5u64);\r\n   121\t    }\r\n   122\t\r\n   123\t    #[test]\r\n   124\t"]
[615.583224, "o", "    fn goldilocks_bridge_quote_and_modular_add_sub() {\r\n   125\t        let q = quote_bridge_verifier_fee(100u64, 0u64);\r\n"]
[615.583744, "o", "\u001b[?2004hroot@f42cb2236dfa:/workspace/challenge# "]
