[614.300528, "o", "     1\t//! Multiprecision 2-by-1 normalized reciprocal division (`alloy-rs/ruint` algorithm)\r\n     2\t//! for L1 data-availability blob gas slot partitioning.\r\n     3\t//!\r\n     4\t//! Given a normalized 16-bit divisor `D = MG10_DIVISOR = 0x8003 = 32_771` (`2^15 + 3`)\r\n     5\t//! with precomputed reciprocal `V = floor((2^32 - 1) / D) - 2^16 = 0xFFF4 = 65_524`,\r\n     6\t//! `div_2x1_mg10(u1, u0)` computes the exact floor quotient\r\n     7\t//! `floor((u1 * 2^16 + u0) / D)` for all `u1 < D` and `u0 < 2^16` using only\r\n     8\t//! shifts, bitwise masks, and `u64` multiplications (without hardware `/` or `%`\r\n     9\t//! in the core reciprocal step).\r\n    10\t\r\n    11\tuse crate::constants::*;\r\n    12\tuse crate::word_math::extract_low_u16;\r\n    13\t\r\n    14\t/// Captures the two-limb blob gas dividend `(high_limb, low_limb)` and its\r\n    15\t/// exact Euclidean division decomposition `high_limb * 2^16 + low_limb = D * slot_quotient + slot_remainder`.\r\n    16\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    17\tpub struct BlobSlotQuote {\r\n    18\t    pub high_limb: u64,\r\n    19\t    pub low_limb: u64,\r\n    20\t    pub slot_quotient: u64,\r\n    21\t    pub slot_remainder: u64,\r\n    22\t}\r\n    23\t\r\n    24\t/// Möller-Granlund 2-by-1 normalized reciprocal division (`div_2x1_mg10`)\r\n    25\t/// for divisor `MG10_DIVISOR = 0x8003 = 32_771` and reciprocal `MG10_RECIPROCAL = 0xFFF4 = 65_524`.\r\n    26\t///\r\n    27\t/// Preconditions guaranteed by caller: `u1 < MG10_DIVISOR` and `u0 < 2^16`.\r\n    28\t/// Returns the exact integer quotient `floor((u1 * 65_536 + u0) / 32_771)`.\r\n    29\t#[inline]\r\n    30\tpub fn div_2x1_mg10(u1: u64, u0: u64) -> u64 {\r\n    31\t    let q_full: u64 = (u1 * MG10_RECIPROCAL) + (u1 << 16u64) + u0 + (1u64 << 16u64);\r\n    32\t\r\n    33\t    let q1: u64 = q_full >> 16u64;\r\n    34\t    let q0: u64 = q_full & LIMB_MASK;\r\n    35\t    let r: u64 = (SUB_BIAS + u0 - q1 * MG10_DIVISOR) & LIMB_MASK;\r\n    36\t\r\n    37\t    let (q_corr, r_corr): (u64, u64) = if q0 < r {\r\n    38\t        (q1 - 1u64, (r + MG10_DIVISOR) & LIMB_MASK)\r\n    39\t    } else {\r\n"]
[614.300867, "o", "    40\t        (q1, r)\r\n    41\t    };\r\n    42\t\r\n    43\t    if r_corr >= MG10_DIVISOR {\r\n    44\t        q_corr + 1u64\r\n    45\t    } else {\r\n    46\t        q_corr\r\n    47\t    }\r\n    48\t}\r\n    49\t\r\n    50\t/// Reconstructs the exact remainder `(u1 * 2^16 + u0) - quot * MG10_DIVISOR`\r\n    51\t/// from a computed quotient `quot = floor((u1 * 2^16 + u0) / MG10_DIVISOR)`.\r\n    52\t#[inline]\r\n    53\tpub fn rem_2x1_mg10(u1: u64, u0: u64, quot: u64) -> u64 {\r\n    54\t    let dividend: u64 = (u1 << 16u64) + u0;\r\n    55\t    dividend - (quot * MG10_DIVISOR)\r\n    56\t}\r\n    57\t\r\n    58\t/// Computes the L1 blob gas slot quotient and remainder for a settlement pair `(amount, fee)`:\r\n    59\t/// - `high_limb = fee % MG10_DIVISOR` (`u1 in [0, 32_770]`)\r\n    60\t/// - `low_limb = amount & 0xFFFF` (`u0 in [0, 65_535]`)\r\n    61\t/// - `slot_quotient = floor((high_limb * 65_536 + low_limb) / 32_771)`\r\n    62\t/// - `slot_remainder = (high_limb * 65_536 + low_limb) % 32_771`\r\n    63\t#[inline]\r\n    64\tpub fn quote_blob_gas_slots(amount: u64, fee: u64) -> BlobSlotQuote {\r\n    65\t    let high_limb: u64 = fee % MG10_DIVISOR;\r\n    66\t    let low_limb: u64 = extract_low_u16(amount);\r\n    67\t    let slot_quotient: u64 = div_2x1_mg10(high_limb, low_limb);\r\n    68\t    let slot_remainder: u64 = rem_2x1_mg10(high_limb, low_limb, slot_quotient);\r\n    69\t    BlobSlotQuote {\r\n    70\t        high_limb,\r\n    71\t        low_limb,\r\n    72\t        slot_quotient,\r\n    73\t        slot_remainder,\r\n    74\t    }\r\n    75\t}\r\n    76\t\r\n    77\t/// Verifies the Euclidean division invariant `0 <= slot_remainder < MG10_DIVISOR`\r\n    78\t/// and `slot_quotient * MG10_DIVISOR + slot_remainder == high_limb * 2^16 + low_limb`\r\n    79\t/// for diagnostic auditing.\r\n    80\t#[inline]\r\n    81\tpub fn verify_blob_slot_euclidean(quote: BlobSlotQuote) -> bool {\r\n    82\t    let dividend: u64 = (quote.high_limb << 16u64) + quote.low_limb;\r\n    83\t    let reconstructed: u64 = (quote.slot_quotient * MG10_DIVISOR) + quote.slot_remainder;\r\n    84\t    (quote.slot_remainder < MG10_DIVISOR) && (reconstructed == dividend)\r\n    85\t}\r\n    86\t\r\n    87\t/// Estimates raw L1 blob gas units `slot_quotient * BLOB_GAS_PER_SLOT` for telemetry.\r\n    88\t#[inline]\r\n    89\tpub fn estimate_blob_gas_units(quote: BlobSlotQuote) -> u64 {"]
[614.30095, "o", "\r\n    90\t    quote.slot_quotient * BLOB_GAS_PER_SLOT\r\n    91\t}\r\n    92\t\r\n    93\t/// Computes the ceiling blob slot count `slot_quotient + (if slot_remainder > 0 { 1 } else { 0 })`\r\n    94\t/// for batch reservation telemetry.\r\n    95\t#[inline]\r\n    96\tpub fn ceil_blob_slots(quote: BlobSlotQuote) -> u64 {\r\n    97\t    if quote.slot_remainder > 0u64 {\r\n    98\t        quote.slot_quotient + 1u64\r\n    99\t    } else {\r\n   100\t        quote.slot_quotient\r\n   101\t    }\r\n   102\t}\r\n   103\t\r\n   104"]
[614.301647, "o", "\t"]
[614.301992, "o", "#[cfg(test)]\r\n   105\tmod tests {\r\n   106\t    use super::*;\r\n   107\t\r\n   108\t    #[test]\r\n   109\t    fn mg10_zero_and_exact_multiples() {\r\n   110\t        assert_eq!(div_2x1_mg10(0u64, 0u64), 0u64);\r\n   111\t        assert_eq!(div_2x1_mg10(0u64, 32_770u64), 0u64);\r\n   112\t        assert_eq!(div_2x1_mg10(0u64, 32_771u64), 1u64);\r\n   113\t        assert_eq!(div_2x1_mg10(1u64, 0u64), 1u64);\r\n   114\t        assert_eq!(div_2x1_mg10(10u64, 32_771u64), 20u64);\r\n   115\t    }\r\n   116\t\r\n   117\t    #[test]\r\n   118\t    fn mg10_exhaustive_boundary_sweeps() {\r\n   119\t        for u1 in [0u64, 1u64, 2u64, 16_384u64, 21_845u64, 32_769u64, 32_770u64] {\r\n   120\t            for u0 in [0u64, 1u64, 2u64, 32_770u64, 32_771u64, 32_772u64, 65_534u64, 65_535u64] {\r\n   121\t                let expected: u64 = ((u1 << 16u64) + u0) / MG10_DIVISOR;\r\n   122\t                let actual: u64 = div_2x1_mg10(u1, u0);\r\n   123\t                assert_eq!(actual, expected, \"mismatch at u1={}, u0={}\", u1, u0);\r\n   124\t            }\r\n   125\t        }\r\n   126\t    }\r\n   127\t\r\n   128\t    #[test]\r\n   129\t    fn mg10_second_correction_branch_is_exact() {\r\n   130\t        let q_a = quote_blob_gas_slots(65_535u64, 16_384u64);\r\n"]
[614.302797, "o", "\u001b[?2004h"]
