[1120.658998, "i", "cd /workspace/challenge\nmkdir -p examples\ncat > examples/complete_check.rs <<'EOF'\nuse settlement_gate::{clearing_pipeline::{compute_clearing_breakdown,quote_clearing_ticket},goldilocks_field::reduce_goldilocks_128,montgomery_field::pack_transcript,reciprocal_div::quote_blob_gas_slots};\nuse settlement_gate::broadword_swar::quote_calldata_lane_surcharge;\nuse settlement_gate::word_math::add_u64_with_carry;\nconst D:u128=32771; const BP:u128=10000; const FL:u128=5000; const P:u128=2013265921; const R:u128=4294967296; const MU:u128=2281701377;\nfn ceil(n:u128,d:u128)->u128{n.div_ceil(d)}\nfn monty(x:u64)->u64{let z=x as u128;let t=((z%R)*MU)%R;let u=t*P;if z>=u{((z-u)/R)as u64}else{(P-(u-z)/R)as u64}}\nfn check(a:u64,f:u64){\n let n=a as u128+f as u128;\n let gross=ceil(n,BP);let net=gross-gross/10;\n let levy=ceil(n,FL);let flash=levy-levy/4;\n let high=(f as u128)%D;let low=(a&65535)as u128;let blob=(high*65536+low)/D;\n let mut active=0u128;let mut bytes=0u128;for i in 0..8{let b=((f>>(8*i))&255)as u128;bytes+=b;if b!=0{active+=1;}}\n let calldata=active*256+bytes;\n let packed=pack_transcript(a,f);let prover=monty(packed)as u128;\n let domain=if f&255==0{90}else{(f&255)as u128};\n let bridge=(((a as u128)+((f as u128)<<64))%0xffff_ffff_0000_0001u128);\n let b=compute_clearing_breakdown(a,f);\n assert_eq!(b.net_bps_fee as u128,net,\"net a={a} f={f}\");assert_eq!(b.flash_lp_fee as u128,flash,\"flash a={a} f={f}\");assert_eq!(b.blob_slot_quotient as u128,blob,\"blob a={a} f={f}\");assert_eq!(b.calldata_surcharge as u128,calldata,\"calldata a={a} f={f}\");assert_eq!(b.prover_levy as u128,prover,\"prover a={a} f={f}\");assert_eq!(b.domain_surcharge as u128,domain,\"domain a={a} f={f}\");assert_eq!(b.bridge_surcharge as u128,bridge,\"bridge a={a} f={f}\");\n let exact=a as u128+net+flash+blob+calldata+prover+domain+bridge;\n assert_eq!(b.base_surcharge as u128,net+flash+blob+calldata+prover+domain);\n match quote_clearing_ticket(a,f){Some(t)=>assert_eq!(t.total_debit as u128,exact,\"ticket a={a} f={f}\"),None=>assert!(exact>u64::MAX as u128,\"false reject a={a} f={f}\")}\n}\nfn main(){\n let v=[0,1,2,3,90,255,256,9999,10000,32770,32771,65535,1<<16,1<<32,1<<63,u64::MAX-10000,u64::MAX-1,u64::MAX];for &a in &v{for &f in &v{check(a,f);}}\n let mut x=0x243f6a8885a308d3u64;for _ in 0..20_000_000{x=x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);let a=x;x=x.rotate_left(21).wrapping_mul(2862933555777941757).wrapping_add(3037000493);let f=x;check(a,f);}\n let _=add_u64_with_carry(0,0);let _=reduce_goldilocks_128(0,0);let _=quote_calldata_lane_surcharge(0);println!(\"complete differential check passed\");\n}\nEOF\ncargo run --release --example complete_check\nrm -f examples/complete_check.rs\nrmdir examples 2>/dev/null || true\n"]
