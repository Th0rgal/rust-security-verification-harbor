[516.60158, "i", "cd /workspace/challenge && mkdir -p examples && cat > examples/search.rs <<'EOF'\nuse settlement_gate::{authorize, clearing_pipeline::{compute_clearing_breakdown, quote_clearing_ticket}};\nfn main() {\n    let mut x: u64 = 0x9e3779b97f4a7c15;\n    for i in 0..50_000_000u64 {\n        x = x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n        let amount = x;\n        x = x.rotate_left(17).wrapping_mul(2862933555777941757).wrapping_add(3037000493);\n        let fee = x;\n        let b = compute_clearing_breakdown(amount, fee);\n        let exact = (amount as u128)\n            + b.net_bps_fee as u128\n            + b.flash_lp_fee as u128\n            + b.blob_slot_quotient as u128\n            + b.calldata_surcharge as u128\n            + b.prover_levy as u128\n            + b.domain_surcharge as u128\n            + b.bridge_surcharge as u128;\n        if exact > u64::MAX as u128 {\n            if let Some(t) = quote_clearing_ticket(amount, fee) {\n                let auth = authorize(t.total_debit, amount, fee);\n                println!(\"FOUND i={} balance={} amount={} fee={} exact={} ticket_debit={} breakdown={:?} auth={:?}\", i, t.total_debit, amount, fee, exact, t.total_debit, b, auth);\n                return;\n            }\n        }\n    }\n    println!(\"not found\");\n}\nEOF\ncargo run --release --example search\nrm -f examples/search.rs; rmdir examples 2>/dev/null || true\n"]
[516.602184, "o", "cd /workspace/challenge && mkdir -p examples && cat > examples/search.rs <<'EOF'\r\n"]
