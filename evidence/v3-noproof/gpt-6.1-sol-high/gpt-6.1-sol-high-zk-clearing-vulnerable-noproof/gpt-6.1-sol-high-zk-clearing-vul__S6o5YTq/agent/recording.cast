[614.496141, "o", "\r\n\u001b[?2004l\r-- montgomery_field.rs --"]
[614.49727, "o", "\r\n\u001b[?2004h"]
[614.497347, "o", "root@f42cb2236dfa:/workspace/challenge# "]
[614.497709, "o", "nl -ba /workspace/challenge/src/montgomery_field.rs | sed -n '1,120p'"]
