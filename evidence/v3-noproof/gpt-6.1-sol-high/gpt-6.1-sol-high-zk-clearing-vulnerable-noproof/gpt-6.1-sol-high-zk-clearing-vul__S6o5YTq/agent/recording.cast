[1005.003098, "i", "cd /workspace/challenge\nmkdir -p examples\ncat > examples/final_audit.rs <<'EOF'\nuse settlement_gate::{authorize,clearing_pipeline::{compute_clearing_breakdown,quote_clearing_ticket}};\nuse settlement_gate::goldilocks_field::reduce_goldilocks_128;\nuse settlement_gate::reciprocal_div::{div_2x1_mg10,quote_blob_gas_slots};\nuse settlement_gate::word_math::{add_u64_with_carry,ceil_div_bps_u64,ceil_div_flash_u64,floor_div_bps_u64,floor_div_flash_u64};\nconst D:u128=32771; const GP:u128=0xffff_ffff_0000_0001; const P:u128=2013265921;\nfn main(){\n for u1 in 0..32771u64 { for u0 in [0,1,2,3,32767,32768,32769,65532,65533,65534,65535] { let q=div_2x1_mg10(u1,u0); let n=(u1 as u128)*65536+u0 as u128; assert_eq!(q,n.div_euclid(D) as u64,\"reciprocal {u1} {u0}\"); } }\n let mut x=0x123456789abcdef0u64;\n for _ in 0..5_000_000 { x=x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407); let lo=x; x=x.rotate_left(17).wrapping_add(0x9e3779b97f4a7c15); let hi=x; let want=(((lo as u128)+((hi as u128)<<64))%GP) as u64; assert_eq!(reduce_goldilocks_128(lo,hi),want,\"gold {lo} {hi}\"); }\n for _ in 0..5_000_000 { x=x.wrapping_mul(2862933555777941757).wrapping_add(3037000493); let a=x; x=x.rotate_left(29).wrapping_add(17); let f=x; let n=(a as u128)+(f as u128); let s=add_u64_with_carry(a,f); assert_eq!(floor_div_bps_u64(s),(n/10000) as u64); assert_eq!(ceil_div_bps_u64(s),n.div_ceil(10000) as u64); assert_eq!(floor_div_flash_u64(s),(n/5000) as u64); assert_eq!(ceil_div_flash_u64(s),n.div_ceil(5000) as u64); let q=quote_blob_gas_slots(a,f); let bn=((q.high_limb as u128)<<16)+(q.low_limb as u128); assert_eq!(q.slot_quotient,(bn/D) as u64); assert_eq!(q.slot_remainder,(bn%D) as u64); let b=compute_clearing_breakdown(a,f); let exact=(a as u128)+(b.net_bps_fee as u128)+(b.flash_lp_fee as u128)+(b.blob_slot_quotient as u128)+(b.calldata_surcharge as u128)+(b.prover_levy as u128)+(b.domain_surcharge as u128)+(b.bridge_surcharge as u128); match quote_clearing_ticket(a,f) { Some(t)=>{assert_eq!(exact,t.total_debit as u128);assert!(authorize"]
