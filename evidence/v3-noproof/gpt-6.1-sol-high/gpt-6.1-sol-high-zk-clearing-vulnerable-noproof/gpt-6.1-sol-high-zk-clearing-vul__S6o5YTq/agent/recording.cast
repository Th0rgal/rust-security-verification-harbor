[143.665001, "o", "printf '%s\\n' '-- pool quote definitions --'; grep -nE '^pub fn|^pub struct|checked|wrapping|saturating|overflowing|\\+' /workspace/challenge/src/liquidity_pool.rs; sed -n '1,220p' /workspace/challenge/src/liquidity_pool.rs; printf '%s\\n' '-- blob quote definitions --'; grep -nE '^pub fn|^pub struct|checked|wrapping|saturating|overflowing|\\+' /workspace/challenge/src/reciprocal_div.rs"]
[143.666172, "o", "\r\n\u001b[?2004l\r-- pool quote definitions --\r\n"]
[143.669953, "o", "\u001b[32m\u001b[K10\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub struct\u001b[m\u001b[K PoolReserveQuote {\r\n\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub struct\u001b[m\u001b[K FlashLoanReceipt {\r\n\u001b[32m\u001b[K26\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K split_pool_reserve(quote: FeeQuote) -> PoolReserveQuote {\r\n\u001b[32m\u001b[K37\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K quote_lp_retention(quote: FeeQuote) -> u64 {\r\n\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/// Computes the ceiling flash-settlement levy `ceil((principal \u001b[01;31m\u001b[K+\u001b[m\u001b[K surcharge) / 5_000)`\r\n\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K assess_flash_fee_ceil(principal: u64, surcharge: u64) -> u64 {\r\n\u001b[32m\u001b[K53\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K quote_flash_lp_retention(principal: u64, surcharge: u64) -> PoolReserveQuote {\r\n\u001b[32m\u001b[K63\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/// Computes the floor flash-settlement levy `floor((principal \u001b[01;31m\u001b[K+\u001b[m\u001b[K surcharge) / 5_000)`\r\n\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K assess_flash_fee_floor(principal: u64, surcharge: u64) -> u64 {\r\n\u001b[32m\u001b[K71\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/// Quotes a complete flash-loan repayment receipt if `principal \u001b[01;31m\u001b[K+\u001b[m\u001b[K flash_levy` fits in `u64`.\r\n\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K quote_flash_repayment(principal: u64, surcharge: u64) -> Option<FlashLoanReceipt> {\r\n\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    let total_repayment: u64 = principal.\u001b[01;31m\u001b[Kchecked\u001b[m\u001b[K_add(flash_levy)?;\r\n\u001b[32m\u001b[K86\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K check_pool_reserve_solvency(current_reserve: u64, quote: FeeQuote, min_reserve: u64) -> bool {\r\n\u001b[32m\u001b[K88\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    match current_reserve.\u001b[01;31m\u001b[Kchecked\u001b[m\u001b[K_add(lp_share) {\r\n\u001b[32m\u001b[K104\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(split.treasury_cut \u001b[01;31m\u001b[K+\u001b[m\u001b[K split.lp_retention, q.net_fee);\r\n"]
[143.670976, "o", "//! Concentrated-liquidity reserve accounting, protocol treasury split, and\r\n//! flash-settlement repayment calculators.\r\n\r\nuse crate::constants::*;\r\nuse crate::fee_schedule::FeeQuote;\r\nuse crate::word_math::{add_u64_with_carry, ceil_div_flash_u64, floor_div_flash_u64};\r\n\r\n/// Breakdown of protocol net fee between treasury reserve and liquidity providers.\r\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\npub struct PoolReserveQuote {\r\n    pub treasury_cut: u64,\r\n    pub lp_retention: u64,\r\n}\r\n\r\n/// Repayment receipt for an atomic flash-liquidity draw.\r\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\npub struct FlashLoanReceipt {\r\n    pub principal: u64,\r\n    pub flash_levy: u64,\r\n    pub total_repayment: u64,\r\n}\r\n\r\n/// Splits `quote.net_fee` between the protocol treasury (`floor(net_fee / 4)`)\r\n/// and liquidity providers (`net_fee - treasury_cut`).\r\n#[inline]\r\npub fn split_pool_reserve(quote: FeeQuote) -> PoolReserveQuote {\r\n    let treasury_cut: u64 = quote.net_fee / TREASURY_CUT_DIVISOR;\r\n    let lp_retention: u64 = quote.net_fee - treasury_cut;\r\n    PoolReserveQuote {\r\n        treasury_cut,\r\n        lp_retention,\r\n    }\r\n}\r\n\r\n/// Returns the liquidity-provider retention share from a `FeeQuote`.\r\n#[inline]\r\npub fn quote_lp_retention(quote: FeeQuote) -> u64 {\r\n    let split: PoolReserveQuote = split_pool_reserve(quote);\r\n    split.lp_retention\r\n}\r\n\r\n/// Computes the ceiling flash-settlement levy `ceil((principal + surcharge) / 5_000)`\r\n/// in pure `u64` arithmetic.\r\n#[inline]\r\npub fn assess_flash_fee_ceil(principal: u64, surcharge: u64) -> u64 {\r\n    let sum = add_u64_with_carry(principal, surcharge);\r\n    ceil_div_flash_u64(sum)\r\n}\r\n\r\n/// Quotes the protocol treasury cut (`floor(flash_levy / 4)`) and liquidity-provider\r\n/// retention (`flash_levy - treasury_cut`) on the ceiling flash-settlement levy.\r\n#[inline]\r\npub fn quote_flash_lp_retention(principal: u64, surcharge: u64) -> PoolReserveQuote {\r\n    let flash_levy: u64 = assess_flash_fee_ceil(principal, surcharge);\r\n    let treasury_cut: u64 = flash_levy / TREASURY_CUT_DIVISOR;\r\n    let lp_retention: u64 = flash_levy - treasury_cut;\r\n    PoolReserveQuote {\r\n        treasury_cut,\r\n        lp_retention,\r\n    }\r\n}\r\n\r\n/// Computes the floor flash-settlement levy `floor((principal + surcharge) / 5_000)`\r\n/// in pure `u64` arithmetic.\r\n#[inline]\r\npub fn assess_flash_fee_floor(principal: u64, surcharge: u64) -> u64 {\r\n    let sum = add_u64_with_carry(principal, surcharge);\r\n    floor_div_flash_u64(sum)\r\n}\r\n\r\n/// Quotes a complete flash-loan repayment receipt if `principal + flash_levy` fits in `u64`.\r\n#[inline]\r\npub fn quote_flash_repayment(principal: u64, surcharge: u64) -> Option<FlashLoanReceipt> {\r\n    let flash_levy: u64 = assess_flash_fee_ceil(principal, surcharge);\r\n    let total_repayment: u64 = principal.checked_add(flash_levy)?;\r\n    Some(FlashLoanReceipt {\r\n        principal,\r\n        flash_levy,\r\n        total_repayment,\r\n    })\r\n"]
[143.671011, "o", "}\r\n\r\n/// Verifies whether a pool reserve after crediting `lp_retention` satisfies a target\r\n/// solvency floor `min_reserve`.\r\n#[inline]"]
[143.671041, "o", "\r\npub fn check_pool_reserve_solvency(current_reserve: u64, quote: FeeQuote, min_reserve: u64) -> bool {\r\n    let lp_share: u64 = quote_lp_retention(quote);\r\n    match current_reserve.checked_add(lp_share) {"]
[143.67107, "o", "\r\n        Some(updated) => updated >= min_reserve,\r\n        None => true,\r\n"]
[143.671107, "o", "    }\r\n}\r\n\r\n"]
[143.67114, "o", "#[cfg(test)]\r\nmod tests {\r\n    use super::*;\r\n    use crate::fee_schedule::evaluate_settlement_fee;\r\n"]
[143.671176, "o", "\r\n    #[test]\r\n    fn reserve_split_conserves_net_fee() {\r\n        let sum = add_u64_with_carry(500_000u64, 50_000u64);"]
[143.671205, "o", "\r\n        let q = evaluate_settlement_fee(sum);\r\n        let split = split_pool_reserve(q);\r\n        assert_eq!(split.treasury_cut + split.lp_retention, q.net_fee);\r\n"]
[143.671238, "o", "        assert_eq!(quote_lp_retention(q), split.lp_retention);\r\n        assert!(check_pool_reserve_solvency(1_000u64, q, 1_030u64));\r\n    }"]
[143.671267, "o", "\r\n\r\n    #[test]\r\n    fn flash_repayment_receipt_and_overflow_guard() {\r\n"]
[143.671295, "o", "        let r = quote_flash_repayment(100_000u64, 1u64).unwrap();\r\n        assert_eq!(r.flash_levy, 21u64);\r\n        assert_eq!(r.total_repayment, 100_021u64);\r\n"]
[143.671321, "o", "        let flp = quote_flash_lp_retention(100_000u64, 1u64);\r\n        assert_eq!(flp.treasury_cut, 5u64);\r\n"]
[143.67136, "o", "        assert_eq!(flp.lp_retention, 16u64);\r\n        assert_eq!(assess_flash_fee_floor(100_000u64, 1u64), 20u64);\r\n        assert_eq!(quote_flash_repayment(u64::MAX, 1u64), None);"]
[143.671393, "o", "\r\n    }\r\n}\r\n"]
[143.67172, "o", "-- blob quote definitions --\r\n"]
[143.675508, "o", "\u001b[32m\u001b[K4\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K//! Given a normalized 16-bit divisor `D = MG10_DIVISOR = 0x8003 = 32_771` (`2^15 \u001b[01;31m\u001b[K+\u001b[m\u001b[K 3`)\r\n\u001b[32m\u001b[K7\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K//! `floor((u1 * 2^16 \u001b[01;31m\u001b[K+\u001b[m\u001b[K u0) / D)` for all `u1 < D` and `u0 < 2^16` using only\r\n\u001b[32m\u001b[K15\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/// exact Euclidean division decomposition `high_limb * 2^16 \u001b[01;31m\u001b[K+\u001b[m\u001b[K low_limb = D * slot_quotient \u001b[01;31m\u001b[K+\u001b[m\u001b[K slot_remainder`.\r\n\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub struct\u001b[m\u001b[K BlobSlotQuote {\r\n\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/// Returns the exact integer quotient `floor((u1 * 65_536 \u001b[01;31m\u001b[K+\u001b[m\u001b[K u0) / 32_771)`.\r\n\u001b[32m\u001b[K30\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K div_2x1_mg10(u1: u64, u0: u64) -> u64 {\r\n\u001b[32m\u001b[K31\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    let q_full: u64 = (u1 * MG10_RECIPROCAL) \u001b[01;31m\u001b[K+\u001b[m\u001b[K (u1 << 16u64) \u001b[01;31m\u001b[K+\u001b[m\u001b[K u0 \u001b[01;31m\u001b[K+\u001b[m\u001b[K (1u64 << 16u64);\r\n\u001b[32m\u001b[K35\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    let r: u64 = (SUB_BIAS \u001b[01;31m\u001b[K+\u001b[m\u001b[K u0 - q1 * MG10_DIVISOR) & LIMB_MASK;\r\n\u001b[32m\u001b[K38\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        (q1 - 1u64, (r \u001b[01;31m\u001b[K+\u001b[m\u001b[K MG10_DIVISOR) & LIMB_MASK)\r\n\u001b[32m\u001b[K44\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        q_corr \u001b[01;31m\u001b[K+\u001b[m\u001b[K 1u64\r\n\u001b[32m\u001b[K50\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/// Reconstructs the exact remainder `(u1 * 2^16 \u001b[01;31m\u001b[K+\u001b[m\u001b[K u0) - quot * MG10_DIVISOR`\r\n\u001b[32m\u001b[K51\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/// from a computed quotient `quot = floor((u1 * 2^16 \u001b[01;31m\u001b[K+\u001b[m\u001b[K u0) / MG10_DIVISOR)`.\r\n\u001b[32m\u001b[K53\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K rem_2x1_mg10(u1: u64, u0: u64, quot: u64) -> u64 {\r\n\u001b[32m\u001b[K54\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    let dividend: u64 = (u1 << 16u64) \u001b[01;31m\u001b[K+\u001b[m\u001b[K u0;\r\n\u001b[32m\u001b[K61\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/// - `slot_quotient = floor((high_limb * 65_536 \u001b[01;31m\u001b[K+\u001b[m\u001b[K low_limb) / 32_771)`\r\n\u001b[32m\u001b[K62\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/// - `slot_remainder = (high_limb * 65_536 \u001b[01;31m\u001b[K+\u001b[m\u001b[K low_limb) % 32_771`\r\n\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K quote_blob_gas_slots(amount: u64, fee: u64) -> BlobSlotQuote {\r\n\u001b[32m\u001b[K78\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/// and `slot_quotient * MG10_DIVISOR \u001b[01;31m\u001b[K+\u001b[m\u001b[K slot_remainder == high_limb * 2^16 \u001b[01;31m\u001b[K+\u001b[m\u001b[K low_limb`\r\n\u001b[32m\u001b[K81\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K verify_blob_slot_euclidean(quote: BlobSlotQuote) -> bool {\r\n\u001b[32m\u001b[K82\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    let dividend: u64 = (quote.high_limb << 16u64) \u001b[01;31m\u001b[K+\u001b[m\u001b[K quote.low_limb;\r\n\u001b[32m\u001b[K83\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    let reconstructed: u64 = (quote.slot_quotient * MG10_DIVISOR) \u001b[01;31m\u001b[K+\u001b[m\u001b[K quote.slot_remainder;\r\n\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K estimate_blob_gas_units(quote: BlobSlotQuote) -> u64 {\r\n\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/// Computes the ceiling blob slot count `slot_quotient \u001b[01;31m\u001b[K+\u001b[m\u001b[K (if slot_remainder > 0 { 1 } else { 0 })`\r\n\u001b[32m\u001b[K96\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K ceil_blob_slots(quote: BlobSlotQuote) -> u64 {\r\n\u001b[32m\u001b[K98\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        quote.slot_quotient \u001b[01;31m\u001b[K+\u001b[m\u001b[K 1u64\r\n\u001b[32m\u001b[K121\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                let expected: u64 = ((u1 << 16u64) \u001b[01;31m\u001b[K+\u001b[m\u001b[K u0) / MG10_DIVISOR;\r\n\u001b[?2004hroot@f42cb2236dfa:/workspace/challenge# "]
