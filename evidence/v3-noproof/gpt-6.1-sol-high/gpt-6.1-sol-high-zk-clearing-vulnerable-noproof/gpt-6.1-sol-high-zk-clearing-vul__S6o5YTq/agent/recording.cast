[816.000266, "i", "cd /workspace/challenge\nmkdir -p examples\ncat > examples/find_witness.rs <<'EOF'\nuse settlement_gate::{authorize, clearing_pipeline::{compute_clearing_breakdown, quote_clearing_ticket}};\nuse settlement_gate::montgomery_field::{pack_transcript, quote_prover_transcript_levy};\nconst P:u128=2_013_265_921u128;\nconst R:u128=4_294_967_296u128;\nconst MU:u128=2_281_701_377u128;\nfn exact_monty(x:u64)->u64 { let xx=x as u128; let t=((xx%(R))*MU)%R; let u=t*P; if xx>=u { ((xx-u)/R) as u64 } else { (P-(u-xx)/R) as u64 } }\nfn main(){\n let mut x:u64=0x123456789abcdef0;\n for i in 0..100_000_000u64 {\n  x=x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n  let amount=x as u32 as u64;\n  x=x.rotate_left(23).wrapping_mul(2862933555777941757).wrapping_add(3037000493);\n  let fee=(x as u128 % P) as u64;\n  let packed=pack_transcript(amount,fee);\n  let got=quote_prover_transcript_levy(amount,fee).prover_levy;\n  let want=exact_monty(packed);\n  if got < want {\n   let b=compute_clearing_breakdown(amount,fee);\n   if let Some(t)=quote_clearing_ticket(amount,fee) {\n    let exact=(amount as u128)+(b.net_bps_fee as u128)+(b.flash_lp_fee as u128)+(b.blob_slot_quotient as u128)+(b.calldata_surcharge as u128)+(want as u128)+(b.domain_surcharge as u128)+(b.bridge_surcharge as u128);\n    if exact <= u64::MAX as u128 && authorize(t.total_debit,amount,fee).is_some() && exact > t.total_debit as u128 {\n     println!(\"FOUND i={i} balance={} amount={} fee={} packed={} got={} want={} reported={} exact={exact} breakdown={:?}\",t.total_debit,amount,fee,packed,got,want,t.total_debit,b); return;\n    }\n   }\n  }\n }\n println!(\"not found\");\n}\nEOF\ncargo run --release --example find_witness\nrm -f examples/find_witness.rs\nrmdir examples 2>/dev/null || true\n"]
