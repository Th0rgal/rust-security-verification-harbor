[185.39954, "o", "-- fee schedule core --"]
[185.400011, "o", "\r\n"]
[185.4036, "o", "     1\t//! Protocol basis-point settlement fee and tier rebate schedule calculator.\r\n     2\t//!\r\n     3\t//! Given a 65-bit combined notional `sum = add_u64_with_carry(amount, fee)`:\r\n     4\t//! 1. The gross settlement fee is the ceiling basis-point quotient\r\n     5\t//!    `gross_fee = ceil((amount + fee) / BPS_DENOM)` (`BPS_DENOM = 10_000`).\r\n     6\t//! 2. The tier rebate is the floor 10% discount\r\n     7\t//!    `rebate = floor(gross_fee / REBATE_DIVISOR)` (`REBATE_DIVISOR = 10`).\r\n     8\t//! 3. The net protocol settlement fee is `net_fee = gross_fee - rebate`.\r\n     9\t\r\n    10\tuse crate::constants::*;\r\n    11\tuse crate::word_math::{WordSum, ceil_div_bps_u64, floor_div_bps_u64, is_institutional_notional};\r\n    12\t\r\n    13\t/// Active protocol fee schedule parameters.\r\n    14\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    15\tpub struct FeeSchedule {\r\n    16\t    pub bps_denom: u64,\r\n    17\t    pub rebate_divisor: u64,\r\n    18\t    pub maker_cap_divisor: u64,\r\n    19\t}\r\n    20\t\r\n    21\t/// Complete two-stage fee quote (`gross_fee`, `rebate`, `net_fee`).\r\n    22\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    23\tpub struct FeeQuote {\r\n    24\t    pub gross_fee: u64,\r\n    25\t    pub rebate: u64,\r\n    26\t    pub net_fee: u64,\r\n    27\t}\r\n    28\t\r\n    29\t/// Returns the canonical protocol fee schedule configuration.\r\n    30\t#[inline]\r\n    31\tpub fn default_schedule() -> FeeSchedule {\r\n    32\t    FeeSchedule {\r\n    33\t        bps_denom: BPS_DENOM,\r\n    34\t        rebate_divisor: REBATE_DIVISOR,\r\n    35\t        maker_cap_divisor: MAKER_REBATE_CAP_DIVISOR,\r\n    36\t    }\r\n    37\t}\r\n    38\t\r\n    39\t/// Computes the 10% floor tier rebate `floor(gross_fee / REBATE_DIVISOR)`.\r\n    40\t#[inline]\r\n    41\tpub fn compute_tier_rebate(gross_fee: u64) -> u64 {\r\n    42\t    gross_fee / REBATE_DIVISOR\r\n    43\t}\r\n    44\t\r\n    45\t/// Computes a capped passive maker rebate `min(floor(gross_fee / 10), floor(cap_basis / 5))`\r\n    46\t/// used by order-book analytics.\r\n    47\t#[inline]\r\n    48\tpub fn compute_capped_maker_rebate(gross_fee: u64, cap_basis: u64) -> u64 {\r\n    49\t    let base_rebate: u64 = gross_fee / REBATE_DIVISOR;\r\n    50\t    let max_rebate: u64 = cap_basis / MAKER_REBATE_CAP_DIVISOR;\r\n    51\t    if base_rebate <= max_rebate {\r\n    52\t        base_rebate\r\n    53\t    } else {\r\n    54\t        max_rebate\r\n    55\t    }\r\n    56\t}\r\n    57\t\r\n    58\t/// Evaluates the active clearing protocol fee quote (`gross_fee`, `rebate`, `net_fee`)\r\n    59\t/// from a 65-bit notional sum `sum = amount + fee` using ceiling basis-point division\r\n    60\t/// and floor tier rebate.\r\n    61\t#[inline]\r\n    62\tpub fn evaluate_settlement_fee(sum: WordSum) -> FeeQuote {\r\n    63\t    let gross_fee: u64 = ceil_div_bps_u64(sum);\r\n    64\t    let rebate: u64 = compute_tier_rebate(gross_fee);\r\n    65\t    let net_fee: u64 = gross_fee - rebate;\r\n    66\t    FeeQuote {\r\n    67\t        gross_fee,\r\n    68\t        rebate,\r\n    69\t        net_fee,\r\n    70\t    }\r\n    71\t}\r\n    72\t\r\n    73\t/// Evaluates a passive liquidity floor fee quote (`floor((amount + fee) / 10_000)`)\r\n    74\t/// for pool reserve telemetry.\r\n    75\t#[inline]\r\n    76\tpub fn evaluate_passive_floor_fee(sum: WordSum) -> FeeQuote {\r\n    77\t    let gross_fee: u64 = floor_div_bps_u64(sum);\r\n    78\t    let rebate: u64 = compute_tier_rebate(gross_fee);\r\n    79\t    let net_fee: u64 = gross_fee - rebate;\r\n    80\t    FeeQuote {\r\n    81\t        gross_fee,\r\n    82\t        rebate,\r\n    83\t        net_fee,\r\n    84\t    }\r\n    85\t}\r\n    86\t\r\n    87\t/// Computes the rounding spread (`ceil_quote.net_fee - floor_quote.net_fee`)\r\n    88\t/// between active ceiling settlement and passive floor settlement.\r\n    89\t#[inline]\r\n    90\tpub fn compute_fee_rounding_spread(sum: WordSum) -> u64 {\r\n    91\t    let ceil_q: FeeQuote = evaluate_settlement_fee(sum);\r\n    92\t    let floor_q: FeeQuote = evaluate_passive_floor_fee(sum);\r\n    93\t    ceil_q.net_fee - floor_q.net_fee\r\n    94\t}\r\n    95\t\r\n    96\t/// Classifies the fee tier code (`0 = zero`, `1 = retail`, `2 = institutional`)\r\n    97\t/// for batch telemetry reporting.\r\n    98\t#[inline]\r\n    9"]
[185.403652, "o", "9\tpub fn classify_settlement_tier(sum: WordSum) -> u64 {\r\n   100\t    if !sum.high_carry && sum.low_word == 0u64 {\r\n   101\t        0u64\r\n   102\t    } else if is_institutional_notional(sum) {\r\n   103\t        2u64\r\n   104\t    } else {\r\n   105\t        1u64\r\n   106\t    }\r\n   107\t}\r\n   108\t\r\n   109\t#[cfg(test)]\r\n   110\tmod tests {\r\n   111\t    use super::*;\r\n   112\t    use crate::word_math::add_u64_with_carry;\r\n   113\t\r\n   114\t    #[test]\r\n   115\t    fn settlement_fee_and_rebate_rounding() {\r\n   116\t        let s = add_u64_with_carry(100_000u64, 25_000u64);\r\n   117\t        let q = evaluate_settlement_fee(s);\r\n   118\t        assert_eq!(q.gross_fee, 13u64);\r\n   119\t        assert_eq!(q.rebate, 1u64);\r\n   120\t        assert_eq!(q.net_fee, 12u64);\r\n   121\t\r\n   122\t        let pf = evaluate_passive_floor_fee(s);\r\n   123\t        assert_eq!(pf.gross_fee, 12u64);\r\n   124\t        assert_eq!(pf.rebate, 1u64);\r\n   125\t        assert_eq!(pf.net_fee, 11u64);\r\n   126\t        assert_eq!(compute_fee_rounding_spread(s), 1u64);\r\n   127\t    }\r\n   128\t\r\n   129\t    #[test]\r\n   130\t    fn capped_maker_rebate_and_default_schedule() {\r\n   131\t        let sched = default_schedule();\r\n   132\t        assert_eq!(sched.bps_denom, 10_000u64);\r\n   133\t        assert_eq!(compute_capped_maker_rebate(100u64, 30u64), 6u64);\r\n   134\t        assert_eq!(compute_capped_maker_rebate(100u64, 100u64), 10u64);\r\n   135\t    }\r\n   136\t\r\n   137\t    #[test]\r\n   138\t    fn settlement_tier_classification() {\r\n   139\t        assert_eq!(classify_settlement_tier(add_u64_with_carry(0u64, 0u64)), 0u64);\r\n   140\t        assert_eq!(classify_settlement_tier(add_u64_with_carry(50_000u64, 100u64)), 1u64);\r\n   141\t        assert_eq!(classify_settlement_tier(add_u64_with_carry(INSTITUTIONAL_BAND_MIN, 0u64)), 2u64);\r\n   142\t    }\r\n   143\t}\r\n"]
[185.404333, "o", "-- pool core --\r\n"]
[185.407736, "o", "     1\t//! Concentrated-liquidity reserve accounting, protocol treasury split, and\r\n     2\t//! flash-settlement repayment calculators.\r\n     3"]
[185.407778, "o", "\t\r\n     4\tuse crate::constants::*;\r\n     5\tuse crate::fee_schedule::FeeQuote;\r\n"]
[185.407809, "o", "     6\tuse crate::word_math::{add_u64_with_carry, ceil_div_flash_u64, floor_div_flash_u64};\r\n     7\t"]
[185.407845, "o", "\r\n     8\t/// Breakdown of protocol net fee between treasury reserve and liquidity providers.\r\n"]
[185.407875, "o", "     9\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    10\tpub struct PoolReserveQuote {"]
[185.407911, "o", "\r\n    11\t    pub treasury_cut: u64,\r\n"]
[185.407943, "o", "    12\t"]
[185.418147, "o", "    pub lp_retention: u64,\r\n    13\t}\r\n    14\t\r\n    15\t/// Repayment receipt for an atomic flash-liquidity draw.\r\n    16\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    17\tpub struct FlashLoanReceipt {\r\n    18\t    pub principal: u64,\r\n    19\t    pub flash_levy: u64,\r\n    20\t    pub total_repayment: u64,\r\n    21\t}\r\n    22\t\r\n    23\t/// Splits `quote.net_fee` between the protocol treasury (`floor(net_fee / 4)`)\r\n    24\t/// and liquidity providers (`net_fee - treasury_cut`).\r\n    25\t#[inline]\r\n    26\tpub fn split_pool_reserve(quote: FeeQuote) -> PoolReserveQuote {\r\n    27\t    let treasury_cut: u64 = quote.net_fee / TREASURY_CUT_DIVISOR;\r\n    28\t    let lp_retention: u64 = quote.net_fee - treasury_cut;\r\n"]
[185.422049, "o", "    29\t    PoolReserveQuote {\r\n    30\t        treasury_cut,\r\n    31\t        lp_retention,\r\n    32\t    }\r\n    33\t}\r\n    34\t\r\n    35\t/// Returns the liquidity-provider retention share from a `FeeQuote`.\r\n    36\t#[inline]\r\n    37\tpub fn quote_lp_retention(quote: FeeQuote) -> u64 {\r\n    38\t    let split: PoolReserveQuote = split_pool_reserve(quote);\r\n    39\t    split.lp_retention\r\n    40\t}\r\n    41\t\r\n    42\t/// Computes the ceiling flash-settlement levy `ceil((principal + surcharge) / 5_000)`\r\n    43\t/// in pure `u64` arithmetic.\r\n    44\t#[inline]\r\n    45\tpub fn assess_flash_fee_ceil(principal: u64, surcharge: u64) -> u64 {\r\n    46\t    let sum = add_u64_with_carry(principal, surcharge);\r\n    47\t    ceil_div_flash_u64(sum)\r\n    48\t}\r\n    49\t\r\n    50\t/// Quotes the protocol treasury cut (`floor(flash_levy / 4)`) and liquidity-provider\r\n    51\t/// retention (`flash_levy - treasury_cut`) on the ceiling flash-settlement levy.\r\n    52\t#[inline]\r\n    53\tpub fn quote_flash_lp_retention(principal: u64, surcharge: u64) -> PoolReserveQuote {\r\n    54\t    let flash_levy: u64 = assess_flash_fee_ceil(principal, surcharge);\r\n    55\t    let treasury_cut: u64 = flash_levy / TREASURY_CUT_DIVISOR;\r\n    56\t    let lp_retention: u64 = flash_levy - treasury_cut;\r\n    57\t    PoolReserveQuote {\r\n    58\t        treasury_cut,\r\n    59\t        lp_retention,\r\n    60\t    }\r\n    61\t}\r\n    62\t\r\n    63\t/// Computes the floor flash-settlement levy `floor((principal + surcharge) / 5_000)`\r\n    64\t/// in pure `u64` arithmetic.\r\n    65\t#[inline]\r\n    66\tpub fn assess_flash_fee_floor(principal: u64, surcharge: u64) -> u64 {\r\n    67\t    let sum = add_u64_with_carry(principal, surcharge);\r\n    68\t    floor_div_flash_u64(sum)\r\n    69\t}\r\n    70\t\r\n    71\t/// Quotes a complete flash-loan repayment receipt if `principal + flash_levy` fits in `u64`.\r\n    72\t#[inline]\r\n    73\tpub fn quote_flash_repayment(principal: u64, surcharge: u64) -> Option<FlashLoanReceipt> {\r\n    74\t    let flash_levy: u64 = assess_flash_fee_ceil(principal, surcharge);\r\n    75\t    let total_repayment: u64 = principal.checked_add(flash_levy)?;\r\n    76\t    Some(FlashLoanReceipt {\r\n    77\t        principal,\r\n    78\t        flash_levy,\r\n    79\t        total_repayment,\r\n    80\t    })\r\n    81\t}\r\n    82\t\r\n    83\t/// Verifies whether a pool reserve after crediting `lp_retention` satisfies a target\r\n    84\t/// solvency floor `min_reserve`.\r\n    85\t#[inline]\r\n    86\tpub fn check_pool_reserve_solvency(current_reserve: u64, quote: FeeQuote, min_reserve: u64) -> bool {\r\n    87\t    let lp_share: u64 = quote_lp_retention(quote);\r\n    88\t    match current_reserve.checked_add(lp_share) {\r\n    89\t        Some(updated) => updated >= min_reserve,\r\n    90\t        None => true,\r\n    91\t    }\r\n    92\t}\r\n    93\t\r\n    94\t#[cfg(test)]\r\n    95\tmod tests {\r\n    96\t    use super::*;\r\n    97\t    use crate::fee_schedule::evaluate_settlement_fee;\r\n    98\t\r\n    99\t    #[test]\r\n   100\t    fn reserve_split_conserves_net_fee() {\r\n   101\t        let sum = add_u64_with_carry(500_000u64, 50_000u64);\r\n   102\t        let q = evaluate_settlement_fee(sum);\r\n   103\t        let split = split_pool_reserve(q);\r\n   104\t        assert_eq!(split.treasury_cut + split.lp_retention, q.net_fee);\r\n   105\t        assert_eq!(quote_lp_retention(q), split.lp_retention);\r\n   106\t        assert!(check_pool_reserve_solvency(1_000u64, q, 1_030u64));\r\n   107\t    }\r\n   108\t\r\n   109\t    #[test]\r\n   110\t    fn flash_repayment_receipt_and_overflow_guard() {\r\n   111\t        let r = quote_flash_repayment(100_000u64, 1u64).unwrap();\r\n   112\t        assert_eq!(r.flash_levy, 21u64);\r\n   113\t        assert_eq!(r.total_repayment, 100_021u64);\r\n   114\t        let flp = quote_flash_lp_retention(100_000u64, 1u64);\r\n   115\t        assert_eq!(flp.treasury_cut, 5u64);\r\n   116\t        assert_eq!(flp.lp_retention, 16u64);\r\n   117\t        assert_eq!(assess_flash_fee_floor(100_000u64, 1u64), 20u64);\r\n   118\t        assert_eq!(quote_flash_repayment(u64::MAX, 1u64), None);\r\n   119\t    }\r\n   120\t}\r\n\u001b[?2004hroot@f42cb2236dfa:/workspace/challenge# "]
[185.705399, "i", "printf '%s\\n' '-- reciprocal core --'; nl -ba /workspace/challenge/src/reciprocal_div.rs | sed -n '1,220p'; printf '%s\\n' '-- broadword core --'; nl -ba /workspace/challenge/src/broadword_swar.rs | sed -n '1,220p'\n"]
[185.706969, "o", "printf '%s\\n' '-- reciprocal core --'; nl -ba /workspace/challenge/src/reciprocal_div.rs | sed -n '1,220p'; printf '%s\\n' '-- broadword core --'; nl -ba /workspace/challenge/src/broadword_swar.rs | sed -n '1,220p'\r\n\u001b[?2004l\r"]
[185.70711, "o", "-- reciprocal core --\r\n"]
[185.709142, "o", "     1\t//! Multiprecision 2-by-1 normalized reciprocal division (`alloy-rs/ruint` algorithm)\r\n"]
[185.709227, "o", "     2\t//! for L1 data-availability blob gas slot partitioning.\r\n     3\t//!\r\n     4\t//! Given a normalized 16-bit divisor `D = MG10_DIVISOR = 0x8003 = 32_771` (`2^15 + 3`)\r\n     5\t"]
[185.709262, "o", "//! with precomputed reciprocal `V = floor((2^32 - 1) / D) - 2^16 = 0xFFF4 = 65_524`,\r\n     6\t//! `div_2x1_mg10(u1, u0)` computes the exact floor quotient\r\n"]
[185.709345, "o", "     7\t//! `floor((u1 * 2^16 + u0) / D)` for all `u1 < D` and `u0 < 2^16` using only\r\n     8"]
[185.709385, "o", "\t//! shifts, bitwise masks, and `u64` multiplications (without hardware `/` or `%`\r\n     9\t//! in the core reciprocal step).\r\n    10\t\r\n    11\tuse crate::constants::*;\r\n    12"]
[185.709415, "o", "\tuse crate::word_math::extract_low_u16;\r\n    13"]
[185.709443, "o", "\t\r\n    14\t"]
[185.709473, "o", "/// Captures the two-limb blob gas dividend `(high_limb, low_limb)` and its\r\n    15\t/// exact Euclidean division decomposition `high_limb * 2^16 + low_limb = D * slot_quotient + slot_remainder`."]
[185.70959, "o", "\r\n    16\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    17\tpub struct BlobSlotQuote {\r\n    18\t    pub high_limb: u64,\r\n    19\t    pub low_limb: u64,\r\n"]
[185.709625, "o", "    20\t    pub slot_quotient: u64,\r\n    21\t    pub slot_remainder: u64,"]
[185.709653, "o", "\r\n    22\t}"]
[185.709682, "o", "\r\n    23\t\r\n"]
[185.709714, "o", "    24\t/// Möller-Granlund 2-by-1 normalized reciprocal division (`div_2x1_mg10`)\r\n    25\t"]
[185.70977, "o", "/// for divisor `MG10_DIVISOR = 0x8003 = 32_771` and reciprocal `MG10_RECIPROCAL = 0xFFF4 = 65_524`.\r\n    26\t///\r\n"]
[185.709806, "o", "    27\t/// Preconditions guaranteed by caller: `u1 < MG10_DIVISOR` and `u0 < 2^16`.\r\n    28\t/// Returns the exact integer quotient `floor((u1 * 65_536 + u0) / 32_771)`."]
[185.709961, "o", "\r\n    29\t#[inline]\r\n    30\tpub fn div_2x1_mg10(u1: u64, u0: u64) -> u64 {\r\n    31\t    let q_full: u64 = (u1 * MG10_RECIPROCAL) + (u1 << 16u64) + u0 + (1u64 << 16u64);\r\n    32\t\r\n    33\t    let q1: u64 = q_full >> 16u64;\r\n    34"]
[185.709998, "o", "\t    let q0: u64 = q_full & LIMB_MASK;\r\n    35\t    let r: u64 = (SUB_BIAS + u0 - q1 * MG10_DIVISOR) & LIMB_MASK;\r\n"]
[185.71003, "o", "    36\t\r\n    37\t"]
[185.710066, "o", "    let (q_corr, r_corr): (u64, u64) = if q0 < r {\r\n    38\t        (q1 - 1u64, (r + MG10_DIVISOR) & LIMB_MASK)"]
[185.710097, "o", "\r\n    39\t    } else {\r\n"]
[185.710128, "o", "    40\t        (q1, r)\r\n    41"]
[185.710159, "o", "\t    };\r\n    42\t"]
[185.710187, "o", "\r\n    43\t    if r_corr >= MG10_DIVISOR {"]
[185.71035, "o", "\r\n    44\t        q_corr + 1u64\r\n    45\t    } else {\r\n    46\t        q_corr\r\n    47\t    }\r\n    48\t}\r\n    49\t\r\n    50"]
[185.710387, "o", "\t/// Reconstructs the exact remainder `(u1 * 2^16 + u0) - quot * MG10_DIVISOR`\r\n    51\t/// from a computed quotient `quot = floor((u1 * 2^16 + u0) / MG10_DIVISOR)`.\r\n"]
[185.710418, "o", "    52\t#[inline]\r\n"]
[185.71045, "o", "    53\tpub fn rem_2x1_mg10(u1: u64, u0: u64, quot: u64) -> u64 {\r\n    54\t"]
[185.71048, "o", "    let dividend: u64 = (u1 << 16u64) + u0;\r\n    55"]
[185.710518, "o", "\t    dividend - (quot * MG10_DIVISOR)\r\n    56\t}"]
[185.710551, "o", "\r\n    57\t\r\n    58\t"]
[185.710582, "o", "/// Computes the L1 blob gas slot quotient and remainder for a settlement pair `(amount, fee)`:\r\n    59\t"]
[185.710613, "o", "/// - `high_limb = fee % MG10_DIVISOR` (`u1 in [0, 32_770]`)\r\n    60\t/// - `low_limb = amount & 0xFFFF` (`u0 in [0, 65_535]`)\r\n"]
[185.710647, "o", "    61\t/// - `slot_quotient = floor((high_limb * 65_536 + low_limb) / 32_771)`\r\n"]
[185.710835, "o", "    62\t/// - `slot_remainder = (high_limb * 65_536 + low_limb) % 32_771`\r\n    63\t#[inline]\r\n    64\tpub fn quote_blob_gas_slots(amount: u64, fee: u64) -> BlobSlotQuote {\r\n    65\t    let high_limb: u64 = fee % MG10_DIVISOR;\r\n    66\t    let low_limb: u64 = extract_low_u16(amount);\r\n    67\t    let slot_quotient: u64 = div_2x1_mg10(high_limb, low_limb);\r\n    68\t    let slot_remainder: u64 = rem_2x1_mg10(high_limb, low_limb, slot_quotient);\r\n    69"]
[185.710875, "o", "\t    BlobSlotQuote {\r\n    70\t        high_limb,\r\n"]
[185.710922, "o", "    71\t        low_limb,\r\n    72"]
[185.710959, "o", "\t"]
[185.711051, "o", "        slot_quotient,\r\n    73\t"]
[185.71109, "o", "        slot_remainder,\r\n    74\t    }\r\n"]
[185.711123, "o", "    75\t}\r\n    76\t\r\n"]
[185.71116, "o", "    77\t/// Verifies the Euclidean division invariant `0 <= slot_remainder < MG10_DIVISOR`\r\n    78\t"]
[185.711192, "o", "/// and `slot_quotient * MG10_DIVISOR + slot_remainder == high_limb * 2^16 + low_limb`\r\n    79\t/// for diagnostic auditing.\r\n"]
[185.711366, "o", "    80\t#[inline]\r\n    81\tpub fn verify_blob_slot_euclidean(quote: BlobSlotQuote) -> bool {\r\n    82\t    let dividend: u64 = (quote.high_limb << 16u64) + quote.low_limb;\r\n    83\t    let reconstructed: u64 = (quote.slot_quotient * MG10_DIVISOR) + quote.slot_remainder;\r\n    84\t    (quote.slot_remainder < MG10_DIVISOR) && (reconstructed == dividend)\r\n    85\t}\r\n    86\t\r\n    87\t"]
[185.711405, "o", "/// Estimates raw L1 blob gas units `slot_quotient * BLOB_GAS_PER_SLOT` for telemetry.\r\n    88\t#[inline]\r\n    89\t"]
[185.711437, "o", "pub fn estimate_blob_gas_units(quote: BlobSlotQuote) -> u64 {\r\n    90\t    quote.slot_quotient * BLOB_GAS_PER_SLOT\r\n"]
[185.71147, "o", "    91\t}\r\n    92\t"]
[185.711503, "o", "\r\n    93\t/// Computes the ceiling blob slot count `slot_quotient + (if slot_remainder > 0 { 1 } else { 0 })`\r\n"]
[185.711538, "o", "    94\t/// for batch reservation telemetry.\r\n    95"]
[185.711571, "o", "\t#[inline]\r\n    96\tpub fn ceil_blob_slots(quote: BlobSlotQuote) -> u64 {\r\n"]
[185.7116, "o", "    97\t    if quote.slot_remainder > 0u64 {\r\n    98"]
[185.711638, "o", "\t        quote.slot_quotient + 1u64\r\n    99\t"]
[185.711669, "o", "    } else {\r\n   100\t        quote.slot_quotient\r\n   101"]
[185.711853, "o", "\t    }\r\n   102\t}\r\n   103\t\r\n   104\t#[cfg(test)]\r\n   105\tmod tests {\r\n   106\t    use super::*;\r\n   107\t\r\n   108\t    #[test]\r\n   109\t    fn mg10_zero_and_exact_multiples() {"]
[185.71189, "o", "\r\n   110\t        assert_eq!(div_2x1_mg10(0u64, 0u64), 0u64);\r\n   111"]
[185.711929, "o", "\t        assert_eq!(div_2x1_mg10(0u64, 32_770u64), 0u64);\r\n   112\t"]
[185.711966, "o", "        assert_eq!(div_2x1_mg10(0u64, 32_771u64), 1u64);\r\n   113\t        assert_eq!(div_2x1_mg10(1u64, 0u64), 1u64);\r\n"]
[185.711998, "o", "   114\t        assert_eq!(div_2x1_mg10(10u64, 32_771u64), 20u64);\r\n   115\t"]
[185.712029, "o", "    }\r\n   116\t\r\n"]
[185.71206, "o", "   117\t    #[test]\r\n   118\t"]
[185.712089, "o", "    fn mg10_exhaustive_boundary_sweeps() {\r\n   119\t        for u1 in [0u64, 1u64, 2u64, 16_384u64, 21_845u64, 32_769u64, 32_770u64] {"]
[185.712124, "o", "\r\n   120\t            for u0 in [0u64, 1u64, 2u64, 32_770u64, 32_771u64, 32_772u64, 65_534u64, 65_535u64] {\r\n"]
[185.712206, "o", "   121\t                let expected: u64 = ((u1 << 16u64) + u0) / MG10_DIVISOR;\r\n"]
[185.712242, "o", "   122\t                let actual: u64 = div_2x1_mg10(u1, u0);\r\n   123\t"]
[185.712445, "o", "                assert_eq!(actual, expected, \"mismatch at u1={}, u0={}\", u1, u0);\r\n   124\t            }\r\n   125\t        }\r\n   126\t    }\r\n   127\t\r\n   128\t    #[test]\r\n   129\t    fn mg10_second_correction_branch_is_exact() {\r\n   130\t        let q_a = quote_blob_gas_slots(65_535u64, 16_384u64);\r\n   131\t        assert!(verify_blob_slot_euclidean(q_a));\r\n   132\t        assert_eq!(q_a.slot_quotient, 32_767u64);"]
[185.712486, "o", "\r\n   133\t        assert_eq!(ceil_blob_slots(q_a), 32_768u64);\r\n   134\t\r\n   135"]
[185.712518, "o", "\t        let q_b = quote_blob_gas_slots(65_534u64, 21_845u64);\r\n   136\t"]
[185.712557, "o", "        assert!(verify_blob_slot_euclidean(q_b));\r\n   137\t        assert_eq!(q_b.slot_quotient, 43_688u64);"]
[185.712594, "o", "\r\n   138\t    }\r\n   139\t"]
[185.712623, "o", "\r\n   140\t    #[test]\r\n   141"]
[185.712651, "o", "\t    fn blob_gas_unit_telemetry() {\r\n   142"]
[185.712682, "o", "\t        let q = quote_blob_gas_slots(32_771u64, 0u64);\r\n   143\t"]
[185.71272, "o", "        assert_eq!(q.slot_quotient, 1u64);\r\n   144\t        assert_eq!(q.slot_remainder, 0u64);\r\n"]
[185.71275, "o", "   145\t        assert_eq!(ceil_blob_slots(q), 1u64);\r\n   146\t"]
[185.71294, "o", "        assert_eq!(estimate_blob_gas_units(q), BLOB_GAS_PER_SLOT);\r\n   147\t    }\r\n   148\t\r\n   149\t    #[test]\r\n   150\t    fn mg10_maximum_two_limb_dividend() {\r\n   151\t        let q_max = quote_blob_gas_slots(65_535u64, 32_770u64);\r\n   152\t        assert!(verify_blob_slot_euclidean(q_max));\r\n   153\t        assert_eq!(q_max.slot_quotient, 65_535u64);\r\n   154\t        assert_eq!(q_max.slot_remainder, 32_770u64);"]
[185.712979, "o", "\r\n   155\t    }\r\n   156\t}"]
[185.713012, "o", "\r\n"]
[185.71374, "o", "-- broadword core --\r\n"]
[185.715668, "o", "     1\t//! Vigna (`tov/succinct-rs`) 8-lane SWAR (SIMD Within A Register) broadword byte\r\n     2\t//! inspection and accumulation kernels for L1 calldata compression pricing.\r\n     3\t//!\r\n     4\t//! Zero-knowledge rollup batches compress zero bytes in transaction fee parameters\r\n     5\t//! much more cheaply than non-zero bytes. For a 64-bit word `fee` viewed as 8 bytes\r\n     6\t//! `b_0, b_1, ..., b_7` (`b_i = (fee >> (8 * i)) & 0xFF`):\r\n"]
[185.715752, "o", "     7\t//! - Each non-zero byte (`b_i > 0`) incurs a fixed `256`-unit activation surcharge.\r\n     8\t//! - Each byte additionally contributes its numeric value `b_i` (`0..=255`).\r\n"]
[185.715822, "o", "     9"]
[185.715878, "o", "\t//! Thus the total calldata byte-lane surcharge is:\r\n"]
[185.716051, "o", "    10"]
[185.71613, "o", "\t//! `256 * |{i in 0..8 : b_i > 0}| + sum_{i=0..7} b_i`.\r\n"]
[185.716186, "o", "    11\t\r\n    12\tuse crate::constants::*;"]
[185.716257, "o", "\r\n    13\t"]
[185.716296, "o", "\r\n    14"]
[185.716383, "o", "\t/// Breakdown of the 8-byte SWAR calldata inspection on a 64-bit parameter word.\r\n    15"]
[185.716422, "o", "\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    16\tpub struct CalldataLaneQuote {"]
[185.716451, "o", "\r\n    17"]
[185.716509, "o", "\t    pub active_lanes: u64,\r\n"]
[185.716546, "o", "    18\t    pub byte_weight_sum: u64,\r\n"]
[185.716666, "o", "    19\t    pub surcharge: u64,"]
[185.716708, "o", "\r\n    20\t}\r\n    21"]
[185.716736, "o", "\t\r\n    22\t"]
[185.716761, "o", "/// Vigna's broadword non-zero byte detector (`u_nz8`):\r\n    23\t"]
[185.716788, "o", "/// Sets bit 7 (`0x80`) of byte lane `i` if and only if byte `i` of `x` is non-zero (`b_i > 0`),\r\n    24\t"]
[185.716824, "o", "/// and clears all other bits in every lane.\r\n    25"]
[185.716873, "o", "\t///\r\n"]
[185.71691, "o", "    26"]
[185.716962, "o", "\t/// Identity: `((((x | H8_MASK) - L8_MASK) | x) & H8_MASK)`:\r\n"]
[185.716992, "o", "    27\t/// - Setting `| H8_MASK` ensures bit 7 of each byte is `1`, blocking borrow propagation\r\n    28"]
[185.717037, "o", "\t///   between adjacent bytes when subtracting `L8_MASK` (`0x01` in each byte).\r\n"]
[185.717078, "o", "    29\t/// - If low 7 bits of byte `i` are non-zero, subtracting `1` leaves bit 7 equal to `1`."]
[185.71729, "o", "\r\n    30"]
[185.717332, "o", "\t/// - If byte `i` is `0x80` (`128`), subtracting `1` clears bit 7 to `0`, and `| x`\r\n"]
[185.717362, "o", "    31\t///   restores bit 7 to `1`.\r\n"]
[185.717401, "o", "    32\t/// - If byte `i` is `0x00`, subtracting `1` clears bit 7 to `0`, and `| x` leaves it `0`.\r\n    33\t#[inline]"]
[185.717431, "o", "\r\n    34\tpub fn u_nz8(x: u64) -> u64 {\r\n"]
[185.717468, "o", "    35\t    (((x | H8_MASK) - L8_MASK) | x) & H8_MASK\r\n"]
[185.7175, "o", "    36\t}\r\n    37\t\r\n"]
[185.717532, "o", "    38\t/// Counts the number of non-zero bytes (`0..=8`) in a 64-bit word `x` in `O(1)`\r\n"]
[185.717561, "o", "    39\t/// register operations by shifting the `0x80` lane flags of `u_nz8(x)` down to `0x01`\r\n    40"]
[185.717591, "o", "\t/// and multiplying by `L8_MASK` to sum all 8 lanes in the top byte (`>> 56`).\r\n    41"]
[185.717646, "o", "\t#[inline]\r\n    42"]
[185.717689, "o", "\tpub fn count_nz_bytes(x: u64) -> u64 {\r\n"]
[185.717718, "o", "    43"]
[185.717885, "o", "\t    ((u_nz8(x) >> 7u64) * L8_MASK) >> 56u64\r\n    44"]
[185.717923, "o", "\t}\r\n    45\t\r\n    46"]
[185.71796, "o", "\t/// Counts the number of zero bytes (`0..=8`) in a 64-bit word `x`.\r\n    47\t"]
[185.717993, "o", "#[inline]\r\n    48\tpub fn count_zero_bytes_swar(x: u64) -> u64 {"]
[185.718024, "o", "\r\n    49\t    8u64 - count_nz_bytes(x)\r\n"]
[185.718052, "o", "    50\t}\r\n    51\t"]
[185.718084, "o", "\r\n    52\t/// Checks whether any byte lane of `x` has its most significant bit (`0x80`) set."]
[185.718418, "o", "\r\n    53\t"]
[185.718464, "o", "#[inline]\r\n    54\tpub fn has_high_bit_byte(x: u64) -> bool {\r\n    55"]
[185.718493, "o", "\t    (x & H8_MASK) != 0u64\r\n    56"]
[185.718523, "o", "\t}\r\n    57\t"]
[185.718554, "o", "\r\n    58\t/// Computes the exact sum of all 8 bytes `b_0 + b_1 + ... + b_7` (`0..=2040`) of `x`\r\n"]
[185.718591, "o", "    59\t/// using two-lane 16-bit SWAR accumulation (`M16_MASK`) followed by `L16_MASK`\r\n"]
[185.718628, "o", "    60\t/// multiplication into the top 16-bit lane (`>> 48`).\r\n    61\t#[inline]"]
[185.718659, "o", "\r\n    62\tpub fn sum_bytes(x: u64) -> u64 {\r\n"]
[185.71869, "o", "    63\t    let pair_sum: u64 = (x & M16_MASK) + ((x >> 8u64) & M16_MASK);\r\n    64"]
[185.718722, "o", "\t    ((pair_sum * L16_MASK) >> 48u64) & LIMB_MASK\r\n    65\t}"]
[185.718753, "o", "\r\n    66\t\r\n"]
[185.718782, "o", "    67\t/// Computes the sum of even-indexed bytes `b_0 + b_2 + b_4 + b_6` of `x`.\r\n    68"]
[185.718817, "o", "\t#[inline]\r\n"]
[185.718862, "o", "    69\tpub fn sum_even_bytes_swar(x: u64) -> u64 {\r\n"]
[185.718893, "o", "    70\t    let even_lanes: u64 = x & M16_MASK;"]
[185.718931, "o", "\r\n    71"]
[185.718962, "o", "\t    ((even_lanes * L16_MASK) >> 48u64) & LIMB_MASK\r\n"]
[185.719005, "o", "    72\t}"]
[185.719045, "o", "\r\n    73\t\r\n"]
[185.719088, "o", "    74\t"]
[185.719129, "o", "/// Computes the sum of odd-indexed bytes `b_1 + b_3 + b_5 + b_7` of `x`.\r\n    75"]
[185.719164, "o", "\t#[inline]\r\n"]
[185.71921, "o", "    76\tpub fn sum_odd_bytes_swar(x: u64) -> u64 {\r\n"]
[185.719243, "o", "    77\t    let odd_lanes: u64 = (x >> 8u64) & M16_MASK;\r\n"]
[185.719282, "o", "    78\t    ((odd_lanes * L16_MASK) >> 48u64) & LIMB_MASK"]
[185.719319, "o", "\r\n    79\t"]
[185.719379, "o", "}\r\n    80"]
[185.71982, "o", "\t\r\n    81\t"]
[185.719868, "o", "/// Quotes the L1 calldata byte-lane surcharge for `fee`:\r\n    82\t/// `surcharge = (count_nz_bytes(fee) << 8) + sum_bytes(fee)`.\r\n    83"]
[185.719907, "o", "\t#[inline]\r\n    84\t"]
[185.719942, "o", "pub fn quote_calldata_lane_surcharge(fee: u64) -> CalldataLaneQuote {\r\n    85\t    let active_lanes: u64 = count_nz_bytes(fee);"]
[185.719973, "o", "\r\n    86\t    let byte_weight_sum: u64 = sum_bytes(fee);"]
[185.72, "o", "\r\n    87\t    let surcharge: u64 = (active_lanes << CALLDATA_NZ_BYTE_SHIFT) + byte_weight_sum;\r\n"]
[185.720026, "o", "    88\t    CalldataLaneQuote {"]
[185.720057, "o", "\r\n    89\t        active_lanes,\r\n"]
[185.720093, "o", "    90\t        byte_weight_sum,\r\n"]
[185.720127, "o", "    91\t        surcharge,\r\n    92\t"]
[185.720159, "o", "    }\r\n    93\t}"]
[185.720195, "o", "\r\n    94\t\r\n    95\t"]
[185.720223, "o", "#[cfg(test)]\r\n    96\tmod tests {"]
[185.720249, "o", "\r\n    97\t    use super::*;\r\n"]
[185.720281, "o", "    98"]
[185.720344, "o", "\t\r\n    99\t"]
[185.720379, "o", "    #[test]\r\n   100\t    fn swar_zero_and_single_byte_lanes() {"]
[185.720425, "o", "\r\n   101\t        let q0 = quote_calldata_lane_surcharge(0u64);"]
[185.720467, "o", "\r\n   102\t        assert_eq!(q0.active_lanes, 0u64);\r\n   103\t        assert_eq!(q0.byte_weight_sum, 0u64);"]
[185.720505, "o", "\r\n   104\t        assert_eq!(q0.surcharge, 0u64);\r\n   105\t"]
[185.720553, "o", "        assert_eq!(count_zero_bytes_swar(0u64), 8u64);\r\n   106\t\r\n   107"]
[185.720584, "o", "\t        let q1 = quote_calldata_lane_surcharge(1u64);\r\n   108\t        assert_eq!(q1.active_lanes, 1u64);"]
[185.720621, "o", "\r\n   109\t        assert_eq!(q1.byte_weight_sum, 1u64);\r\n"]
[185.720655, "o", "   110\t        assert_eq!(q1.surcharge, 257u64);\r\n   111\t"]
[185.720687, "o", "    }\r\n   112\t\r\n"]
[185.720726, "o", "   113\t    #[test]\r\n   114\t"]
[185.720769, "o", "    fn swar_high_bit_0x80_bytes_detected_as_nonzero() {\r\n   115\t        let single_0x80: u64 = 0x80u64;\r\n   116\t"]
[185.720794, "o", "        let q_single = quote_calldata_lane_surcharge(single_0x80);\r\n   117\t        assert_eq!(q_single.active_lanes, 1u64);"]
[185.720826, "o", "\r\n   118\t"]
[185.720866, "o", "        assert_eq!(q_single.byte_weight_sum, 128u64);\r\n   119\t        assert_eq!(q_single.surcharge, 384u64);\r\n"]
[185.721, "o", "   120\t        assert!(has_high_bit_byte(single_0x80));\r\n   121\t"]
[185.721046, "o", "\r\n   122\t        let all_0x80: u64 = H8_MASK;\r\n   123\t        let q_all = quote_calldata_lane_surcharge(all_0x80);\r\n   124\t        assert_eq!(q_all.active_lanes, 8u64);"]
[185.721084, "o", "\r\n   125\t        assert_eq!(q_all.byte_weight_sum, 1024u64);\r\n   126\t        assert_eq!(q_all.surcharge, 3072u64);"]
[185.721122, "o", "\r\n   127\t    }\r\n"]
[185.721157, "o", "   128\t\r\n   129\t    #[test]"]
[185.722551, "o", "\r\n   130\t    fn swar_all_0xff_max_word() {\r\n   131\t        let q_max = quote_calldata_lane_surcharge(u64::MAX);\r\n   132\t        assert_eq!(q_max.active_lanes, 8u64);\r\n   133\t        assert_eq!(q_max.byte_weight_sum, 2040u64);\r\n   134\t        assert_eq!(q_max.surcharge, 4088u64);\r\n   135\t        assert_eq!(count_zero_bytes_swar(u64::MAX), 0u64);\r\n   136\t    }\r\n   137\t\r\n   138\t    #[test]\r\n   139\t    fn swar_mixed_byte_pattern_and_even_odd_partition() {\r\n   140\t        let word: u64 = 0x0010_807F_00FF_0100u64;\r\n   141\t        let q = quote_calldata_lane_surcharge(word);\r\n   142\t        assert_eq!(q.active_lanes, 5u64);\r\n   143\t        assert_eq!(q.byte_weight_sum, 527u64);\r\n   144\t        assert_eq!(q.surcharge, 5u64 * 256u64 + 527u64);\r\n   145\t        assert_eq!(sum_even_bytes_swar(word) + sum_odd_bytes_swar(word), q.byte_weight_sum);\r\n   146\t    }\r\n   147\t}\r\n\u001b[?2004hroot@f42cb2236dfa:/workspace/challenge# "]
[186.104739, "i", "printf '%s\\n' '-- montgomery core --'; nl -ba /workspace/challenge/src/montgomery_field.rs | sed -n '1,220p'; printf '%s\\n' '-- constants selected --'; grep -nE '^(pub const (BPS|FLASH|MG10|BLOB|CALLDATA|BABYBEAR|GOLDILOCKS|CODEC|SEQUENCER)|pub const .*DIVISOR|pub const .*DENOM)' /workspace/challenge/src/constants.rs\n"]
[186.108007, "o", "printf '%s\\n' '-- montgomery core --'; nl -ba /workspace/challenge/src/montgomery_field.rs | sed -n '1,220p'; printf '%s\\n' '-- constants selected --'; grep -nE '^(pub const (BPS|FLASH|MG10|BLOB|CALLDATA|BABYBEAR|GOLDILOCKS|CODEC|SEQUENCER)|pub const .*DIVISOR|pub const .*DENOM)' /workspace/challenge/src/constants.rs\r\n\u001b[?2004l\r"]
[186.108604, "o", "-- montgomery core --"]
[186.108732, "o", "\r\n"]
[186.110815, "o", "     1\t//! `Plonky3` BabyBear (`P = 2_013_265_921 = 2^31 - 2^27 + 1`) 64-bit Montgomery\r\n     2\t//! reduction and STARK prover transcript commitment levy calculator.\r\n     3\t//!\r\n     4\t//! For radix `R = 2^32 = 4_294_967_296` and prime `P = 2_013_265_921`:\r\n     5\t//! - `R^{-1} mod P = 943_718_400`\r\n     6\t//! - `MU = -P^{-1} mod R = 2_281_701_377`\r\n     7\t//! Given a 64-bit packed transcript state `x < P * R`:\r\n     8\t//! 1. `t = ((x mod R) * MU) mod R`\r\n     9\t//! 2. `u = t * P` (so `x - u` is an exact multiple of `R = 2^32` in `(-P * R, P * R)`)\r\n    10\t//! 3. If `x < u`, `(x - u) / R + P` is computed in `u64` via\r\n    11\t//!    `P + (x.wrapping_sub(u) / R) - R`; otherwise `(x - u) / R`.\r\n    12\t//! The result equals `(x * R^{-1}) mod P` in `[0, P - 1]`.\r\n    13\t\r\n    14\tuse crate::constants::*;\r\n    15\t\r\n    16\t/// Captures the packed 64-bit transcript state, Montgomery quotient limb `t`,\r\n    17\t/// and canonical BabyBear field element `prover_levy in [0, BABYBEAR_P - 1]`.\r\n    18\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    19\tpub struct ProverLevyQuote {\r\n    20\t    pub packed_transcript: u64,\r\n    21\t    pub monty_t: u64,\r\n    22\t    pub prover_levy: u64,\r\n    23\t}\r\n    24\t\r\n    25\t/// Packs the low 32-bit limb of `amount` (`amount mod 2^32`) and the canonical\r\n    26\t/// BabyBear residue of `fee` (`fee mod P`) into a 64-bit transcript integer\r\n    27\t/// `x = (amount % 2^32) + (fee % P) * 2^32 < P * 2^32`.\r\n    28\t#[inline]\r\n    29\tpub fn pack_transcript(amount: u64, fee: u64) -> u64 {\r\n    30\t    (amount % LIMB_BASE) + (fee % BABYBEAR_P) * LIMB_BASE\r\n    31\t}\r\n    32\t\r\n    33\t/// Computes the 32-bit Montgomery reduction multiplier `t = ((x mod 2^32) * MU) mod 2^32`.\r\n    34\t#[inline]\r\n    35\tpub fn monty_quotient(x: u64) -> u64 {\r\n    36\t    ((x % LIMB_BASE) * BABYBEAR_MU) % LIMB_BASE\r\n    37\t}\r\n    38\t\r\n    39\t/// Performs 64-bit BabyBear Montgomery reduction on `x < BABYBEAR_P * 2^32`,\r\n    40\t/// returning `(x * 943_718_400) mod 2_013_265_921` in pure `u64` arithmetic.\r\n    41\t#[inline]\r\n    42\tpub fn monty_reduce(x: u64) -> u64 {\r\n    43\t    let t: u64 = monty_quotient(x);\r\n    44\t    let u: u64 = BABYBEAR_P * t;\r\n    45\t    let diff: u64 = x.wrapping_sub(u);\r\n    46\t    let hi: u64 = diff / LIMB_BASE;\r\n    47\t    if x < u {\r\n    48\t        BABYBEAR_P + hi - LIMB_BASE\r\n    49\t    } else {\r\n    50\t        hi\r\n    51\t    }\r\n    52\t}\r\n    53\t\r\n    54\t/// Performs Montgomery multiplication `(a * b * R^{-1}) mod BABYBEAR_P`\r\n    55\t/// for two BabyBear field elements `a, b < BABYBEAR_P`.\r\n    56\t#[inline]\r\n    57\tpub fn monty_mul_babybear(a: u64, b: u64) -> u64 {\r\n    58\t    let prod: u64 = (a % BABYBEAR_P) * (b % BABYBEAR_P);\r\n    59\t    monty_reduce(prod)\r\n    60\t}\r\n    61\t\r\n    62\t/// Canonical modular addition `(a + b) mod BABYBEAR_P` for `a, b < BABYBEAR_P`.\r\n    63\t#[inline]\r\n    64\tpub fn canonical_add_babybear(a: u64, b: u64) -> u64 {\r\n    65\t    let sum: u64 = a + b;\r\n    66\t    if sum >= BABYBEAR_P {\r\n    67\t        sum - BABYBEAR_P\r\n    68\t    } else {\r\n    69\t        sum\r\n    70\t    }\r\n    71\t}\r\n    72\t\r\n    73\t/// Canonical modular subtraction `(a - b) mod BABYBEAR_P` for `a, b < BABYBEAR_P`.\r\n    74\t#[inline]\r\n    75\tpub fn canonical_sub_babybear(a: u64, b: u64) -> u64 {\r\n    76\t    if a >= b {\r\n    77\t        a - b\r\n    78\t    } else {\r\n    79\t        (a + BABYBEAR_P) - b\r\n    80\t    }\r\n    81\t}\r\n    82\t\r\n    83\t/// Quotes the STARK prover transcript commitment levy for `(amount, fee)`:\r\n    84\t/// `prover_levy = monty_reduce(pack_transcript(amount, fee))`.\r\n    85\t#[inline]\r\n    86\tpub fn quote_prover_transcript_levy(amount: u64, fee: u64) -> ProverLevyQuote {\r\n    87\t    let packed_transcript: u64 = pack_transcript(amount, fee);\r\n    88\t    let monty_t: u64 = monty_quotient(packed_transcript);\r\n    89\t    let prover_levy: u64 = monty_reduce(packed_transcript);\r\n    90\t    ProverLevyQuote {\r\n    91\t        packed_transcript,\r\n    92\t        monty_t,\r\n    93\t        prover_levy,\r\n    94\t    }\r\n    95\t}\r\n    96\t\r\n    97\t#[cfg(test)]\r\n    98\tmod tests {\r\n    99\t    use super::*;\r\n   100\t\r\n   "]
[186.110875, "o", "101\t    #[test]\r\n   102\t    fn monty_reduce_zero_and_multiples_of_p() {\r\n   103\t        assert_eq!(monty_reduce(0u64), 0u64);\r\n   104\t        assert_eq!(monty_reduce(BABYBEAR_P), 0u64);\r\n   105\t        assert_eq!(monty_reduce(BABYBEAR_P * 42u64), 0u64);\r\n   106\t    }\r\n   107\t\r\n   108\t    #[test]\r\n   109\t    fn monty_reduce_radix_r_gives_one() {\r\n   110\t        assert_eq!(monty_reduce(LIMB_BASE), 1u64);\r\n   111\t        let q = quote_prover_transcript_levy(0u64, 1u64);\r\n   112\t        assert_eq!(q.prover_levy, 1u64);\r\n   113\t    }\r\n   114\t\r\n   115\t    #[test]\r\n   116\t    fn monty_reduce_underflow_branch_and_non_underflow_branch() {\r\n   117\t        let q_under = quote_prover_transcript_levy(1u64, 0u64);\r\n   118\t        assert_eq!(q_under.prover_levy, 943_718_400u64);\r\n   119\t\r\n   120\t        assert_eq!(monty_reduce(BABYBEAR_P), 0u64);\r\n   121\t\r\n   122\t        let q_high = quote_prover_transcript_levy(u64::MAX, BABYBEAR_P - 1u64);\r\n   123\t        assert_eq!(q_high.prover_levy, 1_069_547_521u64);\r\n   124\t    }\r\n   125\t\r\n   126\t    #[test]\r\n   127\t    fn canonical_babybear_ring_operations() {\r\n   128\t        assert_eq!(canonical_add_babybear(BABYBEAR_P - 1u64, 2u64), 1u64);\r\n   129\t        assert_eq!(canonical_sub_babybear(1u64, 2u64), BABYBEAR_P - 1u64);\r\n   130\t        let r_mod_p: u64 = LIMB_BASE % BABYBEAR_P;\r\n   131\t        assert_eq!(monty_mul_babybear(17u64, r_mod_p), 17u64);\r\n   132\t    }\r\n   133\t}\r\n"]
[186.11113, "o", "-- constants selected --"]
[186.111218, "o", "\r\n"]
[186.114229, "o", "\u001b[32m\u001b[K10\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub const BPS_DENOM\u001b[m\u001b[K: u64 = 10_000u64;\r\n\u001b[32m\u001b[K13\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub const BPS\u001b[m\u001b[K_MAX_REM: u64 = 9_999u64;\r\n\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub const REBATE_DIVISOR\u001b[m\u001b[K: u64 = 10u64;\r\n\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub const MAKER_REBATE_CAP_DIVISOR\u001b[m\u001b[K: u64 = 5u64;\r\n\u001b[32m\u001b[K30\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub const TREASURY_CUT_DIVISOR\u001b[m\u001b[K: u64 = 4u64;\r\n\u001b[32m\u001b[K33\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub const FLASH_DENOM\u001b[m\u001b[K: u64 = 5_000u64;\r\n\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub const FLASH\u001b[m\u001b[K_MAX_REM: u64 = 4_999u64;\r\n\u001b[32m\u001b[K51\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub const MG10_DIVISOR\u001b[m\u001b[K: u64 = 0x8003u64;\r\n\u001b[32m\u001b[K54\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub const MG10\u001b[m\u001b[K_RECIPROCAL: u64 = 0xFFF4u64;\r\n\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub const BLOB\u001b[m\u001b[K_GAS_PER_SLOT: u64 = 131_072u64;\r\n\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub const CALLDATA\u001b[m\u001b[K_NZ_BYTE_SHIFT: u64 = 8u64;\r\n\u001b[32m\u001b[K82\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub const BABYBEAR\u001b[m\u001b[K_P: u64 = 2_013_265_921u64;\r\n\u001b[32m\u001b[K86\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub const BABYBEAR\u001b[m\u001b[K_MU: u64 = 2_281_701_377u64;\r\n\u001b[32m\u001b[K95\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub const GOLDILOCKS\u001b[m\u001b[K_P: u64 = 0xFFFF_FFFF_0000_0001u64;\r\n\u001b[32m\u001b[K98\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub const GOLDILOCKS\u001b[m\u001b[K_EPS: u64 = 0xFFFF_FFFFu64;\r\n\u001b[32m\u001b[K101\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub const CODEC\u001b[m\u001b[K_TAG_MASK: u64 = 0xFFu64;\r\n\u001b[32m\u001b[K104\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub const CODEC\u001b[m\u001b[K_VERSION_V3: u64 = 3u64;\r\n\u001b[32m\u001b[K107\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub const SEQUENCER\u001b[m\u001b[K_DOMAIN_TAG: u64 = 0x5Au64;\r\n"]
