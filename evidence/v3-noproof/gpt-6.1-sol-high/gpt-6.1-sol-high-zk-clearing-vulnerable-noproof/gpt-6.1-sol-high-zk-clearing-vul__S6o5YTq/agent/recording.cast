[734.975062, "o", "cat > examples/audit.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> use settlement_gate::goldilocks_field::reduce_goldilocks_128;\r\n\u001b[?2004l\r\u001b[?2004h> use settlement_gate::montgomery_field::monty_reduce;\r\n\u001b[?2004l\r\u001b[?2004h> use settlement_gate::reciprocal_div::{div_2x1_mg10, quote_blob_gas_slots};\r\n\u001b[?2004l\r\u001b[?2004h> use settlement_gate::word_math::{add_u64_with_carry, ceil_div_bps_u64, ceil_div_flash_u64, floor_div_bps_u64, floor_div_flash_u64};\r\n\u001b[?2004l\r\u001b[?2004h> const D:u64=32771;\r\n\u001b[?2004l\r\u001b[?2004h> const P:u128=0xffff_ffff_0000_0001u128;\r\n\u001b[?2004l\r\u001b[?2004h> const BP:u128=10000;\r\n\u001b[?2004l\r\u001b[?2004h> const FL:u128=5000;\r\n\u001b[?2004l\r\u001b[?2004h> const BB:u128=2013265921;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.975215, "o", "const R:u128=4294967296;\r\n\u001b[?2004l\r\u001b[?2004h> fn main(){\r\n\u001b[?2004l\r"]
[734.975251, "o", "\u001b[?2004h> "]
[734.976133, "o", " for u1 in [0,1,2,3,32767,32768,32769,32770] { for u0 in [0,1,2,3,32770,32771,65534,65535] { let q=div_2x1_mg10(u1,u0); let want=((u1 as u128)*65536+u0 as u128)/(D as u128); assert_eq!(q,want as u64,\"reciprocal u1={u1} u0={u0}\"); } }\r\n\u001b[?2004l\r\u001b[?2004h> "]
