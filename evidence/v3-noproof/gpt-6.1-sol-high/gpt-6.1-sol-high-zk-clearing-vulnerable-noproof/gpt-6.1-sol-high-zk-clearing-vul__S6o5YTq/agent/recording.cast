[734.977953, "o", " for _ in 0..2_000_000 { x=x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407); let lo=x; x=x.rotate_left(19).wrapping_add(0x9e3779b97f4a7c15); let hi=x; let want=(((lo as u128)+((hi as u128)<<64))%P) as u64; assert_eq!(reduce_goldilocks_128(lo,hi),want,\"gold lo={lo} hi={hi}\"); let z=lo as u128; let t=((z & (R-1))*2281701377u128)%R; let u=(z+t*BB)/R; let mw=(if u>=BB {u-BB} else {u}) as u64; assert_eq!(monty_reduce(lo),mw,\"mont lo={lo}\"); }\r\n\u001b[?2004l\r"]
[734.977989, "o", "\u001b[?2004h> "]
