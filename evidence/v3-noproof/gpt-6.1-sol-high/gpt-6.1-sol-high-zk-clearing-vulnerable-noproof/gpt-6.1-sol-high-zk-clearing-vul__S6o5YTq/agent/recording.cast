[614.059613, "o", "\t//! 64-bit word carry/borrow tracking and 128-bit carry-folded quotient kernels.\r\n     2\t//!\r\n     3\t//! Because two `u64` inputs `lhs` and `rhs` can sum to `[0, 2 * 2^64 - 2]`,\r\n     4\t//! computing exact floor and ceiling quotients `floor((lhs + rhs) / D)` and\r\n     5\t//! `ceil((lhs + rhs) / D)` without `u128` requires tracking the 1-bit carry flag\r\n     6\t//! across the `2^64` word boundary and folding `2^64 = Q_64 * D + R_64`.\r\n     7\t\r\n     8\tuse crate::constants::*;\r\n     9\t\r\n    10\t/// Represents the exact 65-bit sum `low_word + (high_carry as u64) * 2^64`\r\n    11\t/// of two 64-bit unsigned words.\r\n    12\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    13\tpub struct WordSum {\r\n    14\t    pub low_word: u64,\r\n    15\t    pub high_carry: bool,\r\n    16\t}\r\n    17\t\r\n    18\t/// Represents the 64-bit wrapped difference `lhs.wrapping_sub(rhs)` together\r\n    19\t/// with an explicit underflow borrow indicator (`lhs < rhs`).\r\n    20\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    21\tpub struct WordDiff {\r\n    22\t    pub diff_word: u64,\r\n    23\t    pub underflow_borrow: bool,\r\n    24\t}\r\n    25\t\r\n    26\t/// Adds two `u64` words in 64-bit register arithmetic and captures the 64-bit\r\n    27\t/// overflow carry flag (`low_word < lhs`).\r\n    28\t#[inline]\r\n    29\tpub fn add_u64_with_carry(lhs: u64, rhs: u64) -> WordSum {\r\n    30\t    let low_word: u64 = lhs.wrapping_add(rhs);\r\n    31\t    let high_carry: bool = low_word < lhs;\r\n    32\t    WordSum {\r\n    33\t        low_word,\r\n    34\t        high_carry,\r\n    35\t    }\r\n    36\t}\r\n    37\t\r\n    38\t/// Subtracts `rhs` from `lhs` in 64-bit register arithmetic and captures the\r\n    39\t/// underflow borrow flag (`lhs < rhs`).\r\n    40\t#[inline]\r\n    41\tpub fn sub_u64_with_borrow(lhs: u64, rhs: u64) -> WordDiff {\r\n    42\t    let diff_word: u64 = lhs.wrapping_sub(rhs);\r\n    43\t    let underflow_borrow: bool = lhs < rhs;\r\n    44\t    WordDiff {\r\n    45\t        diff_word,\r\n    46\t        underflow_borrow,\r\n    47\t    }\r\n    48\t}\r\n    49\t\r\n    50\t/// Extracts the low 16-bit limb `word & 0xFFFF` (`word mod 2^16`).\r\n    51\t#[inline]\r\n    52\tpub fn extract_low_u16(word: u64) -> u64 {\r\n    53\t    word & LIMB_MASK\r\n    54\t}\r\n    55\t\r\n    56\t/// Extracts the low 32-bit limb `word & 0xFFFF_FFFF` (`word mod 2^32`).\r\n    57\t#[inline]\r\n    58\tpub fn extract_low_u32(word: u64) -> u64 {\r\n    59\t    word & LOW32_MASK\r\n    60\t}\r\n    61\t\r\n    62\t/// Extracts the high 32-bit limb `word >> 32` (`floor(word / 2^32)`).\r\n    63\t#[inline]\r\n    64\tpub fn extract_high_u32(word: u64) -> u64 {\r\n    65\t    word >> 32u64\r\n    66\t}\r\n    67\t\r\n    68\t/// Recombines a 32-bit low limb and 32-bit high limb into a 64-bit word.\r\n    69\t#[inline]\r\n    70\tpub fn pack_u32_limbs(low_u32: u64, high_u32: u64) -> u64 {\r\n    71\t    (low_u32 & LOW32_MASK) | ((high_u32 & LOW32_MASK) << 32u64)\r\n    72\t}\r\n    73\t\r\n    74\t/// Classifies whether a 65-bit combined notional `sum` meets or exceeds\r\n    75\t/// `INSTITUTIONAL_BAND_MIN`.\r\n    76\t#[inline]\r\n    77\tpub fn is_institutional_notional(sum: WordSum) -> bool {\r\n    78\t    if sum.high_carry {\r\n    79\t        true\r\n    80\t    } else {\r\n    81\t        sum.low_word >= INSTITUTIONAL_BAND_MIN\r\n    82\t    }\r\n    83\t}\r\n    84\t\r\n    85\t/// Computes the exact remainder `(lhs + rhs) mod BPS_DENOM` (`BPS_DENOM = 10_000`)\r\n    86\t/// over the full 65-bit `WordSum` range in pure `u64` arithmetic.\r\n    87\t#[inline]\r\n    88\tpub fn rem_bps_u64(sum: WordSum) -> u64 {\r\n    89\t    if sum.high_carry {\r\n    90\t        ((sum.low_word % BPS_DENOM) + U64_MOD_BPS_REM) % BPS_DENOM\r\n    91\t    } else {\r\n    92\t        sum.low_word % BPS_DENOM\r\n    93\t    }\r\n    94\t}\r\n    95\t\r\n    96\t/// Computes the exact floor quotient `floor((lhs + rhs) / BPS_DENOM)` (`BPS_DENOM = 10_000`)\r\n    97\t/// over the full 65-bit `WordSum` range using pure `u64` carry folding.\r\n    98\t#[inline]\r\n    99\tpub fn floor_div_bps_u64(sum: WordSum) -> u64 {\r\n   100\t    if sum.high_carry {\r\n   101\t        let folded_rem: u64 = (sum.low_word % BPS_DENOM) + U64_MOD_BPS_REM;\r\n   102\t        U64_MOD_BPS_QUOT + (sum.low_word / BPS_DENOM) + (folded_rem / BP"]
[614.070652, "o", "S_DENOM)\r\n   103\t    } else {\r\n   104\t        sum.low_word / BPS_DENOM\r\n   105\t    }\r\n   106\t}\r\n   107\t\r\n   108\t/// Computes the ceiling quotient `ceil((lhs + rhs) / BPS_DENOM)` (`BPS_DENOM = 10_000`),\r\n   109\t/// equivalent in exact integer arithmetic to `floor((lhs + rhs + 9_999) / 10_000)`,\r\n   110\t/// over the full 65-bit `WordSum` range using pure `u64` arithmetic.\r\n   111\t#[inline]\r\n   112\tpub fn ceil_div_bps_u64(sum: WordSum) -> u64 {\r\n   113\t    if sum.high_carry {\r\n   114\t        let folded_rem: u64 = (sum.low_word % BPS_DENOM) + U64_MOD_BPS_REM;\r\n   115\t        U64_MOD_BPS_QUOT + (sum.low_word / BPS_DENOM) + ((folded_rem + BPS_MAX_REM) / BPS_DENOM)\r\n   116\t    } else {\r\n   117\t        let biased: u64 = sum.low_word.wrapping_add(BPS_MAX_REM);\r\n   118\t        if biased < sum.low_word {\r\n   119\t            (sum.low_word / BPS_DENOM) + (((sum.low_word % BPS_DENOM) + BPS_MAX_REM) / BPS_DENOM)\r\n   120\t        } else {\r\n   121\t            biased / BPS_DENOM\r\n   122\t        }\r\n   123\t    }\r\n   124\t}\r\n   125\t\r\n   126\t/// Computes the exact floor quotient `floor((lhs + rhs) / FLASH_DENOM)` (`FLASH_DENOM = 5_000`)\r\n   127\t/// over the full 65-bit `WordSum` range in pure `u64` arithmetic.\r\n   128\t#[inline]\r\n   129\tpub fn floor_div_flash_u64(sum: WordSum) -> u64 {\r\n   130\t    if sum.high_carry {\r\n   131\t        let folded_rem: u64 = (sum.low_word % FLASH_DENOM) + U64_MOD_FLASH_REM;\r\n   132\t        U64_MOD_FLASH_QUOT + (sum.low_word / FLASH_DENOM) + (folded_rem / FLASH_DENOM)\r\n   133\t    } else {\r\n   134\t        sum.low_word / FLASH_DENOM\r\n   135\t    }\r\n   136\t}\r\n   137\t\r\n   138\t/// Computes the exact ceiling quotient `ceil((lhs + rhs) / FLASH_DENOM)` (`FLASH_DENOM = 5_000`),\r\n   139\t/// equivalent to `floor((lhs + rhs + 4_999) / 5_000)`, in pure `u64` arithmetic.\r\n   140\t#[inline]\r\n   141\tpub fn ceil_div_flash_u64(sum: WordSum) -> u64 {\r\n   142\t    if sum.high_carry {\r\n   143\t        let folded_rem: u64 = (sum.low_word % FLASH_DENOM) + U64_MOD_FLASH_REM;\r\n   144\t        U64_MOD_FLASH_QUOT + (sum.low_word / FLASH_DENOM) + ((folded_rem + FLASH_MAX_REM) / FLASH_DENOM)\r\n   145\t    } else {\r\n   146\t        let biased: u64 = sum.low_word.wrapping_add(FLASH_MAX_REM);\r\n   147\t        if biased < sum.low_word {\r\n   148\t            (sum.low_word / FLASH_DENOM) + ((biased + U64_MOD_FLASH_REM) / FLASH_DENOM)\r\n   149\t        } else {\r\n   150\t            biased / FLASH_DENOM\r\n   151\t        }\r\n   152\t    }\r\n   153\t}\r\n   154\t\r\n   155\t#[cfg(test)]\r\n   156\tmod tests {\r\n   157\t    use super::*;\r\n   158\t\r\n   159\t    #[test]\r\n   160\t    fn add_and_sub_carry_borrow_flags() {\r\n   161\t        let s0 = add_u64_with_carry(100u64, 250u64);\r\n   162\t        assert_eq!(s0.low_word, 350u64);\r\n   163\t        assert!(!s0.high_carry);\r\n   164\t\r\n   165\t        let s1 = add_u64_with_carry(u64::MAX, 1u64);\r\n   166\t        assert_eq!(s1.low_word, 0u64);\r\n   167\t        assert!(s1.high_carry);\r\n   168\t\r\n   169\t        let d0 = sub_u64_with_borrow(500u64, 120u64);\r\n   170\t        assert_eq!(d0.diff_word, 380u64);\r\n   171\t        assert!(!d0.underflow_borrow);\r\n   172\t\r\n   173\t        let d1 = sub_u64_with_borrow(10u64, 20u64);\r\n   174\t        assert!(d1.underflow_borrow);\r\n   175\t    }\r\n   176\t\r\n   177\t    #[test]\r\n   178\t    fn limb_extraction_and_packing_roundtrip() {\r\n   179\t        let w: u64 = 0x1234_5678_9ABC_DEF0u64;\r\n   180\t        assert_eq!(extract_low_u16(w), 0xDEF0u64);\r\n-- word_math remainder --\r\nsed: unrecognized option '-- goldilocks_field.rs --'\r\nUsage: sed [OPTION]... {script-only-if-no-other-script} [input-file]...\r\n\r\n  -n, --quiet, --silent\r\n                 suppress automatic printing of pattern space\r\n      --debug\r\n                 annotate program execution\r\n  -e script, --expression=script\r\n                 add the script to the commands to be executed\r\n  -f script-file, --file=script-file\r\n                 add the contents of script-file to the commands to be executed\r\n  --follow-symlinks\r\n                 follow symlinks when processing in place\r\n  -i[SUFFIX], --in-place[=SUFFIX]\r\n                 edit files in place (makes backup if S"]
[614.070788, "o", "UFFIX supplied)\r\n  -l N, --line-length=N\r\n                 specify the desired line-wrap length for the `l' command\r\n  --posix\r\n                 disable all GNU extensions.\r\n  -E, -r, --regexp-extended\r\n                 use extended regular expressions in the script\r\n                 (for portability use POSIX -E).\r\n  -s, --separate\r\n                 consider files as separate rather than as a single,\r\n                 continuous long stream.\r\n      --sandbox\r\n                 operate in sandbox mode (disable e/r/w commands).\r\n  -u, --unbuffered\r\n                 load minimal amounts of data from the input files and flush\r\n                 the output buffers more often\r\n  -z, --null-data\r\n                 separate lines by NUL characters\r\n      --help     display this help and exit\r\n      --version  output version information and exit\r\n\r\nIf no -e, --expression, -f, or --file option is given, then the first\r\nnon-option argument is taken as the sed script to interpret.  All\r\nremaining arguments are names of input files; if no input files are\r\nspecified, then the standard input is read.\r\n\r\nGNU sed home page: <https://www.gnu.org/software/sed/>.\r\nGeneral help using GNU software: <https://www.gnu.org/gethelp/>.\r\n     1\t//! `recmo/goldilocks` 128-bit prime field reduction (`P_G = 2^64 - 2^32 + 1`)\r\n     2\t//! for cross-chain L1 bridge verification fee quotes.\r\n     3\t//!\r\n     4\t//! Because `2^64 ≡ 2^32 - 1 = EPS (mod P_G)`, a 128-bit integer `x_lo + x_hi * 2^64`\r\n     5\t//! is reduced modulo `P_G` in pure `u64` arithmetic by splitting `x_hi` into its\r\n     6\t//! high 32-bit limb `x_hi_hi = x_hi >> 32` and low 32-bit limb `x_hi_lo = x_hi & EPS`:\r\n     7\t//! 1. Subtract `x_hi_hi` from `x_lo` (compensating by `-EPS` on borrow).\r\n     8\t//! 2. Add `x_hi_lo * EPS` (compensating by `+EPS` on 64-bit carry).\r\n     9\t//! 3. Canonicalize into `[0, P_G - 1]` by subtracting `P_G` if `r >= P_G`.\r\n    10\t\r\n    11\tuse crate::constants::*;\r\n    12\t\r\n    13\t/// Bridge verifier fee quote produced by Goldilocks 128-bit reduction.\r\n    14\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    15\tpub struct GoldilocksQuote {\r\n    16\t    pub folded_low: u64,\r\n    17\t    pub canonical_residue: u64,\r\n    18\t    pub bridge_fee: u64,\r\n    19\t}\r\n    20\t\r\n    21\t/// Performs the first Goldilocks folding step `x_lo - (x_hi >> 32) mod 2^64`,\r\n    22\t/// returning `(r0, borrow)`.\r\n    23\t#[inline]\r\n    24\tpub fn reduce_goldilocks_step1(x_lo: u64, x_hi: u64) -> (u64, bool) {\r\n    25\t    let x_hi_hi: u64 = x_hi >> 32u64;\r\n    26\t    x_lo.overflowing_sub(x_hi_hi)\r\n    27\t}\r\n    28\t\r\n    29\t/// Reduces a 128-bit value `(x_lo, x_hi)` modulo the Goldilocks prime\r\n    30\t/// `GOLDILOCKS_P = 0xFFFF_FFFF_0000_0001` in pure `u64` arithmetic.\r\n    31\t#[inline]\r\n    32\tpub fn reduce_goldilocks_128(x_lo: u64, x_hi: u64) -> u64 {\r\n    33\t    let x_hi_lo: u64 = x_hi & GOLDILOCKS_EPS;\r\n    34\t    let (t0, borrow): (u64, bool) = reduce_goldilocks_step1(x_lo, x_hi);\r\n    35\t    let t1: u64 = if borrow {\r\n    36\t        t0.wrapping_add(GOLDILOCKS_P)\r\n    37\t    } else {\r\n    38\t        t0\r\n    39\t    };\r\n    40\t    let prod: u64 = x_hi_lo * GOLDILOCKS_EPS;\r\n    41\t    let (t2, carry): (u64, bool) = t1.overflowing_add(prod);\r\n    42\t    let t3: u64 = if carry {\r\n    43\t        t2.wrapping_add(GOLDILOCKS_EPS)\r\n    44\t    } else {\r\n    45\t        t2\r\n    46\t    };\r\n    47\t    if t3 >= GOLDILOCKS_P {\r\n    48\t        t3 - GOLDILOCKS_P\r\n    49\t    } else {\r\n    50\t        t3\r\n    51\t    }\r\n    52\t}\r\n    53\t\r\n    54\t/// Canonicalizes a single 64-bit word `x` modulo `GOLDILOCKS_P`.\r\n    55\t#[inline]\r\n    56\tpub fn canonicalize_goldilocks_u64(x: u64) -> u64 {\r\n    57\t    if x >= GOLDILOCKS_P {\r\n    58\t        x - GOLDILOCKS_P\r\n    59\t    } else {\r\n    60\t        x\r\n    61\t    }\r\n    62\t}\r\n    63\t\r\n    64\t/// Canonical modular addition `(a + b) mod GOLDILOCKS_P` for `a, b < GOLDILOCKS_P`.\r\n    65\t#[inline]\r\n    66\tpub fn add_goldilocks_mod(a: u64, b: u64) -> u64 {\r\n    67\t    reduce_goldilocks_128(a.wrapping_add(b), if a.wrapping_add(b) < a { 1u64 } else { 0u64 })\r\n    68\t}\r\n    69\t\r\n  "]
[614.07084, "o", "  70\t/// Canonical modular subtraction `(a - b) mod GOLDILOCKS_P` for `a, b < GOLDILOCKS_P`.\r\n    71\t#[inline]\r\n    72\tpub fn sub_goldilocks_mod(a: u64, b: u64) -> u64 {\r\n    73\t    let ca: u64 = canonicalize_goldilocks_u64(a);\r\n    74\t    let cb: u64 = canonicalize_goldilocks_u64(b);\r\n    75\t    if ca >= cb {\r\n    76\t        ca - cb\r\n    77\t    } else {\r\n    78\t        (GOLDILOCKS_P - cb) + ca\r\n    79\t    }\r\n    80\t}\r\n    81\t\r\n    82\t/// Folds a 64-bit commitment word with a 32-bit challenge scalar in the Goldilocks field.\r\n    83\t#[inline]\r\n    84\tpub fn fold_goldilocks_challenge(commitment: u64, challenge_u32: u64) -> u64 {\r\n    85\t    let scalar: u64 = challenge_u32 & LOW32_MASK;\r\n    86\t    let lo_limb: u64 = commitment & LOW32_MASK;\r\n    87\t    let hi_limb: u64 = commitment >> 32u64;\r\n    88\t    let prod_lo: u64 = lo_limb * scalar;\r\n    89\t    let prod_hi: u64 = hi_limb * scalar;\r\n    90\t    let x_lo: u64 = prod_lo.wrapping_add(prod_hi << 32u64);\r\n    91\t    let carry: u64 = if x_lo < prod_lo { 1u64 } else { 0u64 };\r\n    92\t    let x_hi: u64 = (prod_hi >> 32u64) + carry;\r\n    93\t    reduce_goldilocks_128(x_lo, x_hi)\r\n    94\t}\r\n    95\t\r\n    96\t/// Quotes a cross-chain bridge verifier fee from `(amount, fee)` in the Goldilocks field.\r\n    97\t#[inline]\r\n    98\tpub fn quote_bridge_verifier_fee(amount: u64, fee: u64) -> GoldilocksQuote {\r\n    99\t    let (folded_low, _borrow): (u64, bool) = reduce_goldilocks_step1(amount, fee);\r\n   100\t    let canonical_residue: u64 = reduce_goldilocks_128(amount, fee);\r\n   101\t    let bridge_fee: u64 = canonical_residue;\r\n   102\t    GoldilocksQuote {\r\n   103\t        folded_low,\r\n   104\t        canonical_residue,\r\n   105\t        bridge_fee,\r\n   106\t    }\r\n   107\t}\r\n   108\t\r\n   109\t#[cfg(test)]\r\n   110\tmod tests {\r\n   111\t    use super::*;\r\n   112\t\r\n   113\t    #[test]\r\n   114\t    fn goldilocks_canonicalization_at_modulus_boundary() {\r\n   115\t        assert_eq!(reduce_goldilocks_128(0u64, 0u64), 0u64);\r\n   116\t        assert_eq!(reduce_goldilocks_128(GOLDILOCKS_P, 0u64), 0u64);\r\n   117\t        assert_eq!(reduce_goldilocks_128(0u64, 1u64), GOLDILOCKS_EPS);\r\n   118\t        assert_eq!(reduce_goldilocks_128(0u64, 4_294_967_296u64), GOLDILOCKS_P - 1u64);\r\n   119\t        assert_eq!(reduce_goldilocks_128(1u64, 4_294_967_296u64), 0u64);\r\n   120\t        assert_eq!(canonicalize_goldilocks_u64(GOLDILOCKS_P + 5u64), 5u64);\r\n   121\t    }\r\n   122\t\r\n   123\t    #[test]\r\n   124\t    fn goldilocks_bridge_quote_and_modular_add_sub() {\r\n   125\t        let q = quote_bridge_verifier_fee(100u64, 0u64);\r\n-- clearing pipeline --\r\n"]
[614.102009, "o", "sed: -e expression #1, char 7: extra characters after command"]
