[614.502757, "o", "     1"]
[614.503138, "o", "\t"]
[614.50344, "o", "//! `Plonky3` BabyBear (`P = 2_013_265_921 = 2^31 - 2^27 + 1`) 64-bit Montgomery\r\n     2\t//! reduction and STARK prover transcript commitment levy calculator.\r\n     3\t//!\r\n     4\t//! For radix `R = 2^32 = 4_294_967_296` and prime `P = 2_013_265_921`:"]
[614.503658, "o", "\r\n     5\t//! - `R^{-1} mod P = 943_718_400`\r\n     6\t//! - `MU = -P^{-1} mod R = 2_281_701_377`\r\n     7\t//! Given a 64-bit packed transcript state `x < P * R`:\r\n"]
[614.50394, "o", "     8\t//! 1. `t = ((x mod R) * MU) mod R`\r\n     9\t//! 2. `u = t * P` (so `x - u` is an exact multiple of `R = 2^32` in `(-P * R, P * R)`)\r\n    10\t//! 3. If `x < u`, `(x - u) / R + P` is computed in `u64` via\r\n    11\t"]
[614.504209, "o", "//!    `P + (x.wrapping_sub(u) / R) - R`; otherwise `(x - u) / R`.\r\n    12\t//! The result equals `(x * R^{-1}) mod P` in `[0, P - 1]`.\r\n    13\t\r\n    14\tuse crate::constants::*;\r\n    15\t\r\n    16"]
[614.50446, "o", "\t/// Captures the packed 64-bit transcript state, Montgomery quotient limb `t`,\r\n    17\t/// and canonical BabyBear field element `prover_levy in [0, BABYBEAR_P - 1]`.\r\n    18\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    19\tpub struct ProverLevyQuote {\r\n    20"]
[614.504623, "o", "\t    pub packed_transcript: u64,\r\n    21\t    pub monty_t: u64,\r\n    22\t"]
[614.504787, "o", "    pub prover_levy: u64,\r\n    23\t}\r\n    24\t\r\n    25\t/// Packs the low 32-bit limb of `amount` (`amount mod 2^32`) and the canonical\r\n    26\t/// BabyBear residue of `fee` (`fee mod P`) into a 64-bit transcript integer\r\n    27\t/// `x = (amount % 2^32) + (fee % P) * 2^32 < P * 2^32`.\r\n    28"]
[614.506056, "o", "\t#[inline]\r\n    29\tpub fn pack_transcript(amount: u64, fee: u64) -> u64 {\r\n    30\t    (amount % LIMB_BASE) + (fee % BABYBEAR_P) * LIMB_BASE\r\n    31\t}"]
[614.506262, "o", "\r\n    32\t\r\n    33\t/// Computes the 32-bit Montgomery reduction multiplier `t = ((x mod 2^32) * MU) mod 2^32`.\r\n    34"]
[614.50651, "o", "\t#[inline]\r\n    35\tpub fn monty_quotient(x: u64) -> u64 {\r\n    36\t    ((x % LIMB_BASE) * BABYBEAR_MU) % LIMB_BASE\r\n    37\t}\r\n    38\t\r\n    39\t/// Performs 64-bit BabyBear Montgomery reduction on `x < BABYBEAR_P * 2^32`,\r\n    40\t/// returning `(x * 943_718_400) mod 2_013_265_921` in pure `u64` arithmetic.\r\n    41"]
[614.506839, "o", "\t#[inline]\r\n    42\tpub fn monty_reduce(x: u64) -> u64 {\r\n    43\t    let t: u64 = monty_quotient(x);\r\n    44\t    let u: u64 = BABYBEAR_P * t;\r\n    45\t    let diff: u64 = x.wrapping_sub(u);\r\n    46\t    let hi: u64 = diff / LIMB_BASE;\r\n    47\t    if x < u {"]
[614.506963, "o", "\r\n    48\t        BABYBEAR_P + hi - LIMB_BASE\r\n    49\t    } else {\r\n    50\t        hi\r\n    51"]
[614.507287, "o", "\t    }\r\n    52\t}\r\n    53\t\r\n    54\t/// Performs Montgomery multiplication `(a * b * R^{-1}) mod BABYBEAR_P`\r\n    55"]
[614.507553, "o", "\t/// for two BabyBear field elements `a, b < BABYBEAR_P`.\r\n    56\t#[inline]\r\n    57\tpub fn monty_mul_babybear(a: u64, b: u64) -> u64 {"]
[614.507654, "o", "\r\n    58\t    let prod: u64 = (a % BABYBEAR_P) * (b % BABYBEAR_P);\r\n    59\t    monty_reduce(prod)\r\n    60\t}\r\n    61\t\r\n    62\t/// Canonical modular addition `(a + b) mod BABYBEAR_P` for `a, b < BABYBEAR_P`.\r\n    63\t#[inline]\r\n    64\tpub fn canonical_add_babybear(a: u64, b: u64) -> u64 {\r\n    65\t    let sum: u64 = a + b;"]
[614.507957, "o", "\r\n    66\t    if sum >= BABYBEAR_P {\r\n"]
[614.508036, "o", "    67\t        sum - BABYBEAR_P"]
[614.508339, "o", "\r\n    68"]
[614.508522, "o", "\t    } else {\r\n    69\t        sum\r\n    70\t    }\r\n    71\t}\r\n    72\t\r\n    73"]
[614.508834, "o", "\t/// Canonical modular subtraction `(a - b) mod BABYBEAR_P` for `a, b < BABYBEAR_P`.\r\n    74\t#[inline]\r\n    75\tpub fn canonical_sub_babybear(a: u64, b: u64) -> u64 {\r\n    76\t    if a >= b {"]
[614.508996, "o", "\r\n    77\t        a - b\r\n    78\t    } else {\r\n    79\t        (a + BABYBEAR_P) - b\r\n    80"]
[614.509194, "o", "\t    }\r\n    81\t}\r\n    82\t\r\n    83\t/// Quotes the STARK prover transcript commitment levy for `(amount, fee)`:\r\n    84\t/// `prover_levy = monty_reduce(pack_transcript(amount, fee))`."]
[614.510035, "o", "\r\n    85\t#[inline]\r\n    86\tpub fn quote_prover_transcript_levy(amount: u64, fee: u64) -> ProverLevyQuote {\r\n    87\t    let packed_transcript: u64 = pack_transcript(amount, fee);\r\n    88\t    let monty_t: u64 = monty_quotient(packed_transcript);\r\n    89\t    let prover_levy: u64 = monty_reduce(packed_transcript);\r\n    90\t    ProverLevyQuote {\r\n    91\t        packed_transcript,\r\n    92"]
[614.510081, "o", "\t        monty_t,\r\n    93\t        prover_levy,\r\n    94\t    }\r\n    95\t}\r\n    96\t\r\n    97"]
[614.510147, "o", "\t#[cfg(test)]\r\n    98\t"]
[614.510189, "o", "mod tests {\r\n    99"]
[614.510321, "o", "\t    use super::*;\r\n"]
[614.510377, "o", "   100\t\r\n   101"]
[614.5105, "o", "\t    #[test]\r\n   102"]
[614.510534, "o", "\t    fn monty_reduce_zero_and_multiples_of_p() {\r\n"]
[614.51065, "o", "   103\t        assert_eq!(monty_reduce(0u64), 0u64);\r\n   104\t        assert_eq!(monty_reduce(BABYBEAR_P), 0u64);\r\n   105\t        assert_eq!(monty_reduce(BABYBEAR_P * 42u64), 0u64);"]
[614.510682, "o", "\r\n   106"]
[614.510721, "o", "\t    }\r\n   107\t\r\n   108\t    #[test]"]
[614.510969, "o", "\r\n   109\t    fn monty_reduce_radix_r_gives_one() {\r\n   110\t        assert_eq!(monty_reduce(LIMB_BASE), 1u64);\r\n   111\t        let q = quote_prover_transcript_levy(0u64, 1u64);\r\n   112\t        assert_eq!(q.prover_levy, 1u64);\r\n   113\t    }\r\n   114\t\r\n   115\t    #[test]\r\n   116\t    fn monty_reduce_underflow_branch_and_non_underflow_branch() {\r\n"]
[614.511066, "o", "   117\t        let q_under = quote_prover_transcript_levy(1u64, 0u64);\r\n   118"]
[614.511109, "o", "\t        assert_eq!(q_under.prover_levy, 943_718_400u64);\r\n   119\t\r\n   120\t        assert_eq!(monty_reduce(BABYBEAR_P), 0u64);\r\n"]
[614.511765, "o", "\u001b[?2004h"]
