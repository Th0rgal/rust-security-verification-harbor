[589.290725, "i", "cd /workspace/challenge && cat > /tmp/check.rs <<'RS'\nuse settlement_gate::authorize;\nfn main() {\n    let balance: u64 = 0;\n    let amount: u64 = 0;\n    let fee: u64 = 0;\n    println!(\"{:?}\", authorize(balance, amount, fee));\n}\nRS\nrustc --edition=2021 /tmp/check.rs -L target/release/deps --extern settlement_gate=target/release/libsettlement_gate.rlib -o /tmp/check\n/tmp/check\n"]
[589.291239, "o", "cd /workspace/challenge && cat > /tmp/check.rs <<'RS'\r\n"]
[589.291282, "o", "\u001b[?2004l\r\u001b[?2004h"]
[589.29147, "o", "> "]
