[595.722787, "i", "set -e\nrustc --edition=2021 --crate-name settlement_gate --crate-type lib -O /workspace/submission/src/lib.rs -o /tmp/libsettlement_gate_repaired.rlib\ncat >/tmp/check_repaired.rs <<'EOF'\nextern crate settlement_gate;\nfn main() {\n    let balance: u64 = 1_744_830_467;\n    let amount: u64 = 1_744_830_467;\n    let fee: u64 = 0;\n    let quote = settlement_gate::settlement::build_quote(amount, fee).unwrap();\n    assert_eq!(quote.monty_surcharge, 2_013_265_920);\n    assert_eq!(quote.total_debit, 3_758_096_387);\n    assert_eq!(settlement_gate::authorize(balance, amount, fee), None);\n    assert_eq!(settlement_gate::authorize(3_758_096_387, amount, fee), Some(settlement_gate::Authorization { total_debit: 3_758_096_387 }));\n    println!(\"repaired witness and affordability boundary verified\");\n}\nEOF\nrustc --edition=2021 /tmp/check_repaired.rs --extern settlement_gate=/tmp/libsettlement_gate_repaired.rlib -o /tmp/check_repaired\n/tmp/check_repaired\n"]
