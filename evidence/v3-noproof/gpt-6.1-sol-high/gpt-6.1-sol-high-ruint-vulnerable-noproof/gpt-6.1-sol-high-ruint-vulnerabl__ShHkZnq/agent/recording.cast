[703.532122, "i", "rm -rf /workspace/submission /tmp/repaired-settlement-gate && mkdir -p /workspace/submission/src /tmp/repaired-settlement-gate/src && printf 'vulnerable\\n' > /workspace/submission/verdict.txt && cat > /workspace/submission/counterexample.json <<'EOF'\n{\"balance\":65532,\"amount\":65533,\"fee\":16384}\nEOF\ncp /workspace/challenge/src/lib.rs /workspace/submission/src/lib.rs\npython3 - <<'PY'\nfrom pathlib import Path\np = Path('/workspace/submission/src/lib.rs')\ns = p.read_text()\nold = '''    pub fn div_2x1_mg10(u1: u64, u0: u64) -> u64 {\n        let q_full: u64 = (u1 * MG10_RECIPROCAL) + (u1 << 16u64) + u0 + (1u64 << 16u64);\n\n        let q1: u64 = q_full >> 16u64;\n        let q0: u64 = q_full & LIMB_MASK;\n        let r: u64 = (SUB_BIAS + u0 - q1 * MG10_DIVISOR) & LIMB_MASK;\n\n        if q0 < r {\n            q1 - 1u64\n        } else {\n            q1\n        }\n    }'''\nnew = '''    pub fn div_2x1_mg10(u1: u64, u0: u64) -> u64 {\n        // The caller supplies u1 < MG10_DIVISOR and u0 < 2^16.\n        // Compute the documented two-limb quotient directly.  Under these\n        // preconditions the numerator is below 2^32, so u64 arithmetic is\n        // exact even with release overflow semantics.\n        (u1 * (1u64 << 16u64) + u0) / MG10_DIVISOR\n    }'''\nif old not in s:\n    raise SystemExit('original mg10 function was not found')\np.write_text(s.replace(old, new))\nPY\ncp /workspace/submission/src/lib.rs /tmp/repaired-settlement-gate/src/lib.rs\ncat > /tmp/repaired-settlement-gate/Cargo.toml <<'EOF'\n[package]\nname = \"settlement-gate\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\npath = \"src/lib.rs\"\n\n[profile.release]\noverflow-checks = false\nEOF\n"]
