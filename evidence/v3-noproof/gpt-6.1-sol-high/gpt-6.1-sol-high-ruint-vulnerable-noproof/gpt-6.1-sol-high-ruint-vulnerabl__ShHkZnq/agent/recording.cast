[767.926301, "o", "    /// `V = floor((2^32 - 1) / D) - 2^16 = 0xFFF4 = 65524`.\r\n    /// Given `u1 < D` and `u0 < 2^16`, returns `floor((u1 * 2^16 + u0) / D)`.\r\n    #[inline]"]
[767.926715, "o", "\r\n    pub fn div_2x1_mg10(u1: u64, u0: u64) -> u64 {\r\n        // The caller supplies u1 < MG10_DIVISOR and u0 < 2^16.\r\n        // Compute the documented two-limb quotient directly.  Under these\r\n        // preconditions the numerator is below 2^32, so u64 arithmetic is\r\n        // exact even with release overflow semantics.\r\n        (u1 * (1u64 << 16u64) + u0) / MG10_DIVISOR\r\n    }\r\n}\r\n\r\npub mod settlement {\r\n    use crate::Authorization;\r\n    use crate::mg10;\r\n\r\n    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    pub struct RuintQuote {\r\n"]
[767.926801, "o", "\u001b[?2004hroot@cff11af79506:/workspace/challenge# "]
