[705.691495, "i", "cat > /tmp/repaired-settlement-gate/tests_policy.rs <<'EOF'\nextern crate settlement_gate;\nuse settlement_gate::{authorize, mg10};\n\nfn main() {\n    assert_eq!(mg10::div_2x1_mg10(16384, 65533), 32767);\n    assert_eq!(authorize(65532, 65533, 16384), None);\n    assert_eq!(authorize(65533, 65533, 16384).unwrap().total_debit, 65533);\n\n    let values = [0u64, 1, 2, 32770, 32771, 65535, 65536, u64::MAX - 1, u64::MAX];\n    for &balance in &values {\n        for &amount in &values {\n            for &fee in &values {\n                let u1 = fee % 32771;\n                let u0 = amount & 65535;\n                let quotient = (u1 * 65536 + u0) / 32771;\n                let debit = (amount >> 1) + quotient;\n                let expected = if debit <= balance { Some(debit) } else { None };\n                assert_eq!(authorize(balance, amount, fee).map(|a| a.total_debit), expected,\n                    \"balance={balance} amount={amount} fee={fee}\");\n            }\n        }\n    }\n    println!(\"repaired witness and boundary checks passed\");\n}\nEOF\ncd /tmp/repaired-settlement-gate && rustc --edition=2021 -O tests_policy.rs --extern settlement_gate=target/release/libsettlement_gate.rlib -o /tmp/repaired-policy-check && /tmp/repaired-policy-check\n"]
