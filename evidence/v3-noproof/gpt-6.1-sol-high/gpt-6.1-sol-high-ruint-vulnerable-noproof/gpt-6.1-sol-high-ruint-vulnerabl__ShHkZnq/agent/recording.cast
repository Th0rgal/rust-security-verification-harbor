[520.980181, "i", "cat > /tmp/check.c <<'EOF'\n#include <stdint.h>\n#include <stdio.h>\n#include <inttypes.h>\n\nint main(void) {\n    const uint64_t D = 0x8003ULL, V = 0xFFF4ULL, B = 0x10000ULL;\n    uint64_t count = 0;\n    for (uint64_t u1 = 0; u1 < D; ++u1) {\n        for (uint64_t u0 = 0; u0 < B; ++u0) {\n            uint64_t qfull = u1 * V + (u1 << 16) + u0 + (1ULL << 16);\n            uint64_t q1 = qfull >> 16;\n            uint64_t q0 = qfull & 0xffffULL;\n            uint64_t r = (0xc0000000ULL + u0 - q1 * D) & 0xffffULL;\n            uint64_t got = q0 < r ? q1 - 1 : q1;\n            uint64_t want = (u1 * B + u0) / D;\n            if (got != want) {\n                printf(\"mismatch u1=%\" PRIu64 \" u0=%\" PRIu64 \" got=%\" PRIu64 \" want=%\" PRIu64 \" qfull=%\" PRIu64 \" q1=%\" PRIu64 \" q0=%\" PRIu64 \" r=%\" PRIu64 \"\\n\", u1, u0, got, want, qfull, q1, q0, r);\n                return 1;\n            }\n            ++count;\n        }\n    }\n    printf(\"all %\" PRIu64 \" pairs matched\\n\", count);\n    return 0;\n}\nEOF\ngcc -O3 -std=c11 /tmp/check.c -o /tmp/check && /tmp/check\n"]
[520.982141, "o", "cat > /tmp/check.c <<'EOF'\r\n"]
