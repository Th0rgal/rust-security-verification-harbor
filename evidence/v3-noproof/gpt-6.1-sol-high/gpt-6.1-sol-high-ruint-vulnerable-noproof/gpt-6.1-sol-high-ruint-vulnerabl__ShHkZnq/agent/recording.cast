[530.990068, "i", "cd /workspace/challenge && cat > /tmp/boundary.rs <<'EOF'\nuse settlement_gate::authorize;\nfn main() {\n    let vals = [0u64, 1, 2, 32770, 32771, 65535, 65536, u64::MAX - 1, u64::MAX];\n    for &b in &vals { for &a in &vals { for &f in &vals {\n        let x = authorize(b, a, f);\n        let u1 = f % 32771;\n        let u0 = a & 65535;\n        let q = (u1 * 65536 + u0) / 32771;\n        let debit = (a >> 1) + q;\n        let expected = if debit <= b { Some(debit) } else { None };\n        if x.map(|z| z.total_debit) != expected {\n            println!(\"mismatch balance={} amount={} fee={} got={:?} expected={:?}\", b, a, f, x.map(|z| z.total_debit), expected);\n            std::process::exit(1);\n        }\n    }}}\n    println!(\"boundary checks passed\");\n}\nEOF\nrustc --edition=2021 -O /tmp/boundary.rs --extern settlement_gate=target/release/libsettlement_gate.rlib -o /tmp/boundary && /tmp/boundary\n"]
