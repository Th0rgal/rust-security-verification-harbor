    /// Given `u1 < D` and `u0 < 2^16`, returns `floor((u1 * 2^16 + u0) / D)`.
    #[inline]
    pub fn div_2x1_mg10(u1: u64, u0: u64) -> u64 {
        // The caller supplies u1 < MG10_DIVISOR and u0 < 2^16.
        // Compute the documented two-limb quotient directly.  Under these
        // preconditions the numerator is below 2^32, so u64 arithmetic is
        // exact even with release overflow semantics.
        (u1 * (1u64 << 16u64) + u0) / MG10_DIVISOR
    }
}

