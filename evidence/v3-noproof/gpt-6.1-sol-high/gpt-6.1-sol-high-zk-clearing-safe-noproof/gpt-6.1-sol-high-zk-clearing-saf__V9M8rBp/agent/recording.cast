[1452.685839, "o", "    }\r\n}\r\n\r\n/// Computes the ceiling quotient `ceil((lhs + rhs) / BPS_DENOM)` (`BPS_DENOM = 10_000`),\r\n/// equivalent in exact integer arithmetic to `floor((lhs + rhs + 9_999) / 10_000)`,\r\n"]
[1452.686032, "o", "/// over the full 65-bit `WordSum` range using pure `u64` arithmetic.\r\n#[inline]\r\npub fn ceil_div_bps_u64(sum: WordSum) -> u64 {\r\n    if sum.high_carry {\r\n        let folded_rem: u64 = (sum.low_word % BPS_DENOM) + U64_MOD_BPS_REM;\r\n        U64_MOD_BPS_QUOT + (sum.low_word / BPS_DENOM) + ((folded_rem + BPS_MAX_REM) / BPS_DENOM)\r\n    } else {\r\n        let biased: u64 = sum.low_word.wrapping_add(BPS_MAX_REM);\r\n        if biased < sum.low_word {\r\n            (sum.low_word / BPS_DENOM) + (((sum.low_word % BPS_DENOM) + BPS_MAX_REM) / BPS_DENOM)\r\n        } else {\r\n"]
[1452.686071, "o", "            biased / BPS_DENOM\r\n        }\r\n    }\r\n"]
[1452.686102, "o", "}\r\n\r\n/// Computes the exact floor quotient `floor((lhs + rhs) / FLASH_DENOM)` (`FLASH_DENOM = 5_000`)\r\n"]
[1452.68613, "o", "/// over the full 65-bit `WordSum` range in pure `u64` arithmetic.\r\n#[inline]\r\npub fn floor_div_flash_u64(sum: WordSum) -> u64 {"]
[1452.686155, "o", "\r\n    if sum.high_carry {\r\n        let folded_rem: u64 = (sum.low_word % FLASH_DENOM) + U64_MOD_FLASH_REM;"]
[1452.686195, "o", "\r\n        U64_MOD_FLASH_QUOT + (sum.low_word / FLASH_DENOM) + (folded_rem / FLASH_DENOM)\r\n    } else {\r\n"]
[1452.686225, "o", "        sum.low_word / FLASH_DENOM\r\n    }"]
[1452.686259, "o", "\r\n}\r\n\r\n"]
[1452.687099, "o", "/// Computes the exact ceiling quotient `ceil((lhs + rhs) / FLASH_DENOM)` (`FLASH_DENOM = 5_000`),\r\n/// equivalent to `floor((lhs + rhs + 4_999) / 5_000)`, in pure `u64` arithmetic.\r\n#[inline]\r\npub fn ceil_div_flash_u64(sum: WordSum) -> u64 {\r\n    if sum.high_carry {\r\n        let folded_rem: u64 = (sum.low_word % FLASH_DENOM) + U64_MOD_FLASH_REM;\r\n        U64_MOD_FLASH_QUOT + (sum.low_word / FLASH_DENOM) + ((folded_rem + FLASH_MAX_REM) / FLASH_DENOM)\r\n    } else {\r\n        let biased: u64 = sum.low_word.wrapping_add(FLASH_MAX_REM);\r\n        if biased < sum.low_word {\r\n            (sum.low_word / FLASH_DENOM) + (((sum.low_word % FLASH_DENOM) + FLASH_MAX_REM) / FLASH_DENOM)\r\n        } else {\r\n            biased / FLASH_DENOM\r\n        }\r\n"]
[1452.688525, "o", "//! Protocol-wide arithmetic constants, prime field moduli, reciprocal multipliers,\r\n//! broadword SWAR bitmasks, and 64-bit word carry-folding parameters for the\r\n//! rollup batch settlement and clearing engine."]
[1452.688761, "o", "\r\n//!\r\n//! All arithmetic throughout the clearing crate executes natively on 64-bit machine\r\n//! words (`u64`) without `u128` promotion so that settlement verification matches\r\n//! single-word VM register semantics.\r\n\r\n/// Standard protocol fee basis-point denominator (`100% = 10_000 bps`).\r\npub const BPS_DENOM: u64 = 10_000u64;\r\n\r\n/// Maximum non-zero remainder modulo `BPS_DENOM` (`BPS_DENOM - 1`).\r\npub const BPS_MAX_REM: u64 = 9_999u64;\r\n\r\n/// Exact floor quotient of `2^64` divided by `BPS_DENOM`:\r\n/// `floor(18_446_744_073_709_551_616 / 10_000) = 1_844_674_407_370_955`.\r\npub const U64_MOD_BPS_QUOT: u64 = 1_844_674_407_370_955u64;\r\n\r\n/// Exact positive remainder of `2^64` modulo `BPS_DENOM`:\r\n/// `18_446_744_073_709_551_616 % 10_000 = 1_616`.\r\npub const U64_MOD_BPS_REM: u64 = 1_616u64;\r\n\r\n/// Protocol tier rebate divisor (`10` corresponds to a 10% floor rebate on gross fee).\r\npub const REBATE_DIVISOR: u64 = 10u64;\r\n\r\n/// Passive maker rebate cap divisor (`5` corresponds to a 20% cap on passive limit orders).\r\npub const MAKER_REBATE_CAP_DIVISOR: u64 = 5u64;\r\n"]
[1452.690362, "o", "        }\r\n    }\r\n"]
[1452.690444, "o", "\r\n    #[test]\r\n    fn mg10_second_correction_branch_is_exact() {\r\n        let q_a = quote_blob_gas_slots(65_535u64, 16_384u64);\r\n        assert!(verify_blob_slot_euclidean(q_a));\r\n        assert_eq!(q_a.slot_quotient, 32_767u64);\r\n        assert_eq!(ceil_blob_slots(q_a), 32_768u64);\r\n\r\n        let q_b = quote_blob_gas_slots(65_534u64, 21_845u64);\r\n        assert!(verify_blob_slot_euclidean(q_b));\r\n        assert_eq!(q_b.slot_quotient, 43_688u64);\r\n    }\r\n\r\n    #[test]\r\n    fn blob_gas_unit_telemetry() {\r\n        let q = quote_blob_gas_slots(32_771u64, 0u64);\r\n        assert_eq!(q.slot_quotient, 1u64);\r\n        assert_eq!(q.slot_remainder, 0u64);\r\n        assert_eq!(ceil_blob_slots(q), 1u64);\r\n        assert_eq!(estimate_blob_gas_units(q), BLOB_GAS_PER_SLOT);\r\n    }\r\n\r\n    #[test]\r\n    fn mg10_maximum_two_limb_dividend() {\r\n        let q_max = quote_blob_gas_slots(65_535u64, 32_770u64);\r\n        assert!(verify_blob_slot_euclidean(q_max));\r\n        assert_eq!(q_max.slot_quotient, 65_535u64);\r\n        assert_eq!(q_max.slot_remainder, 32_770u64);\r\n    }\r\n}\r\n"]
[1452.692368, "o", "target/release/libsettlement_gate.rlib\r\n"]
[1452.692673, "o", "\u001b[?2004h"]
[1452.692902, "o", "root@bda1b360e7a1:/workspace/challenge# "]
[1659.626064, "i", "cat >/tmp/check.rs <<'RS'\nextern crate settlement_gate;\nuse settlement_gate::*;\nuse settlement_gate::constants::*;\nuse settlement_gate::word_math::*;\nuse settlement_gate::reciprocal_div::*;\nuse settlement_gate::goldilocks_field::*;\nuse settlement_gate::montgomery_field::*;\n\nfn rng(x: &mut u64) -> u64 { *x = x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407); *x }\nfn ceil(x:u128,d:u128)->u128 {(x+d-1)/d}\nfn expected(a:u64,f:u64)->Option<u64>{\n    let s=a as u128+f as u128;\n    let gross=ceil(s,10000); let net=gross-gross/10;\n    let flash=ceil(s,5000); let flash=flash-flash/4;\n    let blob=((f as u128%32771)*65536+(a as u128&65535))/32771;\n    let mut cal=0u128; let mut nz=0u128;\n    for i in 0..8 { let b=((f as u128>>(8*i))&255); cal+=b; if b!=0 {nz+=1;} }\n    cal += nz*256;\n    let x=(a as u128%(1u128<<32))+(f as u128%(BABYBEAR_P as u128))*(1u128<<32);\n    let prover=(x*943718400u128)%(BABYBEAR_P as u128);\n    let domain=if f&255==0 {90} else {f&255};\n    let bridge=((a as u128)+(f as u128)*(1u128<<64))%(GOLDILOCKS_P as u128);\n    let surcharge=net+flash+blob+cal+prover+domain+bridge;\n    let total=a as u128+surcharge;\n    if total>u64::MAX as u128 {None} else {Some(total as u64)}\n}\nfn main(){\n    for a in [0,1,2,9999,10000,10001,u64::MAX-1,u64::MAX] { for f in [0,1,255,256,32770,32771,BABYBEAR_P,GOLDILOCKS_P,u64::MAX-1,u64::MAX] {\n        let w=add_u64_with_carry(a,f); let n=a as u128+f as u128;\n        assert_eq!(floor_div_bps_u64(w) as u128,n/10000); assert_eq!(ceil_div_bps_u64(w) as u128,ceil(n,10000));\n        assert_eq!(floor_div_flash_u64(w) as u128,n/5000); assert_eq!(ceil_div_flash_u64(w) as u128,ceil(n,5000));\n        assert_eq!(reduce_goldilocks_128(a,f),((a as u128)+(f as u128)*(1u128<<64))%(GOLDILOCKS_P as u128) as u64);\n        let x=(a%(1u64<<32))+(f%BABYBEAR_P)*(1u64<<32);\n        assert_eq!(monty_reduce(x),((x as u128)*943718400u128%(BABYBEAR_P as u128)) as u64);\n        assert_eq!(authorize(a,a,f).map(|z|z.total_debit),expected(a,f).filter(|t|*t<=a));\n    }}\n    let mut seed=7u64;\n    for i in 0..5_000_000u64 { let a=rng(&mut seed); let f=rng(&mut seed);\n        let w=add_u64_with_carry(a,f); let n=a as u128+f as u128;\n        if floor_div_bps_u64(w) as u128 != n/10000 || ceil_div_bps_u64(w) as u128 != ceil(n,10000) || floor_div_flash_u64(w) as u128 != n/5000 || ceil_div_flash_u64(w) as u128 != ceil(n,5000) { panic!(\"quotient mismatch {} {}\",a,f); }\n        if reduce_goldilocks_128(a,f) != (((a as u128)+(f as u128)*(1u128<<64))%(GOLDILOCKS_P as u128)) as u64 { panic!(\"gold mismatch {} {}\",a,f); }\n        let x=(a%(1u64<<32))+(f%BABYBEAR_P)*(1u64<<32);\n        if monty_reduce(x)!=((x as u128)*943718400u128%(BABYBEAR_P as u128)) as u64 { panic!(\"monty mismatch {} {}\",a,f); }\n        let bq=quote_blob_gas_slots(a,f); let div=((f as u128%32771)*65536+(a as u128&65535))/32771;\n        if bq.slot_quotient != div as u64 { panic!(\"blob mismatch {} {}\",a,f); }\n        let want=expected(a,f); let got=quote_clearing_ticket(a,f).map(|t|t.total_debit);\n        if got!=want { panic!(\"ticket mismatch {} {} got {:?} want {:?}\",a,f,got,want); }\n        let bal=rng(&mut seed); let wantauth=want.filter(|t|*t<=bal); let gotauth=authorize(bal,a,f).map(|z|z.total_debit);\n        if gotauth!=wantauth { panic!(\"auth mismatch {} {} {} got {:?} want {:?}\",bal,a,f,gotauth,wანტauth); }\n        if i%1_000_000==0 {println!(\"checked {}\",i);}\n    }\n    for u1 in 0..32771u64 { for u0 in 0..65536u64 { let got=div_2x1_mg10(u1,u0); let want=((u1 as u128)*65536+u0 as u128)/32771; if got!=want as u64 {panic!(\"reciprocal mismatch {} {}\",u1,u0);} } }\n    println!(\"all differential checks passed\");\n}\nRS\nsed -i 's/wანტauth/wantauth/' /tmp/check.rs\nrustc -O --edition=2021 /tmp/check.rs --extern settlement_gate=/workspace/challenge/target/release/libsettlement_gate.rlib -o /tmp/check\n/tmp/check\n"]
