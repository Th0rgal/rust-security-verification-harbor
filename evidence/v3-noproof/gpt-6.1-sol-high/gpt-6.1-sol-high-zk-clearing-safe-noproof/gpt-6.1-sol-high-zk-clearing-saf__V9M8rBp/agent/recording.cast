[397.430283, "o", "\r\n  133 /workspace/challenge/src/montgomery_field.rs\r\n  156 /workspace/challenge/src/reciprocal_div.rs"]
[397.430584, "o", "\r\n   79 /workspace/challenge/src/transcript_codec.rs\r\n  228 /workspace/challenge/src/word_math.rs"]
