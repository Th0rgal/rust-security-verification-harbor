[1416.259449, "i", "cat > /tmp/audit.py <<'PY'\nimport random\nM=(1<<64)-1\nPBB=2013265921\nR=1<<32\nPG=(1<<64)-(1<<32)+1\nEPS=(1<<32)-1\nD=32771\nMU=65524\n\ndef swar(x):\n    nz=(((x|0x8080808080808080)-0x0101010101010101)&M|x)&0x8080808080808080\n    count=((nz>>7)*0x0101010101010101>>56)&M\n    s=0\n    for i in range(8): s+=(x>>(8*i))&255\n    got=(count<<8)+s\n    return count,s,got\n\ndef rec(u1,u0):\n    qfull=u1*MU+(u1<<16)+u0+(1<<16)\n    q1=qfull>>16; q0=qfull&65535\n    r=((0xC0000000+u0-q1*D)&M)&65535\n    if q0<r: qc=q1-1; rc=(r+D)&65535\n    else: qc=q1; rc=r\n    return qc+1 if rc>=D else qc\n\ndef qrec(u1,u0): return (u1*(1<<16)+u0)//D\n\ndef bps(n,d=10000): return (n+d-1)//d\n\ndef carry_div(a,b,d,ceil): return ((a+b+d-1)//d if ceil else (a+b)//d)\n\ndef monty(x): return (x*pow(R,-1,PBB))%PBB\n\ndef gold(lo,hi):\n    h=hi>>32; l=hi&EPS\n    t0=(lo-h)&M\n    t1=(t0+PG)&M if lo<h else t0\n    z=t1+l*EPS\n    t2=z&M\n    t3=(t2+EPS)&M if z>M else t2\n    return (t3-PG)&M if t3>=PG else t3\n\nvals=[0,1,2,3,4,9,10,99,100,255,256,9999,10000,10001,65535,65536,32770,32771,32772,1<<31,1<<32,(1<<32)-1,(1<<32)+1,PBB-1,PBB,PG-1,PG,PG+1,M-1,M]\nfor a in vals:\n  for b in vals:\n    assert carry_div(a,b,10000,False)==(a+b)//10000\n    assert carry_div(a,b,10000,True)==(a+b+9999)//10000\n    assert carry_div(a,b,5000,False)==(a+b)//5000\n    assert carry_div(a,b,5000,True)==(a+b+4999)//5000\n    assert gold(a,b)==(a+b*(1<<64))%PG\nfor u1 in list(range(D))+[D-1]:\n  for u0 in range(65536):\n    if rec(u1,u0)!=qrec(u1,u0): print('REC MISMATCH',u1,u0,rec(u1,u0),qrec(u1,u0)); raise SystemExit\nprint('reciprocal exhaustive passed')\nfor i in range(3000000):\n  a=random.getrandbits(64); b=random.getrandbits(64)\n  c,s,g=swar(b)\n  assert (c,s,g)==(sum(((b>>(8*j))&255)!=0 for j in range(8)),sum((b>>(8*j))&255 for j in range(8)),sum((b>>(8*j))&255 for j in range(8))+256*sum(((b>>(8*j))&255)!=0 for j in range(8)))\n  assert gold(a,b)==(a+b*(1<<64))%PG\n  assert monty((a&(R-1))+(b%PBB)*R)==(((a&(R-1))+(b%PBB)*R)*pow(R,-1,PBB))%PBB\n  u1=b%D; u0=a&65535\n  assert rec(u1,u0)==(u1*65536+u0)//D\nprint('random differential checks passed')\nPY\npython3 /tmp/audit.py\n"]
