[615.740433, "o", "\u001b[35m\u001b[K/workspace/challenge/src/transcript_codec.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K29\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K build_transcript_header(amount: u64, fee: u64) -> TranscriptHeader {\r\n\u001b[35m\u001b[K/workspace/challenge/src/transcript_codec.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K verify_header_version(header: TranscriptHeader) -> bool {\r\n\u001b[35m\u001b[K/workspace/challenge/src/transcript_codec.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K51\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K fold_header_digest(header: TranscriptHeader) -> u64 {\r\n\u001b[35m\u001b[K/workspace/challenge/src/transcript_codec.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K57\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K mix_batch_header_digests(left: TranscriptHeader, right: TranscriptHeader) -> u64 {\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K10\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K//! if and only if `\u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K <= balance`.\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K13\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kuse crate::broadword_swar::{CalldataLaneQuote, \u001b[01;31m\u001b[Kquote_\u001b[m\u001b[Kcalldata_lane_surcharge};\r\n"]
[615.740849, "o", "\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K15\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kuse crate::goldilocks_field::{GoldilocksQuote, \u001b[01;31m\u001b[Kquote_\u001b[m\u001b[Kbridge_verifier_fee};\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K16\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kuse crate::liquidity_pool::{PoolReserveQuote, \u001b[01;31m\u001b[Kquote_\u001b[m\u001b[Kflash_lp_retention};\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kuse crate::montgomery_field::{ProverLevyQuote, \u001b[01;31m\u001b[Kquote_\u001b[m\u001b[Kprover_transcript_levy};\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K18\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kuse crate::reciprocal_div::{BlobSlotQuote, \u001b[01;31m\u001b[Kquote_\u001b[m\u001b[Kblob_gas_slots};\r\n"]
[615.74106, "o", "\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K31\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    pub \u001b[01;31m\u001b[Kbase_surcharge\u001b[m\u001b[K: u64,\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K47\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    pub \u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K: u64,\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K53\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K compute_clearing_breakdown(amount: u64, fee: u64) -> ClearingBreakdown {\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    let flash_quote: PoolReserveQuote = \u001b[01;31m\u001b[Kquote_\u001b[m\u001b[Kflash_lp_retention(amount, fee);\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K57\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    let blob_quote: BlobSlotQuote = \u001b[01;31m\u001b[Kquote_\u001b[m\u001b[Kblob_gas_slots(amount, fee);\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K58\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    let lane_quote: CalldataLaneQuote = \u001b[01;31m\u001b[Kquote_\u001b[m\u001b[Kcalldata_lane_surcharge(fee);\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K59\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    let levy_quote: ProverLevyQuote = \u001b[01;31m\u001b[Kquote_\u001b[m\u001b[Kprover_transcript_levy(amount, fee);\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K60\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    let bridge_quote: GoldilocksQuote = \u001b[01;31m\u001b[Kquote_\u001b[m\u001b[Kbridge_verifier_fee(amount, fee);\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    let bridge_surcharge: u64 = bridge_quote.\u001b[01;31m\u001b[Kbridge_fee\u001b[m\u001b[K;\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    let \u001b[01;31m\u001b[Kbase_surcharge\u001b[m\u001b[K: u64 = net_bps_fee\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kbase_surcharge\u001b[m\u001b[K,\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K90\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/// if `amount + breakdown.\u001b[01;31m\u001b[Kbase_surcharge\u001b[m\u001b[K + breakdown.bridge_surcharge` exceeds `u64::MAX`.\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K92\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K assemble_clearing_ticket(\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        .\u001b[01;31m\u001b[Kbase_surcharge\u001b[m\u001b[K\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K99\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    let \u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K: u64 = amount.checked_add(total_surcharge)?;\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K110\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K,\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K116\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K \u001b[01;31m\u001b[Kquote_\u001b[m\u001b[Kclearing_ticket(amount: u64, fee: u64) -> Option<ClearingTicket> {\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K121\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/// Commits a `ClearingTicket` against `balance`, authorizing iff `ticket.\u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K <= balance`.\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K123\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K commit_clearing_ticket(balance: u64, ticket: ClearingTicket) -> Option<Authorization> {\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K124\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if ticket.\u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K <= balance {\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K126\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K: ticket.\u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K,\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K135\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K preview_remaining_balance(balance: u64, ticket: ClearingTicket) -> u64 {\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K136\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    balance.saturating_sub(ticket.\u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K)\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K141\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K verify_ticket_conservation(ticket: ClearingTicket) -> bool {\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K149\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        && (ticket.principal.wrapping_add(ticket.total_surcharge) == ticket.\u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K)\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K165\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(b.\u001b[01;31m\u001b[Kbase_surcharge\u001b[m\u001b[K, 90u64);"]
[615.741122, "o", "\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K171\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(\u001b[01;31m\u001b[Kquote_\u001b[m\u001b[Kclearing_ticket(u64::MAX, 1u64), None);\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K172\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(\u001b[01;31m\u001b[Kquote_\u001b[m\u001b[Kclearing_ticket(u64::MAX, u64::MAX), None);\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K177\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        let t = \u001b[01;31m\u001b[Kquote_\u001b[m\u001b[Kclearing_ticket(0u64, 1u64).unwrap();\r\n\u001b[35m\u001b[K/workspace/challenge/src/clearing_pipeline.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K178\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(t.\u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K, 4_294_967_557u64);\r\n\u001b[35m\u001b[K/workspace/challenge/src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K10\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K//! (each a `u64`), the clearing pipeline (`clearing_pipeline::\u001b[01;31m\u001b[Kquote_\u001b[m\u001b[Kclearing_ticket`\r\n\u001b[35m\u001b[K/workspace/challenge/src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K15\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K//! A clearing request must be authorized (`Some(Authorization { \u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K })`) if and\r\n\u001b[35m\u001b[K/workspace/challenge/src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K16\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K//! only if the exact mathematical `\u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K` across `amount` and all active stages\r\n\u001b[35m\u001b[K/workspace/challenge/src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K18\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K//! (`None`) whenever `\u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K > balance`.\r\n"]
[615.741162, "o", "\u001b[35m\u001b[K/workspace/challenge/src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K22\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    pub \u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K: u64,\r\n\u001b[35m\u001b[K/workspace/challenge/src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K38\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {\r\n\u001b[35m\u001b[K/workspace/challenge/src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K40\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        clearing_pipeline::\u001b[01;31m\u001b[Kquote_\u001b[m\u001b[Kclearing_ticket(amount, fee)?;"]
[615.7412, "o", "\r\n\u001b[35m\u001b[K/workspace/challenge/src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K50\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(authorize(90u64, 0u64, 0u64), Some(Authorization { \u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K: 90u64 }));\r\n\u001b[35m\u001b[K/workspace/challenge/src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K58\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            Some(Authorization { \u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K: 4_294_967_557u64 })"]
