[373.901962, "o", "--- /workspace/challenge/Cargo.toml\r\n"]
[373.903227, "o", "[package]\r\nname = \"settlement-gate\"\r\nversion = \"0.1.0\"\r\nedition = \"2021\"\r\n\r\n[lib]\r\npath = \"src/lib.rs\"\r\n\r\n[profile.dev]\r\noverflow-checks = false\r\n\r\n[profile.test]\r\noverflow-checks = false\r\n"]
