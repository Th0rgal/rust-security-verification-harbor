[1725.998334, "i", "python3 - <<'PY'\np='/tmp/check.rs'\ns=open(p).read()\ns=s.replace('use settlement_gate::montgomery_field::*;','use settlement_gate::montgomery_field::*;\\nuse settlement_gate::clearing_pipeline::quote_clearing_ticket;')\ns=s.replace('let domain=if f&255==0 {90} else {f&255};','let domain=if f&255==0 {90u64} else {f&255};')\ns=s.replace('let surcharge=net+flash+blob+cal+prover+domain+bridge;','let surcharge=net+flash+blob+cal+prover+(domain as u128)+bridge;')\ns=s.replace('assert_eq!(reduce_goldilocks_128(a,f),((a as u128)+(f as u128)*(1u128<<64))%(GOLDILOCKS_P as u128) as u64);','assert_eq!(reduce_goldilocks_128(a,f),(((a as u128)+(f as u128)*(1u128<<64))%(GOLDILOCKS_P as u128)) as u64);')\ns=s.replace('for u1 in 0..32771u64 { for u0 in 0..65536u64 { let got=div_2x1_mg10(u1,u0); let want=((u1 as u128)*65536+u0 as u128)/32771; if got!=want as u64 {panic!(\"reciprocal mismatch {} {}\",u1,u0);} } }','for u1 in 0..32771u64 { for u0 in [0,1,2,3,7,31,255,256,999,32770,32771,32772,65534,65535] { let got=div_2x1_mg10(u1,u0); let want=((u1 as u128)*65536+u0 as u128)/32771; if got!=want as u64 {panic!(\"reciprocal mismatch {} {}\",u1,u0);} } }')\nopen(p,'w').write(s)\nPY\nrustc -O --edition=2021 /tmp/check.rs --extern settlement_gate=/workspace/challenge/target/release/libsettlement_gate.rlib -o /tmp/check\n/tmp/check\n"]
