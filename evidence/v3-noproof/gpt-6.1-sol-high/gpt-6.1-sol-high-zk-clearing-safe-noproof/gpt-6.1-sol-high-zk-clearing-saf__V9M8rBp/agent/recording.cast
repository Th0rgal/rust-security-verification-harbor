[458.718118, "i", "python3 - <<'PY'\np=2013265921;r=2**32;mu=2281701377\nprint('P*MU mod R:', p*mu%r, 'inverse:', pow(p,-1,r), 'R inverse:',pow(r,-1,p))\nfor a,f in [(1,0),(2,0),(42,0),(0,1),(2**64-1,p-1)]:\n x=a%r+(f%p)*r;t=(x%r)*mu%r;u=p*t;hi=((x-u)%2**64)//r\n actual=p+hi-r if x<u else hi\n print(a,f,'levy:',actual,'exact:',x*pow(r,-1,p)%p,'low diff:',(x-u)%r)\nPY\n"]
