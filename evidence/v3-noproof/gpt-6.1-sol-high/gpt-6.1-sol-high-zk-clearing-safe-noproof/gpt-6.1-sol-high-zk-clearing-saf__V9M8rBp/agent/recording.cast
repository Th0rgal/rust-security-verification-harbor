[764.2205, "i", "python3 - <<'PY'\nimport random\nMASK=(1<<64)-1\nP=(1<<64)-(1<<32)+1\nEPS=(1<<32)-1\n\ndef red(lo,hi):\n    hihi=hi>>32\n    xhilo=hi&EPS\n    t0=(lo-hihi)&MASK\n    borrow=lo<hihi\n    t1=(t0+P)&MASK if borrow else t0\n    prod=xhilo*EPS\n    t2=(t1+prod)&MASK\n    carry=(t1+prod)>MASK\n    t3=(t2+EPS)&MASK if carry else t2\n    return (t3-P)&MASK if t3>=P else t3\n\nvals=[0,1,2,3,EPS,1<<32,(1<<32)+1,P-1,P,P+1,MASK]\nfor lo in vals:\n  for hi in vals:\n    got=red(lo,hi); want=(lo+hi*(1<<64))%P\n    if got!=want: print('MISMATCH',lo,hi,got,want); raise SystemExit\nfor i in range(2000000):\n    lo=random.getrandbits(64); hi=random.getrandbits(64)\n    got=red(lo,hi); want=(lo+hi*(1<<64))%P\n    if got!=want:\n        print('MISMATCH',i,lo,hi,got,want); break\nelse: print('goldilocks random checks passed')\nPY\n"]
