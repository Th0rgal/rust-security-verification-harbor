[766.359633, "i", "python3 - <<'PY'\nimport random\nM=(1<<64)-1; P=(1<<64)-(1<<32)+1; EPS=(1<<32)-1\n\ndef red(lo,hi):\n t0=(lo-(hi>>32))&M; t1=(t0+P)&M if lo<(hi>>32) else t0\n z=t1+(hi&EPS)*EPS; t2=z&M; t3=(t2+EPS)&M if z>M else t2\n return (t3-P)&M if t3>=P else t3\n\ndef ceildiv(x,d): return (x+d-1)//d\n\ndef calc(a,f):\n s=a+f\n net=ceildiv(s,10000)-ceildiv(s,10000)//10\n flash=ceildiv(s,5000); flash-=flash//4\n blob=(((f%32771)*65536)+(a&65535))//32771\n cal=sum((f>>(8*i))&255 for i in range(8))+256*sum(1 for i in range(8) if ((f>>(8*i))&255)!=0)\n x=(a&((1<<32)-1))+(f%2013265921)*(1<<32)\n # monty residue\n prover=(x*943718400)%2013265921\n domain=f&255 or 90\n bridge=red(a,f)\n base=net+flash+blob+cal+prover+domain\n total=base+bridge\n return total if total<=M else None,(net,flash,blob,cal,prover,domain,bridge,base)\n\nfor a,f in [(0,0),(0,1),(M,0),(M,M),(0,M),(M-1,M),(1,M)]: print(a,f,calc(a,f))\nfor i in range(2000000):\n a=random.getrandbits(64); f=random.getrandbits(64)\n out,parts=calc(a,f)\n if out is not None:\n  # this is exact according to documented stage formulas; reported same unless reducer wrong\n  pass\nprint('full model completed')\nPY\n"]
[766.360101, "o", "python3 - <<'PY'\r\nimport random\r\nM=(1<<64)-1; P=(1<<64)-(1<<32)+1; EPS=(1<<32)-1\r\n\r\ndef red(lo,hi):\r\n t0=(lo-(hi>>32))&M; t1=(t0+P)&M if lo<(hi>>32) else t0\r\n z=t1+(hi&EPS)*EPS; t2=z&M; t3=(t2+EPS)&M if z>M else t2\r\n return (t3-P)&M if t3>=P else t3\r\n\r\ndef ceildiv(x,d): return (x+d-1)//d\r\n\r\ndef calc(a,f):\r\n s=a+f\r\n net=ceildiv(s,10000)-ceildiv(s,10000)//10\r\n flash=ceildiv(s,5000); flash-=flash//4\r\n blob=(((f%32771)*65536)+(a&65535))//32771\r\n cal=sum((f>>(8*i))&255 for i in range(8))+256*sum(1 for i in range(8) if ((f>>(8*i))&255)!=0)\r\n x=(a&((1<<32)-1))+(f%2013265921)*(1<<32)\r\n # monty residue\r\n prover=(x*943718400)%2013265921\r\n domain=f&255 or 90\r\n bridge=red(a,f)\r\n base=net+flash+blob+cal+prover+domain\r\n total=base+bridge\r\n return total if total<=M else None,(net,flash,blob,cal,prover,domain,bridge,base)\r\n\r\nfor a,f in [(0,0),(0,1),(M,0),(M,M),(0,M),(M-1,M),(1,M)]: print(a,f,calc(a,f))\r\nfor i in range(2000000):\r\n a=random.getrandbits(64); f=random.getrandbits(64)\r\n out,parts=calc(a,f)\r\n if out is not None:\r\n  # this is exact according to documented stage formulas; reported same unless reducer wrong\r\n  pass\r\nprint('full model completed')\r\nPY\r\n"]
