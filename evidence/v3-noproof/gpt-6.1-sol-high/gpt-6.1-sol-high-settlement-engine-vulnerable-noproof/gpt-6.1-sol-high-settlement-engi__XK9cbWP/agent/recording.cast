[295.331862, "o", "\u001b[?2004hroot@41aebfb9ecd7:/workspace/challenge# "]
[608.243427, "i", "cat > /tmp/check.py <<'PY'\nimport random\nD = 10000\nR = 1616\nQ = 1844674407370955\nM = (1 << 64) - 1\n\ndef add_word(a, b):\n    s = (a + b) & M\n    return s, int(s < a)\n\ndef ceil_impl(a, b):\n    low, carry = add_word(a, b)\n    if carry:\n        folded = (low % D) + R\n        return Q + low // D + (folded + D - 1) // D\n    biased = (low + D - 1) & M\n    if biased < low:\n        return low // D + (((low % D) + D - 1) // D)\n    return biased // D\n\ndef auth_impl(balance, amount, fee):\n    gross = ceil_impl(amount, fee)\n    net = gross - gross // 10\n    total = amount + net\n    return total if total <= M and total <= balance else None\n\ndef auth_exact(balance, amount, fee):\n    gross = (amount + fee + D - 1) // D\n    net = gross - gross // 10\n    total = amount + net\n    return total if total <= balance else None\n\nvals = [0, 1, 2, 9, 10, 9998, 9999, 10000, 10001, 499999, 500000,\n        10**12, 10**15, M-20000, M-10000, M-9999, M-5000, M-4999,\n        M-1616, M-1, M]\ntriples = [(b, a, f) for b in vals for a in vals for f in vals]\nrng = random.Random(0x5E771E)\ntriples += [(rng.getrandbits(64), rng.getrandbits(64), rng.getrandbits(64)) for _ in range(200000)]\nfor b, a, f in triples:\n    x = auth_impl(b, a, f)\n    y = auth_exact(b, a, f)\n    if x != y:\n        raise SystemExit(f'mismatch balance={b} amount={a} fee={f}: impl={x} exact={y}')\nprint(f'checked {len(triples)} triples: no mismatches')\nPY\npython3 /tmp/check.py\n"]
[608.252427, "o", "cat > /tmp/check.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import random\r\n\u001b[?2004l\r\u001b[?2004h> D = 10000\r\n\u001b[?2004l\r\u001b[?2004h> R = 1616\r\n\u001b[?2004l\r\u001b[?2004h> Q = 1844674407370955\r\n\u001b[?2004l\r\u001b[?2004h> M = (1 << 64) - 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def add_word(a, b):\r\n\u001b[?2004l\r\u001b[?2004h>     s = (a + b) & M\r\n\u001b[?2004l\r\u001b[?2004h>     return s, int(s < a)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def ceil_impl(a, b):\r\n\u001b[?2004l\r\u001b[?2004h>     low, carry = add_word(a, b)\r\n\u001b[?2004l\r\u001b[?2004h>     if carry:\r\n\u001b[?2004l\r\u001b[?2004h>         folded = (low % D) + R\r\n\u001b[?2004l\r\u001b[?2004h>         return Q + low // D + (folded + D - 1) // D\r\n\u001b[?2004l\r\u001b[?2004h>     biased = (low + D - 1) & M\r\n\u001b[?2004l\r\u001b[?2004h>     if biased < low:\r\n\u001b[?2004l\r\u001b[?2004h>         return low // D + (((low % D) + D - 1) // D)\r\n\u001b[?2004l\r\u001b[?2004h>     return biased // D\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def auth_impl(balance, amount, fee):\r\n\u001b[?2004l\r\u001b[?2004h>     gross = ceil_impl(amount, fee)\r\n\u001b[?2004l\r\u001b[?2004h>     net = gross - gross // 10\r\n\u001b[?2004l\r\u001b[?2004h>     total = amount + net\r\n\u001b[?2004l\r\u001b[?2004h>     return total if total <= M and total <= balance else None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def auth_exact(balance, amount, fee):\r\n\u001b[?2004l\r\u001b[?2004h>     gross = (amount + fee + D - 1) // D\r\n\u001b[?2004l\r\u001b[?2004h>     net = gross - gross // 10\r\n\u001b[?2004l\r\u001b[?2004h>     total = amount + net\r\n\u001b[?2004l\r\u001b[?2004h>     return total if total <= balance else None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> vals = [0, 1, 2, 9, 10, 9998, 9999, 10000, 10001, 499999, 500000,\r\n\u001b[?2004l\r\u001b[?2004h>         10**12, 10**15, M-20000, M-10000, M-9999, M-5000, M-4999,\r\n\u001b[?2004l\r\u001b[?2004h>         M-1616, M-1, M]\r\n\u001b[?2004l\r\u001b[?2004h> triples = [(b, a, f) for b in vals for a in vals for f in vals]\r\n\u001b[?2004l\r\u001b[?2004h> rng = random.Random(0x5E771E)\r\n\u001b[?2004l\r\u001b[?2004h> triples += [(rng.getrandbits(64), rng.getrandbits(64), rng.getrandbits(64)) for _ in range(200000)]"]
