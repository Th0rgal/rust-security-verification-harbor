[937.99734, "o", "    assert_eq!(got_reduce, want_reduce, \"reduce mismatch: amount={amount}, fee={fee}\");\r\n\u001b[?2004l\r\u001b[?2004h>     let got = repaired::authorize(balance, amount, fee).map(|x| x.total_debit);\r\n\u001b[?2004l\r\u001b[?2004h>     let want = reference_authorize(balance, amount, fee);\r\n\u001b[?2004l\r\u001b[?2004h>     assert_eq!(got, want, \"authorize mismatch: balance={balance}, amount={amount}, fee={fee}\");\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> fn main() {\r\n\u001b[?2004l\r\u001b[?2004h>     let max = u64::MAX;\r\n\u001b[?2004l\r\u001b[?2004h>     let vals = [0, 1, 2, 3, 0xffff_ffff, 0x1_0000_0000,\r\n\u001b[?2004l\r\u001b[?2004h>                 0xffff_ffff_0000_0000, max - 1, max];\r\n\u001b[?2004l\r\u001b[?2004h> "]
