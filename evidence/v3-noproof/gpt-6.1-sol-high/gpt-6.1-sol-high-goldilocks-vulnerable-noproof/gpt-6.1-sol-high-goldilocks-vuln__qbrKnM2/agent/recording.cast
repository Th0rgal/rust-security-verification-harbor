[727.723321, "o", "\u001b[?2004hroot@1162f035bca2:/workspace/challenge# cat > /workspace/submission/src/lib.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n\u001b[?2004l\r\u001b[?2004h> pub struct Authorization {\r\n\u001b[?2004l\r\u001b[?2004h>     pub total_debit: u64,\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub mod field {\r\n\u001b[?2004l\r\u001b[?2004h>     pub const GOLDILOCKS_MODULUS: u64 = 0xFFFF_FFFF_0000_0001u64;\r\n\u001b[?2004l\r\u001b[?2004h>     pub const GOLDILOCKS_EPSILON: u64 = 0xFFFF_FFFFu64;\r\n\u001b[?2004l\r\u001b[?2004h>     pub const LIMB_SHIFT: u64 = 32u64;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n\u001b[?2004l\r\u001b[?2004h>     pub struct TranscriptLimbs {\r\n\u001b[?2004l\r\u001b[?2004h>         pub low: u64,\r\n\u001b[?2004l\r\u001b[?2004h>         pub mid: u64,\r\n\u001b[?2004l\r\u001b[?2004h>         pub high: u64,\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     #[inline]\r\n\u001b[?2004l\r\u001b[?2004h>     pub fn split_transcript(amount: u64, fee: u64) -> TranscriptLimbs {\r\n\u001b[?2004l\r\u001b[?2004h>         TranscriptLimbs {\r\n\u001b[?2004l\r\u001b[?2004h>             low: amount,\r\n\u001b[?2004l\r\u001b[?2004h>             mid: fee & GOLDILOCKS_EPSILON,\r\n\u001b[?2004l\r\u001b[?2004h>             high: fee >> LIMB_SHIFT,\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     /// Fold the top 32-bit limb `high * 2^96` into `low` using `2^96 == -1 (mod P)`.\r\n\u001b[?2004l\r\u001b[?2004h>     #[inline]\r\n\u001b[?2004l\r\u001b[?2004h>     pub fn fold_high_limb(low: u64, high: u64) -> u64 {\r\n\u001b[?2004l\r\u001b[?2004h>         if low >= high {\r\n\u001b[?2004l\r\u001b[?2004h>             low - high\r\n\u001b[?2004l\r\u001b[?2004h>         } else {\r\n\u001b[?2004l\r\u001b[?2004h>             GOLDILOCKS_MODULUS - (high - low)\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[727.735366, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     /// Fold the middle 32-bit limb `mid * 2^64` using `2^64 == 2^32 - 1 (mod P)`.\r\n\u001b[?2004l\r\u001b[?2004h>     #[inline]\r\n\u001b[?2004l\r\u001b[?2004h>     pub fn fold_mid_limb(low2: u64, mid: u64) -> u64 {\r\n\u001b[?2004l\r\u001b[?2004h>         let product: u64 = mid * GOLDILOCKS_EPSILON;\r\n\u001b[?2004l\r\u001b[?2004h>         let modulus_minus_product: u64 = GOLDILOCKS_MODULUS - product;\r\n\u001b[?2004l\r\u001b[?2004h>         if low2 >= modulus_minus_product {\r\n\u001b[?2004l\r\u001b[?2004h>             low2 - modulus_minus_product\r\n\u001b[?2004l\r\u001b[?2004h>         } else {\r\n\u001b[?2004l\r\u001b[?2004h>             low2 + product\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     #[inline]\r\n\u001b[?2004l\r\u001b[?2004h>     pub fn canonicalize(folded: u64) -> u64 {\r\n\u001b[?2004l\r\u001b[?2004h>         if folded >= GOLDILOCKS_MODULUS {\r\n\u001b[?2004l\r\u001b[?2004h>             folded - GOLDILOCKS_MODULUS\r\n\u001b[?2004l\r\u001b[?2004h>         } else {\r\n\u001b[?2004l\r\u001b[?2004h>             folded\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     /// Reduce the 128-bit integer `amount + fee * 2^64` modulo the Goldilocks\r\n\u001b[?2004l\r\u001b[?2004h>     /// prime `P = 2^64 - 2^32 + 1` in pure `u64`.\r\n\u001b[?2004l\r\u001b[?2004h>     #[inline]\r\n\u001b[?2004l\r\u001b[?2004h>     pub fn reduce_128(amount: u64, fee: u64) -> u64 {\r\n\u001b[?2004l\r\u001b[?2004h>         let limbs: TranscriptLimbs = split_transcript(amount, fee);\r\n\u001b[?2004l\r\u001b[?2004h>         let low2: u64 = fold_high_limb(limbs.low, limbs.high);\r\n\u001b[?2004l\r\u001b[?2004h>         let folded: u64 = fold_mid_limb(low2, limbs.mid);\r\n\u001b[?2004l\r\u001b[?2004h>         canonicalize(folded)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub mod settlement {\r\n\u001b[?2004l\r\u001b[?2004h>     use crate::field;\r\n\u001b[?2004l\r\u001b[?2004h>     use crate::Authorization;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     pub const PRINCIPAL_DIVISOR: u64 = 2u64;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n\u001b[?2004l\r\u001b[?2004h>     pub struct GoldilocksQuote {\r\n\u001b[?2004l\r\u001b[?2004h>         pub principal_share: u64,\r\n\u001b[?2004l\r\u001b[?2004h>         pub field_surcharge: u64,\r\n\u001b[?2004l\r\u001b[?2004h>         pub total_debit: u64,\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     #[inline]\r\n\u001b[?2004l\r\u001b[?2004h>     pub fn build_quote(amount: u64, fee: u64) -> Option<GoldilocksQuote> {\r\n\u001b[?2004l\r\u001b[?2004h>         let principal_share: u64 = amount / PRINCIPAL_DIVISOR;\r\n\u001b[?2004l\r\u001b[?2004h>         let field_surcharge: u64 = field::reduce_128(amount, fee);\r\n\u001b[?2004l\r\u001b[?2004h>         let total_debit: u64 = principal_share.checked_add(field_surcharge)?;\r\n\u001b[?2004l\r\u001b[?2004h>         Some(GoldilocksQuote {\r\n\u001b[?2004l\r\u001b[?2004h>             principal_share,\r\n\u001b[?2004l\r\u001b[?2004h>             field_surcharge,\r\n\u001b[?2004l\r\u001b[?2004h>             total_debit,\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     #[inline]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[727.735715, "o", "    pub fn verify_affordability(balance: u64, quote: GoldilocksQuote) -> Option<Authorization> {\r\n\u001b[?2004l\r"]
[727.735857, "o", "\u001b[?2004h> "]
[727.735989, "o", "        if quote.total_debit <= balance {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[727.736115, "o", "            Some(Authorization {\r\n\u001b[?2004l\r"]
[727.736244, "o", "\u001b[?2004h> "]
[727.736363, "o", "                total_debit: quote.total_debit,\r\n\u001b[?2004l\r"]
[727.736401, "o", "\u001b[?2004h> "]
[727.736558, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[727.736607, "o", "        } else {\r\n\u001b[?2004l\r"]
[727.736639, "o", "\u001b[?2004h> "]
[727.736843, "o", "            None\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[727.73689, "o", ">     }\r\n\u001b[?2004l\r"]
[727.736919, "o", "\u001b[?2004h> "]
[727.736952, "o", "}\r\n\u001b[?2004l\r"]
[727.736991, "o", "\u001b[?2004h> "]
[727.737024, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[727.737055, "o", "> "]
[727.737372, "o", "/// Authorize a Goldilocks rollup settlement against `balance`.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[727.737701, "o", "pub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {\r\n\u001b[?2004l\r"]
[727.737736, "o", "\u001b[?2004h> "]
[727.738084, "o", "    let quote: settlement::GoldilocksQuote = settlement::build_quote(amount, fee)?;\r\n\u001b[?2004l\r"]
[727.738119, "o", "\u001b[?2004h> "]
[727.738371, "o", "    settlement::verify_affordability(balance, quote)\r\n\u001b[?2004l\r"]
[727.738407, "o", "\u001b[?2004h> }"]
[727.738435, "o", "\r\n\u001b[?2004l\r"]
[727.738461, "o", "\u001b[?2004h> "]
[727.738676, "o", "EOF\r\n\u001b[?2004l\r"]
