[1377.691233, "i", "cat >/tmp/verify_repair.rs <<'EOF'\ninclude!(\"/workspace/submission/src/lib.rs\");\n\nfn reference_reduce(amount: u64, fee: u64) -> u64 {\n    let p: u128 = (1u128 << 64) - (1u128 << 32) + 1;\n    ((amount as u128 + (fee as u128) * (1u128 << 64)) % p) as u64\n}\n\nfn reference_authorize(balance: u64, amount: u64, fee: u64) -> Option<u64> {\n    let principal = amount / 2;\n    let surcharge = reference_reduce(amount, fee);\n    let total = principal as u128 + surcharge as u128;\n    if total <= balance as u128 { Some(total as u64) } else { None }\n}\n\nfn check(balance: u64, amount: u64, fee: u64) {\n    assert_eq!(field::reduce_128(amount, fee), reference_reduce(amount, fee),\n        \"reduce mismatch: amount={amount}, fee={fee}\");\n    assert_eq!(authorize(balance, amount, fee).map(|x| x.total_debit),\n        reference_authorize(balance, amount, fee),\n        \"authorize mismatch: balance={balance}, amount={amount}, fee={fee}\");\n}\n\nfn main() {\n    let max = u64::MAX;\n    let vals = [0, 1, 2, 3, 0xffff_ffff, 0x1_0000_0000,\n                0xffff_ffff_0000_0000, max - 1, max];\n    for &a in &vals { for &f in &vals { for &b in &vals { check(b, a, f); } } }\n\n    let mut x: u64 = 0x9e37_79b9_7f4a_7c15;\n    for _ in 0..200_000 {\n        x ^= x << 7;\n        x ^= x >> 9;\n        x ^= x << 8;\n        let a = x;\n        x = x.wrapping_mul(0xd134_2543_de82_ef95).wrapping_add(1);\n        let f = x;\n        x ^= x >> 17;\n        let b = x;\n        check(b, a, f);\n    }\n\n    assert_eq!(authorize(4_294_967_294, 0, 4_294_967_296), None);\n    println!(\"repair differential checks passed\");\n}\nEOF\nrustc --edition=2021 /tmp/verify_repair.rs -O -o /tmp/verify_repair && /tmp/verify_repair\n"]
