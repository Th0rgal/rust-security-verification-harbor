[234.821808, "o", "test tests::ceiling_bias_wrap_at_u64_max ... \u001b[32mok\u001b[m\u000f\r\ntest tests::ceiling_rounding_and_rebate ... \u001b[32mok\u001b[m\u000f\r\ntest tests::floor_div_helper_matches_exact_quotient ... \u001b[32mok\u001b[m\u000f\r\ntest tests::ordinary_settlement ... \u001b[32mok\u001b[m\u000f\r\ntest tests::total_debit_overflow_rejected ... \u001b[32mok\u001b[m\u000f\r\ntest tests::wide_basis_carry_folding ... \u001b[32mok\u001b[m\u000f\r\n\r\ntest result: \u001b[32mok\u001b[m\u000f. 6 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.00s\r\n\r\n"]
