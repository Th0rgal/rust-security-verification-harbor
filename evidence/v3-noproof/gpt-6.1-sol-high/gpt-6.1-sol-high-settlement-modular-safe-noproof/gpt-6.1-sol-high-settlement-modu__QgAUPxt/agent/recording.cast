[234.850585, "o", "\u001b[?2004hroot@e883fe9dc023:/workspace/challenge# "]
[236.555757, "i", "python3 - <<'PY'\nimport random\nMASK = (1 << 64) - 1\nD = 10000\nQ = 1844674407370955\nR = 1616\n\ndef impl_gross(amount, fee):\n    low = (amount + fee) & MASK\n    wrapped = low < amount\n    if wrapped:\n        folded_rem = (low % D) + R\n        return Q + (low // D) + ((folded_rem + D - 1) // D)\n    biased = (low + D - 1) & MASK\n    if biased < low:\n        return (low // D) + (((low % D) + D - 1) // D)\n    return biased // D\n\ndef impl_authorize(balance, amount, fee):\n    gross = impl_gross(amount, fee)\n    net = gross - gross // 10\n    total = amount + net\n    return total if total <= MASK and total <= balance else None\n\ndef ref_authorize(balance, amount, fee):\n    gross = (amount + fee + D - 1) // D\n    net = gross - gross // 10\n    total = amount + net\n    return total if total <= MASK and total <= balance else None\n\ncases = []\nvals = [0, 1, 2, 9, 10, 9999, 10000, 10001, 99990, 99991, 99999, 100000,\n        Q, Q*D, MASK-10000, MASK-9999, MASK-1616, MASK-1, MASK]\nfor a in vals:\n    for f in vals:\n        for b in [0, 1, 2, 8, 9, 10, MASK-1, MASK]:\n            cases.append((b, a & MASK, f & MASK))\nfor _ in range(300000):\n    cases.append((random.getrandbits(64), random.getrandbits(64), random.getrandbits(64)))\nfor b, a, f in cases:\n    x = impl_authorize(b, a, f)\n    y = ref_authorize(b, a, f)\n    if x != y:\n        print('MISMATCH', b, a, f, x, y)\n        raise SystemExit(1)\nprint('independent arithmetic comparison passed for', len(cases), 'boundary/random cases')\nPY\n"]
