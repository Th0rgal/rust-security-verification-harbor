[649.327573, "i", "python3 - <<'PY'\nimport random\nP=2013265921\nR=1<<32\nMASK=R-1\nRINV=943718400\nU64=(1<<64)-1\n\ndef expected(balance, amount, fee):\n    surcharge=(((amount&MASK)+(fee%P)*R)*RINV)%P\n    debit=amount+surcharge\n    return debit if debit<=U64 and debit<=balance else None\n\ndef implementation_model(balance, amount, fee):\n    x=(amount&MASK)+(fee%P)*R\n    t=((x&MASK)*2281701377)&MASK\n    u=t*P\n    diff=(x-u)&U64\n    hi=diff>>32\n    if x<u:\n        hi=hi+P-R\n    if amount > U64-hi:\n        return None\n    total=amount+hi\n    return total if total<=balance else None\n\nvals=[0,1,2,P-1,P,P+1,R-1,R,R+1,U64]\nfor b in vals:\n    for a in vals:\n        for f in vals:\n            if expected(b,a,f)!=implementation_model(b,a,f):\n                raise SystemExit(f'mismatch: {b} {a} {f}')\nfor _ in range(1000000):\n    b=random.getrandbits(64)\n    a=random.getrandbits(64)\n    f=random.getrandbits(64)\n    if expected(b,a,f)!=implementation_model(b,a,f):\n        raise SystemExit(f'mismatch: {b} {a} {f}')\nprint('authorization model matches mathematical policy on boundary cases and 1,000,000 random triples')\nPY\n"]
[649.327852, "o", "python3 - <<'PY'"]
