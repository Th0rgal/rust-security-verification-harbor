[546.115363, "i", "python3 - <<'PY'\nP=2013265921\nR=1<<32\nMU=2281701377\nR_INV=943718400\nprint('P*MU mod R =', (P*MU)%R)\nprint('P inverse mod R =', pow(P,-1,R))\nprint('-P inverse mod R =', (-pow(P,-1,R))%R)\nprint('R*R_INV mod P =', (R*R_INV)%P)\nprint('max pack =', (P-1)*R + (R-1), '<', 1<<64)\nprint('max xlo*MU =', (R-1)*MU, '<', 1<<64)\nprint('max t*P =', (R-1)*P, '<', 1<<64)\nPY\n"]
