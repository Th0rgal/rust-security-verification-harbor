[546.128661, "o", "\u001b[?2004hroot@0f2d8ccb7d3a:/workspace/challenge# "]
[546.320214, "i", "python3 - <<'PY'\nimport random\nP=2013265921\nR=1<<32\nMASK=R-1\nMU=2281701377\nR_INV=943718400\nU64=(1<<64)-1\n\ndef impl(amount, fee):\n    low=amount&MASK\n    high=fee%P\n    x=low+high*R\n    t=((x&MASK)*MU)&MASK\n    u=t*P\n    diff=(x-u)&U64\n    borrow=x<u\n    hi=diff>>32\n    if borrow:\n        hi=hi+P-R\n    return hi\n\ndef spec(amount, fee):\n    x=(amount&MASK)+(fee%P)*R\n    return (x*R_INV)%P\n\nvals=[0,1,2,P-1,P,P+1,R-1,R,R+1,U64]\nfor a in vals:\n  for f in vals:\n    x=impl(a,f); y=spec(a,f)\n    if x!=y:\n      print('MISMATCH',a,f,x,y)\n      raise SystemExit(1)\nfor i in range(1000000):\n    a=random.getrandbits(64); f=random.getrandbits(64)\n    x=impl(a,f); y=spec(a,f)\n    if x!=y:\n      print('MISMATCH',a,f,x,y)\n      raise SystemExit(1)\nprint('all boundary and 1,000,000 random reduction checks passed')\nPY\n"]
[546.323626, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import random\r\n\u001b[?2004l\r\u001b[?2004h> P=2013265921\r\n\u001b[?2004l\r\u001b[?2004h> R=1<<32\r\n\u001b[?2004l\r\u001b[?2004h> MASK=R-1\r\n\u001b[?2004l\r\u001b[?2004h> MU=2281701377\r\n\u001b[?2004l\r\u001b[?2004h> R_INV=943718400\r\n\u001b[?2004l\r\u001b[?2004h> U64=(1<<64)-1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def impl(amount, fee):\r\n\u001b[?2004l\r\u001b[?2004h>     low=amount&MASK\r\n\u001b[?2004l\r\u001b[?2004h>     high=fee%P\r\n\u001b[?2004l\r\u001b[?2004h>     x=low+high*R\r\n\u001b[?2004l\r\u001b[?2004h>     t=((x&MASK)*MU)&MASK\r\n\u001b[?2004l\r\u001b[?2004h>     u=t*P\r\n\u001b[?2004l\r\u001b[?2004h>     diff=(x-u)&U64\r\n\u001b[?2004l\r\u001b[?2004h>     borrow=x<u\r\n\u001b[?2004l\r\u001b[?2004h>     hi=diff>>32\r\n\u001b[?2004l\r\u001b[?2004h>     if borrow:\r\n\u001b[?2004l\r\u001b[?2004h>         hi=hi+P-R\r\n\u001b[?2004l\r\u001b[?2004h>     return hi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def spec(amount, fee):\r\n\u001b[?2004l\r\u001b[?2004h>     x=(amount&MASK)+(fee%P)*R\r\n\u001b[?2004l\r\u001b[?2004h>     return (x*R_INV)%P\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> vals=[0,1,2,P-1,P,P+1,R-1,R,R+1,U64]\r\n\u001b[?2004l\r\u001b[?2004h> for a in vals:\r\n\u001b[?2004l\r\u001b[?2004h>   for f in vals:\r\n\u001b[?2004l\r\u001b[?2004h>     x=impl(a,f); y=spec(a,f)\r\n\u001b[?2004l\r\u001b[?2004h>     if x!=y:\r\n\u001b[?2004l\r\u001b[?2004h>       print('MISMATCH',a,f,x,y)\r\n\u001b[?2004l\r\u001b[?2004h> "]
