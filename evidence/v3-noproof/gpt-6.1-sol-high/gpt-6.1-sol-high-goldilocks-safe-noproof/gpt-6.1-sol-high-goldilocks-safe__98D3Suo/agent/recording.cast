[228.234121, "o", "\u001b[1m\u001b[32m   Doc-tests\u001b[0m settlement_gate\r\n"]
[228.451108, "i", "cat > /tmp/check.rs <<'EOF'\nconst P: u64 = 0xFFFF_FFFF_0000_0001;\nconst E: u64 = 0xFFFF_FFFF;\nfn impl_reduce(amount: u64, fee: u64) -> u64 {\n    let high = fee >> 32;\n    let mid = fee & E;\n    let (low2, borrow) = amount.overflowing_sub(high);\n    let low2 = if borrow { low2.wrapping_add(P) } else { low2 };\n    let product = mid * E;\n    let (sum1, carry) = low2.overflowing_add(product);\n    let folded = if carry { sum1.wrapping_add(E) } else { sum1 };\n    if folded >= P { folded - P } else { folded }\n}\nfn main() {\n    let mut x: u64 = 0x1234_5678_9abc_def0;\n    for i in 0..5_000_000u64 {\n        x = x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n        let amount = x;\n        x = x.rotate_left(17).wrapping_mul(2862933555777941757).wrapping_add(3037000493);\n        let fee = x;\n        let expected = ((amount as u128 + (fee as u128) * (1u128 << 64)) % (P as u128)) as u64;\n        let actual = impl_reduce(amount, fee);\n        if actual != expected {\n            println!(\"mismatch i={i} amount={amount} fee={fee} actual={actual} expected={expected}\");\n            std::process::exit(1);\n        }\n    }\n    println!(\"5,000,000 differential cases matched\");\n}\nEOF\nrustc -C opt-level=3 -C overflow-checks=off /tmp/check.rs -o /tmp/check && /tmp/check\n"]
[228.453413, "o", "cat > /tmp/check.rs <<'EOF'\r\nconst P: u64 = 0xFFFF_FFFF_0000_0001;\r\nconst E: u64 = 0xFFFF_FFFF;\r\nfn impl_reduce(amount: u64, fee: u64) -> u64 {\r\n    let high = fee >> 32;\r\n    let mid = fee & E;\r\n    let (low2, borrow) = amount.overflowing_sub(high);\r\n    let low2 = if borrow { low2.wrapping_add(P) } else { low2 };\r\n    let product = mid * E;\r\n    let (sum1, carry) = low2.overflowing_add(product);\r\n    let folded = if carry { sum1.wrapping_add(E) } else { sum1 };\r\n    if folded >= P { folded - P } else { folded }\r\n}\r\nfn main() {\r\n    let mut x: u64 = 0x1234_5678_9abc_def0;\r\n    for i in 0..5_000_000u64 {\r\n        x = x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\r\n        let amount = x;\r\n        x = x.rotate_left(17).wrapping_mul(2862933555777941757).wrapping_add(3037000493);\r\n        let fee = x;\r\n        let expected = ((amount as u128 + (fee as u128) * (1u128 << 64)) % (P as u128)) as u64;\r\n        let actual = impl_reduce(amount, fee);\r\n        if actual != expected {\r\n            println!(\"mismatch i={i} amount={amount} fee={fee} actual={actual} expected={expected}\");\r\n            std::process::exit(1);\r\n        }\r\n    }\r\n    println!(\"5,000,000 differential cases matched\");\r\n}\r\nEOF\r\nrustc -C opt-level=3 -C overflow-checks=off /tmp/check.rs -o /tmp/check && /tmp/check\r\n"]
