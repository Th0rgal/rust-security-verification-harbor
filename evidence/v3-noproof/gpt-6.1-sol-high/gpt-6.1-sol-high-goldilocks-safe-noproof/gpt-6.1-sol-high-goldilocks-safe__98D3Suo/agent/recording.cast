[461.787399, "i", "cat > /tmp/check_auth.rs <<'EOF'\nconst P: u128 = 18446744069414584321u128;\nconst U64MAX: u128 = 18446744073709551615u128;\nfn reduce(amount: u64, fee: u64) -> u64 {\n    const MOD: u64 = 0xFFFF_FFFF_0000_0001;\n    const EPS: u64 = 0xFFFF_FFFF;\n    let high = fee >> 32;\n    let mid = fee & EPS;\n    let (low, borrow) = amount.overflowing_sub(high);\n    let low = if borrow { low.wrapping_add(MOD) } else { low };\n    let product = mid * EPS;\n    let (sum, carry) = low.overflowing_add(product);\n    let folded = if carry { sum.wrapping_add(EPS) } else { sum };\n    if folded >= MOD { folded - MOD } else { folded }\n}\nfn actual(balance: u64, amount: u64, fee: u64) -> Option<u64> {\n    let surcharge = reduce(amount, fee);\n    let total = (amount / 2).checked_add(surcharge)?;\n    if total <= balance { Some(total) } else { None }\n}\nfn expected(balance: u64, amount: u64, fee: u64) -> Option<u64> {\n    let surcharge = ((amount as u128 + (fee as u128) * (1u128 << 64)) % P) as u128;\n    let total = amount as u128 / 2 + surcharge;\n    if total <= U64MAX && total <= balance as u128 { Some(total as u64) } else { None }\n}\nfn main() {\n    let vals: [u64; 25] = [\n        0, 1, 2, 3, 0xFFFF_FFFF, 0x1_0000_0000,\n        0x1_0000_0001, 0xFFFF_FFFE_FFFF_FFFF, 0xFFFF_FFFF_0000_0000,\n        0xFFFF_FFFF_0000_0001, 0xFFFF_FFFF_0000_0002,\n        0xFFFF_FFFF_FFFF_FFFE, u64::MAX,\n        18446744069414584319, 18446744069414584320, 18446744069414584321,\n        18446744069414584322, 18446744069414584330,\n        9223372034707292160, 9223372034707292161, 9223372034707292165,\n        9223372036854775807, 9223372036854775808, 9223372036854775809,\n        4294967295,\n    ];\n    let mut cases: u64 = 0;\n    for &b in &vals {\n        for &a in &vals {\n            for &f in &vals {\n                let x = actual(b, a, f);\n                let y = expected(b, a, f);\n                if x != y { panic!(\"boundary mismatch b={b} a={a} f={f}: {:?} != {:?}\", x, y); }\n                cases += 1;\n            }\n        }\n    }\n    let mut x: u64 = 0x243f_6a88_85a3_08d3;\n    for i in 0..10_000_000u64 {\n        x = x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n        let b = x;\n        x = x.rotate_left(23).wrapping_mul(2862933555777941757).wrapping_add(3037000493);\n        let a = x;\n        x = x.rotate_left(41).wrapping_mul(3202034522624059733).wrapping_add(1);\n        let f = x;\n        let got = actual(b, a, f);\n        let want = expected(b, a, f);\n        if got != want { panic!(\"random mismatch i={i} b={b} a={a} f={f}: {:?} != {:?}\", got, want); }\n        cases += 1;\n    }\n    println!(\"{cases} complete authorization cases matched independent u128 specification\");\n}\nEOF\nrustc -C opt-level=3 -C overflow-checks=off /tmp/check_auth.rs -o /tmp/check_auth && /tmp/check_auth\n"]
