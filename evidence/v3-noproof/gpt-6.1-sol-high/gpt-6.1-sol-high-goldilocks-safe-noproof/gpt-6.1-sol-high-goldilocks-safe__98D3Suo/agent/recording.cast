[545.101524, "o", "\r\n\u001b[?2004hroot@850a700a9803:/workspace/challenge# "]
[631.265479, "i", "cat > /tmp/check_real.rs <<'EOF'\n#![allow(dead_code)]\ninclude!(\"/workspace/challenge/src/lib.rs\");\n\nconst P: u128 = 18446744069414584321u128;\nconst U64_MAX: u128 = 18446744073709551615u128;\n\nfn expected(balance: u64, amount: u64, fee: u64) -> Option<u64> {\n    let surcharge = ((amount as u128) + (fee as u128) * (1u128 << 64)) % P;\n    let total = (amount as u128) / 2 + surcharge;\n    if total <= U64_MAX && total <= balance as u128 {\n        Some(total as u64)\n    } else {\n        None\n    }\n}\n\nfn check(balance: u64, amount: u64, fee: u64) {\n    let got = authorize(balance, amount, fee).map(|x| x.total_debit);\n    let want = expected(balance, amount, fee);\n    assert_eq!(got, want, \"mismatch balance={balance} amount={amount} fee={fee}: got={got:?} want={want:?}\");\n    let got_field = field::reduce_128(amount, fee) as u128;\n    let want_field = ((amount as u128) + (fee as u128) * (1u128 << 64)) % P;\n    assert_eq!(got_field, want_field, \"field mismatch amount={amount} fee={fee}\");\n}\n\nfn main() {\n    let vals: [u64; 31] = [\n        0, 1, 2, 3, 4, 0xFFFF_FFFF, 0x1_0000_0000,\n        0x1_0000_0001, 0xFFFF_FFFE_FFFF_FFFF, 0xFFFF_FFFF_0000_0000,\n        0xFFFF_FFFF_0000_0001, 0xFFFF_FFFF_0000_0002,\n        0xFFFF_FFFF_FFFF_FFFE, u64::MAX,\n        18446744069414584319, 18446744069414584320, 18446744069414584321,\n        18446744069414584322, 18446744069414584330,\n        9223372034707292160, 9223372034707292161, 9223372034707292165,\n        9223372036854775807, 9223372036854775808, 9223372036854775809,\n        4294967294, 4294967295, 4294967296,\n        8589934590, 8589934591, 8589934592,\n    ];\n    let mut cases = 0u64;\n    for &balance in &vals {\n        for &amount in &vals {\n            for &fee in &vals {\n                check(balance, amount, fee);\n                cases += 1;\n            }\n        }\n    }\n\n    // Explicitly exercise the middle-fold carry and high-fold borrow paths.\n    for amount in [0, 1, 2, 0xFFFF_FFFF, 0x1_0000_0000, u64::MAX] {\n        for fee in [0x0000_0000_FFFF_FFFF, 0x0000_0001_FFFF_FFFF, u64::MAX, 0xFFFF_FFFF_0000_0000] {\n            for balance in [0, u64::MAX, amount / 2] {\n                check(balance, amount, fee);\n                cases += 1;\n            }\n        }\n    }\n\n    let mut x = 0x243f_6a88_85a3_08d3u64;\n    for _ in 0..5_000_000u64 {\n        x = x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n        let balance = x;\n        x = x.rotate_left(23).wrapping_mul(2862933555777941757).wrapping_add(3037000493);\n        let amount = x;\n        x = x.rotate_left(41).wrapping_mul(3202034522624059733).wrapping_add(1);\n        let fee = x;\n        check(balance, amount, fee);\n        cases += 1;\n    }\n    println!(\"{cases} cases matched the independent mathematical specification\");\n}\nEOF\nrustc -C opt-level=3 -C overflow-checks=off /tmp/check_real.rs -o /tmp/check_real && /tmp/check_real\n"]
[631.26586, "o", "cat > /tmp/check_real.rs <<'EOF'\r\n"]
