[466.773714, "o", "safe\r\n"]
[466.773904, "o", "\u001b[?2004hroot@850a700a9803:/workspace/challenge# "]
[544.66863, "i", "python3 - <<'PY'\nP = 2**64 - 2**32 + 1\nE = 2**32 - 1\n\ndef impl_reduce(amount, fee):\n    high = fee >> 32\n    mid = fee & E\n    low2 = (amount - high) & ((1<<64)-1)\n    if amount < high:\n        low2 = (low2 + P) & ((1<<64)-1)\n    product = mid * E\n    total = low2 + product\n    sum1 = total & ((1<<64)-1)\n    if total >> 64:\n        sum1 = (sum1 + E) & ((1<<64)-1)\n    return sum1 - P if sum1 >= P else sum1\n\ndef expected(amount, fee):\n    return (amount + fee * (1<<64)) % P\n\nfor amount in [0, 1, 2, E, 1<<32, 2**64-2, 2**64-1]:\n  for fee in [E, 1<<32, (1<<32)|E, 2**64-1]:\n    a = impl_reduce(amount, fee); b = expected(amount, fee)\n    if a != b: print('mismatch', amount, fee, a, b)\n\n# Search a simple witness where the incorrect accepted debit is affordable but exact debit is not.\n# Since the implementation is one too high in the relevant case, choose balance=bad total.\nfor amount in range(0, 1000):\n  for fee in [E, (1<<32)|E, 2**64-1]:\n    bad = impl_reduce(amount, fee); good = expected(amount, fee)\n    if bad != good:\n      total_bad = amount//2 + bad\n      total_good = amount//2 + good\n      if total_bad <= 2**64-1 and total_good > total_bad:\n        print('witness', {'balance': total_bad, 'amount': amount, 'fee': fee, 'bad_surcharge': bad, 'good_surcharge': good, 'bad_total': total_bad, 'good_total': total_good})\n        raise SystemExit\nPY\n"]
[544.670734, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> P = 2**64 - 2**32 + 1\r\n\u001b[?2004l\r\u001b[?2004h> E = 2**32 - 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def impl_reduce(amount, fee):\r\n\u001b[?2004l\r\u001b[?2004h>     high = fee >> 32\r\n\u001b[?2004l\r\u001b[?2004h>     mid = fee & E\r\n\u001b[?2004l\r\u001b[?2004h>     low2 = (amount - high) & ((1<<64)-1)\r\n\u001b[?2004l\r\u001b[?2004h>     if amount < high:\r\n\u001b[?2004l\r\u001b[?2004h>         low2 = (low2 + P) & ((1<<64)-1)\r\n\u001b[?2004l\r\u001b[?2004h>     product = mid * E\r\n\u001b[?2004l\r\u001b[?2004h>     total = low2 + product\r\n\u001b[?2004l\r\u001b[?2004h>     sum1 = total & ((1<<64)-1)\r\n\u001b[?2004l\r\u001b[?2004h>     if total >> 64:\r\n\u001b[?2004l\r\u001b[?2004h>         sum1 = (sum1 + E) & ((1<<64)-1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[544.670981, "o", "    return sum1 - P if sum1 >= P else sum1\r\n\u001b[?2004l\r"]
[544.671164, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[544.671263, "o", "> def expected(amount, fee):"]
[544.671387, "o", "\r\n"]
[544.671633, "o", "\u001b[?2004l\r\u001b[?2004h>     return (amount + fee * (1<<64)) % P"]
[544.67174, "o", "\r\n"]
[544.671888, "o", "\u001b[?2004l\r\u001b[?2004h"]
[544.672257, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[544.672307, "o", "> for amount in [0, 1, 2, E, 1<<32, 2**64-2, 2**64-1]:"]
[544.672411, "o", "\r\n"]
[544.672499, "o", "\u001b[?2004l\r"]
[544.672827, "o", "\u001b[?2004h"]
[544.672874, "o", ">   for fee in [E, 1<<32, (1<<32)|E, 2**64-1]:"]
[544.672985, "o", "\r\n"]
[544.673104, "o", "\u001b[?2004l\r"]
[544.673424, "o", "\u001b[?2004h>     a = impl_reduce(amount, fee); b = expected(amount, fee)"]
[544.67354, "o", "\r\n"]
[544.673628, "o", "\u001b[?2004l\r"]
[544.673987, "o", "\u001b[?2004h"]
[544.674036, "o", ">     if a != b: print('mismatch', amount, fee, a, b)"]
[544.674139, "o", "\r\n"]
[544.674271, "o", "\u001b[?2004l\r"]
[544.674429, "o", "\u001b[?2004h> \r\n"]
[544.674877, "o", "\u001b[?2004l\r\u001b[?2004h> # Search a simple witness where the incorrect accepted debit is affordable but exact debit is not."]
[544.674991, "o", "\r\n"]
[544.675134, "o", "\u001b[?2004l\r"]
[544.675674, "o", "\u001b[?2004h"]
[544.675725, "o", "> # Since the implementation is one too high in the relevant case, choose balance=bad total."]
[544.675894, "o", "\r\n"]
[544.676063, "o", "\u001b[?2004l\r"]
[544.676553, "o", "\u001b[?2004h> "]
[544.676708, "o", "for amount in range(0, 1000):"]
[544.677021, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[544.677149, "o", "> "]
[544.677302, "o", "  for fee in [E, (1<<32)|E, 2**64-1]:\r\n\u001b[?2004l\r"]
[544.677427, "o", "\u001b[?2004h> "]
[544.677596, "o", "    bad = impl_reduce(amount, fee); good = expected(amount, fee)\r\n\u001b[?2004l\r"]
[544.678063, "o", "\u001b[?2004h>     if bad != good:\r\n\u001b[?2004l\r\u001b[?2004h>       total_bad = amount//2 + bad\r\n\u001b[?2004l\r\u001b[?2004h>       total_good = amount//2 + good\r\n\u001b[?2004l\r\u001b[?2004h"]
[544.678101, "o", "> "]
[544.678375, "o", "      if total_bad <= 2**64-1 and total_good > total_bad:"]
[544.67841, "o", "\r\n"]
[544.678504, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[544.67925, "o", "        print('witness', {'balance': total_bad, 'amount': amount, 'fee': fee, 'bad_surcharge': bad, 'good_surcharge': good, 'bad_total': total_bad, 'good_total': total_good})\r\n\u001b[?2004l\r"]
[544.679287, "o", "\u001b[?2004h"]
[544.67944, "o", "> "]
[544.679481, "o", "        raise SystemExit\r\n"]
[544.679511, "o", "\u001b[?2004l\r"]
[544.679681, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[544.698871, "o", "\u001b[?2004hroot@850a700a9803:/workspace/challenge# "]
[544.890662, "i", "cat > /tmp/find.rs <<'EOF'\nconst P: u128 = 18446744069414584321;\nconst E: u64 = 0xFFFF_FFFF;\nfn bad(amount: u64, fee: u64) -> u64 {\n    let high = fee >> 32;\n    let mid = fee & E;\n    let (low2, borrow) = amount.overflowing_sub(high);\n    let low2 = if borrow { low2.wrapping_add(P as u64) } else { low2 };\n    let product = mid * E;\n    let (sum1, carry1) = low2.overflowing_add(product);\n    let folded = if carry1 { sum1.wrapping_add(E) } else { sum1 };\n    if folded >= P as u64 { folded - P as u64 } else { folded }\n}\nfn main() {\n    for amount in 0u64..1000 {\n        for fee in [E, 1u64 << 32, (1u64 << 32) | E, u64::MAX] {\n            let got = bad(amount, fee);\n            let want = ((amount as u128 + fee as u128 * (1u128 << 64)) % P) as u64;\n            if got != want {\n                let bad_total = amount / 2 + got;\n                let good_total = amount as u128 / 2 + want as u128;\n                println!(\"amount={amount} fee={fee} bad_surcharge={got} good_surcharge={want} bad_total={bad_total} good_total={good_total}\");\n                return;\n            }\n        }\n    }\n    println!(\"no witness\");\n}\nEOF\nrustc -C opt-level=3 -C overflow-checks=off /tmp/find.rs -o /tmp/find && /tmp/find\n"]
[544.891333, "o", "cat > /tmp/find.rs <<'EOF'"]
