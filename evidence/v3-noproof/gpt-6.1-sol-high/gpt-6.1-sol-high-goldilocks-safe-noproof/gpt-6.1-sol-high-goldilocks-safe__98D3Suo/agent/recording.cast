[544.892413, "o", "    let high = fee >> 32;\r\n\u001b[?2004l\r\u001b[?2004h"]
[544.892583, "o", "> "]
[544.892715, "o", "    let mid = fee & E;\r\n\u001b[?2004l\r"]
[544.892832, "o", "\u001b[?2004h> "]
[544.895023, "o", "    let (low2, borrow) = amount.overflowing_sub(high);\r\n\u001b[?2004l\r\u001b[?2004h>     let low2 = if borrow { low2.wrapping_add(P as u64) } else { low2 };\r\n\u001b[?2004l\r\u001b[?2004h>     let product = mid * E;\r\n\u001b[?2004l\r\u001b[?2004h>     let (sum1, carry1) = low2.overflowing_add(product);\r\n\u001b[?2004l\r\u001b[?2004h>     let folded = if carry1 { sum1.wrapping_add(E) } else { sum1 };\r\n\u001b[?2004l\r\u001b[?2004h>     if folded >= P as u64 { folded - P as u64 } else { folded }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> fn main() {\r\n\u001b[?2004l\r\u001b[?2004h>     for amount in 0u64..1000 {\r\n\u001b[?2004l\r\u001b[?2004h>         for fee in [E, 1u64 << 32, (1u64 << 32) | E, u64::MAX] {\r\n\u001b[?2004l\r\u001b[?2004h>             let got = bad(amount, fee);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[544.895321, "o", "            let want = ((amount as u128 + fee as u128 * (1u128 << 64)) % P) as u64;\r\n\u001b[?2004l\r"]
[544.895381, "o", "\u001b[?2004h> "]
