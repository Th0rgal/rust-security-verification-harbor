cat > /tmp/check.rs <<'EOF'
const P: u64 = 0xFFFF_FFFF_0000_0001;
const E: u64 = 0xFFFF_FFFF;
fn impl_reduce(amount: u64, fee: u64) -> u64 {
    let high = fee >> 32;
    let mid = fee & E;
    let (low2, borrow) = amount.overflowing_sub(high);
    let low2 = if borrow { low2.wrapping_add(P) } else { low2 };
    let product = mid * E;
    let (sum1, carry) = low2.overflowing_add(product);
    let folded = if carry { sum1.wrapping_add(E) } else { sum1 };
    if folded >= P { folded - P } else { folded }
}
fn main() {
    let mut x: u64 = 0x1234_5678_9abc_def0;
    for i in 0..5_000_000u64 {
        x = x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
        let amount = x;
        x = x.rotate_left(17).wrapping_mul(2862933555777941757).wrapping_add(3037000493);
        let fee = x;
        let expected = ((amount as u128 + (fee as u128) * (1u128 << 64)) % (P as u128)) as u64;
        let actual = impl_reduce(amount, fee);
        if actual != expected {
            println!("mismatch i={i} amount={amount} fee={fee} actual={actual} expected={expected}");
            std::process::exit(1);
        }
    }
    println!("5,000,000 differential cases matched");
}
