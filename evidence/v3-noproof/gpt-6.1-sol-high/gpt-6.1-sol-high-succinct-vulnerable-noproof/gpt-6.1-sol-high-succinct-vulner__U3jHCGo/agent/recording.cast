[106.944105, "o", "\u001b[?2004hroot@73447434e653:/workspace/challenge# "]
[107.554584, "i", "cat > /tmp/check.py <<'PY'\nimport random\nMASK = (1 << 64) - 1\nH8 = 0x8080808080808080\nL8 = 0x0101010101010101\nM16 = 0x00FF00FF00FF00FF\nL16 = 0x0001000100010001\n\ndef u_nz8(x):\n    return (((x | H8) - L8) & MASK) & H8\n\ndef count_nz(x):\n    return (((u_nz8(x) >> 7) * L8) & MASK) >> 56\n\ndef sum_bytes(x):\n    pairs = ((x & M16) + ((x >> 8) & M16)) & MASK\n    return (((pairs * L16) & MASK) >> 48) & 0xffff\n\ndef expected(x):\n    bs = [(x >> (8*i)) & 0xff for i in range(8)]\n    return sum(b != 0 for b in bs), sum(bs)\n\nfor b in range(256):\n    x = b * L8\n    assert count_nz(x) == (8 if b else 0), (b, count_nz(x))\n    assert sum_bytes(x) == 8*b, (b, sum_bytes(x))\n\nvals = [0, 1, MASK, H8, L8, M16, 0x0123456789abcdef, 0xfedcba9876543210]\nvals += [random.getrandbits(64) for _ in range(200000)]\nfor x in vals:\n    c, s = expected(x)\n    assert count_nz(x) == c, (hex(x), count_nz(x), c)\n    assert sum_bytes(x) == s, (hex(x), sum_bytes(x), s)\n    amount = random.getrandbits(64)\n    balance = random.getrandbits(64)\n    debit = amount // 2 + 256*c + s\n    assert debit <= MASK\n    assert ((debit <= balance) == (((amount >> 1) + (count_nz(x) << 8) + sum_bytes(x)) <= balance))\nprint('independent SWAR and policy checks passed')\nprint('maximum debit bound:', MASK // 2 + 2048 + 2040)\nPY\npython3 /tmp/check.py\n"]
