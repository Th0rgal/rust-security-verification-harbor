[128.888168, "i", "cat >/tmp/check.c <<'EOF'\n#include <stdint.h>\n#include <stdio.h>\nint main(void) {\n    const uint64_t D=0x8003, B=1ULL<<16;\n    uint64_t mismatches=0, first_u1=0, first_u0=0, first_w=0, first_g=0;\n    for (uint64_t u1=0; u1<D; ++u1) {\n        for (uint64_t u0=0; u0<B; ++u0) {\n            uint64_t q_full=u1*0xFFF4ULL+(u1<<16)+u0+(1ULL<<16);\n            uint64_t q1=q_full>>16, q0=q_full&0xffff;\n            uint64_t r=(0xC0000000ULL+u0-q1*D)&0xffff;\n            uint64_t qc, rc;\n            if (q0<r) { qc=q1-1; rc=(r+D)&0xffff; }\n            else { qc=q1; rc=r; }\n            uint64_t got=(rc>=D)?qc+1:qc;\n            uint64_t want=(u1*B+u0)/D;\n            if (got!=want) {\n                if (!mismatches) { first_u1=u1; first_u0=u0; first_w=want; first_g=got; }\n                ++mismatches;\n            }\n        }\n    }\n    printf(\"mismatches=%llu first=(%llu,%llu) want=%llu got=%llu\\n\",(unsigned long long)mismatches,(unsigned long long)first_u1,(unsigned long long)first_u0,(unsigned long long)first_w,(unsigned long long)first_g);\n    return 0;\n}\nEOF\ncc -O3 -o /tmp/check /tmp/check.c && /tmp/check\n"]
