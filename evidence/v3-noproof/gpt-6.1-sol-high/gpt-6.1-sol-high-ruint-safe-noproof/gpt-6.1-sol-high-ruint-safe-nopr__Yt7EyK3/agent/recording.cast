[128.379472, "i", "python3 - <<'PY'\nD = 0x8003\nB = 1 << 16\nV = ((B * B - 1) // D) - B\nprint('D', D, 'B', B, 'V', V, hex(V))\n\ndef impl(u1, u0):\n    q_full = (u1 * 0xFFF4) + (u1 << 16) + u0 + (1 << 16)\n    q1 = q_full >> 16\n    q0 = q_full & 0xffff\n    r = (0xC0000000 + u0 - q1 * D) & 0xffff\n    if q0 < r:\n        q_corr, r_corr = q1 - 1, (r + D) & 0xffff\n    else:\n        q_corr, r_corr = q1, r\n    return q_corr + 1 if r_corr >= D else q_corr\n\nfor u1 in [0,1,2,3, D-2, D-1, D]:\n    for u0 in [0,1,D-1,D,B-2,B-1]:\n        if 0 <= u1 < D and 0 <= u0 < B:\n            want = (u1*B+u0)//D\n            got = impl(u1,u0)\n            print(u1,u0,want,got,'OK' if want==got else 'BAD')\nPY\n"]
