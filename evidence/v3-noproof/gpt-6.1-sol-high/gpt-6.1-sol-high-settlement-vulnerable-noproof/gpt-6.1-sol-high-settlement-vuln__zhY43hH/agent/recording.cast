[151.077086, "o", "    let values = [0, 1, 9, 10, 9_998, 9_999, 10_000, 10_001,\r\n\u001b[?2004l\r\u001b[?2004h>                   99_990, 99_991, 100_000, u64::MAX / 2,\r\n\u001b[?2004l\r\u001b[?2004h>                   u64::MAX - 10_000, u64::MAX - 9_999,\r\n\u001b[?2004l\r\u001b[?2004h>                   u64::MAX - 1_616, u64::MAX - 1_615, u64::MAX - 1, u64::MAX];\r\n\u001b[?2004l\r\u001b[?2004h>     for amount in values { for fee in values { check_pair(amount, fee); } }\r\n\u001b[?2004l\r\u001b[?2004h> "]
