[85.912356, "i", "cat > /tmp/original_witness.rs <<'EOF'\n#[path = \"/workspace/challenge/src/lib.rs\"]\nmod settlement;\nfn main() {\n    let balance = 1_660_206_966_633_859u64;\n    let amount = 0u64;\n    let fee = 18_446_744_073_709_549_999u64;\n    let result = settlement::authorize(balance, amount, fee);\n    println!(\"Original authorization: {:?}\", result);\n    assert_eq!(result.unwrap().total_debit, balance);\n}\nEOF\nrustc --edition=2021 -O -C overflow-checks=off /tmp/original_witness.rs -o /tmp/original_witness && /tmp/original_witness\npython3 - <<'PY'\nbalance = 1660206966633859\namount = 0\nfee = 18446744073709549999\ngross = (amount + fee + 9999) // 10000\nrebate = gross // 10\ndebit = amount + gross - rebate\nprint({'balance': balance, 'amount': amount, 'fee': fee, 'gross_fee': gross, 'rebate': rebate, 'exact_debit': debit})\nassert debit > balance\nassert all(0 <= n < 2**64 for n in (balance, amount, fee))\nPY\n"]
