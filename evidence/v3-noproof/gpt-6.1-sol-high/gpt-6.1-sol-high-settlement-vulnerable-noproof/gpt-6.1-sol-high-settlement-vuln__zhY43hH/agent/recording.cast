[150.446618, "o", "\u001b[?2004hroot@b61f55a42c8d:/workspace/challenge# "]
[151.068023, "i", "cat > /tmp/repair_oracle.rs <<'EOF'\n#[path = \"/workspace/submission/src/lib.rs\"]\nmod settlement;\nfn check(balance: u64, amount: u64, fee: u64) {\n    let gross = (amount as u128 + fee as u128 + 9_999) / 10_000;\n    let debit = amount as u128 + gross - gross / 10;\n    let expected = if debit <= balance as u128 {\n        Some(settlement::Authorization { total_debit: debit as u64 })\n    } else {\n        None\n    };\n    assert_eq!(settlement::authorize(balance, amount, fee), expected,\n               \"balance={balance}, amount={amount}, fee={fee}, exact debit={debit}\");\n}\nfn check_pair(amount: u64, fee: u64) {\n    let gross = (amount as u128 + fee as u128 + 9_999) / 10_000;\n    let debit = amount as u128 + gross - gross / 10;\n    check(0, amount, fee);\n    check(u64::MAX, amount, fee);\n    if debit <= u64::MAX as u128 {\n        let d = debit as u64;\n        check(d, amount, fee);\n        if d > 0 { check(d - 1, amount, fee); }\n        if d < u64::MAX { check(d + 1, amount, fee); }\n    }\n}\nfn next(state: &mut u64) -> u64 {\n    *state ^= *state << 13;\n    *state ^= *state >> 7;\n    *state ^= *state << 17;\n    *state\n}\nfn main() {\n    let values = [0, 1, 9, 10, 9_998, 9_999, 10_000, 10_001,\n                  99_990, 99_991, 100_000, u64::MAX / 2,\n                  u64::MAX - 10_000, u64::MAX - 9_999,\n                  u64::MAX - 1_616, u64::MAX - 1_615, u64::MAX - 1, u64::MAX];\n    for amount in values { for fee in values { check_pair(amount, fee); } }\n    for offset in 0..30_000u64 {\n        check_pair(0, u64::MAX - offset);\n        check_pair(offset, u64::MAX);\n        check_pair(u64::MAX - offset, offset);\n    }\n    let mut state = 0x123456789abcdefu64;\n    for _ in 0..200_000 {\n        let amount = next(&mut state);\n        let fee = next(&mut state);\n        check_pair(amount, fee);\n        check(next(&mut state), amount, fee);\n    }\n    println!(\"Independent exact-integer oracle: all boundary and randomized checks passed\");\n}\nEOF\nrustc --edition=2021 -O -C overflow-checks=off /tmp/repair_oracle.rs -o /tmp/repair_oracle && /tmp/repair_oracle\nfind /workspace/submission -type f -print; cat /workspace/submission/verdict.txt /workspace/submission/counterexample.json; diff -u /workspace/challenge/src/lib.rs /workspace/submission/src/lib.rs\n"]
[151.06844, "o", "cat > /tmp/repair_oracle.rs <<'EOF'"]
