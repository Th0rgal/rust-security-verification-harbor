[461.097753, "i", "python3 - <<'PY'\nimport random\nU=1<<64\nD=10000\nB=D-1\nQ=U//D\nR=U%D\n\ndef repaired_ceil(a,f):\n    low=(a+f)&(U-1)\n    wrapped=low<a\n    if wrapped:\n        rem=(low%D)+R\n        return Q+(low//D)+((rem+B)//D)\n    biased=(low+B)&(U-1)\n    if biased<low:\n        return low//D + (0 if low%D==0 else 1)\n    return biased//D\n\nvals=[0,1,2,9998,9999,10000,10001,Q,Q+1,U-21615,U-10000,U-9999,U-9998,U-2,U-1]\nfor a in vals:\n    for f in vals:\n        assert repaired_ceil(a,f)==((a+f+B)//D), (a,f,repaired_ceil(a,f),(a+f+B)//D)\nfor _ in range(300000):\n    a=random.randrange(U); f=random.randrange(U)\n    got=repaired_ceil(a,f)\n    want=(a+f+B)//D\n    assert got==want, (a,f,got,want)\nprint('repaired arithmetic differential verification passed: boundaries and 300000 random pairs')\nPY\n"]
