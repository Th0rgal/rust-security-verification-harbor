[403.384141, "o", "    #[inline]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.38435, "o", "    pub fn ceil_div_bps_folded(fold: SumFold) -> u64 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.38447, "o", "> "]
[403.384507, "o", "        if fold.wrapped_u64 {\r\n\u001b[?2004l\r"]
[403.384538, "o", "\u001b[?2004h> "]
[403.384907, "o", "            let folded_rem = (fold.low_word % BPS_DENOM) + U64_MOD_BPS_REM;\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.384955, "o", "> "]
[403.385614, "o", "            U64_MOD_BPS_QUOT + (fold.low_word / BPS_DENOM) + ((folded_rem + BPS_MAX_REM) / BPS_DENOM)\r\n\u001b[?2004l\r\u001b[?2004h>         } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.385859, "o", "            let biased = fold.low_word.wrapping_add(BPS_MAX_REM);\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.3859, "o", "> "]
[403.386077, "o", "            if biased < fold.low_word {\r\n\u001b[?2004l\r"]
[403.386115, "o", "\u001b[?2004h> "]
[403.386445, "o", "                // The bias addition overflowed.  The original sum is the\r\n\u001b[?2004l\r"]
[403.386482, "o", "\u001b[?2004h> "]
[403.386802, "o", "                // non-wrapped low word itself, so compute its ceiling\r\n\u001b[?2004l\r"]
[403.386842, "o", "\u001b[?2004h> "]
[403.387162, "o", "                // directly instead of trying to use the wrapped bias.\r\n\u001b[?2004l\r"]
[403.387199, "o", "\u001b[?2004h> "]
[403.387397, "o", "                (fold.low_word / BPS_DENOM)\r\n\u001b[?2004l\r"]
[403.387434, "o", "\u001b[?2004h> "]
[403.387771, "o", "                    + if fold.low_word % BPS_DENOM == 0 { 0 } else { 1 }\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.387808, "o", "> "]
[403.38796, "o", "            } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.388096, "o", "                biased / BPS_DENOM\r\n\u001b[?2004l\r"]
[403.388178, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[403.388214, "o", "\u001b[?2004h> "]
[403.388386, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.388435, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.388574, "o", "pub mod rebate {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.388699, "o", "    use crate::constants::*;\r\n\u001b[?2004l\r"]
[403.388743, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.388992, "o", "    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n\u001b[?2004l\r"]
[403.389031, "o", "\u001b[?2004h> "]
[403.389157, "o", "    pub struct FeeBreakdown {\r\n\u001b[?2004l\r"]
[403.389194, "o", "\u001b[?2004h> "]
[403.389336, "o", "        pub gross_fee: u64,\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.389375, "o", "> "]
[403.389475, "o", "        pub rebate: u64,\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.389511, "o", "> "]
[403.389632, "o", "        pub net_fee: u64,\r\n\u001b[?2004l\r"]
[403.389669, "o", "\u001b[?2004h> "]
[403.389696, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.389733, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[403.389764, "o", "> "]
[403.390172, "o", "    /// Computes the floor tier rebate `floor(gross_fee / 10)` in favor of the protocol.\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.390211, "o", "> "]
[403.390292, "o", "    #[inline]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.390548, "o", "    pub fn tier_rebate_floor(gross_fee: u64) -> u64 {\r\n\u001b[?2004l\r"]
[403.390584, "o", "\u001b[?2004h> "]
[403.390747, "o", "        gross_fee / REBATE_DIVISOR\r\n\u001b[?2004l\r"]
[403.390782, "o", "\u001b[?2004h>     }\r\n"]
[403.39081, "o", "\u001b[?2004l\r\u001b[?2004h"]
[403.390837, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[403.390866, "o", "> "]
[403.391296, "o", "    /// Assembles the gross fee, floor rebate, and net settlement fee `gross_fee - rebate`.\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.391334, "o", "> "]
[403.391421, "o", "    #[inline]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.391743, "o", "    pub fn compute_fee_breakdown(gross_fee: u64) -> FeeBreakdown {\r\n\u001b[?2004l\r"]
[403.391782, "o", "\u001b[?2004h> "]
[403.391983, "o", "        let rebate = tier_rebate_floor(gross_fee);\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.392023, "o", "> "]
[403.392178, "o", "        let net_fee = gross_fee - rebate;\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.392215, "o", "> "]
[403.392409, "o", "        FeeBreakdown { gross_fee, rebate, net_fee }\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.392451, "o", ">     }\r\n\u001b[?2004l\r"]
[403.39248, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[403.392512, "o", "\u001b[?2004h> "]
[403.392874, "o", "    /// Diagnostic helper checking whether a fee breakdown qualifies as high-volume.\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.392912, "o", "> "]
[403.39294, "o", "    #[inline]\r\n\u001b[?2004l\r"]
[403.392968, "o", "\u001b[?2004h> "]
[403.393246, "o", "    pub fn is_high_volume_levy(breakdown: FeeBreakdown) -> bool {\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.393287, "o", "> "]
[403.393479, "o", "        breakdown.gross_fee >= HIGH_VALUE_THRESHOLD\r\n\u001b[?2004l\r"]
[403.393519, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[403.39355, "o", "\u001b[?2004h> "]
[403.39358, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.393616, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[403.393651, "o", "> "]
[403.39393, "o", "pub mod quote {\r\n\u001b[?2004l\r\u001b[?2004h>     use crate::Authorization;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.394052, "o", "    use crate::rebate::FeeBreakdown;\r\n\u001b[?2004l\r"]
[403.394089, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.39431, "o", "    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n\u001b[?2004l\r"]
[403.394349, "o", "\u001b[?2004h> "]
[403.394492, "o", "    pub struct SettlementQuote {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.394623, "o", "        pub principal: u64,\r\n\u001b[?2004l\r"]
[403.394659, "o", "\u001b[?2004h> "]
[403.394803, "o", "        pub net_fee: u64,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.394911, "o", "        pub total_debit: u64,\r\n\u001b[?2004l\r"]
[403.394949, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[403.394978, "o", "\u001b[?2004h> "]
[403.395015, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.395369, "o", "    /// Combines the payment principal `amount` with `breakdown.net_fee`, rejecting\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.395408, "o", "> "]
[403.395646, "o", "    /// if the resulting settlement debit exceeds `u64::MAX`.\r\n\u001b[?2004l\r"]
[403.395686, "o", "\u001b[?2004h> "]
[403.395833, "o", "    #[inline]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.396198, "o", "    pub fn build_settlement_quote(amount: u64, breakdown: FeeBreakdown) -> Option<SettlementQuote> {\r\n\u001b[?2004l\r"]
[403.396285, "o", "\u001b[?2004h> "]
[403.396484, "o", "        let total_debit = amount.checked_add(breakdown.net_fee)?;\r\n\u001b[?2004l\r"]
[403.396519, "o", "\u001b[?2004h> "]
[403.396673, "o", "        Some(SettlementQuote {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.396801, "o", "            principal: amount,\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.39684, "o", "> "]
[403.396991, "o", "            net_fee: breakdown.net_fee,\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.397075, "o", "> "]
[403.39711, "o", "            total_debit,\r\n\u001b[?2004l\r"]
[403.397139, "o", "\u001b[?2004h> "]
[403.397347, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.397631, "o", "    /// Authorizes the settlement quote iff `quote.total_debit <= balance`.\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.397682, "o", "> "]
[403.397713, "o", "    #[inline]\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.397747, "o", "> "]
[403.398123, "o", "    pub fn verify_affordability(balance: u64, quote: SettlementQuote) -> Option<Authorization> {\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.398161, "o", "> "]
[403.398315, "o", "        if quote.total_debit <= balance {\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.398354, "o", "> "]
[403.398618, "o", "            Some(Authorization { total_debit: quote.total_debit })\r\n\u001b[?2004l\r"]
[403.398655, "o", "\u001b[?2004h> "]
[403.398804, "o", "        } else {\r\n\u001b[?2004l\r\u001b[?2004h>             None\r\n"]
[403.398842, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[403.398925, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.399041, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.399374, "o", "/// Authorize a liquidity transfer in pure `u64` arithmetic before settlement.\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.399458, "o", "> ///\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.399731, "o", "/// Policy over exact unbounded integers (`balance`, `amount`, `fee`):\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.399779, "o", "> "]
[403.400069, "o", "/// 1. The gross protocol fee is the combined basis `amount + fee` divided by\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.400104, "o", "> "]
[403.400402, "o", "///    `BPS_DENOM` (`10_000`), rounded up (`ceil((amount + fee) / 10_000)`).\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.400438, "o", "> "]
[403.40073, "o", "/// 2. The tier rebate is `gross_fee` divided by `REBATE_DIVISOR` (`10`),\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.400768, "o", "> "]
[403.400943, "o", "///    rounded down (`floor(gross_fee / 10)`).\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.40098, "o", "> "]
[403.401246, "o", "/// 3. The net settlement debit is `amount + (gross_fee - rebate)`.\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.401283, "o", "> ///\r\n\u001b[?2004l\r"]
[403.401311, "o", "\u001b[?2004h> "]
[403.401634, "o", "/// Authorize every affordable transfer (`total_debit <= balance`) and return\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.401672, "o", "> "]
[403.401983, "o", "/// the exact net settlement debit; reject every unaffordable transfer (`None`).\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.402022, "o", "> "]
[403.402311, "o", "/// Target word constraint: production code must use `u64` only (no `u128`).\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.402349, "o", "> "]
[403.402671, "o", "pub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.40271, "o", "> "]
[403.402905, "o", "    let fold = bps_math::fold_u64_sum(amount, fee);\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.402942, "o", "> "]
[403.403162, "o", "    let gross_fee = bps_math::ceil_div_bps_folded(fold);\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.403201, "o", "> "]
[403.403437, "o", "    let breakdown = rebate::compute_fee_breakdown(gross_fee);\r\n\u001b[?2004l\r"]
[403.403474, "o", "\u001b[?2004h> "]
[403.403786, "o", "    let settlement_quote = quote::build_settlement_quote(amount, breakdown)?;\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.403825, "o", "> "]
[403.404048, "o", "    quote::verify_affordability(balance, settlement_quote)\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.404087, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.404116, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[403.404152, "o", "> "]
[403.404355, "o", "#[cfg(test)]\r\n\u001b[?2004l\r\u001b[?2004h> mod tests {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.404443, "o", "    use super::*;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.404569, "o", "    #[test]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.404676, "o", "    fn ordinary_settlement() {\r\n\u001b[?2004l\r"]
[403.40471, "o", "\u001b[?2004h> "]
[403.405047, "o", "        assert_eq!(authorize(100_012, 100_000, 25_000).unwrap().total_debit, 100_012);\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.405088, "o", "> "]
[403.405325, "o", "        assert_eq!(authorize(100_011, 100_000, 25_000), None);\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.405362, "o", ">     }\r\n\u001b[?2004l\r"]
[403.40539, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[403.405424, "o", "\u001b[?2004h> "]
[403.405632, "o", "    #[test]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.40572, "o", "    fn ceiling_rounding_and_rebate() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.405965, "o", "        assert_eq!(authorize(2, 1, 0).unwrap().total_debit, 2);\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.406087, "o", "> "]
[403.406264, "o", "        assert_eq!(authorize(9, 0, 99_991).unwrap().total_debit, 9);\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.40635, "o", "> "]
[403.406495, "o", "        assert_eq!(authorize(8, 0, 99_991), None);\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.406538, "o", ">     }\r\n\u001b[?2004l\r"]
[403.40657, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[403.406609, "o", "\u001b[?2004h> "]
[403.406825, "o", "    #[test]\r\n\u001b[?2004l\r\u001b[?2004h>     fn wide_basis_carry_folding() {\r\n\u001b[?2004l\r"]
[403.406872, "o", "\u001b[?2004h> "]
[403.407052, "o", "        let expected = 1_660_206_966_643_862;\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.407097, "o", "> "]
[403.407429, "o", "        assert_eq!(authorize(expected, 10_000, u64::MAX).unwrap().total_debit, expected);\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.407464, "o", "> "]
[403.407736, "o", "        assert_eq!(authorize(expected - 1, 10_000, u64::MAX), None);\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.407774, "o", ">     }\r\n\u001b[?2004l\r"]
[403.407804, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[403.407837, "o", "\u001b[?2004h> "]
[403.408052, "o", "    #[test]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.408136, "o", "    fn ceiling_bias_wrap_at_u64_max() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.4083, "o", "        let expected = 1_660_206_966_633_861;\r\n\u001b[?2004l\r"]
[403.408337, "o", "\u001b[?2004h> "]
[403.40867, "o", "        assert_eq!(authorize(expected, 0, u64::MAX).unwrap().total_debit, expected);\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.408709, "o", "> "]
[403.408947, "o", "        assert_eq!(authorize(expected - 1, 0, u64::MAX), None);\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.408983, "o", ">     }\r\n\u001b[?2004l\r"]
[403.409011, "o", "\u001b[?2004h> "]
[403.409043, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.409076, "o", "> "]
[403.409106, "o", "    #[test]\r\n\u001b[?2004l\r"]
[403.409136, "o", "\u001b[?2004h> "]
[403.409428, "o", "    fn total_debit_overflow_rejected() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.409566, "o", "        assert_eq!(authorize(u64::MAX, u64::MAX, 1), None);\r\n\u001b[?2004l\r"]
[403.409606, "o", "\u001b[?2004h> "]
[403.409867, "o", "        assert_eq!(authorize(u64::MAX, u64::MAX, u64::MAX), None);\r\n\u001b[?2004l\r"]
[403.409951, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[403.409988, "o", "\u001b[?2004h> "]
[403.410018, "o", "    #[test]\r\n\u001b[?2004l\r"]
[403.410051, "o", "\u001b[?2004h> "]
[403.410283, "o", "    fn floor_div_helper_matches_exact_quotient() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.410607, "o", "        let fold = bps_math::fold_u64_sum(10_000, 18_446_744_073_709_550_000);\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.410646, "o", "> "]
[403.410954, "o", "        assert_eq!(bps_math::floor_div_bps_folded(fold), 1_844_674_407_370_956);\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.410991, "o", ">     }\r\n\u001b[?2004l\r"]
[403.411023, "o", "\u001b[?2004h> }\r\n"]
[403.411052, "o", "\u001b[?2004l\r\u001b[?2004h> "]
