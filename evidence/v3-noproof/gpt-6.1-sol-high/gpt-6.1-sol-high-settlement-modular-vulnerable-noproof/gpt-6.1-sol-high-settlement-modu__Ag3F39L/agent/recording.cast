[275.034539, "o", "\u001b[?2004hroot@62135d6401cf:/workspace/challenge# "]
[276.624929, "i", "python3 - <<'PY'\nimport random\nU=(1<<64)\nD=10000\nQ=U//D\nR=U%D\n\ndef folded_ceil(a,f):\n    low=(a+f)&(U-1)\n    wrapped=low<a\n    if wrapped:\n        folded_rem=(low%D)+R\n        return Q+(low//D)+((folded_rem+D-1)//D)\n    biased=(low+(D-1))&(U-1)\n    if biased<low:\n        return (low//D)+((biased+R)//D)\n    return biased//D\n\ndef rust_policy(b,a,f):\n    gross=folded_ceil(a,f)\n    net=gross-gross//10\n    total=a+net\n    return total if total<=b and total < U else None\n\ndef exact_policy(b,a,f):\n    gross=((a+f)+D-1)//D\n    net=gross-gross//10\n    total=a+net\n    return total if total<=b and total<U else None\n\nvals=[0,1,2,9,10,9998,9999,10000,10001,1844674407370955,1844674407370956,(1<<64)-10000,(1<<64)-9999,(1<<64)-9998,(1<<64)-2,(1<<64)-1]\nfor a in vals:\n  for f in vals:\n    assert folded_ceil(a,f)==((a+f+D-1)//D), (a,f,folded_ceil(a,f),((a+f+D-1)//D))\nfor _ in range(200000):\n    a=random.randrange(U); f=random.randrange(U); b=random.randrange(U)\n    assert rust_policy(b,a,f)==exact_policy(b,a,f), (b,a,f,rust_policy(b,a,f),exact_policy(b,a,f))\nprint('differential verification passed: boundary cases and 200000 random u64 triples')\nPY\n"]
[276.625381, "o", "python3 - <<'PY'"]
