[?2004l[?2004h> /// Authorize a liquidity transfer in pure `u64` arithmetic before settlement.
[?2004l[?2004h> ///
[?2004l[?2004h> /// Policy over exact unbounded integers (`balance`, `amount`, `fee`):
[?2004l[?2004h> /// 1. The gross protocol fee is the combined basis `amount + fee` divided by
[?2004l[?2004h> ///    `BPS_DENOM` (`10_000`), rounded up (`ceil((amount + fee) / 10_000)`).
[?2004l[?2004h> /// 2. The tier rebate is `gross_fee` divided by `REBATE_DIVISOR` (`10`),
[?2004l[?2004h> ///    rounded down (`floor(gross_fee / 10)`).
[?2004l[?2004h> /// 3. The net settlement debit is `amount + (gross_fee - rebate)`.
[?2004l[?2004h> ///
[?2004l[?2004h> /// Authorize every affordable transfer (`total_debit <= balance`) and return
[?2004l[?2004h> /// the exact net settlement debit; reject every unaffordable transfer (`None`).
[?2004l[?2004h> /// Target word constraint: production code must use `u64` only (no `u128`).
[?2004l[?2004h> pub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {
[?2004l[?2004h>     let fold = bps_math::fold_u64_sum(amount, fee);
[?2004l[?2004h>     let gross_fee = bps_math::ceil_div_bps_folded(fold);
[?2004l[?2004h>     let breakdown = rebate::compute_fee_breakdown(gross_fee);
[?2004l[?2004h>     let settlement_quote = quote::build_settlement_quote(amount, breakdown)?;
[?2004l[?2004h>     quote::verify_affordability(balance, settlement_quote)
[?2004l[?2004h> }
