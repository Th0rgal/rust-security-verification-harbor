[374.263064, "i", "cat > /tmp/check_authorization.rs <<'RS'\ninclude!(\"/workspace/challenge/src/lib.rs\");\n\nfn exact_debit(amount: u64, fee: u64) -> u128 {\n    let numerator = (amount as u128) + ((fee as u128) << 64);\n    let gross_fee = numerator / 1_000_000 + if numerator % 1_000_000 != 0 { 1 } else { 0 };\n    (amount / 2) as u128 + gross_fee\n}\n\nfn check(balance: u64, amount: u64, fee: u64) {\n    let debit = exact_debit(amount, fee);\n    let expected = if debit <= balance as u128 {\n        Some(Authorization { total_debit: debit as u64 })\n    } else {\n        None\n    };\n    assert_eq!(authorize(balance, amount, fee), expected,\n        \"balance={balance}, amount={amount}, fee={fee}, exact={debit}\");\n    let gross = debit - (amount / 2) as u128;\n    let expected_fee = if gross <= u64::MAX as u128 { Some(gross as u64) } else { None };\n    assert_eq!(u128_math::div_round_up_fee(amount, fee), expected_fee);\n}\n\nfn random(state: &mut u64) -> u64 {\n    *state ^= *state << 13;\n    *state ^= *state >> 7;\n    *state ^= *state << 17;\n    *state\n}\n\nfn main() {\n    let values = [0, 1, 2, 3, 999_999, 1_000_000, 1_000_001,\n        (1u64 << 32) - 1, 1u64 << 32, (1u64 << 32) + 1,\n        4_294_967_295_000_000, 4_294_967_295_000_001,\n        u64::MAX / 2, u64::MAX - 1, u64::MAX];\n    let mut checks = 0;\n    for amount in values {\n        for fee in values {\n            for balance in values {\n                check(balance, amount, fee);\n                checks += 1;\n            }\n            let debit = exact_debit(amount, fee);\n            if debit <= u64::MAX as u128 {\n                let debit = debit as u64;\n                check(debit, amount, fee);\n                if debit > 0 { check(debit - 1, amount, fee); }\n                if debit < u64::MAX { check(debit + 1, amount, fee); }\n            }\n        }\n    }\n    let mut state = 0x7dca_519b_efa3_6021;\n    for i in 0..1_000_000 {\n        let amount = random(&mut state);\n        let fee_sample = random(&mut state);\n        let fee = if i % 2 == 0 { fee_sample % 1_000_001 } else { fee_sample };\n        let balance = random(&mut state);\n        check(balance, amount, fee);\n        let debit = exact_debit(amount, fee);\n        if debit <= u64::MAX as u128 {\n            let debit = debit as u64;\n            check(debit, amount, fee);\n            if debit > 0 { check(debit - 1, amount, fee); }\n        }\n        checks += 1;\n    }\n    println!(\"Passed {checks} boundary/random cases plus exact-affordability boundary checks.\");\n}\nRS\nrustc --edition=2021 -O -C overflow-checks=off /tmp/check_authorization.rs -o /tmp/check_authorization && /tmp/check_authorization\n"]
[374.264683, "o", "cat > /tmp/check_authorization.rs <<'RS'"]
