[374.28214, "o", "        let balance = random(&mut state);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.282217, "o", "        check(balance, amount, fee);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.282437, "o", "        let debit = exact_debit(amount, fee);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.28266, "o", "        if debit <= u64::MAX as u128 {\r\n\u001b[?2004l\r"]
[374.282814, "o", "\u001b[?2004h> "]
[374.282905, "o", "            let debit = debit as u64;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.283106, "o", "            check(debit, amount, fee);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.283342, "o", "            if debit > 0 { check(debit - 1, amount, fee); }\r\n\u001b[?2004l\r"]
[374.283491, "o", "\u001b[?2004h> "]
[374.283726, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.283804, "o", "        checks += 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.284055, "o", "    println!(\"Passed {checks} boundary/random cases plus exact-affordability boundary checks.\");\r\n\u001b[?2004l\r"]
[374.284093, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[374.284122, "o", "\u001b[?2004h> "]
[374.284157, "o", "RS\r\n\u001b[?2004l\r"]
[374.285815, "o", "\u001b[?2004hroot@9ed9c222c234:/workspace/challenge# "]
[374.286329, "o", "rustc --edition=2021 -O -C overflow-checks=off /tmp/check_authorization.rs -o /tmp/check_authorization && /tmp/check_authorization\r\n\u001b[?2004l\r"]
[374.608081, "o", "Passed 1003375 boundary/random cases plus exact-affordability boundary checks.\r\n"]
[374.608415, "o", "\u001b[?2004hroot@9ed9c222c234:/workspace/challenge# "]
[375.245589, "i", "python3 - <<'PY'\nB = 2**32\nD = 1_000_000\nM = 2**64 - 1\nprint('Maximum div_step numerator:', D*B-1, '<=', M)\nassert D*B-1 <= M\nassert (D*B-1)//D == B-1\nprint('Maximum lower-limb rounding sum:', B, '<=', M)\nassert B <= M\nprint('Maximum highest quotient limb:', (B-1)//D)\nassert (B-1)//D + 1 < B\nprint('Maximum converted u64:', (B-1)*B+(B-1))\nassert (B-1)*B+(B-1) == M\nprint('All required no-overflow bounds verified.')\nPY\n"]
