[70.187194, "o", "\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K8\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kpub struct \u001b[01;31m\u001b[KAuthorization\u001b[m\u001b[K {\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K9\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    pub \u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K: u64,\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K242\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    use crate::\u001b[01;31m\u001b[KAuthorization\u001b[m\u001b[K;\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K252\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        pub \u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K: u64,\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K259\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        let \u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K = amount.checked_add(fee_quote.net_fee)?;\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K265\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K,\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K279\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    /// `ticket.\u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K <= balance`.\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K281\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    pub fn commit_ticket(balance: u64, ticket: SettlementTicket) -> Option<\u001b[01;31m\u001b[KAuthorization\u001b[m\u001b[K> {\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K282\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if ticket.\u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K <= balance {\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K283\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            Some(\u001b[01;31m\u001b[KAuthorization\u001b[m\u001b[K {\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K284\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K: ticket.\u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K,\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K292\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    /// when \u001b[01;31m\u001b[Kaffordable\u001b[m\u001b[K, saturating at zero for telemetry.\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K295\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        balance.saturating_sub(ticket.\u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K)\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K308\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/// Authorize every \u001b[01;31m\u001b[Kaffordable\u001b[m\u001b[K transfer (`\u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K <= balance`) and return\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K309\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/// the exact net settlement debit; reject every \u001b[01;31m\u001b[Kunaffordable\u001b[m\u001b[K transfer (`None`).\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K311\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kpub fn \u001b[01;31m\u001b[Kauthorize\u001b[m\u001b[K(balance: u64, amount: u64, fee: u64) -> Option<\u001b[01;31m\u001b[KAuthorization\u001b[m\u001b[K> {\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K322\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(\u001b[01;31m\u001b[Kauthorize\u001b[m\u001b[K(100_012, 100_000, 25_000).unwrap().\u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K, 100_012);\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K323\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(\u001b[01;31m\u001b[Kauthorize\u001b[m\u001b[K(100_011, 100_000, 25_000), None);\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K328\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(\u001b[01;31m\u001b[Kauthorize\u001b[m\u001b[K(2, 1, 0).unwrap().\u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K, 2);\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K329\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(\u001b[01;31m\u001b[Kauthorize\u001b[m\u001b[K(9, 0, 99_991).unwrap().\u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K, 9);\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K330\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(\u001b[01;31m\u001b[Kauthorize\u001b[m\u001b[K(8, 0, 99_991), None);\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K336\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(\u001b[01;31m\u001b[Kauthorize\u001b[m\u001b[K(expected, 10_000, u64::MAX).unwrap().\u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K, expected);\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K337\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(\u001b[01;31m\u001b[Kauthorize\u001b[m\u001b[K(expected - 1, 10_000, u64::MAX), None);\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K343\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(\u001b[01;31m\u001b[Kauthorize\u001b[m\u001b[K(expected, 0, u64::MAX).unwrap().\u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K, expected);\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K344\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(\u001b[01;31m\u001b[Kauthorize\u001b[m\u001b[K(expected - 1, 0, u64::MAX), None);\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K348\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fn \u001b[01;31m\u001b[Ktotal_debit\u001b[m\u001b[K_overflow_rejected() {\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K349\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(\u001b[01;31m\u001b["]
[70.187436, "o", "Kauthorize\u001b[m\u001b[K(u64::MAX, u64::MAX, 1), None);\r\n\u001b[35m\u001b[K./src/lib.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K350\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(\u001b[01;31m\u001b[Kauthorize\u001b[m\u001b[K(u64::MAX, u64::MAX, u64::MAX), None);\r\n\u001b[?2004hroot@2d24cb1395e3:/workspace/challenge# "]
[172.064665, "i", "cd /workspace/challenge && mkdir -p src/bin && cat > src/bin/audit_check.rs <<'RS'\nuse settlement_gate::authorize;\n\nfn check(balance: u64, amount: u64, fee: u64) {\n    let n = amount as u128 + fee as u128;\n    let gross = (n + 9_999) / 10_000;\n    let net = gross - gross / 10;\n    let debit = amount as u128 + net;\n    let expected = if debit <= balance as u128 { Some(debit as u64) } else { None };\n    let actual = authorize(balance, amount, fee).map(|x| x.total_debit);\n    assert_eq!(actual, expected, \"mismatch for balance={balance}, amount={amount}, fee={fee}; exact debit={debit}\");\n}\n\nfn main() {\n    let m = u64::MAX;\n    let mut vals = vec![0, 1, 2, 3, 9, 10, 11, 9_999, 10_000, 10_001, 99_990, 99_991, 99_999, 100_000, m - 10_000, m - 9_999, m - 2_500, m - 1, m];\n    for k in 0..=20u64 {\n        vals.push(k * 10_000);\n        vals.push(k * 10_000 + 1);\n        vals.push(k * 10_000 + 9_999);\n    }\n    for &b in &vals { for &a in &vals { for &f in &vals { check(b, a, f); } } }\n    let mut x = 0x9e3779b97f4a7c15u64;\n    for _ in 0..2_000_000 {\n        x = x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n        let b = x;\n        x = x.rotate_left(17).wrapping_mul(2862933555777941757).wrapping_add(3037000493);\n        let a = x;\n        x = x.rotate_left(29).wrapping_mul(3202034522624059733).wrapping_add(1);\n        let f = x;\n        check(b, a, f);\n    }\n    println!(\"differential checks passed\");\n}\nRS\ncargo run --release --bin audit_check\nrm -f src/bin/audit_check.rs\nrmdir src/bin 2>/dev/null || true\n"]
[172.066153, "o", "cd /workspace/challenge && mkdir -p src/bin && cat > src/bin/audit_check.rs <<'RS'"]
