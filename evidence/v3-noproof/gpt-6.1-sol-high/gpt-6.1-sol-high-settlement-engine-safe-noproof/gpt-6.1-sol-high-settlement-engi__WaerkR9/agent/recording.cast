[42.11934, "o", "\r\n   217\t            U64_MOD_FLASH_QUOT + (sum.low_word / FLASH_DENOM) + ((folded_rem + FLASH_MAX_REM) / FLASH_DENOM)\r\n   218\t        } else {\r\n   219\t            let biased = sum.low_word.wrapping_add(FLASH_MAX_REM);\r\n   220\t            if biased < sum.low_word {\r\n   221\t                (sum.low_word / FLASH_DENOM) + (((sum.low_word % FLASH_DENOM) + FLASH_MAX_REM) / FLASH_DENOM)"]
[42.119714, "o", "\r\n   222\t            } else {\r\n   223\t                biased / FLASH_DENOM\r\n   224\t            }\r\n   225\t        }\r\n   226"]
[42.119946, "o", "\t    }\r\n   227\t\r\n   228\t    /// Builds a flash-loan repayment receipt if `principal + flash_levy` fits in `u64`.\r\n"]
[42.120178, "o", "   229\t    #[inline]\r\n   230\t    pub fn quote_flash_repayment(principal: u64, surcharge: u64) -> Option<FlashLoanReceipt> {\r\n   231\t        let flash_levy = assess_flash_fee_ceil(principal, surcharge);\r\n   232\t        let total_repayment = principal.checked_add(flash_levy)?;\r\n"]
