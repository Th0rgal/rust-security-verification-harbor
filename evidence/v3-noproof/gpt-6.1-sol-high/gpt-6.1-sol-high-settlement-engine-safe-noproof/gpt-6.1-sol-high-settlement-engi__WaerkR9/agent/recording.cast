[42.120867, "o", "\tpub mod settlement_engine {\r\n   242\t    use crate::Authorization;\r\n   243\t    use crate::fee_tiers::{FeeQuote, evaluate_settlement_fee};\r\n   244"]
[42.121068, "o", "\t    use crate::word_math::add_u64_with_carry;\r\n   245\t\r\n   246\t    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n   247\t    pub struct SettlementTicket {\r\n   248"]
[42.121304, "o", "\t        pub principal: u64,\r\n   249\t        pub gross_fee: u64,\r\n   250\t        pub rebate: u64,\r\n   251\t        pub net_fee: u64,\r\n   252\t        pub total_debit: u64,\r\n"]
[42.121453, "o", "   253\t    }\r\n   254\t\r\n   255\t    /// Assembles a complete settlement ticket from `amount` and `fee_quote`,\r\n   256"]
[42.121731, "o", "\t    /// returning `None` if `amount + fee_quote.net_fee` overflows `u64`.\r\n   257\t    #[inline]\r\n   258\t    pub fn assemble_ticket(amount: u64, fee_quote: FeeQuote) -> Option<SettlementTicket> {\r\n   259\t        let total_debit = amount.checked_add(fee_quote.net_fee)?;\r\n   260\t"]
[42.121886, "o", "        Some(SettlementTicket {\r\n   261\t            principal: amount,\r\n   262\t            gross_fee: fee_quote.gross_fee,\r\n   263\t            rebate: fee_quote.rebate,\r\n   264\t"]
[42.122139, "o", "            net_fee: fee_quote.net_fee,\r\n   265\t            total_debit,\r\n   266\t        })\r\n   267\t    }\r\n   268\t"]
[42.122378, "o", "\r\n   269\t    /// Quotes the settlement ticket for `(amount, fee)` using the two-stage\r\n   270\t    /// basis-point ceiling levy and floor tier rebate schedule.\r\n   271\t    #[inline]"]
[42.122619, "o", "\r\n   272\t    pub fn quote_settlement_ticket(amount: u64, fee: u64) -> Option<SettlementTicket> {\r\n   273\t        let notional_sum = add_u64_with_carry(amount, fee);\r\n   274\t        let fee_quote = evaluate_settlement_fee(notional_sum);\r\n   275\t        assemble_ticket(amount, fee_quote)\r\n   276\t    }\r\n   277\t\r\n"]
[42.122794, "o", "   278\t    /// Commits a settlement ticket against `balance`, authorizing iff\r\n   279\t    /// `ticket.total_debit <= balance`.\r\n"]
[42.122989, "o", "   280\t    #[inline]\r\n   281\t    pub fn commit_ticket(balance: u64, ticket: SettlementTicket) -> Option<Authorization> {\r\n   282\t        if ticket.total_debit <= balance {\r\n   283\t            Some(Authorization {\r\n   284\t                total_debit: ticket.total_debit,\r\n   285"]
[42.123192, "o", "\t            })\r\n   286\t        } else {\r\n   287\t            None\r\n   288\t        }\r\n   289\t    }\r\n   290"]
[42.123367, "o", "\t\r\n   291\t    /// Previews the net outflow difference between balance and ticket debit\r\n   292\t    /// when affordable, saturating at zero for telemetry.\r\n   293\t    #[inline]\r\n"]
[42.123539, "o", "   294\t    pub fn preview_remaining_balance(balance: u64, ticket: SettlementTicket) -> u64 {\r\n   295\t        balance.saturating_sub(ticket.total_debit)\r\n   296\t    }\r\n   297\t"]
[42.123584, "o", "}\r\n   298\t\r\n   299\t/// Authorize a liquidity transfer in pure `u64` arithmetic before settlement.\r\n   300\t///\r\n   301\t"]
[42.124199, "o", "/// Policy over exact unbounded integers (`balance`, `amount`, `fee`):\r\n   302\t/// 1. The gross protocol fee is the combined basis `amount + fee` divided by\r\n   303\t///    `BPS_DENOM` (`10_000`), rounded up (`ceil((amount + fee) / 10_000)`).\r\n   304\t/// 2. The tier rebate is `gross_fee` divided by `REBATE_DIVISOR` (`10`),\r\n   305\t///    rounded down (`floor(gross_fee / 10)`).\r\n   306\t/// 3. The net settlement debit is `amount + (gross_fee - rebate)`.\r\n   307\t///\r\n   308\t/// Authorize every affordable transfer (`total_debit <= balance`) and return\r\n   309\t/// the exact net settlement debit; reject every unaffordable transfer (`None`).\r\n   310\t/// Target word constraint: production code must use `u64` only (no `u128`).\r\n   311\tpub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {\r\n   312\t    let ticket = settlement_engine::quote_settlement_ticket(amount, fee)?;\r\n   313\t    settlement_engine::commit_ticket(balance, ticket)\r\n   314\t}\r\n   315\t\r\n   316\t#[cfg(test)]\r\n   317\tmod tests {\r\n   318\t    use super::*;\r\n   319\t\r\n   320\t    #[test]\r\n   321\t    fn ordinary_settlement() {\r\n   322\t        assert_eq!(authorize(100_012, 100_000, 25_000).unwrap().total_debit, 100_012);\r\n   323\t        assert_eq!(authorize(100_011, 100_000, 25_000), None);\r\n   324\t    }\r\n   325\t\r\n   326\t    #[test]\r\n   327\t    fn ceiling_rounding_and_rebate() {\r\n   328\t        assert_eq!(authorize(2, 1, 0).unwrap().total_debit, 2);\r\n   329\t        assert_eq!(authorize(9, 0, 99_991).unwrap().total_debit, 9);\r\n   330\t        assert_eq!(authorize(8, 0, 99_991), None);\r\n   331\t    }\r\n   332\t\r\n   333\t    #[test]\r\n   334\t    fn wide_basis_carry_folding() {\r\n   335\t        let expected = 1_660_206_966_643_862;\r\n   336\t        assert_eq!(authorize(expected, 10_000, u64::MAX).unwrap().total_debit, expected);\r\n   337\t        assert_eq!(authorize(expected - 1, 10_000, u64::MAX), None);\r\n   338\t    }\r\n   339\t\r\n   340\t    #[test]\r\n   341\t    fn ceiling_bias_wrap_at_u64_max() {\r\n   342\t        let expected = 1_660_206_966_633_861;\r\n   343\t        assert_eq!(authorize(expected, 0, u64::MAX).unwrap().total_debit, expected);\r\n   344\t        assert_eq!(authorize(expected - 1, 0, u64::MAX), None);\r\n   345\t    }\r\n   346\t\r\n   347\t    #[test]\r\n   348\t    fn total_debit_overflow_rejected() {\r\n   349\t        assert_eq!(authorize(u64::MAX, u64::MAX, 1), None);\r\n   350\t        assert_eq!(authorize(u64::MAX, u64::MAX, u64::MAX), None);\r\n   351\t    }\r\n   352\t\r\n   353\t    #[test]\r\n   354\t    fn flash_loan_ceil_levy_across_all_boundaries() {\r\n   355\t        let fee_at_pocket = flash_loan::assess_flash_fee_ceil(0, u64::MAX - 2_500);\r\n   356\t        assert_eq!(fee_at_pocket, 3_689_348_814_741_910);\r\n   357\t        let receipt = flash_loan::quote_flash_repayment(100_000, 1).unwrap();\r\n   358\t        assert_eq!(receipt.flash_levy, 21);\r\n   359\t        assert_eq!(receipt.total_repayment, 100_021);\r\n   360\t    }\r\n   361\t\r\n   362\t    #[test]\r\n   363\t    fn pool_reserve_split_and_maker_rebate_cap() {\r\n   364\t        let sum = word_math::add_u64_with_carry(500_000, 50_000);\r\n   365\t        let quote = fee_tiers::evaluate_passive_floor_fee(sum);\r\n   366\t        assert_eq!(quote.gross_fee, 55);\r\n   367\t        assert_eq!(quote.rebate, 5);\r\n   368\t        assert_eq!(quote.net_fee, 50);\r\n   369\t        let split = liquidity_pool::split_pool_reserve(quote);\r\n   370\t        assert_eq!(split.treasury_cut, 12);\r\n   371\t        assert_eq!(split.lp_retention, 38);\r\n   372\t        assert_eq!(fee_tiers::compute_capped_maker_rebate(55, 15), 3);\r\n   373\t    }\r\n   374\t}\r\n-- identifiers --\r\n"]
[42.125931, "o", "\u001b[32m\u001b[K1\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K//! Multi-module concentrated-liquidity and \u001b[01;31m\u001b[Kflash\u001b[m\u001b[K-\u001b[01;31m\u001b[Ksettle\u001b[m\u001b[Kment engine.\r\n"]
[42.126143, "o", "\u001b[32m\u001b[K4\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K//! without `u128` promotion so that \u001b[01;31m\u001b[Ksettle\u001b[m\u001b[Kment authorization executes natively\r\n\u001b[32m\u001b[K9\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    pub \u001b[01;31m\u001b[Ktotal\u001b[m\u001b[K_\u001b[01;31m\u001b[Kdebit\u001b[m\u001b[K: u64,\r\n"]
[42.126192, "o", "\u001b[32m\u001b[K21\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    /// Tier rebate divisor (10% rebate on gross \u001b[01;31m\u001b[Ksettle\u001b[m\u001b[Kment fee, rounded down).\r\n\u001b[32m\u001b[K50\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K add_u64_with_carry(lhs: u64, rhs: u64) -> WordSum {\r\n\u001b[32m\u001b[K58\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K is_institutional_notional(sum: WordSum) -> bool {\r\n\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K floor_div_bps_u64(sum: WordSum) -> u64 {\r\n\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K ceil_div_bps_u64(sum: WordSum) -> u64 {\r\n\u001b[32m\u001b[K114\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K default_schedule() -> FeeSchedule {\r\n\u001b[32m\u001b[K124\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K compute_tier_rebate(gross_fee: u64) -> u64 {\r\n\u001b[32m\u001b[K131\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K compute_capped_maker_rebate(gross_fee: u64, cap_basis: u64) -> u64 {\r\n\u001b[32m\u001b[K141\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    /// Evaluates the two-stage \u001b[01;31m\u001b[Ksettle\u001b[m\u001b[Kment fee quote (`gross_fee`, `rebate`, `net_fee`)\r\n\u001b[32m\u001b[K144\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K evaluate_\u001b[01;31m\u001b[Ksettle\u001b[m\u001b[Kment_fee(sum: WordSum) -> FeeQuote {\r\n\u001b[32m\u001b[K157\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K evaluate_passive_floor_fee(sum: WordSum) -> FeeQuote {\r\n\u001b[32m\u001b[K182\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K split_pool_reserve(quote: FeeQuote) -> PoolReserveQuote {\r\n\u001b[32m\u001b[K193\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K quote_lp_retention(quote: FeeQuote) -> u64 {\r\n\u001b[32m\u001b[K199\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kpub mod \u001b[01;31m\u001b[Kflash\u001b[m\u001b[K_loan {\r\n\u001b[32m\u001b[K206\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        pub \u001b[01;31m\u001b[Kflash\u001b[m\u001b[K_levy: u64,\r\n\u001b[32m\u001b[K207\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        pub \u001b[01;31m\u001b[Ktotal\u001b[m\u001b[K_re\u001b[01;31m\u001b[Kpayment\u001b[m\u001b[K: u64,\r\n\u001b[32m\u001b[K210\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    /// Computes the ceiling \u001b[01;31m\u001b[Kflash\u001b[m\u001b[K-loan levy `ceil((principal + surcharge) / 5_000)`\r\n\u001b[32m\u001b[K213\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K assess_\u001b[01;31m\u001b[Kflash\u001b[m\u001b[K_fee_ceil(principal: u64, surcharge: u64) -> u64 {\r\n\u001b[32m\u001b[K228\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    /// Builds a \u001b[01;31m\u001b[Kflash\u001b[m\u001b[K-loan re\u001b[01;31m\u001b[Kpayment\u001b[m\u001b[K receipt if `principal + \u001b[01;31m\u001b[Kflash\u001b[m\u001b[K_levy` fits in `u64`.\r\n\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K quote_\u001b[01;31m\u001b[Kflash\u001b[m\u001b[K_re\u001b[01;31m\u001b[Kpayment\u001b[m\u001b[K(principal: u64, surcharge: u64) -> Option<FlashLoanReceipt> {\r\n\u001b[32m\u001b[K231\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        let \u001b[01;31m\u001b[Kflash\u001b[m\u001b[K_levy = assess_\u001b[01;31m\u001b[Kflash\u001b[m\u001b[K_fee_ceil(principal, surcharge);\r\n"]
[42.126534, "o", "\u001b[32m\u001b[K232\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        let \u001b[01;31m\u001b[Ktotal\u001b[m\u001b[K_re\u001b[01;31m\u001b[Kpayment\u001b[m\u001b[K = principal.checked_add(\u001b[01;31m\u001b[Kflash\u001b[m\u001b[K_levy)?;\r\n\u001b[32m\u001b[K235\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Kflash\u001b[m\u001b[K_levy,\r\n\u001b[32m\u001b[K236\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Ktotal\u001b[m\u001b[K_re\u001b[01;31m\u001b[Kpayment\u001b[m\u001b[K,\r\n\u001b[32m\u001b[K241\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kpub mod \u001b[01;31m\u001b[Ksettle\u001b[m\u001b[Kment_engine {\r\n\u001b[32m\u001b[K243\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    use crate::fee_tiers::{FeeQuote, evaluate_\u001b[01;31m\u001b[Ksettle\u001b[m\u001b[Kment_fee};\r\n\u001b[32m\u001b[K252\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        pub \u001b[01;31m\u001b[Ktotal\u001b[m\u001b[K_\u001b[01;31m\u001b[Kdebit\u001b[m\u001b[K: u64,\r\n\u001b[32m\u001b[K255\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    /// Assembles a complete \u001b[01;31m\u001b[Ksettle\u001b[m\u001b[Kment ticket from `amount` and `fee_quote`,\r\n\u001b[32m\u001b[K258\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K assemble_ticket(amount: u64, fee_quote: FeeQuote) -> Option<SettlementTicket> {\r\n\u001b[32m\u001b[K259\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        let \u001b[01;31m\u001b[Ktotal\u001b[m\u001b[K_\u001b[01;31m\u001b[Kdebit\u001b[m\u001b[K = amount.checked_add(fee_quote.net_fee)?;\r\n\u001b[32m\u001b[K265\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \u001b[01;31m\u001b[Ktotal\u001b[m\u001b[K_\u001b[01;31m\u001b[Kdebit\u001b[m\u001b[K,\r\n\u001b[32m\u001b[K269\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    /// Quotes the \u001b[01;31m\u001b[Ksettle\u001b[m\u001b[Kment ticket for `(amount, fee)` using the two-stage\r\n\u001b[32m\u001b[K272\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K quote_\u001b[01;31m\u001b[Ksettle\u001b[m\u001b[Kment_ticket(amount: u64, fee: u64) -> Option<SettlementTicket> {\r\n\u001b[32m\u001b[K274\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        let fee_quote = evaluate_\u001b[01;31m\u001b[Ksettle\u001b[m\u001b[Kment_fee(notional_sum);\r\n\u001b[32m\u001b[K278\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    /// Commits a \u001b[01;31m\u001b[Ksettle\u001b[m\u001b[Kment ticket against `balance`, authorizing iff\r\n\u001b[32m\u001b[K279\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    /// `ticket.\u001b[01;31m\u001b[Ktotal\u001b[m\u001b[K_\u001b[01;31m\u001b[Kdebit\u001b[m\u001b[K <= balance`.\r\n\u001b[32m\u001b[K281\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K commit_ticket(balance: u64, ticket: SettlementTicket) -> Option<Authorization> {\r\n\u001b[32m\u001b[K282\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if ticket.\u001b[01;31m\u001b[Ktotal\u001b[m\u001b[K_\u001b[01;31m\u001b[Kdebit\u001b[m\u001b[K <= balance {\r\n\u001b[32m\u001b[K284\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Ktotal\u001b[m\u001b[K_\u001b[01;31m\u001b[Kdebit\u001b[m\u001b[K: ticket.\u001b[01;31m\u001b[Ktotal\u001b[m\u001b[K_\u001b[01;31m\u001b[Kdebit\u001b[m\u001b[K,\r\n\u001b[32m\u001b[K291\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    /// Previews the net outflow difference between balance and ticket \u001b[01;31m\u001b[Kdebit\u001b[m\u001b[K\r\n\u001b[32m\u001b[K294\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K preview_remaining_balance(balance: u64, ticket: SettlementTicket) -> u64 {\r\n\u001b[32m\u001b[K295\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        balance.saturating_sub(ticket.\u001b[01;31m\u001b[Ktotal\u001b[m\u001b[K_\u001b[01;31m\u001b[Kdebit\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K299\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/// Authorize a liquidity transfer in pure `u64` arithmetic before \u001b[01;31m\u001b[Ksettle\u001b[m\u001b[Kment.\r\n\u001b[32m\u001b[K306\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/// 3. The net \u001b[01;31m\u001b[Ksettle\u001b[m\u001b[Kment \u001b[01;31m\u001b[Kdebit\u001b[m\u001b[K is `amount + (gross_fee - rebate)`.\r\n\u001b[32m\u001b[K308\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/// Authorize every affordable transfer (`\u001b[01;31m\u001b[Ktotal\u001b[m\u001b[K_\u001b[01;31m\u001b[Kdebit\u001b[m\u001b[K <= balance`) and return\r\n\u001b[32m\u001b[K309\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K/// the exact net \u001b[01;31m\u001b[Ksettle\u001b[m\u001b[Kment \u001b[01;31m\u001b[Kdebit\u001b[m\u001b[K; reject every unaffordable transfer (`None`).\r\n\u001b[32m\u001b[K311\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K \u001b[01;31m\u001b[Kauthorize\u001b[m\u001b[K(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {\r\n\u001b[32m\u001b[K312\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    let ticket = \u001b[01;31m\u001b[Ksettle\u001b[m\u001b[Kment_engine::quote_\u001b[01;31m\u001b[Ksettle\u001b[m\u001b[Kment_ticket(amount, fee)?;\r\n\u001b[32m\u001b[K313\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Ksettle\u001b[m\u001b[Kment_engine::commit_ticket(balance, ticket)\r\n\u001b[32m\u001b[K316\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#[cfg(\u001b[01;31m\u001b[Ktest\u001b[m\u001b[K)]\r\n\u001b[32m\u001b[K317\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kmod \u001b[01;31m\u001b[Ktest\u001b[m\u001b[Ks {\r\n\u001b[32m\u001b[K320\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    #[\u001b[01;31m\u001b[Ktest\u001b[m\u001b[K]\r\n"]
[42.126791, "o", "\u001b[32m\u001b[K321\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fn ordinary_\u001b[01;31m\u001b[Ksettle\u001b[m\u001b[Kment() {\r\n\u001b[32m\u001b[K322\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(\u001b[01;31m\u001b[Kauthorize\u001b[m\u001b[K(100_012, 100_000, 25_000).unwrap().\u001b[01;31m\u001b[Ktotal\u001b[m\u001b[K_\u001b[01;31m\u001b[Kdebit\u001b[m\u001b[K, 100_012);\r\n\u001b[32m\u001b[K323\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(\u001b[01;31m\u001b[Kauthorize\u001b[m\u001b[K(100_011, 100_000, 25_000), None);\r\n\u001b[32m\u001b[K326\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    #[\u001b[01;31m\u001b[Ktest\u001b[m\u001b[K]\r\n\u001b[32m\u001b[K328\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(\u001b[01;31m\u001b[Kauthorize\u001b[m\u001b[K(2, 1, 0).unwrap().\u001b[01;31m\u001b[Ktotal\u001b[m\u001b[K_\u001b[01;31m\u001b[Kdebit\u001b[m\u001b[K, 2);\r\n\u001b[32m\u001b[K329\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(\u001b[01;31m\u001b[Kauthorize\u001b[m\u001b[K(9, 0, 99_991).unwrap().\u001b[01;31m\u001b[Ktotal\u001b[m\u001b[K_\u001b[01;31m\u001b[Kdebit\u001b[m\u001b[K, 9);\r\n\u001b[32m\u001b[K330\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(\u001b[01;31m\u001b[Kauthorize\u001b[m\u001b[K(8, 0, 99_991), None);\r\n\u001b[32m\u001b[K333\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    #[\u001b[01;31m\u001b[Ktest\u001b[m\u001b[K]\r\n\u001b[32m\u001b[K336\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(\u001b[01;31m\u001b[Kauthorize\u001b[m\u001b[K(expected, 10_000, u64::MAX).unwrap().\u001b[01;31m\u001b[Ktotal\u001b[m\u001b[K_\u001b[01;31m\u001b[Kdebit\u001b[m\u001b[K, expected);\r\n\u001b[32m\u001b[K337\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(\u001b[01;31m\u001b[Kauthorize\u001b[m\u001b[K(expected - 1, 10_000, u64::MAX), None);\r\n\u001b[32m\u001b[K340\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    #[\u001b[01;31m\u001b[Ktest\u001b[m\u001b[K]\r\n\u001b[32m\u001b[K343\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(\u001b[01;31m\u001b[Kauthorize\u001b[m\u001b[K(expected, 0, u64::MAX).unwrap().\u001b[01;31m\u001b[Ktotal\u001b[m\u001b[K_\u001b[01;31m\u001b[Kdebit\u001b[m\u001b[K, expected);\r\n\u001b[32m\u001b[K344\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(\u001b[01;31m\u001b[Kauthorize\u001b[m\u001b[K(expected - 1, 0, u64::MAX), None);\r\n\u001b[32m\u001b[K347\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    #[\u001b[01;31m\u001b[Ktest\u001b[m\u001b[K]\r\n\u001b[32m\u001b[K348\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fn \u001b[01;31m\u001b[Ktotal\u001b[m\u001b[K_\u001b[01;31m\u001b[Kdebit\u001b[m\u001b[K_overflow_rejected() {\r\n\u001b[32m\u001b[K349\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(\u001b[01;31m\u001b[Kauthorize\u001b[m\u001b[K(u64::MAX, u64::MAX, 1), None);\r\n\u001b[32m\u001b[K350\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(\u001b[01;31m\u001b[Kauthorize\u001b[m\u001b[K(u64::MAX, u64::MAX, u64::MAX), None);\r\n\u001b[32m\u001b[K353\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    #[\u001b[01;31m\u001b[Ktest\u001b[m\u001b[K]\r\n\u001b[32m\u001b[K354\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fn \u001b[01;31m\u001b[Kflash\u001b[m\u001b[K_loan_ceil_levy_across_all_boundaries() {\r\n\u001b[32m\u001b[K355\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        let fee_at_pocket = \u001b[01;31m\u001b[Kflash\u001b[m\u001b[K_loan::assess_\u001b[01;31m\u001b[Kflash\u001b[m\u001b[K_fee_ceil(0, u64::MAX - 2_500);\r\n\u001b[32m\u001b[K357\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        let receipt = \u001b[01;31m\u001b[Kflash\u001b[m\u001b[K_loan::quote_\u001b[01;31m\u001b[Kflash\u001b[m\u001b[K_re\u001b[01;31m\u001b[Kpayment\u001b[m\u001b[K(100_000, 1).unwrap();\r\n\u001b[32m\u001b[K358\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(receipt.\u001b[01;31m\u001b[Kflash\u001b[m\u001b[K_levy, 21);\r\n\u001b[32m\u001b[K359\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        assert_eq!(receipt.\u001b[01;31m\u001b[Ktotal\u001b[m\u001b[K_re\u001b[01;31m\u001b[Kpayment\u001b[m\u001b[K, 100_021);\r\n\u001b[32m\u001b[K362\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    #[\u001b[01;31m\u001b[Ktest\u001b[m\u001b[K]\r\n"]
