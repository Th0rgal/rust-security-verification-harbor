[69.99971, "o", "     1\t//! Multi-module concentrated-liquidity and flash-settlement engine.\r\n     2\t//!\r\n     3\t//! All production paths operate strictly in 64-bit word arithmetic (`u64`)\r\n     4\t//! without `u128` promotion so that settlement authorization executes natively\r\n     5\t"]
[69.999819, "o", "//! on 64-bit VM word registers.\r\n     6\t\r\n     7\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n     8\tpub struct Authorization {\r\n     9\t    pub total_debit: u64,\r\n    10\t}\r\n    11\t\r\n"]
[69.9999, "o", "    12\tpub mod constants {\r\n    13\t    /// Standard basis-point denominator (100% = 10_000 bps).\r\n    14\t    pub const BPS_DENOM: u64 = 10_000;\r\n    15\t    /// Maximum non-zero remainder modulo `BPS_DENOM` (`BPS_DENOM - 1`).\r\n    16\t    pub const BPS_MAX_REM: u64 = 9_999;\r\n    17\t    /// Floor quotient of `2^64` by `BPS_DENOM`: `floor(2^64 / 10_000)`."]
[69.999943, "o", "\r\n    18\t    pub const U64_MOD_BPS_QUOT: u64 = 1_844_674_407_370_955;\r\n    19\t    /// Exact remainder of `2^64` modulo `BPS_DENOM`: `2^64 % 10_000 = 1_616`.\r\n"]
[69.999975, "o", "    20\t    pub const U64_MOD_BPS_REM: u64 = 1_616;\r\n    21\t"]
[69.999999, "o", "    /// Tier rebate divisor (10% rebate on gross settlement fee, rounded down).\r\n    22\t"]
[70.000022, "o", "    pub const REBATE_DIVISOR: u64 = 10;\r\n    23\t"]
[70.000052, "o", "    /// Maker rebate cap divisor (20% cap on maker rebates in order-book mode).\r\n    24\t"]
[70.000079, "o", "    pub const MAKER_REBATE_CAP_DIVISOR: u64 = 5;\r\n    25\t    /// Protocol reserve cut divisor (25% of net pool fee retained by treasury).\r\n"]
[70.000107, "o", "    26\t"]
[70.000783, "o", "    pub const TREASURY_CUT_DIVISOR: u64 = 4;\r\n    27\t    /// Flash-loan surcharge denominator (5_000 = 2 bps per unit).\r\n    28\t    pub const FLASH_DENOM: u64 = 5_000;\r\n    29\t    /// Ceiling bias for `FLASH_DENOM` (`FLASH_DENOM - 1`).\r\n    30\t    pub const FLASH_MAX_REM: u64 = 4_999;\r\n    31\t    /// Floor quotient `floor(2^64 / 5_000)`.\r\n    32\t    pub const U64_MOD_FLASH_QUOT: u64 = 3_689_348_814_741_910;\r\n    33\t    /// Exact remainder `2^64 % 5_000 = 1_616`.\r\n    34\t    pub const U64_MOD_FLASH_REM: u64 = 1_616;\r\n    35\t    /// Institutional notional band threshold for diagnostic classification.\r\n    36\t    pub const INSTITUTIONAL_BAND_MIN: u64 = 10_000_000_000_000;\r\n    37\t}\r\n    38\t\r\n    39\tpub mod word_math {\r\n    40\t    use crate::constants::*;\r\n    41\t\r\n    42\t    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    43\t    pub struct WordSum {\r\n    44\t        pub low_word: u64,\r\n    45\t        pub high_carry: bool,\r\n    46\t    }\r\n    47\t\r\n    48\t    /// Adds two `u64` words and captures the 64-bit wrap carry flag.\r\n    49\t    #[inline]\r\n    50\t    pub fn add_u64_with_carry(lhs: u64, rhs: u64) -> WordSum {\r\n    51\t        let low_word = lhs.wrapping_add(rhs);\r\n    52\t        let high_carry = low_word < lhs;\r\n    53\t        WordSum { low_word, high_carry }\r\n    54\t    }\r\n    55\t\r\n    56\t    /// Checks whether a combined notional exceeds the institutional liquidity band.\r\n    57\t    #[inline]\r\n    58\t    pub fn is_institutional_notional(sum: WordSum) -> bool {\r\n    59\t        if sum.high_carry {\r\n    60\t            true\r\n    61\t        } else {\r\n    62\t            sum.low_word >= INSTITUTIONAL_BAND_MIN\r\n    63\t        }\r\n    64\t    }\r\n    65\t\r\n    66\t    /// Exact floor division `floor((lhs + rhs) / 10_000)` in pure `u64` arithmetic.\r\n    67\t    #[inline]\r\n    68\t    pub fn floor_div_bps_u64(sum: WordSum) -> u64 {\r\n    69\t        if sum.high_carry {\r\n    70\t            let folded_rem = (sum.low_word % BPS_DENOM) + U64_MOD_BPS_REM;\r\n    71\t            U64_MOD_BPS_QUOT + (sum.low_word / BPS_DENOM) + (folded_rem / BPS_DENOM)\r\n    72\t        } else {\r\n    73\t            sum.low_word / BPS_DENOM\r\n    74\t        }\r\n    75\t    }\r\n    76\t\r\n    77\t    /// Ceiling division `ceil((lhs + rhs) / 10_000)` in pure `u64` arithmetic.\r\n    78\t    #[inline]\r\n    79\t    pub fn ceil_div_bps_u64(sum: WordSum) -> u64 {\r\n    80\t        if sum.high_carry {\r\n    81\t            let folded_rem = (sum.low_word % BPS_DENOM) + U64_MOD_BPS_REM;\r\n    82\t            U64_MOD_BPS_QUOT + (sum.low_word / BPS_DENOM) + ((folded_rem + BPS_MAX_REM) / BPS_DENOM)\r\n    83\t        } else {\r\n    84\t            let biased = sum.low_word.wrapping_add(BPS_MAX_REM);\r\n    85\t            if biased < sum.low_word {\r\n    86\t                (sum.low_word / BPS_DENOM) + (((sum.low_word % BPS_DENOM) + BPS_MAX_REM) / BPS_DENOM)\r\n    87\t            } else {\r\n    88\t                biased / BPS_DENOM\r\n    89\t            }\r\n    90\t        }\r\n    91\t    }\r\n    92\t}\r\n    93\t\r\n    94\tpub mod fee_tiers {\r\n    95\t    use crate::constants::*;\r\n    96\t    use crate::word_math::{WordSum, ceil_div_bps_u64, floor_div_bps_u64};\r\n    97\t\r\n    98\t    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    99\t    pub struct FeeSchedule {\r\n   100\t        pub bps_denom: u64,\r\n   101\t        pub rebate_divisor: u64,\r\n   102\t        pub maker_cap_divisor: u64,\r\n   103\t    }\r\n   104\t\r\n   105\t    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n   106\t    pub struct FeeQuote {\r\n   107\t        pub gross_fee: u64,\r\n   108\t        pub rebate: u64,\r\n   109\t        pub net_fee: u64,\r\n   110\t    }\r\n   111\t\r\n   112\t    /// Returns the default protocol fee schedule parameters.\r\n   113\t    #[inline]\r\n   114\t    pub fn default_schedule() -> FeeSchedule {\r\n   115\t        FeeSchedule {\r\n   116\t            bps_denom: BPS_DENOM,\r\n   117\t            rebate_divisor: REBATE_DIVISOR,\r\n   118\t            maker_cap_divisor: MAKER_REBATE_CAP_DIVISOR,\r\n   119\t        }\r\n   120\t    }\r\n   121\t\r\n   122\t    /// Computes the floor 10% tier rebate `floor(gross_fee / 10)`.\r\n   123\t    #[inline]\r\n   124\t    pub fn compute_tier_rebate(gr"]
[70.000827, "o", "oss_fee: u64) -> u64 {\r\n   125\t        gross_fee / REBATE_DIVISOR\r\n   126\t    }\r\n   127\t\r\n   128\t    /// Computes a capped maker rebate `min(floor(gross_fee / 10), floor(limit / 5))`\r\n   129\t    /// used by passive order-book quotes.\r\n   130\t    #[inline]\r\n   131\t    pub fn compute_capped_maker_rebate(gross_fee: u64, cap_basis: u64) -> u64 {\r\n   132\t        let base_rebate = gross_fee / REBATE_DIVISOR;\r\n   133\t        let max_rebate = cap_basis / MAKER_REBATE_CAP_DIVISOR;\r\n   134\t        if base_rebate <= max_rebate {\r\n   135\t            base_rebate\r\n   136\t        } else {\r\n   137\t            max_rebate\r\n   138\t        }\r\n   139\t    }\r\n   140\t\r\n   141\t    /// Evaluates the two-stage settlement fee quote (`gross_fee`, `rebate`, `net_fee`)\r\n   142\t    /// from a folded 64-bit notional sum.\r\n   143\t    #[inline]\r\n   144\t    pub fn evaluate_settlement_fee(sum: WordSum) -> FeeQuote {\r\n   145\t        let gross_fee = ceil_div_bps_u64(sum);\r\n   146\t        let rebate = compute_tier_rebate(gross_fee);\r\n   147\t        let net_fee = gross_fee - rebate;\r\n   148\t        FeeQuote {\r\n   149\t            gross_fee,\r\n   150\t            rebate,\r\n   151\t            net_fee,\r\n   152\t        }\r\n   153\t    }\r\n   154\t\r\n   155\t    /// Evaluates a passive liquidity floor fee quote (used by pool analytics).\r\n   156\t    #[inline]\r\n   157\t    pub fn evaluate_passive_floor_fee(sum: WordSum) -> FeeQuote {\r\n   158\t        let gross_fee = floor_div_bps_u64(sum);\r\n   159\t        let rebate = compute_tier_rebate(gross_fee);\r\n   160\t        let net_fee = gross_fee - rebate;\r\n   161\t        FeeQuote {\r\n   162\t            gross_fee,\r\n   163\t            rebate,\r\n   164\t            net_fee,\r\n   165\t        }\r\n   166\t    }\r\n   167\t}\r\n   168\t\r\n   169\tpub mod liquidity_pool {\r\n   170\t    use crate::constants::*;\r\n   171\t    use crate::fee_tiers::FeeQuote;\r\n   172\t\r\n   173\t    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n   174\t    pub struct PoolReserveQuote {\r\n   175\t        pub treasury_cut: u64,\r\n   176\t        pub lp_retention: u64,\r\n   177\t    }\r\n   178\t\r\n   179\t    /// Splits a net fee between the protocol treasury (`floor(net_fee / 4)`)\r\n   180\t    /// and liquidity providers (`net_fee - treasury_cut`).\r\n   181\t    #[inline]\r\n   182\t    pub fn split_pool_reserve(quote: FeeQuote) -> PoolReserveQuote {\r\n   183\t        let treasury_cut = quote.net_fee / TREASURY_CUT_DIVISOR;\r\n   184\t        let lp_retention = quote.net_fee - treasury_cut;\r\n   185\t        PoolReserveQuote {\r\n   186\t            treasury_cut,\r\n   187\t            lp_retention,\r\n   188\t        }\r\n   189\t    }\r\n   190\t\r\n\u001b[?2004h"]
