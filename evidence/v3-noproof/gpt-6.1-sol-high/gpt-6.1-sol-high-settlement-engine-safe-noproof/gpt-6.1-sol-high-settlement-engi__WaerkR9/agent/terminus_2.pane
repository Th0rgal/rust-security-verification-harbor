   298	
   299	/// Authorize a liquidity transfer in pure `u64` arithmetic before settlement.
   300	///
   301	/// Policy over exact unbounded integers (`balance`, `amount`, `fee`):
   302	/// 1. The gross protocol fee is the combined basis `amount + fee` divided by
   303	///    `BPS_DENOM` (`10_000`), rounded up (`ceil((amount + fee) / 10_000)`).
   304	/// 2. The tier rebate is `gross_fee` divided by `REBATE_DIVISOR` (`10`),
   305	///    rounded down (`floor(gross_fee / 10)`).
   306	/// 3. The net settlement debit is `amount + (gross_fee - rebate)`.
   307	///
   308	/// Authorize every affordable transfer (`total_debit <= balance`) and return
   309	/// the exact net settlement debit; reject every unaffordable transfer (`None`).
   310	/// Target word constraint: production code must use `u64` only (no `u128`).
   311	pub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {
   312	    let ticket = settlement_engine::quote_settlement_ticket(amount, fee)?;
   313	    settlement_engine::commit_ticket(balance, ticket)
   314	}
   315	
   316	#[cfg(test)]
   317	mod tests {
   318	    use super::*;
   319	
   320	    #[test]
   321	    fn ordinary_settlement() {
   322	        assert_eq!(authorize(100_012, 100_000, 25_000).unwrap().total_debit, 100_012);
   323	        assert_eq!(authorize(100_011, 100_000, 25_000), None);
   324	    }
   325	
   326	    #[test]
   327	    fn ceiling_rounding_and_rebate() {
   328	        assert_eq!(authorize(2, 1, 0).unwrap().total_debit, 2);
   329	        assert_eq!(authorize(9, 0, 99_991).unwrap().total_debit, 9);
   330	        assert_eq!(authorize(8, 0, 99_991), None);
   331	    }
   332	
   333	    #[test]
   334	    fn wide_basis_carry_folding() {
   335	        let expected = 1_660_206_966_643_862;
   336	        assert_eq!(authorize(expected, 10_000, u64::MAX).unwrap().total_debit, expected);
   337	        assert_eq!(authorize(expected - 1, 10_000, u64::MAX), None);
   338	    }
   339	
   340	    #[test]
   341	    fn ceiling_bias_wrap_at_u64_max() {
   342	        let expected = 1_660_206_966_633_861;
   343	        assert_eq!(authorize(expected, 0, u64::MAX).unwrap().total_debit, expected);
   344	        assert_eq!(authorize(expected - 1, 0, u64::MAX), None);
   345	    }
   346	
   347	    #[test]
   348	    fn total_debit_overflow_rejected() {
   349	        assert_eq!(authorize(u64::MAX, u64::MAX, 1), None);
   350	        assert_eq!(authorize(u64::MAX, u64::MAX, u64::MAX), None);
   351	    }
   352	
   353	    #[test]
   354	    fn flash_loan_ceil_levy_across_all_boundaries() {
   355	        let fee_at_pocket = flash_loan::assess_flash_fee_ceil(0, u64::MAX - 2_500);
   356	        assert_eq!(fee_at_pocket, 3_689_348_814_741_910);
   357	        let receipt = flash_loan::quote_flash_repayment(100_000, 1).unwrap();
   358	        assert_eq!(receipt.flash_levy, 21);
   359	        assert_eq!(receipt.total_repayment, 100_021);
   360	    }
   361	
   362	    #[test]
   363	    fn pool_reserve_split_and_maker_rebate_cap() {
   364	        let sum = word_math::add_u64_with_carry(500_000, 50_000);
   365	        let quote = fee_tiers::evaluate_passive_floor_fee(sum);
   366	        assert_eq!(quote.gross_fee, 55);
   367	        assert_eq!(quote.rebate, 5);
   368	        assert_eq!(quote.net_fee, 50);
   369	        let split = liquidity_pool::split_pool_reserve(quote);
   370	        assert_eq!(split.treasury_cut, 12);
   371	        assert_eq!(split.lp_retention, 38);
   372	        assert_eq!(fee_tiers::compute_capped_maker_rebate(55, 15), 3);
   373	    }
   374	}
