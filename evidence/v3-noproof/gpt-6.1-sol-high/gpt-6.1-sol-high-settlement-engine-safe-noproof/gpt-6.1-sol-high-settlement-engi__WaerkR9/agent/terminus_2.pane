   299	/// Authorize a liquidity transfer in pure `u64` arithmetic before settlement.
   300	///
   301	/// Policy over exact unbounded integers (`balance`, `amount`, `fee`):
   302	/// 1. The gross protocol fee is the combined basis `amount + fee` divided by
   303	///    `BPS_DENOM` (`10_000`), rounded up (`ceil((amount + fee) / 10_000)`).
   304	/// 2. The tier rebate is `gross_fee` divided by `REBATE_DIVISOR` (`10`),
   305	///    rounded down (`floor(gross_fee / 10)`).
   306	/// 3. The net settlement debit is `amount + (gross_fee - rebate)`.
   307	///
   308	/// Authorize every affordable transfer (`total_debit <= balance`) and return
   309	/// the exact net settlement debit; reject every unaffordable transfer (`None`).
   310	/// Target word constraint: production code must use `u64` only (no `u128`).
   311	pub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {
   312	    let ticket = settlement_engine::quote_settlement_ticket(amount, fee)?;
   313	    settlement_engine::commit_ticket(balance, ticket)
   314	}
