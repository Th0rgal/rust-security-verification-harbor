[25.876636, "i", "cat >> src/lib.rs <<'EOF'\n#[cfg(test)]\nmod fuzz {\n    use super::*;\n    fn reference(b: u64, a: u64, f: u64) -> Option<u64> {\n        let mut act: u128 = 0; let mut s: u128 = 0;\n        for i in 0..8 { let x = ((f >> (8*i)) & 0xFF) as u128; if x > 0 { act += 1; } s += x; }\n        let t = (a as u128)/2 + 256*act + s;\n        if t <= b as u128 { Some(t as u64) } else { None }\n    }\n    #[test]\n    fn compare() {\n        let edge = [0u64,1,2,0x7F,0x80,0xFF,0x100,0x8080_8080_8080_8080,0x0101_0101_0101_0101,0x7F7F_7F7F_7F7F_7F7F,u64::MAX,u64::MAX-1,u64::MAX/2,1u64<<63,(1u64<<63)+4087,(1u64<<63)+4086];\n        for &b in &edge { for &a in &edge { for &f in &edge {\n            assert_eq!(authorize(b,a,f).map(|x| x.total_debit), reference(b,a,f), \"{} {} {}\", b,a,f);\n        }}}\n        let mut s: u64 = 0x9E3779B97F4A7C15;\n        let mut r = || { s ^= s << 13; s ^= s >> 7; s ^= s << 17; s };\n        for _ in 0..3_000_000 {\n            let f = r(); let a = r(); let b = r();\n            let f = match f % 3 { 0 => f, 1 => f & 0x8080_8080_8080_8080, _ => f | 0x8080_8080_8080_8080 };\n            assert_eq!(authorize(b,a,f).map(|x| x.total_debit), reference(b,a,f), \"{} {} {}\", b,a,f);\n            let tot = reference(u64::MAX,a,f).unwrap();\n            assert!(authorize(tot,a,f).is_some());\n            if tot > 0 { assert!(authorize(tot-1,a,f).is_none()); }\n        }\n    }\n}\nEOF\n"]
