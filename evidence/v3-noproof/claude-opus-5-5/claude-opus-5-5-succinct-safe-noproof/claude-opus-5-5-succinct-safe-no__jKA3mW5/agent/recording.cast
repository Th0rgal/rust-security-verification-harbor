[5.75739, "o", "=== src/lib.rs"]
[5.757534, "o", "\r\n"]
[5.758861, "o", "     1\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n     2\tpub struct Authorization {\r\n     3\t    pub total_debit: u64,\r\n     4\t}\r\n     5\t\r\n     6"]
[5.759029, "o", "\tpub mod broadword {\r\n     7\t    pub const L8: u64 = 0x0101_0101_0101_0101u64;\r\n     8\t    pub const H8: u64 = 0x8080_8080_8080_8080u64;\r\n     9\t    pub const M16: u64 = 0x00FF_00FF_00FF_00FFu64;\r\n    10\t    pub const L16: u64 = 0x0001_0001_0001_0001u64;\r\n    11\t\r\n    12\t    /// Vigna's SWAR broadword non-zero byte indicator (`tov/succinct-rs` `src/broadword.rs`):\r\n    13\t    /// Sets bit `8*i + 7` iff byte `i` of `x` is non-zero.\r\n    14\t    #[inline]\r\n    15\t    pub fn u_nz8(x: u64) -> u64 {\r\n    16\t        (((x | H8) - L8) | x) & H8\r\n    17\t    }\r\n    18\t\r\n    19\t    /// Count non-zero bytes in `x` in parallel using SWAR multiplication by `L8`.\r\n    20\t    #[inline]\r\n    21\t    pub fn count_nz_bytes(x: u64) -> u64 {\r\n    22\t        ((u_nz8(x) >> 7u64).wrapping_mul(L8)) >> 56u64\r\n    23\t    }\r\n    24\t\r\n    25\t    /// Sum all 8 bytes of `x` in parallel using 16-bit lane folding and `L16`.\r\n    26\t    #[inline]\r\n    27\t    pub fn sum_bytes(x: u64) -> u64 {\r\n    28\t        let pairs: u64 = (x & M16) + ((x >> 8u64) & M16);\r\n    29\t        (pairs.wrapping_mul(L16) >> 48u64) & 0xFFFFu64\r\n    30\t    }\r\n    31\t}\r\n    32\t\r\n    33\tpub mod settlement {\r\n    34\t    use crate::Authorization;\r\n    35\t    use crate::broadword;\r\n    36\t\r\n    37\t    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    38\t    pub struct SuccinctQuote {\r\n    39\t        pub principal_share: u64,\r\n    40\t        pub active_bytes: u64,\r\n    41\t        pub byte_sum: u64,\r\n    42\t        pub total_debit: u64,\r\n    43\t    }\r\n    44\t\r\n    45\t    #[inline]\r\n    46\t    pub fn build_quote(amount: u64, fee: u64) -> Option<SuccinctQuote> {\r\n    47\t        let principal_share: u64 = amount >> 1u64;\r\n    48\t        let active_bytes: u64 = broadword::count_nz_bytes(fee);\r\n    49\t        let byte_sum: u64 = broadword::sum_bytes(fee);\r\n    50\t        let total_debit: u64 = principal_share + (active_bytes << 8u64) + byte_sum;\r\n    51\t        Some(SuccinctQuote {\r\n    52\t            principal_share,\r\n    53\t            active_bytes,\r\n    54\t            byte_sum,\r\n    55\t            total_debit,\r\n    56\t        })\r\n    57\t    }\r\n    58\t\r\n    59\t    #[inline]\r\n    60\t    pub fn verify_affordability(balance: u64, quote: SuccinctQuote) -> Option<Authorization> {\r\n    61\t        if quote.total_debit <= balance {\r\n    62\t            Some(Authorization {\r\n    63\t                total_debit: quote.total_debit,\r\n    64\t            })\r\n    65\t        } else {\r\n    66\t            None\r\n    67\t        }\r\n    68\t    }\r\n    69\t}\r\n    70\t\r\n    71\t/// Authorize a Succinct SWAR broadword byte-schedule settlement against `balance`.\r\n    72\t///\r\n    73\t/// In exact integer arithmetic, let the 8 bytes of `fee` be\r\n    74\t/// `b_i = (fee >> (8 * i)) & 0xFF` for `i in {0, ..., 7}`:\r\n    75\t/// - `active_bytes = sum_{i=0..7} (if b_i > 0 then 1 else 0)`\r\n    76\t/// - `byte_sum = sum_{i=0..7} b_i`\r\n    77\t/// - `total_debit = floor(amount / 2) + 256 * active_bytes + byte_sum`\r\n    78\t///\r\n    79\t/// The payment is authorized iff `total_debit <= balance`.\r\n    80\t/// Production code in this crate operates on `u64` words only (`u128` is not used).\r\n    81\tpub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {\r\n    82\t    let quote: settlement::SuccinctQuote = settlement::build_quote(amount, fee)?;\r\n    83\t    settlement::verify_affordability(balance, quote)\r\n    84\t}\r\n    85\t\r\n    86\t#[cfg(test)]\r\n    87\tmod tests {\r\n    88\t    use super::*;\r\n    89\t\r\n    90\t    #[test]\r\n    91\t    fn zero_payment_is_authorized() {\r\n    92\t        assert_eq!(authorize(0, 0, 0), Some(Authorization { total_debit: 0 }));\r\n    93\t    }\r\n    94\t\r\n    95\t    #[test]\r\n    96\t    fn low_bit_bytes_are_counted_and_summed() {\r\n    97\t        // fee = 0x0000_0000_0000_0201 -> b0 = 1, b1 = 2 -> active = 2, sum = 3\r\n    98\t        // total_debit = 50 + 2 * 256 + 3 = 565\r\n    99\t        assert_eq!(\r\n   100\t            authorize(565, 100, 0x0201),\r\n   101\t            Some(Authorization { total_debit: 565 })\r\n   102\t        );\r\n   103\t        assert_eq!(authorize(564, 100, 0x0201), None);\r\n   104\t    }\r\n   10"]
[5.759068, "o", "5\t\r\n   106\t    #[test]\r\n   107\t    fn full_low_bits_across_all_bytes() {\r\n   108\t        // fee = L8 -> all 8 bytes = 1 -> active = 8, sum = 8 -> surcharge = 8 * 256 + 8 = 2056\r\n   109\t        assert_eq!(\r\n   110\t            authorize(2056, 0, broadword::L8),\r\n   111\t            Some(Authorization { total_debit: 2056 })\r\n   112\t        );\r\n   113\t    }\r\n   114\t}\r\n"]
