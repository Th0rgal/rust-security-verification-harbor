[27.709206, "i", "python3 - <<'EOF'\ns=open('/workspace/challenge/src/lib.rs').read()\nold='''        let raw_idx: u64 = d0 * o0 + d1 * o1 + d2 * o2 + d3;\n        let space_size: u64 = o0.wrapping_mul(b0);\n        if raw_idx < space_size {\n            raw_idx\n        } else {\n            0u64\n        }\n'''\nnew='''        // Exact: raw_idx <= b0*b1*b2*b3 - 1 <= 2^64 - 1, so it always fits in u64\n        // and is always within the (possibly 2^64-sized) index space.\n        let raw_idx: u64 = d0 * o0 + d1 * o1 + d2 * o2 + d3;\n        raw_idx\n'''\nassert old in s\ns=s.replace(old,new)\nt='''    #[test]\n    fn full_radix_space_is_not_zeroed() {\n        let half: u64 = u64::MAX >> 1;\n        assert_eq!(authorize(half, u64::MAX, u64::MAX), None);\n        assert_eq!(authorize(u64::MAX - 1, u64::MAX, u64::MAX), Some(Authorization { total_debit: u64::MAX - 1 }));\n    }\n}\n'''\ni=s.rstrip().rfind('}')\ns=s[:i]+t\nopen('/workspace/submission/src/lib.rs','w').write(s)\nEOF\ndiff /workspace/challenge/src/lib.rs /workspace/submission/src/lib.rs\n"]
