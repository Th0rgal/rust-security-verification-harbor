[5.551323, "o", "\t//! Multi-module concentrated-liquidity and flash-settlement engine.\r\n     2\t//!\r\n     3\t//! All production paths operate strictly in 64-bit word arithmetic (`u64`)\r\n     4\t//! without `u128` promotion so that settlement authorization executes natively\r\n     5\t//! on 64-bit VM word registers.\r\n     6\t\r\n     7\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n     8\tpub struct Authorization {\r\n     9\t    pub total_debit: u64,\r\n    10\t}\r\n    11\t\r\n    12\tpub mod constants {\r\n    13\t    /// Standard basis-point denominator (100% = 10_000 bps).\r\n    14\t    pub const BPS_DENOM: u64 = 10_000;\r\n    15\t    /// Maximum non-zero remainder modulo `BPS_DENOM` (`BPS_DENOM - 1`).\r\n    16\t    pub const BPS_MAX_REM: u64 = 9_999;\r\n    17\t    /// Floor quotient of `2^64` by `BPS_DENOM`: `floor(2^64 / 10_000)`.\r\n    18\t    pub const U64_MOD_BPS_QUOT: u64 = 1_844_674_407_370_955;\r\n    19\t    /// Exact remainder of `2^64` modulo `BPS_DENOM`: `2^64 % 10_000 = 1_616`.\r\n    20\t    pub const U64_MOD_BPS_REM: u64 = 1_616;\r\n    21\t    /// Tier rebate divisor (10% rebate on gross settlement fee, rounded down).\r\n    22\t    pub const REBATE_DIVISOR: u64 = 10;\r\n    23\t    /// Maker rebate cap divisor (20% cap on maker rebates in order-book mode).\r\n    24\t    pub const MAKER_REBATE_CAP_DIVISOR: u64 = 5;\r\n    25\t    /// Protocol reserve cut divisor (25% of net pool fee retained by treasury).\r\n    26\t    pub const TREASURY_CUT_DIVISOR: u64 = 4;\r\n    27\t    /// Flash-loan surcharge denominator (5_000 = 2 bps per unit).\r\n    28\t    pub const FLASH_DENOM: u64 = 5_000;\r\n    29\t    /// Ceiling bias for `FLASH_DENOM` (`FLASH_DENOM - 1`).\r\n    30\t    pub const FLASH_MAX_REM: u64 = 4_999;\r\n    31\t    /// Floor quotient `floor(2^64 / 5_000)`.\r\n    32\t    pub const U64_MOD_FLASH_QUOT: u64 = 3_689_348_814_741_910;\r\n    33\t    /// Exact remainder `2^64 % 5_000 = 1_616`.\r\n    34\t    pub const U64_MOD_FLASH_REM: u64 = 1_616;\r\n    35\t    /// Institutional notional band threshold for diagnostic classification.\r\n    36\t    pub const INSTITUTIONAL_BAND_MIN: u64 = 10_000_000_000_000;\r\n    37\t}\r\n    38\t\r\n    39\tpub mod word_math {\r\n    40\t    use crate::constants::*;\r\n    41\t\r\n    42\t    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    43\t    pub struct WordSum {\r\n    44\t        pub low_word: u64,\r\n    45\t        pub high_carry: bool,\r\n    46\t    }\r\n    47\t\r\n    48\t    /// Adds two `u64` words and captures the 64-bit wrap carry flag.\r\n    49\t    #[inline]\r\n    50\t    pub fn add_u64_with_carry(lhs: u64, rhs: u64) -> WordSum {\r\n    51\t        let low_word = lhs.wrapping_add(rhs);\r\n    52\t        let high_carry = low_word < lhs;\r\n    53\t        WordSum { low_word, high_carry }\r\n    54\t    }\r\n    55\t\r\n    56\t    /// Checks whether a combined notional exceeds the institutional liquidity band.\r\n    57\t    #[inline]\r\n    58\t    pub fn is_institutional_notional(sum: WordSum) -> bool {\r\n    59\t        if sum.high_carry {\r\n    60\t            true\r\n    61\t        } else {\r\n    62\t            sum.low_word >= INSTITUTIONAL_BAND_MIN\r\n    63\t        }\r\n    64\t    }\r\n    65\t\r\n    66\t    /// Exact floor division `floor((lhs + rhs) / 10_000)` in pure `u64` arithmetic.\r\n    67\t    #[inline]\r\n    68\t    pub fn floor_div_bps_u64(sum: WordSum) -> u64 {\r\n    69\t        if sum.high_carry {\r\n    70\t            let folded_rem = (sum.low_word % BPS_DENOM) + U64_MOD_BPS_REM;\r\n    71\t            U64_MOD_BPS_QUOT + (sum.low_word / BPS_DENOM) + (folded_rem / BPS_DENOM)\r\n    72\t        } else {\r\n    73\t            sum.low_word / BPS_DENOM\r\n    74\t        }\r\n    75\t    }\r\n    76\t\r\n    77\t    /// Ceiling division `ceil((lhs + rhs) / 10_000)` in pure `u64` arithmetic.\r\n    78\t    #[inline]\r\n    79\t    pub fn ceil_div_bps_u64(sum: WordSum) -> u64 {\r\n    80\t        if sum.high_carry {\r\n    81\t            let folded_rem = (sum.low_word % BPS_DENOM) + U64_MOD_BPS_REM;\r\n    82\t            U64_MOD_BPS_QUOT + (sum.low_word / BPS_DENOM) + ((folded_rem + BPS_MAX_REM) / BPS_DENOM)\r\n    83\t        } else {\r\n    84\t            let biased = sum.low_word.wrapping_add(BPS_MAX_REM);\r\n    85\t            if biased < sum.low_wor"]
[5.553011, "o", "d {\r\n    86\t                (sum.low_word / BPS_DENOM) + ((biased + U64_MOD_BPS_REM) / BPS_DENOM)\r\n    87\t            } else {\r\n    88\t                biased / BPS_DENOM\r\n    89\t            }\r\n    90\t        }\r\n    91\t    }\r\n    92\t}\r\n    93\t\r\n    94\tpub mod fee_tiers {\r\n    95\t    use crate::constants::*;\r\n    96\t    use crate::word_math::{WordSum, ceil_div_bps_u64, floor_div_bps_u64};\r\n    97\t\r\n    98\t    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    99\t    pub struct FeeSchedule {\r\n   100\t        pub bps_denom: u64,\r\n   101\t        pub rebate_divisor: u64,\r\n   102\t        pub maker_cap_divisor: u64,\r\n   103\t    }\r\n   104\t\r\n   105\t    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n   106\t    pub struct FeeQuote {\r\n   107\t        pub gross_fee: u64,\r\n   108\t        pub rebate: u64,\r\n   109\t        pub net_fee: u64,\r\n   110\t    }\r\n   111\t\r\n   112\t    /// Returns the default protocol fee schedule parameters.\r\n   113\t    #[inline]\r\n   114\t    pub fn default_schedule() -> FeeSchedule {\r\n   115\t        FeeSchedule {\r\n   116\t            bps_denom: BPS_DENOM,\r\n   117\t            rebate_divisor: REBATE_DIVISOR,\r\n   118\t            maker_cap_divisor: MAKER_REBATE_CAP_DIVISOR,\r\n   119\t        }\r\n   120\t    }\r\n   121\t\r\n   122\t    /// Computes the floor 10% tier rebate `floor(gross_fee / 10)`.\r\n   123\t    #[inline]\r\n   124\t    pub fn compute_tier_rebate(gross_fee: u64) -> u64 {\r\n   125\t        gross_fee / REBATE_DIVISOR\r\n   126\t    }\r\n   127\t\r\n   128\t    /// Computes a capped maker rebate `min(floor(gross_fee / 10), floor(limit / 5))`\r\n   129\t    /// used by passive order-book quotes.\r\n   130\t    #[inline]\r\n   131\t    pub fn compute_capped_maker_rebate(gross_fee: u64, cap_basis: u64) -> u64 {\r\n   132\t        let base_rebate = gross_fee / REBATE_DIVISOR;\r\n   133\t        let max_rebate = cap_basis / MAKER_REBATE_CAP_DIVISOR;\r\n   134\t        if base_rebate <= max_rebate {\r\n   135\t            base_rebate\r\n   136\t        } else {\r\n   137\t            max_rebate\r\n   138\t        }\r\n   139\t    }\r\n   140\t\r\n   141\t    /// Evaluates the two-stage settlement fee quote (`gross_fee`, `rebate`, `net_fee`)\r\n   142\t    /// from a folded 64-bit notional sum.\r\n   143\t    #[inline]\r\n   144\t    pub fn evaluate_settlement_fee(sum: WordSum) -> FeeQuote {\r\n   145\t        let gross_fee = ceil_div_bps_u64(sum);\r\n   146\t        let rebate = compute_tier_rebate(gross_fee);\r\n   147\t        let net_fee = gross_fee - rebate;\r\n   148\t        FeeQuote {\r\n   149\t            gross_fee,\r\n   150\t            rebate,\r\n   151\t            net_fee,\r\n   152\t        }\r\n   153\t    }\r\n   154\t\r\n   155\t    /// Evaluates a passive liquidity floor fee quote (used by pool analytics).\r\n   156\t    #[inline]\r\n   157\t    pub fn evaluate_passive_floor_fee(sum: WordSum) -> FeeQuote {\r\n   158\t        let gross_fee = floor_div_bps_u64(sum);\r\n   159\t        let rebate = compute_tier_rebate(gross_fee);\r\n   160\t        let net_fee = gross_fee - rebate;\r\n   161\t        FeeQuote {\r\n   162\t            gross_fee,\r\n   163\t            rebate,\r\n   164\t            net_fee,\r\n   165\t        }\r\n   166\t    }\r\n   167\t}\r\n   168\t\r\n   169\tpub mod liquidity_pool {\r\n   170\t    use crate::constants::*;\r\n   171\t    use crate::fee_tiers::FeeQuote;\r\n   172\t\r\n   173\t    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n   174\t    pub struct PoolReserveQuote {\r\n   175\t        pub treasury_cut: u64,\r\n   176\t        pub lp_retention: u64,\r\n   177\t    }\r\n   178\t\r\n   179\t    /// Splits a net fee between the protocol treasury (`floor(net_fee / 4)`)\r\n   180\t    /// and liquidity providers (`net_fee - treasury_cut`).\r\n   181\t    #[inline]\r\n   182\t    pub fn split_pool_reserve(quote: FeeQuote) -> PoolReserveQuote {\r\n   183\t        let treasury_cut = quote.net_fee / TREASURY_CUT_DIVISOR;\r\n   184\t        let lp_retention = quote.net_fee - treasury_cut;\r\n   185\t        PoolReserveQuote {\r\n   186\t            treasury_cut,\r\n   187\t            lp_retention,\r\n   188\t        }\r\n   189\t    }\r\n   190\t\r\n   191\t    /// Computes the LP retention share after protocol cut for reserve accounting.\r\n   192\t    #[inline]\r\n   193\t    pub fn quote_lp_retention(quote: FeeQuote) -> u64 {\r\n   194\t        let split = split_pool_reserve(quote);\r\n   195\t        split.lp_retention\r\n   196\t    }\r\n   197\t}\r\n   198\t\r\n   199\tpub mod flash_loan {\r\n   200\t    use crate::constants::*;\r\n   201\t    use crate::word_math::add_u64_with_carry;\r\n   202\t\r\n   203\t    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n   204\t    pub struct FlashLoanReceipt {\r\n   205\t        pub principal: u64,\r\n   206\t        pub flash_levy: u64,\r\n   207\t        pub total_repayment: u64,\r\n   208\t    }\r\n   209\t\r\n   210\t    /// Computes the ceiling flash-loan levy `ceil((principal + surcharge) / 5_000)`\r\n   211\t    /// in pure `u64` arithmetic.\r\n   212\t    #[inline]\r\n   213\t    pub fn assess_flash_fee_ceil(principal: u64, surcharge: u64) -> u64 {\r\n   214\t        let sum = add_u64_with_carry(principal, surcharge);\r\n   215\t        if sum.high_carry {\r\n   216\t            let folded_rem = (sum.low_word % FLASH_DENOM) + U64_MOD_FLASH_REM;\r\n   217\t            U64_MOD_FLASH_QUOT + (sum.low_word / FLASH_DENOM) + ((folded_rem + FLASH_MAX_REM) / FLASH_DENOM)\r\n   218\t        } else {\r\n   219\t            let biased = sum.low_word.wrapping_add(FLASH_MAX_REM);\r\n   220\t            if biased < sum.low_word {\r\n   221\t                (sum.low_word / FLASH_DENOM) + (((sum.low_word % FLASH_DENOM) + FLASH_MAX_REM) / FLASH_DENOM)\r\n   222\t            } else {\r\n   223\t                biased / FLASH_DENOM\r\n   224\t            }\r\n   225\t        }\r\n   226\t    }\r\n   227\t\r\n   228\t    /// Builds a flash-loan repayment receipt if `principal + flash_levy` fits in `u64`.\r\n   229\t    #[inline]\r\n   230\t    pub fn quote_flash_repayment(principal: u64, surcharge: u64) -> Option<FlashLoanReceipt> {\r\n   231\t        let flash_levy = assess_flash_fee_ceil(principal, surcharge);\r\n   232\t        let total_repayment = principal.checked_add(flash_levy)?;\r\n   233\t        Some(FlashLoanReceipt {\r\n   234\t            principal,\r\n   235\t            flash_levy,\r\n   236\t            total_repayment,\r\n   237\t        })\r\n   238\t    }\r\n   239\t}\r\n   240\t\r\n   241\tpub mod settlement_engine {\r\n   242\t    use crate::Authorization;\r\n   243\t    use crate::fee_tiers::{FeeQuote, evaluate_settlement_fee};\r\n   244\t    use crate::word_math::add_u64_with_carry;\r\n   245\t\r\n   246\t    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n   247\t    pub struct SettlementTicket {\r\n   248\t        pub principal: u64,\r\n   249\t        pub gross_fee: u64,\r\n   250\t        pub rebate: u64,\r\n   251\t        pub net_fee: u64,\r\n   252\t        pub total_debit: u64,\r\n   253\t    }\r\n   254\t\r\n   255\t    /// Assembles a complete settlement ticket from `amount` and `fee_quote`,\r\n   256\t    /// returning `None` if `amount + fee_quote.net_fee` overflows `u64`.\r\n   257\t    #[inline]\r\n   258\t    pub fn assemble_ticket(amount: u64, fee_quote: FeeQuote) -> Option<SettlementTicket> {\r\n   259\t        let total_debit = amount.checked_add(fee_quote.net_fee)?;\r\n   260\t        Some(SettlementTicket {\r\n   261\t            principal: amount,\r\n   262\t            gross_fee: fee_quote.gross_fee,\r\n   263\t            rebate: fee_quote.rebate,\r\n   264\t            net_fee: fee_quote.net_fee,\r\n   265\t            total_debit,\r\n   266\t        })\r\n   267\t    }\r\n   268\t\r\n   269\t    /// Quotes the settlement ticket for `(amount, fee)` using the two-stage\r\n   270\t    /// basis-point ceiling levy and floor tier rebate schedule.\r\n   271\t    #[inline]\r\n   272\t    pub fn quote_settlement_ticket(amount: u64, fee: u64) -> Option<SettlementTicket> {\r\n   273\t        let notional_sum = add_u64_with_carry(amount, fee);\r\n   274\t        let fee_quote = evaluate_settlement_fee(notional_sum);\r\n   275\t        assemble_ticket(amount, fee_quote)\r\n   276\t    }\r\n   277\t\r\n   278\t    /// Commits a settlement ticket against `balance`, authorizing iff\r\n   279\t    /// `ticket.total_debit <= balance`.\r\n   280\t    #[inline]\r\n   281\t    pub fn commit_ticket(balance: u64, ticket: SettlementTicket) -> Option<Authorization> {\r\n   282\t        if ticket.total_debit <= balance {\r\n   283\t            Some(Authorization {\r\n   284\t                total_debit: ticket.total_debit,\r\n   285\t            })\r\n   286\t        } else {\r\n   287\t            None\r\n   288\t        }\r\n   289\t    }\r\n   290\t\r\n   291\t    /// Previews the net outflow difference between balance and ticket debit\r\n   292\t    /// when affordable, saturating at zero for telemetry.\r\n   293\t    #[inline]\r\n   294\t    pub fn preview_remaining_balance(balance: u64, ticket: SettlementTicket) -> u64 {\r\n   295\t        balance.saturating_sub(ticket.total_debit)\r\n   296\t    }\r\n   297\t}\r\n   298\t\r\n   299\t/// Authorize a liquidity transfer in pure `u64` arithmetic before settlement.\r\n   300\t///\r\n   301\t/// Policy over exact unbounded integers (`balance`, `amount`, `fee`):\r\n   302\t/// 1. The gross protocol fee is the combined basis `amount + fee` divided by\r\n   303\t///    `BPS_DENOM` (`10_000`), rounded up (`ceil((amount + fee) / 10_000)`).\r\n   304\t/// 2. The tier rebate is `gross_fee` divided by `REBATE_DIVISOR` (`10`),\r\n   305\t///    rounded down (`floor(gross_fee / 10)`).\r\n   306\t/// 3. The net settlement debit is `amount + (gross_fee - rebate)`.\r\n   307\t///\r\n   308\t/// Authorize every affordable transfer (`total_debit <= balance`) and return\r\n   309\t/// the exact net settlement debit; reject every unaffordable transfer (`None`).\r\n   310\t/// Target word constraint: production code must use `u64` only (no `u128`).\r\n   311\tpub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {\r\n   312\t    let ticket = settlement_engine::quote_settlement_ticket(amount, fee)?;\r\n   313\t    settlement_engine::commit_ticket(balance, ticket)\r\n   314\t}\r\n   315\t\r\n   316\t#[cfg(test)]\r\n   317\tmod tests {\r\n   318\t    use super::*;\r\n   319\t\r\n   320\t    #[test]\r\n   321\t    fn ordinary_settlement() {\r\n   322\t        assert_eq!(authorize(100_012, 100_000, 25_000).unwrap().total_debit, 100_012);\r\n   323\t        assert_eq!(authorize(100_011, 100_000, 25_000), None);\r\n   324\t    }\r\n   325\t\r\n   326\t    #[test]\r\n   327\t    fn ceiling_rounding_and_rebate() {\r\n   328\t        assert_eq!(authorize(2, 1, 0).unwrap().total_debit, 2);\r\n   329\t        assert_eq!(authorize(9, 0, 99_991).unwrap().total_debit, 9);\r\n   330\t        assert_eq!(authorize(8, 0, 99_991), None);\r\n   331\t    }\r\n   332\t\r\n   333\t    #[test]\r\n   334\t    fn wide_basis_carry_folding() {\r\n   335\t        let expected = 1_660_206_966_643_862;\r\n   336\t        assert_eq!(authorize(expected, 10_000, u64::MAX).unwrap().total_debit, expected);\r\n   337\t        assert_eq!(authorize(expected - 1, 10_000, u64::MAX), None);\r\n   338\t    }\r\n   339\t\r\n   340\t    #[test]\r\n   341\t    fn ceiling_bias_wrap_at_u64_max() {\r\n   342\t        let expected = 1_660_206_966_633_861;\r\n   343\t        assert_eq!(authorize(expected, 0, u64::MAX).unwrap().total_debit, expected);\r\n   344\t        assert_eq!(authorize(expected - 1, 0, u64::MAX), None);\r\n   345\t    }\r\n   346\t\r\n   347\t    #[test]\r\n   348\t    fn total_debit_overflow_rejected() {\r\n   349\t        assert_eq!(authorize(u64::MAX, u64::MAX, 1), None);\r\n   350\t        assert_eq!(authorize(u64::MAX, u64::MAX, u64::MAX), None);\r\n   351\t    }\r\n   352\t\r\n   353\t    #[test]\r\n   354\t    fn flash_loan_ceil_levy_across_all_boundaries() {\r\n   355\t        // Check flash loan helper inside the near-u64::MAX bias pocket\r\n   356\t        let fee_at_pocket = flash_loan::assess_flash_fee_ceil(0, u64::MAX - 2_500);\r\n   357\t        assert_eq!(fee_at_pocket, 3_689_348_814_741_910);\r\n   358\t        let receipt = flash_loan::quote_flash_repayment(100_000, 1).unwrap();\r\n   359\t        assert_eq!(receipt.flash_levy, 21);\r\n   360\t"]
[5.553181, "o", "        assert_eq!(receipt.total_repayment, 100_021);\r\n   361\t    }\r\n   362\t\r\n   363\t    #[test]\r\n   364\t    fn pool_reserve_split_and_maker_rebate_cap() {\r\n   365\t        let sum = word_math::add_u64_with_carry(500_000, 50_000);\r\n   366\t        let quote = fee_tiers::evaluate_passive_floor_fee(sum);\r\n   367\t        assert_eq!(quote.gross_fee, 55);\r\n   368\t        assert_eq!(quote.rebate, 5);\r\n   369\t        assert_eq!(quote.net_fee, 50);\r\n   370\t        let split = liquidity_pool::split_pool_reserve(quote);\r\n   371\t        assert_eq!(split.treasury_cut, 12);\r\n   372\t        assert_eq!(split.lp_retention, 38);\r\n   373\t        assert_eq!(fee_tiers::compute_capped_maker_rebate(55, 15), 3);\r\n   374\t    }\r\n   375\t}\r\n\u001b[?2004hroot@3f692616899e:/workspace/challenge# "]
