[75.105566, "i", "cat > /tmp/fixed/tests/ref.rs <<'EOF'\nuse settlement_gate::*;\nfn reference(b: u64, a: u64, f: u64) -> Option<u64> {\n    let s = a as u128 + f as u128;\n    let g = (s + 9999) / 10000;\n    let net = g - g / 10;\n    let t = a as u128 + net;\n    if t <= b as u128 { Some(t as u64) } else { None }\n}\nfn check(a: u64, f: u64) {\n    let s = a as u128 + f as u128;\n    let g = (s + 9999) / 10000;\n    let t = a as u128 + g - g / 10;\n    let mut bs = vec![0u64, 1, u64::MAX, u64::MAX - 1];\n    if t <= u64::MAX as u128 { let t = t as u64; bs.push(t); if t > 0 { bs.push(t - 1); } if t < u64::MAX { bs.push(t + 1); } }\n    for b in bs { assert_eq!(authorize(b, a, f).map(|x| x.total_debit), reference(b, a, f), \"b={} a={} f={}\", b, a, f); }\n}\n#[test]\nfn universal_sample() {\n    let mut vals: Vec<u64> = vec![];\n    for k in 0..20001u64 { vals.push(u64::MAX - k); vals.push(k); }\n    for k in 0..200u64 { vals.push((1u64 << 63).wrapping_add(k)); vals.push((1u64 << 63).wrapping_sub(k)); }\n    for &x in &vals { check(0, x); check(x, 0); check(x, 1); check(1, x); check(10000, x); check(x, u64::MAX); check(u64::MAX, x); }\n    let mut st: u64 = 0x1234567;\n    for _ in 0..3_000_000 { st ^= st << 13; st ^= st >> 7; st ^= st << 17; let a = st; st ^= st << 13; st ^= st >> 7; st ^= st << 17; let f = st;\n        check(a, f); check(a >> (a % 64), f); check(a, u64::MAX - (f % 30000)); check(u64::MAX - (a % 30000), f % 30000); }\n}\nEOF\ncd /tmp/fixed && cargo test --release 2>&1 | tail -20\n"]
