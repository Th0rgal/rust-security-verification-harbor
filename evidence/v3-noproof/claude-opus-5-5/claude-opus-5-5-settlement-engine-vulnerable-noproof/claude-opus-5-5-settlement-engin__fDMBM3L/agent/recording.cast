[9.342927, "o", "     1\tpub mod fee_tiers {\r\n     2\t    use crate::constants::*;\r\n     3\t    use crate::word_math::{WordSum, ceil_div_bps_u64, floor_div_bps_u64};\r\n     4\t\r\n     5\t    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n     6\t    pub struct FeeSchedule {\r\n     7\t        pub bps_denom: u64,\r\n     8\t        pub rebate_divisor: u64,\r\n     9\t        pub maker_cap_divisor: u64,\r\n    10\t    }\r\n    11\t\r\n    12\t    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    13\t    pub struct FeeQuote {\r\n    14\t        pub gross_fee: u64,\r\n    15\t        pub rebate: u64,\r\n    16\t        pub net_fee: u64,\r\n    17\t    }\r\n    18\t\r\n    19\t    /// Returns the default protocol fee schedule parameters.\r\n    20\t    #[inline]\r\n    21\t    pub fn default_schedule() -> FeeSchedule {\r\n    22\t        FeeSchedule {\r\n    23\t            bps_denom: BPS_DENOM,\r\n    24\t            rebate_divisor: REBATE_DIVISOR,\r\n    25\t            maker_cap_divisor: MAKER_REBATE_CAP_DIVISOR,\r\n    26\t        }\r\n    27\t    }\r\n    28\t\r\n    29\t    /// Computes the floor 10% tier rebate `floor(gross_fee / 10)`.\r\n    30\t    #[inline]\r\n"]
[9.342979, "o", "    31\t    pub fn compute_tier_rebate(gross_fee: u64) -> u64 {\r\n    32\t        gross_fee / REBATE_DIVISOR\r\n    33\t    }\r\n    34\t\r\n    35\t    /// Computes a capped maker rebate `min(floor(gross_fee / 10), floor(limit / 5))`\r\n    36\t    /// used by passive order-book quotes.\r\n    37\t    #[inline]\r\n    38\t    pub fn compute_capped_maker_rebate(gross_fee: u64, cap_basis: u64) -> u64 {\r\n    39\t        let base_rebate = gross_fee / REBATE_DIVISOR;\r\n    40\t        let max_rebate = cap_basis / MAKER_REBATE_CAP_DIVISOR;\r\n    41\t        if base_rebate <= max_rebate {\r\n    42\t            base_rebate\r\n    43\t        } else {\r\n    44\t            max_rebate\r\n    45\t        }\r\n    46\t    }\r\n    47\t\r\n    48\t    /// Evaluates the two-stage settlement fee quote (`gross_fee`, `rebate`, `net_fee`)\r\n    49\t    /// from a folded 64-bit notional sum.\r\n    50\t    #[inline]\r\n    51\t    pub fn evaluate_settlement_fee(sum: WordSum) -> FeeQuote {\r\n    52\t        let gross_fee = ceil_div_bps_u64(sum);\r\n    53\t        let rebate = compute_tier_rebate(gross_fee);\r\n    54\t        let net_fee = gross_fee - rebate;\r\n    55\t        FeeQuote {\r\n    56\t            gross_fee,\r\n    57\t            rebate,\r\n    58\t            net_fee,\r\n    59\t        }\r\n    60\t    }\r\n    61\t\r\n    62\t    /// Evaluates a passive liquidity floor fee quote (used by pool analytics).\r\n    63\t    #[inline]\r\n    64\t    pub fn evaluate_passive_floor_fee(sum: WordSum) -> FeeQuote {\r\n    65\t        let gross_fee = floor_div_bps_u64(sum);\r\n    66\t        let rebate = compute_tier_rebate(gross_fee);\r\n    67\t        let net_fee = gross_fee - rebate;\r\n    68\t        FeeQuote {\r\n    69\t            gross_fee,"]
[9.343017, "o", "\r\n    70\t            rebate,\r\n    71\t            net_fee,\r\n    72\t        }\r\n    73\t    }\r\n    74\t}\r\n    75\t\r\n    76\tpub mod liquidity_pool {\r\n    77\t    use crate::constants::*;\r\n    78\t    use crate::fee_tiers::FeeQuote;\r\n    79\t\r\n    80\t    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    81\t    pub struct PoolReserveQuote {\r\n    82\t        pub treasury_cut: u64,\r\n    83\t        pub lp_retention: u64,\r\n    84\t    }\r\n    85\t\r\n    86\t    /// Splits a net fee between the protocol treasury (`floor(net_fee / 4)`)\r\n    87\t    /// and liquidity providers (`net_fee - treasury_cut`).\r\n    88\t    #[inline]\r\n    89\t    pub fn split_pool_reserve(quote: FeeQuote) -> PoolReserveQuote {\r\n    90\t        let treasury_cut = quote.net_fee / TREASURY_CUT_DIVISOR;\r\n    91\t"]
[9.34305, "o", "        let lp_retention = quote.net_fee - treasury_cut;\r\n    92\t        PoolReserveQuote {\r\n"]
