     1	//! Multi-module concentrated-liquidity and flash-settlement engine.
     2	//!
     3	//! All production paths operate strictly in 64-bit word arithmetic (`u64`)
     4	//! without `u128` promotion so that settlement authorization executes natively
     5	//! on 64-bit VM word registers.
     6	
     7	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
     8	pub struct Authorization {
     9	    pub total_debit: u64,
    10	}
    11	
    12	pub mod constants {
    13	    /// Standard basis-point denominator (100% = 10_000 bps).
    14	    pub const BPS_DENOM: u64 = 10_000;
    15	    /// Maximum non-zero remainder modulo `BPS_DENOM` (`BPS_DENOM - 1`).
    16	    pub const BPS_MAX_REM: u64 = 9_999;
    17	    /// Floor quotient of `2^64` by `BPS_DENOM`: `floor(2^64 / 10_000)`.
    18	    pub const U64_MOD_BPS_QUOT: u64 = 1_844_674_407_370_955;
    19	    /// Exact remainder of `2^64` modulo `BPS_DENOM`: `2^64 % 10_000 = 1_616`.
    20	    pub const U64_MOD_BPS_REM: u64 = 1_616;
    21	    /// Tier rebate divisor (10% rebate on gross settlement fee, rounded down).
    22	    pub const REBATE_DIVISOR: u64 = 10;
    23	    /// Maker rebate cap divisor (20% cap on maker rebates in order-book mode).
    24	    pub const MAKER_REBATE_CAP_DIVISOR: u64 = 5;
    25	    /// Protocol reserve cut divisor (25% of net pool fee retained by treasury).
    26	    pub const TREASURY_CUT_DIVISOR: u64 = 4;
    27	    /// Flash-loan surcharge denominator (5_000 = 2 bps per unit).
    28	    pub const FLASH_DENOM: u64 = 5_000;
    29	    /// Ceiling bias for `FLASH_DENOM` (`FLASH_DENOM - 1`).
    30	    pub const FLASH_MAX_REM: u64 = 4_999;
    31	    /// Floor quotient `floor(2^64 / 5_000)`.
    32	    pub const U64_MOD_FLASH_QUOT: u64 = 3_689_348_814_741_910;
    33	    /// Exact remainder `2^64 % 5_000 = 1_616`.
    34	    pub const U64_MOD_FLASH_REM: u64 = 1_616;
    35	    /// Institutional notional band threshold for diagnostic classification.
    36	    pub const INSTITUTIONAL_BAND_MIN: u64 = 10_000_000_000_000;
    37	}
    38	
    39	pub mod word_math {
    40	    use crate::constants::*;
    41	
    42	    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
    43	    pub struct WordSum {
    44	        pub low_word: u64,
    45	        pub high_carry: bool,
    46	    }
    47	
    48	    /// Adds two `u64` words and captures the 64-bit wrap carry flag.
    49	    #[inline]
    50	    pub fn add_u64_with_carry(lhs: u64, rhs: u64) -> WordSum {
    51	        let low_word = lhs.wrapping_add(rhs);
    52	        let high_carry = low_word < lhs;
    53	        WordSum { low_word, high_carry }
    54	    }
    55	
    56	    /// Checks whether a combined notional exceeds the institutional liquidity band.
    57	    #[inline]
    58	    pub fn is_institutional_notional(sum: WordSum) -> bool {
    59	        if sum.high_carry {
    60	            true
    61	        } else {
    62	            sum.low_word >= INSTITUTIONAL_BAND_MIN
    63	        }
    64	    }
    65	
    66	    /// Exact floor division `floor((lhs + rhs) / 10_000)` in pure `u64` arithmetic.
    67	    #[inline]
    68	    pub fn floor_div_bps_u64(sum: WordSum) -> u64 {
    69	        if sum.high_carry {
    70	            let folded_rem = (sum.low_word % BPS_DENOM) + U64_MOD_BPS_REM;
    71	            U64_MOD_BPS_QUOT + (sum.low_word / BPS_DENOM) + (folded_rem / BPS_DENOM)
    72	        } else {
    73	            sum.low_word / BPS_DENOM
    74	        }
    75	    }
    76	
    77	    /// Ceiling division `ceil((lhs + rhs) / 10_000)` in pure `u64` arithmetic.
    78	    #[inline]
    79	    pub fn ceil_div_bps_u64(sum: WordSum) -> u64 {
    80	        if sum.high_carry {
    81	            let folded_rem = (sum.low_word % BPS_DENOM) + U64_MOD_BPS_REM;
    82	            U64_MOD_BPS_QUOT + (sum.low_word / BPS_DENOM) + ((folded_rem + BPS_MAX_REM) / BPS_DENOM)
    83	        } else {
    84	            let biased = sum.low_word.wrapping_add(BPS_MAX_REM);
    85	            if biased < sum.low_word {
    86	                (sum.low_word / BPS_DENOM) + ((biased + U64_MOD_BPS_REM) / BPS_DENOM)
    87	            } else {
    88	                biased / BPS_DENOM
    89	            }
    90	        }
    91	    }
    92	}
