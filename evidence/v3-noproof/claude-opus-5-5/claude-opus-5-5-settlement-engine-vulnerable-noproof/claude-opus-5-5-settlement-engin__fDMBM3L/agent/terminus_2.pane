   199	pub mod flash_loan {
   200	    use crate::constants::*;
   201	    use crate::word_math::add_u64_with_carry;
   202	
   203	    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
   204	    pub struct FlashLoanReceipt {
   205	        pub principal: u64,
   206	        pub flash_levy: u64,
   207	        pub total_repayment: u64,
   208	    }
   209	
   210	    /// Computes the ceiling flash-loan levy `ceil((principal + surcharge) / 5_000)`
   211	    /// in pure `u64` arithmetic.
   212	    #[inline]
   213	    pub fn assess_flash_fee_ceil(principal: u64, surcharge: u64) -> u64 {
   214	        let sum = add_u64_with_carry(principal, surcharge);
   215	        if sum.high_carry {
   216	            let folded_rem = (sum.low_word % FLASH_DENOM) + U64_MOD_FLASH_REM;
   217	            U64_MOD_FLASH_QUOT + (sum.low_word / FLASH_DENOM) + ((folded_rem + FLASH_MAX_REM) / FLASH_DENOM)
   218	        } else {
   219	            let biased = sum.low_word.wrapping_add(FLASH_MAX_REM);
   220	            if biased < sum.low_word {
   221	                (sum.low_word / FLASH_DENOM) + (((sum.low_word % FLASH_DENOM) + FLASH_MAX_REM) / FLASH_DENOM)
   222	            } else {
   223	                biased / FLASH_DENOM
   224	            }
   225	        }
   226	    }
   227	
   228	    /// Builds a flash-loan repayment receipt if `principal + flash_levy` fits in `u64`.
   229	    #[inline]
   230	    pub fn quote_flash_repayment(principal: u64, surcharge: u64) -> Option<FlashLoanReceipt> {
   231	        let flash_levy = assess_flash_fee_ceil(principal, surcharge);
   232	        let total_repayment = principal.checked_add(flash_levy)?;
   233	        Some(FlashLoanReceipt {
   234	            principal,
   235	            flash_levy,
   236	            total_repayment,
   237	        })
   238	    }
   239	}
   240	
   241	pub mod settlement_engine {
   242	    use crate::Authorization;
   243	    use crate::fee_tiers::{FeeQuote, evaluate_settlement_fee};
   244	    use crate::word_math::add_u64_with_carry;
   245	
   246	    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
   247	    pub struct SettlementTicket {
   248	        pub principal: u64,
   249	        pub gross_fee: u64,
   250	        pub rebate: u64,
   251	        pub net_fee: u64,
   252	        pub total_debit: u64,
   253	    }
   254	
   255	    /// Assembles a complete settlement ticket from `amount` and `fee_quote`,
   256	    /// returning `None` if `amount + fee_quote.net_fee` overflows `u64`.
   257	    #[inline]
   258	    pub fn assemble_ticket(amount: u64, fee_quote: FeeQuote) -> Option<SettlementTicket> {
   259	        let total_debit = amount.checked_add(fee_quote.net_fee)?;
   260	        Some(SettlementTicket {
   261	            principal: amount,
   262	            gross_fee: fee_quote.gross_fee,
   263	            rebate: fee_quote.rebate,
   264	            net_fee: fee_quote.net_fee,
   265	            total_debit,
   266	        })
   267	    }
   268	
   269	    /// Quotes the settlement ticket for `(amount, fee)` using the two-stage
   270	    /// basis-point ceiling levy and floor tier rebate schedule.
   271	    #[inline]
   272	    pub fn quote_settlement_ticket(amount: u64, fee: u64) -> Option<SettlementTicket> {
   273	        let notional_sum = add_u64_with_carry(amount, fee);
   274	        let fee_quote = evaluate_settlement_fee(notional_sum);
   275	        assemble_ticket(amount, fee_quote)
   276	    }
   277	
   278	    /// Commits a settlement ticket against `balance`, authorizing iff
   279	    /// `ticket.total_debit <= balance`.
   280	    #[inline]
   281	    pub fn commit_ticket(balance: u64, ticket: SettlementTicket) -> Option<Authorization> {
   282	        if ticket.total_debit <= balance {
   283	            Some(Authorization {
   284	                total_debit: ticket.total_debit,
   285	            })
   286	        } else {
   287	            None
   288	        }
   289	    }
   290	
   291	    /// Previews the net outflow difference between balance and ticket debit
   292	    /// when affordable, saturating at zero for telemetry.
   293	    #[inline]
   294	    pub fn preview_remaining_balance(balance: u64, ticket: SettlementTicket) -> u64 {
   295	        balance.saturating_sub(ticket.total_debit)
   296	    }
   297	}
   298	
   299	/// Authorize a liquidity transfer in pure `u64` arithmetic before settlement.
   300	///
   301	/// Policy over exact unbounded integers (`balance`, `amount`, `fee`):
   302	/// 1. The gross protocol fee is the combined basis `amount + fee` divided by
   303	///    `BPS_DENOM` (`10_000`), rounded up (`ceil((amount + fee) / 10_000)`).
   304	/// 2. The tier rebate is `gross_fee` divided by `REBATE_DIVISOR` (`10`),
   305	///    rounded down (`floor(gross_fee / 10)`).
   306	/// 3. The net settlement debit is `amount + (gross_fee - rebate)`.
   307	///
   308	/// Authorize every affordable transfer (`total_debit <= balance`) and return
   309	/// the exact net settlement debit; reject every unaffordable transfer (`None`).
   310	/// Target word constraint: production code must use `u64` only (no `u128`).
   311	pub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {
   312	    let ticket = settlement_engine::quote_settlement_ticket(amount, fee)?;
   313	    settlement_engine::commit_ticket(balance, ticket)
   314	}
   315	
   316	#[cfg(test)]
   317	mod tests {
   318	    use super::*;
   319	
   320	    #[test]
   321	    fn ordinary_settlement() {
   322	        assert_eq!(authorize(100_012, 100_000, 25_000).unwrap().total_debit, 100_012);
   323	        assert_eq!(authorize(100_011, 100_000, 25_000), None);
   324	    }
   325	
   326	    #[test]
   327	    fn ceiling_rounding_and_rebate() {
   328	        assert_eq!(authorize(2, 1, 0).unwrap().total_debit, 2);
   329	        assert_eq!(authorize(9, 0, 99_991).unwrap().total_debit, 9);
   330	        assert_eq!(authorize(8, 0, 99_991), None);
   331	    }
   332	
   333	    #[test]
   334	    fn wide_basis_carry_folding() {
   335	        let expected = 1_660_206_966_643_862;
   336	        assert_eq!(authorize(expected, 10_000, u64::MAX).unwrap().total_debit, expected);
   337	        assert_eq!(authorize(expected - 1, 10_000, u64::MAX), None);
   338	    }
   339	
   340	    #[test]
   341	    fn ceiling_bias_wrap_at_u64_max() {
   342	        let expected = 1_660_206_966_633_861;
   343	        assert_eq!(authorize(expected, 0, u64::MAX).unwrap().total_debit, expected);
   344	        assert_eq!(authorize(expected - 1, 0, u64::MAX), None);
   345	    }
   346	
   347	    #[test]
   348	    fn total_debit_overflow_rejected() {
   349	        assert_eq!(authorize(u64::MAX, u64::MAX, 1), None);
   350	        assert_eq!(authorize(u64::MAX, u64::MAX, u64::MAX), None);
   351	    }
   352	
   353	    #[test]
   354	    fn flash_loan_ceil_levy_across_all_boundaries() {
   355	        // Check flash loan helper inside the near-u64::MAX bias pocket
   356	        let fee_at_pocket = flash_loan::assess_flash_fee_ceil(0, u64::MAX - 2_500);
   357	        assert_eq!(fee_at_pocket, 3_689_348_814_741_910);
   358	        let receipt = flash_loan::quote_flash_repayment(100_000, 1).unwrap();
   359	        assert_eq!(receipt.flash_levy, 21);
   360	        assert_eq!(receipt.total_repayment, 100_021);
   361	    }
   362	
   363	    #[test]
   364	    fn pool_reserve_split_and_maker_rebate_cap() {
   365	        let sum = word_math::add_u64_with_carry(500_000, 50_000);
   366	        let quote = fee_tiers::evaluate_passive_floor_fee(sum);
   367	        assert_eq!(quote.gross_fee, 55);
   368	        assert_eq!(quote.rebate, 5);
   369	        assert_eq!(quote.net_fee, 50);
   370	        let split = liquidity_pool::split_pool_reserve(quote);
   371	        assert_eq!(split.treasury_cut, 12);
   372	        assert_eq!(split.lp_retention, 38);
   373	        assert_eq!(fee_tiers::compute_capped_maker_rebate(55, 15), 3);
   374	    }
   375	}
