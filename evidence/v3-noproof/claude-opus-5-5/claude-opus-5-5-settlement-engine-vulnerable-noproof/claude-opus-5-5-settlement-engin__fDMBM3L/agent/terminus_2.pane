    94	pub mod fee_tiers {
    95	    use crate::constants::*;
    96	    use crate::word_math::{WordSum, ceil_div_bps_u64, floor_div_bps_u64};
    97	
    98	    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
    99	    pub struct FeeSchedule {
   100	        pub bps_denom: u64,
   101	        pub rebate_divisor: u64,
   102	        pub maker_cap_divisor: u64,
   103	    }
   104	
   105	    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
   106	    pub struct FeeQuote {
   107	        pub gross_fee: u64,
   108	        pub rebate: u64,
   109	        pub net_fee: u64,
   110	    }
   111	
   112	    /// Returns the default protocol fee schedule parameters.
   113	    #[inline]
   114	    pub fn default_schedule() -> FeeSchedule {
   115	        FeeSchedule {
   116	            bps_denom: BPS_DENOM,
   117	            rebate_divisor: REBATE_DIVISOR,
   118	            maker_cap_divisor: MAKER_REBATE_CAP_DIVISOR,
   119	        }
   120	    }
   121	
   122	    /// Computes the floor 10% tier rebate `floor(gross_fee / 10)`.
   123	    #[inline]
   124	    pub fn compute_tier_rebate(gross_fee: u64) -> u64 {
   125	        gross_fee / REBATE_DIVISOR
   126	    }
   127	
   128	    /// Computes a capped maker rebate `min(floor(gross_fee / 10), floor(limit / 5))`
   129	    /// used by passive order-book quotes.
   130	    #[inline]
   131	    pub fn compute_capped_maker_rebate(gross_fee: u64, cap_basis: u64) -> u64 {
   132	        let base_rebate = gross_fee / REBATE_DIVISOR;
   133	        let max_rebate = cap_basis / MAKER_REBATE_CAP_DIVISOR;
   134	        if base_rebate <= max_rebate {
   135	            base_rebate
   136	        } else {
   137	            max_rebate
   138	        }
   139	    }
   140	
   141	    /// Evaluates the two-stage settlement fee quote (`gross_fee`, `rebate`, `net_fee`)
   142	    /// from a folded 64-bit notional sum.
   143	    #[inline]
   144	    pub fn evaluate_settlement_fee(sum: WordSum) -> FeeQuote {
   145	        let gross_fee = ceil_div_bps_u64(sum);
   146	        let rebate = compute_tier_rebate(gross_fee);
   147	        let net_fee = gross_fee - rebate;
   148	        FeeQuote {
   149	            gross_fee,
   150	            rebate,
   151	            net_fee,
   152	        }
   153	    }
   154	
   155	    /// Evaluates a passive liquidity floor fee quote (used by pool analytics).
   156	    #[inline]
   157	    pub fn evaluate_passive_floor_fee(sum: WordSum) -> FeeQuote {
   158	        let gross_fee = floor_div_bps_u64(sum);
   159	        let rebate = compute_tier_rebate(gross_fee);
   160	        let net_fee = gross_fee - rebate;
   161	        FeeQuote {
   162	            gross_fee,
   163	            rebate,
   164	            net_fee,
   165	        }
   166	    }
   167	}
