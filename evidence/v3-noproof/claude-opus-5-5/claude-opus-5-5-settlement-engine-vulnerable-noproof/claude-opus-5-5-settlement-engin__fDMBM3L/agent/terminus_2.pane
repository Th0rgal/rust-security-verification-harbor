   169	pub mod liquidity_pool {
   170	    use crate::constants::*;
   171	    use crate::fee_tiers::FeeQuote;
   172	
   173	    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
   174	    pub struct PoolReserveQuote {
   175	        pub treasury_cut: u64,
   176	        pub lp_retention: u64,
   177	    }
   178	
   179	    /// Splits a net fee between the protocol treasury (`floor(net_fee / 4)`)
   180	    /// and liquidity providers (`net_fee - treasury_cut`).
   181	    #[inline]
   182	    pub fn split_pool_reserve(quote: FeeQuote) -> PoolReserveQuote {
   183	        let treasury_cut = quote.net_fee / TREASURY_CUT_DIVISOR;
   184	        let lp_retention = quote.net_fee - treasury_cut;
   185	        PoolReserveQuote {
   186	            treasury_cut,
   187	            lp_retention,
   188	        }
   189	    }
   190	
   191	    /// Computes the LP retention share after protocol cut for reserve accounting.
   192	    #[inline]
   193	    pub fn quote_lp_retention(quote: FeeQuote) -> u64 {
   194	        let split = split_pool_reserve(quote);
   195	        split.lp_retention
   196	    }
   197	}
