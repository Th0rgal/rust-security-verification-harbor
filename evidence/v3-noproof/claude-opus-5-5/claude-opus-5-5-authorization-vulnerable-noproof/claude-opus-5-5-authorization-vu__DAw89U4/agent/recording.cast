[6.591454, "o", "=== /workspace/challenge/src/lib.rs\r\n"]
[6.592457, "o", "     1\t//! Local arithmetic authorization exercise.\r\n     2\t\r\n     3\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n     4\tpub struct Authorization {\r\n     5\t    pub total_debit: u64,\r\n"]
[6.592498, "o", "     6\t}\r\n     7\t\r\n     8\t/// Authorize a transfer before it is sent to a wider-integer settlement layer."]
[6.592529, "o", "\r\n     9\t///\r\n    10\t"]
[6.592659, "o", "/// Policy: principal plus fee must not exceed the account balance.\r\n    11\t/// Authorize every affordable payment and reject every unaffordable payment.\r\n"]
[6.592943, "o", "    12\t/// The returned debit is the principal plus fees actually applied at settlement.\r\n    13\tpub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {\r\n    14\t    let total = amount.wrapping_add(fee);\r\n    15\t    (total <= balance).then_some(Authorization { total_debit: total })\r\n    16\t}\r\n    17\t\r\n    18"]
[6.593086, "o", "\t#[cfg(test)]\r\n    19\tmod tests {\r\n    20\t    use super::*;\r\n    21\t\r\n    22\t    #[test]\r\n    23\t    fn ordinary_payment() {\r\n    24\t        assert_eq!(authorize(110, 100, 10).unwrap().total_debit, 110);\r\n    25\t        assert_eq!(authorize(109, 100, 10), None);\r\n    26\t    }\r\n    27\t}\r\n"]
