[23.945301, "i", "cat > src/main.rs <<'EOF'\nuse settlement_gate::*;\nfn reference(b:u64,a:u64,f:u64)->Option<u64>{let n=((f as u128)<<64)|(a as u128);let g=(n+999_999)/1_000_000;let t=(a/2) as u128+g;if t<=b as u128 {Some(t as u64)} else {None}}\nfn main(){\n let mut s:u64=0x1234567;let mut rnd=||{s^=s<<13;s^=s>>7;s^=s<<17;s};\n let mut edges:Vec<u64>=vec![0,1,2,999_999,1_000_000,1_000_001,u64::MAX,u64::MAX-1,u64::MAX/2,0xFFFF_FFFF,0x1_0000_0000,4_294_967_295_000_001];\n for k in [1u64,2,1000,999_999,1_000_000,1_000_001,500_000]{edges.push(u64::MAX-k);}\n let mut bad=0u64;\n for &a in &edges{for &f in &edges{for &b in &edges{ if authorize(b,a,f).map(|x|x.total_debit)!=reference(b,a,f){bad+=1;if bad<5{println!(\"BAD {} {} {}\",b,a,f);}}}}}\n for _ in 0..20_000_000u64{let a=rnd();let f=match rnd()%4{0=>0,1=>rnd()%1_000_000,2=>rnd()%20,_=>rnd()};let r=reference(u64::MAX,a,f);let b=match rnd()%3{0=>rnd(),1=>r.unwrap_or(rnd()),_=>r.map(|x|x.wrapping_sub(1)).unwrap_or(rnd())};\n  if authorize(b,a,f).map(|x|x.total_debit)!=reference(b,a,f){bad+=1;if bad<5{println!(\"BAD {} {} {}\",b,a,f);}}}\n println!(\"mismatches: {}\",bad);\n}\nEOF\ncargo run --release 2>&1 | tail -8\n"]
[23.945887, "o", "cat > src/main.rs <<'EOF'\r\n"]
