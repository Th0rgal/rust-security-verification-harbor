[6.615374, "o", "=== /workspace/challenge/src/lib.rs\r\n     1\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n     2\tpub struct Authorization {\r\n     3\t    pub total_debit: u64,\r\n     4\t}\r\n     5\t\r\n     6\tpub mod monty31 {\r\n     7\t    pub const BABY_BEAR_P: u64 = 2_013_265_921u64;\r\n     8\t    pub const BABY_BEAR_MU: u64 = 2_281_701_377u64;\r\n     9\t    pub const LIMB_BASE: u64 = 4_294_967_296u64;\r\n    10\t    pub const LIMB_MASK: u64 = 0xFFFF_FFFFu64;\r\n    11\t\r\n    12\t    #[inline]\r\n    13\t    pub fn pack_transcript(amount: u64, fee: u64) -> u64 {\r\n    14\t        let low: u64 = amount & LIMB_MASK;\r\n    15\t        let high: u64 = fee % BABY_BEAR_P;\r\n    16\t        low + high * LIMB_BASE\r\n    17\t    }\r\n    18\t\r\n    19\t    #[inline]\r\n    20\t    pub fn monty_quotient(x: u64) -> u64 {\r\n    21\t        let x_lo: u64 = x & LIMB_MASK;\r\n    22\t        (x_lo * BABY_BEAR_MU) & LIMB_MASK\r\n    23\t    }\r\n    24\t\r\n    25\t    /// Montgomery reduction of `x < P * 2^32` over the BabyBear prime\r\n    26\t    /// `P = 2013265921` (`MU = P^-1 mod 2^32 = 2281701377`).\r\n    27\t    #[inline]\r\n    28\t    pub fn monty_reduce(x: u64) -> u64 {\r\n    29\t        let t: u64 = monty_quotient(x);\r\n    30\t        let u: u64 = t * BABY_BEAR_P;\r\n    31\t        let (diff, borrow) = x.overflowing_sub(u);\r\n    32\t        let hi: u64 = diff >> 32u64;\r\n    33\t        if borrow {\r\n    34\t            if hi == LIMB_MASK {\r\n    35\t                0u64\r\n    36\t            } else {\r\n    37\t                hi + BABY_BEAR_P - LIMB_BASE\r\n    38\t            }\r\n    39\t        } else {\r\n    40\t            hi\r\n    41\t        }\r\n    42\t    }\r\n    43\t}\r\n    44\t\r\n    45\tpub mod settlement {\r\n    46\t    use crate::Authorization;\r\n    47\t    use crate::monty31;\r\n    48\t\r\n    49\t    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    50\t    pub struct PlonkyQuote {\r\n    51\t        pub principal: u64,\r\n    52\t        pub monty_surcharge: u64,\r\n    53\t        pub total_debit: u64,\r\n    54\t    }\r\n    55\t\r\n    56\t    #[inline]\r\n    57\t    pub fn build_quote(amount: u64, fee: u64) -> Option<PlonkyQuote> {\r\n    58\t        let transcript: u64 = monty31::pack_transcript(amount, fee);\r\n    59\t        let monty_surcharge: u64 = monty31::monty_reduce(transcript);\r\n    60\t        let total_debit: u64 = amount.checked_add(monty_surcharge)?;\r\n    61\t        Some(PlonkyQuote {\r\n    62\t            principal: amount,\r\n    63\t            monty_surcharge,\r\n    64\t            total_debit,\r\n    65\t        })\r\n    66\t    }\r\n    67\t\r\n    68\t    #[inline]\r\n    69\t    pub fn verify_affordability(balance: u64, quote: PlonkyQuote) -> Option<Authorization> {\r\n    70\t        if quote.total_debit <= balance {\r\n    71\t            Some(Authorization {\r\n    72\t                total_debit: quote.total_debit,\r\n    73\t            })\r\n    74\t        } else {\r\n    75\t            None\r\n    76\t        }\r\n    77\t    }\r\n    78\t}\r\n    79\t\r\n    80\t/// Authorize a Plonky3 BabyBear Montgomery settlement against `balance`.\r\n    81\t///\r\n    82\t/// In exact integer arithmetic:\r\n    83\t/// - `P = 2013265921` (BabyBear prime), `R = 2^32 = 4294967296`, `R_INV = 943718400` (`R * R_INV == 1 mod P`)\r\n    84\t/// - `transcript = (amount mod 2^32) + (fee mod P) * 2^32`\r\n    85\t/// - `monty_surcharge = (transcript * R_INV) mod P`\r\n    86\t/// - `total_debit = amount + monty_surcharge`\r\n    87\t///\r\n    88\t/// The payment is authorized iff `total_debit <= balance`.\r\n    89\t/// Production code in this crate operates on `u64` words only (`u128` is not used).\r\n    90\tpub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {\r\n    91\t    let quote: settlement::PlonkyQuote = settlement::build_quote(amount, fee)?;\r\n    92\t    settlement::verify_affordability(balance, quote)\r\n    93\t}\r\n    94\t\r\n    95\t#[cfg(test)]\r\n    96\tmod tests {\r\n    97\t    use super::*;\r\n    98\t\r\n    99\t    #[test]\r\n   100\t    fn zero_payment_is_authorized() {\r\n   101\t        assert_eq!(authorize(0, 0, 0), Some(Authorization { total_debit: 0 }));\r\n   102\t    }\r\n   103\t\r\n   104\t    #[test]\r\n   105\t    fn montgomery_identity_element() {\r\n   106\t        assert_eq!(authorize(1, 0, 1)"]
