[37.017827, "i", "cat > /tmp/reftest.rs <<'EOF'\n#[cfg(test)]\nmod reftests {\n    use super::*;\n    fn reference(b: u64, a: u64, f: u64) -> Option<u64> {\n        let p: u128 = 2013265921; let rinv: u128 = 943718400;\n        let tr: u128 = (a as u128 & 0xFFFF_FFFF) + ((f as u128) % p) * (1u128 << 32);\n        let s = (tr * rinv) % p;\n        let tot = a as u128 + s;\n        if tot <= b as u128 { Some(tot as u64) } else { None }\n    }\n    fn chk(b: u64, a: u64, f: u64) {\n        assert_eq!(authorize(b, a, f).map(|x| x.total_debit), reference(b, a, f), \"b={} a={} f={}\", b, a, f);\n    }\n    #[test]\n    fn against_reference() {\n        chk(1744830467, 1744830467, 0);\n        let edges = [0u64, 1, 2, 2013265920, 2013265921, 2013265922, 1744830467, 0xFFFF_FFFF, 1<<32, (1<<32)+1, u64::MAX, u64::MAX-1, u64::MAX-2013265920, 3758096387];\n        for &a in &edges { for &f in &edges { for &b in &edges { chk(b,a,f); } let r = reference(u64::MAX,a,f); if let Some(t)=r { chk(t,a,f); chk(t.wrapping_sub(1),a,f);} } }\n        let mut s: u64 = 0x1234567;\n        let mut nx = || { s ^= s << 13; s ^= s >> 7; s ^= s << 17; s };\n        for _ in 0..3_000_000 { let a = nx(); let f = nx(); let a = if nx()&1==0 { a & 0xFFFF_FFFF } else { a }; let r = reference(u64::MAX,a,f); let b = match r { Some(t) => t.wrapping_sub(nx()%2), None => nx() }; chk(b,a,f); }\n        for t in 3u64..2000000 { let x = t*2013265921 - (1u64<<32); let a = x & 0xFFFF_FFFF; let f = x >> 32; chk(u64::MAX, a, f); let r = reference(u64::MAX,a,f).unwrap(); chk(r-1,a,f); }\n    }\n}\nEOF\ncat /tmp/reftest.rs >> /tmp/orig/src/lib.rs; cat /tmp/reftest.rs >> /tmp/fix/src/lib.rs\n"]
