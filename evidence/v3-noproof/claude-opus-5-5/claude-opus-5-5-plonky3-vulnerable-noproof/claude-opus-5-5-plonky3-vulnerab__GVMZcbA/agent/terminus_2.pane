    68	    #[inline]
    69	    pub fn verify_affordability(balance: u64, quote: PlonkyQuote) -> Option<Authorization> {
    70	        if quote.total_debit <= balance {
    71	            Some(Authorization {
    72	                total_debit: quote.total_debit,
    73	            })
    74	        } else {
    75	            None
    76	        }
    77	    }
