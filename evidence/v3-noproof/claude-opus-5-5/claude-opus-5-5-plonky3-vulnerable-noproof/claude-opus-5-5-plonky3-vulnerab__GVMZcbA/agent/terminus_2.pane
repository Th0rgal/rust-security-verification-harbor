    56	    #[inline]
    57	    pub fn build_quote(amount: u64, fee: u64) -> Option<PlonkyQuote> {
    58	        let transcript: u64 = monty31::pack_transcript(amount, fee);
    59	        let monty_surcharge: u64 = monty31::monty_reduce(transcript);
    60	        let total_debit: u64 = amount.checked_add(monty_surcharge)?;
