    80	/// Authorize a Plonky3 BabyBear Montgomery settlement against `balance`.
    81	///
    82	/// In exact integer arithmetic:
    83	/// - `P = 2013265921` (BabyBear prime), `R = 2^32 = 4294967296`, `R_INV = 943718400` (`R * R_INV == 1 mod P`)
    84	/// - `transcript = (amount mod 2^32) + (fee mod P) * 2^32`
    85	/// - `monty_surcharge = (transcript * R_INV) mod P`
    86	/// - `total_debit = amount + monty_surcharge`
    87	///
    88	/// The payment is authorized iff `total_debit <= balance`.
    89	/// Production code in this crate operates on `u64` words only (`u128` is not used).
    90	pub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {
    91	    let quote: settlement::PlonkyQuote = settlement::build_quote(amount, fee)?;
    92	    settlement::verify_affordability(balance, quote)
    93	}
