[5.606263, "o", "=== src/lib.rs\r\n"]
[5.607253, "o", "     1\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n     2\tpub struct Authorization {\r\n     3\t    pub total_debit: u64,\r\n     4\t}\r\n     5"]
[5.607592, "o", "\t\r\n     6\tpub mod mixed_radix {\r\n     7\t    pub const RADIX_MASK: u64 = 0xFFFFu64;\r\n     8\t    pub const SHIFT_16: u64 = 16u64;\r\n     9\t    pub const SHIFT_32: u64 = 32u64;\r\n    10\t    pub const SHIFT_48: u64 = 48u64;\r\n    11\t\r\n    12\t    #[inline]\r\n    13\t    pub fn clamp_digit(a: u64, b: u64) -> u64 {\r\n    14\t        if a < b {\r\n    15\t            a\r\n    16\t        } else {\r\n    17\t            b - 1u64\r\n    18\t        }\r\n    19\t    }\r\n    20\t\r\n    21\t    /// Encode a 4-level mixed-radix coordinate `(d0, d1, d2, d3)` with radices\r\n    22\t    /// `(b0, b1, b2, b3)` in `[1, 65536]` extracted from `fee` (`waugh_indexer::MixedRadix`).\r\n    23\t    /// Since `d_i <= b_i - 1`, the encoded index satisfies\r\n    24\t    /// `d0 * b1 * b2 * b3 + d1 * b2 * b3 + d2 * b3 + d3 <= b0 * b1 * b2 * b3 - 1 <= 2^64 - 1`.\r\n    25\t    #[inline]\r\n    26\t    pub fn encode(amount: u64, fee: u64) -> u64 {\r\n    27\t        let b0: u64 = (fee & RADIX_MASK) + 1u64;\r\n    28\t        let b1: u64 = ((fee >> SHIFT_16) & RADIX_MASK) + 1u64;\r\n    29\t        let b2: u64 = ((fee >> SHIFT_32) & RADIX_MASK) + 1u64;\r\n    30\t        let b3: u64 = ((fee >> SHIFT_48) & RADIX_MASK) + 1u64;\r\n    31\t        let a0: u64 = amount & RADIX_MASK;\r\n    32\t        let a1: u64 = (amount >> SHIFT_16) & RADIX_MASK;\r\n    33\t        let a2: u64 = (amount >> SHIFT_32) & RADIX_MASK;\r\n    34\t        let a3: u64 = (amount >> SHIFT_48) & RADIX_MASK;\r\n    35\t        let d0: u64 = clamp_digit(a0, b0);\r\n    36\t        let d1: u64 = clamp_digit(a1, b1);\r\n    37\t        let d2: u64 = clamp_digit(a2, b2);\r\n    38\t        let d3: u64 = clamp_digit(a3, b3);\r\n    39\t        let o2: u64 = b3;\r\n    40\t        let o1: u64 = b2 * o2;\r\n    41\t        let o0: u64 = b1 * o1;\r\n    42\t        d0 * o0 + d1 * o1 + d2 * o2 + d3\r\n    43\t    }\r\n    44\t}\r\n    45\t\r\n    46\tpub mod settlement {\r\n    47\t    use crate::Authorization;\r\n    48\t    use crate::mixed_radix;\r\n    49\t\r\n    50\t    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    51\t    pub struct OpenPqlQuote {\r\n    52\t        pub principal_share: u64,\r\n    53\t        pub encoded_idx: u64,\r\n    54\t        pub index_surcharge: u64,\r\n    55\t        pub total_debit: u64,\r\n    56\t    }\r\n    57\t\r\n    58\t    #[inline]\r\n    59\t    pub fn build_quote(amount: u64, fee: u64) -> Option<OpenPqlQuote> {\r\n    60\t        let principal_share: u64 = amount >> 1u64;\r\n    61\t        let encoded_idx: u64 = mixed_radix::encode(amount, fee);\r\n    62\t        let index_surcharge: u64 = encoded_idx >> 1u64;\r\n    63\t        let total_debit: u64 = principal_share + index_surcharge;\r\n    64\t        Some(OpenPqlQuote {\r\n    65\t            principal_share,\r\n    66\t            encoded_idx,\r\n    67\t            index_surcharge,\r\n    68\t            total_debit,\r\n    69\t        })\r\n    70\t    }\r\n    71\t\r\n    72\t    #[inline]\r\n    73\t    pub fn verify_affordability(balance: u64, quote: OpenPqlQuote) -> Option<Authorization> {\r\n    74\t        if quote.total_debit <= balance {\r\n    75\t            Some(Authorization {\r\n    76\t                total_debit: quote.total_debit,\r\n    77\t            })\r\n    78\t        } else {\r\n    79\t            None\r\n    80\t        }\r\n    81\t    }\r\n    82\t}\r\n    83\t\r\n    84\t/// Authorize an OpenPQL 4-level mixed-radix settlement against `balance`.\r\n    85\t///\r\n    86\t/// In exact integer arithmetic:\r\n    87\t/// - For `i in {0, 1, 2, 3}`:\r\n    88\t///   - `b_i = ((fee >> (16 * i)) & 0xFFFF) + 1` in `[1, 65536]`\r\n    89\t///   - `a_i = (amount >> (16 * i)) & 0xFFFF` in `[0, 65535]`\r\n    90\t///   - `d_i = min(a_i, b_i - 1)`\r\n    91\t/// - Suffix-product offsets: `o2 = b3`, `o1 = b2 * o2`, `o0 = b1 * o1`\r\n    92\t/// - `encoded_idx = d0 * o0 + d1 * o1 + d2 * o2 + d3`\r\n    93\t/// - `total_debit = floor(amount / 2) + floor(encoded_idx / 2)`\r\n    94\t///\r\n    95\t/// The payment is authorized iff `total_debit <= balance`.\r\n    96\t/// Production code in this crate operates on `u64` words only (`u128` is not used).\r\n    97\tpub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {\r\n    98\t    let quote: settlement::OpenPqlQuote = settlement::build_quote(am"]
[5.607635, "o", "ount, fee)?;\r\n    99\t    settlement::verify_affordability(balance, quote)\r\n   100\t}\r\n   101\t\r\n   102\t#[cfg(test)]\r\n   103\tmod tests {\r\n   104\t    use super::*;\r\n   105\t\r\n   106\t    #[test]\r\n   107\t    fn zero_payment_is_authorized() {\r\n   108\t        assert_eq!(authorize(0, 0, 0), Some(Authorization { total_debit: 0 }));\r\n   109\t    }\r\n   110\t\r\n   111\t    #[test]\r\n   112\t    fn small_mixed_radix_coordinates_match_policy() {\r\n   113\t        // fee = 0x0003_0003_0003_0003 -> b_i = 4 for all i, o2 = 4, o1 = 16, o0 = 64\r\n   114\t        // amount = 0x0001_0002_0001_0002 -> d0 = 2, d1 = 1, d2 = 2, d3 = 1\r\n   115\t        // encoded_idx = 2*64 + 1*16 + 2*4 + 1 = 153\r\n   116\t        // total_debit = (281483566710786 / 2) + (153 / 2) = 140741783355393 + 76 = 140741783355469\r\n   117\t        let fee: u64 = 0x0003_0003_0003_0003;\r\n   118\t        let amount: u64 = 0x0001_0002_0001_0002;\r\n   119\t        assert_eq!(\r\n   120\t            authorize(140_741_783_355_469, amount, fee),\r\n   121\t            Some(Authorization {\r\n   122\t                total_debit: 140_741_783_355_469\r\n   123\t            })\r\n   124\t        );\r\n   125\t        assert_eq!(authorize(140_741_783_355_468, amount, fee), None);\r\n   126\t    }\r\n   127\t\r\n   128\t    #[test]\r\n   129\t    fn clamps_digits_to_radix_minus_one() {\r\n   130\t        // fee = 0 -> all b_i = 1 -> all d_i = 0 -> encoded_idx = 0\r\n   131\t        assert_eq!(\r\n   132\t            authorize(50, 100, 0),\r\n   133\t            Some(Authorization { total_debit: 50 })\r\n   134\t        );\r\n   135\t    }\r\n   136\t}\r\n"]
