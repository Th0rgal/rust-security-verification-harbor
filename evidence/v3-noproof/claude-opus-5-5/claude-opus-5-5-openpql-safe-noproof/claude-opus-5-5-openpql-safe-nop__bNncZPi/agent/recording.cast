[24.973254, "i", "rm -rf /tmp/check && cp -r /workspace/challenge /tmp/check && cd /tmp/check && mkdir -p tests && cat > tests/fuzz.rs <<'EOF'\nuse settlement_gate::*;\nfn reference(balance: u64, amount: u64, fee: u64) -> Option<u128> {\n    let mut b=[0u128;4]; let mut d=[0u128;4];\n    for i in 0..4 { b[i]=(((fee>>(16*i))&0xFFFF) as u128)+1; let a=((amount>>(16*i))&0xFFFF) as u128; d[i]=a.min(b[i]-1); }\n    let o2=b[3]; let o1=b[2]*o2; let o0=b[1]*o1;\n    let idx=d[0]*o0+d[1]*o1+d[2]*o2+d[3];\n    let t=(amount as u128)/2+idx/2;\n    if t <= balance as u128 { Some(t) } else { None }\n}\n#[test]\nfn fuzz() {\n    let mut s: u64 = 0x9E3779B97F4A7C15;\n    let mut next = || { s ^= s<<13; s ^= s>>7; s ^= s<<17; s };\n    let edges=[0u64,1,2,0xFFFF,0x10000,u64::MAX,u64::MAX-1,1<<63,(1<<63)-1,0xFFFF_FFFF_FFFF_FFFE];\n    for i in 0..20_000_000u64 {\n        let mut pick = |k: u64| -> u64 { let r=next(); match (r>>60)%4 { 0 => edges[(r as usize)%edges.len()], 1 => { let mut v=0u64; for j in 0..4 { let c=[0u64,1,0xFFFE,0xFFFF][((r>>(j*2+k))&3) as usize]; v|=c<<(16*j);} v }, _ => next() } };\n        let a=pick(1); let f=pick(3);\n        let t = reference(u64::MAX,a,f).unwrap();\n        let bal = match i%3 { 0 => next(), 1 => t as u64, _ => (t as u64).wrapping_sub(1) };\n        let r = reference(bal,a,f);\n        let got = authorize(bal,a,f).map(|x| x.total_debit as u128);\n        assert_eq!(got, r, \"bal={} a={} f={}\", bal, a, f);\n    }\n}\nEOF\ncargo test --release 2>&1 | tail -15\n"]
[24.974611, "o", "rm -rf /tmp/check && cp -r /workspace/challenge /tmp/check && cd /tmp/check && mkdir -p tests && cat > tests/fuzz.rs <<'EOF'"]
