Sending keys: ['cat > tests/ref.rs <<\'EOF\'\nuse settlement_gate::*;\n\nfn reference(b: u64, a: u64, f: u64) -> Option<u64> {\n    let s = a as u128 + f as u128;\n    let gross = (s + 9_999) / 10_000;\n    let net = gross - gross / 10;\n    let total = a as u128 + net;\n    if total <= b as u128 { Some(total as u64) } else { None }\n}\n\nfn check(b: u64, a: u64, f: u64) {\n    let got = authorize(b, a, f).map(|x| x.total_debit);\n    assert_eq!(got, reference(b, a, f), "b={} a={} f={}", b, a, f);\n}\n\nfn ref_total(a: u64, f: u64) -> u128 {\n    let s = a as u128 + f as u128;\n    let gross = (s + 9_999) / 10_000;\n    a as u128 + gross - gross / 10\n}\n\nfn balances(a: u64, f: u64) -> Vec<u64> {\n    let t = ref_total(a, f);\n    let mut v = vec![0u64, 1, u64::MAX, u64::MAX - 1];\n    for d in [-2i128, -1, 0, 1, 2] {\n        let x = t as i128 + d;\n        if x >= 0 && x <= u64::MAX as i128 { v.push(x as u64); }\n    }\n    v\n}\n\n#[test]\nfn edges() {\n    let mut vals: Vec<u64> = vec![];\n    let bases: [u64; 8] = [0, 10_000, 1 << 32, 1 << 63, u64::MAX, u64::MAX - 9_999, u64::MAX - 1_616, 18_446_744_073_709_550_000];\n    for &bv in &bases {\n        for d in 0..20_002u64.min(40) {\n            vals.push(bv.wrapping_add(d));\n            vals.push(bv.wrapping_sub(d));\n        }\n    }\n    for k in [8_383u64, 8_384, 8_385, 1_615, 1_616, 1_617, 9_998, 9_999, 10_001] {\n        vals.push(k); vals.push(u64::MAX - k); vals.push(u64::MAX - k + 1);\n    }\n    vals.sort(); vals.dedup();\n    for &a in &vals { for &f in &vals { for b in balances(a, f) { check(b, a, f); } } }\n}\n\n#[test]\nfn random() {\n    let mut s: u64 = 0x9E3779B97F4A7C15;\n    let mut next = || { s ^= s << 13; s ^= s >> 7; s ^= s << 17; s };\n    for i in 0..3_000_000u64 {\n        let mut a = next();\n        let mut f = next();\n        match i % 4 { 1 => a %= 100_000, 2 => f = u64::MAX - (f % 100_000), 3 => a = u64::MAX - (a % 1_000_000), _ => {} }\n        for b in balances(a, f) { check(b, a, f); }\n        let rb = next();\n        check(rb, a, f);\n    }\n}\nEOF\ncargo test --release 2>&1 | tail -30\n'] min_timeout_sec: 60.0 max_timeout_sec: 180.0
