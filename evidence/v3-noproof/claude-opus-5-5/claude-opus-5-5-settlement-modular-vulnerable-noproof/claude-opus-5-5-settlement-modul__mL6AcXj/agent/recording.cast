[35.98023, "o", "61c61\r\n<                 (fold.low_word / BPS_DENOM) + ((biased + U64_MOD_BPS_REM) / BPS_DENOM)\r\n---\r\n>                 U64_MOD_BPS_QUOT + ((biased + U64_MOD_BPS_REM) / BPS_DENOM)\r\n"]
