[5.787807, "o", "=== src/lib.rs\r\n"]
[5.789077, "o", "     1\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n     2\tpub struct Authorization {\r\n     3\t    pub total_debit: u64,\r\n     4\t}\r\n     5\t\r\n     6\tpub mod constants {\r\n"]
[5.789118, "o", "     7\t    /// Basis-point denominator (100% = 10_000 bps).\r\n     8\t    pub const BPS_DENOM: u64 = 10_000;\r\n"]
[5.789148, "o", "     9\t    /// Ceiling-division bias for `BPS_DENOM` (`BPS_DENOM - 1`).\r\n    10\t    pub const BPS_MAX_REM: u64 = 9_999;"]
[5.78952, "o", "\r\n    11\t    /// Floor quotient of `2^64` by `BPS_DENOM`: `floor(2^64 / 10_000)`.\r\n    12\t    pub const U64_MOD_BPS_QUOT: u64 = 1_844_674_407_370_955;\r\n    13\t    /// Exact remainder of `2^64` modulo `BPS_DENOM`: `2^64 % 10_000 = 1_616`.\r\n    14\t    pub const U64_MOD_BPS_REM: u64 = 1_616;\r\n    15\t    /// Protocol tier rebate divisor (10% rebate on gross fee, rounded down).\r\n    16\t    pub const REBATE_DIVISOR: u64 = 10;\r\n    17\t    /// Reference liquidity band threshold for diagnostics.\r\n    18\t    pub const HIGH_VALUE_THRESHOLD: u64 = 1_000_000_000_000;\r\n    19\t}\r\n    20\t\r\n    21\tpub mod bps_math {\r\n    22\t    use crate::constants::*;\r\n    23\t\r\n    24\t    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    25\t    pub struct SumFold {\r\n    26\t        pub low_word: u64,\r\n    27\t        pub wrapped_u64: bool,\r\n    28\t    }\r\n    29\t\r\n    30"]
[5.789559, "o", "\t    /// Folds the unbounded notional sum `amount + fee` into a 64-bit low word\r\n    31\t    /// and an explicit `2^64` carry flag without `u128` promotion.\r\n    32\t    #[inline]"]
[5.789761, "o", "\r\n    33\t    pub fn fold_u64_sum(amount: u64, fee: u64) -> SumFold {\r\n    34\t        let low_word = amount.wrapping_add(fee);\r\n    35\t        let wrapped_u64 = low_word < amount;\r\n    36\t        SumFold { low_word, wrapped_u64 }\r\n    37\t    }\r\n    38\t\r\n    39\t    /// Computes the floor basis-point levy `floor((amount + fee) / 10_000)`\r\n    40\t    /// in pure `u64` arithmetic across the `2^64` boundary.\r\n    41\t    #[inline]\r\n    42\t    pub fn floor_div_bps_folded(fold: SumFold) -> u64 {\r\n    43\t        if fold.wrapped_u64 {\r\n"]
[5.789804, "o", "    44\t            let rem_sum = (fold.low_word % BPS_DENOM) + U64_MOD_BPS_REM;\r\n    45\t            U64_MOD_BPS_QUOT + (fold.low_word / BPS_DENOM) + (rem_sum / BPS_DENOM)\r\n"]
[5.789861, "o", "    46\t        } else {\r\n    47\t            fold.low_word / BPS_DENOM\r\n    48\t        }\r\n    49\t    }\r\n    50"]
[5.790195, "o", "\t\r\n    51\t    /// Computes the ceiling basis-point levy `ceil((amount + fee) / 10_000)`\r\n    52\t    /// in pure `u64` arithmetic from a folded 64-bit sum.\r\n    53\t    #[inline]\r\n    54\t    pub fn ceil_div_bps_folded(fold: SumFold) -> u64 {\r\n    55\t        if fold.wrapped_u64 {\r\n    56\t            let folded_rem = (fold.low_word % BPS_DENOM) + U64_MOD_BPS_REM;\r\n    57\t            U64_MOD_BPS_QUOT + (fold.low_word / BPS_DENOM) + ((folded_rem + BPS_MAX_REM) / BPS_DENOM)\r\n    58\t        } else {\r\n    59\t            let biased = fold.low_word.wrapping_add(BPS_MAX_REM);\r\n    60\t            if biased < fold.low_word {\r\n    61\t"]
[5.790245, "o", "                (fold.low_word / BPS_DENOM) + ((biased + U64_MOD_BPS_REM) / BPS_DENOM)\r\n    62\t            } else {\r\n    63\t                biased / BPS_DENOM\r\n    64\t            }\r\n    65\t        }\r\n    66\t    }\r\n    67\t}\r\n    68\t\r\n    69\tpub mod rebate {\r\n    70\t    use crate::constants::*;\r\n    71\t\r\n    72\t    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    73\t    pub struct FeeBreakdown {\r\n    74\t        pub gross_fee: u64,"]
[5.790282, "o", "\r\n    75\t        pub rebate: u64,\r\n    76\t        pub net_fee: u64,"]
[5.790324, "o", "\r\n    77\t    }\r\n    78\t\r\n    79\t    /// Computes the floor tier rebate `floor(gross_fee / 10)` in favor of the protocol.\r\n    80\t    #[inline]"]
[5.790701, "o", "\r\n    81\t    pub fn tier_rebate_floor(gross_fee: u64) -> u64 {\r\n    82\t        gross_fee / REBATE_DIVISOR\r\n    83\t    }\r\n    84\t\r\n    85\t    /// Assembles the gross fee, floor rebate, and net settlement fee `gross_fee - rebate`.\r\n    86\t    #[inline]\r\n    87\t    pub fn compute_fee_breakdown(gross_fee: u64) -> FeeBreakdown {\r\n    88\t        let rebate = tier_rebate_floor(gross_fee);\r\n    89\t        let net_fee = gross_fee - rebate;\r\n    90\t        FeeBreakdown { gross_fee, rebate, net_fee }\r\n    91\t    }\r\n    92\t"]
[5.790746, "o", "\r\n    93\t    /// Diagnostic helper checking whether a fee breakdown qualifies as high-volume.\r\n    94\t    #[inline]\r\n    95\t    pub fn is_high_volume_levy(breakdown: FeeBreakdown) -> bool {\r\n    96\t        breakdown.gross_fee >= HIGH_VALUE_THRESHOLD\r\n    97\t    }\r\n    98\t}\r\n    99\t\r\n   100\tpub mod quote {\r\n   101\t    use crate::Authorization;\r\n   102\t    use crate::rebate::FeeBreakdown;\r\n   103\t\r\n   104\t    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n   105\t    pub struct SettlementQuote {\r\n   106\t        pub principal: u64,\r\n   107\t        pub net_fee: u64,"]
[5.790787, "o", "\r\n   108\t        pub total_debit: u64,\r\n   109\t    }"]
[5.791065, "o", "\r\n   110\t\r\n   111\t    /// Combines the payment principal `amount` with `breakdown.net_fee`, rejecting\r\n   112\t    /// if the resulting settlement debit exceeds `u64::MAX`.\r\n   113\t    #[inline]\r\n   114\t    pub fn build_settlement_quote(amount: u64, breakdown: FeeBreakdown) -> Option<SettlementQuote> {\r\n   115\t        let total_debit = amount.checked_add(breakdown.net_fee)?;\r\n   116\t        Some(SettlementQuote {\r\n   117\t            principal: amount,\r\n   118\t            net_fee: breakdown.net_fee,\r\n   119\t            total_debit,\r\n   120\t        })\r\n   121\t    }\r\n   122\t\r\n   123\t    /// Authorizes the settlement quote iff `quote.total_debit <= balance`.\r\n   124\t    #[inline]\r\n   125\t    pub fn verify_affordability(balance: u64, quote: SettlementQuote) -> Option<Authorization> {\r\n   126\t        if quote.total_debit <= balance {\r\n   127\t            Some(Authorization { total_debit: quote.total_debit })\r\n   128\t        } else {\r\n   129\t            None\r\n   130\t        }\r\n   131\t    }\r\n   132\t}\r\n   133\t\r\n   134\t/// Authorize a liquidity transfer in pure `u64` arithmetic before settlement.\r\n   135\t///\r\n   136\t/// Policy over exact unbounded integers (`balance`, `amount`, `fee`):\r\n   137\t/// 1. The gross protocol fee is the combined basis `amount + fee` divided by\r\n   138\t///    `BPS_DENOM` (`10_000`), rounded up (`ceil((amount + fee) / 10_000)`).\r\n   139\t/// 2. The tier rebate is `gross_fee` divided by `REBATE_DIVISOR` (`10`),\r\n   140\t///    rounded down (`floor(gross_fee / 10)`).\r\n   141\t/// 3. The net settlement debit is `amount + (gross_fee - rebate)`.\r\n   142\t///\r\n   143\t/// Authorize every affordable transfer (`total_debit <= balance`) and return\r\n   144\t/// the exact net settlement debit; reject every unaffordable transfer (`None`).\r\n   145\t/// Target word constraint: production code must use `u64` only (no `u128`).\r\n   146\tpub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {\r\n   147\t    let fold = bps_math::fold_u64_sum(amount, fee);\r\n   148\t    let gross_fee = bps_math::ceil_div_bps_folded(fold);\r\n   149\t    let breakdown = rebate::compute_fee_breakdown(gross_fee);\r\n   150\t    let settlement_quote = quote::build_settlement_quote(amount, breakdown)?;\r\n   151\t    quote::verify_affordability(balance, settlement_quote)\r\n   152\t}\r\n   153\t\r\n   154\t#[cfg(test)]\r\n   155\tmod tests {\r\n   156\t    use super::*;\r\n   157\t\r\n   158\t    #[test]\r\n   159\t    fn ordinary_settlement() {\r\n   160\t        assert_eq!(authorize(100_012, 100_000, 25_000).unwrap().total_debit, 100_012);\r\n   161\t        assert_eq!(authorize(100_011, 100_000, 25_000), None);\r\n   162\t    }\r\n   163\t\r\n   164\t    #[test]\r\n   165\t    fn ceiling_rounding_and_rebate() {\r\n   166\t        assert_eq!(authorize(2, 1, 0).unwrap().total_debit, 2);\r\n   167\t        assert_eq!(authorize(9, 0, 99_991).unwrap().total_debit, 9);\r\n   168\t        assert_eq!(authorize(8, 0, 99_991), None);\r\n   169\t    }\r\n   170\t\r\n   171\t    #[test]\r\n   172\t    fn wide_basis_carry_folding() {\r\n   173\t        let expected = 1_660_206_966_643_862;\r\n   174\t        assert_eq!(authorize(expected, 10_000, u64::MAX).unwrap().total_debit, expected);\r\n   175\t        assert_eq!(authorize(expected - 1, 10_000, u64::MAX), None);\r\n   176\t    }\r\n   177\t\r\n   178\t    #[test]\r\n   179\t    fn ceiling_bias_wrap_at_u64_max() {\r\n   180\t        let expected = 1_660_206_966_633_861;\r\n   181\t        assert_eq!(authorize(expected, 0, u64::MAX).unwrap().total_debit, expected);\r\n   182\t        assert_eq!(authorize(expected - 1, 0, u64::MAX), None);\r\n   183\t    }\r\n   184\t\r\n   185\t    #[test]\r\n   186\t    fn total_debit_overflow_rejected() {\r\n   187\t        assert_eq!(authorize(u64::MAX, u64::MAX, 1), None);\r\n   188\t        assert_eq!(authorize(u64::MAX, u64::MAX, u64::MAX), None);\r\n   189\t    }\r\n   190\t\r\n   191\t    #[test]\r\n   192\t    fn floor_div_helper_matches_exact_quotient() {\r\n   193\t        let fold = bps_math::fold_u64_sum(10_000, 18_446_744_073_709_550_000);\r\n   194\t        assert_eq!(bps_math::floor_div_bps_folded(fold), 1_844_674_407_370_956);\r\n   195\t    }\r\n   196\t}\r\n"]
