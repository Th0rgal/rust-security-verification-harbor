[35.969339, "o", "mkdir -p /workspace/submission/src /tmp/orig && cp -r /workspace/challenge/* /tmp/orig/ && cp src/lib.rs /workspace/submission/src/lib.rs && sed -i 's|(fold.low_word / BPS_DENOM) + ((biased + U64_MOD_BPS_REM) / BPS_DENOM)|U64_MOD_BPS_QUOT + ((biased + U64_MOD_BPS_REM) / BPS_DENOM)|' /workspace/submission/src/lib.rs && diff src/lib.rs /workspace/submission/src/lib.rs"]
