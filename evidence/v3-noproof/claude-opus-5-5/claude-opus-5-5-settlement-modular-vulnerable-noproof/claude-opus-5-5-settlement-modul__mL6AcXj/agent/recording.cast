[36.525933, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.526913, "o", "    for a in [0u64, 1, 5000, 10000] { for k in 0..30000u64 { let f = (u64::MAX - k).wrapping_sub(a); let r = reference(u64::MAX,a,f); if let Some(t)=r { for bal in [t, t-1] { if authorize(bal,a,f).map(|z|z.total_debit) != reference(bal,a,f) { bad+=1; } } } } }"]
[36.527248, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     println!(\"bad={}\", bad);\r\n\u001b[?2004l\r"]
[36.527379, "o", "\u001b[?2004h>     assert_eq!(bad, 0);\r\n\u001b[?2004l\r"]
[36.527565, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
