[36.505193, "i", "cat > /tmp/reftest.rs <<'EOF'\nuse settlement_gate::*;\nfn reference(b: u64, a: u64, f: u64) -> Option<u64> {\n    let s = a as u128 + f as u128;\n    let g = (s + 9999) / 10000;\n    let net = g - g / 10;\n    let t = a as u128 + net;\n    if t <= b as u128 { Some(t as u64) } else { None }\n}\n#[test]\nfn cex() {\n    let (b, a, f) = (1660206966633859u64, 0u64, 18446744073709549616u64);\n    println!(\"impl={:?} ref={:?}\", authorize(b, a, f), reference(b, a, f));\n}\n#[test]\nfn sweep() {\n    let mut x: u64 = 0x9E3779B97F4A7C15;\n    let mut next = || { x ^= x << 13; x ^= x >> 7; x ^= x << 17; x };\n    let edges: Vec<u64> = { let mut v = vec![]; for k in 0..20000u64 { v.push(u64::MAX - k); v.push(k); } for k in [1615u64,1616,1617,9998,9999,10000,10001] { v.push(k); v.push(u64::MAX-k);} v };\n    let mut bad = 0u64;\n    for i in 0..2_000_000u64 {\n        let a = if i % 3 == 0 { edges[(next() % edges.len() as u64) as usize] } else { next() >> (next() % 64) };\n        let f = if i % 2 == 0 { edges[(next() % edges.len() as u64) as usize] } else { next() >> (next() % 64) };\n        let r = reference(u64::MAX, a, f);\n        let bal = match r { Some(t) => [t, t.wrapping_sub(1), next()][(i % 3) as usize], None => next() };\n        let got = authorize(bal, a, f).map(|z| z.total_debit);\n        if got != reference(bal, a, f) { bad += 1; if bad < 3 { println!(\"MISMATCH b={} a={} f={} got={:?} ref={:?}\", bal, a, f, got, reference(bal,a,f)); } }\n    }\n    for a in [0u64, 1, 5000, 10000] { for k in 0..30000u64 { let f = (u64::MAX - k).wrapping_sub(a); let r = reference(u64::MAX,a,f); if let Some(t)=r { for bal in [t, t-1] { if authorize(bal,a,f).map(|z|z.total_debit) != reference(bal,a,f) { bad+=1; } } } } }\n    println!(\"bad={}\", bad);\n    assert_eq!(bad, 0);\n}\nEOF\nfor d in orig fixed; do mkdir -p /tmp/$d/tests && cp /tmp/reftest.rs /tmp/$d/tests/; done\n"]
