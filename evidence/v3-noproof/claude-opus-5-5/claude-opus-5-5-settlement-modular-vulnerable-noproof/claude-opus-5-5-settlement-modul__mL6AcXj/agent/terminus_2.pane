   181	        assert_eq!(authorize(expected, 0, u64::MAX).unwrap().total_debit, expected);
   182	        assert_eq!(authorize(expected - 1, 0, u64::MAX), None);
   183	    }
   184	
   185	    #[test]
   186	    fn total_debit_overflow_rejected() {
   187	        assert_eq!(authorize(u64::MAX, u64::MAX, 1), None);
   188	        assert_eq!(authorize(u64::MAX, u64::MAX, u64::MAX), None);
   189	    }
   190	
