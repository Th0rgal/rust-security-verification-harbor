[27.544702, "o", "root@9dac7182d9bb:/workspace/challenge# "]
[47.082963, "i", "mkdir -p /tmp/chk && cat > /tmp/chk/m.rs <<'EOF'\ninclude!(\"/workspace/challenge/src/lib.rs\");\nfn main(){let m=u64::MAX;let v=[0u64,1,2,3,m/2,m/2+1,m-2,m-1,m];let mut bad=0;for &b in &v{for &a in &v{for &f in &v{let s=a as u128+f as u128;let ok=s<=b as u128;match authorize(b,a,f){Some(x)=>{if !ok||x.total_debit as u128!=s{bad+=1;println!(\"BAD {} {} {}\",b,a,f);}}None=>{if ok{bad+=1;println!(\"BAD {} {} {}\",b,a,f);}}}}}}println!(\"bad={}\",bad);}\nEOF\nrustc -O -o /tmp/chk/m /tmp/chk/m.rs 2>&1 | tail -3 && /tmp/chk/m\n"]
