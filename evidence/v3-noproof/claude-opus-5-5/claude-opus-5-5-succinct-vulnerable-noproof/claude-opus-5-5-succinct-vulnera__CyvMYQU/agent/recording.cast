[6.068055, "i", "for f in $(find src -name '*.rs'); do echo \"=== $f\"; cat -n $f; done\n"]
[6.068707, "o", "for f in $(find src -name '*.rs'); do echo \"=== $f\"; cat -n $f; done"]
[6.068807, "o", "\r\n"]
[6.069436, "o", "\u001b[?2004l\r"]
[6.072756, "o", "=== src/lib.rs\r\n"]
[6.073861, "o", "     1\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n     2\tpub struct Authorization {"]
[6.073896, "o", "\r\n     3\t    pub total_debit: u64,\r\n     4\t}\r\n     5\t\r\n"]
[6.073924, "o", "     6\tpub mod broadword {\r\n     7\t    pub const L8: u64 = 0x0101_0101_0101_0101u64;"]
[6.073957, "o", "\r\n     8\t    pub const H8: u64 = 0x8080_8080_8080_8080u64;\r\n     9\t"]
[6.073992, "o", "    pub const M16: u64 = 0x00FF_00FF_00FF_00FFu64;\r\n    10\t    pub const L16: u64 = 0x0001_0001_0001_0001u64;\r\n    11\t\r\n"]
[6.07402, "o", "    12\t    /// Vigna's SWAR broadword non-zero byte indicator (`tov/succinct-rs` `src/broadword.rs`):\r\n    13\t    /// Sets bit `8*i + 7` iff byte `i` of `x` is non-zero.\r\n"]
[6.074051, "o", "    14\t    #[inline]\r\n    15\t    pub fn u_nz8(x: u64) -> u64 {"]
[6.07408, "o", "\r\n    16\t        ((x | H8) - L8) & H8\r\n    17\t    }"]
[6.074116, "o", "\r\n    18\t\r\n    19\t    /// Count non-zero bytes in `x` in parallel using SWAR multiplication by `L8`."]
[6.074144, "o", "\r\n    20\t    #[inline]\r\n    21\t    pub fn count_nz_bytes(x: u64) -> u64 {\r\n"]
[6.074177, "o", "    22\t        ((u_nz8(x) >> 7u64).wrapping_mul(L8)) >> 56u64\r\n    23\t    }"]
[6.074205, "o", "\r\n    24\t\r\n    25\t    /// Sum all 8 bytes of `x` in parallel using 16-bit lane folding and `L16`.\r\n    26"]
[6.074238, "o", "\t    #[inline]\r\n    27\t    pub fn sum_bytes(x: u64) -> u64 {\r\n"]
[6.074269, "o", "    28\t        let pairs: u64 = (x & M16) + ((x >> 8u64) & M16);\r\n    29\t        (pairs.wrapping_mul(L16) >> 48u64) & 0xFFFFu64"]
[6.074297, "o", "\r\n    30\t    }\r\n    31\t"]
[6.074323, "o", "}\r\n    32\t\r\n    33\t"]
[6.074359, "o", "pub mod settlement {\r\n    34\t    use crate::Authorization;\r\n    35"]
[6.07439, "o", "\t    use crate::broadword;\r\n    36\t\r\n    37\t    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n"]
[6.074423, "o", "    38\t    pub struct SuccinctQuote {\r\n    39\t        pub principal_share: u64,"]
[6.074454, "o", "\r\n    40\t        pub active_bytes: u64,\r\n    41\t        pub byte_sum: u64,\r\n"]
[6.074485, "o", "    42\t        pub total_debit: u64,\r\n    43\t    }"]
[6.074513, "o", "\r\n    44\t\r\n    45\t    #[inline]\r\n"]
[6.07454, "o", "    46\t    pub fn build_quote(amount: u64, fee: u64) -> Option<SuccinctQuote> {\r\n    47\t        let principal_share: u64 = amount >> 1u64;"]
[6.074572, "o", "\r\n    48\t        let active_bytes: u64 = broadword::count_nz_bytes(fee);\r\n    49\t        let byte_sum: u64 = broadword::sum_bytes(fee);"]
[6.074616, "o", "\r\n    50\t        let total_debit: u64 = principal_share + (active_bytes << 8u64) + byte_sum;\r\n    51\t"]
[6.074648, "o", "        Some(SuccinctQuote {\r\n"]
[6.074679, "o", "    52\t            principal_share,"]
[6.074708, "o", "\r\n    53\t            active_bytes,\r\n    54\t            byte_sum,"]
[6.074739, "o", "\r\n    55\t            total_debit,\r\n    56"]
[6.074768, "o", "\t        })\r\n    57\t    }"]
[6.074798, "o", "\r\n    58\t\r\n    59\t    #[inline]"]
[6.07483, "o", "\r\n    60\t    pub fn verify_affordability(balance: u64, quote: SuccinctQuote) -> Option<Authorization> {\r\n    61\t"]
[6.074869, "o", "        if quote.total_debit <= balance {\r\n    62\t            Some(Authorization {\r\n    63"]
[6.0749, "o", "\t                total_debit: quote.total_debit,\r\n    64\t            })\r\n    65"]
[6.074934, "o", "\t        } else {\r\n    66\t            None\r\n    67"]
[6.074966, "o", "\t        }\r\n    68\t    }\r\n    69\t"]
[6.074999, "o", "}\r\n    70\t\r\n    71\t/// Authorize a Succinct SWAR broadword byte-schedule settlement against `balance`."]
[6.075027, "o", "\r\n    72\t///\r\n    73\t/// In exact integer arithmetic, let the 8 bytes of `fee` be"]
[6.075059, "o", "\r\n    74\t/// `b_i = (fee >> (8 * i)) & 0xFF` for `i in {0, ..., 7}`:\r\n    75\t"]
[6.075091, "o", "/// - `active_bytes = sum_{i=0..7} (if b_i > 0 then 1 else 0)`\r\n    76\t/// - `byte_sum = sum_{i=0..7} b_i`\r\n    77\t/// - `total_debit = floor(amount / 2) + 256 * active_bytes + byte_sum`"]
[6.07513, "o", "\r\n    78\t///\r\n    79\t/// The payment is authorized iff `total_debit <= balance`."]
[6.075163, "o", "\r\n    80\t/// Production code in this crate operates on `u64` words only (`u128` is not used).\r\n    81\tpub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {\r\n    82"]
[6.075201, "o", "\t    let quote: settlement::SuccinctQuote = settlement::build_quote(amount, fee)?;\r\n    83\t    settlement::verify_affordability(balance, quote)\r\n    84\t"]
[6.075234, "o", "}\r\n    85\t\r\n    86\t#[cfg(test)]\r\n    87"]
[6.075265, "o", "\tmod tests {\r\n    88\t    use super::*;"]
[6.075298, "o", "\r\n    89\t\r\n    90\t    #[test]"]
[6.075329, "o", "\r\n    91\t    fn zero_payment_is_authorized() {\r\n"]
[6.07536, "o", "    92\t        assert_eq!(authorize(0, 0, 0), Some(Authorization { total_debit: 0 }));\r\n    93\t    }\r\n"]
[6.075398, "o", "    94\t\r\n    95\t    #[test]\r\n"]
[6.075431, "o", "    96\t    fn low_bit_bytes_are_counted_and_summed() {\r\n    97\t        assert_eq!(\r\n    98\t"]
[6.075469, "o", "            authorize(565, 100, 0x0201),\r\n    99\t            Some(Authorization { total_debit: 565 })\r\n   100\t"]
[6.075501, "o", "        );\r\n   101\t        assert_eq!(authorize(564, 100, 0x0201), None);\r\n   102\t    }\r\n"]
[6.075534, "o", "   103\t\r\n   104\t    #[test]\r\n   105"]
[6.075564, "o", "\t    fn full_low_bits_across_all_bytes() {\r\n   106\t        assert_eq!(\r\n   107"]
[6.075593, "o", "\t            authorize(2056, 0, broadword::L8),\r\n   108\t            Some(Authorization { total_debit: 2056 })"]
[6.075629, "o", "\r\n   109\t        );\r\n   110"]
[6.075683, "o", "\t    }\r\n   111\t}\r\n"]
[6.07658, "o", "\u001b[?2004h"]
[6.077725, "o", "root@fbba84ab2bfd:/workspace/challenge# "]
[27.841466, "i", "mkdir -p /workspace/submission/src && cd /workspace/submission && echo vulnerable > verdict.txt && echo '{\"balance\": 128, \"amount\": 0, \"fee\": 128}' > counterexample.json && cp /workspace/challenge/src/lib.rs src/lib.rs && sed -i 's/((x | H8) - L8) \\& H8/(((x | H8) - L8) | x) \\& H8/' src/lib.rs && sed -n 12,18p src/lib.rs && cat verdict.txt counterexample.json\n"]
[27.84335, "o", "mkdir -p /workspace/submission/src && cd /workspace/submission && echo vulnerable > verdict.txt && echo '{\"balance\": 128, \"amount\": 0, \"fee\": 128}' > counterexample.json && cp /workspace/challenge/src/lib.rs src/lib.rs && sed -i 's/((x | H8) - L8) \\& H8/(((x | H8) - L8) | x) \\& H8/' src/lib.rs && sed -n 12,18p src/lib.rs && cat verdict.txt counterexample.json"]
[27.844128, "o", "\r\n\u001b[?2004l\r"]
[27.856914, "o", "    /// Vigna's SWAR broadword non-zero byte indicator (`tov/succinct-rs` `src/broadword.rs`):\r\n"]
[27.857079, "o", "    /// Sets bit `8*i + 7` iff byte `i` of `x` is non-zero.\r\n    #[inline]\r\n    pub fn u_nz8(x: u64) -> u64 {\r\n        (((x | H8) - L8) | x) & H8\r\n    }\r\n\r\n"]
[27.858821, "o", "vulnerable\r\n"]
[27.85896, "o", "{\"balance\": 128, \"amount\": 0, \"fee\": 128}\r\n"]
[27.859771, "o", "\u001b[?2004hroot@fbba84ab2bfd:/workspace/submission# "]
[28.096673, "i", "rm -rf /tmp/t && cp -r /workspace/challenge /tmp/t && cp src/lib.rs /tmp/t/src/lib.rs && cat >> /tmp/t/src/lib.rs <<'EOF'\n#[cfg(test)]\nmod extra {\n    use super::*;\n    fn model(b: u64, a: u64, f: u64) -> Option<u64> {\n        let mut act: u128 = 0; let mut s: u128 = 0;\n        for i in 0..8 { let by = ((f >> (8*i)) & 0xFF) as u128; if by > 0 { act += 1; } s += by; }\n        let t = (a as u128)/2 + 256*act + s;\n        if t <= b as u128 { Some(t as u64) } else { None }\n    }\n    #[test]\n    fn brute() {\n        let mut x: u64 = 0x9E3779B97F4A7C15;\n        for _ in 0..3_000_000u64 {\n            x ^= x << 13; x ^= x >> 7; x ^= x << 17;\n            let mut f = x;\n            let mask = x.rotate_left(17);\n            for i in 0..8 { let m = (mask >> (i*3)) & 3; if m == 0 { f = (f & !(0xFFu64 << (8*i))) | (0x80u64 << (8*i)); } else if m == 1 { f &= !(0xFFu64 << (8*i)); } }\n            let a = x.rotate_left(29); let a = if x & 1 == 0 { u64::MAX - (a & 0xFFF) } else { a };\n            let t = model(u64::MAX, a, f).unwrap();\n            for b in [t, t.wrapping_sub(1), u64::MAX, 0, x] {\n                assert_eq!(authorize(b, a, f).map(|z| z.total_debit), model(b, a, f), \"{} {} {}\", b, a, f);\n            }\n        }\n        assert_eq!(authorize(128, 0, 128), None);\n        assert_eq!(authorize(384, 0, 128), Some(Authorization{total_debit:384}));\n    }\n}\nEOF\ncd /tmp/t && cargo test --release 2>&1 | tail -15\n"]
[28.097332, "o", "rm -rf /tmp/t && cp -r /workspace/challenge /tmp/t && cp src/lib.rs /tmp/t/src/lib.rs && cat >> /tmp/t/src/lib.rs <<'EOF'\r\n\u001b[?2004l\r"]
