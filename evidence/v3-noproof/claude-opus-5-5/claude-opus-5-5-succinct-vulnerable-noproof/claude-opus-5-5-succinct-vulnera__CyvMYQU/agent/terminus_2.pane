     1	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
     2	pub struct Authorization {
     3	    pub total_debit: u64,
     4	}
     5	
     6	pub mod broadword {
     7	    pub const L8: u64 = 0x0101_0101_0101_0101u64;
     8	    pub const H8: u64 = 0x8080_8080_8080_8080u64;
     9	    pub const M16: u64 = 0x00FF_00FF_00FF_00FFu64;
    10	    pub const L16: u64 = 0x0001_0001_0001_0001u64;
    11	
    12	    /// Vigna's SWAR broadword non-zero byte indicator (`tov/succinct-rs` `src/broadword.rs`):
    13	    /// Sets bit `8*i + 7` iff byte `i` of `x` is non-zero.
    14	    #[inline]
    15	    pub fn u_nz8(x: u64) -> u64 {
    16	        ((x | H8) - L8) & H8
    17	    }
    18	
    19	    /// Count non-zero bytes in `x` in parallel using SWAR multiplication by `L8`.
    20	    #[inline]
    21	    pub fn count_nz_bytes(x: u64) -> u64 {
    22	        ((u_nz8(x) >> 7u64).wrapping_mul(L8)) >> 56u64
    23	    }
    24	
    25	    /// Sum all 8 bytes of `x` in parallel using 16-bit lane folding and `L16`.
    26	    #[inline]
    27	    pub fn sum_bytes(x: u64) -> u64 {
    28	        let pairs: u64 = (x & M16) + ((x >> 8u64) & M16);
    29	        (pairs.wrapping_mul(L16) >> 48u64) & 0xFFFFu64
    30	    }
    31	}
    32	
    33	pub mod settlement {
    34	    use crate::Authorization;
    35	    use crate::broadword;
    36	
    37	    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
    38	    pub struct SuccinctQuote {
    39	        pub principal_share: u64,
    40	        pub active_bytes: u64,
    41	        pub byte_sum: u64,
    42	        pub total_debit: u64,
    43	    }
    44	
    45	    #[inline]
    46	    pub fn build_quote(amount: u64, fee: u64) -> Option<SuccinctQuote> {
    47	        let principal_share: u64 = amount >> 1u64;
    48	        let active_bytes: u64 = broadword::count_nz_bytes(fee);
    49	        let byte_sum: u64 = broadword::sum_bytes(fee);
    50	        let total_debit: u64 = principal_share + (active_bytes << 8u64) + byte_sum;
    51	        Some(SuccinctQuote {
    52	            principal_share,
    53	            active_bytes,
    54	            byte_sum,
    55	            total_debit,
    56	        })
    57	    }
    58	
    59	    #[inline]
    60	    pub fn verify_affordability(balance: u64, quote: SuccinctQuote) -> Option<Authorization> {
    61	        if quote.total_debit <= balance {
    62	            Some(Authorization {
    63	                total_debit: quote.total_debit,
    64	            })
    65	        } else {
    66	            None
    67	        }
    68	    }
    69	}
    70	
    71	/// Authorize a Succinct SWAR broadword byte-schedule settlement against `balance`.
    72	///
    73	/// In exact integer arithmetic, let the 8 bytes of `fee` be
    74	/// `b_i = (fee >> (8 * i)) & 0xFF` for `i in {0, ..., 7}`:
    75	/// - `active_bytes = sum_{i=0..7} (if b_i > 0 then 1 else 0)`
    76	/// - `byte_sum = sum_{i=0..7} b_i`
    77	/// - `total_debit = floor(amount / 2) + 256 * active_bytes + byte_sum`
    78	///
    79	/// The payment is authorized iff `total_debit <= balance`.
    80	/// Production code in this crate operates on `u64` words only (`u128` is not used).
    81	pub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {
    82	    let quote: settlement::SuccinctQuote = settlement::build_quote(amount, fee)?;
    83	    settlement::verify_affordability(balance, quote)
    84	}
