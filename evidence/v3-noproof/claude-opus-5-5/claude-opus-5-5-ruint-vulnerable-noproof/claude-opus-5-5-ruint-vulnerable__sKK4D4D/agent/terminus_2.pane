     6	pub mod mg10 {
     7	    pub const MG10_DIVISOR: u64 = 0x8003u64;
     8	    pub const MG10_RECIPROCAL: u64 = 0xFFF4u64;
     9	    pub const LIMB_MASK: u64 = 0xFFFFu64;
    10	    pub const SUB_BIAS: u64 = 0xC000_0000u64;
    11	
    12	    /// Möller-Granlund 2-by-1 normalized division (`alloy-rs/ruint` `src/algorithms/div/small.rs`)
    13	    /// for fixed normalized divisor `D = 0x8003 = 32771` and reciprocal
    14	    /// `V = floor((2^32 - 1) / D) - 2^16 = 0xFFF4 = 65524`.
    15	    /// Given `u1 < D` and `u0 < 2^16`, returns `floor((u1 * 2^16 + u0) / D)`.
    16	    #[inline]
    17	    pub fn div_2x1_mg10(u1: u64, u0: u64) -> u64 {
    18	        let q_full: u64 = (u1 * MG10_RECIPROCAL) + (u1 << 16u64) + u0 + (1u64 << 16u64);
    19	
    20	        let q1: u64 = q_full >> 16u64;
    21	        let q0: u64 = q_full & LIMB_MASK;
    22	        let r: u64 = (SUB_BIAS + u0 - q1 * MG10_DIVISOR) & LIMB_MASK;
    23	
    24	        if q0 < r {
    25	            q1 - 1u64
    26	        } else {
    27	            q1
    28	        }
    29	    }
    30	}
    31	
    32	pub mod settlement {
    33	    use crate::Authorization;
    34	    use crate::mg10;
    35	
    36	    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
    37	    pub struct RuintQuote {
    38	        pub u1: u64,
    39	        pub u0: u64,
    40	        pub quotient: u64,
    41	        pub total_debit: u64,
    42	    }
    43	
    44	    #[inline]
    45	    pub fn build_quote(amount: u64, fee: u64) -> Option<RuintQuote> {
    46	        let u1: u64 = fee % mg10::MG10_DIVISOR;
    47	        let u0: u64 = amount & mg10::LIMB_MASK;
    48	        let quotient: u64 = mg10::div_2x1_mg10(u1, u0);
    49	        let total_debit: u64 = (amount >> 1u64) + quotient;
    50	        Some(RuintQuote {
    51	            u1,
    52	            u0,
    53	            quotient,
    54	            total_debit,
    55	        })
    56	    }
    57	
    58	    #[inline]
    59	    pub fn verify_affordability(balance: u64, quote: RuintQuote) -> Option<Authorization> {
    60	        if quote.total_debit <= balance {
    61	            Some(Authorization {
    62	                total_debit: quote.total_debit,
    63	            })
    64	        } else {
    65	            None
    66	        }
    67	    }
    68	}
    69	
    70	/// Authorize a Ruint Möller-Granlund 2-by-1 normalized division settlement against `balance`.
    71	///
    72	/// In exact integer arithmetic:
    73	/// - `D = 32771` (`0x8003`), `B = 2^16 = 65536`
    74	/// - `u1 = fee mod D`, `u0 = amount mod B`
    75	/// - `quotient = floor((u1 * B + u0) / D)`
    76	/// - `total_debit = floor(amount / 2) + quotient`
    77	///
    78	/// The payment is authorized iff `total_debit <= balance`.
    79	/// Production code in this crate operates on `u64` words only (`u128` is not used).
    80	pub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {
    81	    let quote: settlement::RuintQuote = settlement::build_quote(amount, fee)?;
    82	    settlement::verify_affordability(balance, quote)
    83	}
