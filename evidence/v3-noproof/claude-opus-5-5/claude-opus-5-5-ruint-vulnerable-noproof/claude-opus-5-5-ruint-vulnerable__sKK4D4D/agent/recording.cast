[4.98482, "o", "     1\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n     2\tpub struct Authorization {\r\n     3\t    pub total_debit: u64,\r\n     4\t}\r\n     5\t\r\n     6\tpub mod mg10 {\r\n     7\t    pub const MG10_DIVISOR: u64 = 0x8003u64;\r\n     8\t    pub const MG10_RECIPROCAL: u64 = 0xFFF4u64;\r\n     9\t    pub const LIMB_MASK: u64 = 0xFFFFu64;\r\n    10\t    pub const SUB_BIAS: u64 = 0xC000_0000u64;\r\n    11\t\r\n    12\t    /// Möller-Granlund 2-by-1 normalized division (`alloy-rs/ruint` `src/algorithms/div/small.rs`)\r\n    13\t    /// for fixed normalized divisor `D = 0x8003 = 32771` and reciprocal\r\n    14\t    /// `V = floor((2^32 - 1) / D) - 2^16 = 0xFFF4 = 65524`.\r\n    15\t    /// Given `u1 < D` and `u0 < 2^16`, returns `floor((u1 * 2^16 + u0) / D)`.\r\n    16\t    #[inline]\r\n    17\t    pub fn div_2x1_mg10(u1: u64, u0: u64) -> u64 {\r\n    18\t        let q_full: u64 = (u1 * MG10_RECIPROCAL) + (u1 << 16u64) + u0 + (1u64 << 16u64);\r\n    19\t\r\n    20\t        let q1: u64 = q_full >> 16u64;\r\n    21\t        let q0: u64 = q_full & LIMB_MASK;\r\n    22\t        let r: u64 = (SUB_BIAS + u0 - q1 * MG10_DIVISOR) & LIMB_MASK;\r\n    23\t\r\n    24\t        if q0 < r {\r\n    25\t            q1 - 1u64\r\n    26\t        } else {\r\n    27\t            q1\r\n    28\t        }\r\n    29\t    }\r\n    30\t}\r\n    31\t\r\n    32\tpub mod settlement {\r\n    33\t    use crate::Authorization;\r\n"]
[4.984877, "o", "    34\t    use crate::mg10;\r\n    35\t\r\n    36\t    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    37\t    pub struct RuintQuote {\r\n    38\t        pub u1: u64,\r\n    39\t        pub u0: u64,\r\n    40\t        pub quotient: u64,\r\n    41\t        pub total_debit: u64,\r\n    42\t    }\r\n    43\t\r\n    44\t    #[inline]\r\n    45\t    pub fn build_quote(amount: u64, fee: u64) -> Option<RuintQuote> {\r\n    46\t        let u1: u64 = fee % mg10::MG10_DIVISOR;\r\n    47\t        let u0: u64 = amount & mg10::LIMB_MASK;\r\n    48\t        let quotient: u64 = mg10::div_2x1_mg10(u1, u0);\r\n    49\t        let total_debit: u64 = (amount >> 1u64) + quotient;\r\n    50\t        Some(RuintQuote {\r\n    51\t            u1,\r\n    52\t            u0,\r\n    53\t            quotient,\r\n    54\t            total_debit,\r\n    55\t        })\r\n    56\t    }\r\n    57\t\r\n    58\t    #[inline]\r\n    59\t    pub fn verify_affordability(balance: u64, quote: RuintQuote) -> Option<Authorization> {\r\n    60\t        if quote.total_debit <= balance {\r\n    61\t            Some(Authorization {\r\n    62\t                total_debit: quote.total_debit,\r\n    63\t            })\r\n    64\t        } else {\r\n    65\t            None\r\n    66\t        }\r\n    67\t    }\r\n    68\t}\r\n    69\t\r\n    70\t/// Authorize a Ruint Möller-Granlund 2-by-1 normalized division settlement against `balance`.\r\n    71\t///\r\n    72\t/// In exact integer arithmetic:\r\n    73\t/// - `D = 32771` (`0x8003`), `B = 2^16 = 65536`\r\n    74\t/// - `u1 = fee mod D`, `u0 = amount mod B`\r\n    75\t/// - `quotient = floor((u1 * B + u0) / D)`\r\n    76\t/// - `total_debit = floor(amount / 2) + quotient`\r\n    77\t///\r\n    78\t/// The payment is authorized iff `total_debit <= balance`.\r\n    79\t/// Production code in this crate operates on `u64` words only (`u128` is not used).\r\n    80\tpub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {\r\n    81\t    let quote: settlement::RuintQuote = settlement::build_quote(amount, fee)?;\r\n    82\t    settlement::verify_affordability(balance, quote)\r\n    83\t}\r\n    84\t\r\n    85\t#[cfg(test)]"]
[4.98491, "o", "\r\n    86\tmod tests {\r\n    87\t    use super::*;\r\n    88\t\r\n    89\t    #[test]\r\n    90\t    fn zero_payment_is_authorized() {\r\n    91\t        assert_eq!(authorize(0, 0, 0), Some(Authorization { total_debit: 0 }));\r\n    92\t    }\r\n    93\t\r\n    94\t    #[test]\r\n    95\t    fn exact_multiple_of_divisor() {\r\n    96\t        assert_eq!(authorize(1, 0, 1), Some(Authorization { total_debit: 1 }));\r\n    97\t        assert_eq!(authorize(0, 0, 1), None);\r\n    98\t    }\r\n    99\t\r\n   100\t    #[test]\r\n   101\t    fn two_limb_dividend_matches_policy() {\r\n   102\t        assert_eq!(\r\n   103\t            authorize(16_405, 32_771, 10),\r\n   104\t            Some(Authorization {\r\n   105\t                total_debit: 16_405\r\n   106\t            })\r\n   107\t        );\r\n   108\t    }\r\n   109\t}\r\n"]
[4.985628, "o", "\u001b[?2004hroot@148045982f45:/workspace/challenge# "]
[35.269821, "i", "mkdir -p /tmp/bf && cat > /tmp/bf/main.rs <<'EOF'\nconst D: u64 = 0x8003; const V: u64 = 0xFFF4; const M: u64 = 0xFFFF; const SB: u64 = 0xC000_0000;\nfn mg(u1: u64, u0: u64) -> u64 {\n    let q_full = (u1.wrapping_mul(V)).wrapping_add(u1 << 16).wrapping_add(u0).wrapping_add(1 << 16);\n    let q1 = q_full >> 16; let q0 = q_full & M;\n    let r = (SB.wrapping_add(u0).wrapping_sub(q1.wrapping_mul(D))) & M;\n    if q0 < r { q1.wrapping_sub(1) } else { q1 }\n}\nfn main() {\n    let mut cnt: u64 = 0;\n    for u1 in 0..D { for u0 in 0..65536u64 {\n        let e = ((u1 << 16) + u0) / D; let g = mg(u1, u0);\n        if e != g { cnt += 1; if cnt < 6 { println!(\"u1={} u0={} exact={} got={}\", u1, u0, e, g); } }\n    }}\n    println!(\"mismatches={}\", cnt);\n}\nEOF\ncd /tmp/bf && rustc -O -C overflow-checks=off main.rs -o bf && time ./bf\n"]
[35.270389, "o", "mkdir -p /tmp/bf && cat > /tmp/bf/main.rs <<'EOF'"]
