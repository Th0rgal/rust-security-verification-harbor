[30.506631, "i", "rm -rf /tmp/chk && cp -r /workspace/challenge /tmp/chk && cat >> /tmp/chk/src/lib.rs <<'EOF'\n#[cfg(test)]\nmod fuzz {\n    use super::*;\n    fn reference(b: u64, a: u64, f: u64) -> Option<u64> {\n        let p: u128 = 18446744069414584321;\n        let v: u128 = (a as u128) + ((f as u128) << 64);\n        let t: u128 = (a as u128) / 2 + v % p;\n        if t <= b as u128 { Some(t as u64) } else { None }\n    }\n    #[test]\n    fn fuzz_all() {\n        let edges: Vec<u64> = vec![0,1,2,3,0xFFFF_FFFF,0x1_0000_0000,0xFFFF_FFFF_0000_0000,0xFFFF_FFFF_0000_0001,0xFFFF_FFFF_0000_0002,u64::MAX,u64::MAX-1,1u64<<63,(1u64<<63)-1,0xFFFF_FFFE_FFFF_FFFF,0x8000_0000_FFFF_FFFF];\n        for &b in &edges { for &a in &edges { for &f in &edges {\n            assert_eq!(authorize(b,a,f).map(|x| x.total_debit), reference(b,a,f), \"{} {} {}\", b,a,f);\n        }}}\n        let mut s: u64 = 0x1234_5678_9abc_def1;\n        let mut r = || { s ^= s << 13; s ^= s >> 7; s ^= s << 17; s };\n        for _ in 0..3_000_000 {\n            let a = r(); let f = r(); let pick = r() % 4;\n            let a = if pick == 0 { a | 0xFFFF_FFFF_0000_0000 } else { a };\n            let f = if pick == 1 { f & 0xFFFF_FFFF } else { f };\n            let t = reference(u64::MAX, a, f);\n            let b = match t { Some(v) => if r() % 2 == 0 { v } else { v.saturating_sub(1) }, None => r() };\n            assert_eq!(authorize(b,a,f).map(|x| x.total_debit), reference(b,a,f), \"{} {} {}\", b,a,f);\n        }\n    }\n}\nEOF\ncd /tmp/chk && cargo test 2>&1 | tail -15; cd /workspace\n"]
