[35.137572, "i", "rm -rf /tmp/chk && cp -r /workspace/challenge /tmp/chk && cp /workspace/submission/src/lib.rs /tmp/chk/src/lib.rs && cat >> /tmp/chk/src/lib.rs <<'EOF'\n#[cfg(test)]\nmod ref_check {\n    use super::*;\n    const P: u128 = 18446744069414584321;\n    fn reference(b: u64, a: u64, f: u64) -> Option<u64> {\n        let x = (a as u128) + ((f as u128) << 64);\n        let t = (a as u128) / 2 + x % P;\n        if t <= b as u128 { Some(t as u64) } else { None }\n    }\n    #[test]\n    fn exhaustive_like() {\n        let mut s: u64 = 0x1234567;\n        let edges = [0u64, 1, 2, 0xFFFF_FFFF, 0x1_0000_0000, 0x1_0000_0001, u64::MAX, u64::MAX - 1, 0xFFFF_FFFF_0000_0000, 0xFFFF_FFFF_0000_0001, 0xFFFF_FFFF_0000_0002, 1u64<<63];\n        let mut vals: Vec<u64> = edges.to_vec();\n        for _ in 0..200 { s ^= s << 13; s ^= s >> 7; s ^= s << 17; vals.push(s); vals.push(s >> 32); vals.push(s & 0xFFFF_FFFF_0000_0000); }\n        for &a in &vals { for &f in &vals {\n            let x = (a as u128) + ((f as u128) << 64);\n            let t = (a as u128) / 2 + x % P;\n            for b in [0u64, u64::MAX, if t > u64::MAX as u128 { u64::MAX } else { t as u64 }, if t == 0 || t > u64::MAX as u128 + 1 { 0 } else { (t - 1) as u64 }] {\n                assert_eq!(authorize(b, a, f).map(|z| z.total_debit), reference(b, a, f), \"b={} a={} f={}\", b, a, f);\n            }\n        }}\n    }\n    #[test]\n    fn cex_rejected() { assert_eq!(authorize(4294967294, 0, 4294967296), None); }\n}\nEOF\ncd /tmp/chk && cargo test --release 2>&1 | tail -15\n"]
[35.138964, "o", "rm -rf /tmp/chk && cp -r /workspace/challenge /tmp/chk && cp /workspace/submission/src/lib.rs /tmp/chk/src/lib.rs && cat >> /tmp/chk/src/lib.rs <<'EOF'"]
