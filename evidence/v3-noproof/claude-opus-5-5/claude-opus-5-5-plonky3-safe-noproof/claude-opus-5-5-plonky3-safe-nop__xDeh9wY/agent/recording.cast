[30.464946, "i", "rm -rf /tmp/chk && cp -r /workspace/challenge /tmp/chk && cd /tmp/chk && cat >> src/lib.rs <<'EOF'\n#[cfg(test)]\nmod fuzz {\n    use super::*;\n    fn reference(b: u64, a: u64, f: u64) -> Option<u64> {\n        let p: u128 = 2013265921; let rinv: u128 = 943718400;\n        let t: u128 = (a as u128 % (1u128<<32)) + (f as u128 % p) * (1u128<<32);\n        let s = (t * rinv) % p;\n        let tot = a as u128 + s;\n        if tot <= b as u128 { Some(tot as u64) } else { None }\n    }\n    #[test]\n    fn fuzz() {\n        let mut s: u64 = 0x1234567;\n        let mut next = || { s ^= s << 13; s ^= s >> 7; s ^= s << 17; s };\n        let edges = [0u64,1,2,2013265920,2013265921,2013265922,4294967295,4294967296,4294967297,u64::MAX,u64::MAX-1,u64::MAX-2013265921, 1u64<<63];\n        for i in 0..20_000_000u64 {\n            let pick = |v: u64, r: u64| if r % 3 == 0 { edges[(v % edges.len() as u64) as usize] } else if r%3==1 { v } else { v & 0xFFFF_FFFF };\n            let (r1,r2,r3) = (next(),next(),next());\n            let a = pick(r1, r2>>5); let f = pick(r2, r3>>7);\n            let tot_ref = reference(u64::MAX, a, f);\n            let b = match tot_ref { Some(t) => if i % 2 == 0 { t } else { t.wrapping_sub(1) }, None => r3 };\n            let got = authorize(b, a, f).map(|x| x.total_debit);\n            assert_eq!(got, reference(b, a, f), \"b={} a={} f={}\", b, a, f);\n        }\n    }\n}\nEOF\ncargo test --release --offline 2>&1 | tail -15\n"]
[30.472425, "o", "rm -rf /tmp/chk && cp -r /workspace/challenge /tmp/chk && cd /tmp/chk && cat >> src/lib.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #[cfg(test)]\r\n\u001b[?2004l\r\u001b[?2004h> mod fuzz {\r\n\u001b[?2004l\r\u001b[?2004h>     use super::*;\r\n\u001b[?2004l\r\u001b[?2004h>     fn reference(b: u64, a: u64, f: u64) -> Option<u64> {\r\n\u001b[?2004l\r\u001b[?2004h>         let p: u128 = 2013265921; let rinv: u128 = 943718400;\r\n\u001b[?2004l\r\u001b[?2004h>         let t: u128 = (a as u128 % (1u128<<32)) + (f as u128 % p) * (1u128<<32);\r\n\u001b[?2004l\r\u001b[?2004h>         let s = (t * rinv) % p;\r\n\u001b[?2004l\r\u001b[?2004h>         let tot = a as u128 + s;\r\n\u001b[?2004l\r\u001b[?2004h>         if tot <= b as u128 { Some(tot as u64) } else { None }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     #[test]\r\n\u001b[?2004l\r\u001b[?2004h>     fn fuzz() {\r\n\u001b[?2004l\r\u001b[?2004h>         let mut s: u64 = 0x1234567;\r\n\u001b[?2004l\r\u001b[?2004h>         let mut next = || { s ^= s << 13; s ^= s >> 7; s ^= s << 17; s };\r\n\u001b[?2004l\r\u001b[?2004h>         let edges = [0u64,1,2,2013265920,2013265921,2013265922,4294967295,4294967296,4294967297,u64::MAX,u64::MAX-1,u64::MAX-2013265921, 1u64<<63];\r\n\u001b[?2004l\r\u001b[?2004h>         for i in 0..20_000_000u64 {\r\n\u001b[?2004l\r\u001b[?2004h>             let pick = |v: u64, r: u64| if r % 3 == 0 { edges[(v % edges.len() as u64) as usize] } else if r%3==1 { v } else { v & 0xFFFF_FFFF };\r\n\u001b[?2004l\r\u001b[?2004h>             let (r1,r2,r3) = (next(),next(),next());\r\n\u001b[?2004l\r\u001b[?2004h>             let a = pick(r1, r2>>5); let f = pick(r2, r3>>7);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.472515, "o", "            let tot_ref = reference(u64::MAX, a, f);\r\n\u001b[?2004l\r\u001b[?2004h>             let b = match tot_ref { Some(t) => if i % 2 == 0 { t } else { t.wrapping_sub(1) }, None => r3 };\r\n\u001b[?2004l\r\u001b[?2004h>             let got = authorize(b, a, f).map(|x| x.total_debit);\r\n\u001b[?2004l\r\u001b[?2004h>             assert_eq!(got, reference(b, a, f), \"b={} a={} f={}\", b, a, f);\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
