= r.n(); match v % 4 { 0 => specials[(v >> 8) as usize % specials.len()], 1 => v >> (v % 64), 2 => u64::MAX - (v >> (v % 64)), _ => r.n() } };\n        let amount = pick(&mut r); let fee = pick(&mut r);\n        let exp = reference(u64::MAX, amount, fee);\n        let bal = match exp { Some(t) => match i % 3 { 0 => t, 1 => t.saturating_sub(1), _ => r.n() }, None => u64::MAX };\n        let got = authorize(bal, amount, fee).map(|a| a.total_debit);\n        assert_eq!(got, reference(bal, amount, fee), "bal={} amount={} fee={}", bal, amount, fee);\n        n += 1;\n    }\n    println!("checked {}", n);\n}\nEOF\ncd /tmp/audit && cargo test --release --test audit 2>&1 | tail -20\n'] min_timeout_sec: 60.0 max_timeout_sec: 180.0
