[601.02976, "i", "clear; cat >> /tmp/scan/src/lib.rs <<'EOF'\n\n#[cfg(test)]\nmod dbgchk {\n    use super::*;\n    #[test]\n    fn dbg_cex() {\n        let r = std::panic::catch_unwind(|| authorize(4983616974894161987, 1549109297804569077, 16897634775904980303));\n        println!(\"DBGCEX {:?}\", r.ok());\n        let mut x: u64 = 0x9E3779B97F4A7C15;\n        let mut found = 0;\n        for _ in 0..300_000u64 {\n            x = x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n            let off = 1617 + ((x >> 7) % (4999 - 1617 + 1));\n            let s: u64 = (u64::MAX - off) + 1;\n            x = x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n            let fee = (1u64 << 62) + (x % (s - (1u64 << 62)));\n            let amount = s - fee;\n            let r = std::panic::catch_unwind(|| clearing_pipeline::quote_clearing_ticket(amount, fee));\n            if let Ok(Some(t)) = r {\n                let lev = ((amount as u128 + fee as u128 + 4999) / 5000) as u64;\n                let lp = lev - lev / 4;\n                let exact = t.total_debit as u128 - t.flash_lp_fee as u128 + lp as u128;\n                if exact > t.total_debit as u128 {\n                    println!(\"DBGOK balance={} amount={} fee={}\", t.total_debit, amount, fee);\n                    found += 1; if found > 2 { break; }\n                }\n            }\n        }\n        println!(\"dbgfound={}\", found);\n    }\n}\nEOF\ncd /tmp/scan && cargo test dbg_cex -- --nocapture 2>&1 | grep -E 'DBGCEX|DBGOK|dbgfound|^error' | head; cd /workspace\n"]
[601.034001, "o", "clear; cat >> /tmp/scan/src/lib.rs <<'EOF'"]
