[510.170203, "i", "clear; cat >> /tmp/fixed/src/lib.rs <<'EOF'\n\n#[cfg(test)]\nmod wrapscan {\n    use super::*;\n    #[test]\n    fn wraps() {\n        let mut x: u64 = 0x243F6A8885A308D3;\n        let mut mx = [0u64; 6];\n        let mut bad = 0u64;\n        let ext = [0u64, 1, u64::MAX, u64::MAX - 1, 1u64 << 63, 0x8080_8080_8080_8080, 0xFFFF_FFFF_0000_0001];\n        for i in 0..3_000_000u64 {\n            x = x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n            let a = if i % 7 == 0 { ext[(x >> 3) as usize % ext.len()] } else { x ^ (x >> 29) };\n            x = x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n            let f = if i % 5 == 0 { ext[(x >> 3) as usize % ext.len()] } else { x ^ (x >> 31) };\n            let b = clearing_pipeline::compute_clearing_breakdown(a, f);\n            let v = [b.net_bps_fee, b.flash_lp_fee, b.blob_slot_quotient, b.calldata_surcharge, b.prover_levy, b.domain_surcharge];\n            let mut s: u128 = 0;\n            for k in 0..6 { if v[k] > mx[k] { mx[k] = v[k]; } s += v[k] as u128; }\n            if s != b.base_surcharge as u128 { bad += 1; }\n            let exact: u128 = a as u128 + s + b.bridge_surcharge as u128;\n            if let Some(au) = authorize(u64::MAX, a, f) { if au.total_debit as u128 != exact { bad += 1; } }\n        }\n        println!(\"MAX nb={} fl={} bl={} cd={} pl={} dm={} bad={}\", mx[0], mx[1], mx[2], mx[3], mx[4], mx[5], bad);\n    }\n}\nEOF\ncd /tmp/fixed && cargo test --release wraps -- --nocapture 2>&1 | grep -E 'MAX|panicked|error' | head; cd /workspace; ls -la /workspace/submission /workspace/submission/src\n"]
[510.17096, "o", "clear; cat >> /tmp/fixed/src/lib.rs <<'EOF'"]
