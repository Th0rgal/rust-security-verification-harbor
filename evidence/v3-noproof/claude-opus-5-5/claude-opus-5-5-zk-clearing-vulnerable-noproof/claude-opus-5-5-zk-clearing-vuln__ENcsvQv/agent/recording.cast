[89.141006, "o", "use crate::constants::*;"]
[89.141118, "o", "\r\n"]
[89.145284, "o", "use crate::word_math::{WordSum, ceil_div_bps_u64, floor_div_bps_u64, is_institutional_notional};\r\n\r\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\npub struct FeeSchedule {\r\n    pub bps_denom: u64,\r\n    pub rebate_divisor: u64,\r\n    pub maker_cap_divisor: u64,\r\n}\r\n\r\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\npub struct FeeQuote {\r\n    pub gross_fee: u64,\r\n    pub rebate: u64,\r\n    pub net_fee: u64,"]
[89.14553, "o", "\r\n}\r\n\r\n#[inline]\r\n"]
[89.145575, "o", "pub fn default_schedule() -> FeeSchedule {\r\n    FeeSchedule {\r\n        bps_denom: BPS_DENOM,\r\n"]
[89.146137, "o", "        rebate_divisor: REBATE_DIVISOR,\r\n        maker_cap_divisor: MAKER_REBATE_CAP_DIVISOR,\r\n    }\r\n}\r\n\r\n#[inline]\r\npub fn compute_tier_rebate(gross_fee: u64) -> u64 {\r\n    gross_fee / REBATE_DIVISOR\r\n}\r\n\r\n#[inline]\r\npub fn compute_capped_maker_rebate(gross_fee: u64, cap_basis: u64) -> u64 {\r\n"]
[89.146648, "o", "    let base_rebate: u64 = gross_fee / REBATE_DIVISOR;\r\n    let max_rebate: u64 = cap_basis / MAKER_REBATE_CAP_DIVISOR;\r\n    if base_rebate <= max_rebate {"]
[89.146704, "o", "\r\n        base_rebate\r\n    } else {\r\n        max_rebate\r\n    }\r\n}\r\n\r\n#[inline]\r\npub fn evaluate_settlement_fee(sum: WordSum) -> FeeQuote {\r\n"]
[89.147145, "o", "\u001b[?2004hroot@ee17d3ce67f3:/workspace# "]
[108.186705, "i", "clear; rm -rf /tmp/scan && cp -r /workspace/challenge /tmp/scan && cat >> /tmp/scan/src/lib.rs <<'EOF'\n\n#[cfg(test)]\nmod scan {\n    use super::*;\n    #[test]\n    fn find_cex() {\n        let mut found = 0;\n        for s_off in [4999u64, 4000, 3000, 2000, 1617] {\n            let s: u64 = u64::MAX - s_off + 1;\n            for amount in [0u64, 1, 2, 3, 5, 10, 100, 12345, 1_000_000] {\n                let fee = s - amount;\n                let t = match clearing_pipeline::quote_clearing_ticket(amount, fee) { Some(t) => t, None => { println!(\"overflow a={} f={}\", amount, fee); continue; } };\n                let exact_levy = ((amount as u128 + fee as u128 + 4999) / 5000) as u64;\n                let exact_lp = exact_levy - exact_levy / 4;\n                let exact_total = (t.total_debit as u128) - (t.flash_lp_fee as u128) + (exact_lp as u128);\n                if exact_total > t.total_debit as u128 {\n                    let a = authorize(t.total_debit, amount, fee);\n                    println!(\"CEX balance={} amount={} fee={} reported={} exact={} auth={:?}\", t.total_debit, amount, fee, t.total_debit, exact_total, a);\n                    found += 1;\n                }\n            }\n        }\n        println!(\"found={}\", found);\n    }\n}\nEOF\ncd /tmp/scan && cargo test --release find_cex -- --nocapture 2>&1 | grep -E 'CEX|found=|overflow|error|panicked' | head -30; cd /workspace\n"]
