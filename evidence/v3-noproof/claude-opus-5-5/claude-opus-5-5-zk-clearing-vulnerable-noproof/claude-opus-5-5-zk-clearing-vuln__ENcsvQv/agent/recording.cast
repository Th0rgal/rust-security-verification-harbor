[255.146566, "o", "clear; grep -v '^\\s*//' /workspace/challenge/src/goldilocks_field.rs | grep -v '^\\s*$' | sed -n '1,60p'"]
[255.147593, "o", "\r\n"]
[255.147821, "o", "\u001b[?2004l\r"]
[255.148233, "o", "\u001b[H\u001b[J\u001b[3J"]
[255.151561, "o", "use crate::constants::*;\r\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]"]
[255.151843, "o", "\r\npub struct GoldilocksQuote {\r\n    pub folded_low: u64,\r\n    pub canonical_residue: u64,\r\n    pub bridge_fee: u64,\r\n}\r\n#[inline]\r\n"]
[255.152141, "o", "pub fn reduce_goldilocks_step1(x_lo: u64, x_hi: u64) -> (u64, bool) {\r\n    let x_hi_hi: u64 = x_hi >> 32u64;\r\n    x_lo.overflowing_sub(x_hi_hi)\r\n}\r\n#[inline]\r\npub fn reduce_goldilocks_128(x_lo: u64, x_hi: u64) -> u64 {\r\n    let x_hi_lo: u64 = x_hi & GOLDILOCKS_EPS;\r\n    let (t0, borrow): (u64, bool) = reduce_goldilocks_step1(x_lo, x_hi);\r\n    let t1: u64 = if borrow {\r\n        t0.wrapping_add(GOLDILOCKS_P)\r\n"]
[255.152307, "o", "    } else {\r\n        t0\r\n    };\r\n    let prod: u64 = x_hi_lo * GOLDILOCKS_EPS;\r\n    let (t2, carry): (u64, bool) = t1.overflowing_add(prod);"]
[255.152551, "o", "\r\n    let t3: u64 = if carry {\r\n        t2.wrapping_add(GOLDILOCKS_EPS)\r\n    } else {\r\n        t2\r\n    };\r\n    if t3 >= GOLDILOCKS_P {\r\n        t3 - GOLDILOCKS_P\r\n    } else {\r\n        t3\r\n"]
[255.152841, "o", "    }\r\n}\r\n#[inline]\r\npub fn canonicalize_goldilocks_u64(x: u64) -> u64 {\r\n    if x >= GOLDILOCKS_P {\r\n        x - GOLDILOCKS_P"]
[255.153019, "o", "\r\n    } else {\r\n        x\r\n    }\r\n}\r\n#[inline]"]
[255.153177, "o", "\r\npub fn add_goldilocks_mod(a: u64, b: u64) -> u64 {\r\n    reduce_goldilocks_128(a.wrapping_add(b), if a.wrapping_add(b) < a { 1u64 } else { 0u64 })\r\n}\r\n#[inline]\r\npub fn sub_goldilocks_mod(a: u64, b: u64) -> u64 {\r\n    let ca: u64 = canonicalize_goldilocks_u64(a);\r\n    let cb: u64 = canonicalize_goldilocks_u64(b);\r\n    if ca >= cb {\r\n        ca - cb\r\n    } else {"]
[255.153749, "o", "\r\n        (GOLDILOCKS_P - cb) + ca\r\n    }\r\n}\r\n#[inline]\r\npub fn fold_goldilocks_challenge(commitment: u64, challenge_u32: u64) -> u64 {"]
[255.153807, "o", "\r\n    let scalar: u64 = challenge_u32 & LOW32_MASK;\r\n    let lo_limb: u64 = commitment & LOW32_MASK;\r\n"]
[255.153909, "o", "\u001b[?2004hroot@ee17d3ce67f3:/workspace# "]
[261.650268, "i", "clear; grep -n 'pub fn' /workspace/challenge/src/goldilocks_field.rs; awk '/pub fn quote_bridge_verifier_fee/,/^}/' /workspace/challenge/src/goldilocks_field.rs; awk '/pub fn fold_goldilocks_challenge/,/^}/' /workspace/challenge/src/goldilocks_field.rs\n"]
[261.662046, "o", "clear; grep -n 'pub fn' /workspace/challenge/src/goldilocks_field.rs; awk '/pub fn quote_bridge_verifier_fee/,/^}/' /workspace/challenge/src/goldilocks_field.rs; awk '/pub fn fold_goldilocks_challenge/,/^}/' /workspace/challenge/src/goldilocks_field.rs\r\n\u001b[?2004l\r"]
[261.664002, "o", "\u001b[H\u001b[J\u001b[3J"]
[261.676566, "o", "\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K reduce_goldilocks_step1(x_lo: u64, x_hi: u64) -> (u64, bool) {\r\n\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K reduce_goldilocks_128(x_lo: u64, x_hi: u64) -> u64 {\r\n\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K canonicalize_goldilocks_u64(x: u64) -> u64 {\r\n\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K add_goldilocks_mod(a: u64, b: u64) -> u64 {\r\n\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K sub_goldilocks_mod(a: u64, b: u64) -> u64 {\r\n\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K fold_goldilocks_challenge(commitment: u64, challenge_u32: u64) -> u64 {\r\n\u001b[32m\u001b[K98\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K quote_bridge_verifier_fee(amount: u64, fee: u64) -> GoldilocksQuote {\r\n"]
[261.679944, "o", "pub fn quote_bridge_verifier_fee(amount: u64, fee: u64) -> GoldilocksQuote {"]
[261.680201, "o", "\r\n"]
[261.6803, "o", "    let (folded_low, _borrow): (u64, bool) = reduce_goldilocks_step1(amount, fee);"]
[261.680395, "o", "\r\n"]
[261.680511, "o", "    let canonical_residue: u64 = reduce_goldilocks_128(amount, fee);"]
[261.680731, "o", "\r\n    let bridge_fee: u64 = canonical_residue;"]
[261.680898, "o", "\r\n    GoldilocksQuote {\r\n        folded_low,\r\n        canonical_residue,\r\n        bridge_fee,\r\n    }\r\n}"]
[261.681423, "o", "\r\n"]
[261.693433, "o", "pub fn fold_goldilocks_challenge(commitment: u64, challenge_u32: u64) -> u64 {\r\n    let scalar: u64 = challenge_u32 & LOW32_MASK;\r\n    let lo_limb: u64 = commitment & LOW32_MASK;\r\n    let hi_limb: u64 = commitment >> 32u64;\r\n    let prod_lo: u64 = lo_limb * scalar;\r\n    let prod_hi: u64 = hi_limb * scalar;"]
[261.694121, "o", "\r\n    let x_lo: u64 = prod_lo.wrapping_add(prod_hi << 32u64);\r\n    let carry: u64 = if x_lo < prod_lo { 1u64 } else { 0u64 };\r\n    let x_hi: u64 = (prod_hi >> 32u64) + carry;\r\n    reduce_goldilocks_128(x_lo, x_hi)\r\n}\r\n"]
[261.702743, "o", "\u001b[?2004h"]
[261.703944, "o", "root@ee17d3ce67f3:/workspace# "]
[278.809564, "i", "clear; cat >> /tmp/scan/src/lib.rs <<'EOF'\n\n#[cfg(test)]\nmod scan3 {\n    use super::*;\n    #[test]\n    fn rnd() {\n        let mut x: u64 = 0x9E3779B97F4A7C15;\n        let mut found = 0;\n        for _ in 0..2_000_000u64 {\n            x = x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n            let off = 1617 + ((x >> 7) % (4999 - 1617 + 1));\n            let s: u64 = (u64::MAX - off) + 1;\n            x = x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n            let fee = (1u64 << 62) + (x % (s - (1u64 << 62)));\n            let amount = s - fee;\n            if let Some(t) = clearing_pipeline::quote_clearing_ticket(amount, fee) {\n                let lev = ((amount as u128 + fee as u128 + 4999) / 5000) as u64;\n                let lp = lev - lev / 4;\n                let exact = t.total_debit as u128 - t.flash_lp_fee as u128 + lp as u128;\n                if exact > t.total_debit as u128 {\n                    println!(\"CEX balance={} amount={} fee={} exact={} auth={:?}\", t.total_debit, amount, fee, exact, authorize(t.total_debit, amount, fee));\n                    found += 1;\n                    if found > 5 { break; }\n                }\n            }\n        }\n        println!(\"found={}\", found);\n    }\n}\nEOF\ncd /tmp/scan && cargo test --release rnd -- --nocapture 2>&1 | grep -E 'CEX|found=|error|panicked' | head -20; cd /workspace\n"]
[278.809979, "o", "clear; cat >> /tmp/scan/src/lib.rs <<'EOF'"]
[278.810541, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[278.810596, "o", "> \r\n"]
[278.810663, "o", "\u001b[?2004l\r"]
