[108.193629, "o", "                    found += 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.193672, "o", "                }\r\n"]
[108.193796, "o", "\u001b[?2004l\r\u001b[?2004h"]
[108.193855, "o", ">             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.194004, "o", "        }\r\n\u001b[?2004l\r"]
