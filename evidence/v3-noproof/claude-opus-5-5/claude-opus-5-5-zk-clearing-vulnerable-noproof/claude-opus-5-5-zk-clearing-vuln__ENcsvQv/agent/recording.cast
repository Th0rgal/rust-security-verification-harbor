[679.897098, "i", "clear; cat >> /tmp/scan/src/lib.rs <<'EOF'\n\n#[cfg(test)]\nmod dbgchk2 {\n    use super::*;\n    #[test]\n    fn dbg_onebyte() {\n        std::panic::set_hook(Box::new(|_| {}));\n        let mut found = 0;\n        let mut panics = 0u64;\n        'outer: for b in 1u64..=255 {\n            let fee = b << 56;\n            for off in 1617u64..=4999 {\n                let s: u64 = (u64::MAX - off) + 1;\n                let amount = s - fee;\n                match std::panic::catch_unwind(|| clearing_pipeline::quote_clearing_ticket(amount, fee)) {\n                    Err(_) => { panics += 1; }\n                    Ok(Some(t)) => {\n                        let lev = ((amount as u128 + fee as u128 + 4999) / 5000) as u64;\n                        let lp = lev - lev / 4;\n                        let exact = t.total_debit as u128 - t.flash_lp_fee as u128 + lp as u128;\n                        if exact > t.total_debit as u128 {\n                            let a = std::panic::catch_unwind(|| authorize(t.total_debit, amount, fee));\n                            println!(\"OB balance={} amount={} fee={} exact={} auth={:?}\", t.total_debit, amount, fee, exact, a.ok());\n                            found += 1; if found > 3 { break 'outer; }\n                        }\n                    }\n                    Ok(None) => {}\n                }\n            }\n        }\n        println!(\"obfound={} panics={}\", found, panics);\n    }\n}\nEOF\ncd /tmp/scan && cargo test dbg_onebyte -- --nocapture 2>&1 | grep -E '^OB|obfound|^error' | head; cd /workspace\n"]
