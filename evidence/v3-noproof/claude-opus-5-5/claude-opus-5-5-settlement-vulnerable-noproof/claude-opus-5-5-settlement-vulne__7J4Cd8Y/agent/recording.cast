[133.704455, "i", "sed -i '/^\\/\\/!/d' src/lib.rs && cat > src/main.rs <<'EOF'\ninclude!(\"lib.rs\");\nfn reference(balance:u64,amount:u64,fee:u64)->Option<u64>{\n    let s=amount as u128 + fee as u128; let g=(s+9999)/10000; let r=g/10; let t=amount as u128 + g - r;\n    if t<=balance as u128 { Some(t as u64) } else { None }\n}\nfn main(){\n    let b=1660206966643859u64; let a=10000u64; let f=18446744073709539999u64;\n    println!(\"orig authorize = {:?}\", authorize(b,a,f));\n    println!(\"reference = {:?}\", reference(b,a,f));\n    println!(\"raw_sum = {}\", a.wrapping_add(f));\n    let mut bad=0u64;\n    for d in 0..30000u64 { let s=u64::MAX-d; for a in [0u64,1,10000,s/2] { if a> s {continue;} let f=s-a;\n        let o=authorize(u64::MAX,a,f).map(|x|x.total_debit); let r=reference(u64::MAX,a,f); if o!=r { bad+=1; if bad<4 {println!(\"mismatch s={} a={} o={:?} r={:?}\",s,a,o,r);} } } }\n    println!(\"mismatches={}\",bad);\n}\nEOF\nrustc -O -C overflow-checks=off src/main.rs -o v 2>&1 | grep -E '^error' | head; ./v\n"]
