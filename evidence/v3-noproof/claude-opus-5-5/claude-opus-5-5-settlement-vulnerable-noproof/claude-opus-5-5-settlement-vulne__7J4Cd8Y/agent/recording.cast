[157.939129, "o", "///    rounded down (`floor(gross_fee / 10)`).\r\n/// 3. The net settlement debit is `amount + (gross_fee - rebate)`.\r\n///\r\n/// Authorize every affordable transfer (`total_debit <= balance`) and return\r\n/// the exact net settlement debit; reject every unaffordable transfer (`None`).\r\n/// Target word constraint: production code must use `u64` only (no `u128`).\r\npub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {\r\n    let raw_sum = amount.wrapping_add(fee);\r\n    let gross_fee = if raw_sum < amount {\r\n        let folded_rem = (raw_sum % BPS_DENOM) + U64_MOD_BPS_REM;\r\n        U64_MOD_BPS_QUOT + (raw_sum / BPS_DENOM) + ((folded_rem + BPS_MAX_REM) / BPS_DENOM)\r\n    } else {\r\n        raw_sum.div_ceil(BPS_DENOM)\r\n    };\r\n    let rebate = gross_fee / REBATE_DIVISOR;\r\n    let net_fee = gross_fee - rebate;\r\n    let total_debit = amount.checked_add(net_fee)?;\r\n    (total_debit <= balance).then_some(Authorization { total_debit })\r\n}\r\n\r\n"]
[157.939185, "o", "#[cfg(test)]\r\n\u001b[?2004hroot@bcf48b6c3526:/workspace/submission# "]
[158.901482, "i", "cd /tmp/verify && sed '/^\\/\\/!/d' /workspace/submission/src/lib.rs > src/lib.rs && cat > src/main.rs <<'EOF'\ninclude!(\"lib.rs\");\nfn reference(balance:u64,amount:u64,fee:u64)->Option<u64>{\n    let s=amount as u128 + fee as u128; let g=(s+9999)/10000; let r=g/10; let t=amount as u128 + g - r;\n    if t<=balance as u128 { Some(t as u64) } else { None }\n}\nfn main(){\n    let mut bad=0u64; let mut n=0u64;\n    let mut x:u64=0x9E3779B97F4A7C15;\n    let mut rnd=||{x^=x<<13;x^=x>>7;x^=x<<17;x};\n    for d in 0..40000u64 { let s=u64::MAX-d; for a in [0u64,1,9999,10000,s/2,s] { let f=s-a;\n        for bal in [u64::MAX,0] { let o=authorize(bal,a,f).map(|x|x.total_debit); let r=reference(bal,a,f); if o!=r {bad+=1;} n+=1; }\n        if let Some(t)=reference(u64::MAX,a,f) { for bal in [t, t.wrapping_sub(1)] { if authorize(bal,a,f).map(|x|x.total_debit)!=reference(bal,a,f){bad+=1;} n+=1; } } } }\n    for _ in 0..3000000 { let a=rnd(); let f=rnd()>>(rnd()%64); let b=rnd();\n        for (a,f) in [(a,f),(f,a),(u64::MAX-(rnd()%30000),f%20000),(rnd()%20000, u64::MAX-(rnd()%30000))] {\n        let t=reference(u64::MAX,a,f);\n        for bal in [b, u64::MAX, t.unwrap_or(0), t.unwrap_or(1).wrapping_sub(1)] { if authorize(bal,a,f).map(|x|x.total_debit)!=reference(bal,a,f){bad+=1; if bad<4{println!(\"bad {} {} {}\",bal,a,f);}} n+=1; } } }\n    println!(\"checked={} mismatches={}\",n,bad);\n}\nEOF\nrustc -O -C overflow-checks=off src/main.rs -o v 2>&1 | grep -E '^error' | head; ./v\n"]
