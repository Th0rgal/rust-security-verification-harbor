[33.400427, "i", "cat > tests/ref.rs <<'EOF'\nuse settlement_gate::authorize;\nfn reference(b: u64, a: u64, f: u64) -> Option<u64> {\n    let s = a as u128 + f as u128;\n    let g = (s + 9_999) / 10_000;\n    let net = g - g / 10;\n    let t = a as u128 + net;\n    if t <= b as u128 { Some(t as u64) } else { None }\n}\nfn check(b: u64, a: u64, f: u64) {\n    let got = authorize(b, a, f).map(|x| x.total_debit);\n    assert_eq!(got, reference(b, a, f), \"b={} a={} f={}\", b, a, f);\n}\n#[test]\nfn compare() {\n    let mut special: Vec<u64> = vec![0, 1, 2, 9, 10, 9_998, 9_999, 10_000, 10_001, 1_615, 1_616, 1_617, 8_383, 8_384, 8_385];\n    for d in 0..20_001u64 { special.push(u64::MAX - d); }\n    for k in [u64::MAX / 2, u64::MAX / 2 + 1, 1u64 << 63, (1u64 << 63) - 1] { for d in 0..3 { special.push(k.wrapping_add(d)); special.push(k.wrapping_sub(d)); } }\n    let mut x: u64 = 0x9E3779B97F4A7C15;\n    let mut rnd = || { x ^= x << 13; x ^= x >> 7; x ^= x << 17; x };\n    let small: Vec<u64> = special.iter().cloned().step_by(37).chain([0,1,9_999,10_000,u64::MAX,u64::MAX-9_998, u64::MAX-1_615,u64::MAX-1_616]).collect();\n    for &a in &small { for &f in &special {\n        let r = reference(u64::MAX, a, f);\n        let bs = match r { Some(t) => vec![t, t.wrapping_sub(1), t.saturating_add(1), u64::MAX, 0], None => vec![u64::MAX, 0] };\n        for b in bs { check(b, a, f); check(b, f, a); }\n    }}\n    for _ in 0..3_000_000 {\n        let a = rnd(); let f = rnd() >> (rnd() % 64); let a2 = if rnd() % 2 == 0 { a } else { a >> (rnd() % 64) };\n        let r = reference(u64::MAX, a2, f);\n        let b = match r { Some(t) => if rnd()%2==0 { t } else { t.wrapping_sub(1) }, None => rnd() };\n        check(b, a2, f); check(b, f, a2);\n    }\n}\nEOF\n"]
