[11.811326, "o", "120:    }\r\n121:\r\n122:    /// Computes the floor 10% tier rebate `floor(gross_fee / 10)`.\r\n123:    #[inline]\r\n124:    pub fn compute_tier_rebate(gross_fee: u64) -> u64 {\r\n125:        gross_fee / REBATE_DIVISOR\r\n126:    }\r\n127:\r\n128:    /// Computes a capped maker rebate `min(floor(gross_fee / 10), floor(limit / 5))`\r\n129:    /// used by passive order-book quotes.\r\n130:    #[inline]\r\n131:    pub fn compute_capped_maker_rebate(gross_fee: u64, cap_basis: u64) -> u64 {\r\n132:        let base_rebate = gross_fee / REBATE_DIVISOR;\r\n133:        let max_rebate = cap_basis / MAKER_REBATE_CAP_DIVISOR;\r\n134:        if base_rebate <= max_rebate {\r\n135:            base_rebate\r\n136:        } else {\r\n137:            max_rebate\r\n138:        }\r\n139:    }\r\n140:\r\n141:    /// Evaluates the two-stage settlement fee quote (`gross_fee`, `rebate`, `net_fee`)\r\n142:    /// from a folded 64-bit notional sum.\r\n143:    #[inline]\r\n144:    pub fn evaluate_settlement_fee(sum: WordSum) -> FeeQuote {\r\n145:        let gross_fee = ceil_div_bps_u64(sum);\r\n146:        let rebate = compute_tier_rebate(gross_fee);\r\n147:        let net_fee = gross_fee - rebate;\r\n148:        FeeQuote {\r\n149:            gross_fee,\r\n150:            rebate,\r\n151:            net_fee,\r\n152:        }\r\n153:    }\r\n154:\r\n155:    /// Evaluates a passive liquidity floor fee quote (used by pool analytics).\r\n156:    #[inline]\r\n157:    pub fn evaluate_passive_floor_fee(sum: WordSum) -> FeeQuote {\r\n158:        let gross_fee = floor_div_bps_u64(sum);\r\n159:        let rebate = compute_tier_rebate(gross_fee);\r\n160:        let net_fee = gross_fee - rebate;\r\n161:        FeeQuote {\r\n162:            gross_fee,\r\n163:            rebate,\r\n164:            net_fee,\r\n165:        }\r\n166:    }\r\n167:}\r\n168:\r\n169:pub mod liquidity_pool {\r\n170:    use crate::constants::*;\r\n171:    use crate::fee_tiers::FeeQuote;\r\n172:\r\n173:    #[derive(D