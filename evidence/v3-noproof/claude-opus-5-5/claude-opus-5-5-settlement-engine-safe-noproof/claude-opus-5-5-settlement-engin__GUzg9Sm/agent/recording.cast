[11.813391, "o", " `principal + flash_levy` fits in `u64`.\r\n229:    #[inline]\r\n230:    pub fn quote_flash_repayment(principal: u64, surcharge: u64) -> Option<FlashLoanReceipt> {\r\n231:        let flash_levy = assess_flash_fee_ceil(principal, surcharge);\r\n232:        let total_repayment = principal.checked_add(flash_levy)?;\r\n233:        Some(FlashLoanReceipt {\r\n234:            principal,\r\n235:            flash_levy,\r\n236:            total_repayment,\r\n237:        })\r\n238:    }\r\n239:}\r\n240:\r\n241:pub mod settlement_engine {\r\n242:    use crate::Authorization;\r\n243:    use crate::fee_tiers::{FeeQuote, evaluate_settlement_fee};\r\n244:    use crate::word_math::add_u64_with_carry;\r\n245:\r\n246:    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n247:    pub struct SettlementTicket {\r\n248:        pub principal: u64,\r\n249:        pub gross_fee: u64,\r\n250:        pub rebate: u64,\r\n251:        pub net_fee: u64,\r\n252:        pub total_debit: u64,\r\n253:    }\r\n254:\r\n255:    /// Assembles a complete settlement ticket from `amount` and `fee_quote`,\r\n256:    /// returning `None` if `amount + fee_quote.net_fee` overflows `u64`.\r\n257:    #[inline]\r\n258:    pub fn assemble_ticket(amount: u64, fee_quote: FeeQuote) -> Option<SettlementTicket> {\r\n259:        let total_debit = amount.checked_add(fee_quote.net_fee)?;\r\n260:        Some(SettlementTicket {\r\n\u001b[?2004hroot@c5667e496778:/workspace/challenge# "]
