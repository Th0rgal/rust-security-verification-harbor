[?2004l[?2004h> import SecurityChallenge
[?2004l[?2004h> import Lean.Elab.Tactic.Omega
[?2004l[?2004h> open SecurityChallenge
[?2004l[?2004h> 
[?2004l[?2004h> /-- The gross fee is the ceiling of the exact combined basis / 10,000. -/
[?2004l[?2004h> def policyGross (amount fee : UInt64) : Nat :=
[?2004l[?2004h>   (amount.toNat + fee.toNat + 9999) / 10000
[?2004l[?2004h> 
[?2004l[?2004h> /-- Principal plus the gross fee less the floor ten-percent rebate. -/
[?2004l[?2004h> def policyDebit (amount fee : UInt64) : Nat :=
[?2004l[?2004h>   amount.toNat + (policyGross amount fee - policyGross amount fee / 10)
[?2004l[?2004h> 
[?2004l[?2004h> /-- Affordability is exact-integer affordability; output is the exact debit. -/
[?2004l[?2004h> def candidateSpec : AuthorizationSpec := {
[?2004l[?2004h>   accepts := fun balance amount fee => policyDebit amount fee ≤ balance.toNat
[?2004l[?2004h>   output := fun _ amount fee totalDebit => totalDebit.toNat = policyDebit amount fee
[?2004l[?2004h> }
[?2004l[?2004h> EOF
