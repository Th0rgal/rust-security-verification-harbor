[177.115642, "o", "326:protected theorem UInt64.mod_eq_of_lt {a b : UInt64} (h : a < b) : a % b = a := UInt64.toNat_inj.1 (Nat.mod_eq_of_lt h)\r\n402:@[simp] theorem UInt8.toUInt64_mod_256 (n : UInt8) : n.toUInt64 % 256 = n.toUInt64 := UInt64.toNat.inj (by simp)\r\n406:@[simp] theorem UInt16.toUInt64_mod_65536 (n : UInt16) : n.toUInt64 % 65536 = n.toUInt64 := UInt64.toNat.inj (by simp)\r\n409:@[simp] theorem UInt32.toUInt64_mod_4294967296 (n : UInt32) : n.toUInt64 % 4294967296 = n.toUInt64 := UInt64.toNat.inj (by simp)\r\n584:  UInt64.toNat.inj (by simp)\r\n618:  UInt64.toNat.inj (by simp)\r\n620:  UInt64.toNat.inj (by simp)\r\n622:  UInt64.toNat.inj (by simp)\r\n624:  UInt64.toNat.inj (by simp)\r\n642:  UInt64.toNat.inj (by simp [Nat.mod_eq_of_lt h])\r\n"]
