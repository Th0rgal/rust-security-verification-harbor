[177.112722, "i", "grep -nE 'UInt64.toNat_inj|UInt64.toNat.inj' /opt/lean/src/lean/Init/Data/UInt/Lemmas.lean | head -10\npython3 - <<'PY'\np='Work.lean'\ns=open(p).read(); s=s[:s.index('  unfold challengeAuthorize quoteSettlementTicket assembleTicket')]+'''  let n := (evaluateSettlementFee (addU64WithCarry a f)).netFee\n  change n.toNat = policyGross a f - policyGross a f / 10 at hn\n  have hexpr : challengeAuthorize b a f =\n      if n ≤ u64Max - a then\n        (if a + n ≤ b then some (a + n) else none)\n      else none := by\n    unfold challengeAuthorize quoteSettlementTicket assembleTicket\n    dsimp only\n    by_cases h : n ≤ u64Max - a\n    · simp only [show (evaluateSettlementFee (addU64WithCarry a f)).netFee ≤ u64Max - a from h,\n        if_pos, commitTicket]\n    · simp only [show ¬ (evaluateSettlementFee (addU64WithCarry a f)).netFee ≤ u64Max - a from h,\n        if_neg]\n  rw [hexpr]\n  by_cases h : n ≤ u64Max - a\n  · rw [if_pos h]\n    by_cases hbal : a + n ≤ b\n    · rw [if_pos hbal]\n      simp only [Option.some."]
[177.112825, "i", "injEq, ← UInt64.toNat_inj]\n      simp [UInt64.le_iff_toNat_le, UInt64.toNat_add, hm] at h hbal ⊢\n      unfold policyDebit\n      omega\n    · rw [if_neg hbal]\n      simp only [reduceCtorEq, false_iff]\n      simp [UInt64.le_iff_toNat_le, UInt64.toNat_add, hm] at h hbal\n      unfold policyDebit\n      omega\n  · rw [if_neg h]\n    simp only [reduceCtorEq, false_iff]\n    simp [UInt64.le_iff_toNat_le, hm] at h\n    unfold policyDebit\n    omega\n'''; open(p,'w').write(s)\nPY\nlean Work.lean\n"]
[177.113193, "o", "grep -nE 'UInt64.toNat_inj|UInt64.toNat.inj' /opt/lean/src/lean/Init/Data/UInt/Lemmas.lean | head -10\r\n"]
