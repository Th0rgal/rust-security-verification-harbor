[50.366202, "o", "621:protected def UInt64.mod (a b : UInt64) : UInt64 := ⟨BitVec.umod a.toBitVec b.toBitVec⟩\r\n625:@[deprecated UInt64.mod (since := \"2024-09-23\")]\r\n626:protected def UInt64.modn (a : UInt64) (n : Nat) : UInt64 := ⟨Fin.modn a.toFin n⟩\r\n635:protected def UInt64.land (a b : UInt64) : UInt64 := ⟨a.toBitVec &&& b.toBitVec⟩\r\n645:protected def UInt64.lor (a b : UInt64) : UInt64 := ⟨a.toBitVec ||| b.toBitVec⟩\r\n655:protected def UInt64.xor (a b : UInt64) : UInt64 := ⟨a.toBitVec ^^^ b.toBitVec⟩\r\n662:protected def UInt64.shiftLeft (a b : UInt64) : UInt64 := ⟨a.toBitVec <<< (UInt64.mod b 64).toBitVec⟩\r\n669:protected def UInt64.shiftRight (a b : UInt64) : UInt64 := ⟨a.toBitVec >>> (UInt64.mod b 64).toBitVec⟩\r\n674:protected def UInt64.lt (a b : UInt64) : Prop := a.toBitVec < b.toBitVec\r\n679:protected def UInt64.le (a b : UInt64) : Prop := a.toBitVec ≤ b.toBitVec\r\n681:instance : Add UInt64       := ⟨UInt64.add⟩\r\n682:instance : Sub UInt64       := ⟨UInt64.sub⟩\r\n"]
[50.36634, "o", "683:instance : Mul UInt64       := ⟨UInt64.mul⟩\r\n684:instance : Pow UInt64 Nat   := ⟨UInt64.pow⟩\r\n"]
[50.366432, "o", "685:instance : Mod UInt64       := ⟨UInt64.mod⟩\r\n688:instance : HMod UInt64 Nat UInt64 := ⟨UInt64.modn⟩\r\n690:instance : Div UInt64       := ⟨UInt64.div⟩\r\n691:instance : LT UInt64        := ⟨UInt64.lt⟩\r\n692:instance : LE UInt64        := ⟨UInt64.le⟩\r\n"]
[50.366588, "o", "703:protected def UInt64.complement (a : UInt64) : UInt64 := ⟨~~~a.toBitVec⟩\r\n705:Negation of 64-bit unsigned integers, computed modulo `UInt64.size`.\r\n707:`UInt64.neg a` is equivalent to `18_446_744_073_709_551_615 - a + 1`.\r\n712:protected def UInt64.neg (a : UInt64) : UInt64 := ⟨-a.toBitVec⟩"]
[50.366701, "o", "\r\n714:instance : Complement UInt64 := ⟨UInt64.complement⟩\r\n715:instance : Neg UInt64 := ⟨UInt64.neg⟩\r\n716:instance : AndOp UInt64     := ⟨UInt64.land⟩\r\n717:instance : OrOp UInt64      := ⟨UInt64.lor⟩\r\n"]
[50.36674, "o", "718:instance : XorOp UInt64       := ⟨UInt64.xor⟩\r\n719:instance : ShiftLeft UInt64  := ⟨UInt64.shiftLeft⟩\r\n720:instance : ShiftRight UInt64 := ⟨UInt64.shiftRight⟩\r\n726:def Bool.toUInt64 (b : Bool) : UInt64 := if b then 1 else 0\r\n730:`DecidableLT UInt64` instance.\r\n735: * `(if (6 : UInt64) < 7 then \"yes\" else \"no\") = \"yes\"`\r\n"]
[50.366833, "o", "736: * `(if (5 : UInt64) < 5 then \"yes\" else \"no\") = \"no\"`\r\n737: * `show ¬((7 : UInt64) < 7) by decide`\r\n740:def UInt64.decLt (a b : UInt64) : Decidable (a < b) :="]
[50.366944, "o", "\r\n745:`DecidableLE UInt64` instance.\r\n750: * `(if (15 : UInt64) ≤ 15 then \"yes\" else \"no\") = \"yes\"`\r\n751: * `(if (15 : UInt64) ≤ 5 then \"yes\" else \"no\") = \"no\"`\r\n"]
[50.366999, "o", "752: * `(if (5 : UInt64) ≤ 15 then \"yes\" else \"no\") = \"yes\"`\r\n753: * `show (7 : UInt64) ≤ 7 by decide`\r\n"]
[50.367274, "o", "756:def UInt64.decLe (a b : UInt64) : Decidable (a ≤ b) :=\r\n759:attribute [instance] UInt64.decLt UInt64.decLe\r\n761:instance : Max UInt64 := maxOfLe\r\n762:instance : Min UInt64 := minOfLe"]
[50.367499, "o", "\r\n768:def USize.ofInt (x : Int) : USize := ofNat (x % 2 ^ System.Platform.numBits).toNat\r\n881:  USize.ofNat32 a.toBitVec.toNat (Nat.lt_trans a.toBitVec.isLt (by decide))\r\n888:def USize.toUInt8 (a : USize) : UInt8 := a.toNat.toUInt8\r\n896:  USize.ofNat32 a.toBitVec.toNat (Nat.lt_trans a.toBitVec.isLt (by decide))"]
[50.367519, "o", "\r\n903:def USize.toUInt16 (a : USize) : UInt16 := a.toNat.toUInt16\r\n910:def UInt32.toUSize (a : UInt32) : USize := USize.ofNat32 a.toBitVec.toNat a.toBitVec.isLt\r\n918:def USize.toUInt32 (a : USize) : UInt32 := a.toNat.toUInt32\r\n926:def UInt64.toUSize (a : UInt64) : USize := a.toNat.toUSize\r\n934:def USize.toUInt64 (a : USize) : UInt64 :=\r\n935:  UInt64.ofNatLT a.toBitVec.toNat (Nat.lt_of_lt_of_le a.toBitVec.isLt USize.size_le)\r\n"]
[50.371778, "o", "3490:  simpa [le_iff_toNat_le, lt_iff_toNat_lt] using Nat.lt_of_lt_of_le\r\n3492:  simpa [le_iff_toNat_le, lt_iff_toNat_lt] using Nat.lt_of_lt_of_le\r\n3494:  simpa [le_iff_toNat_le, lt_iff_toNat_lt] using Nat.lt_of_lt_of_le\r\n3496:  simpa [le_iff_toNat_le, lt_iff_toNat_lt] using Nat.lt_of_lt_of_le\r\n3498:  simpa [le_iff_toNat_le, lt_iff_toNat_lt] using Nat.lt_of_lt_of_le\r\n3501:  simpa [lt_iff_toNat_lt, ← UInt8.toNat_inj] using Nat.lt_or_lt_of_ne\r\n3503:  simpa [lt_iff_toNat_lt, ← UInt16.toNat_inj] using Nat.lt_or_lt_of_ne\r\n3505:  simpa [lt_iff_toNat_lt, ← UInt32.toNat_inj] using Nat.lt_or_lt_of_ne\r\n3507:  simpa [lt_iff_toNat_lt, ← UInt64.toNat_inj] using Nat.lt_or_lt_of_ne\r\n3509:  simpa [lt_iff_toNat_lt, ← USize.toNat_inj] using Nat.lt_or_lt_of_ne\r\n3512:  simp [lt_iff_toNat_lt, le_iff_toNat_le]; omega\r\n3514:  simp [lt_iff_toNat_lt, le_iff_toNat_le]; omega\r\n3516:  simp [lt_iff_toNat_lt, le_iff_toNat_le]; omega\r\n3518:  simp [lt_iff_toNat_lt, le_iff_toNat_le]; omega\r\n3520:  simp [lt_iff_toNat_lt, le_iff_toNa"]
