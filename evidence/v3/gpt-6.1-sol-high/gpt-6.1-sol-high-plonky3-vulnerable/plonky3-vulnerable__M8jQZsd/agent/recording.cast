[128.173593, "i", "python3 - <<'PY'\nimport random\nP=2013265921;R=1<<32;M=(1<<64)-1;MU=2281701377;INV=943718400\nrng=random.Random(31)\nvalues=[0,1,P-1,P,P+1,R-1,R,R+1,M-1,M]\npairs=[(a,f) for a in values for f in values]+[(rng.getrandbits(64),rng.getrandbits(64)) for _ in range(100000)]\nfor a,f in pairs:\n    x=(a&(R-1))+(f%P)*R\n    t=((x&(R-1))*MU)&(R-1)\n    u=t*P\n    hi=((x-u)&M)>>32\n    surcharge=hi+P-R if x<u else hi\n    expected=x*INV%P\n    assert surcharge==expected,(a,f,surcharge,expected)\n    assert 0<=surcharge<P\nprint('Repaired Montgomery reduction matches exact settlement arithmetic on',len(pairs),'boundary/random pairs.')\nPY\nfind /workspace/submission -type f -maxdepth 3 -print\ncat /workspace/submission/Spec.lean /workspace/submission/Audit.lean /workspace/submission/Proof.lean\n"]
