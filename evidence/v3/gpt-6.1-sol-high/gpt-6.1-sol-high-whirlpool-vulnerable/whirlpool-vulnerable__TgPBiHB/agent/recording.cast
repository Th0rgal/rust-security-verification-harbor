[98.839039, "o", "\u001b[?2004hroot@42dc7d7cff85:/workspace/challenge# "]
[137.8402, "i", "cat > /tmp/authorization-reference-check.rs <<'RS'\nmod repaired { include!(\"/workspace/submission/src/lib.rs\"); }\nfn check(balance: u64, amount: u64, fee: u64) {\n    let x = (amount as u128) + ((fee as u128) << 64);\n    let gross_fee = x / 1_000_000 + if x % 1_000_000 == 0 { 0 } else { 1 };\n    let debit = (amount as u128) / 2 + gross_fee;\n    let expected = if debit <= balance as u128 { Some(debit as u64) } else { None };\n    assert_eq!(repaired::authorize(balance, amount, fee).map(|a| a.total_debit), expected,\n        \"balance={balance}, amount={amount}, fee={fee}\");\n}\nfn main() {\n    let values = [0, 1, 2, 999_998, 999_999, 1_000_000, 1_000_001,\n        4_294_967_295, 4_294_967_296, 4_294_967_297,\n        18_446_744_073_708_551_616, 18_446_744_073_708_551_617,\n        u64::MAX - 1, u64::MAX];\n    for b in values { for a in values { for f in values { check(b, a, f); } } }\n    let mut seed = 1u64;\n    for i in 0..200_000 {\n        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1);\n        let amount = seed;\n        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1);\n        let fee = if i % 2 == 0 { seed % 1_000_001 } else { seed };\n        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1);\n        check(seed, amount, fee);\n        let x = amount as u128 + ((fee as u128) << 64);\n        let debit = amount as u128 / 2 + x / 1_000_000 + if x % 1_000_000 == 0 { 0 } else { 1 };\n        if debit <= u64::MAX as u128 {\n            check(debit as u64, amount, fee);\n            if debit > 0 { check((debit - 1) as u64, amount, fee); }\n        }\n    }\n    println!(\"Boundary and randomized u128 reference comparisons passed\");\n}\nRS\nrustc --edition=2021 -O /tmp/authorization-reference-check.rs -o /tmp/authorization-reference-check && /tmp/authorization-reference-check\n"]
