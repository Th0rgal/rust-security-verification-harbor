[94.651944, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=Path('/workspace/submission/Proof.lean')\ns=p.read_text().replace('have rejected : ¬ candidateSpec.accepts 9223372036854275808 18446744073708551617 999999 := by\\n    decide', 'have rejected : ¬ candidateSpec.accepts 9223372036854275808 18446744073708551617 999999 := by\\n    change ¬ settlementDebit 18446744073708551617 999999 ≤ (9223372036854275808 : UInt64).toNat\\n    decide')\np.write_text(s)\np=Path('/workspace/submission/src/lib.rs')\ns=p.read_text()\npos=s.rfind('\\n}')\ns=s[:pos]+'''\n\n    #[test]\n    fn carry_into_third_limb_rejects_unrepresentable_fee() {\n        let amount = 18_446_744_073_708_551_617u64;\n        let fee = 999_999u64;\n        let balance = 9_223_372_036_854_275_808u64;\n        assert_eq!(u128_math::div_round_up_fee(amount, fee), None);\n        assert_eq!(authorize(balance, amount, fee), None);\n        assert_eq!(authorize(u64::MAX, amount, fee), None);\n    }\n'''+s[pos:]\np.write_text(s)\nPY\npython3 /workspace/lean/check.py\n"]
