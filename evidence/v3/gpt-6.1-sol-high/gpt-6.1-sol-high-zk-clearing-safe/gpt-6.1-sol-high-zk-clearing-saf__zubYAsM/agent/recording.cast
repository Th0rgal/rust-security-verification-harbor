lean\r\n/workspace/lean/LeanModel/WordMath.lean\r\n/workspace/lean/LeanModel/WordMath.olean\r\n/workspace/lean/SecurityChallenge.lean\r\n/workspace/lean/SecurityChallenge.olean\r\n/workspace/lean/Signature.lean\r\n/workspace/lean/check.py\r\n/workspace/lean/lean-toolchain\r\n"]
