[393.602823, "o", "-- Carry-preserving ceiling assessment of a two-word notional.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[393.603083, "o", "def ceilCharge (a f d remBias carryQuot carryRem : Nat) : Nat :="]
[393.608433, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   let low := add a f\r\n\u001b[?2004l\r\u001b[?2004h>   if low < a then\r\n\u001b[?2004l\r\u001b[?2004h>     let folded := add (low % d) carryRem\r\n\u001b[?2004l\r\u001b[?2004h>     add (add carryQuot (low / d)) (add folded remBias / d)\r\n\u001b[?2004l\r\u001b[?2004h>   else\r\n\u001b[?2004l\r\u001b[?2004h>     let biased := add low remBias\r\n\u001b[?2004l\r\u001b[?2004h>     if biased < low then\r\n\u001b[?2004l\r\u001b[?2004h>       add (low / d) (add (low % d) remBias / d)\r\n\u001b[?2004l\r\u001b[?2004h>     else biased / d\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def netFee (a f : Nat) : Nat :=\r\n\u001b[?2004l\r\u001b[?2004h>   let gross := ceilCharge a f 10000 9999 1844674407370955 1616\r\n\u001b[?2004l\r\u001b[?2004h>   sub gross (gross / 10)\r\n\u001b[?2004l\r\u001b[?2004h> def flashRetention (a f : Nat) : Nat :=\r\n\u001b[?2004l\r\u001b[?2004h>   let gross := ceilCharge a f 5000 4999 3689348814741910 1616\r\n\u001b[?2004l\r\u001b[?2004h>   sub gross (gross / 4)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
