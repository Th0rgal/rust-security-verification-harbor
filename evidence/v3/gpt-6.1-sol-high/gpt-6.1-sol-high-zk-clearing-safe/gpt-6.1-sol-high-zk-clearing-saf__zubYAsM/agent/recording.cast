[147.92842, "i", "python3 - <<'PY'\nimport random\nR=1<<64; p=R-(1<<32)+1; m=R-1\nfor i in range(1000000):\n a=random.randrange(R); f=random.randrange(R)\n t0=(a-(f>>32))&m; t1=(t0+p)&m if a<(f>>32) else t0\n prod=(f&((1<<32)-1))*((1<<32)-1); t2=(t1+prod)&m\n t3=(t2+((1<<32)-1))&m if t1+prod>=R else t2\n g=t3-p if t3>=p else t3\n if g!=(a+R*f)%p:\n  print('GOLD BUG',a,f,g,(a+R*f)%p);break\nelse: print('gold random passed')\nfor i in range(1000000):\n u1=random.randrange(32771);u0=random.randrange(65536)\n qf=u1*65524+(u1<<16)+u0+65536;q1=qf>>16;q0=qf&65535;r=(0xc0000000+u0-q1*32771)&65535\n if q0<r:q1-=1;r=(r+32771)&65535\n q=q1+(r>=32771)\n if q!=((u1<<16)+u0)//32771:print('DIV BUG',u1,u0,q,((u1<<16)+u0)//32771);break\nelse:print('div random passed')\nPY\n"]
