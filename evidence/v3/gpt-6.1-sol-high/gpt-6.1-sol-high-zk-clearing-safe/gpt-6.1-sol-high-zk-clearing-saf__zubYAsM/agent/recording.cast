[331.375184, "o", "UInt64.toNat_mul (a b : UInt64) : (a * b).toNat = a.toNat * b.toNat % 2 ^ 64\r\n"]
[331.381054, "o", "UInt64.toNat_div (a b : UInt64) : (a / b).toNat = a.toNat / b.toNat\r\n"]
[331.38184, "o", "UInt64.toNat_mod (a b : UInt64) : (a % b).toNat = a.toNat % b.toNat\r\n"]
[331.416716, "o", "UInt64.toNat_shiftLeft (a b : UInt64) : (a <<< b).toNat = a.toNat <<< (b.toNat % 64) % 2 ^ 64\r\nUInt64.toNat_shiftRight (a b : UInt64) : (a >>> b).toNat = a.toNat >>> (b.toNat % 64)\r\nUInt64.toNat_and (a b : UInt64) : (a &&& b).toNat = a.toNat &&& b.toNat\r\nUInt64.toNat_or (a b : UInt64) : (a ||| b).toNat = a.toNat ||| b.toNat\r\nUInt64.le_iff_toNat_le {a b : UInt64} : a ≤ b ↔ a.toNat ≤ b.toNat\r\nUInt64.lt_iff_toNat_lt {a b : UInt64} : a < b ↔ a.toNat < b.toNat\r\nUInt64.toNat_ofNat {n : Nat} : (OfNat.ofNat n).toNat = n % 2 ^ 64\r\nUInt64.toNat_inj {a b : UInt64} : a.toNat = b.toNat ↔ a = b\r\n"]
