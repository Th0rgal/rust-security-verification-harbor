[393.599203, "o", "def sub (x y : Nat) := (R - y + x) % R\r\n\u001b[?2004l\r\u001b[?2004h> def mul (x y : Nat) := (x * y) % R\r\n\u001b[?2004l\r\u001b[?2004h> def left (x k : Nat) := (x <<< (k % 64)) % R\r\n\u001b[?2004l\r\u001b[?2004h> "]
