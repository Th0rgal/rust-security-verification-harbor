[90.076973, "o", "word_math:\r\nuse crate::constants::*; #[derive(Debug, Clone, Copy, PartialEq, Eq)] pub struct WordSum { pub low_word: u64, pub high_carry: bool, } #[derive(Debug, Clone, Copy, PartialEq, Eq)] pub struct WordDiff { pub diff_word: u64, pub underflow_borrow: bool, } #[inline] pub fn add_u64_with_carry(lhs: u64, rhs: u64) -> WordSum { let low_word: u64 = lhs.wrapping_add(rhs); let high_carry: bool = low_word < lhs; WordSum { low_word, high_carry, } } #[inline] pub fn sub_u64_with_borrow(lhs: u64, rhs: u64) -> WordDiff { let diff_word: u64 = lhs.wrapping_sub(rhs); let underflow_borrow: bool = lhs < rhs; WordDiff { diff_word, underflow_borrow, } } #[inline] pub fn extract_low_u16(word: u64) -> u64 { word & LIMB_MASK } #[inline] pub fn extract_low_u32(word: u64) -> u64 { word & LOW32_MASK } #[inline] pub fn extract_high_u32(word: u64) -> u64 { word >> 32u64 } #[inline] pub fn pack_u32_limbs(low_u32: u64, high_u32: u64) -> u64 { (low_u32 & LOW32_MASK) | ((high_u32 & LOW32_MASK) << 32u64) } #[inline] pub fn is_institutional_notional(sum: WordSum) -> bool { if sum.high_carry { true } else { sum.low_word >= INSTITUTIONAL_BAND_MIN } } #[inline] pub fn rem_bps_u64(sum: WordSum) -> u64 { if sum.high_carry { ((sum.low_word % BPS_DENOM) + U64_MOD_BPS_REM) % BPS_DENOM } else { sum.low_word % BPS_DENOM } } #[inline] pub fn floor_div_bps_u64(sum: WordSum) -> u64 { if sum.high_carry { let folded_rem: u64 = (sum.low_word % BPS_DENOM) + U64_MOD_BPS_REM; U64_MOD_BPS_QUOT + (sum.low_word / BPS_DENOM) + (folded_rem / BPS_DENOM) } else { sum.low_word / BPS_DENOM } } #[inline] pub fn ceil_div_bps_u64(sum: WordSum) -> u64 { if sum.high_carry { let folded_rem: u64 = (sum.low_word % BPS_DENOM) + U64_MOD_BPS_REM; U64_MOD_BPS_QUOT + (sum.low_word / BPS_DENOM) + ((folded_rem + BPS_MAX_REM) / BPS_DENOM) } else { let biased: u64 = sum.low_word.wrapping_add(BPS_MAX_REM); if biased < sum.low_word { (sum.low_word / BPS_DENOM) + (((sum.low_word % BPS_DENOM) + BPS_MAX_REM) / BPS_DENOM) } else { biased / BPS_DENOM } } } #[inline] pub fn floor_div_flash_u64(sum: WordSum) -> u64 { if sum.high_carry { let folded_rem: u64 = (sum.low_word % FLASH_DENOM) + U64_MOD_FLASH_REM; U64_MOD_FLASH_QUOT + (sum.low_word / FLASH_DENOM) + (folded_rem / FLASH_DENOM) } else { sum.low_word / FLASH_DENOM } } #[inline] pub fn ceil_div_flash_u64(sum: WordSum) -> u64 { if sum.high_carry { let folded_rem: u64 = (sum.low_word % FLASH_DENOM) + U64_MOD_FLASH_REM; U64_MOD_FLASH_QUOT + (sum.low_word / FLASH_DENOM) + ((folded_rem + FLASH_MAX_REM) / FLASH_DENOM) } else { let biased: u64 = sum.low_word.wrapping_add(FLASH_MAX_REM); if biased < sum.low_word { (sum.low_word / FLASH_DENOM) + (((sum.low_word % FLASH_DENOM) + FLASH_MAX_REM) / FLASH_DENOM) } else { biased / FLASH_DENOM } } }\r\nfee_schedule:\r\nuse crate::constants::*; use crate::word_math::{WordSum, ceil_div_bps_u64, floor_div_bps_u64, is_institutional_notional}; #[derive(Debug, Clone, Copy, PartialEq, Eq)] pub struct FeeSchedule { pub bps_denom: u64, pub rebate_divisor: u64, pub maker_cap_divisor: u64, } #[derive(Debug, Clone, Copy, PartialEq, Eq)] pub struct FeeQuote { pub gross_fee: u64, pub rebate: u64, pub net_fee: u64, } #[inline] pub fn default_schedule() -> FeeSchedule { FeeSchedule { bps_denom: BPS_DENOM, rebate_divisor: REBATE_DIVISOR, maker_cap_divisor: MAKER_REBATE_CAP_DIVISOR, } } #[inline] pub fn compute_tier_rebate(gross_fee: u64) -> u64 { gross_fee / REBATE_DIVISOR } #[inline] pub fn compute_capped_maker_rebate(gross_fee: u64, cap_basis: u64) -> u64 { let base_rebate: u64 = gross_fee / REBATE_DIVISOR; let max_rebate: u64 = cap_basis / MAKER_REBATE_CAP_DIVISOR; if base_rebate <= max_rebate { base_rebate } else { max_rebate } } #[inline] pub fn evaluate_settlement_fee(sum: WordSum) -> FeeQuote { let gross_fee: u64 = ceil_div_bps_u64(sum); let rebate: u64 = compute_tier_rebate(gross_fee); let net_fee: u64 = gross_fee - rebate; FeeQuote { gross_fee, rebate, net_fee, } } #[inline] pub fn evaluate_passive_floor_fee(sum: WordSum) -> FeeQuote { let gross_fee: u64 = floor_div_bps_u64(sum); let rebate: u64 = compute_tier_rebate(gros"]
[90.079699, "o", "s_fee); let net_fee: u64 = gross_fee - rebate; FeeQuote { gross_fee, rebate, net_fee, } } #[inline] pub fn compute_fee_rounding_spread(sum: WordSum) -> u64 { let ceil_q: FeeQuote = evaluate_settlement_fee(sum); let floor_q: FeeQuote = evaluate_passive_floor_fee(sum); ceil_q.net_fee - floor_q.net_fee } #[inline] pub fn classify_settlement_tier(sum: WordSum) -> u64 { if !sum.high_carry && sum.low_word == 0u64 { 0u64 } else if is_institutional_notional(sum) { 2u64 } else { 1u64 } }\r\nliquidity_pool:\r\nuse crate::constants::*; use crate::fee_schedule::FeeQuote; use crate::word_math::{add_u64_with_carry, ceil_div_flash_u64, floor_div_flash_u64}; #[derive(Debug, Clone, Copy, PartialEq, Eq)] pub struct PoolReserveQuote { pub treasury_cut: u64, pub lp_retention: u64, } #[derive(Debug, Clone, Copy, PartialEq, Eq)] pub struct FlashLoanReceipt { pub principal: u64, pub flash_levy: u64, pub total_repayment: u64, } #[inline] pub fn split_pool_reserve(quote: FeeQuote) -> PoolReserveQuote { let treasury_cut: u64 = quote.net_fee / TREASURY_CUT_DIVISOR; let lp_retention: u64 = quote.net_fee - treasury_cut; PoolReserveQuote { treasury_cut, lp_retention, } } #[inline] pub fn quote_lp_retention(quote: FeeQuote) -> u64 { let split: PoolReserveQuote = split_pool_reserve(quote); split.lp_retention } #[inline] pub fn assess_flash_fee_ceil(principal: u64, surcharge: u64) -> u64 { let sum = add_u64_with_carry(principal, surcharge); ceil_div_flash_u64(sum) } #[inline] pub fn quote_flash_lp_retention(principal: u64, surcharge: u64) -> PoolReserveQuote { let flash_levy: u64 = assess_flash_fee_ceil(principal, surcharge); let treasury_cut: u64 = flash_levy / TREASURY_CUT_DIVISOR; let lp_retention: u64 = flash_levy - treasury_cut; PoolReserveQuote { treasury_cut, lp_retention, } } #[inline] pub fn assess_flash_fee_floor(principal: u64, surcharge: u64) -> u64 { let sum = add_u64_with_carry(principal, surcharge); floor_div_flash_u64(sum) } #[inline] pub fn quote_flash_repayment(principal: u64, surcharge: u64) -> Option<FlashLoanReceipt> { let flash_levy: u64 = assess_flash_fee_ceil(principal, surcharge); let total_repayment: u64 = principal.checked_add(flash_levy)?; Some(FlashLoanReceipt { principal, flash_levy, total_repayment, }) } #[inline] pub fn check_pool_reserve_solvency(current_reserve: u64, quote: FeeQuote, min_reserve: u64) -> bool { let lp_share: u64 = quote_lp_retention(quote); match current_reserve.checked_add(lp_share) { Some(updated) => updated >= min_reserve, None => true, } }\r\nreciprocal_div:\r\nuse crate::constants::*; use crate::word_math::extract_low_u16; #[derive(Debug, Clone, Copy, PartialEq, Eq)] pub struct BlobSlotQuote { pub high_limb: u64, pub low_limb: u64, pub slot_quotient: u64, pub slot_remainder: u64, } #[inline] pub fn div_2x1_mg10(u1: u64, u0: u64) -> u64 { let q_full: u64 = (u1 * MG10_RECIPROCAL) + (u1 << 16u64) + u0 + (1u64 << 16u64); let q1: u64 = q_full >> 16u64; let q0: u64 = q_full & LIMB_MASK; let r: u64 = (SUB_BIAS + u0 - q1 * MG10_DIVISOR) & LIMB_MASK; let (q_corr, r_corr): (u64, u64) = if q0 < r { (q1 - 1u64, (r + MG10_DIVISOR) & LIMB_MASK) } else { (q1, r) }; if r_corr >= MG10_DIVISOR { q_corr + 1u64 } else { q_corr } } #[inline] pub fn rem_2x1_mg10(u1: u64, u0: u64, quot: u64) -> u64 { let dividend: u64 = (u1 << 16u64) + u0; dividend - (quot * MG10_DIVISOR) } #[inline] pub fn quote_blob_gas_slots(amount: u64, fee: u64) -> BlobSlotQuote { let high_limb: u64 = fee % MG10_DIVISOR; let low_limb: u64 = extract_low_u16(amount); let slot_quotient: u64 = div_2x1_mg10(high_limb, low_limb); let slot_remainder: u64 = rem_2x1_mg10(high_limb, low_limb, slot_quotient); BlobSlotQuote { high_limb, low_limb, slot_quotient, slot_remainder, } } #[inline] pub fn verify_blob_slot_euclidean(quote: BlobSlotQuote) -> bool { let dividend: u64 = (quote.high_limb << 16u64) + quote.low_limb; let reconstructed: u64 = (quote.slot_quotient * MG10_DIVISOR) + quote.slot_remainder; (quote.slot_remainder < MG10_DIVISOR) && (reconstructed == dividend) } #[inline] pub fn estimate_blob_gas_units(quote: BlobSlotQuote) -> u64 { quote.slot_quotient * BL"]
[90.080418, "o", "OB_GAS_PER_SLOT } #[inline] pub fn ceil_blob_slots(quote: BlobSlotQuote) -> u64 { if quote.slot_remainder > 0u64 { quote.slot_quotient + 1u64 } else { quote.slot_quotient } }\r\nbroadword_swar:\r\nuse crate::constants::*; #[derive(Debug, Clone, Copy, PartialEq, Eq)] pub struct CalldataLaneQuote { pub active_lanes: u64, pub byte_weight_sum: u64, pub surcharge: u64, } #[inline] pub fn u_nz8(x: u64) -> u64 { (((x | H8_MASK) - L8_MASK) | x) & H8_MASK } #[inline] pub fn count_nz_bytes(x: u64) -> u64 { ((u_nz8(x) >> 7u64) * L8_MASK) >> 56u64 } #[inline] pub fn count_zero_bytes_swar(x: u64) -> u64 { 8u64 - count_nz_bytes(x) } #[inline] pub fn has_high_bit_byte(x: u64) -> bool { (x & H8_MASK) != 0u64 } #[inline] pub fn sum_bytes(x: u64) -> u64 { let pair_sum: u64 = (x & M16_MASK) + ((x >> 8u64) & M16_MASK); ((pair_sum * L16_MASK) >> 48u64) & LIMB_MASK } #[inline] pub fn sum_even_bytes_swar(x: u64) -> u64 { let even_lanes: u64 = x & M16_MASK; ((even_lanes * L16_MASK) >> 48u64) & LIMB_MASK } #[inline] pub fn sum_odd_bytes_swar(x: u64) -> u64 { let odd_lanes: u64 = (x >> 8u64) & M16_MASK; ((odd_lanes * L16_MASK) >> 48u64) & LIMB_MASK } #[inline] pub fn quote_calldata_lane_surcharge(fee: u64) -> CalldataLaneQuote { let active_lanes: u64 = count_nz_bytes(fee); let byte_weight_sum: u64 = sum_bytes(fee); let surcharge: u64 = (active_lanes << CALLDATA_NZ_BYTE_SHIFT) + byte_weight_sum; CalldataLaneQuote { active_lanes, byte_weight_sum, surcharge, } }\r\nmontgomery_field:\r\nuse crate::constants::*; #[derive(Debug, Clone, Copy, PartialEq, Eq)] pub struct ProverLevyQuote { pub packed_transcript: u64, pub monty_t: u64, pub prover_levy: u64, } #[inline] pub fn pack_transcript(amount: u64, fee: u64) -> u64 { (amount % LIMB_BASE) + (fee % BABYBEAR_P) * LIMB_BASE } #[inline] pub fn monty_quotient(x: u64) -> u64 { ((x % LIMB_BASE) * BABYBEAR_MU) % LIMB_BASE } #[inline] pub fn monty_reduce(x: u64) -> u64 { let t: u64 = monty_quotient(x); let u: u64 = BABYBEAR_P * t; let diff: u64 = x.wrapping_sub(u); let hi: u64 = diff / LIMB_BASE; if x < u { BABYBEAR_P + hi - LIMB_BASE } else { hi } } #[inline] pub fn monty_mul_babybear(a: u64, b: u64) -> u64 { let prod: u64 = (a % BABYBEAR_P) * (b % BABYBEAR_P); monty_reduce(prod) } #[inline] pub fn canonical_add_babybear(a: u64, b: u64) -> u64 { let sum: u64 = a + b; if sum >= BABYBEAR_P { sum - BABYBEAR_P } else { sum } } #[inline] pub fn canonical_sub_babybear(a: u64, b: u64) -> u64 { if a >= b { a - b } else { (a + BABYBEAR_P) - b } } #[inline] pub fn quote_prover_transcript_levy(amount: u64, fee: u64) -> ProverLevyQuote { let packed_transcript: u64 = pack_transcript(amount, fee); let monty_t: u64 = monty_quotient(packed_transcript); let prover_levy: u64 = monty_reduce(packed_transcript); ProverLevyQuote { packed_transcript, monty_t, prover_levy, } }\r\ngoldilocks_field:\r\nuse crate::constants::*; #[derive(Debug, Clone, Copy, PartialEq, Eq)] pub struct GoldilocksQuote { pub folded_low: u64, pub canonical_residue: u64, pub bridge_fee: u64, } #[inline] pub fn reduce_goldilocks_step1(x_lo: u64, x_hi: u64) -> (u64, bool) { let x_hi_hi: u64 = x_hi >> 32u64; x_lo.overflowing_sub(x_hi_hi) } #[inline] pub fn reduce_goldilocks_128(x_lo: u64, x_hi: u64) -> u64 { let x_hi_lo: u64 = x_hi & GOLDILOCKS_EPS; let (t0, borrow): (u64, bool) = reduce_goldilocks_step1(x_lo, x_hi); let t1: u64 = if borrow { t0.wrapping_add(GOLDILOCKS_P) } else { t0 }; let prod: u64 = x_hi_lo * GOLDILOCKS_EPS; let (t2, carry): (u64, bool) = t1.overflowing_add(prod); let t3: u64 = if carry { t2.wrapping_add(GOLDILOCKS_EPS) } else { t2 }; if t3 >= GOLDILOCKS_P { t3 - GOLDILOCKS_P } else { t3 } } #[inline] pub fn canonicalize_goldilocks_u64(x: u64) -> u64 { if x >= GOLDILOCKS_P { x - GOLDILOCKS_P } else { x } } #[inline] pub fn add_goldilocks_mod(a: u64, b: u64) -> u64 { reduce_goldilocks_128(a.wrapping_add(b), if a.wrapping_add(b) < a { 1u64 } else { 0u64 }) } #[inline] pub fn sub_goldilocks_mod(a: u64, b: u64) -> u64 { let ca: u64 = canonicalize_goldilocks_u64(a); let cb: u64 = canonicalize_goldilocks_u64(b); if ca >= cb { ca - cb } else { (GOLDILOCKS_P - "]
[90.083891, "o", "cb) + ca } } #[inline] pub fn fold_goldilocks_challenge(commitment: u64, challenge_u32: u64) -> u64 { let scalar: u64 = challenge_u32 & LOW32_MASK; let lo_limb: u64 = commitment & LOW32_MASK; let hi_limb: u64 = commitment >> 32u64; let prod_lo: u64 = lo_limb * scalar; let prod_hi: u64 = hi_limb * scalar; let x_lo: u64 = prod_lo.wrapping_add(prod_hi << 32u64); let carry: u64 = if x_lo < prod_lo { 1u64 } else { 0u64 }; let x_hi: u64 = (prod_hi >> 32u64) + carry; reduce_goldilocks_128(x_lo, x_hi) } #[inline] pub fn quote_bridge_verifier_fee(amount: u64, fee: u64) -> GoldilocksQuote { let (folded_low, _borrow): (u64, bool) = reduce_goldilocks_step1(amount, fee); let canonical_residue: u64 = reduce_goldilocks_128(amount, fee); let bridge_fee: u64 = canonical_residue; GoldilocksQuote { folded_low, canonical_residue, bridge_fee, } }\r\n"]
