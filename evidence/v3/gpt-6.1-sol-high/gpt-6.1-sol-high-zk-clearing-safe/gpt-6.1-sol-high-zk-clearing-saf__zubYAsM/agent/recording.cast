[420.05682, "i", "cd /workspace/submission\nLEAN_PATH=/workspace/lean:/workspace/submission lean -o Spec.olean Spec.lean\ncat > Helpers.lean <<'EOF'\nimport SecurityChallenge\nimport Spec\nimport Std\nopen SecurityChallenge\nopen LeanModel.Constants LeanModel.WordMath LeanModel.FeeSchedule LeanModel.LiquidityPool\nopen LeanModel.BroadwordSwar LeanModel.ReciprocalDiv LeanModel.MontgomeryField LeanModel.GoldilocksField LeanModel.TranscriptCodec LeanModel.ClearingPipeline\n\nset_option maxRecDepth 4096\nset_option maxHeartbeats 2000000\n\nexample (a f : UInt64) : (evaluateSettlementFee (addU64WithCarry a f)).netFee.toNat = Policy.netFee a.toNat f.toNat := by\n  simp only [evaluateSettlementFee, addU64WithCarry, ceilDivBpsU64, computeTierRebate,\n    UInt64.toNat_sub, UInt64.toNat_add, UInt64.toNat_div, UInt64.toNat_mod,\n    UInt64.lt_iff_toNat_lt, Policy.netFee, Policy.ceilCharge, Policy.add, Policy.sub,\n    bpsDenom, bpsMaxRem, u64ModBpsRem, u64ModBpsQuot, rebateDivisor,\n    UInt64.reduceToNat, Bool.true_eq]\nEOF\nLEAN_PATH=/workspace/lean:/workspace/submission lean Helpers.lean\n"]
