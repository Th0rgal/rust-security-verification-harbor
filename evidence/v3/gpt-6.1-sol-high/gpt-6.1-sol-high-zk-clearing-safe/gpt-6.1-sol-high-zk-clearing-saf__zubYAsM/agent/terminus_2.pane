[?2004l[?2004h> def right (x k : Nat) := x >>> (k % 64)
[?2004l[?2004h> 
[?2004l[?2004h> -- Carry-preserving ceiling assessment of a two-word notional.
[?2004l[?2004h> def ceilCharge (a f d remBias carryQuot carryRem : Nat) : Nat :=
[?2004l[?2004h>   let low := add a f
[?2004l[?2004h>   if low < a then
[?2004l[?2004h>     let folded := add (low % d) carryRem
[?2004l[?2004h>     add (add carryQuot (low / d)) (add folded remBias / d)
[?2004l[?2004h>   else
[?2004l[?2004h>     let biased := add low remBias
[?2004l[?2004h>     if biased < low then
[?2004l[?2004h>       add (low / d) (add (low % d) remBias / d)
[?2004l[?2004h>     else biased / d
[?2004l[?2004h> 
[?2004l[?2004h> def netFee (a f : Nat) : Nat :=
[?2004l[?2004h>   let gross := ceilCharge a f 10000 9999 1844674407370955 1616
[?2004l[?2004h>   sub gross (gross / 10)
[?2004l[?2004h> def flashRetention (a f : Nat) : Nat :=
[?2004l[?2004h>   let gross := ceilCharge a f 5000 4999 3689348814741910 1616
[?2004l[?2004h>   sub gross (gross / 4)
[?2004l[?2004h> 
[?2004l[?2004h> -- Euclidean two-limb blob-slot assessment with reciprocal corrections.
[?2004l[?2004h> def blob (a f : Nat) : Nat :=
[?2004l[?2004h>   let h := f % 32771
[?2004l[?2004h>   let l := a &&& 65535
[?2004l[?2004h>   let full := add (add (add (mul h 65524) (left h 16)) l) (left 1 16)
[?2004l[?2004h>   let q := right full 16
[?2004l[?2004h>   let low := full &&& 65535
[?2004l[?2004h>   let r := sub (add 3221225472 l) (mul q 32771) &&& 65535
[?2004l[?2004h>   let qc := if low < r then sub q 1 else q
[?2004l[?2004h>   let rc := if low < r then add r 32771 &&& 65535 else r
[?2004l[?2004h>   if 32771 ≤ rc then add qc 1 else qc
[?2004l[?2004h> 
[?2004l[?2004h> -- Each nonzero calldata byte costs 256, plus its unsigned byte weight.
[?2004l[?2004h> def lanes (f : Nat) : Nat :=
[?2004l[?2004h>   let nz := (sub (f ||| 9259542123273814144) 72340172838076673 ||| f) &&& 9259542123273814144
[?2004l[?2004h>   right (mul (right nz 7) 72340172838076673) 56
[?2004l[?2004h> def weights (f : Nat) : Nat :=
[?2004l[?2004h>   let pairs := add (f &&& 71777214294589695) (right f 8 &&& 71777214294589695)
[?2004l[?2004h>   right (mul pairs 281479271743489) 48 &&& 65535
[?2004l[?2004h> def calldata (f : Nat) : Nat := add (left (lanes f) 8) (weights f)
[?2004l[?2004h> 
[?2004l[?2004h> -- Canonical BabyBear Montgomery transcript levy.
[?2004l[?2004h> def prover (a f : Nat) : Nat :=
[?2004l[?2004h>   let x := add (a % B) (mul (f % Q) B)
[?2004l[?2004h>   let t := mul (x % B) 2281701377 % B
[?2004l[?2004h>   let u := mul Q t
[?2004l[?2004h>   let hi := sub x u / B
[?2004l[?2004h>   if x < u then sub (add Q hi) B else hi
[?2004l[?2004h> 
[?2004l[?2004h> -- Canonical Goldilocks residue of the 128-bit bridge challenge.
[?2004l[?2004h> def bridge (a f : Nat) : Nat :=
[?2004l[?2004h>   let h := right f 32
[?2004l[?2004h>   let t0 := sub a h
[?2004l[?2004h>   let t1 := if a < h then add t0 P else t0
[?2004l[?2004h>   let prod := mul (f &&& E) E
[?2004l[?2004h>   let t2 := add t1 prod
[?2004l[?2004h>   let t3 := if t2 < t1 then add t2 E else t2
[?2004l[?2004h>   if P ≤ t3 then sub t3 P else t3
[?2004l[?2004h> 
[?2004l[?2004h> def domain (f : Nat) : Nat :=
[?2004l[?2004h>   let tag := f &&& 255
[?2004l[?2004h>   if tag = 0 then 90 else tag
[?2004l[?2004h> 
[?2004l[?2004h> def base (a f : Nat) : Nat :=
[?2004l[?2004h>   netFee a f + flashRetention a f + blob a f + calldata f + prover a f + domain f
[?2004l[?2004h> 
[?2004l[?2004h> def debit (a f : Nat) : Nat := a + (base a f + bridge a f)
[?2004l[?2004h> end Policy
[?2004l[?2004h> 
[?2004l[?2004h> def candidateSpec : SecurityChallenge.AuthorizationSpec where
[?2004l[?2004h>   accepts b a f := Policy.debit a.toNat f.toNat ≤ b.toNat
[?2004l[?2004h>   output b a f totalDebit :=
[?2004l[?2004h>     Policy.debit a.toNat f.toNat ≤ b.toNat ∧
[?2004l[?2004h>     totalDebit.toNat = Policy.debit a.toNat f.toNat
