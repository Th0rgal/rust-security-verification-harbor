use crate::word_math::{extract_high_u32, extract_low_u32};
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct TranscriptHeader {
    pub version: u64,
    pub domain_tag: u64,
    pub payload_low32: u64,
    pub checksum_word: u64,
}
pub fn decode_domain_tag(word: u64) -> u64 {
    let raw_tag: u64 = word & CODEC_TAG_MASK;
    if raw_tag == 0u64 {
        SEQUENCER_DOMAIN_TAG
    } else {
        raw_tag
    }
}
pub fn build_transcript_header(amount: u64, fee: u64) -> TranscriptHeader {
    let version: u64 = CODEC_VERSION_V3;
    let domain_tag: u64 = decode_domain_tag(fee);
    let payload_low32: u64 = extract_low_u32(amount);
    let hi_fee: u64 = extract_high_u32(fee);
    let checksum_word: u64 = (payload_low32 ^ hi_fee) + (domain_tag << 8u64) + version;
    TranscriptHeader {
        version,
        domain_tag,
        payload_low32,
        checksum_word,
    }
}
pub fn verify_header_version(header: TranscriptHeader) -> bool {
    header.version == CODEC_VERSION_V3
}
pub fn fold_header_digest(header: TranscriptHeader) -> u64 {
    (header.checksum_word & LOW32_MASK) + (header.domain_tag << 32u64)
}
pub fn mix_batch_header_digests(left: TranscriptHeader, right: TranscriptHeader) -> u64 {
    let d_left: u64 = fold_header_digest(left);
    let d_right: u64 = fold_header_digest(right);
    (d_left ^ (d_right >> 16u64)).wrapping_add(left.domain_tag + right.domain_tag)
}
use crate::constants::*;
use crate::fee_schedule::FeeQuote;
use crate::word_math::{add_u64_with_carry, ceil_div_flash_u64, floor_div_flash_u64};
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct PoolReserveQuote {
    pub treasury_cut: u64,
    pub lp_retention: u64,
}
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct FlashLoanReceipt {
    pub principal: u64,
    pub flash_levy: u64,
    pub total_repayment: u64,
}
pub fn split_pool_reserve(quote: FeeQuote) -> PoolReserveQuote {
    let treasury_cut: u64 = quote.net_fee / TREASURY_CUT_DIVISOR;
    let lp_retention: u64 = quote.net_fee - treasury_cut;
    PoolReserveQuote {
        treasury_cut,
        lp_retention,
    }
}
pub fn quote_lp_retention(quote: FeeQuote) -> u64 {
    let split: PoolReserveQuote = split_pool_reserve(quote);
    split.lp_retention
}
pub fn assess_flash_fee_ceil(principal: u64, surcharge: u64) -> u64 {
    let sum = add_u64_with_carry(principal, surcharge);
    ceil_div_flash_u64(sum)
}
pub fn assess_flash_fee_floor(principal: u64, surcharge: u64) -> u64 {
    let sum = add_u64_with_carry(principal, surcharge);
    floor_div_flash_u64(sum)
}
pub fn quote_flash_repayment(principal: u64, surcharge: u64) -> Option<FlashLoanReceipt> {
    let flash_levy: u64 = assess_flash_fee_ceil(principal, surcharge);
    let total_repayment: u64 = principal.checked_add(flash_levy)?;
    Some(FlashLoanReceipt {
        principal,
        flash_levy,
        total_repayment,
    })
}
pub fn check_pool_reserve_solvency(current_reserve: u64, quote: FeeQuote, min_reserve: u64) -> bool {
    let lp_share: u64 = quote_lp_retention(quote);
    match current_reserve.checked_add(lp_share) {
        Some(updated) => updated >= min_reserve,
        None => true,
    }
}
