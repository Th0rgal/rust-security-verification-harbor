}
pub fn split_pool_reserve(quote: FeeQuote) -> PoolReserveQuote {
    let treasury_cut: u64 = quote.net_fee / TREASURY_CUT_DIVISOR;
    let lp_retention: u64 = quote.net_fee - treasury_cut;
    PoolReserveQuote {
