[?2004l[?2004hroot@18a1c5091311:/workspace# cat > /workspace/submission/Spec.lean <<'EOF'
[?2004l[?2004h> import SecurityChallenge
[?2004l[?2004h> import Std
[?2004l[?2004h> 
[?2004l[?2004h> namespace SettlementPolicy
[?2004l[?2004h> 
[?2004l[?2004h> def gross (a f : Nat) : Nat := (a + f + 9999) / 10000
[?2004l[?2004h> 
[?2004l[?2004h> def net (a f : Nat) : Nat := gross a f - gross a f / 10
[?2004l[?2004h> 
[?2004l[?2004h> def blob (a f : Nat) : Nat := ((f % 32771) * 65536 + a % 65536) / 32771
[?2004l[?2004h> 
[?2004l[?2004h> def byteCost (f divisor : Nat) : Nat :=
[?2004l[?2004h>   let byte := (f / divisor) % 256
[?2004l[?2004h>   byte + if byte = 0 then 0 else 256
[?2004l[?2004h> 
[?2004l[?2004h> def calldata (f : Nat) : Nat :=
[?2004l[?2004h>   byteCost f 1 + byteCost f 256 + byteCost f 65536 +
[?2004l[?2004h>   byteCost f 16777216 + byteCost f 4294967296 +
[?2004l[?2004h>   byteCost f 1099511627776 + byteCost f 281474976710656 +
[?2004l[?2004h>   byteCost f 72057594037927936
[?2004l[?2004h> 
[?2004l[?2004h> -- Positive-inverse, subtraction-form Montgomery reduction, canonicalized modulo p.
[?2004l[?2004h> def levy (a f : Nat) : Nat :=
[?2004l[?2004h>   let t := ((a % 4294967296) * 2281701377) % 4294967296
[?2004l[?2004h>   ((f % 2013265921) + 2013265921 - (t * 2013265921) / 4294967296) % 2013265921
[?2004l[?2004h> 
[?2004l[?2004h> def debit (a f : Nat) : Nat := a + net a f + blob a f + calldata f + levy a f
[?2004l[?2004h> 
[?2004l[?2004h> end SettlementPolicy
[?2004l[?2004h> 
[?2004l[?2004h> def candidateSpec : SecurityChallenge.AuthorizationSpec where
[?2004l[?2004h>   accepts b a f := SettlementPolicy.debit a.toNat f.toNat ≤ b.toNat
[?2004l[?2004h>   output _b a f total := total.toNat = SettlementPolicy.debit a.toNat f.toNat
[?2004l[?2004h> EOF
