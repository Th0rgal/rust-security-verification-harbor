[192.18347, "i", "python3 - <<'PY'\nimport random\nD=32771\nout='No mismatch in sample'\nfor i in range(300000):\n h=random.randrange(D); l=random.randrange(65536)\n qf=h*65524+(h<<16)+l+65536; q1=qf>>16; q0=qf&65535\n r=(0xC0000000+l-q1*D)&65535\n qc,rc=(q1-1,(r+D)&65535) if q0<r else (q1,r)\n q=qc+1 if D<=rc else qc\n e=((h<<16)+l)//D\n if q!=e: out=f'MISMATCH h={h} l={l} actual={q} exact={e}'; break\nopen('/workspace/search.txt','w').write(out)\nPY\ncat /workspace/search.txt\nsed -n '55,64p' /workspace/lean/LeanModel/WordMath.lean\nsed -n '30,62p' /workspace/challenge/src/montgomery_field.rs\n"]
