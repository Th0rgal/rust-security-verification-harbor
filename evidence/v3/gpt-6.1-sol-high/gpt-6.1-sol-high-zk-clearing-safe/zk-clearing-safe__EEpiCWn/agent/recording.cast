[157.725371, "i", "python3 - <<'PY'\nimport random\nD=32771\nM=(1<<64)-1\nfor i in range(1000000):\n h=random.randrange(D); l=random.randrange(65536)\n if i<65536: h=0; l=i\n qf=h*65524+(h<<16)+l+65536\n q1=qf>>16; q0=qf&65535\n r=(0xC0000000+l-q1*D)&65535\n qc,rc=(q1-1,(r+D)&65535) if q0<r else (q1,r)\n q=qc+1 if D<=rc else qc\n exact=((h<<16)+l)//D\n if q!=exact:\n  print('MISMATCH',h,l,q,exact);break\nelse: print('No reciprocal mismatch in sample')\nPY\n"]
[157.725605, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
