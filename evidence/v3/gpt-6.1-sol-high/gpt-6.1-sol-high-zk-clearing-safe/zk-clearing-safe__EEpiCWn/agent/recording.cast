[375.540424, "o", "326:protected theorem UInt64.mod_eq_of_lt {a b : UInt64} (h : a < b) : a % b = a := UInt64.toNat_inj.1 (Nat.mod_eq_of_lt h)\r\n332:@[simp] theorem UInt64.toNat_lt (n : UInt64) : n.toNat < 2 ^ 64 := n.toFin.isLt\r\n395:@[simp] theorem UInt64.toNat_mod_size (n : UInt64) : n.toNat % UInt64.size = n.toNat := Nat.mod_eq_of_lt n.toNat_lt\r\n871:@[simp] theorem UInt64.toNat_ofFin (x : Fin UInt64.size) : (UInt64.ofFin x).toNat = x.val := (rfl)\r\n880:theorem UInt64.toNat_ofNatClamp_of_lt {n : Nat} (hn : n < UInt64.size) :\r\n891:theorem UInt64.toNat_ofNatClamp_of_le {n : Nat} (hn : UInt64.size ≤ n) :\r\n1471:@[deprecated UInt64.toNat_ofNatClamp_of_lt (since := \"2026-05-04\")]\r\n1472:theorem UInt64.toNat_ofNatTruncate_of_lt {n : Nat} (hn : n < UInt64.size) :\r\n1474:  UInt64.toNat_ofNatClamp_of_lt hn\r\n1496:@[deprecated UInt64.toNat_ofNatClamp_of_le (since := \"2026-05-04\")]\r\n1497:theorem UInt64.toNat_ofNatTruncate_of_le {n : Nat} (hn : UInt64.size ≤ n) :\r\n1499:  UInt64.toNat_ofNatClamp_of_le hn\r\n2089:  simp [← UInt8.toNat_inj, ← UInt64.toNat_inj]\r\n2096:  simp [← UInt16.toNat_inj, ← UInt64.toNat_inj]\r\n2101:  simp [← UInt32.toNat_inj, ← UInt64.toNat_inj]\r\n2113:  simp [← UInt8.toNat_inj, ← UInt64.toNat_inj]\r\n2120:  simp [← UInt16.toNat_inj, ← UInt64.toNat_inj]\r\n2125:  simp [← UInt32.toNat_inj, ← UInt64.toNat_inj]\r\n2132:  simp [← USize.toNat_inj, ← UInt64.toNat_inj, USize.size_eq_two_pow]\r\n2176:  simp [lt_iff_toNat_lt, UInt64.lt_iff_toNat_lt]\r\n2183:  simp [lt_iff_toNat_lt, UInt64.lt_iff_toNat_lt]\r\n2188:  simp [lt_iff_toNat_lt, UInt64.lt_iff_toNat_lt]\r\n2193:  simp [lt_iff_toNat_lt, UInt64.lt_iff_toNat_lt]\r\n2218:  simp only [USize.lt_iff_toNat_lt, toNat_toUSize, lt_iff_toNat_lt, UInt64.toNat_mod, toNat_ofNat', Nat.reducePow]\r\n2226:  simp [le_iff_toNat_le, UInt64.le_iff_toNat_le]\r\n2233:  simp [le_iff_toNat_le, UInt64.le_iff_toNat_le]\r\n2238:  simp [le_iff_toNat_le, UInt64.le_iff_toNat_le]\r\n2243:  simp [le_iff_toNat_le, UInt64.le_iff_toNat_le]\r\n2268:  simp only [USize.le_iff_toNat_le, toNat_toUSize, le_iff_toNat_le, UInt64.toNat_mod]\r\n2312:@[si"]
[375.541013, "o", "mp] theorem UInt64.toNat_neg (a : UInt64) : (-a).toNat = (UInt64.size - a.toNat) % UInt64.size := (rfl)\r\n2464:  simp [← UInt64.toNat_inj]\r\n2868:theorem UInt64.toNat_one : (1 : UInt64).toNat = 1 := (rfl)\r\n3367:  simpa [lt_iff_toNat_lt, le_iff_toNat_le, ← UInt64.toNat_inj] using Nat.lt_of_le_of_ne\r\n3378:  simpa [lt_iff_toNat_lt, le_iff_toNat_le, ← UInt64.toNat_inj] using Nat.lt_iff_le_and_ne\r\n3507:  simpa [lt_iff_toNat_lt, ← UInt64.toNat_inj] using Nat.lt_or_lt_of_ne\r\n3541:  simpa [← UInt64.toNat_inj, le_iff_toNat_le, lt_iff_toNat_lt] using Nat.le_iff_lt_or_eq\r\n3558:  simp [le_iff_toNat_le, UInt64.toNat_sub_of_le _ _ hab]\r\n3575:  rw [lt_iff_toNat_lt, UInt64.toNat_sub_of_le _ _ hab]\r\n3576:  refine Nat.sub_lt ?_ (UInt64.lt_iff_toNat_lt.1 hb)\r\n3577:  exact UInt64.lt_iff_toNat_lt.1 (UInt64.lt_of_lt_of_le hb hab)\r\n\u001b[?2004hroot@18a1c5091311:/workspace# "]
