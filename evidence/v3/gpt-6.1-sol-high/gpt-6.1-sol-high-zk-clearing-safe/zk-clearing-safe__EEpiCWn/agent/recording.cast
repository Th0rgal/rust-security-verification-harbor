[157.726822, "o", "import random\r\n\u001b[?2004l\r\u001b[?2004h> D=32771\r\n\u001b[?2004l\r\u001b[?2004h> M=(1<<64)-1\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(1000000):\r\n\u001b[?2004l\r\u001b[?2004h>  h=random.randrange(D); l=random.randrange(65536)\r\n\u001b[?2004l\r\u001b[?2004h>  if i<65536: h=0; l=i\r\n\u001b[?2004l\r\u001b[?2004h>  qf=h*65524+(h<<16)+l+65536\r\n\u001b[?2004l\r\u001b[?2004h>  q1=qf>>16; q0=qf&65535\r\n\u001b[?2004l\r\u001b[?2004h>  r=(0xC0000000+l-q1*D)&65535\r\n\u001b[?2004l\r"]
