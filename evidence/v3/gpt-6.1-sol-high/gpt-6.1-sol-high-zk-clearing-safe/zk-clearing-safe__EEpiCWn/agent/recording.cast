eq_of_lt (Nat.lt_trans n.toNat_lt (by decide))\r\n389:@[simp] theorem UInt16.toNat_mod_uSizeSize (n : UInt16) : n.toNat % USize.size = n.toNat := Nat.mod_eq_of_lt n.toNat_lt_usizeSize\r\n391:@[simp] theorem UInt32.toNat_mod_size (n : UInt32) : n.toNat % UInt32.size = n.toNat := Nat.mod_eq_of_lt n.toNat_lt\r\n392:@[simp] theorem UInt32.toNat_mod_uInt64Size (n : UInt32) : n.toNat % UInt64.size = n.toNat := Nat.mod_eq_of_lt (Nat.lt_trans n.toNat_lt (by decide))\r\n393:@[simp] theorem UInt32.toNat_mod_uSizeSize (n : UInt32) : n.toNat % USize.size = n.toNat := Nat.mod_eq_of_lt n.toNat_lt_usizeSize\r\n395:@[simp] theorem UInt64.toNat_mod_size (n : UInt64) : n.toNat % UInt64.size = n.toNat := Nat.mod_eq_of_lt n.toNat_lt\r\n397:@[simp] theorem USize.toNat_mod_size (n : USize) : n.toNat % USize.size = n.toNat := Nat.mod_eq_of_lt n.toNat_lt_size\r\n398:@[simp] theorem USize.toNat_mod_uInt64Size (n : USize) : n.toNat % UInt64.size = n.toNat := Nat.mod_eq_of_lt n.toNat_lt\r\n856:  simp only [UInt32.toNat_toUSize, toNat_toUInt32, Nat.reducePow, USize.toNat_mod]\r\n1966:  simp only [toNat_toUInt32, USize.toNat_mod, Nat.reducePow, UInt32.toNat_mod]\r\n1980:  simp only [toNat_toUInt32, USize.toNat_mod, Nat.reducePow, UInt32.toNat_mod]\r\n2218:  simp only [USize.lt_iff_toNat_lt, toNat_toUSize, lt_iff_toNat_lt, UInt64.toNat_mod, toNat_ofNat', Nat.reducePow]\r\n2268:  simp only [USize.le_iff_toNat_le, toNat_toUSize, le_iff_toNat_le, UInt64.toNat_mod]\r\n2566:  rw [Int.toNat_emod h₃ (by decide), Int.toNat_add h₁ h₂]\r\n2575:  rw [Int.toNat_emod h₃ (by decide), Int.toNat_add h₁ h₂]\r\n2584:  rw [Int.toNat_emod h₃ (by decide), Int.toNat_add h₁ h₂]\r\n2593:  rw [Int.toNat_emod h₃ (by decide), Int.toNat_add h₁ h₂]\r\n2617:  rw [Int.toNat_emod h₃ two_pow_numBits_nonneg, Int.toNat_add h₁ h₂]\r\n2714:  rw [Int.toNat_emod h₃ (by decide), Int.toNat_mul h₁ h₂]\r\n2723:  rw [Int.toNat_emod h₃ (by decide), Int.toNat_mul h₁ h₂]\r\n2732:  rw [Int.toNat_emod h₃ (by decide), Int.toNat_mul h₁ h₂]\r\n27