[476.765122, "o", "open SecurityChallenge\r\n\u001b[?2004l\r"]
[476.765188, "o", "\u001b[?2004h"]
[476.765307, "o", "> "]
[476.765462, "o", "example (x : UInt64) : countNzBytes x ≤ 8 := by"]
[476.765541, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[476.765704, "o", "  unfold countNzBytes uNz8 h8Mask l8Mask\r\n\u001b[?2004l\r"]
[476.765784, "o", "\u001b[?2004h> "]
[476.765852, "o", "  bv_decide\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
