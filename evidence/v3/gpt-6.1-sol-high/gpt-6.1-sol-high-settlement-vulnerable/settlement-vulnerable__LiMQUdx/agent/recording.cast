[76.640277, "o", "source = source[:start] + '''    // Decompose the exact combined basis without ever forming amount + fee.\r\n\u001b[?2004l\r\u001b[?2004h>     // Each remainder is at most 9999; their sum plus the ceiling bias is\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.64048, "o", "    // at most 29997. The sum of quotients plus the carry is also far below\r\n\u001b[?2004l\r"]
[76.640497, "o", "\u001b[?2004h> "]
[76.641058, "o", "    // u64::MAX, even when both inputs equal u64::MAX.\r\n\u001b[?2004l\r\u001b[?2004h>     let quotients = (amount / BPS_DENOM) + (fee / BPS_DENOM);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.64125, "o", "    let remainders = (amount % BPS_DENOM) + (fee % BPS_DENOM);\r\n\u001b[?2004l\r"]
[76.641268, "o", "\u001b[?2004h"]
[76.641369, "o", "> "]
[76.64162, "o", "    let gross_fee = quotients + ((remainders + BPS_MAX_REM) / BPS_DENOM);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.641729, "o", "''' + source[end:]\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.641785, "o", "> source += '''\r\n\u001b[?2004l\r"]
[76.641897, "o", "\u001b[?2004h> #[cfg(test)]"]
