[12.791075, "o", "total 24\r\ndrwxr-xr-x 1 root root 4096 Oct  6 05:14 .\r\ndrwxr-xr-x 1 root root 4096 Oct  6 05:03 ..\r\n-rw-r--r-- 1 root root  126 Oct  6 05:03 Audit.lean\r\n-rw-r--r-- 1 root root   92 Oct  6 05:03 Proof.lean\r\n-rw-r--r-- 1 root root  129 Oct  6 05:03 Spec.lean\r\ndrwxr-xr-x 2 root root 4096 Oct  6 05:14 src\r\n"]
