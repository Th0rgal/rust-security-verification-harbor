[76.642123, "o", "\r\n\u001b[?2004l\r"]
[76.642232, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.642251, "o", "    #[test]\r\n\u001b[?2004l\r"]
[76.642293, "o", "\u001b[?2004h> "]
[76.64295, "o", "    fn ceiling_bias_wrap_must_not_undercharge() {\r\n\u001b[?2004l\r\u001b[?2004h>         let fee = 18_446_744_073_709_549_999;\r\n\u001b[?2004l\r\u001b[?2004h>         let exact_debit = 1_660_206_966_633_860;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.643151, "o", "        assert_eq!(authorize(exact_debit - 1, 0, fee), None);\r\n"]
