[76.626098, "o", "    settlementDebit amount fee ≤ balance.toNat ∧\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.626171, "o", "    totalDebit.toNat = settlementDebit amount fee\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
