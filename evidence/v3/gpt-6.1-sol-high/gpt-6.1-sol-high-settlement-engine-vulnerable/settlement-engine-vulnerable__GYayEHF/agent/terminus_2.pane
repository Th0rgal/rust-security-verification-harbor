cat > /tmp/settlement-audit.rs <<'EOF'
extern crate pristine;
extern crate repaired;

fn expected(balance: u64, amount: u64, fee: u64) -> Option<u64> {
    let gross = (amount as u128 + fee as u128 + 9999) / 10000;
    let debit = amount as u128 + gross - gross / 10;
    if debit <= balance as u128 { Some(debit as u64) } else { None }
}
fn check(balance: u64, amount: u64, fee: u64) {
    assert_eq!(repaired::authorize(balance, amount, fee).map(|x| x.total_debit),
               expected(balance, amount, fee), "b={balance}, a={amount}, f={fee}");
}
fn main() {
    let b = 1660206966633859;
    let f = 18446744073709541617;
    assert_eq!(pristine::authorize(b, 0, f).unwrap().total_debit, b);
    assert_eq!(expected(b, 0, f), None);
    check(b, 0, f);
    check(b + 1, 0, f);
    let amounts = [0, 1, 9999, 10000, 100000, u64::MAX / 2, u64::MAX - 10000, u64::MAX];
    for offset in 0..=25000 {
        for a in amounts {
            let f = u64::MAX - offset;
            check(u64::MAX, a, f);
            if let Some(d) = expected(u64::MAX, a, f) {
                check(d, a, f);
                if d > 0 { check(d - 1, a, f); }
            }
        }
    }
    let mut seed = 123456789u64;
    for _ in 0..100000 {
        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1);
        let a = seed;
        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1);
        let f = seed;
        check(u64::MAX, a, f);
        if let Some(d) = expected(u64::MAX, a, f) {
            check(d, a, f);
            if d > 0 { check(d - 1, a, f); }
        }
    }
    println!("Original counterexample confirmed; repaired boundary and random oracle checks passed.");
}
EOF
