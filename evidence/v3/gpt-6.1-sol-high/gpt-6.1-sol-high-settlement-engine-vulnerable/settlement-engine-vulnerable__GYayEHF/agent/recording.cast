[44.15215, "i", "python3 - <<'PY'\nM = 2**64\namount = 0\nfee = M - 9999\nbiased = (fee + 9999) % M\nbad_gross = fee // 10000 + (biased + 1616) // 10000\ngross = (amount + fee + 9999) // 10000\nbad_debit = amount + bad_gross - bad_gross // 10\ndebit = amount + gross - gross // 10\nprint(dict(balance=bad_debit, amount=amount, fee=fee))\nprint('bad gross/debit:', bad_gross, bad_debit, 'correct gross/debit:', gross, debit)\nPY\n"]
[44.153942, "o", "python3 - <<'PY'"]
[44.157437, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> M = 2**64\r\n\u001b[?2004l\r\u001b[?2004h> amount = 0\r\n\u001b[?2004l\r\u001b[?2004h> fee = M - 9999\r\n\u001b[?2004l\r\u001b[?2004h> biased = (fee + 9999) % M\r\n\u001b[?2004l\r\u001b[?2004h> bad_gross = fee // 10000 + (biased + 1616) // 10000\r\n\u001b[?2004l\r\u001b[?2004h> gross = (amount + fee + 9999) // 10000\r\n\u001b[?2004l\r\u001b[?2004h> bad_debit = amount + bad_gross - bad_gross // 10\r\n\u001b[?2004l\r\u001b[?2004h> debit = amount + gross - gross // 10\r\n\u001b[?2004l\r\u001b[?2004h> print(dict(balance=bad_debit, amount=amount, fee=fee))\r\n\u001b[?2004l\r\u001b[?2004h> print('bad gross/debit:', bad_gross, bad_debit, 'correct gross/debit:', gross, debit)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[44.190919, "o", "{'balance': 1660206966633859, 'amount': 0, 'fee': 18446744073709541617}\r\nbad gross/debit: 1844674407370954 1660206966633859 correct gross/debit: 1844674407370955 1660206966633860\r\n"]
