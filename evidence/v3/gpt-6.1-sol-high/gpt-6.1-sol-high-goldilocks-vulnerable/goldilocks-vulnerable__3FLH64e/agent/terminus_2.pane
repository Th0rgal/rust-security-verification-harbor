+
+#[cfg(test)]
+mod borrow_regression_tests {
+    use super::*;
+
+    #[test]
+    fn high_limb_borrow_uses_the_exact_surcharge() {
+        let fee = 1u64 << 32;
+        let debit = field::GOLDILOCKS_MODULUS - 1;
+        assert_eq!(field::reduce_128(0, fee), debit);
+        assert_eq!(authorize(4_294_967_294, 0, fee), None);
