[237.032647, "o", "\u001b[32m\u001b[K133\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  simp only [UInt64.le_iff_toNat_le, U̵I̵n̵t̵6̵4̵.̵t̵o̵N̵a̵t̵_̵s̵u̵b̵_̵o̵f̵_̵l̵e̵ ̵_̵ ̵_̵ ̵h̵p̵,̵u64Max, principalDivisor, UInt64.toNat_div,\r\n\u001b[32m\u001b[K134\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  ̲  ̲ ̲ ̲ ̲ ̲ ̲ ̲ ̲ ̲UInt64.toNat_ofNat, Nat.reducePow, Nat.reduceMod] at hs\r\n\u001b[32m\u001b[K135\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K136\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KNote: This linter can be disabled with `set_option linter.unusedSimpArgs false`\r\n\u001b[32m\u001b[K137\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KCandidateSpec.lean:177:36: warning: This simp argument is unused:\r\n\u001b[32m\u001b[K138\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K  UInt64.toNat_div\r\n"]
