[45.125498, "o", "def settlementDebit (amount fee : UInt64) : Nat :=\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.125963, "o", "  amount.toNat / 2 +\r\n\u001b[?2004l\r\u001b[?2004h>     (amount.toNat + fee.toNat * 18446744073709551616 + 999999) / 1000000\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
