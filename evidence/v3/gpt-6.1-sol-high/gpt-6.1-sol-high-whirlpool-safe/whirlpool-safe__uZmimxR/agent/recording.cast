[304.79565, "o", "\r\nHint: Omit it from the simp argument list.\r\n  simp_all [← UInt64.toNat_inj, UInt64.toNat_add, UInt64.toNat_div, p̵r̵i̵n̵c̵i̵p̵a̵l̵D̵i̵v̵i̵s̵o̵r̵,̵ ̵N̵a̵t̵.̵m̵o̵d̵_̵e̵q̵_̵o̵f̵_̵l̵t̵ ̵h̵n̵]̵p̲r̲i̲n̲c̲i̲p̲a̲l̲D̲i̲v̲i̲s̲o̲r̲]̲\r\n\r\nNote: This linter can be disabled with `set_option linter.unusedSimpArgs false`\r\n"]
