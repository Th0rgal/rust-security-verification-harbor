[269.126623, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> theorem authorize_correct (b a f : UInt64) :\r\n\u001b[?2004l\r\u001b[?2004h>     (∃ t, challengeAuthorize b a f = some t) ↔ settlementDebit a f ≤ b.toNat := by\r\n\u001b[?2004l\r\u001b[?2004h>   constructor\r\n\u001b[?2004l\r\u001b[?2004h>   · rintro ⟨t, ht⟩\r\n\u001b[?2004l\r\u001b[?2004h> "]
