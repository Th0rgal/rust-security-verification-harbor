[247.596026, "o", "\r\n/opt/lean/src/lean/Lean/Elab/Tactic/BVDecide/Frontend/BVDecide.lean:314:  let bvExpr := reflectionResult.bvExpr\r\n/opt/lean/src/lean/Lean/Elab/Tactic/BVDecide/Frontend/BVDecide.lean:348:    let proof ← cert.toReflectionProof ctx reflectionResult\r\n/opt/lean/src/lean/Lean/Elab/Tactic/BVDecide/Frontend/BVDecide.lean:353:    return .error { goal, unusedHypotheses := reflectionResult.unusedHypotheses, equations }\r\n/opt/lean/src/lean/Lean/Elab/Tactic/BVDecide/Frontend/BVDecide.lean:385:    let reflectionResult ←\r\n/opt/lean/src/lean/Lean/Elab/Tactic/BVDecide/Frontend/BVDecide.lean:388:    trace[Meta.Tactic.bv] \"Reflected bv logical expression: {reflectionResult.bvExpr}\"\r\n/opt/lean/src/lean/Lean/Elab/Tactic/BVDecide/Frontend/BVDecide.lean:393:    match ← unsatProver g reflectionResult atomsAssignment with"]
