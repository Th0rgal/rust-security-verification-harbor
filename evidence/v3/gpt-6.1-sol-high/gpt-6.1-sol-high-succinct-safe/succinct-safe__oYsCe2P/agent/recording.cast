[247.596081, "o", "/opt/lean/src/lean/Lean/Elab/Tactic/BVDecide/Frontend/BVDecide.lean:402:    withTraceNode `Meta.Tactic.bv (fun _ => return \"Preparing LRAT reflection term\") do\r\n/opt/lean/src/lean/Lean/Elab/Tactic/BVDecide/Frontend/BVDecide.lean:403:      lratBitblaster g ctx reflectionResult atomsAssignment\r\n/opt/lean/src/lean/Lean/Elab/Tactic/BVDecide/Frontend/BVTrace.lean:52:    1. Introduce `ByteArray` literals to the kernel.\r\n"]
