[74.793337, "o", "\u001b[?2004h> "]
[74.793497, "o", "def nz (x : UInt64) : UInt64 := if x = 0 then 0 else 1\r\n\u001b[?2004l\r"]
[74.793535, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[74.793562, "o", "> "]
[74.793777, "o", "theorem count_correct (f : UInt64) : countNzBytes f =\r\n\u001b[?2004l\r"]
[74.793811, "o", "\u001b[?2004h> "]
[74.794042, "o", "  nz (ub f 0) + nz (ub f 8) + nz (ub f 16) + nz (ub f 24) +\r\n\u001b[?2004l\r"]
[74.794113, "o", "\u001b[?2004h> "]
