[74.785516, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> /-- An individual fee byte, interpreted as a natural number. -/\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.785596, "o", "def feeByte (fee : UInt64) (i : Nat) : Nat :=\r\n\u001b[?2004l\r"]
[74.785735, "o", "\u001b[?2004h>   (fee.toNat / 2 ^ (8 * i)) % 256\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.78581, "o", "def byteCharge (b : Nat) : Nat := (if b = 0 then 0 else 256) + b\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.785908, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.786161, "o", "/-- Settlement uses exact arithmetic, including the half-principal rounded down. -/\r\n\u001b[?2004l\r"]
[74.786202, "o", "\u001b[?2004h> "]
[74.786361, "o", "def exactDebit (amount fee : UInt64) : Nat :=\r\n\u001b[?2004l\r"]
[74.786394, "o", "\u001b[?2004h> "]
[74.786527, "o", "  amount.toNat / 2 +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.786715, "o", "  byteCharge (feeByte fee 0) + byteCharge (feeByte fee 1) +\r\n\u001b[?2004l\r"]
[74.786779, "o", "\u001b[?2004h> "]
[74.78696, "o", "  byteCharge (feeByte fee 2) + byteCharge (feeByte fee 3) +\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.787021, "o", "> "]
[74.787197, "o", "  byteCharge (feeByte fee 4) + byteCharge (feeByte fee 5) +\r\n\u001b[?2004l\r"]
[74.78727, "o", "\u001b[?2004h> "]
[74.78743, "o", "  byteCharge (feeByte fee 6) + byteCharge (feeByte fee 7)\r\n\u001b[?2004l\r"]
[74.787493, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.787639, "o", "def candidateSpec : AuthorizationSpec where\r\n\u001b[?2004l\r"]
[74.787675, "o", "\u001b[?2004h> "]
[74.78791, "o", "  accepts := fun balance amount fee => exactDebit amount fee ≤ balance.toNat\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.787946, "o", "> "]
[74.788084, "o", "  output := fun balance amount fee totalDebit =>\r\n\u001b[?2004l\r"]
[74.788118, "o", "\u001b[?2004h> "]
[74.788393, "o", "    exactDebit amount fee ≤ balance.toNat ∧ totalDebit.toNat = exactDebit amount fee\r\n\u001b[?2004l\r"]
[74.788426, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
