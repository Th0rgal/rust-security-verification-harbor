[247.596222, "o", "/opt/lean/src/lean/Lean/Elab/Tactic/BVDecide/Frontend/BVCheck.lean:49:      let proof ← lratChecker ctx reflectionResult\r\n/opt/lean/src/lean/Lean/Elab/Tactic/BVDecide/Frontend/BVDecide/Reflect.lean:17:This module contains the implementation of the reflection monad, used by all other components of this\r\n/opt/lean/src/lean/Lean/Elab/Tactic/BVDecide/Frontend/BVDecide/Reflect.lean:137:The state of the reflection monad\r\n"]
