[87.771556, "o", "240:        `(@[simp] theorem toNat_toUInt64 (x : $typeName) : x.toUInt64.toNat = x.toNat := (rfl))\r\n255:@[simp] theorem USize.toNat_toUInt64 (x : USize) : x.toUInt64.toNat = x.toNat := (rfl)\r\n305:theorem UInt64.lt_ofNat_iff {n : UInt64} {m : Nat} (h : m < size) : n < ofNat m ↔ n.toNat < m := by\r\n307:theorem UInt64.ofNat_lt_iff {n : UInt64} {m : Nat} (h : m < size) : ofNat m < n ↔ m < n.toNat := by\r\n309:theorem UInt64.le_ofNat_iff {n : UInt64} {m : Nat} (h : m < size) : n ≤ ofNat m ↔ n.toNat ≤ m := by\r\n311:theorem UInt64.ofNat_le_iff {n : UInt64} {m : Nat} (h : m < size) : ofNat m ≤ n ↔ m ≤ n.toNat := by\r\n326:protected theorem UInt64.mod_eq_of_lt {a b : UInt64} (h : a < b) : a % b = a := UInt64.toNat_inj.1 (Nat.mod_eq_of_lt h)\r\n332:@[simp] theorem UInt64.toNat_lt (n : UInt64) : n.toNat < 2 ^ 64 := n.toFin.isLt\r\n383:@[simp] theorem UInt8.toNat_mod_uInt64Size (n : UInt8) : n.toNat % UInt64.size = n.toNat := Nat.mod_eq_of_lt (Nat.lt_trans n.toNat_lt (by decide))\r\n388:@[simp] theorem UInt16.toNat_mod_uInt64Size (n : UInt16) : n.toNat % UInt64.size = n.toNat := Nat.mod_eq_of_lt (Nat.lt_trans n.toNat_lt (by decide))\r\n392:@[simp] theorem UInt32.toNat_mod_uInt64Size (n : UInt32) : n.toNat % UInt64.size = n.toNat := Nat.mod_eq_of_lt (Nat.lt_trans n.toNat_lt (by decide))\r\n395:@[simp] theorem UInt64.toNat_mod_size (n : UInt64) : n.toNat % UInt64.size = n.toNat := Nat.mod_eq_of_lt n.toNat_lt\r\n398:@[simp] theorem USize.toNat_mod_uInt64Size (n : USize) : n.toNat % UInt64.size = n.toNat := Nat.mod_eq_of_lt n.toNat_lt\r\n402:@[simp] theorem UInt8.toUInt64_mod_256 (n : UInt8) : n.toUInt64 % 256 = n.toUInt64 := UInt64.toNat.inj (by simp)\r\n406:@[simp] theorem UInt16.toUInt64_mod_65536 (n : UInt16) : n.toUInt64 % 65536 = n.toUInt64 := UInt64.toNat.inj (by simp)\r\n409:@[simp] theorem UInt32.toUInt64_mod_4294967296 (n : UInt32) : n.toUInt64 % 4294967296 = n.toUInt64 := UInt64.toNat.inj (by simp)\r\n414:@[simp] theorem Fin.mk_uInt64ToNat (n : UInt64) : Fin.mk n.toNat (by exact n.toFin.isLt) = n.toFin := (rfl)\r\n420:@[simp] theorem BitVec.ofNatLT_uInt64ToNat (n : UInt64) : BitVec.ofNatLT n.toNat (by exact n.toFin.isLt) = n.toBitVec := (rfl)\r\n479:@[simp] theorem UInt64.ofNatLT_uInt8ToNat (n : UInt8) : UInt64.ofNatLT n.toNat (Nat.lt_trans n.toNat_lt (by decide)) = n.toUInt64 := (rfl)\r\n484:@[simp] theorem UInt64.ofNatLT_uInt16ToNat (n : UInt16) : UInt64.ofNatLT n.toNat (Nat.lt_trans n.toNat_lt (by decide)) = n.toUInt64 := (rfl)\r\n488:@[simp] theorem UInt64.ofNatLT_uInt32ToNat (n : UInt32) : UInt64.ofNatLT n.toNat (Nat.lt_trans n.toNat_lt (by decide)) = n.toUInt64 := (rfl)\r\n491:@[simp] theorem UInt64.ofNatLT_toNat (n : UInt64) : UInt64.ofNatLT n.toNat n.toNat_lt = n := (rfl)\r\n494:@[simp] theorem UInt64.ofNatLT_uSizeToNat (n : USize) : UInt64.ofNatLT n.toNat n.toNat_lt = n.toUInt64 := (rfl)\r\n501:theorem UInt8.ofNatLT_uInt64ToNat (n : UInt64) (h) : UInt8.ofNatLT n.toNat h = n.toUInt8 :=\r\n507:theorem UInt16.ofNatLT_uInt64ToNat (n : UInt64) (h) : UInt16.ofNatLT n.toNat h = n.toUInt16 :=\r\n511:theorem UInt32.ofNatLT_uInt64ToNat (n : UInt64) (h) : UInt32.ofNatLT n.toNat h = n.toUInt32 :=\r\n515:theorem USize.ofNatLT_uInt64ToNat (n : UInt64) (h) : USize.ofNatLT n.toNat h = n.toUSize :=\r\n584:  UInt64.toNat.inj (by simp)\r\n601:@[simp] theorem UInt8.ofNat_uInt64ToNat (n : UInt64) : UInt8.ofNat n.toNat = n.toUInt8 := (rfl)\r\n607:@[simp] theorem UInt16.ofNat_uInt64ToNat (n : UInt64) : UInt16.ofNat n.toNat = n.toUInt16 := (rfl)\r\n614:@[simp] theorem UInt32.ofNat_uInt64ToNat (n : UInt64) : UInt32.ofNat n.toNat = n.toUInt32 := (rfl)\r\n617:@[simp] theorem UInt64.ofNat_uInt8ToNat (n : UInt8) : UInt64.ofNat n.toNat = n.toUInt64 :=\r\n618:  UInt64.toNat.inj (by simp)\r\n619:@[simp] theorem UInt64.ofNat_uInt16ToNat (n : UInt16) : UInt64.ofNat n.toNat = n.toUInt64 :=\r\n620:  UInt64.toNat.inj (by simp)\r\n621:@[simp] theorem UInt64.ofNat_uInt32ToNat (n : UInt32) : UInt64.ofNat n.toNat = n.toUInt64 :=\r\n622:  UInt64.toNat.inj (by simp)\r\n623:@[simp] theorem UInt64.ofNat_uSizeToNat (n : USize) : UInt64.ofNat n.toNat = n.toUInt64 :=\r\n624:  UInt64.toNat.inj (by simp)\r\n632:@[simp] theorem USize.ofNat_uInt64ToNat (n : UInt64) : USize.ofNat n.toNat = n.toUSize :=\r\n642:  UInt64.toNat.inj (by simp [Nat.mod_eq_of_lt h])\r\n680:@[simp] theorem UInt64.ofNatClamp_uInt8ToNat (n : UInt8) : UInt64.ofNatClamp n.toNat = n.toUInt64 := by\r\n683:@[simp] theorem UInt64.ofNatClamp_uInt16ToNat (n : UInt16) : UInt64.ofNatClamp n.toNat = n.toUInt64 := by\r\n686:@[simp] theorem UInt64.ofNatClamp_uInt32ToNat (n : UInt32) : UInt64.ofNatClamp n.toNat = n.toUInt64 := by\r\n689:@[simp] theorem UInt64.ofNatClamp_toNat (n : UInt64) : UInt64.ofNatClamp n.toNat = n := by\r\n690:  rw [UInt64.ofNatClamp_eq_ofNat] <;> simp [n.toNat_lt]\r\n691:@[simp] theorem UInt64.ofNatClamp_uSizeToNat (n : USize) : UInt64.ofNatClamp n.toNat = n.toUInt64 := by\r\n871:@[simp] theorem UInt64.toNat_ofFin (x : Fin UInt64.size) : (UInt64.ofFin x).toNat = x.val := (rfl)\r\n880:theorem UInt64.toNat_ofNatClamp_of_lt {n : Nat} (hn : n < UInt64.size) :\r\n881:    (UInt64.ofNatClamp n).toNat = n := by rw [UInt64.ofNatClamp, dif_pos hn, toNat_ofNatLT]\r\n891:theorem UInt64.toNat_ofNatClamp_of_le {n : Nat} (hn : UInt64.size ≤ n) :\r\n892:    (UInt64.ofNatClamp n).toNat = UInt64.size - 1 := by rw [ofNatClamp, dif_neg (by omega), toNat_ofNatLT]\r\n1019:@[simp] theorem UInt64.toUInt8_ofNat' (n : Nat) : (UInt64.ofNat n).toUInt8 = UInt8.ofNat n := UInt8.toNat.inj (by simp)\r\n1063:@[simp] theorem UInt64.toUInt16_ofNat' (n : Nat) : (UInt64.ofNat n).toUInt16 = UInt16.ofNat n := UInt16.toNat.inj (by simp)\r\n1097:@[simp] theorem UInt64.toUInt32_ofNat' (n : Nat) : (UInt64.ofNat n).toUInt32 = UInt32.ofNat n := UInt32.toNat.inj (by simp)\r\n1122:@[simp] theorem UInt64.toUSize_ofNat' (n : Nat) : (UInt64.ofNat n).toUSize = USize.ofNat n := USize.toNat.inj (by simp)"]
[87.771689, "o", "\r\n1165:  UInt64.toNat.inj (by simp [toNat_ofNatClamp_of_lt hn])\r\n1178:  UInt64.toNat.inj (by simp [toNat_ofNatClamp_of_le hn])\r\n1207:  UInt64.toNat.inj (by simp [toNat_ofNatClamp_of_lt hn])\r\n1217:  UInt64.toNat.inj (by simp [toNat_ofNatClamp_of_le hn])\r\n1238:  UInt64.toNat.inj (by simp [toNat_ofNatClamp_of_lt hn])\r\n1245:  UInt64.toNat.inj (by simp [toNat_ofNatClamp_of_le hn])\r\n1261:  UInt64.toNat.inj (by simp [toNat_ofNatClamp_of_lt hn])\r\n1265:  UInt64.toNat.inj (by simp [toNat_ofNatClamp_of_le hn])\r\n1324:@[simp] theorem UInt64.ofNatLT_bitVecToNat (n : BitVec 64) : UInt64.ofNatLT n.toNat n.isLt = UInt64.ofBitVec n := (rfl)\r\n1344:@[simp] theorem UInt64.ofNat_bitVecToNat (n : BitVec 64) : UInt64.ofNat n.toNat = UInt64.ofBitVec n := by\r\n1366:@[simp] theorem UInt64.ofNatClamp_bitVecToNat (n : BitVec 64) : UInt64.ofNatClamp n.toNat = UInt64.ofBitVec n := by\r\n1421:theorem UInt64.ofNatTruncate_uInt8ToNat (n : UInt8) : UInt64.ofNatClamp n.toNat = n.toUInt64 :=\r\n1425:theorem UInt64.ofNatTruncate_uInt16ToNat (n : UInt16) : UInt64.ofNatClamp n.toNat = n.toUInt64 :=\r\n1429:theorem UInt64.ofNatTruncate_uInt32ToNat (n : UInt32) : UInt64.ofNatClamp n.toNat = n.toUInt64 :=\r\n1432:@[deprecated UInt64.ofNatClamp_toNat (since := \"2026-05-04\")]\r\n"]
