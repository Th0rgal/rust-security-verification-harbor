[163.962359, "o", "/opt/lean/src/lean/Init/Data/UInt/Lemmas.lean:2368:theorem UInt64.sub_eq_add_mul (a b : UInt64) : a - b = a + 18446744073709551615 * b := by\r\n/opt/lean/src/lean/Init/Data/UInt/Lemmas.lean:2889:protected theorem UInt64.add_assoc (a b c : UInt64) : a + b + c = a + (b + c) :=\r\n/opt/lean/src/lean/Init/Data/UInt/Lemmas.lean:2890:  UInt64.toBitVec_inj.1 (BitVec.add_assoc _ _ _)\r\n/opt/lean/src/lean/Init/Data/UInt/Lemmas.lean:2897:instance : Std.Associative (α := UInt64) (· + ·) := ⟨UInt64.add_assoc⟩\r\n/opt/lean/src/lean/Init/Data/UInt/Lemmas.lean:2903:protected theorem UInt64.add_comm (a b : UInt64) : a + b = b + a := UInt64.toBitVec_inj.1 (BitVec.add_comm _ _)\r\n/opt/lean/src/lean/Init/Data/UInt/Lemmas.lean:2909:instance : Std.Commutative (α := UInt64) (· + ·) := ⟨UInt64.add_comm⟩\r\n/opt/lean/src/lean/Init/Data/UInt/Lemmas.lean:3045:  rw [UInt64.sub_eq_add_neg, UInt64.neg_add, UInt64.sub_neg, UInt64.add_comm, ← UInt64.sub_eq_add_neg]\r\n/opt/lean/src/lean/Init/Data/UInt/Lemmas.lean:3246:protected theorem UInt64.mul_add {a b c : UInt64} : a * (b + c) = a * b + a * c :=\r\n/opt/lean/src/lean/Init/Data/UInt/Lemmas.lean:3247:    UInt64.toBitVec_inj.1 BitVec.mul_add\r\n/opt/lean/src/lean/Init/Data/UInt/Lemmas.lean:3257:protected theorem UInt64.add_mul {a b c : UInt64} : (a + b) * c = a * c + b * c := by\r\n/opt/lean/src/lean/Init/Data/UInt/Lemmas.lean:3258:  rw [UInt64.mul_comm, UInt64.mul_add, UInt64.mul_comm a c, UInt64.mul_comm c b]\r\n/opt/lean/src/lean/Init/Data/UInt/Lemmas.lean:3265:protected theorem UInt64.mul_succ {a b : UInt64} : a * (b + 1) = a * b + a := by simp [UInt64.mul_add]\r\n/opt/lean/src/lean/Init/Data/UInt/Lemmas.lean:3271:protected theorem UInt64.succ_mul {a b : UInt64} : (a + 1) * b = a * b + b := by simp [UInt64.add_mul]\r\n/opt/lean/src/lean/Init/Data/UInt/Lemmas.lean:3333:theorem UInt64.neg_add_mul_eq_mul_not {a b : UInt64} : -(a + a * b) = a * ~~~b :=\r\n/opt/lean/src/lean/Init/Data/UInt/Lemmas.lean:3334:  UInt64.toBitVec_inj.1 BitVec.neg_add_mul_eq_mul_not\r\n/opt/lean/src/lean/Init/Data/UInt/Lemmas.lean:3344:theorem UInt64.neg_mul_not_eq_add_mul {a b : UInt64} : -(a * ~~~b) = a + a * b :=\r\n/opt/lean/src/lean/Init/Data/UInt/Lemmas.lean:3345:  UInt64.toBitVec_inj.1 BitVec.neg_mul_not_eq_add_mul\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:244:theorem UInt64.shiftLeft_eq_shiftLeft_mod (a b : UInt64) : a <<< b = a <<< (b % 64) := UInt64.toBitVec_inj.1 (by simp)\r\n"]
[163.964379, "o", "     1\timport SecurityChallenge\r\n     2\timport Std.Tactic.BVDecide\r\n     3\topen SecurityChallenge\r\n     4\t\r\n     5\t/-- An individual fee byte, interpreted as a natural number. -/"]
[163.964889, "o", "\r\n     6\tdef feeByte (fee : UInt64) (i : Nat) : Nat :=\r\n     7\t  (fee.toNat / 2 ^ (8 * i)) % 256\r\n     8\t\r\n     9\tdef byteCharge (b : Nat) : Nat := (if b = 0 then 0 else 256) + b\r\n    10\t\r\n    11\t/-- Settlement uses exact arithmetic, including the half-principal rounded down. -/\r\n    12\tdef exactDebit (amount fee : UInt64) : Nat :=\r\n    13\t  amount.toNat / 2 +\r\n    14\t  byteCharge (feeByte fee 0) + byteCharge (feeByte fee 1) +\r\n    15\t  byteCharge (feeByte fee 2) + byteCharge (feeByte fee 3) +\r\n    16\t  byteCharge (feeByte fee 4) + byteCharge (feeByte fee 5) +\r\n    17\t  byteCharge (feeByte fee 6) + byteCharge (feeByte fee 7)\r\n    18\t\r\n    19\tdef candidateSpec : AuthorizationSpec where\r\n    20\t  accepts := fun balance amount fee => exactDebit amount fee ≤ balance.toNat\r\n    21\t  output := fun balance amount fee totalDebit =>\r\n    22\t    exactDebit amount fee ≤ balance.toNat ∧ totalDebit.toNat = exactDebit amount fee\r\n    23\t\r\n    24\tset_option maxRecDepth 4096\r\n    25\tset_option maxHeartbeats 0\r\n    26\t\r\n    27\tdef ub (f : UInt64) (i : UInt64) : UInt64 := (f >>> i) &&& 255\r\n    28\tdef nz (x : UInt64) : UInt64 := if x = 0 then 0 else 1\r\n    29\t\r\n    30\ttheorem count_correct (f : UInt64) : countNzBytes f =\r\n    31\t  nz (ub f 0) + nz (ub f 8) + nz (ub f 16) + nz (ub f 24) +\r\n    32\t  nz (ub f 32) + nz (ub f 40) + nz (ub f 48) + nz (ub f 56) := by\r\n    33\t  unfold countNzBytes uNz8 l8Mask h8Mask ub nz\r\n    34\t  bv_decide\r\n    35\t\r\n    36\ttheorem sum_correct (f : UInt64) : sumBytes f =\r\n    37\t  ub f 0 + ub f 8 + ub f 16 + ub f 24 +\r\n    38\t  ub f 32 + ub f 40 + ub f 48 + ub f 56 := by\r\n    39\t  unfold sumBytes m16Mask l16Mask ub\r\n    40\t  bv_decide\r\n    41\t\r\n    42\tdef wc (x : UInt64) : UInt64 := (if x = 0 then 0 else 256) + x\r\n    43\t\r\n    44\ttheorem debit_word (a f : UInt64) :\r\n    45\t  (a >>> 1) + (countNzBytes f <<< 8) + sumBytes f =\r\n    46\t  a / 2 + wc (ub f 0) + wc (ub f 8) + wc (ub f 16) + wc (ub f 24) +\r\n    47\t  wc (ub f 32) + wc (ub f 40) + wc (ub f 48) + wc (ub f 56) := by\r\n    48\t  rw [count_correct, sum_correct]\r\n    49\t  unfold wc nz ub\r\n    50\t  bv_decide\r\n    51\t\r\n    52\ttheorem ub_as_mod (f : UInt64) :\r\n    53\t  ub f 0 = (f / 1) % 256 ∧ ub f 8 = (f / 256) % 256 ∧\r\n    54\t  ub f 16 = (f / 65536) % 256 ∧ ub f 24 = (f / 16777216) % 256 ∧\r\n    55\t  ub f 32 = (f / 4294967296) % 256 ∧ ub f 40 = (f / 1099511627776) % 256 ∧\r\n    56\t  ub f 48 = (f / 281474976710656) % 256 ∧ ub f 56 = (f / 72057594037927936) % 256 := by\r\n    57\t  unfold ub\r\n    58\t  bv_decide\r\n    59\t\r\n    60\t theorem byte_nat (f : UInt64) :\r\n    61\t  (ub f 0).toNat = feeByte f 0 ∧ (ub f 8).toNat = feeByte f 1 ∧\r\n    62\t  (ub f 16).toNat = feeByte f 2 ∧ (ub f 24).toNat = feeByte f 3 ∧\r\n    63\t  (ub f 32).toNat = feeByte f 4 ∧ (ub f 40).toNat = feeByte f 5 ∧\r\n    64\t  (ub f 48).toNat = feeByte f 6 ∧ (ub f 56).toNat = feeByte f 7 := by\r\n    65\t  rcases ub_as_mod f with ⟨h0,h1,h2,h3,h4,h5,h6,h7⟩\r\n    66\t  simp [h0,h1,h2,h3,h4,h5,h6,h7,feeByte]\r\n    67\t\r\n    68\t theorem charge_nat (x : UInt64) (h : x.toNat < 256) :\r\n    69\t  (wc x).toNat = byteCharge x.toNat := by\r\n    70\t  by_cases hx : x = 0\r\n    71\t  · simp [wc, byteCharge, hx]\r\n    72\t  · have hn : x.toNat ≠ 0 := by\r\n    73\t      intro hn\r\n    74\t      apply hx\r\n    75\t      apply UInt64.toNat.inj\r\n    76\t      simpa using hn\r\n    77\t    simp [wc, byteCharge, hx, hn, UInt64.toNat_add]\r\n    78\t    omega\r\n    79\t\r\n    80\t theorem charge_bound (f : UInt64) (i : Nat) : byteCharge (feeByte f i) ≤ 511 := by\r\n    81\t  have hb : feeByte f i < 256 := Nat.mod_lt _ (by decide)\r\n    82\t  unfold byteCharge\r\n    83\t  split <;> omega\r\n    84\t\r\n    85\t theorem debit_nat (a f : UInt64) :\r\n    86\t  ((a >>> 1) + (countNzBytes f <<< 8) + sumBytes f).toNat = exactDebit a f := by\r\n    87\t  rw [debit_word]\r\n    88\t  rcases byte_nat f with ⟨h0,h1,h2,h3,h4,h5,h6,h7⟩\r\n    89\t  have hb (i : Nat) : feeByte f i < 256 := Nat.mod_lt _ (by decide)\r\n    90\t  have c0 := charge_nat (ub f 0) (by rw [h0]; exact hb 0)\r\n    91\t  have c1 := charge_nat (ub f 8) (by rw [h1]; exact hb 1)\r\n    92"]
[163.96497, "o", "\t  have c2 := charge_nat (ub f 16) (by rw [h2]; exact hb 2)\r\n    93\t  have c3 := charge_nat (ub f 24) (by rw [h3]; exact hb 3)\r\n    94\t  have c4 := charge_nat (ub f 32) (by rw [h4]; exact hb 4)\r\n    95\t  have c5 := charge_nat (ub f 40) (by rw [h5]; exact hb 5)\r\n\u001b[?2004hroot@d4dcfb267f27:/workspace# "]
[183.310789, "i", "python3 - <<'PY'\np='/workspace/lean/Explore.lean'; s=open(p).read(); pos=s.index('theorem debit_word'); s=s[:pos]+'''theorem shift_mul (x : UInt64) : x <<< 8 = x * 256 := by bv_decide\n\ntheorem half_shift (x : UInt64) : x >>> 1 = x / 2 := by bv_decide\n\ntheorem nz_scaled (x : UInt64) : nz x * 256 = (if x = 0 then 0 else 256) := by\n  unfold nz\n  split <;> decide +revert\n\n'''+s[pos:]; s=s.replace('  unfold wc nz ub\\n  bv_decide','  rw [half_shift, shift_mul]\\n  simp only [UInt64.add_mul, nz_scaled, wc]\\n  ac_rfl'); open(p,'w').write(s)\nPY\ncd /workspace/lean && LEAN_PATH=/workspace/lean lean Explore.lean > /workspace/explore3.log 2>&1 &\n"]
