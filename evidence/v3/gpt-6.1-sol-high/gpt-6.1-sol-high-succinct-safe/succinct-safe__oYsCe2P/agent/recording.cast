[291.784575, "o", "theorem count_correct : ∀ (f : UInt64),\r\n  @Eq.{1} UInt64 (SecurityChallenge.countNzBytes f)\r\n    (@HAdd.hAdd.{0, 0, 0} UInt64 UInt64 UInt64 (@instHAdd.{0} UInt64 instAddUInt64)\r\n      (@HAdd.hAdd.{0, 0, 0} UInt64 UInt64 UInt64 (@instHAdd.{0} UInt64 instAddUInt64)\r\n        (@HAdd.hAdd.{0, 0, 0} UInt64 UInt64 UInt64 (@instHAdd.{0} UInt64 instAddUInt64)\r\n          (@HAdd.hAdd.{0, 0, 0} UInt64 UInt64 UInt64 (@instHAdd.{0} UInt64 instAddUInt64)\r\n            (@HAdd.hAdd.{0, 0, 0} UInt64 UInt64 UInt64 (@instHAdd.{0} UInt64 instAddUInt64)\r\n              (@HAdd.hAdd.{0, 0, 0} UInt64 UInt64 UInt64 (@instHAdd.{0} UInt64 instAddUInt64)\r\n                (@HAdd.hAdd.{0, 0, 0} UInt64 UInt64 UInt64 (@instHAdd.{0} UInt64 instAddUInt64)\r\n                  (nz (ub f (@OfNat.ofNat.{0} UInt64 (nat_lit 0) (@UInt64.instOfNat (nat_lit 0)))))\r\n"]
[291.784755, "o", "                  (nz (ub f (@OfNat.ofNat.{0} UInt64 (nat_lit 8) (@UInt64.instOfNat (nat_lit 8))))))\r\n                (nz (ub f (@OfNat.ofNat.{0} UInt64 (nat_lit 16) (@UInt64.instOfNat (nat_lit 16))))))\r\n              (nz (ub f (@OfNat.ofNat.{0} UInt64 (nat_lit 24) (@UInt64.instOfNat (nat_lit 24))))))\r\n            (nz (ub f (@OfNat.ofNat.{0} UInt64 (nat_lit 32) (@UInt64.instOfNat (nat_lit 32))))))\r\n          (nz (ub f (@OfNat.ofNat.{0} UInt64 (nat_lit 40) (@UInt64.instOfNat (nat_lit 40))))))\r\n        (nz (ub f (@OfNat.ofNat.{0} UInt64 (nat_lit 48) (@UInt64.instOfNat (nat_lit 48))))))\r\n      (nz (ub f (@OfNat.ofNat.{0} UInt64 (nat_lit 56) (@UInt64.instOfNat (nat_lit 56)))))) :=\r\nfun (f : ⋯) =>\r\n  @id.{0}\r\n    (@Eq.{1} UInt64 (SecurityChallenge.countNzBytes f)\r\n      (@HAdd.hAdd.{0, 0, 0} UInt64 UInt64 UInt64 (@instHAdd.{0} UInt64 instAddUInt64)\r\n        (@HAdd.hAdd.{0, 0, 0} UInt64 UInt64 UInt64 (@instHAdd.{0} UInt64 instAddUInt64)\r\n          (@HAdd.hAdd.{0, 0, 0} UInt64 UInt64 UInt64 (@instHAdd.{0} UInt64 instAddUInt64)\r\n            (@HAdd.hAdd.{0, 0, 0} UInt64 UInt64 UInt64 (@instHAdd.{0} UInt64 instAddUInt64)\r\n              (@HAdd.hAdd.{0, 0, 0} UInt64 UInt64 UInt64 (@instHAdd.{0} UInt64 instAddUInt64)\r\n                (@HAdd.hAdd.{0, 0, 0} UInt64 UInt64 UInt64 (@instHAdd.{0} UInt64 instAddUInt64)\r\n                  (@HAdd.hAdd.{0, 0, 0} UInt64 UInt64 UInt64 (@instHAdd.{0} UInt64 instAddUInt64)\r\n                    (nz (ub f (@OfNat.ofNat.{0} UInt64 (nat_lit 0) (@UInt64.instOfNat (nat_lit 0)))))\r\n                    (nz (ub f (@OfNat.ofNat.{0} UInt64 (nat_lit 8) (@UInt64.instOfNat (nat_lit 8))))))\r\n                  (nz (ub f (@OfNat.ofNat.{0} UInt64 (nat_lit 16) (@UInt64.instOfNat (nat_lit 16))))))\r\n                (nz (ub f (@OfNat.ofNat.{0} UInt64 (nat_lit 24) (@UInt64.instOfNat (nat_lit 24))))))\r\n              (nz (ub f (@OfNat.ofNat.{0} UInt64 (nat_lit 32) (@UInt64.instOfNat (nat_lit 32))))))\r\n            (nz (ub f (@OfNat.ofNat.{0} UInt64 (nat_lit 40) (@UInt64.instOfNat (nat_lit 40))))))\r\n          (nz (ub f (@OfNat.ofNat.{0} UInt64 (nat_lit 48) (@UInt64.instOfNat (nat_lit 48))))))\r\n        (nz (ub f (@OfNat.ofNat.{0} UInt64 (nat_lit 56) (@UInt64.instOfNat (nat_lit 56)))))))\r\n    (@id.{0}\r\n      (@Eq.{1} UInt64\r\n        (@HShiftRight.hShiftRight.{0, 0, 0} UInt64 UInt64 UInt64\r\n          (@instHShiftRightOfShiftRight.{0} UInt64 instShiftRightUInt64)\r\n          (@HMul.hMul.{0, 0, 0} UInt64 UInt64 UInt64 (@instHMul.{0} UInt64 instMulUInt64)\r\n            (@HShiftRight.hShiftRight.{0, 0, 0} UInt64 UInt64 UInt64\r\n              (@instHShiftRightOfShiftRight.{0} UInt64 instShiftRightUInt64) (SecurityChallenge.uNz8 f)\r\n              (@OfNat.ofNat.{0} UInt64 ("]
