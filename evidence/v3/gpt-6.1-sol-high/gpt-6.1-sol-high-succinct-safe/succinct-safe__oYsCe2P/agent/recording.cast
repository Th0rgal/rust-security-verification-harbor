[37.876248, "o", " BitVec.ofNat w c) &&& a := by\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:425:      (BitVec.ofNat w1 a)\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:426:      (HAppend.hAppend (γ := BitVec (no_index _)) (BitVec.ofNat w2 b) c)\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:427:    = ((BitVec.ofNat w1 a ++ BitVec.ofNat w2 b) ++ c).cast (Nat.add_assoc ..) := by\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:434:      (HAppend.hAppend (γ := BitVec (no_index _)) a (BitVec.ofNat w2 b))\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:435:      (BitVec.ofNat w3 c)\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:436:    = (a ++ (BitVec.ofNat w2 b ++ BitVec.ofNat w3 c)).cast (Eq.symm <| Nat.add_assoc ..) := by\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:500:theorem UInt64.toBitVec_cond :\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:501:    UInt64.toBitVec (bif c then t else e) = bif c then t.toBitVec else e.toBitVec := by\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:502:  rw [Bool.apply_cond UInt64.toBitVec]\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:550:theorem UInt64.toBitVec_ite [Decidable c] :\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:551:    UInt64.toBitVec (if c then t else e) = if c then t.toBitVec else e.toBitVec := by\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:552:  rw [apply_ite UInt64.toBitVec]\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:594:theorem UInt64.beq_eq_decide_eq {a b : UInt64} : (a == b) = decide (a = b) := Bool.beq_eq_decide_eq ..\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Bitblast/BVExpr/Basic.lean:251:  hashCode : (w : Nat) → BVExpr w → UInt64\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Bitblast/BVExpr/Circuit/Lemmas/Operations/Mul.lean:92:        simp only [RefVec.denote_ite, RefVec.get_cast,