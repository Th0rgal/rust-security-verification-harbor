[37.875273, "o", "/opt/lean/src/lean/Std/Tactic/BVDecide/LRAT/Parser.lean:93:    Int.ofNat <$> parsePos\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/LRAT/Parser.lean:164:  go (uidx : UInt64) (shift : UInt64) : Parser Int := do\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/LRAT/Parser.lean:171:      let uidx := uidx ||| ((uch &&& 127).toUInt64 <<< shift)\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/LRAT/Parser.lean:175:          return (-(idx).toNat : Int)\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/LRAT/Parser.lean:177:          return (idx.toNat : Int)\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/LRAT/Parser.lean:389:    let mapped := mapped.toUInt64\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/LRAT/Parser.lean:392:  variableLengthEncode (acc : ByteArray) (lit : UInt64) : ByteArray :=\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/Canonicalize.lean:77:attribute [bv_normalize] BitVec.testBit_toNat\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/Canonicalize.lean:91:attribute [bv_normalize] BitVec.natCast_eq_ofNat\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:62:attribute [bv_normalize] BitVec.ofNat_eq_ofNat\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:65:theorem BitVec.ofNatLT_reduce (n : Nat) (h) : BitVec.ofNatLT n h = BitVec.ofNat w n := by\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:66:  simp [BitVec.ofNatLT, BitVec.ofNat, Fin.ofNat, Nat.mod_eq_of_lt h]\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:240:    BitVec.ofNat w a + (BitVec.ofNat w b + c) = (BitVec.ofNat w a + BitVec.ofNat w b) + c := by\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:245:    BitVec.ofNat w a + (b + BitVec.ofNat w c) = (BitVec.ofNat w a + BitVec.ofNat w c) + b := by\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:250:    (BitVec.ofNat w a + b) + BitVec.ofNat w c = (BitVec.ofNat w a + BitVec.ofNat w c) + b := by\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:255:    (a + BitVec.ofNat w b) + BitVec.ofNat w c = (BitVec.ofNat w b + BitVec.ofNat w c) + a := by\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:300:    simp_all only [BitVec.lt_def, BitVec.toNat_ofNat, Nat.zero_mod, ne_eq, BitVec.toNat_eq] <;>\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:360:/-- `x / (BitVec.ofNat n)` where `n = 2^k` is the same as shifting `x` right by `k`. -/\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:361:theorem BitVec.udiv_ofNat_eq_of_lt (w : Nat) (x : BitVec w) (n : Nat) (k : Nat) (hk : 2 ^ k = n) (hlt : k < w) :\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:362:    x / (BitVec.ofNat w n) = x >>> k := by\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:363:  have : BitVec.ofNat w n = BitVec.twoPow w k := by simp [bitvec_to_nat, hk]\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:382:    ((a + BitVec.ofNat w b) == BitVec.ofNat w c) = (a == BitVec.ofNat w c - BitVec.ofNat w b) := by\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:387:    ((BitVec.ofNat w b + a) == BitVec.ofNat w c) = (a == BitVec.ofNat w c - BitVec.ofNat w b) := by\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:392:    (BitVec.ofNat w c == (a + BitVec.ofNat w b)) = (a == BitVec.ofNat w c - BitVec.ofNat w b) := by\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:397:    (BitVec.ofNat w c == (BitVec.ofNat w b + a)) = (a == BitVec.ofNat w c - BitVec.ofNat w b) := by\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:403:    BitVec.ofNat w a &&& (BitVec.ofNat w b &&& c) = (BitVec.ofNat w a &&& BitVec.ofNat w b) &&& c := by\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:408:    BitVec.ofNat w a &&& (b &&& BitVec.ofNat w c) = (BitVec.ofNat w a &&& BitVec.ofNat w c) &&& b := by\r\n/opt/lean/src/lean/Std/Tactic/BVDecide/Normalize/BitVec.lean:413:    (BitVec.ofNat w a &&& b) &&& BitVec.ofNat w c = (BitVec.ofNat w a &&& Bi