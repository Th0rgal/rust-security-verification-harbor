    38	  ub f 32 + ub f 40 + ub f 48 + ub f 56 := by
    39	  unfold sumBytes m16Mask l16Mask ub
    40	  bv_decide
    41	
    42	def wc (x : UInt64) : UInt64 := (if x = 0 then 0 else 256) + x
    43	
    44	theorem debit_word (a f : UInt64) :
    45	  (a >>> 1) + (countNzBytes f <<< 8) + sumBytes f =
    46	  a / 2 + wc (ub f 0) + wc (ub f 8) + wc (ub f 16) + wc (ub f 24) +
    47	  wc (ub f 32) + wc (ub f 40) + wc (ub f 48) + wc (ub f 56) := by
    48	  rw [count_correct, sum_correct]
    49	  unfold wc nz ub
    50	  bv_decide
    51	
    52	theorem ub_as_mod (f : UInt64) :
    53	  ub f 0 = (f / 1) % 256 ∧ ub f 8 = (f / 256) % 256 ∧
    54	  ub f 16 = (f / 65536) % 256 ∧ ub f 24 = (f / 16777216) % 256 ∧
