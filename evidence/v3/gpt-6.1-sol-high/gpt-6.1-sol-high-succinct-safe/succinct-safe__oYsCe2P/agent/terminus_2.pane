    60	 theorem byte_nat (f : UInt64) :
    61	  (ub f 0).toNat = feeByte f 0 ∧ (ub f 8).toNat = feeByte f 1 ∧
    62	  (ub f 16).toNat = feeByte f 2 ∧ (ub f 24).toNat = feeByte f 3 ∧
    63	  (ub f 32).toNat = feeByte f 4 ∧ (ub f 40).toNat = feeByte f 5 ∧
    64	  (ub f 48).toNat = feeByte f 6 ∧ (ub f 56).toNat = feeByte f 7 := by
