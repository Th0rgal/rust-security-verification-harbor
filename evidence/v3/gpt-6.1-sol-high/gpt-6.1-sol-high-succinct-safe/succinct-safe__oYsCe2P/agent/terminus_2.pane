theorem count_correct : ∀ (f : UInt64),
  @Eq.{1} UInt64 (SecurityChallenge.countNzBytes f)
    (@HAdd.hAdd.{0, 0, 0} UInt64 UInt64 UInt64 (@instHAdd.{0} UInt64 instAddUInt64)
