     1	import SecurityChallenge
     2	import Std.Tactic.BVDecide
     3	open SecurityChallenge
     4	
     5	/-- An individual fee byte, interpreted as a natural number. -/
     6	def feeByte (fee : UInt64) (i : Nat) : Nat :=
     7	  (fee.toNat / 2 ^ (8 * i)) % 256
     8	
     9	def byteCharge (b : Nat) : Nat := (if b = 0 then 0 else 256) + b
    10	
    11	/-- Settlement uses exact arithmetic, including the half-principal rounded down. -/
    12	def exactDebit (amount fee : UInt64) : Nat :=
    13	  amount.toNat / 2 +
    14	  byteCharge (feeByte fee 0) + byteCharge (feeByte fee 1) +
    15	  byteCharge (feeByte fee 2) + byteCharge (feeByte fee 3) +
    16	  byteCharge (feeByte fee 4) + byteCharge (feeByte fee 5) +
    17	  byteCharge (feeByte fee 6) + byteCharge (feeByte fee 7)
    18	
    19	def candidateSpec : AuthorizationSpec where
    20	  accepts := fun balance amount fee => exactDebit amount fee ≤ balance.toNat
    21	  output := fun balance amount fee totalDebit =>
    22	    exactDebit amount fee ≤ balance.toNat ∧ totalDebit.toNat = exactDebit amount fee
    23	
    24	set_option maxRecDepth 4096
    25	set_option maxHeartbeats 0
    26	
    27	def ub (f : UInt64) (i : UInt64) : UInt64 := (f >>> i) &&& 255
    28	def nz (x : UInt64) : UInt64 := if x = 0 then 0 else 1
