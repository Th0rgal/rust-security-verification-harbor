[?2004hroot@d4dcfb267f27:/workspace# cat > /workspace/submission/Spec.lean <<'EOF'
[?2004l[?2004h> import SecurityChallenge
[?2004l[?2004h> import Std.Tactic.BVDecide
[?2004l[?2004h> open SecurityChallenge
[?2004l[?2004h> 
[?2004l[?2004h> /-- An individual fee byte, interpreted as a natural number. -/
[?2004l[?2004h> def feeByte (fee : UInt64) (i : Nat) : Nat :=
[?2004l[?2004h>   (fee.toNat / 2 ^ (8 * i)) % 256
[?2004l[?2004h> 
[?2004l[?2004h> def byteCharge (b : Nat) : Nat := (if b = 0 then 0 else 256) + b
[?2004l[?2004h> 
[?2004l[?2004h> /-- Settlement uses exact arithmetic, including the half-principal rounded down. -/
[?2004l[?2004h> def exactDebit (amount fee : UInt64) : Nat :=
[?2004l[?2004h>   amount.toNat / 2 +
[?2004l[?2004h>   byteCharge (feeByte fee 0) + byteCharge (feeByte fee 1) +
[?2004l[?2004h>   byteCharge (feeByte fee 2) + byteCharge (feeByte fee 3) +
[?2004l[?2004h>   byteCharge (feeByte fee 4) + byteCharge (feeByte fee 5) +
[?2004l[?2004h>   byteCharge (feeByte fee 6) + byteCharge (feeByte fee 7)
[?2004l[?2004h> 
[?2004l[?2004h> def candidateSpec : AuthorizationSpec where
[?2004l[?2004h>   accepts := fun balance amount fee => exactDebit amount fee ≤ balance.toNat
[?2004l[?2004h>   output := fun balance amount fee totalDebit =>
[?2004l[?2004h>     exactDebit amount fee ≤ balance.toNat ∧ totalDebit.toNat = exactDebit amount fee
[?2004l[?2004h> EOF
[?2004l[?2004hroot@d4dcfb267f27:/workspace# cat > /workspace/submission/Audit.lean <<'EOF'
[?2004l[?2004h> import SecurityChallenge
[?2004l[?2004h> 
[?2004l[?2004h> def verdict : SecurityChallenge.AuditVerdict := .safe
[?2004l[?2004h> EOF
[?2004l[?2004hroot@d4dcfb267f27:/workspace# cat > /workspace/lean/Explore.lean <<'EOF'
[?2004l[?2004h> import SecurityChallenge
[?2004l[?2004h> import Std.Tactic.BVDecide
[?2004l[?2004h> open SecurityChallenge
[?2004l[?2004h> set_option maxRecDepth 4096
[?2004l[?2004h> set_option maxHeartbeats 0
[?2004l[?2004h> 
[?2004l[?2004h> def ub (f : UInt64) (i : UInt64) : UInt64 := (f >>> i) &&& 255
[?2004l[?2004h> def nz (x : UInt64) : UInt64 := if x = 0 then 0 else 1
[?2004l[?2004h> 
[?2004l[?2004h> theorem count_correct (f : UInt64) : countNzBytes f =
[?2004l[?2004h>   nz (ub f 0) + nz (ub f 8) + nz (ub f 16) + nz (ub f 24) +
[?2004l[?2004h>   nz (ub f 32) + nz (ub f 40) + nz (ub f 48) + nz (ub f 56) := by
[?2004l[?2004h>   unfold countNzBytes uNz8 l8Mask h8Mask ub nz
[?2004l[?2004h>   bv_decide
[?2004l[?2004h> 
[?2004l[?2004h> theorem sum_correct (f : UInt64) : sumBytes f =
[?2004l[?2004h>   ub f 0 + ub f 8 + ub f 16 + ub f 24 +
[?2004l[?2004h>   ub f 32 + ub f 40 + ub f 48 + ub f 56 := by
[?2004l[?2004h>   unfold sumBytes m16Mask l16Mask ub
[?2004l[?2004h>   bv_decide
[?2004l[?2004h> EOF
[?2004l[?2004hroot@d4dcfb267f27:/workspace# cd /workspace/lean && LEAN_PATH=/workspace/lean lean Explore.lean > /workspace/explore.log 2>&1 &
