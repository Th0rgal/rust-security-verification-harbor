[37.648048, "i", "python3 - <<'PY'\nD=32771\nfor u1 in range(D):\n    for u0 in (0, 1, 32770, 32771, 65534, 65535):\n        qfull=u1*65524+u1*65536+u0+65536\n        q1=qfull>>16\n        q0=qfull&65535\n        r=(0xC0000000+u0-q1*D)&65535\n        actual=q1-1 if q0<r else q1\n        expected=(u1*65536+u0)//D\n        if actual!=expected:\n            print(dict(u1=u1,u0=u0,actual=actual,expected=expected,q1=q1,q0=q0,r=r))\n            raise SystemExit\nprint('No discrepancy in this sample')\nPY\n"]
