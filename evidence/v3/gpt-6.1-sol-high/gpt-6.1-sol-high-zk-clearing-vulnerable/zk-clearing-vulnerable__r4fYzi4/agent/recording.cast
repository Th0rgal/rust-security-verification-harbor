[308.998769, "o", "def calldataNat (f : Nat) : Nat :="]
[308.999498, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.999554, "o", ">   laneNat f + laneNat (f / 256) + laneNat (f / 65536)"]
[308.999661, "o", "\r\n"]
[308.999795, "o", "\u001b[?2004l\r"]
[309.000132, "o", "\u001b[?2004h> "]
[309.000182, "o", "  + laneNat (f / 16777216) + laneNat (f / 4294967296)"]
[309.000282, "o", "\r\n"]
[309.000401, "o", "\u001b[?2004l\r"]
[309.00076, "o", "\u001b[?2004h"]
[309.000817, "o", ">   + laneNat (f / 1099511627776) + laneNat (f / 281474976710656)"]
[309.000919, "o", "\r\n"]
[309.001005, "o", "\u001b[?2004l\r"]
[309.001294, "o", "\u001b[?2004h"]
[309.001344, "o", ">   + laneNat (f / 72057594037927936)"]
[309.001483, "o", "\r\n"]
[309.00164, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[309.001843, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[309.001886, "o", "> def blobNat (a f : Nat) : Nat :="]
[309.002235, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[309.002283, "o", ">   ((f % 32771) * 65536 + a % 65536) / 32771"]
[309.002387, "o", "\r\n"]
[309.002533, "o", "\u001b[?2004l\r"]
[309.002691, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[309.003046, "o", "\u001b[?2004h> -- Canonical Montgomery reduction: inverse of 2^32 modulo p is 943718400."]
[309.003149, "o", "\r\n"]
[309.003236, "o", "\u001b[?2004l\r"]
[309.003365, "o", "\u001b[?2004h"]
[309.003761, "o", "> "]
[309.003812, "o", "-- Reducing before multiplying is mathematically equivalent to reducing"]
[309.003917, "o", "\r\n"]
[309.004004, "o", "\u001b[?2004l\r"]
[309.004368, "o", "\u001b[?2004h"]
[309.004415, "o", "> -- the packed transcript multiplied by this inverse."]
[309.00451, "o", "\r\n"]
[309.004618, "o", "\u001b[?2004l\r"]
[309.004906, "o", "\u001b[?2004h"]
[309.004953, "o", "> def levyNat (a f : Nat) : Nat :="]
[309.005052, "o", "\r\n"]
[309.00551, "o", "\u001b[?2004l\r\u001b[?2004h"]
[309.005559, "o", ">   (((a % 4294967296) % 2013265921) * 943718400 + f % 2013265921) % 2013265921"]
[309.005662, "o", "\r\n"]
[309.005746, "o", "\u001b[?2004l\r"]
[309.005926, "o", "\u001b[?2004h> "]
[309.006167, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> def surchargeNat (a f : Nat) : Nat :="]
[309.006309, "o", "\r\n"]
[309.00652, "o", "\u001b[?2004l\r\u001b[?2004h"]
[309.006596, "o", ">   let g := grossNat a f"]
[309.00673, "o", "\r\n"]
[309.006904, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[309.007223, "o", "  (g - g / 10) + blobNat a f + calldataNat f + levyNat a f"]
[309.007325, "o", "\r\n"]
[309.007471, "o", "\u001b[?2004l\r"]
[309.007857, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[309.007906, "o", "> def debitNat (a f : Nat) : Nat := a + surchargeNat a f"]
[309.008008, "o", "\r\n"]
[309.008126, "o", "\u001b[?2004l\r"]
[309.00828, "o", "\u001b[?2004h"]
[309.008571, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[309.00862, "o", "def candidateSpec : AuthorizationSpec where"]
[309.00872, "o", "\r\n"]
[309.008841, "o", "\u001b[?2004l\r"]
[309.009177, "o", "\u001b[?2004h> "]
[309.009226, "o", "  accepts b a f := debitNat a.toNat f.toNat ≤ b.toNat"]
[309.009324, "o", "\r\n"]
[309.009409, "o", "\u001b[?2004l\r"]
[309.009829, "o", "\u001b[?2004h"]
[309.009877, "o", ">   output b a f total := debitNat a.toNat f.toNat ≤ b.toNat ∧"]
[309.009972, "o", "\r\n"]
[309.01006, "o", "\u001b[?2004l\r"]
[309.010198, "o", "\u001b[?2004h"]
[309.010432, "o", ">     total.toNat = debitNat a.toNat f.toNat"]
[309.010531, "o", "\r\n"]
[309.010662, "o", "\u001b[?2004l\r"]
[309.010818, "o", "\u001b[?2004h> "]
[309.011173, "o", "EOF\r\n\u001b[?2004l\r"]
