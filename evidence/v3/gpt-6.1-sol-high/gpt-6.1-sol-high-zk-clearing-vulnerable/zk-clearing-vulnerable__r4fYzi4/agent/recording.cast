[274.931253, "i", "cat > /tmp/prepare.py <<'PY'\nfrom pathlib import Path\ns=Path('/workspace/submission'); (s/'src').mkdir(exist_ok=True); (s/'LeanModel').mkdir(exist_ok=True)\nr=Path('/workspace/challenge/src/clearing_pipeline.rs').read_text()\nstart=r.index('    let notional_sum:', r.index('pub fn compute_clearing_breakdown'))\nend=r.index('    let total_surcharge:',start)\nr=r[:start]+'''    // Quotient/remainder decomposition avoids overflowing amount + fee or its bias.\n    let gross = amount / 10000 + fee / 10000\n        + (amount % 10000 + fee % 10000 + 9999) / 10000;\n    let net_bps_fee = gross - gross / 10;\n    let blob_slot_quotient = ((fee % 32771) * 65536 + amount % 65536) / 32771;\n    let calldata_surcharge = lane_charge(fee) + lane_charge(fee / 256)\n        + lane_charge(fee / 65536) + lane_charge(fee / 16777216)\n        + lane_charge(fee / 4294967296) + lane_charge(fee / 1099511627776)\n        + lane_charge(fee / 281474976710656) + lane_charge(fee / 72057594037927936);\n    // 943718400 is the inverse of 2^32 modulo BabyBear's prime.\n    let prover_levy = (((amount % 4294967296) % 2013265921) * 943718400\n        + fee % 2013265921) % 2013265921;\n\n'''+r[end:]\npos=r.index('/// Evaluates all four')\nr=r[:pos]+'''// One byte costs its value plus a 256-unit activation charge, unless zero.\nfn lane_charge(x: u64) -> u64 {\n    let byte = x % 256;\n    if byte == 0 { 0 } else { 256 + byte }\n}\n\n'''+r[pos:]\n(s/'src/clearing_pipeline.rs').write_text(r)\nl=Path('/workspace/lean/LeanModel/ClearingPipeline.lean').read_text()\nstart=l.index('def computeClearingBreakdown')\nend=l.index('def assembleClearingTicket',start)\nl=l[:start]+'''def laneCharge (x : UInt64) : UInt64 :=\n  let byte := x % 256\n  if byte = 0 then 0 else 256 + byte\n\ndef protocolGross (amount fee : UInt64) : UInt64 :=\n  amount / 10000 + fee / 10000 + (amount % 10000 + fee % 10000 + 9999) / 10000\n\ndef blobCharge (amount fee : UInt64) : UInt64 :=\n  ((fee % 32771) * 65536 + amount % 65536) / 32771\n\ndef calldataCharge (fee : UInt64) : UInt64 :=\n  laneCharge fee + laneCharge (fee / 256) + laneCharge (fee / 65536)\n  + laneCharge (fee / 16777216) + laneCharge (fee / 4294967296)\n  + laneCharge (fee / 1099511627776) + laneCharge (fee / 281474976710656)\n  + laneCharge (fee / 72057594037927936)\n\ndef levyCharge (amount fee : UInt64) : UInt64 :=\n  (((amount % 4294967296) % 2013265921) * 943718400\n    + fee % 2013265921) % 2013265921\n\ndef computeClearingBreakdown (amount fee : UInt64) : ClearingBreakdown :=\n  let gross := protocolGross amount fee\n  let net := gross - gross / 10\n  let blob := blobCharge amount fee\n  let calldata := calldataCharge fee\n  let levy := levyCharge amount fee\n  { netBpsFee := net\n    blobSlotQuotient := blob\n    calldataSurcharge := calldata\n    proverLevy := levy\n    totalSurcharge := net + blob + calldata + levy }\n\n'''+l[end:]\n(s/'LeanModel/ClearingPipeline.lean').write_text(l)\n(s/'Audit.lean').write_text('import SecurityChallenge\\nopen SecurityChallenge\\ndef verdict : AuditVerdict := .vulnerable\\n')\nPY\npython3 /tmp/prepare.py\ncat > /tmp/witness.rs <<'RS'\nextern crate settlement_gate;\nfn main() {\n    for delta in 0..10000u64 {\n        let fee=u64::MAX-delta;\n        let q=(fee/10000)+(fee%10000+9999)/10000;\n        let net=q-q/10;\n        let old=settlement_gate::clearing_pipeline::compute_clearing_breakdown(0,fee);\n        if old.net_bps_fee < net {\n            println!(\"fee={} old={:?} expectedNet={} authorization={:?}\",fee,old,net,settlement_gate::authorize(old.total_surcharge,0,fee)); break;\n        }\n    }\n}\nRS\nrustc /tmp/witness.rs --extern settlement_gate=$(ls /workspace/challenge/target/release/deps/libsettlement_gate-*.rlib | head -1) -o /tmp/witness; /tmp/witness\n"]
