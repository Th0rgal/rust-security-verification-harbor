[342.348018, "o", "69:  theorem le_iff_toNat_le {a b : $typeName} : a ≤ b ↔ a.toNat ≤ b.toNat := .rfl\r\n71:  theorem lt_iff_toNat_lt {a b : $typeName} : a < b ↔ a.toNat < b.toNat := .rfl\r\n138:  @[simp] protected theorem toNat_add (a b : $typeName) : (a + b).toNat = (a.toNat + b.toNat) % 2 ^ $bits := BitVec.toNat_add ..\r\n140:  protected theorem toNat_sub (a b : $typeName) : (a - b).toNat = (2 ^ $bits - b.toNat + a.toNat) % 2 ^ $bits := BitVec.toNat_sub  ..\r\n142:  @[simp] protected theorem toNat_mul (a b : $typeName) : (a * b).toNat = a.toNat * b.toNat % 2 ^ $bits := BitVec.toNat_mul  ..\r\n144:  @[simp] protected theorem toNat_mod (a b : $typeName) : (a % b).toNat = a.toNat % b.toNat := BitVec.toNat_umod ..\r\n146:  @[simp] protected theorem toNat_div (a b : $typeName) : (a / b).toNat = a.toNat / b.toNat := BitVec.toNat_udiv  ..\r\n148:  @[simp] protected theorem toNat_sub_of_le (a b : $typeName) : b ≤ a → (a - b).toNat = a.toNat - b.toNat := BitVec.toNat_sub_of_le\r\n"]
[342.348803, "o", "152:  open $typeName (toNat_mod toNat_lt_size) in\r\n153:  protected theorem toNat_mod_lt {m : Nat} : ∀ (u : $typeName), 0 < m → toNat (u % ofNat m) < m := by\r\n156:    · rw [toNat_mod, toNat_ofNat_of_lt' h2]\r\n279:  rw [lt_iff_toNat_lt, toNat_ofNat_of_lt' h]\r\n281:  rw [lt_iff_toNat_lt, toNat_ofNat_of_lt' h]\r\n283:  rw [le_iff_toNat_le, toNat_ofNat_of_lt' h]\r\n285:  rw [le_iff_toNat_le, toNat_ofNat_of_lt' h]\r\n288:  rw [lt_iff_toNat_lt, toNat_ofNat_of_lt' h]\r\n290:  rw [lt_iff_toNat_lt, toNat_ofNat_of_lt' h]\r\n292:  rw [le_iff_toNat_le, toNat_ofNat_of_lt' h]\r\n294:  rw [le_iff_toNat_le, toNat_ofNat_of_lt' h]\r\n297:  rw [lt_iff_toNat_lt, toNat_ofNat_of_lt' h]\r\n299:  rw [lt_iff_toNat_lt, toNat_ofNat_of_lt' h]\r\n301:  rw [le_iff_toNat_le, toNat_ofNat_of_lt' h]\r\n303:  rw [le_iff_toNat_le, toNat_ofNat_of_lt' h]\r\n306:  rw [lt_iff_toNat_lt, toNat_ofNat_of_lt' h]\r\n308:  rw [lt_iff_toNat_lt, toNat_ofNat_of_lt' h]\r\n310:  rw [le_iff_toNat_le, toNat_ofNat_of_lt' h]\r\n312:  rw [le_iff_toNat_le, toNat_ofNat_of_lt' h]\r\n315:  rw [lt_iff_toNat_lt, toNat_ofNat_of_lt' h]\r\n317:  rw [lt_iff_toNat_lt, toNat_ofNat_of_lt' h]\r\n319:  rw [le_iff_toNat_le, toNat_ofNat_of_lt' h]\r\n321:  rw [le_iff_toNat_le, toNat_ofNat_of_lt' h]\r\n380:@[simp] theorem UInt8.toNat_mod_size (n : UInt8) : n.toNat % UInt8.size = n.toNat := Nat.mod_eq_of_lt n.toNat_lt\r\n381:@[simp] theorem UInt8.toNat_mod_uInt16Size (n : UInt8) : n.toNat % UInt16.size = n.toNat := Nat.mod_eq_of_lt (Nat.lt_trans n.toNat_lt (by decide))\r\n382:@[simp] theorem UInt8.toNat_mod_uInt32Size (n : UInt8) : n.toNat % UInt32.size = n.toNat := Nat.mod_eq_of_lt (Nat.lt_trans n.toNat_lt (by decide))\r\n383:@[simp] theorem UInt8.toNat_mod_uInt64Size (n : UInt8) : n.toNat % UInt64.size = n.toNat := Nat.mod_eq_of_lt (Nat.lt_trans n.toNat_lt (by decide))\r\n"]
