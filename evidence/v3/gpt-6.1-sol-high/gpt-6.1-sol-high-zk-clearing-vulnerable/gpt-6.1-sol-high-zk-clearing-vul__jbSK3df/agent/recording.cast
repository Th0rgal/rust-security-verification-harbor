[365.844477, "o", "\r\n  protected theorem toBitVec_ne_of_ne {a b : $typeName} (h : a ≠ b) : a.toBitVec ≠ b.toBitVec :=\r\n    fun h' => h (eq_of_toBitVec_eq h')\r\n\r\n  open $typeName (toBitVec_eq_of_eq) in\r\n  protected theorem ne_of_toBitVec_ne {a b : $typeName} (h : a.toBitVec ≠ b.toBitVec) : a ≠ b :=\r\n    fun h' => absurd (toBitVec_eq_of_eq h') h\r\n\r\n  open $typeName (ne_of_toBitVec_ne toBitVec_ne_of_ne) in\r\n  @[int_toBitVec]\r\n  protected theorem ne_iff_toBitVec_ne {a b : $typeName} : a ≠ b ↔ a.toBitVec ≠ b.toBitVec :=\r\n    Iff.intro toBitVec_ne_of_ne ne_of_toBitVec_ne\r\n\r\n  open $typeName (ne_of_toBitVec_ne) in\r\n  protected theorem ne_of_lt {a b : $typeName} (h : a < b) : a ≠ b := by\r\n    apply ne_of_toBitVec_ne\r\n    apply BitVec.ne_of_lt\r\n    simpa [lt_iff_toBitVec_lt] using h\r\n\r\n  @[simp] protected theorem toNat_zero : (0 : $typeName).toNat = 0 := Nat.zero_mod _\r\n\r\n  @[simp] protected theorem toNat_add (a b : $typeName) : (a + b).toNat = (a.toNat + b.toNat) % 2 ^ $bits := BitVec.toNat_add ..\r\n\r\n  protected theorem toNat_sub (a b : $typeName) : (a - b).toNat = (2 ^ $bits - b.toNat + a.toNat) % 2 ^ $bits := BitVec.toNat_sub  ..\r\n\r\n  @[simp] protected theorem toNat_mul (a b : $typeName) : (a * b).toNat = a.toNat * b.toNat % 2 ^ $bits := BitVec.toNat_mul  ..\r\n\r\n  @[simp] protected theorem toNat_mod (a b : $typeName) : (a % b).toNat = a.toNat % b.toNat := BitVec.toNat_umod ..\r\n\r\n  @[simp] protected theorem toNat_div (a b : $typeName) : (a / b).toNat = a.toNat / b.toNat := BitVec.toNat_udiv  ..\r\n\r\n  @[simp] protected theorem toNat_sub_of_le (a b : $typeName) : b ≤ a → (a - b).toNat = a.toNat - b.toNat := BitVec.toNat_sub_of_le\r\n\r\n  protected theorem toNat_lt_size (a : $typeName) : a.toNat < size := a.toBitVec.isLt\r\n\r\n"]
[365.854296, "o", "/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:35:@[simp] protected theorem toNat_and (a b : $typeName) : (a &&& b).toNat = a.toNat &&& b.toNat := by simp [toNat, -toNat_toBitVec]\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:36:@[simp] protected theorem toNat_or (a b : $typeName) : (a ||| b).toNat = a.toNat ||| b.toNat := by simp [toNat, -toNat_toBitVec]\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:37:@[simp] protected theorem toNat_xor (a b : $typeName) : (a ^^^ b).toNat = a.toNat ^^^ b.toNat := by simp [toNat, -toNat_toBitVec]\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:38:@[simp] protected theorem toNat_shiftLeft (a b : $typeName) : (a <<< b).toNat = a.toNat <<< (b.toNat % $bits) % 2 ^ $bits := by simp [toNat, -toNat_toBitVec]\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:39:@[simp] protected theorem toNat_shiftRight (a b : $typeName) : (a >>> b).toNat = a.toNat >>> (b.toNat % $bits) := by simp [toNat, -toNat_toBitVec]\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:238:@[simp] theorem USize.toFin_shiftLeft (a b : USize) (hb : b.toNat < System.Platform.numBits) : (a <<< b).toFin = a.toFin <<< b.toFin :=\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:239:  Fin.val_inj.1 (by simp [Nat.mod_eq_of_lt (a := b.toNat) (b := System.Platform.numBits) hb])\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:294:@[simp] theorem UInt64.toUSize_shiftLeft (a b : UInt64) (hb : b.toNat < System.Platform.numBits) :\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:297:  have h₁ : b.toNat % 64 = b.toNat := Nat.mod_eq_of_lt (Nat.lt_of_lt_of_le hb System.Platform.numBits_le)\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:298:  have h₂ : b.toNat % (2 ^ System.Platform.numBits) % System.Platform.numBits = b.toNat := by\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:363:theorem USize.toUInt64_shiftLeft_of_lt (a b : USize) (hb : b.toNat < System.Platform.numBits) : (a <<< b).toUInt64 = (a.toUInt64 <<< b.toUInt64) % UInt64.ofNat USize.size := by\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:400:@[simp] theorem USize.toFin_shiftRight (a b : USize) (hb : b.toNat < System.Platform.numBits) : (a >>> b).toFin = a.toFin >>> b.toFin :=\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:401:  Fin.val_inj.1 (by simp [Nat.mod_eq_of_lt (a := b.toNat) (b := System.Platform.numBits) hb])\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:614:  rw [UInt8.ofNat_eq_iff_mod_eq_toNat, UInt8.toNat_shiftLeft, toNat_ofNat', toNat_ofNat',\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:618:  rw [UInt16.ofNat_eq_iff_mod_eq_toNat, UInt16.toNat_shiftLeft, toNat_ofNat', toNat_ofNat',\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:622:  rw [UInt32.ofNat_eq_iff_mod_eq_toNat, UInt32.toNat_shiftLeft, toNat_ofNat', toNat_ofNat',\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:626:  rw [UInt64.ofNat_eq_iff_mod_eq_toNat, UInt64.toNat_shiftLeft, toNat_ofNat', toNat_ofNat',\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:630:  rw [USize.ofNat_eq_iff_mod_eq_toNat, USize.toNat_shiftLeft, toNat_ofNat', toNat_ofNat',\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:1162:    Nat.mod_eq_of_lt (show c.toNat < 8 by omega), BitVec.shiftLeft_add]\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:1166:    Nat.mod_eq_of_lt (show c.toNat < 16 by omega), BitVec.shiftLeft_add]\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:1170:    Nat.mod_eq_of_lt (show c.toNat < 32 by omega), BitVec.shiftLeft_add]\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:1174:    Nat.mod_eq_of_lt (show c.toNat < 64 by omega), BitVec.shiftLeft_add]\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:1176:    (h : b.toNat + c.toNat < System.Platform.numBits) :\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:1219:  have hb : b.toNat < System.Platform.numBits := by simpa [lt_iff_toNat_lt] using hb\r\n/opt/lean/src/lean/Init/Data/UInt/Bitwise.lean:1220:  have hc : c.toNat < System.Platform.numBits := by simpa [lt_iff_toNat_lt] using hc\r\n"]
