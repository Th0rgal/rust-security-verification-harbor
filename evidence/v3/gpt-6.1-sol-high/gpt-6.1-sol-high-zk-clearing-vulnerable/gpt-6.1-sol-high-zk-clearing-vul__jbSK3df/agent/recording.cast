[405.645317, "o", "UInt64.toNat_ofNat' {n : Nat} : (UInt64.ofNat n).toNat = n % 2 ^ 64\r\nUInt64.toNat_sub (a b : UInt64) : (a - b).toNat = (2 ^ 64 - b.toNat + a.toNat) % 2 ^ 64\r\nNat.and_le_left {n m : Nat} : n &&& m ≤ n\r\nNat.and_le_right {n m : Nat} : n &&& m ≤ m\r\nNat.shiftRight_eq_div_pow (m n : Nat) : m >>> n = m / 2 ^ n\r\n"]
