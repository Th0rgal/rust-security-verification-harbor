[395.382567, "i", "cat > /workspace/rustdev/main.rs <<'RS'\nextern crate original;\nextern crate repaired;\nfn main() {\n for a in 0..100000u64 {\n  for delta in [4999u64,4998,4000,3000,2000,1617] {\n   let f=u64::MAX-(delta-1)-a;\n   if let Some(x)=original::authorize(u64::MAX,a,f) {\n    if repaired::authorize(x.total_debit,a,f).is_none() {\n     println!(\"{{\\\"balance\\\":{},\\\"amount\\\":{},\\\"fee\\\":{}}}\",x.total_debit,a,f);\n     println!(\"repaired {:?}\",repaired::authorize(u64::MAX,a,f)); return;\n    }\n   }\n  }\n }\n}\nRS\nrustc /workspace/rustdev/main.rs --extern original=/workspace/rustdev/liboriginal.rlib --extern repaired=/workspace/rustdev/librepaired.rlib -o /workspace/rustdev/main; /workspace/rustdev/main\n"]
[395.386522, "o", "cat > /workspace/rustdev/main.rs <<'RS'\r\n"]
[395.399407, "o", "\u001b[?2004l\r\u001b[?2004h> extern crate original;\r\n\u001b[?2004l\r\u001b[?2004h> extern crate repaired;\r\n\u001b[?2004l\r\u001b[?2004h> fn main() {\r\n\u001b[?2004l\r\u001b[?2004h>  for a in 0..100000u64 {\r\n\u001b[?2004l\r\u001b[?2004h>   for delta in [4999u64,4998,4000,3000,2000,1617] {\r\n\u001b[?2004l\r\u001b[?2004h>    let f=u64::MAX-(delta-1)-a;\r\n\u001b[?2004l\r\u001b[?2004h>    if let Some(x)=original::authorize(u64::MAX,a,f) {\r\n\u001b[?2004l\r\u001b[?2004h>     if repaired::authorize(x.total_debit,a,f).is_none() {\r\n\u001b[?2004l\r\u001b[?2004h>      println!(\"{{\\\"balance\\\":{},\\\"amount\\\":{},\\\"fee\\\":{}}}\",x.total_debit,a,f);\r\n\u001b[?2004l\r\u001b[?2004h>      println!(\"repaired {:?}\",repaired::authorize(u64::MAX,a,f)); return;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>    }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>  }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
