[283.510037, "o", "69:  theorem le_iff_toNat_le {a b : $typeName} : a ≤ b ↔ a.toNat ≤ b.toNat := .rfl\r\n71:  theorem lt_iff_toNat_lt {a b : $typeName} : a < b ↔ a.toNat < b.toNat := .rfl\r\n136:  @[simp] protected theorem toNat_zero : (0 : $typeName).toNat = 0 := Nat.zero_mod _\r\n138:  @[simp] protected theorem toNat_add (a b : $typeName) : (a + b).toNat = (a.toNat + b.toNat) % 2 ^ $bits := BitVec.toNat_add ..\r\n140:  protected theorem toNat_sub (a b : $typeName) : (a - b).toNat = (2 ^ $bits - b.toNat + a.toNat) % 2 ^ $bits := BitVec.toNat_sub  ..\r\n142:  @[simp] protected theorem toNat_mul (a b : $typeName) : (a * b).toNat = a.toNat * b.toNat % 2 ^ $bits := BitVec.toNat_mul  ..\r\n144:  @[simp] protected theorem toNat_mod (a b : $typeName) : (a % b).toNat = a.toNat % b.toNat := BitVec.toNat_umod ..\r\n146:  @[simp] protected theorem toNat_div (a b : $typeName) : (a / b).toNat = a.toNat / b.toNat := BitVec.toNat_udiv  ..\r\n148:  @[simp] protected theorem toNat_sub_of_le (a b : $typeName) : b ≤ a → (a - b).toNat = a.toNat - b.toNat := BitVec.toNat_sub_of_le\r\n152:  open $typeName (toNat_mod toNat_lt_size) in\r\n153:  protected theorem toNat_mod_lt {m : Nat} : ∀ (u : $typeName), 0 < m → toNat (u % ofNat m) < m := by\r\n156:    · rw [toNat_mod, toNat_ofNat_of_lt' h2]\r\n237:        `(@[simp] theorem toNat_toUSize (x : $typeName) : x.toUSize.toNat = x.toNat % 2 ^ System.Platform.numBits := (rfl))\r\n279:  rw [lt_iff_toNat_lt, toNat_ofNat_of_lt' h]\r\n281:  rw [lt_iff_toNat_lt, toNat_ofNat_of_lt' h]\r\n283:  rw [le_iff_toNat_le, toNat_ofNat_of_lt' h]\r\n285:  rw [le_iff_toNat_le, toNat_ofNat_of_lt' h]\r\n288:  rw [lt_iff_toNat_lt, toNat_ofNat_of_lt' h]\r\n290:  rw [lt_iff_toNat_lt, toNat_ofNat_of_lt' h]\r\n292:  rw [le_iff_toNat_le, toNat_ofNat_of_lt' h]\r\n294:  rw [le_iff_toNat_le, toNat_ofNat_of_lt' h]\r\n"]
[283.511066, "o", "297:  rw [lt_iff_toNat_lt, toNat_ofNat_of_lt' h]\r\n299:  rw [lt_iff_toNat_lt, toNat_ofNat_of_lt' h]\r\n301:  rw [le_iff_toNat_le, toNat_ofNat_of_lt' h]\r\n303:  rw [le_iff_toNat_le, toNat_ofNat_of_lt' h]\r\n306:  rw [lt_iff_toNat_lt, toNat_ofNat_of_lt' h]\r\n308:  rw [lt_iff_toNat_lt, toNat_ofNat_of_lt' h]\r\n310:  rw [le_iff_toNat_le, toNat_ofNat_of_lt' h]\r\n312:  rw [le_iff_toNat_le, toNat_ofNat_of_lt' h]\r\n315:  rw [lt_iff_toNat_lt, toNat_ofNat_of_lt' h]\r\n317:  rw [lt_iff_toNat_lt, toNat_ofNat_of_lt' h]\r\n319:  rw [le_iff_toNat_le, toNat_ofNat_of_lt' h]\r\n321:  rw [le_iff_toNat_le, toNat_ofNat_of_lt' h]\r\n323:protected theorem UInt8.mod_eq_of_lt {a b : UInt8} (h : a < b) : a % b = a := UInt8.toNat_inj.1 (Nat.mod_eq_of_lt h)\r\n324:protected theorem UInt16.mod_eq_of_lt {a b : UInt16} (h : a < b) : a % b = a := UInt16.toNat_inj.1 (Nat.mod_eq_of_lt h)\r\n325:protected theorem UInt32.mod_eq_of_lt {a b : UInt32} (h : a < b) : a % b = a := UInt32.toNat_inj.1 (Nat.mod_eq_of_lt h)\r\n326:protected theorem UInt64.mod_eq_of_lt {a b : UInt64} (h : a < b) : a % b = a := UInt64.toNat_inj.1 (Nat.mod_eq_of_lt h)\r\n327:protected theorem USize.mod_eq_of_lt {a b : USize} (h : a < b) : a % b = a := USize.toNat_inj.1 (Nat.mod_eq_of_lt h)\r\n345:theorem USize.toNat_lt_two_pow_numBits (n : USize) : n.toNat < 2 ^ System.Platform.numBits := n.toFin.isLt\r\n380:@[simp] theorem UInt8.toNat_mod_size (n : UInt8) : n.toNat % UInt8.size = n.toNat := Nat.mod_eq_of_lt n.toNat_lt\r\n381:@[simp] theorem UInt8.toNat_mod_uInt16Size (n : UInt8) : n.toNat % UInt16.size = n.toNat := Nat.mod_eq_of_lt (Nat.lt_trans n.toNat_lt (by decide))"]
[283.511664, "o", "\r\n382:@[simp] theorem UInt8.toNat_mod_uInt32Size (n : UInt8) : n.toNat % UInt32.size = n.toNat := Nat.mod_eq_of_lt (Nat.lt_trans n.toNat_lt (by decide))\r\n383:@[simp] theorem UInt8.toNat_mod_uInt64Size (n : UInt8) : n.toNat % UInt64.size = n.toNat := Nat.mod_eq_of_lt (Nat.lt_trans n.toNat_lt (by decide))\r\n384:@[simp] theorem UInt8.toNat_mod_uSizeSize (n : UInt8) : n.toNat % USize.size = n.toNat := Nat.mod_eq_of_lt n.toNat_lt_usizeSize\r\n386:@[simp] theorem UInt16.toNat_mod_size (n : UInt16) : n.toNat % UInt16.size = n.toNat := Nat.mod_eq_of_lt n.toNat_lt\r\n387:@[simp] theorem UInt16.toNat_mod_uInt32Size (n : UInt16) : n.toNat % UInt32.size = n.toNat := Nat.mod_eq_of_lt (Nat.lt_trans n.toNat_lt (by decide))\r\n388:@[simp] theorem UInt16.toNat_mod_uInt64Size (n : UInt16) : n.toNat % UInt64.size = n.toNat := Nat.mod_eq_of_lt (Nat.lt_trans n.toNat_lt (by decide))\r\n389:@[simp] theorem UInt16.toNat_mod_uSizeSize (n : UInt16) : n.toNat % USize.size = n.toNat := Nat.mod_eq_of_lt n.toNat_lt_usizeSize\r\n391:@[simp] theorem UInt32.toNat_mod_size (n : UInt32) : n.toNat % UInt32.size = n.toNat := Nat.mod_eq_of_lt n.toNat_lt\r\n392:@[simp] theorem UInt32.toNat_mod_uInt64Size (n : UInt32) : n.toNat % UInt64.size = n.toNat := Nat.mod_eq_of_lt (Nat.lt_trans n.toNat_lt (by decide))\r\n393:@[simp] theorem UInt32.toNat_mod_uSizeSize (n : UInt32) : n.toNat % USize.size = n.toNat := Nat.mod_eq_of_lt n.toNat_lt_usizeSize\r\n395:@[simp] theorem UInt64.toNat_mod_size (n : UInt64) : n.toNat % UInt64.size = n.toNat := Nat.mod_eq_of_lt n.toNat_lt\r\n397:@[simp] theorem USize.toNat_mod_size (n : USize) : n.toNat % USize.size = n.toNat := Nat.mod_eq_of_lt n.toNat_lt_size\r\n398:@[simp] theorem USize.toNat_mod_uInt64Size (n : USize) : n.toNat % UInt64.size = n.toNat := Nat.mod_eq_of_lt n.toNat_lt\r\n498:  UInt8.toNat.inj (by simp [Nat.mod_eq_of_lt h])\r\n500:  UInt8.toNat.inj (by simp [Nat.mod_eq_of_lt h])\r\n502:  UInt8.toNat.inj (by simp [Nat.mod_eq_of_lt h])\r\n504:  UInt8.toNat.inj (by simp [Nat.mod_eq_of_lt h])\r\n506:  UInt16.toNat.inj (by simp [Nat.mod_eq_of_lt h])\r\n508:  UInt16.toNat.inj (by simp [Nat.mod_eq_of_lt h])\r\n"]
