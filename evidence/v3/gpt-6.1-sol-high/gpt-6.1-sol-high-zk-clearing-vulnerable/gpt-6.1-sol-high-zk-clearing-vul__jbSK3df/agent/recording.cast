[191.533445, "o", "2826:theorem UInt32.ofNatLT_le_iff_le {a b : Nat} (ha : a < UInt32.size) (hb : b < UInt32.size) :\r\n2828:theorem UInt64.ofNatLT_le_iff_le {a b : Nat} (ha : a < UInt64.size) (hb : b < UInt64.size) :\r\n2830:theorem USize.ofNatLT_le_iff_le {a b : Nat} (ha : a < USize.size) (hb : b < USize.size) :\r\n2833:theorem UInt8.ofNat_lt_iff_lt {a b : Nat} (ha : a < UInt8.size) (hb : b < UInt8.size) :\r\n2836:theorem UInt16.ofNat_lt_iff_lt {a b : Nat} (ha : a < UInt16.size) (hb : b < UInt16.size) :\r\n2839:theorem UInt32.ofNat_lt_iff_lt {a b : Nat} (ha : a < UInt32.size) (hb : b < UInt32.size) :\r\n2842:theorem UInt64.ofNat_lt_iff_lt {a b : Nat} (ha : a < UInt64.size) (hb : b < UInt64.size) :\r\n2845:theorem USize.ofNat_lt_iff_lt {a b : Nat} (ha : a < USize.size) (hb : b < USize.size) :\r\n2849:theorem UInt8.ofNat_le_iff_le {a b : Nat} (ha : a < UInt8.size) (hb : b < UInt8.size) :\r\n2852:theorem UInt16.ofNat_le_iff_le {a b : Nat} (ha : a < UInt16.size) (hb : b < UInt16.size) :\r\n2855:theorem UInt32.ofNat_le_iff_le {a b : Nat} (ha : a < UInt32.size) (hb : b < UInt32.size) :"]
[191.536336, "o", "\r\n2858:theorem UInt64.ofNat_le_iff_le {a b : Nat} (ha : a < UInt64.size) (hb : b < UInt64.size) :\r\n2861:theorem USize.ofNat_le_iff_le {a b : Nat} (ha : a < USize.size) (hb : b < USize.size) :\r\n2865:theorem UInt8.toNat_one : (1 : UInt8).toNat = 1 := (rfl)\r\n2866:theorem UInt16.toNat_one : (1 : UInt16).toNat = 1 := (rfl)\r\n2867:theorem UInt32.toNat_one : (1 : UInt32).toNat = 1 := (rfl)\r\n2868:theorem UInt64.toNat_one : (1 : UInt64).toNat = 1 := (rfl)\r\n2869:theorem USize.toNat_one : (1 : USize).toNat = 1 := by simp\r\n2875:theorem USize.zero_lt_one : (0 : USize) < 1 := by simp [lt_iff_toNat_lt]\r\n2881:theorem USize.zero_ne_one : (0 : USize) ≠ 1 := by simp [← USize.toNat_inj]\r\n3371:protected theorem UInt8.lt_iff_le_and_ne {a b : UInt8} : a < b ↔ a ≤ b ∧ a ≠ b := by\r\n3373:protected theorem UInt16.lt_iff_le_and_ne {a b : UInt16} : a < b ↔ a ≤ b ∧ a ≠ b := by\r\n3375:protected theorem UInt32.lt_iff_le_and_ne {a b : UInt32} : a < b ↔ a ≤ b ∧ a ≠ b := by\r\n3377:protected theorem UInt64.lt_iff_le_and_ne {a b : UInt64} : a < b ↔ a ≤ b ∧ a ≠ b := by\r\n3379:protected theorem USize.lt_iff_le_and_ne {a b : USize} : a < b ↔ a ≤ b ∧ a ≠ b := by\r\n3382:@[simp] protected theorem UInt8.not_lt_zero {a : UInt8} : ¬a < 0 := by simp [UInt8.lt_iff_toBitVec_lt]\r\n3383:@[simp] protected theorem UInt16.not_lt_zero {a : UInt16} : ¬a < 0 := by simp [UInt16.lt_iff_toBitVec_lt]\r\n3384:@[simp] protected theorem UInt32.not_lt_zero {a : UInt32} : ¬a < 0 := by simp [UInt32.lt_iff_toBitVec_lt]\r\n3385:@[simp] protected theorem UInt64.not_lt_zero {a : UInt64} : ¬a < 0 := by simp [UInt64.lt_iff_toBitVec_lt]\r\n3386:@[simp] protected theorem USize.not_lt_zero {a : USize} : ¬a < 0 := by simp [USize.lt_iff_toBitVec_lt]\r\n3472:protected theorem UInt8.pos_iff_ne_zero {a : UInt8} : 0 < a ↔ a ≠ 0 := by simp [UInt8.lt_iff_le_and_ne, Eq.comm]\r\n3473:protected theorem UInt16.pos_iff_ne_zero {a : UInt16} : 0 < a ↔ a ≠ 0 := by simp [UInt16.lt_iff_le_and_ne, Eq.comm]\r\n3474:protected theorem UInt32.pos_iff_ne_zero {a : UInt32} : 0 < a ↔ a ≠ 0 := by simp [UInt32.lt_iff_le_and_ne, Eq.comm]\r\n3475:protected theorem UInt64.pos_iff_ne_zero {a : UInt64} : 0 < a ↔ a ≠ 0 := by simp [UInt64.lt_iff_le_and_ne, Eq.comm]\r\n3476:protected theorem USize.pos_iff_ne_zero {a : USize} : 0 < a ↔ a ≠ 0 := by simp [USize.lt_iff_le_and_ne, Eq.comm]\r\n3534:protected theorem UInt8.le_iff_lt_or_eq {a b : UInt8} : a ≤ b ↔ a < b ∨ a = b := by\r\n3536:protected theorem UInt16.le_iff_lt_or_eq {a b : UInt16} : a ≤ b ↔ a < b ∨ a = b := by\r\n3538:protected theorem UInt32.le_iff_lt_or_eq {a b : UInt32} : a ≤ b ↔ a < b ∨ a = b := by\r\n3540:protected theorem UInt64.le_iff_lt_or_eq {a b : UInt64} : a ≤ b ↔ a < b ∨ a = b := by\r\n3542:protected theorem USize.le_iff_lt_or_eq {a b : USize} : a ≤ b ↔ a < b ∨ a = b := by\r\n3545:protected theorem UInt8.lt_or_eq_of_le {a b : UInt8} : a ≤ b → a < b ∨ a = b := UInt8.le_iff_lt_or_eq.mp\r\n3546:protected theorem UInt16.lt_or_eq_of_le {a b : UInt16} : a ≤ b → a < b ∨ a = b := UInt16.le_iff_lt_or_eq.mp\r\n3547:protected theorem UInt32.lt_or_eq_of_le {a b : UInt32} : a ≤ b → a < b ∨ a = b := UInt32.le_iff_lt_or_eq.mp\r\n3548:protected theorem UInt64.lt_or_eq_of_le {a b : UInt64} : a ≤ b → a < b ∨ a = b := UInt64.le_iff_lt_or_eq.mp\r\n3549:protected theorem USize.lt_or_eq_of_le {a b : USize} : a ≤ b → a < b ∨ a = b := USize.le_iff_lt_or_eq.mp\r\n"]
[191.547178, "o", "import Lean  namespace LeanModel.Constants  def bpsDenom : UInt64 := 10000 def bpsMaxRem : UInt64 := 9999 def u64ModBpsQuot : UInt64 := 1844674407370955 def u64ModBpsRem : UInt64 := 1616 def rebateDivisor : UInt64 := 10 def makerRebateCapDivisor : UInt64 := 5 def treasuryCutDivisor : UInt64 := 4 def flashDenom : UInt64 := 5000 def flashMaxRem : UInt64 := 4999 def u64ModFlashQuot : UInt64 := 3689348814741910 def u64ModFlashRem : UInt64 := 1616 def institutionalBandMin : UInt64 := 10000000000000  def mg10Divisor : UInt64 := 0x8003 def mg10Reciprocal : UInt64 := 0xFFF4 def limbMask : UInt64 := 0xFFFF def subBias : UInt64 := 0xC0000000 def blobGasPerSlot : UInt64 := 131072  def l8Mask : UInt64 := 0x0101010101010101 def h8Mask : UInt64 := 0x8080808080808080 def m16Mask : UInt64 := 0x00FF00FF00FF00FF def l16Mask : UInt64 := 0x0001000100010001 def calldataNzByteShift : UInt64 := 8  def babyBearP : UInt64 := 2013265921 def babyBearMu : UInt64 := 2281701377 def limbBase : UInt64 := 4294967296 def low32Mask : UInt64 := 0xFFFFFFFF  def goldilocksP : UInt64 := 0xFFFFFFFF00000001 def goldilocksEps : UInt64 := 0xFFFFFFFF  def codecTagMask : UInt64 := 0xFF def codecVersionV3 : UInt64 := 3 def sequencerDomainTag : UInt64 := 0x5A  def u64Max : UInt64 := 18446744073709551615  end LeanModel.Constants \r\n\u001b[?2004h"]
