[229.382127, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport os, subprocess, tempfile\ns=Path('/workspace/submission')\nwith tempfile.TemporaryDirectory(prefix='audit-axioms-') as d:\n    p=Path(d)\n    env={**os.environ,'LEAN_PATH':'/workspace/lean:'+d}\n    for name,file in [('CandidateSpec','Spec.lean'),('CandidateAudit','Audit.lean')]:\n        (p/(name+'.lean')).write_text((s/file).read_text())\n        subprocess.run(['lean','-o',name+'.olean',name+'.lean'],cwd=d,env=env,check=True)\n    (p/'Axioms.lean').write_text('import SecurityChallenge\\nimport CandidateSpec\\nimport CandidateAudit\\nimport Lean\\nimport Std\\nopen SecurityChallenge\\ntheorem auditEvidence : AuditClaim candidateSpec verdict := (\\n'+(s/'Proof.lean').read_text()+'\\n)\\n#print axioms auditEvidence\\n')\n    subprocess.run(['lean','Axioms.lean'],cwd=d,env=env,check=True)\nPY\nfind /workspace/submission -maxdepth 2 -type f -printf '%P\\n'\n"]
[229.382549, "o", "python3 - <<'PY'\r\nfrom pathlib import Path\r\nimport os, subprocess, tempfile\r\ns=Path('/workspace/submission')\r\nwith tempfile.TemporaryDirectory(prefix='audit-axioms-') as d:\r\n    p=Path(d)\r\n    env={**os.environ,'LEAN_PATH':'/workspace/lean:'+d}\r\n    for name,file in [('CandidateSpec','Spec.lean'),('CandidateAudit','Audit.lean')]:\r\n        (p/(name+'.lean')).write_text((s/file).read_text())\r\n        subprocess.run(['lean','-o',name+'.olean',name+'.lean'],cwd=d,env=env,check=True)\r\n    (p/'Axioms.lean').write_text('import SecurityChallenge\\nimport CandidateSpec\\nimport CandidateAudit\\nimport Lean\\nimport Std\\nopen SecurityChallenge\\ntheorem auditEvidence : AuditClaim candidateSpec verdict := (\\n'+(s/'Proof.lean').read_text()+'\\n)\\n#print axioms auditEvidence\\n')\r\n    subprocess.run(['lean','Axioms.lean'],cwd=d,env=env,check=True)\r\nPY\r\nfind /workspace/submission -maxdepth 2 -type f -printf '%P\\n'\r\n"]
