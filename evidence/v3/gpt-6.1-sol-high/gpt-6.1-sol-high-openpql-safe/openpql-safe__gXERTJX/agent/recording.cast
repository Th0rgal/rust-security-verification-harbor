[23.737996, "o", "\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  theorem \u001b[01;31m\u001b[Kle_iff_toNat\u001b[m\u001b[K_le {a b : $typeName} : a ≤ b ↔ a.toNat ≤ b.toNat := .rfl\r\n"]
[23.738159, "o", "\u001b[32m\u001b[K71\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  theorem \u001b[01;31m\u001b[Klt_iff_toNat\u001b[m\u001b[K_lt {a b : $typeName} : a < b ↔ a.toNat < b.toNat := .rfl\r\n\u001b[32m\u001b[K138\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  @[simp] protected theorem \u001b[01;31m\u001b[KtoNat_add\u001b[m\u001b[K (a b : $typeName) : (a + b).toNat = (a.toNat + b.toNat) % 2 ^ $bits := BitVec.\u001b[01;31m\u001b[KtoNat_add\u001b[m\u001b[K ..\r\n\u001b[32m\u001b[K142\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  @[simp] protected theorem \u001b[01;31m\u001b[KtoNat_mul\u001b[m\u001b[K (a b : $typeName) : (a * b).toNat = a.toNat * b.toNat % 2 ^ $bits := BitVec.\u001b[01;31m\u001b[KtoNat_mul\u001b[m\u001b[K  ..\r\n\u001b[32m\u001b[K146\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  @[simp] protected theorem \u001b[01;31m\u001b[KtoNat_div\u001b[m\u001b[K (a b : $typeName) : (a / b).toNat = a.toNat / b.toNat := BitVec.toNat_udiv  ..\r\n\u001b[32m\u001b[K150\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  protected theorem \u001b[01;31m\u001b[KtoNat_lt\u001b[m\u001b[K_size (a : $typeName) : a.toNat < size := a.toBitVec.isLt\r\n\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  open $typeName (toNat_mod \u001b[01;31m\u001b[KtoNat_lt\u001b[m\u001b[K_size) in\r\n\u001b[32m\u001b[K159\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      · apply \u001b[01;31m\u001b[KtoNat_lt\u001b[m\u001b[K_size\r\n\u001b[32m\u001b[K197\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    simp [Nat.mod_eq_of_lt x.\u001b[01;31m\u001b[KtoNat_lt\u001b[m\u001b[K_size]\r\n\u001b[32m\u001b[K279\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  rw [\u001b[01;31m\u001b[Klt_iff_toNat\u001b[m\u001b[K_lt, toNat_ofNat_of_lt' h]\r\n\u001b[32m\u001b[K281\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  rw [\u001b[01;31m\u001b[Klt_iff_toNat\u001b[m\u001b[K_lt, toNat_ofNat_of_lt' h]\r\n\u001b[32m\u001b[K283\u001b[m\u001b[K\u00