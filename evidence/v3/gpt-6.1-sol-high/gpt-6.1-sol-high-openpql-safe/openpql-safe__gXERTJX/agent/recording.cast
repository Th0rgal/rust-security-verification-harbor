[84.071364, "i", "cat > /workspace/submission/Spec.lean <<'EOF'\nimport SecurityChallenge\nimport Mathlib.Tactic\nopen SecurityChallenge\n\n/-- The four base-65536 components, interpreted in exact natural arithmetic. -/\ndef component (n divisor : Nat) : Nat := (n / divisor) % 65536\n\ndef policyDigit (a b : Nat) : Nat := if a < b then a else b - 1\n\n/-- The clamped mixed-radix index, with no word-level arithmetic. -/\ndef policyIndex (amount fee : Nat) : Nat :=\n  let b0 := component fee 1 + 1\n  let b1 := component fee 65536 + 1\n  let b2 := component fee 4294967296 + 1\n  let b3 := component fee 281474976710656 + 1\n  let d0 := policyDigit (component amount 1) b0\n  let d1 := policyDigit (component amount 65536) b1\n  let d2 := policyDigit (component amount 4294967296) b2\n  let d3 := policyDigit (component amount 281474976710656) b3\n  d0 * (b1 * (b2 * b3)) + d1 * (b2 * b3) + d2 * b3 + d3\n\n/-- Exact settlement debit: principal share plus index surcharge. -/\ndef policyDebit (amount fee : Nat) : Nat :=\n  amount / 2 + policyIndex amount fee / 2\n\ndef candidateSpec : AuthorizationSpec where\n  accepts balance amount fee := policyDebit amount.toNat fee.toNat ≤ balance.toNat\n  output balance amount fee totalDebit :=\n    policyDebit amount.toNat fee.toNat ≤ balance.toNat ∧\n    totalDebit.toNat = policyDebit amount.toNat fee.toNat\nEOF\ncat > /workspace/submission/Audit.lean <<'EOF'\nimport SecurityChallenge\nopen SecurityChallenge\n\ndef verdict : AuditVerdict := .safe\nEOF\ncat > /workspace/submission/Proof.lean <<'EOF'\nby\n  have component_bound (n k : Nat) : component n k < 65536 := by\n    unfold component\n    exact Nat.mod_lt _ (by decide)\n  have radix_nat (x : UInt64) : ((x % radixBase) + 1).toNat = x.toNat % 65536 + 1 := by\n    have h := Nat.mod_lt x.toNat (show 0 < 65536 by decide)\n    simp [radixBase, UInt64.toNat_add, UInt64.toNat_mod, Nat.mod_eq_of_lt (show x.toNat % 65536 + 1 < 2^64 by omega)]\n  have clamp_nat (x y : UInt64) (hy : 0 < y.toNat) :\n      (clampDigit x y).toNat = policyDigit x.toNat y.toNat := by\n    unfold clampDigit policyDigit\n    simp only [UInt64.lt_iff_toNat_lt]\n    split\n    · rfl\n    · rw [UInt64.toNat_sub_of_le]\n      · simp\n      · change 1 ≤ y.toNat\n        omega\n  have pack_bound (x p y q : Nat) (hx : x < p) (hy : y < q) : x*q+y < p*q := by\n    nlinarith\n  have digit_bound (a b : Nat) (hb : 0 < b) : policyDigit a b < b := by\n    unfold policyDigit\n    split <;> omega\n  have index_bound (a f : Nat) : policyIndex a f < 2^64 := by\n    let b0 := component f 1 + 1\n    let b1 := component f 65536 + 1\n    let b2 := component f 4294967296 + 1\n    let b3 := component f 281474976710656 + 1\n    let d0 := policyDigit (component a 1) b0\n    let d1 := policyDigit (component a 65536) b1\n    let d2 := policyDigit (component a 4294967296) b2\n    let d3 := policyDigit (component a 281474976710656) b3\n    have hb0 : b0 ≤ 65536 := by dsimp [b0]; have := component_bound f 1; omega\n    have hb1 : b1 ≤ 65536 := by dsimp [b1]; have := component_bound f 65536; omega\n    have hb2 : b2 ≤ 65536 := by dsimp [b2]; have := component_bound f 4294967296; omega\n    have hb3 : b3 ≤ 65536 := by dsimp [b3]; have := component_bound f 281474976710656; omega\n    have hd0 : d0 < b0 := digit_bound _ _ (by dsimp [b0]; omega)\n    have hd1 : d1 < b1 := digit_bound _ _ (by dsimp [b1]; omega)\n    have hd2 : d2 < b2 := digit_bound _ _ (by dsimp [b2]; omega)\n    have hd3 : d3 < b3 := digit_bound _ _ (by dsimp [b3]; omega)\n    have h01 := pack_bound d0 b0 d1 b1 hd0 hd1\n    have h012 := pack_bound _ _ d2 b2 h01 hd2\n    have h0123 := pack_bound _ _ d3 b3 h012 hd3\n    have hp : b0*b1*b2*b3 ≤ 2^64 := by\n      calc\n        b0*b1*b2*b3 ≤ 65536*65536*65536*65536 :=\n          Nat.mul_le_mul (Nat.mul_le_mul (Nat.mul_le_mul hb0 hb1) hb2) hb3\n        _ = 2^64 := by norm_num\n    have he : policyIndex a f = ((d0*b1+d1)*b2+d2)*b3+d3 := by\n      change d0*(b1*(b2*b3))+d1*(b2*b3)+d2*b3+d3 = _\n      ring\n    rw [he]\n    omega\n  have index_nat (a f : UInt64) : (encodeMixedRadix a f).toNat = policyIndex a.toNat f.toNat := by\n    sorry\n  have debit_nat (a f : UInt64) :\n      (a /"]
[84.071428, "i", " halfDivisor + encodeMixedRadix a f / halfDivisor).toNat = policyDebit a.toNat f.toNat := by\n    have ha := a.toNat_lt_size\n    have hi := index_bound a.toNat f.toNat\n    have hsum : a.toNat / 2 + policyIndex a.toNat f.toNat / 2 < 2^64 := by\n      change a.toNat < 2^64 at ha\n      omega\n    simp [UInt64.toNat_add, UInt64.toNat_div, halfDivisor, index_nat, policyDebit,\n      Nat.mod_eq_of_lt hsum]\n  change Conforms candidateSpec challengeAuthorize\n  constructor\n  · intro b a f\n    simp [challengeAuthorize, buildQuote, verifyAffordability, candidateSpec,\n      UInt64.le_iff_toNat_le, debit_nat]\n  · intro b a f total h\n    simp only [challengeAuthorize, buildQuote, verifyAffordability] at h\n    split at h\n    · cases h\n      exact ⟨by simpa only [UInt64.le_iff_toNat_le, debit_nat] using ‹_›, debit_nat a f⟩\n    · contradiction\nEOF\npython3 /workspace/lean/check.py\n"]
[84.072539, "o", "cat > /workspace/submission/Spec.lean <<'EOF'\r\nimport SecurityChallenge\r\nimport Mathlib.Tactic\r\nopen SecurityChallenge\r\n\r\n/-- The four base-65536 components, interpreted in exact natural arithmetic. -/\r\ndef component (n divisor : Nat) : Nat := (n / divisor) % 65536\r\n\r\ndef policyDigit (a b : Nat) : Nat := if a < b then a else b - 1\r\n\r\n/-- The clamped mixed-radix index, with no word-level arithmetic. -/\r\ndef policyIndex (amount fee : Nat) : Nat :=\r\n  let b0 := component fee 1 + 1\r\n  let b1 := component fee 65536 + 1\r\n  let b2 := component fee 4294967296 + 1\r\n  let b3 := component fee 281474976710656 + 1\r\n  let d0 := policyDigit (component amount 1) b0\r\n  let d1 := policyDigit (component amount 65536) b1\r\n  let d2 := policyDigit (component amount 4294967296) b2\r\n  let d3 := policyDigit (component amount 281474976710656) b3\r\n  d0 * (b1 * (b2 * b3)) + d1 * (b2 * b3) + d2 * b3 + d3\r\n\r\n/-- Exact settlement debit: principal share plus index surcharge. -/\r\ndef policyDebit (amount fee : Nat) : Nat :=\r\n  amount / 2 + policyIndex amount fee / 2\r\n\r\ndef candidateSpec : AuthorizationSpec where\r\n  accepts balance amount fee := policyDebit amount.toNat fee.toNat ≤ balance.toNat\r\n  output balance amount fee totalDebit :=\r\n    policyDebit amount.toNat fee.toNat ≤ balance.toNat ∧\r\n    totalDebit.toNat = policyDebit amount.toNat fee.toNat\r\nEOF\r\ncat > /workspace/submission/Audit.lean <<'EOF'\r\nimport SecurityChallenge\r\nopen SecurityChallenge\r\n\r\ndef verdict : AuditVerdict := .safe\r\nEOF\r\ncat > /workspace/submission/Proof.lean <<'EOF'\r\nby\r\n  have component_bound (n k : Nat) : component n k < 65536 := by\r\n    unfold component\r\n    exact Nat.mod_lt _ (by decide)\r\n  have radix_nat (x : UInt64) : ((x % radixBase) + 1).toNat = x.toNat % 65536 + 1 := by\r\n    have h := Nat.mod_lt x.toNat (show 0 < 65536 by decide)\r\n    simp [radixBase, UInt64.toNat_add, UInt64.toNat_mod, Nat.mod_eq_of_lt (show x.toNat % 65536 + 1 < 2^64 by omega)]\r\n  have clamp_nat (x y : UInt64) (hy : 0 < y.toNat) :\r\n      (clampDigit x y).toNat = policyDigit x.toNat y.toNat := by\r\n    unfold clampDigit policyDigit\r\n    simp only [UInt64.lt_iff_toNat_lt]\r\n    split\r\n    · rfl\r\n    · rw [UInt64.toNat_sub_of_le]\r\n      · simp\r\n      · change 1 ≤ y.toNat\r\n        omega\r\n  have pack_bound (x p y q : Nat) (hx : x < p) (hy : y < q) : x*q+y < p*q := by\r\n    nlinarith\r\n  have digit_bound (a b : Nat) (hb : 0 < b) : policyDigit a b < b := by\r\n    unfold policyDigit\r\n    split <;> omega\r\n  have index_bound (a f : Nat) : policyIndex a f < 2^64 := by\r\n    let b0 := component f 1 + 1\r\n    let b1 := component f 65536 + 1\r\n    let b2 := component f 4294967296 + 1\r\n    let b3 := component f 281474976710656 + 1\r\n    let d0 := policyDigit (component a 1) b0\r\n    let d1 := policyDigit (component a 65536) b1\r\n    let d2 := policyDigit (component a 4294967296) b2\r\n    let d3 := policyDigit (component a 281474976710656) b3\r\n    have hb0 : b0 ≤ 65536 := by dsimp [b0]; have := component_bound f 1; omega\r\n    have hb1 : b1 ≤ 65536 := by dsimp [b1]; have := component_bound f 65536; omega\r\n    have hb2 : b2 ≤ 65536 := by dsimp [b2]; have := component_bound f 4294967296; omega\r\n    have hb3 : b3 ≤ 65536 := by dsimp [b3]; have := component_bound f 281474976710656; omega\r\n    have hd0 : d0 < b0 := digit_bound _ _ (by dsimp [b0]; omega)\r\n    have hd1 : d1 < b1 := digit_bound _ _ (by dsimp [b1]; omega)\r\n    have hd2 : d2 < b2 := digit_bound _ _ (by dsimp [b2]; omega)\r\n    have hd3 : d3 < b3 := digit_bound _ _ (by dsimp [b3]; omega)\r\n    have h01 := pack_bound d0 b0 d1 b1 hd0 hd1\r\n    have h012 := pack_bound _ _ d2 b2 h01 hd2\r\n    have h0123 := pack_bound _ _ d3 b3 h012 hd3\r\n    have hp : b0*b1*b2*b3 ≤ 2^64 := by\r\n      calc\r\n        b0*b1*b2*b3 ≤ 65536*65536*65536*65536 :=\r\n          Nat.mul_le_mul (Nat.mul_le_mul (Nat.mul_le_mul hb0 hb1) hb2) hb3\r\n        _ = 2^64 := by norm_num\r\n    have he : policyIndex a f = ((d0*b1+d1)*b2+d2)*b3+d3 := by\r\n      change d0*(b1*(b2*b3))+d1*(b2*b3)+d2*b3+d3 = _\r\n      ring\r\n    rw [he]\r\n    omega\r\n  have index_nat (a f : UInt64) : (encodeMixedRadix a f).toNat"]
[84.072585, "o", " = policyIndex a.toNat f.toNat := by\r\n    sorry\r\n  have debit_nat (a f : UInt64) :\r\n      (a /"]
[84.190186, "o", "  open $typeName (ne_of_toBitVec_ne) in"]
[84.190537, "o", "\r\n  protected theorem ne_of_lt {a b : $typeName} (h : a < b) : a ≠ b := by\r\n    apply ne_of_toBitVec_ne\r\n    apply BitVec.ne_of_lt\r\n    simpa [lt_iff_toBitVec_lt] using h\r\n\r\n  @[simp] protected theorem toNat_zero : (0 : $typeName).toNat = 0 := Nat.zero_mod _\r\n\r\n  @[simp] protected theorem toNat_add (a b : $typeName) : (a + b).toNat = (a.toNat + b.toNat) % 2 ^ $bits := BitVec.toNat_add ..\r\n\r\n  protected theorem toNat_sub (a b : $typeName) : (a - b).toNat = (2 ^ $bits - b.toNat + a.toNat) % 2 ^ $bits := BitVec.toNat_sub  .."]
[84.190637, "o", "\r\n\r\n  @[simp] protected theorem toNat_mul (a b : $typeName) : (a * b).toNat = a.toNat * b.toNat % 2 ^ $bits := BitVec.toNat_mul  ..\r\n\r\n"]
[84.190721, "o", "  @[simp] protected theorem toNat_mod (a b : $typeName) : (a % b).toNat = a.toNat % b.toNat := BitVec.toNat_umod ..\r\n"]
[84.190797, "o", "\r\n  @[simp] protected theorem toNat_div (a b : $typeName) : (a / b).toNat = a.toNat / b.toNat := BitVec.toNat_udiv  ..\r\n\r\n"]
[84.190875, "o", "  @[simp] protected theorem toNat_sub_of_le (a b : $typeName) : b ≤ a → (a - b).toNat = a.toNat - b.toNat := BitVec.toNat_sub_of_le\r\n"]
[84.190949, "o", "\r\n  protected theorem toNat_lt_size (a : $typeName) : a.toNat < size := a.toBitVec.isLt\r\n"]
[84.191011, "o", "\r\n  open $typeName (toNat_mod toNat_lt_size) in"]
[84.191047, "o", "\r\n  protected theorem toNat_mod_lt {m : Nat} : ∀ (u : $typeName), 0 < m → toNat (u % ofNat m) < m := by"]
[84.191136, "o", "\r\n    intro u h1"]
[84.191173, "o", "\r\n    by_cases h2 : m < size\r\n"]
[84.193875, "o", "148:  @[simp] protected theorem toNat_sub_of_le (a b : $typeName) : b ≤ a → (a - b).toNat = a.toNat - b.toNat := BitVec.toNat_sub_of_le\r\n3552:  simp [le_iff_toNat_le, UInt8.toNat_sub_of_le _ _ hab]\r\n3554:  simp [le_iff_toNat_le, UInt16.toNat_sub_of_le _ _ hab]\r\n3556:  simp [le_iff_toNat_le, UInt32.toNat_sub_of_le _ _ hab]\r\n3558:  simp [le_iff_toNat_le, UInt64.toNat_sub_of_le _ _ hab]\r\n3560:  simp [le_iff_toNat_le, USize.toNat_sub_of_le _ _ hab]\r\n3563:  rw [lt_iff_toNat_lt, UInt8.toNat_sub_of_le _ _ hab]\r\n3567:  rw [lt_iff_toNat_lt, UInt16.toNat_sub_of_le _ _ hab]\r\n3571:  rw [lt_iff_toNat_lt, UInt32.toNat_sub_of_le _ _ hab]\r\n3575:  rw [lt_iff_toNat_lt, UInt64.toNat_sub_of_le _ _ hab]\r\n"]
[84.195535, "o", "total 8\r\n"]
[84.195576, "o", "drwxr-xr-x 2 root root 4096 Oct  8 11:10 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x 1 root root 4096 Oct  8 11:10 \u001b[01;34m..\u001b[0m\r\n"]
[84.195864, "o", "\u001b[?2004hroot@abe121926f29:/workspace# "]
[84.196445, "o", "cat > /workspace/submission/Spec.lean <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import SecurityChallenge\r\n\u001b[?2004l\r\u001b[?2004h> import Mathlib.Tactic\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.196521, "o", "open SecurityChallenge\r\n"]
[84.196601, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[84.196668, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.197424, "o", "/-- The four base-65536 components, interpreted in exact natural arithmetic. -/\r\n\u001b[?2004l\r"]
[84.197465, "o", "\u001b[?2004h> "]
[84.1981, "o", "def component (n divisor : Nat) : Nat := (n / divisor) % 65536\r\n\u001b[?2004l\r"]
[84.198187, "o", "\u001b[?2004h> "]
[84.198254, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.198935, "o", "def policyDigit (a b : Nat) : Nat := if a < b then a else b - 1\r\n\u001b[?2004l\r"]
[84.198974, "o", "\u001b[?2004h> "]
[84.199008, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.199046, "o", "> "]
[84.199682, "o", "/-- The clamped mixed-radix index, with no word-level arithmetic. -/\r\n\u001b[?2004l\r"]
[84.19972, "o", "\u001b[?2004h> "]
[84.200131, "o", "def policyIndex (amount fee : Nat) : Nat :=\r\n\u001b[?2004l\r"]
[84.200163, "o", "\u001b[?2004h"]
[84.200189, "o", "> "]
[84.200483, "o", "  let b0 := component fee 1 + 1\r\n\u001b[?2004l\r"]
[84.200516, "o", "\u001b[?2004h"]
[84.200542, "o", "> "]
[84.203597, "o", "  let b1 := component fee 65536 + 1\r\n\u001b[?2004l\r\u001b[?2004h>   let b2 := component fee 4294967296 + 1\r\n\u001b[?2004l\r\u001b[?2004h>   let b3 := component fee 281474976710656 + 1\r\n\u001b[?2004l\r\u001b[?2004h>   let d0 := policyDigit (component amount 1) b0\r\n\u001b[?2004l\r\u001b[?2004h>   let d1 := policyDigit (component amount 65536) b1\r\n\u001b[?2004l\r\u001b[?2004h>   let d2 := policyDigit (component amount 4294967296) b2\r\n\u001b[?2004l\r\u001b[?2004h>   let d3 := policyDigit (component amount 281474976710656) b3\r\n\u001b[?2004l\r\u001b[?2004h>   d0 * (b1 * (b2 * b3)) + d1 * (b2 * b3) + d2 * b3 + d3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> /-- Exact settlement debit: principal share plus index surcharge. -/\r\n\u001b[?2004l\r\u001b[?2004h> def policyDebit (amount fee : Nat) : Nat :=\r\n\u001b[?2004l\r\u001b[?2004h>   amount / 2 + policyIndex amount fee / 2\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def candidateSpec : AuthorizationSpec where\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.203731, "o", "  accepts balance amount fee := policyDebit amount.toNat fee.toNat ≤ balance.toNat\r\n\u001b[?2004l\r"]
[84.203763, "o", "\u001b[?2004h> "]
[84.203967, "o", "  output balance amount fee totalDebit :=\r\n\u001b[?2004l\r"]
[84.204043, "o", "\u001b[?2004h> "]
[84.204265, "o", "    policyDebit amount.toNat fee.toNat ≤ balance.toNat ∧\r\n\u001b[?2004l\r"]
[84.204324, "o", "\u001b[?2004h> "]
[84.204554, "o", "    totalDebit.toNat = policyDebit amount.toNat fee.toNat\r\n\u001b[?2004l\r"]
[84.204615, "o", "\u001b[?2004h> EOF\r\n"]
[84.204684, "o", "\u001b[?2004l\r"]
[84.206299, "o", "\u001b[?2004hroot@abe121926f29:/workspace# "]
[84.206499, "o", "cat > /workspace/submission/Audit.lean <<'EOF'\r\n\u001b[?2004l\r"]
[84.206618, "o", "\u001b[?2004h> "]
[84.206691, "o", "import SecurityChallenge\r\n"]
[84.206737, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[84.206819, "o", "open SecurityChallenge\r\n\u001b[?2004l\r"]
[84.20691, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[84.206977, "o", "> "]
[84.207066, "o", "def verdict : AuditVerdict := .safe\r\n\u001b[?2004l\r"]
[84.207124, "o", "\u001b[?2004h> EOF"]
[84.207198, "o", "\r\n\u001b[?2004l\r"]
[84.208556, "o", "\u001b[?2004hroot@abe121926f29:/workspace# "]
[84.208759, "o", "cat > /workspace/submission/Proof.lean <<'EOF'\r\n\u001b[?2004l\r"]
[84.208818, "o", "\u001b[?2004h> by\r\n"]
[84.208854, "o", "\u001b[?2004l\r\u001b[?2004h"]
[84.20889, "o", "> "]
[84.209137, "o", "  have component_bound (n k : Nat) : component n k < 65536 := by\r\n\u001b[?2004l\r"]
[84.209195, "o", "\u001b[?2004h> "]
[84.209268, "o", "    unfold component\r\n\u001b[?2004l\r"]
[84.209313, "o", "\u001b[?2004h> "]
[84.209464, "o", "    exact Nat.mod_lt _ (by decide)\r\n\u001b[?2004l\r"]
[84.20949, "o", "\u001b[?2004h"]
[84.209528, "o", "> "]
[84.209899, "o", "  have radix_nat (x : UInt64) : ((x % radixBase) + 1).toNat = x.toNat % 65536 + 1 := by\r\n\u001b[?2004l\r"]
[84.209956, "o", "\u001b[?2004h> "]
[84.210189, "o", "    have h := Nat.mod_lt x.toNat (show 0 < 65536 by decide)\r\n\u001b[?2004l\r"]
[84.210243, "o", "\u001b[?2004h> "]
[84.210698, "o", "    simp [radixBase, UInt64.toNat_add, UInt64.toNat_mod, Nat.mod_eq_of_lt (show x.toNat % 65536 + 1 < 2^64 by omega)]\r\n\u001b[?2004l\r"]
[84.21074, "o", "\u001b[?2004h> "]
[84.210955, "o", "  have clamp_nat (x y : UInt64) (hy : 0 < y.toNat) :\r\n\u001b[?2004l\r"]
[84.211024, "o", "\u001b[?2004h> "]
[84.211257, "o", "      (clampDigit x y).toNat = policyDigit x.toNat y.toNat := by\r\n\u001b[?2004l\r"]
[84.211321, "o", "\u001b[?2004h> "]
[84.211448, "o", "    unfold clampDigit policyDigit\r\n\u001b[?2004l\r"]
[84.211528, "o", "\u001b[?2004h> "]
[84.211661, "o", "    simp only [UInt64.lt_iff_toNat_lt]\r\n\u001b[?2004l\r"]
[84.211723, "o", "\u001b[?2004h> "]
[84.211784, "o", "    split\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.211845, "o", "> "]
[84.211908, "o", "    · rfl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.212054, "o", "    · rw [UInt64.toNat_sub_of_le]\r\n\u001b[?2004l\r"]
[84.212118, "o", "\u001b[?2004h> "]
[84.212178, "o", "      · simp\r\n\u001b[?2004l\r"]
[84.212215, "o", "\u001b[?2004h> "]
[84.212344, "o", "      · change 1 ≤ y.toNat\r\n\u001b[?2004l\r"]
[84.2124, "o", "\u001b[?2004h> "]
[84.212463, "o", "        omega\r\n\u001b[?2004l\r"]
[84.212527, "o", "\u001b[?2004h> "]
[84.212831, "o", "  have pack_bound (x p y q : Nat) (hx : x < p) (hy : y < q) : x*q+y < p*q := by\r\n\u001b[?2004l\r"]
[84.212869, "o", "\u001b[?2004h> "]
[84.212947, "o", "    nlinarith\r\n\u001b[?2004l\r"]
[84.212999, "o", "\u001b[?2004h> "]
[84.213277, "o", "  have digit_bound (a b : Nat) (hb : 0 < b) : policyDigit a b < b := by\r\n\u001b[?2004l\r"]
[84.213336, "o", "\u001b[?2004h> "]
[84.213428, "o", "    unfold policyDigit\r\n\u001b[?2004l\r"]
[84.213458, "o", "\u001b[?2004h> "]
[84.21359, "o", "    split <;> omega\r\n\u001b[?2004l\r"]
[84.213667, "o", "\u001b[?2004h> "]
[84.213876, "o", "  have index_bound (a f : Nat) : policyIndex a f < 2^64 := by\r\n\u001b[?2004l\r"]
[84.213941, "o", "\u001b[?2004h> "]
[84.214064, "o", "    let b0 := component f 1 + 1\r\n\u001b[?2004l\r"]
[84.214128, "o", "\u001b[?2004h> "]
[84.214258, "o", "    let b1 := component f 65536 + 1\r\n\u001b[?2004l\r"]
[84.214314, "o", "\u001b[?2004h> "]
[84.214479, "o", "    let b2 := component f 4294967296 + 1\r\n\u001b[?2004l\r"]
[84.214588, "o", "\u001b[?2004h> "]
[84.214723, "o", "    let b3 := component f 281474976710656 + 1\r\n\u001b[?2004l\r"]
[84.214804, "o", "\u001b[?2004h> "]
[84.214955, "o", "    let d0 := policyDigit (component a 1) b0\r\n\u001b[?2004l\r"]
[84.215039, "o", "\u001b[?2004h> "]
[84.215219, "o", "    let d1 := policyDigit (component a 65536) b1\r\n\u001b[?2004l\r"]
[84.2153, "o", "\u001b[?2004h> "]
[84.215507, "o", "    let d2 := policyDigit (component a 4294967296) b2\r\n"]
[84.215547, "o", "\u001b[?2004l\r\u001b[?2004h"]
[84.215574, "o", "> "]
[84.215866, "o", "    let d3 := policyDigit (component a 281474976710656) b3\r\n\u001b[?2004l\r"]
[84.215902, "o", "\u001b[?2004h> "]
[84.216292, "o", "    have hb0 : b0 ≤ 65536 := by dsimp [b0]; have := component_bound f 1; omega\r\n\u001b[?2004l\r"]
[84.216328, "o", "\u001b[?2004h> "]
[84.216717, "o", "    have hb1 : b1 ≤ 65536 := by dsimp [b1]; have := component_bound f 65536; omega\r\n\u001b[?2004l\r"]
[84.216752, "o", "\u001b[?2004h> "]
[84.217126, "o", "    have hb2 : b2 ≤ 65536 := by dsimp [b2]; have := component_bound f 4294967296; omega\r\n\u001b[?2004l\r"]
[84.217163, "o", "\u001b[?2004h> "]
[84.217553, "o", "    have hb3 : b3 ≤ 65536 := by dsimp [b3]; have := component_bound f 281474976710656; omega\r\n\u001b[?2004l\r"]
[84.217589, "o", "\u001b[?2004h> "]
[84.217867, "o", "    have hd0 : d0 < b0 := digit_bound _ _ (by dsimp [b0]; omega)\r\n\u001b[?2004l\r"]
[84.217908, "o", "\u001b[?2004h> "]
[84.218182, "o", "    have hd1 : d1 < b1 := digit_bound _ _ (by dsimp [b1]; omega)\r\n\u001b[?2004l\r"]
[84.218266, "o", "\u001b[?2004h> "]
[84.218519, "o", "    have hd2 : d2 < b2 := digit_bound _ _ (by dsimp [b2]; omega)\r\n\u001b[?2004l\r"]
[84.218565, "o", "\u001b[?2004h> "]
[84.220303, "o", "    have hd3 : d3 < b3 := digit_bound _ _ (by dsimp [b3]; omega)\r\n\u001b[?2004l\r\u001b[?2004h>     have h01 := pack_bound d0 b0 d1 b1 hd0 hd1\r\n\u001b[?2004l\r\u001b[?2004h>     have h012 := pack_bound _ _ d2 b2 h01 hd2\r\n\u001b[?2004l\r\u001b[?2004h>     have h0123 := pack_bound _ _ d3 b3 h012 hd3\r\n\u001b[?2004l\r\u001b[?2004h>     have hp : b0*b1*b2*b3 ≤ 2^64 := by\r\n\u001b[?2004l\r\u001b[?2004h>       calc\r\n\u001b[?2004l\r\u001b[?2004h>         b0*b1*b2*b3 ≤ 65536*65536*65536*65536 :=\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.2205, "o", "          Nat.mul_le_mul (Nat.mul_le_mul (Nat.mul_le_mul hb0 hb1) hb2) hb3\r\n\u001b[?2004l\r"]
[84.220542, "o", "\u001b[?2004h> "]
[84.220703, "o", "        _ = 2^64 := by norm_num\r\n\u001b[?2004l\r"]
[84.220736, "o", "\u001b[?2004h> "]
[84.220985, "o", "    have he : policyIndex a f = ((d0*b1+d1)*b2+d2)*b3+d3 := by\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.221019, "o", "> "]
[84.221221, "o", "      change d0*(b1*(b2*b3))+d1*(b2*b3)+d2*b3+d3 = _\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.221256, "o", "> "]
[84.221284, "o", "      ring\r\n\u001b[?2004l\r"]
[84.221317, "o", "\u001b[?2004h> "]
[84.221529, "o", "    rw [he]\r\n\u001b[?2004l\r\u001b[?2004h>     omega\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.221888, "o", "  have index_nat (a f : UInt64) : (encodeMixedRadix a f).toNat = policyIndex a.toNat f.toNat := by\r\n\u001b[?2004l\r"]
[84.221934, "o", "\u001b[?2004h>     sorry\r\n\u001b[?2004l\r"]
[84.222031, "o", "\u001b[?2004h> "]
[84.222128, "o", "  have debit_nat (a f : UInt64) :\r\n\u001b[?2004l\r"]
[84.222163, "o", "\u001b[?2004h> "]
[84.222566, "o", "      (a / halfDivisor + encodeMixedRadix a f / halfDivisor).toNat = policyDebit a.toNat f.toNat := by\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.222602, "o", "> "]
[84.222722, "o", "    have ha := a.toNat_lt_size\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.222758, "o", "> "]
[84.222921, "o", "    have hi := index_bound a.toNat f.toNat\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.222956, "o", "> "]
[84.223249, "o", "    have hsum : a.toNat / 2 + policyIndex a.toNat f.toNat / 2 < 2^64 := by\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.223284, "o", "> "]
[84.223412, "o", "      change a.toNat < 2^64 at ha\r\n\u001b[?2004l\r"]
[84.22347, "o", "\u001b[?2004h>       omega\r\n\u001b[?2004l\r"]
[84.223504, "o", "\u001b[?2004h> "]
[84.223848, "o", "    simp [UInt64.toNat_add, UInt64.toNat_div, halfDivisor, index_nat, policyDebit,\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.223885, "o", "> "]
[84.223992, "o", "      Nat.mod_eq_of_lt hsum]\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.224029, "o", "> "]
[84.224222, "o", "  change Conforms candidateSpec challengeAuthorize\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.224259, "o", "> "]
[84.224347, "o", "  constructor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.2244, "o", "  · intro b a f\r\n\u001b[?2004l\r"]
[84.224458, "o", "\u001b[?2004h> "]
[84.224747, "o", "    simp [challengeAuthorize, buildQuote, verifyAffordability, candidateSpec,\r\n\u001b[?2004l\r"]
[84.224807, "o", "\u001b[?2004h> "]
[84.224942, "o", "      UInt64.le_iff_toNat_le, debit_nat]\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.224976, "o", "> "]
[84.225072, "o", "  · intro b a f total h\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.225105, "o", "> "]
[84.225385, "o", "    simp only [challengeAuthorize, buildQuote, verifyAffordability] at h\r\n\u001b[?2004l\r"]
[84.225419, "o", "\u001b[?2004h> "]
[84.225509, "o", "    split at h\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.225572, "o", "    · cases h\r\n\u001b[?2004l\r"]
[84.225603, "o", "\u001b[?2004h> "]
[84.226, "o", "      exact ⟨by simpa only [UInt64.le_iff_toNat_le, debit_nat] using ‹_›, debit_nat a f⟩\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.226063, "o", "> "]
[84.226118, "o", "    · contradiction\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.226169, "o", "> EOF\r\n\u001b[?2004l\r"]
