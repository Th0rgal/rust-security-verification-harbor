[23.738792, "o", "\u001b[32m\u001b[K319\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  rw [\u001b[01;31m\u001b[Kle_iff_toNat\u001b[m\u001b[K_le, toNat_ofNat_of_lt' h]\r\n\u001b[32m\u001b[K321\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  rw [\u001b[01;31m\u001b[Kle_iff_toNat\u001b[m\u001b[K_le, toNat_ofNat_of_lt' h]\r\n\u001b[32m\u001b[K329\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K@[simp] theorem UInt8.\u001b[01;31m\u001b[KtoNat_lt\u001b[m\u001b[K (n : UInt8) : n.toNat < 2 ^ 8 := n.toFin.isLt\r\n\u001b[32m\u001b[K330\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K@[simp] theorem UInt16.\u001b[01;31m\u001b[KtoNat_lt\u001b[m\u001b[K (n : UInt16) : n.toNat < 2 ^ 16 := n.toFin.isLt\r\n\u001b[32m\u001b[K331\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K@[simp] theorem UInt32.\u001b[01;31m\u001b[KtoNat_lt\u001b[m\u001b[K (n : UInt32) : n.toNat < 2 ^ 32 := n.toFin.isLt\r\n\u001b[32m\u001b[K332\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K@[simp] theorem UInt64.\u001b[01;31m\u001b[KtoNat_lt\u001b[m\u001b[K (n : UInt64) : n.toNat < 2 ^ 64 := n.toFin.isLt\r\n\u001b[32m\u001b[K345\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Ktheorem USize.\u001b[01;31m\u001b[KtoNat_lt\u001b[m\u001b[K_two_pow_numBits (n : USize) : n.toNat < 2 ^ System.Platform.numBits := n.toFin.isLt\r\n\u001b[32m\u001b[K346\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K@[simp] theorem USize.\u001b[01;31m\u001b[KtoNat_lt\u001b[m\u001b[K (n : USize) : n.toNat < 2 ^ 64 := Nat.lt_of_lt_of_le n.toFin.isLt size_le\r\n\u001b[32m\u001b[K350\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Ktheorem UInt8.\u001b[01;31m\u001b[KtoNat_lt\u001b[m\u001b[K_usizeSize (n : UInt8) : n.toNat < USize.size :=\r\n\u001b[32m\u001b[K351\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  Nat.lt_of_lt_of_le n.\u001b[01;31m\u001b[KtoNat_lt\u001b[m\u001b[K (by cases USize.size_eq <;> simp_all)\r\n\u001b[32m\u001b[K352\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Ktheorem UInt16.\u001b[01;31m\u