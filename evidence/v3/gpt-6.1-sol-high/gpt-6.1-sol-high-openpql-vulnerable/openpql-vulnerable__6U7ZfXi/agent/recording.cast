[49.124276, "o", "\u001b[?2004h> "]
[49.124582, "o", "  accepts := fun balance amount fee => policyDebit amount fee ≤ balance.toNat\r\n\u001b[?2004l\r"]
[49.124656, "o", "\u001b[?2004h> "]
[49.124804, "o", "  output := fun balance amount fee totalDebit =>\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.124844, "o", "> "]
[49.125027, "o", "    policyDebit amount fee ≤ balance.toNat ∧\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.125065, "o", "> "]
[49.125243, "o", "    totalDebit.toNat = policyDebit amount fee\r\n\u001b[?2004l\r"]
[49.125282, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
