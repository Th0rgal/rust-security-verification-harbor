[111.122433, "o", "--- /workspace/challenge/src/lib.rs\t2026-10-08 11:09:16.000000000 +0000\r\n+++ /workspace/submission/src/lib.rs\t2026-10-08 11:18:59.072300081 +0000\r\n@@ -38,12 +38,11 @@\r\n         let o1: u64 = b2 * o2;\r\n         let o0: u64 = b1 * o1;\r\n         let raw_idx: u64 = d0 * o0 + d1 * o1 + d2 * o2 + d3;"]
[111.122577, "o", "\r\n-        let space_size: u64 = o0.wrapping_mul(b0);\r\n-        if raw_idx < space_size {\r\n-            raw_idx\r\n-        } else {\r\n-            0u64\r\n-        }\r\n+        // The clamped coordinate is always below the mathematical radix\r\n+        // product, which is at most 2^64. Hence raw_idx fits in u64 even\r\n+        // when that product itself does not. Do not wrap the product and\r\n+        // use the wrapped value to discard valid indices.\r\n+        raw_idx\r\n     }\r\n }\r\n \r\n@@ -132,4 +131,25 @@\r\n             Some(Authorization { total_debit: 50 })\r\n         );\r\n"]
[111.122663, "o", "     }\r\n+\r\n+    #[test]\r\n+    fn full_radix_space_does_not_discard_the_index() {\r\n+        assert_eq!(authorize(1, 2, u64::MAX), None);\r\n+        assert_eq!(authorize(281_474_976_710_656, 2, u64::MAX), None);\r\n+        assert_eq!(\r\n+            authorize(281_474_976_710_657, 2, u64::MAX),\r\n+            Some(Authorization { total_debit: 281_474_976_710_657 })\r\n+        );\r\n+    }\r\n+\r\n+    #[test]\r\n+    fn maximum_coordinates_have_exact_representable_debit() {\r\n+        assert_eq!(\r\n+            authorize(u64::MAX, u64::MAX, u64::MAX),\r\n+            Some(Authorization { total_debit: u64::MAX - 1 })\r\n+        );\r\n+        assert_eq!(authorize(u64::MAX - 2, u64::MAX, u64::MAX), None);\r\n+        assert_eq!(authorize(0, 0, u64::MAX), Some(Authorization { total_debit: 0 }));\r\n+    }\r\n+\r\n }\r\n"]
[111.122939, "o", "\u001b[?2004h"]
