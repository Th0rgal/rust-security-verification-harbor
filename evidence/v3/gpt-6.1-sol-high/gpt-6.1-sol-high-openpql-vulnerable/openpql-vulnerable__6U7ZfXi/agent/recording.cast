[49.119736, "o", "cat > /workspace/submission/Spec.lean <<'EOF'\r\n\u001b[?2004l\r"]
[49.119817, "o", "\u001b[?2004h> "]
[49.119925, "o", "import SecurityChallenge\r\n\u001b[?2004l\r"]
[49.120032, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.120173, "o", "-- All arithmetic below is exact natural-number arithmetic.\r\n\u001b[?2004l\r"]
[49.120202, "o", "\u001b[?2004h> "]
[49.120432, "o", "def policyDigit (word : Nat) (position : Nat) : Nat :=\r\n\u001b[?2004l\r"]
[49.120461, "o", "\u001b[?2004h> "]
[49.120612, "o", "  (word / (65536 ^ position)) % 65536\r\n\u001b[?2004l\r"]
[49.120646, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[49.120669, "o", "> "]
[49.120832, "o", "def policyClamp (a limit : Nat) : Nat :=\r\n\u001b[?2004l\r"]
[49.120914, "o", "\u001b[?2004h> "]
[49.121012, "o", "  if a < limit then a else limit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.121044, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.121247, "o", "def policyIndex (amount fee : UInt64) : Nat :=\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.121277, "o", "> "]
[49.121416, "o", "  let f0 := policyDigit fee.toNat 0\r\n\u001b[?2004l\r"]
[49.121493, "o", "\u001b[?2004h> "]
[49.121595, "o", "  let f1 := policyDigit fee.toNat 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.121631, "o", "> "]
[49.121824, "o", "  let f2 := policyDigit fee.toNat 2\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.121867, "o", "> "]
[49.122014, "o", "  let f3 := policyDigit fee.toNat 3\r\n\u001b[?2004l\r"]
[49.123282, "o", "\u001b[?2004h>   let d0 := policyClamp (policyDigit amount.toNat 0) f0\r\n\u001b[?2004l\r\u001b[?2004h>   let d1 := policyClamp (policyDigit amount.toNat 1) f1\r\n\u001b[?2004l\r\u001b[?2004h>   let d2 := policyClamp (policyDigit amount.toNat 2) f2\r\n\u001b[?2004l\r\u001b[?2004h>   let d3 := policyClamp (policyDigit amount.toNat 3) f3\r\n\u001b[?2004l\r\u001b[?2004h>   d0 * ((f1 + 1) * ((f2 + 1) * (f3 + 1))) +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.123481, "o", "    d1 * ((f2 + 1) * (f3 + 1)) + d2 * (f3 + 1) + d3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[49.123513, "o", "\u001b[?2004h> "]
[49.123704, "o", "def policyDebit (amount fee : UInt64) : Nat :=\r\n\u001b[?2004l\r"]
[49.123733, "o", "\u001b[?2004h> "]
[49.12394, "o", "  amount.toNat / 2 + policyIndex amount fee / 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.123977, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
