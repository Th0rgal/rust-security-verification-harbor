[35.177475, "o", "import SecurityChallenge\r\nopen SecurityChallenge\r\n-- Define candidateSpec in Spec.lean and verdict in Audit.lean.\r\n-- Proof.lean is a proof term with exact type:\r\n-- SecurityChallenge.AuditClaim candidateSpec verdict\r\n"]
