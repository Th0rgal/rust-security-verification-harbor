[158.925595, "i", "cat > Test.lean <<'EOF'\nimport SecurityChallenge\nimport Std.Tactic\nopen SecurityChallenge\nset_option maxRecDepth 4096\nset_option maxHeartbeats 2000000\nset_option linter.unusedSimpArgs false\n\ntheorem pack_nat (a f : UInt64) :\n  (packTranscript a f).toNat = 4294967296 * (f.toNat % 2013265921) + a.toNat % 4294967296 := by\n  have ha := Nat.mod_lt a.toNat (by decide : 0 < 4294967296)\n  have hf := Nat.mod_lt f.toNat (by decide : 0 < 2013265921)\n  simp [packTranscript, limbBase, babyBearP, UInt64.toNat_ofNat]\n  omega\n\ntheorem quotient_nat (x : UInt64) :\n  (montyQuotient x).toNat = (2281701377 * (x.toNat % 4294967296)) % 4294967296 := by\n  have hx := Nat.mod_lt x.toNat (by decide : 0 < 4294967296)\n  simp only [montyQuotient, UInt64.toNat_mul, UInt64.toNat_mod,\n    babyBearMu, limbBase, UInt64.toNat_ofNat]\n  simp\n\ntheorem inverse_low (x : Nat) :\n  (2013265921 * ((2281701377 * (x % 4294967296)) % 4294967296)) % 4294967296 = x % 4294967296 := by\n  rw [Nat.mul_mod, Nat.mod_mod, ← Nat.mul_mod, ← Nat.mul_assoc]\n  rw [Nat.mul_mod]\n  simp\n\ntheorem reduce_bounds (x : UInt64) (hx : x.toNat < 8646911288846319616) :\n  (montyReduce x).toNat < 2013265921 ∧\n  ((montyReduce x).toNat * 4294967296) % 2013265921 = x.toNat % 2013265921 := by\n  have ht := Nat.mod_lt (2281701377 * (x.toNat % 4294967296)) (by decide : 0 < 4294967296)\n  have hlow := inverse_low x.toNat\n  have hu : (babyBearP * montyQuotient x).toNat =\n      2013265921 * ((2281701377 * (x.toNat % 4294967296)) % 4294967296) := by\n    simp only [UInt64.toNat_mul, quotient_nat, babyBearP, UInt64.toNat_ofNat]\n    simp\n    omega\n  unfold montyReduce\n  dsimp only\n  split <;>\n    simp only [UInt64.toNat_sub, UInt64.toNat_add, UInt64.toNat_div,\n      UInt64.lt_iff_toNat_lt, hu, babyBearP, limbBase, UInt64.toNat_ofNat] at * <;>\n    simp at * <;> omega\nEOF\nlean Test.lean\n"]
