[184.438506, "i", "python3 - <<'PY'\np='Test.lean';s=open(p).read();s=s[:s.index('theorem reduce_bounds')];s+='''theorem nat_reduce (x t : Nat) (hx : x < 8646911288846319616)\n    (ht : t < 4294967296)\n    (hlow : (2013265921 * t) % 4294967296 = x % 4294967296) :\n    let hi := (18446744073709551616 - 2013265921 * t + x) % 18446744073709551616 / 4294967296\n    let z := if x < 2013265921 * t then\n      (18446744069414584320 + (2013265921 + hi)) % 18446744073709551616 else hi\n    z < 2013265921 ∧ (z * 4294967296) % 2013265921 = x % 2013265921 := by\n  dsimp only\n  split <;> omega\n''';open(p,'w').write(s)\nPY\nlean Test.lean\n"]
