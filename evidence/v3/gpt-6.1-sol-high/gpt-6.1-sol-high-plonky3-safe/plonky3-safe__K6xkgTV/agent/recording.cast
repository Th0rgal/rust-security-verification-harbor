[35.297018, "o", "34:  theorem zero_def : (0 : $typeName) = ⟨0⟩ := (rfl)\r\n35:  theorem one_def : (1 : $typeName) = ⟨1⟩ := (rfl)\r\n36:  theorem sub_def (a b : $typeName) : a - b = ⟨a.toBitVec - b.toBitVec⟩ := (rfl)\r\n37:  theorem mul_def (a b : $typeName) : a * b = ⟨a.toBitVec * b.toBitVec⟩ := (rfl)\r\n38:  theorem mod_def (a b : $typeName) : a % b = ⟨a.toBitVec % b.toBitVec⟩ := (rfl)\r\n39:  theorem add_def (a b : $typeName) : a + b = ⟨a.toBitVec + b.toBitVec⟩ := (rfl)\r\n41:  @[simp] theorem toNat_ofBitVec : (ofBitVec a).toNat = a.toNat := (rfl)\r\n43:  @[simp] theorem toNat_ofNat' {n : Nat} : (ofNat n).toNat = n % 2 ^ $bits := BitVec.toNat_ofNat ..\r\n46:  theorem toNat_ofNat {n : Nat} : toNat (no_index (OfNat.ofNat n)) = n % 2 ^ $bits := toNat_ofNat'\r\n48:  @[simp] theorem toNat_ofNatLT {n : Nat} {h : n < size} : (ofNatLT n h).toNat = n := BitVec.toNat_ofNatLT ..\r\n50:  @[simp] theorem toFin_val (x : $typeName) : x.toFin.val = x.toNat := (rfl)\r\n52:  @[simp] theorem toNat_toBitVec (x : $typeName) : x.toBitVec.toNat = x.toNat := (rfl)\r\n53:  @[simp] theorem toFin_toBitVec (x : $typeName) : x.toBitVec.toFin = x.toFin := (rfl)\r\n55:  @[simp] theorem ofBitVec_toBitVec : ∀ (a : $typeName), ofBitVec a.toBitVec = a\r\n58:  theorem toBitVec_ofNat' (n : Nat) : (ofNat n).toBitVec = BitVec.ofNat _ n := (rfl)\r\n60:  theorem toNat_ofNat_of_lt' {n : Nat} (h : n < size) : (ofNat n).toNat = n := by\r\n61:    rw [toNat, toBitVec_ofNat', BitVec.toNat_ofNat, Nat.mod_eq_of_lt h]\r\n62:  theorem toNat_ofNat_of_lt {n : Nat} (h : n < size) : toNat (OfNat.ofNat n) = n :=\r\n63:    toNat_ofNat_of_lt' h\r\n65:  @[int_toBitVec] theorem le_iff_toBitVec_le {a b : $typeName} : a ≤ b ↔ a.toBitVec ≤ b.toBitVec := .rfl\r\n67:  @[int_toBitVec] theorem lt_iff_toBitVec_lt {a b : $typeName} : a < b ↔ a.toBitVec < b.toBitVec := .rfl\r\n69:  theorem le_iff_toNat_le {a b : $typeName} : a ≤ b ↔ a.toNat ≤ b.toNat := .rfl\r\n71:  theorem lt_iff_toNat_lt {a b : $typeName} : a < b ↔ a.toNat < b.toNat := .rfl\r\n73:  @[simp] protected theorem not_le {a b : $typeName} : ¬ a ≤ b ↔ b < a := by\r\n76:  @[simp] protected theorem not_lt {a b : $typeName} : ¬ a < b ↔ b ≤ a := by\r\n79:  @[simp] protected theorem le_refl (a : $typeName) : a ≤ a := by simp [le_iff_toBitVec_le]\r\n"]
[35.297064, "o", "82:  protected theorem le_rfl {a : $typeName} : a ≤ a := le_refl _\r\n84:  @[simp] protected theorem lt_irrefl (a : $typeName) : ¬ a < a := by simp\r\n86:  protected theorem le_trans {a b c : $typeName} : a ≤ b → b ≤ c → a ≤ c := BitVec.le_trans\r\n88:  protected theorem lt_trans {a b c : $typeName} : a < b → b < c → a < c := BitVec.lt_trans\r\n90:  protected theorem le_total (a b : $typeName) : a ≤ b ∨ b ≤ a := BitVec.le_total ..\r\n92:  protected theorem lt_asymm {a b : $typeName} : a < b → ¬ b < a := BitVec.lt_asymm\r\n94:  protected theorem toBitVec_eq_of_eq {a b : $typeName} (h : a = b) : a.toBitVec = b.toBitVec := h ▸ rfl\r\n"]
[35.297094, "o", "96:  protected theorem eq_of_toBitVec_eq {a b : $typeName} (h : a.toBitVec = b.toBitVec) : a = b := by\r\n100:  protected theorem toBitVec_inj {a b : $typeName} : a.toBitVec = b.toBitVec ↔ a = b :=\r\n105:  protected theorem eq_iff_toBitVec_eq {a b : $typeName} : a = b ↔ a.toBitVec = b.toBitVec :=\r\n"]
