[63.709953, "i", "cat > /workspace/submission/Spec.lean <<'EOF'\nimport SecurityChallenge\n\n-- Exact settlement arithmetic; neither the product nor the debit wraps.\ndef settlementDebit (amount fee : UInt64) : Nat :=\n  amount.toNat +\n    (((amount.toNat % 4294967296 + (fee.toNat % 2013265921) * 4294967296)\n       * 943718400) % 2013265921)\n\ndef candidateSpec : SecurityChallenge.AuthorizationSpec where\n  accepts balance amount fee := settlementDebit amount fee ≤ balance.toNat\n  output _ amount fee totalDebit := totalDebit.toNat = settlementDebit amount fee\nEOF\ncat > /workspace/submission/Audit.lean <<'EOF'\nimport SecurityChallenge\n\ndef verdict : SecurityChallenge.AuditVerdict := .safe\nEOF\ncat > /workspace/lean/Test.lean <<'EOF'\nimport SecurityChallenge\nimport Std.Tactic\nopen SecurityChallenge\nset_option maxRecDepth 4096\nset_option maxHeartbeats 2000000\nexample (a f : UInt64) :\n    (montyReduce (packTranscript a f)).toNat =\n    (((a.toNat % 4294967296 + (f.toNat % 2013265921) * 4294967296) * 943718400) % 2013265921) := by\n  unfold montyReduce montyQuotient packTranscript\n  simp only [UInt64.toNat_add, UInt64.toNat_mul, UInt64.toNat_mod,\n    UInt64.toNat_div, UInt64.toNat_sub, UInt64.lt_iff_toNat_lt,\n    babyBearP, babyBearMu, limbBase, UInt64.toNat_ofNat]\n  split <;> simp only [UInt64.toNat_add, UInt64.toNat_sub, UInt64.toNat_div,\n    babyBearP, limbBase, UInt64.toNat_ofNat] <;> omega\nEOF\ncd /workspace/lean && lean Test.lean\n"]
