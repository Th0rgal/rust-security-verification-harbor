[315.103113, "i", "cat >> Test.lean <<'EOF'\n\ntheorem reduce_bounds (x : UInt64) (hx : x.toNat < 8646911288846319616) :\n  (montyReduce x).toNat < 2013265921 ∧\n  ((montyReduce x).toNat * 4294967296) % 2013265921 = x.toNat % 2013265921 := by\n  have ht : (montyQuotient x).toNat < 4294967296 := by\n    rw [quotient_nat]\n    exact Nat.mod_lt _ (by decide)\n  have hl : (2013265921 * (montyQuotient x).toNat) % 4294967296 = x.toNat % 4294967296 := by\n    rw [quotient_nat]\n    exact inverse_low _\n  have hu : (babyBearP * montyQuotient x).toNat = 2013265921 * (montyQuotient x).toNat := by\n    simp only [UInt64.toNat_mul, babyBearP, UInt64.toNat_ofNat]\n    simp\n    omega\n  have h := nat_reduce x.toNat (montyQuotient x).toNat hx ht hl\n  unfold montyReduce\n  dsimp only at h ⊢\n  split <;>\n    simp only [UInt64.toNat_sub, UInt64.toNat_add, UInt64.toNat_div,\n      UInt64.lt_iff_toNat_lt, hu, babyBearP, limbBase, UInt64.toNat_ofNat] at * <;>\n    simp at * <;> exact h\n\ntheorem invert_residue (x z : Nat) (hz : z < 2013265921)\n    (h : (z * 4294967296) % 2013265921 = x % 2013265921) :\n    z = (x * 943718400) % 2013265921 := by\n  have hh := congrArg (fun n : Nat => (n * 943718400) % 2013265921) h\n  simp only [Nat.mod_mul_mod] at hh\n  rw [Nat.mul_assoc, Nat.mul_mod] at hh\n  simp at hh\n  omega\n\ntheorem surcharge_nat (a f : UInt64) :\n    (montyReduce (packTranscript a f)).toNat =\n    ((a.toNat % 4294967296 + (f.toNat % 2013265921) * 4294967296) * 943718400) % 2013265921 := by\n  have ha := Nat.mod_lt a.toNat (by decide : 0 < 4294967296)\n  have hf := Nat.mod_lt f.toNat (by decide : 0 < 2013265921)\n  have hx : (packTranscript a f).toNat < 8646911288846319616 := by rw [pack_nat]; omega\n  have h := reduce_bounds (packTranscript a f) hx\n  have hi := invert_residue _ _ h.1 h.2\n  rw [pack_nat] at hi\n  simpa [Nat.mul_comm, Nat.add_comm] using hi\nEOF\nlean Test.lean\n"]
[315.103433, "o", "cat >> Test.lean <<'EOF'\r\n\u001b[?2004l\r"]
