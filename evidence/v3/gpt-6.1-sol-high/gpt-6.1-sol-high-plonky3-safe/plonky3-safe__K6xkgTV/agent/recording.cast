[315.106483, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   ((montyReduce x).toNat * 4294967296) % 2013265921 = x.toNat % 2013265921 := by\r\n\u001b[?2004l\r\u001b[?2004h>   have ht : (montyQuotient x).toNat < 4294967296 := by\r\n\u001b[?2004l\r\u001b[?2004h>     rw [quotient_nat]\r\n\u001b[?2004l\r\u001b[?2004h>     exact Nat.mod_lt _ (by decide)\r\n\u001b[?2004l\r\u001b[?2004h>   have hl : (2013265921 * (montyQuotient x).toNat) % 4294967296 = x.toNat % 4294967296 := by\r\n\u001b[?2004l\r\u001b[?2004h>     rw [quotient_nat]\r\n\u001b[?2004l\r\u001b[?2004h>     exact inverse_low _\r\n\u001b[?2004l\r\u001b[?2004h>   have hu : (babyBearP * montyQuotient x).toNat = 2013265921 * (montyQuotient x).toNat := by\r\n\u001b[?2004l\r\u001b[?2004h>     simp only [UInt64.toNat_mul, babyBearP, UInt64.toNat_ofNat]\r\n\u001b[?2004l\r\u001b[?2004h>     simp\r\n\u001b[?2004l\r\u001b[?2004h>     omega\r\n\u001b[?2004l\r\u001b[?2004h>   have h := nat_reduce x.toNat (montyQuotient x).toNat hx ht hl\r\n\u001b[?2004l\r\u001b[?2004h>   unfold montyReduce\r\n\u001b[?2004l\r\u001b[?2004h>   dsimp only at h ⊢\r\n\u001b[?2004l\r\u001b[?2004h>   split <;>\r\n\u001b[?2004l\r\u001b[?2004h> "]
