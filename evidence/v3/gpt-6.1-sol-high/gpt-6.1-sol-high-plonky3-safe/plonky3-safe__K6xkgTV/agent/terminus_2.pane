[?2004l[?2004h>        * 943718400) % 2013265921)
[?2004l[?2004h> 
[?2004l[?2004h> def candidateSpec : SecurityChallenge.AuthorizationSpec where
[?2004l[?2004h>   accepts balance amount fee := settlementDebit amount fee ≤ balance.toNat
