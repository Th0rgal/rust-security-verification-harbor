[82.771651, "i", "grep -nE 'toNat_(and|shift)|shift.*toNat' /opt/lean/src/lean/Init/Data/UInt/Lemmas.lean; grep -R -nE 'theorem.*(and_two_pow|and.*sub_one|and.*ones)' /opt/lean/src/lean/Init/Data/Nat/ | head -30; sed -n '120,150p' /opt/lean/src/lean/Init/Data/UInt/Lemmas.lean; grep -nE 'toNat.*(shift|and)' /opt/lean/src/lean/Init/Data/BitVec/Lemmas.lean | head -30\n"]
