[82.779613, "o", "\r\n"]
[82.781495, "o", "\r\n  open $typeName (toBitVec_eq_of_eq) in\r\n  protected theorem ne_of_toBitVec_ne {a b : $typeName} (h : a.toBitVec ≠ b.toBitVec) : a ≠ b :=\r\n    fun h' => absurd (toBitVec_eq_of_eq h') h\r\n\r\n  open $typeName (ne_of_toBitVec_ne toBitVec_ne_of_ne) in\r\n  @[int_toBitVec]\r\n  protected theorem ne_iff_toBitVec_ne {a b : $typeName} : a ≠ b ↔ a.toBitVec ≠ b.toBitVec :=\r\n    Iff.intro toBitVec_ne_of_ne ne_of_toBitVec_ne\r\n\r\n  open $typeName (ne_of_toBitVec_ne) in\r\n  protected theorem ne_of_lt {a b : $typeName} (h : a < b) : a ≠ b := by\r\n    apply ne_of_toBitVec_ne\r\n"]
[82.781682, "o", "    apply BitVec.ne_of_lt\r\n    simpa [lt_iff_toBitVec_lt] using h\r\n\r\n  @[simp] protected theorem toNat_zero : (0 : $typeName).toNat = 0 := Nat.zero_mod _\r\n\r\n  @[simp] protected theorem toNat_add (a b : $typeName) : (a + b).toNat = (a.toNat + b.toNat) % 2 ^ $bits := BitVec.toNat_add ..\r\n\r\n  protected theorem toNat_sub (a b : $typeName) : (a - b).toNat = (2 ^ $bits - b.toNat + a.toNat) % 2 ^ $bits := BitVec.toNat_sub  ..\r\n\r\n  @[simp] protected theorem toNat_mul (a b : $typeName) : (a * b).toNat = a.toNat * b.toNat % 2 ^ $bits := BitVec.toNat_mul  ..\r\n\r\n  @[simp] protected theorem toNat_mod (a b : $typeName) : (a % b).toNat = a.toNat % b.toNat := BitVec.toNat_umod ..\r\n\r\n  @[simp] protected theorem toNat_div (a b : $typeName) : (a / b).toNat = a.toNat / b.toNat := BitVec.toNat_udiv  ..\r\n\r\n  @[simp] protected theorem toNat_sub_of_le (a b : $typeName) : b ≤ a → (a - b).toNat = a.toNat - b.toNat := BitVec.toNat_sub_of_le\r\n\r\n  protected theorem toNat_lt_size (a : $typeName) : a.toNat < size := a.toBitVec.isLt\r\n"]
[82.786794, "o", "598:-- Activate `toInt_eq_toNat_of_msb` if we have already seen both `x.toInt` and `x.toNat`\r\n1456:@[simp, grind =] theorem toNat_and (x y : BitVec v) :\r\n1461:  rw_mod_cast [Int.bmod_def, BitVec.toInt, toNat_and, Nat.mod_eq_of_lt\r\n1552:  eq_of_toNat_eq (by simp [Nat.and_mod_two_pow])\r\n1856:@[simp, bitvec_to_nat, grind =] theorem toNat_shiftLeft {x : BitVec v} :\r\n1862:  rw [toInt_eq_toNat_bmod, toNat_shiftLeft, Nat.shiftLeft_eq]\r\n1880:  simp only [toNat_shiftLeft, Nat.testBit_mod_two_pow, Nat.testBit_shiftLeft, ge_iff_le]\r\n1888:  simp only [toNat_shiftLeft, Nat.testBit_mod_two_pow, Nat.testBit_shiftLeft, ge_iff_le]\r\n1931:  · simp only [toNat_ofNatLT, toNat_shiftLeft, toNat_setWidth']\r\n1938:theorem toNat_shiftLeftZeroExtend {x : BitVec w} :\r\n1942:  · simp only [shiftLeftZeroExtend_eq, toNat_shiftLeft, toNat_setWidth]\r\n1993:    rw [shiftLeftZeroExtend_eq, toFin_shiftLeft, toNat_setWidth, Nat.mod_eq_of_lt (by omega), Nat.shiftLeft_eq]\r\n2076:@[simp, bitvec_to_nat, grind =] theorem toNat_ushiftRight (x : BitVec n) (i : Nat) :\r\n2085:  simp [getElem_eq_testBit_toNat, toNat_ushiftRight, Nat.testBit_shiftRight, getLsbD]\r\n2113:theorem toNat_ushiftRight_lt (x : BitVec w) (n : Nat) (hn : n ≤ w) :\r\n2115:  rw [toNat_ushiftRight, Nat.shiftRight_eq_div_pow, Nat.div_lt_iff_lt_mul]\r\n2125:  simp only [toNat_eq, toNat_ushiftRight, toNat_ofNat, Nat.zero_mod]\r\n2137:  simp only [toNat_ushiftRight, ite_eq_left_iff, Nat.not_lt]\r\n2140:  · have h1 := Nat.mul_lt_mul_of_pos_left (toNat_ushiftRight_lt x n hn) Nat.two_pos\r\n2141:    simp only [toNat_ushiftRight, Nat.zero_lt_succ, Nat.mul_lt_mul_left] at h1\r\n2221:  simp [BitVec.toNat_eq, Nat.shiftRight_eq_div_pow, Nat.lt_two_pow_self, Nat.div_eq_of_lt]\r\n2237:  simp only [hxbound, ↓reduceIte, toNat_ushiftRight]\r\n2257:    simp only [hxbound, ↓reduceIte, toNat_ofInt, toNat_not, toNat_ushiftRight]\r\n2407:theorem toNat_sshiftRight_of_msb_true {x : BitVec w} {n : Nat} (h : x.msb = true) :\r\n2411:theorem toNat_sshiftRight_of_msb_false {x : BitVec w} {n : Nat} (h : x.msb = false) :\r\n2415:theorem toNat_sshiftRight {x : BitVec w} {n : Nat} :\r\n2421:  · simp [toNat_sshiftRight_of_msb_true, h]\r\n2423:    simp [toNat_sshiftRight_of_msb_false, h]\r\n2428:  simp only [val_toFin, toNat_sshiftRight, h, ↓reduceIte, Fin.val_ofNat]\r\n2437:  simp only [val_toFin, toNat_sshiftRight, h, Bool.false_eq_true, ↓reduceIte, Fin.val_ofNat]\r\n"]
