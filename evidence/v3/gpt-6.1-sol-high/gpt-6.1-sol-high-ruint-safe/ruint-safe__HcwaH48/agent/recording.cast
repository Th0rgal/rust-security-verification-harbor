[29.03376, "i", "python3 - <<'PY'\nimport random\nD=32771; B=65536\nrandom.seed(0)\ndef test(u1,u0):\n    qfull=u1*65524+u1*B+u0+B\n    q1=qfull>>16; q0=qfull&65535\n    r=(0xC0000000+u0-q1*D)&65535\n    qc,rc=(q1-1,(r+D)&65535) if q0<r else (q1,r)\n    q=qc+1 if rc>=D else qc\n    expected=(u1*B+u0)//D\n    if q!=expected:\n        print('MISMATCH',u1,u0,'got',q,'expected',expected,'q0',q0,'r',r,'q1',q1)\n        return True\n    return False\nfor u1 in [0,1,2,D//2,D-2,D-1]:\n    for u0 in range(B):\n        if test(u1,u0): raise SystemExit\nfor _ in range(2000000):\n    if test(random.randrange(D),random.randrange(B)): break\nelse: print('No mismatch in sampled inputs')\nPY\n"]
[29.03624, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import random\r\n\u001b[?2004l\r\u001b[?2004h> D=32771; B=65536\r\n\u001b[?2004l\r\u001b[?2004h> random.seed(0)\r\n\u001b[?2004l\r\u001b[?2004h> def test(u1,u0):\r\n\u001b[?2004l\r\u001b[?2004h>     qfull=u1*65524+u1*B+u0+B\r\n\u001b[?2004l\r\u001b[?2004h>     q1=qfull>>16; q0=qfull&65535\r\n\u001b[?2004l\r\u001b[?2004h>     r=(0xC0000000+u0-q1*D)&65535\r\n\u001b[?2004l\r\u001b[?2004h>     qc,rc=(q1-1,(r+D)&65535) if q0<r else (q1,r)\r\n\u001b[?2004l\r\u001b[?2004h>     q=qc+1 if rc>=D else qc\r\n\u001b[?2004l\r\u001b[?2004h>     expected=(u1*B+u0)//D\r\n\u001b[?2004l\r\u001b[?2004h>     if q!=expected:\r\n\u001b[?2004l\r\u001b[?2004h>         print('MISMATCH',u1,u0,'got',q,'expected',expected,'q0',q0,'r',r,'q1',q1)\r\n\u001b[?2004l\r\u001b[?2004h>         return True"]
