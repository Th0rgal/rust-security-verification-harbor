[138.390622, "o", "\r\n46:  theorem toNat_ofNat {n : Nat} : toNat (no_index (OfNat.ofNat n)) = n % 2 ^ $bits := toNat_ofNat'\r\n48:  @[simp] theorem toNat_ofNatLT {n : Nat} {h : n < size} : (ofNatLT n h).toNat = n := BitVec.toNat_ofNatLT ..\r\n52:  @[simp] theorem toNat_toBitVec (x : $typeName) : x.toBitVec.toNat = x.toNat := (rfl)\r\n60:  theorem toNat_ofNat_of_lt' {n : Nat} (h : n < size) : (ofNat n).toNat = n := by\r\n61:    rw [toNat, toBitVec_ofNat', BitVec.toNat_ofNat, Nat.mod_eq_of_lt h]\r\n62:  theorem toNat_ofNat_of_lt {n : Nat} (h : n < size) : toNat (OfNat.ofNat n) = n :=\r\n63:    toNat_ofNat_of_lt' h\r\n156:    · rw [toNat_mod, toNat_ofNat_of_lt' h2]\r\n250:@[simp] theorem USize.toNat_ofNat32 {n : Nat} {h : n < 4294967296} : (ofNat32 n h).toNat = n := (rfl)\r\n257:theorem USize.toNat_ofNat_of_lt_32 {n : Nat} (h : n < 4294967296) : toNat (ofNat n) = n :=\r\n258:  toNat_ofNat_of_lt (Nat.lt_of_lt_of_le h USize.le_size)\r\n279:  rw [lt_iff_toNat_lt, toNat_ofNat_of_lt' h]\r\n281:  rw [lt_iff_toNat_lt, toNat_ofNat_of_lt' h]"]
