t/Div/Lemmas.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K225\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktheorem mod_mod_of_dvd\u001b[m\u001b[K' {a b c : Nat} (h : b ∣ c) : a % b % c = a % b := by\r\n\u001b[35m\u001b[K/opt/lean/src/lean/Init/Data/Nat/Div/Lemmas.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K228\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktheorem mod_mod\u001b[m\u001b[K_eq_mod_mod_mod_of_dvd {a b c : Nat} (hb : b ∣ c) :\r\ngrep: /opt/lean/src/lean/Init/Data/Nat/Mod/Lemmas.lean: No such file or directory\r\n"]
[344.991344, "o", "/opt/lean/src/lean/Init/Data/Nat/Div/Basic.lean:128:protected theorem modCore_eq (x y : Nat) : Nat.modCore x y =\r\n/opt/lean/src/lean/Init/Data/Nat/Div/Basic.lean:146:protected theorem modCore_eq_mod (n m : Nat) : Nat.modCore n m = n % m := by\r\n/opt/lean/src/lean/Init/Data/Nat/Div/Basic.lean:197:theorem mod_eq_sub_mod {a b : Nat} (h : a ≥ b) : a % b = (a - b) % b :=\r\n/opt/lean/src/lean/Init/Data/Nat/Div/Basic.lean:202:@[simp] protected theorem sub_mod_add_mod_cancel (a b : Nat) [NeZero a] : a - b % a + b % a = a := by\r\n/opt/lean/src/lean/Init/Data/Nat/Div/Basic.lean:256:theorem mod_eq_sub_mul_div {x k : Nat} : x % k = x - k * (x / k) := mod_def _ _\r\n/opt/lean/src/lean/Init/Data/Nat/Div/Lemmas.lean:26:theorem mod_add_mod_lt (a b : Nat) {c : Nat} (h : 0 < c) : a % c + b % c < 2 * c - 1 := by\r\n/opt/lean/src/lean/Init/Data/Nat/Div/Lemmas.lean:31:theorem mod_add_mod_eq {a b c : Nat} : a % c + b % c = (a + b) % c + if a % c + b % c < c then 0 else c := by\r\n/opt/lean/src/lean/Init/Data/Nat/Div/Lemmas.lean:185:theorem mod_add_mod_lt_of_add_mod_eq_sub_one (w : 0 < c) (h : (a + b) % c = c - 1) : a % c + b % c < c := by\r\n/opt/lean/src/lean/Init/Data/Nat/Div/Lemmas.lean:209:theorem div_mod_eq_mod_div_mod {a b c : Nat} (ha : a < c) (hb : b < c) :\r\n/opt/lean/src/lean/Init/Data/Nat/Div/Lemmas.lean:213:theorem mod_mod_eq_mod_of_lt_right {a b c : Nat} (ha : a < c) : (a % b) % c = a % b :=\r\n/opt/lean/src/lean/Init/Data/Nat/Div/Lemmas.lean:216:theorem mod_mod_eq_mod_mod_mod {a b c : Nat} (ha : a < c) (hb : b < c) :\r\n/opt/lean/src/lean/Init/Data/Nat/Div/Lemmas.lean:220:theorem mod_mod_eq_mod_mod_of_dvd {a b c : Nat} (h : b ∣ c) : a % b % c = a % c % b := by\r\n/opt/lean/src/lean/Init/Data/Nat/Div/Lemmas.lean:225:theorem mod_mod_of_dvd' {a b c : Nat} (h : b ∣ c) : a % b % c = a % b := by\r\n/opt/lean/src/lean/Init/Data/Nat/Div/Lemmas.lean:228:theorem mod_mod_eq_mod_mod_mod_of_dvd {a b c : Nat} (hb : b ∣ c) :\r\n/opt/lean/src/lean/Init/Data/Nat/Div