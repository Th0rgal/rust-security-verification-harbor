[318.016581, "o", "     8\t    change x.toNat &&& (2^16 - 1) = _\r\n     9\t    rw [Nat.and_two_pow_sub_one_eq_mod]\r\n    10\t  have shrNat (x : UInt64) (n : UInt64) :\r\n    11\t      (x >>> n).toNat = x.toNat / 2^(n.toNat % 64) := by\r\n    12\t    change (x.toBitVec >>> (n.toNat % 64)).toNat = _\r\n    13\t    rw [BitVec.toNat_ushiftRight, Nat.shiftRight_eq_div_pow]\r\n    14\t    rfl\r\n    15\t  have shlNat (x : UInt64) (n : UInt64) :\r\n    16\t      (x <<< n).toNat = (x.toNat * 2^(n.toNat % 64)) % 2^64 := by\r\n    17\t    change (x.toBitVec <<< (n.toNat % 64)).toNat = _\r\n    18\t    rw [BitVec.toNat_shiftLeft, Nat.shiftLeft_eq]\r\n    19\t    rfl\r\n    20\t  have divCorrect (u1 u0 : UInt64) (h1 : u1.toNat < 32771) (h0 : u0.toNat < 65536) :\r\n    21\t      (div2x1Mg10 u1 u0).toNat = (u1.toNat * 65536 + u0.toNat) / 32771 := by\r\n    22\t    have hFull : u1.toNat * 65524 + u1.toNat * 65536 + u0.toNat + 65536 < 18446744073709551616 := by omega\r\n    23\t    have hQ : (u1.toNat * 65524 + u1.toNat * 65536 + u0.toNat + 65536) / 65536 ≤ 65535 := by omega\r\n    24\t    have hQpos : 1 ≤ (u1.toNat * 65524 + u1.toNat * 65536 + u0.toNat + 65536) / 65536 := by omega\r\n    25\t    have hProd : (u1.toNat * 65524 + u1.toNat * 65536 + u0.toNat + 65536) / 65536 * 32771 < 18446744073709551616 := by\r\n    26\t      exact lt_of_le_of_lt (Nat.mul_le_mul_right 32771 hQ) (by decide)\r\n    27\t    unfold div2x1Mg10\r\n    28\t    dsimp only\r\n    29\t    split <;> split <;>\r\n    30\t      simp only [UInt64.toNat_add, UInt64.toNat_mul, UInt64.toNat_sub,\r\n    31\t        maskNat, shrNat, shlNat, UInt64.lt_iff_toNat_lt, UInt64.le_iff_toNat_le,\r\n    32\t        mg10Divisor, mg10Reciprocal, limbMask, subBias] at *\r\n    33\t    all_goals try simp only [UInt64.toNat_ofNat, Nat.reduceMod, Nat.reducePow, Nat.one_mul] at *\r\n    34\t    have unwrap (n : Nat) (h : n < 18446744073709551616) : n % 18446744073709551616 = n := Nat.mod_eq_of_lt h\r\n    35\t    all_goals simp (d