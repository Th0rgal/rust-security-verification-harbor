[67.76192, "o", "at_lt = n := (rfl)\r\n488:@[simp] theorem UInt64.ofNatLT_uInt32ToNat (n : UInt32) : UInt64.ofNatLT n.toNat (Nat.lt_trans n.toNat_lt (by decide)) = n.toUInt64 := (rfl)\r\n489:@[simp] theorem USize.ofNatLT_uInt32ToNat (n : UInt32) : USize.ofNatLT n.toNat n.toNat_lt_usizeSize = n.toUSize := (rfl)\r\n491:@[simp] theorem UInt64.ofNatLT_toNat (n : UInt64) : UInt64.ofNatLT n.toNat n.toNat_lt = n := (rfl)\r\n493:@[simp] theorem USize.ofNatLT_toNat (n : USize) : USize.ofNatLT n.toNat n.toNat_lt_size = n := (rfl)\r\n494:@[simp] theorem UInt64.ofNatLT_uSizeToNat (n : USize) : UInt64.ofNatLT n.toNat n.toNat_lt = n.toUInt64 := (rfl)\r\n663:  rw [UInt8.ofNatClamp_eq_ofNat] <;> simp [n.toNat_lt]\r\n667:  exact Nat.lt_trans (n.toNat_lt) (by decide)\r\n669:  rw [UInt16.ofNatClamp_eq_ofNat] <;> simp [n.toNat_lt]\r\n673:  exact Nat.lt_trans (n.toNat_lt) (by decide)\r\n676:  exact Nat.lt_trans (n.toNat_lt) (by decide)\r\n678:  rw [UInt32.ofNatClamp_eq_ofNat] <;> simp [n.toNat_lt]\r\n682:  exact Nat.lt_trans (n.toNat_lt) (by decide)\r\n"]
