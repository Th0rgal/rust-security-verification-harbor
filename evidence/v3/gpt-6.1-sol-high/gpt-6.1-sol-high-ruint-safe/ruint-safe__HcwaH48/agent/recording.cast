[67.761756, "o", "65:  @[int_toBitVec] theorem le_iff_toBitVec_le {a b : $typeName} : a ≤ b ↔ a.toBitVec ≤ b.toBitVec := .rfl\r\n67:  @[int_toBitVec] theorem lt_iff_toBitVec_lt {a b : $typeName} : a < b ↔ a.toBitVec < b.toBitVec := .rfl\r\n69:  theorem le_iff_toNat_le {a b : $typeName} : a ≤ b ↔ a.toNat ≤ b.toNat := .rfl\r\n71:  theorem lt_iff_toNat_lt {a b : $typeName} : a < b ↔ a.toNat < b.toNat := .rfl\r\n74:    simp [le_iff_toBitVec_le, lt_iff_toBitVec_lt]\r\n77:    simp [le_iff_toBitVec_le, lt_iff_toBitVec_lt]\r\n79:  @[simp] protected theorem le_refl (a : $typeName) : a ≤ a := by simp [le_iff_toBitVec_le]\r\n134:    simpa [lt_iff_toBitVec_lt] using h\r\n138:  @[simp] protected theorem toNat_add (a b : $typeName) : (a + b).toNat = (a.toNat + b.toNat) % 2 ^ $bits := BitVec.toNat_add ..\r\n140:  protected theorem toNat_sub (a b : $typeName) : (a - b).toNat = (2 ^ $bits - b.toNat + a.toNat) % 2 ^ $bits := BitVec.toNat_sub  ..\r\n142:  @[simp] protected theorem toNat_mul (a b : $typeName) : (a * b).toNat = a.toNat * b.toNat % 2 ^ $bits := BitVec.toNat_mul  ..\r\n144:  @[simp] protected theorem toNat_mod (a b : $typeName) : (a % b).toNat = a.toNat % b.toNat := BitVec.toNat_umod ..\r\n148:  @[simp] protected theorem toNat_sub_of_le (a b : $typeName) : b ≤ a → (a - b).toNat = a.toNat - b.toNat := BitVec.toNat_sub_of_le\r\n150:  protected theorem toNat_lt_size (a : $typeName) : a.toNat < size := a.toBitVec.isLt\r\n152:  open $typeName (toNat_mod toNat_lt_size) in\r\n153:  protected theorem toNat_mod_lt {m : Nat} : ∀ (u : $typeName), 0 < m → toNat (u % ofNat m) < m := by\r\n156:    · rw [toNat_mod, toNat_ofNat_of_lt' h2]\r\n159:      · apply toNat_lt_size\r\n163:    simp only [lt_iff_toBitVec_lt, mod_def]\r\n190:  lt_iff _ _ := by\r\n197:    simp [Nat.mod_eq_of_lt x.toNat_lt_size]\r\n279:  rw [lt_iff_toNat_lt, toNat_ofNat_of_lt' h]\r\n280:theorem UInt8.ofNat_lt_iff {n : UInt8} {m : Nat} (h : m < size) : ofNat m < n ↔ m < n.toNat := by\r\n281:  rw [lt_iff_toNat_lt, toNat