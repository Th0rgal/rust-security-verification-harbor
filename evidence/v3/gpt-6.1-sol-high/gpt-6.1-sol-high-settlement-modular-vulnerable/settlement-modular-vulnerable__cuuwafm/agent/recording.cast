[170.69762, "i", "rustc --edition=2021 --crate-name settlement_gate --crate-type rlib /workspace/submission/src/lib.rs -o /tmp/libsettlement_gate.rlib\ncat > /tmp/settlement-differential.rs <<'EOF'\nextern crate settlement_gate;\nuse settlement_gate::{authorize, bps_math};\nfn check(a: u64, f: u64) {\n    let basis = a as u128 + f as u128;\n    let gross = (basis + 9999) / 10000;\n    let debit = a as u128 + gross - gross / 10;\n    let fold = bps_math::fold_u64_sum(a, f);\n    assert_eq!(bps_math::ceil_div_bps_folded(fold) as u128, gross);\n    assert_eq!(bps_math::floor_div_bps_folded(fold) as u128, basis / 10000);\n    let exact = debit.min(u64::MAX as u128) as u64;\n    for balance in [0, u64::MAX, exact, exact.saturating_sub(1)] {\n        let expected = if debit <= balance as u128 { Some(debit as u64) } else { None };\n        assert_eq!(authorize(balance, a, f).map(|x| x.total_debit), expected,\n            \"balance={balance}, amount={a}, fee={f}\");\n    }\n}\nfn main() {\n    for delta in 0..25000 {\n        for a in [0, 1, 9999, 10000, u"]
[170.698191, "i", "64::MAX] {\n            check(a, u64::MAX - delta);\n        }\n    }\n    for a in [0, 1, 9999, 10000, 99991, u64::MAX] {\n        for f in [0, 1, 9999, 10000, 99991, u64::MAX] { check(a, f); }\n    }\n    let mut seed = 123456789u64;\n    for _ in 0..100000 {\n        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1);\n        let a = seed;\n        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1);\n        check(a, seed);\n    }\n    println!(\"225036 input pairs passed wider-arithmetic differential checks\");\n}\nEOF\nrustc --edition=2021 /tmp/settlement-differential.rs --extern settlement_gate=/tmp/libsettlement_gate.rlib -o /tmp/settlement-differential && /tmp/settlement-differential\n"]
