[8.706254, "o", "cat /workspace/challenge/src/lib.rs\r\n\u001b[?2004l\r"]
[8.70713, "o", "#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\npub struct Authorization {\r\n    pub total_debit: u64,\r\n}\r\n\r\npub mod broadword {\r\n    pub const L8: u64 = 0x0101_0101_0101_0101u64;\r\n    pub const H8: u64 = 0x8080_8080_8080_8080u64;\r\n    pub const M16: u64 = 0x00FF_00FF_00FF_00FFu64;\r\n    pub const L16: u64 = 0x0001_0001_0001_0001u64;\r\n\r\n    /// Vigna's SWAR broadword non-zero byte indicator (`tov/succinct-rs` `src/broadword.rs`):\r\n    /// Sets bit `8*i + 7` iff byte `i` of `x` is non-zero.\r\n    #[inline]\r\n    pub fn u_nz8(x: u64) -> u64 {\r\n        ((x | H8) - L8) & H8\r\n    }\r\n\r\n    /// Count non-zero bytes in `x` in parallel using SWAR multiplication by `L8`.\r\n    #[inline]\r\n    pub fn count_nz_bytes(x: u64) -> u64 {\r\n        ((u_nz8(x) >> 7u64).wrapping_mul(L8)) >> 56u64\r\n    }\r\n\r\n    /// Sum all 8 bytes of `x` in parallel using 16-bit lane folding and `L16`.\r\n    #[inline]\r\n    pub fn sum_bytes(x: u64) -> u64 {\r\n"]
[8.707165, "o", "        let pairs: u64 = (x & M16) + ((x >> 8u64) & M16);\r\n        (pairs.wrapping_mul(L16) >> 48u64) & 0xFFFFu64\r\n    }\r\n}\r\n\r\npub mod settlement {\r\n    use crate::Authorization;\r\n    use crate::broadword;\r\n\r\n    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n    pub struct SuccinctQuote {\r\n        pub principal_share: u64,\r\n        pub active_bytes: u64,\r\n        pub byte_sum: u64,\r\n        pub total_debit: u64,\r\n    }\r\n\r\n    #[inline]\r\n    pub fn build_quote(amount: u64, fee: u64) -> Option<SuccinctQuote> {\r\n        let principal_share: u64 = amount >> 1u64;\r\n        let active_bytes: u64 = broadword::count_nz_bytes(fee);\r\n        let byte_sum: u64 = broadword::sum_bytes(fee);\r\n        let total_debit: u64 = principal_share + (active_bytes << 8u64) + byte_sum;"]
[8.70719, "o", "\r\n        Some(SuccinctQuote {\r\n            principal_share,\r\n"]
[8.707744, "o", "            active_bytes,\r\n            byte_sum,\r\n            total_debit,"]
[8.707842, "o", "\r\n        })\r\n    }\r\n\r\n    #[inline]\r\n    pub fn verify_affordability(balance: u64, quote: SuccinctQuote) -> Option<Authorization> {\r\n        if quote.total_debit <= balance {\r\n            Some(Authorization {\r\n                total_debit: quote.total_debit,\r\n            })\r\n        } else {\r\n            None\r\n        }\r\n    }\r\n}\r\n\r\n/// Authorize a Succinct SWAR broadword byte-schedule settlement against `balance`.\r\n///\r\n/// In exact integer arithmetic, let the 8 bytes of `fee` be\r\n/// `b_i = (fee >> (8 * i)) & 0xFF` for `i in {0, ..., 7}`:\r\n/// - `active_bytes = sum_{i=0..7} (if b_i > 0 then 1 else 0)`\r\n/// - `byte_sum = sum_{i=0..7} b_i`\r\n/// - `total_debit = floor(amount / 2) + 256 * active_bytes + byte_sum`\r\n///\r\n/// The payment is authorized iff `total_debit <= balance`.\r\n/// Production code in this crate operates on `u64` words only (`u128` is not used).\r\npub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {\r\n    let quote: settlement::SuccinctQuote = settlement::build_quote(amount, fee)?;\r\n    settlement::verify_affordability(balance, quote)\r\n}\r\n\r\n#[cfg(test)]\r\nmod tests {\r\n    use super::*;\r\n\r\n    #[test]\r\n    fn zero_payment_is_authorized() {\r\n        assert_eq!(authorize(0, 0, 0), Some(Authorization { total_debit: 0 }));\r\n    }\r\n\r\n    #[test]\r\n    fn low_bit_bytes_are_counted_and_summed() {\r\n        assert_eq!(\r\n            authorize(565, 100, 0x0201),\r\n            Some(Authorization { total_debit: 565 })\r\n        );\r\n        assert_eq!(authorize(564, 100, 0x0201), None);\r\n    }\r\n\r\n    #[test]\r\n    fn full_low_bits_across_all_bytes() {\r\n        assert_eq!(\r\n            authorize(2056, 0, broadword::L8),\r\n            Some(Authorization { total_debit: 2056 })\r\n        );\r\n    }\r\n}\r\n\u001b[?2004hroot@27e4dcb10dc1:/workspace# "]
[8.83537, "i", "cat /workspace/lean/SecurityChallenge.lean\n"]
[8.835697, "o", "cat /workspace/lean/SecurityChallenge.lean\r\n\u001b[?2004l\r"]
[8.837042, "o", "namespace SecurityChallenge\r\n\r\nstructure AuthorizationSpec where\r\n  accepts : UInt64 → UInt64 → UInt64 → Prop\r\n  output : UInt64 → UInt64 → UInt64 → UInt64 → Prop\r\n"]
[8.837441, "o", "\r\ninductive AuditVerdict where\r\n  | vulnerable"]
[8.837516, "o", "\r\n  | safe\r\n  deriving Repr\r\n\r\ndef l8Mask : UInt64 := 0x0101010101010101\r\ndef h8Mask : UInt64 := 0x8080808080808080\r\ndef m16Mask : UInt64 := 0x00FF00FF00FF00FF\r\ndef l16Mask : UInt64 := 0x0001000100010001\r\n"]
[8.837555, "o", "\r\nstructure SuccinctQuote where\r\n  principalShare : UInt64\r\n  activeBytes : UInt64\r\n  byteSum : UInt64\r\n"]
[8.837631, "o", "  totalDebit : UInt64\r\n\r\ndef uNz8 (x : UInt64) : UInt64 :=\r\n  ((x ||| h8Mask) - l8Mask) &&& h8Mask\r\n\r\ndef countNzBytes (x : UInt64) : UInt64 :=\r\n  (((uNz8 x) >>> 7) * l8Mask) >>> 56\r\n\r\ndef sumBytes (x : UInt64) : UInt64 :="]
[8.837717, "o", "\r\n  let pairs := (x &&& m16Mask) + ((x >>> 8) &&& m16Mask)\r\n  ((pairs * l16Mask) >>> 48) &&& 0xFFFF\r\n\r\ndef buildQuote (amount fee : UInt64) : Option SuccinctQuote :=\r\n  let principalShare := amount >>> 1\r\n"]
[8.837757, "o", "  let activeBytes := countNzBytes fee\r\n  let byteSum := sumBytes fee\r\n  let totalDebit := principalShare + (activeBytes <<< 8) + byteSum\r\n  some {\r\n    principalShare := principalShare,\r\n    activeBytes := activeBytes,\r\n    byteSum := byteSum,\r\n    totalDebit := totalDebit\r\n  }\r\n\r\n"]
[8.837787, "o", "def verifyAffordability (balance : UInt64) (quote : SuccinctQuote) : Option UInt64 :=\r\n  if quote.totalDebit ≤ balance then\r\n    some quote.totalDebit\r\n"]
[8.83791, "o", "  else\r\n    none\r\n\r\ndef challengeAuthorize (balance amount fee : UInt64) : Option UInt64 :=\r\n  match buildQuote amount fee with\r\n  | some quote => verifyAffordability balance quote\r\n  | none => none\r\n\r\ndef Conforms (spec : AuthorizationSpec)\r\n    (authorize : UInt64 → UInt64 → UInt64 → Option UInt64) : Prop :=\r\n  (∀ b a f, (∃ total, authorize b a f = some total) ↔ spec.accepts b a f) ∧\r\n  (∀ b a f total, authorize b a f = some total → spec.output b a f total)\r\n\r\ndef AuditClaim (spec : AuthorizationSpec) (verdict : AuditVerdict) : Prop :=\r\n"]
[8.837947, "o", "  match verdict with\r\n  | .safe => Conforms spec challengeAuthorize\r\n  | .vulnerable => ¬ Conforms spec challengeAuthorize\r\n\r\nend SecurityChallenge\r\n"]
