[125.233423, "o", "by\r\n  change ¬ SecurityChallenge.Conforms candidateSpec SecurityChallenge.challengeAuthorize\r\n  intro h\r\n  have actual : SecurityChallenge.challengeAuthorize 128 0 128 = some 128 := by\r\n    decide\r\n  have rejected : ¬ candidateSpec.accepts 128 0 128 := by\r\n    change ¬ ((384 : Nat) ≤ 128)\r\n    decide\r\n  exact rejected ((h.1 128 0 128).mp ⟨128, actual⟩)\r\n"]
[125.234947, "o", "--- /workspace/challenge/src/lib.rs\t2026-10-08 11:09:16.000000000 +0000\r\n+++ /workspace/submission/src/lib.rs\t2026-10-08 11:20:26.967132568 +0000\r\n@@ -9,11 +9,11 @@\r\n     pub const M16: u64 = 0x00FF_00FF_00FF_00FFu64;\r\n     pub const L16: u64 = 0x0001_0001_0001_0001u64;\r\n \r\n-    /// Vigna's SWAR broadword non-zero byte indicator (`tov/succinct-rs` `src/broadword.rs`):\r\n+    /// SWAR non-zero byte indicator, retaining original high bits as well:\r\n     /// Sets bit `8*i + 7` iff byte `i` of `x` is non-zero.\r\n     #[inline]\r\n"]
[125.234989, "o", "     pub fn u_nz8(x: u64) -> u64 {\r\n-        ((x | H8) - L8) & H8\r\n+        (((x | H8) - L8) | x) & H8\r\n     }\r\n \r\n     /// Count non-zero bytes in `x` in parallel using SWAR multiplication by `L8`.\r\n@@ -109,3 +109,27 @@\r\n         );\r\n     }\r\n }\r\n+\r\n+#[cfg(test)]\r\n+mod regression_tests {\r\n+    use super::*;\r\n+\r\n+    #[test]\r\n+    fn high_bit_only_bytes_are_nonzero() {\r\n+        assert_eq!(authorize(128, 0, 128), None);\r\n+        for i in 0..8 {\r\n+            let fee = 128u64 << (8 * i);\r\n+            assert_eq!(authorize(383, 0, fee), None);\r\n"]
[125.235019, "o", "+            assert_eq!(authorize(384, 0, fee), Some(Authorization { total_debit: 384 }));\r\n+        }\r\n"]
[125.235337, "o", "+        assert_eq!(authorize(3072, 0, broadword::H8), Some(Authorization { total_debit: 3072 }));\r\n+    }\r\n+\r\n+    #[test]\r\n+    fn maximum_fee_and_principal_remain_exact() {\r\n+        let total = (u64::MAX / 2) + 4088;\r\n+        assert_eq!(authorize(total, u64::MAX, u64::MAX), Some(Authorization { total_debit: total }));\r\n+        assert_eq!(authorize(total - 1, u64::MAX, u64::MAX), None);\r\n+        assert_eq!(authorize(4088, 0, u64::MAX), Some(Authorization { total_debit: 4088 }));\r\n+    }\r\n+}\r\n"]
[125.23544, "o", "\u001b[?2004hroot@27e4dcb10dc1:/workspace# "]
