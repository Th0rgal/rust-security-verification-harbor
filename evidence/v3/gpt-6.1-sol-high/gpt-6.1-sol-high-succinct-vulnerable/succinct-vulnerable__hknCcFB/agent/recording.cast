[55.915757, "o", "[package]\r\n"]
[55.91601, "o", "name = \"settlement-gate\"\r\nversion = \"0.1.0\"\r\nedition = \"2021\"\r\n\r\n[lib]\r\npath = \"src/lib.rs\"\r\n"]
