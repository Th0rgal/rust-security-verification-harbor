[102.921357, "i", "cat > /tmp/authorization-reference.rs <<'EOF'\ninclude!(\"/workspace/submission/src/lib.rs\");\n\nfn check(amount: u64, fee: u64) {\n    let mut debit = (amount as u128) / 2;\n    for i in 0..8 {\n        let byte = (fee >> (8 * i)) & 255;\n        debit += byte as u128;\n        if byte != 0 { debit += 256; }\n    }\n    assert!(debit <= u64::MAX as u128);\n    let debit = debit as u64;\n    assert_eq!(authorize(debit, amount, fee), Some(Authorization { total_debit: debit }));\n    assert_eq!(authorize(u64::MAX, amount, fee), Some(Authorization { total_debit: debit }));\n    if debit != 0 { assert_eq!(authorize(debit - 1, amount, fee), None); }\n}\n\nfn main() {\n    for i in 0..8 {\n        for byte in 0u64..256 {\n            for amount in [0, 1, 2, u64::MAX - 1, u64::MAX] {\n                check(amount, byte << (8 * i));\n            }\n        }\n    }\n    for fee in [0, broadword::L8, broadword::H8, u64::MAX, 0x7f7f7f7f7f7f7f7f] {\n        check(u64::MAX, fee);\n    }\n    let mut state = 0x9e3779b97f4a7c15u64;\n    for _ in 0..100_000 {\n        state ^= state << 13;\n        state ^= state >> 7;\n        state ^= state << 17;\n        check(state.rotate_left(29), state);\n    }\n    println!(\"Wider-arithmetic reference comparisons passed\");\n}\nEOF\nrustc --edition=2021 /tmp/authorization-reference.rs -o /tmp/authorization-reference && /tmp/authorization-reference\n"]
