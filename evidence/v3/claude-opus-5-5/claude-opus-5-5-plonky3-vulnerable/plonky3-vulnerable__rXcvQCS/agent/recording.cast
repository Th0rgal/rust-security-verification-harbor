[31.232624, "i", "python3 -c \"P=2013265921;R=2**32;a=1744830467;f=0;x=a%R+(f%P)*R;print(x*943718400%P, (R*943718400)%P);t=((x&(R-1))*2281701377)&(R-1);u=t*P;d=(x-u)%2**64;hi=d>>32;print(t,x<u,hi==R-1)\"\n"]
