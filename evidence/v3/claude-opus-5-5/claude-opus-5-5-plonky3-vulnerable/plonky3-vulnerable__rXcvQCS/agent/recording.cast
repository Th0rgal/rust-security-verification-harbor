[151.705973, "o", "sed -n '/pub fn monty_reduce/,/^    }/p' /workspace/submission/src/lib.rs\r\n\u001b[?2004l\r"]
[151.707385, "o", "    pub fn monty_reduce(x: u64) -> u64 {\r\n        let t: u64 = monty_quotient(x);\r\n        let u: u64 = t * BABY_BEAR_P;\r\n        let (diff, borrow) = x.overflowing_sub(u);\r\n        let hi: u64 = diff >> 32u64;"]
[151.707425, "o", "\r\n        if borrow {\r\n            // diff wrapped: hi = 2^32 + q with -P < q < 0, so hi + P - 2^32 = q + P in (0, P).\r\n            hi + BABY_BEAR_P - LIMB_BASE\r\n        } else {\r\n            hi\r\n        }\r\n    }\r\n"]
