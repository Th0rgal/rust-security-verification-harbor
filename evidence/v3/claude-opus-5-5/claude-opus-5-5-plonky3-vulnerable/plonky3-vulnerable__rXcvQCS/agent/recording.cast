[31.543509, "o", "\u001b[?2004hroot@714fbc9bbc0e:/workspace# "]
[66.176869, "i", "cat > /workspace/submission/Spec.lean <<'EOF'\nimport SecurityChallenge\nopen SecurityChallenge\n\n/-- BabyBear prime P. -/\ndef specP : Nat := 2013265921\n/-- Montgomery radix R = 2^32. -/\ndef specR : Nat := 4294967296\n/-- R^-1 mod P. -/\ndef specRInv : Nat := 943718400\n\n/-- transcript = (amount mod 2^32) + (fee mod P) * 2^32, exact integers. -/\ndef specTranscript (amount fee : UInt64) : Nat :=\n  amount.toNat % specR + (fee.toNat % specP) * specR\n\n/-- monty_surcharge = (transcript * R_INV) mod P. -/\ndef specSurcharge (amount fee : UInt64) : Nat :=\n  (specTranscript amount fee * specRInv) % specP\n\n/-- Exact debit = principal + fee surcharge (unbounded). -/\ndef specTotal (amount fee : UInt64) : Nat :=\n  amount.toNat + specSurcharge amount fee\n\ndef candidateSpec : AuthorizationSpec where\n  accepts := fun balance amount fee => specTotal amount fee ≤ balance.toNat\n  output := fun _balance amount fee total => total.toNat = specTotal amount fee\nEOF\n"]
[66.177145, "o", "cat > /workspace/submission/Spec.lean <<'EOF'\r\n\u001b[?2004l\r"]
[66.177184, "o", "\u001b[?2004h"]
[66.177312, "o", "> import SecurityChallenge\r\n\u001b[?2004l\r"]
[66.177355, "o", "\u001b[?2004h> "]
[66.177522, "o", "open SecurityChallenge\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.177653, "o", "/-- BabyBear prime P. -/\r\n\u001b[?2004l\r"]
[66.177716, "o", "\u001b[?2004h> "]
[66.177756, "o", "def specP : Nat := 2013265921\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.17779, "o", "> "]
[66.177918, "o", "/-- Montgomery radix R = 2^32. -/\r\n\u001b[?2004l\r"]
[66.177989, "o", "\u001b[?2004h> "]
[66.178069, "o", "def specR : Nat := 4294967296\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.178152, "o", "/-- R^-1 mod P. -/\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.17819, "o", "> "]
[66.178306, "o", "def specRInv : Nat := 943718400\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.178382, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[66.178572, "o", "> "]
[66.178645, "o", "/-- transcript = (amount mod 2^32) + (fee mod P) * 2^32, exact integers. -/\r\n\u001b[?2004l\r"]
[66.178679, "o", "\u001b[?2004h> "]
[66.178869, "o", "def specTranscript (amount fee : UInt64) : Nat :=\r\n\u001b[?2004l\r"]
[66.178903, "o", "\u001b[?2004h> "]
[66.179086, "o", "  amount.toNat % specR + (fee.toNat % specP) * specR\r\n\u001b[?2004l\r"]
[66.179119, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[66.179145, "o", "> "]
[66.179335, "o", "/-- monty_surcharge = (transcript * R_INV) mod P. -/\r\n\u001b[?2004l\r"]
[66.179405, "o", "\u001b[?2004h> "]
[66.179543, "o", "def specSurcharge (amount fee : UInt64) : Nat :=\r\n\u001b[?2004l\r"]
[66.179603, "o", "\u001b[?2004h> "]
[66.179747, "o", "  (specTranscript amount fee * specRInv) % specP\r\n\u001b[?2004l\r"]
[66.17978, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[66.179806, "o", "> "]
[66.180017, "o", "/-- Exact debit = principal + fee surcharge (unbounded). -/\r\n\u001b[?2004l\r"]
[66.180079, "o", "\u001b[?2004h> "]
[66.180213, "o", "def specTotal (amount fee : UInt64) : Nat :=\r\n\u001b[?2004l\r"]
[66.180272, "o", "\u001b[?2004h> "]
[66.1804, "o", "  amount.toNat + specSurcharge amount fee\r\n\u001b[?2004l\r"]
[66.180508, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.180663, "o", "def candidateSpec : AuthorizationSpec where\r\n\u001b[?2004l\r"]
[66.180715, "o", "\u001b[?2004h> "]
[66.18096, "o", "  accepts := fun balance amount fee => specTotal amount fee ≤ balance.toNat\r\n\u001b[?2004l\r"]
[66.180993, "o", "\u001b[?2004h> "]
[66.181267, "o", "  output := fun _balance amount fee total => total.toNat = specTotal amount fee\r\n\u001b[?2004l\r"]
