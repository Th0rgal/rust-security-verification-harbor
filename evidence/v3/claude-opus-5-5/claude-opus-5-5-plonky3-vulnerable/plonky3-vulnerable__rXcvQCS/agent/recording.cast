[289.282149, "i", "python3 - <<'EOF'\nimport random\nP=2013265921;R=2**32;M=2**64;MU=2281701377;RINV=943718400\ndef fixed(x):\n    t=((x&(R-1))*MU)&(R-1); u=t*P; assert u<M\n    d=(x-u)%M; hi=d>>32\n    if x<u:\n        v=hi+P-R; assert 0<=v<M and hi+P<M\n        return v\n    return hi\ndef auth(b,a,f):\n    x=(a&(R-1))+(f%P)*R; assert x<M\n    s=fixed(x); tot=a+s\n    if tot>=M: return None\n    return tot if tot<=b else None\ndef spec(b,a,f):\n    x=(a%R)+(f%P)*R; tot=a+(x*RINV)%P\n    return tot if tot<=b else None\nbad=0\nfor _ in range(300000):\n    x=random.randrange(0,P*R)\n    if fixed(x)!=(x*RINV)%P: bad+=1\nfor t in range(0,R,4099):\n    for x in (t*P-R, t*P-1, t*P, t*P+1):\n        if 0<=x<P*R and fixed(x)!=(x*RINV)%P: bad+=1\nedges=[0,1,2,P-1,P,P+1,R-1,R,R+1,M-1,M-2,M-P,1744830467,3758096387]\nfor b in edges:\n    for a in edges:\n        for f in edges:\n            if auth(b,a,f)!=spec(b,a,f): bad+=1\nfor _ in range(200000):\n    a=random.choice([random.randrange(M),random.randrange(R),M-1-random.randrange(P)]); f=random.randrange(M)\n    b=random.choice([random.randrange(M),M-1])\n    if auth(b,a,f)!=spec(b,a,f): bad+=1\nprint('mismatches:',bad)\nprint('cex spec:',spec(1744830467,1744830467,0),'fixed:',auth(1744830467,1744830467,0))\nEOF\n"]
