[151.688605, "i", "mkdir -p /workspace/submission/src && python3 - <<'EOF'\nsrc = open('/workspace/challenge/src/lib.rs').read()\nold = '''        if borrow {\n            if hi == LIMB_MASK {\n                0u64\n            } else {\n                hi + BABY_BEAR_P - LIMB_BASE\n            }\n        } else {'''\nnew = '''        if borrow {\n            // diff wrapped: hi = 2^32 + q with -P < q < 0, so hi + P - 2^32 = q + P in (0, P).\n            hi + BABY_BEAR_P - LIMB_BASE\n        } else {'''\nassert old in src\nsrc = src.replace(old, new)\ntest_anchor = '''    fn small_transcript_reduction_matches_policy() {'''\nreg = '''    fn borrow_with_all_ones_high_limb_is_p_minus_one() {\n        // transcript = 3P - 2^32, quotient t = 3, q = -1 -> surcharge must be P - 1.\n        assert_eq!(monty31::monty_reduce(1_744_830_467), 2_013_265_920);\n        assert_eq!(authorize(1_744_830_467, 1_744_830_467, 0), None);\n        assert_eq!(\n            authorize(3_758_096_387, 1_744_830_467, 0),\n            Some(Authorization { total_debit: 3_758_096_387 })\n        );\n    }\n\n    #[test]\n'''\nassert test_anchor in src\nsrc = src.replace(test_anchor, reg + test_anchor, 1)\nopen('/workspace/submission/src/lib.rs','w').write(src)\nEOF\nsed -n '/pub fn monty_reduce/,/^    }/p' /workspace/submission/src/lib.rs\n"]
