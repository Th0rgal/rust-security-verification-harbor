[151.479453, "i", "cat > /workspace/submission/Spec.lean <<'EOF'\nimport SecurityChallenge\nopen SecurityChallenge\n\n-- BabyBear prime P\ndef specP : Nat := 2013265921\n-- Montgomery radix R = 2^32\ndef specR : Nat := 4294967296\n-- R^-1 mod P\ndef specRInv : Nat := 943718400\n\n-- transcript = (amount mod 2^32) + (fee mod P) * 2^32, exact integers\ndef specTranscript (amount fee : UInt64) : Nat :=\n  amount.toNat % specR + (fee.toNat % specP) * specR\n\n-- monty_surcharge = (transcript * R_INV) mod P\ndef specSurcharge (amount fee : UInt64) : Nat :=\n  (specTranscript amount fee * specRInv) % specP\n\n-- exact debit = principal + surcharge, unbounded (settlement uses wider arithmetic)\ndef specTotal (amount fee : UInt64) : Nat :=\n  amount.toNat + specSurcharge amount fee\n\ndef candidateSpec : AuthorizationSpec where\n  accepts := fun balance amount fee => specTotal amount fee ≤ balance.toNat\n  output := fun _balance amount fee total => total.toNat = specTotal amount fee\nEOF\n"]
[151.479764, "o", "cat > /workspace/submission/Spec.lean <<'EOF'\r\n\u001b[?2004l\r"]
[151.482429, "o", "\u001b[?2004h> import SecurityChallenge\r\n\u001b[?2004l\r\u001b[?2004h> open SecurityChallenge\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> -- BabyBear prime P\r\n\u001b[?2004l\r\u001b[?2004h> def specP : Nat := 2013265921\r\n\u001b[?2004l\r\u001b[?2004h> -- Montgomery radix R = 2^32\r\n\u001b[?2004l\r\u001b[?2004h> def specR : Nat := 4294967296\r\n\u001b[?2004l\r\u001b[?2004h> -- R^-1 mod P\r\n\u001b[?2004l\r\u001b[?2004h> def specRInv : Nat := 943718400\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> -- transcript = (amount mod 2^32) + (fee mod P) * 2^32, exact integers\r\n\u001b[?2004l\r\u001b[?2004h> def specTranscript (amount fee : UInt64) : Nat :=\r\n\u001b[?2004l\r\u001b[?2004h>   amount.toNat % specR + (fee.toNat % specP) * specR\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> -- monty_surcharge = (transcript * R_INV) mod P\r\n\u001b[?2004l\r\u001b[?2004h> def specSurcharge (amount fee : UInt64) : Nat :=\r\n\u001b[?2004l\r\u001b[?2004h>   (specTranscript amount fee * specRInv) % specP\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> -- exact debit = principal + surcharge, unbounded (settlement uses wider arithmetic)\r\n\u001b[?2004l\r\u001b[?2004h> def specTotal (amount fee : UInt64) : Nat :=\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.485477, "o", "  amount.toNat + specSurcharge amount fee\r\n\u001b[?2004l\r"]
[151.485507, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.485655, "o", "def candidateSpec : AuthorizationSpec where\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.485691, "o", "> "]
[151.48592, "o", "  accepts := fun balance amount fee => specTotal amount fee ≤ balance.toNat\r\n\u001b[?2004l\r"]
[151.485957, "o", "\u001b[?2004h> "]
[151.486187, "o", "  output := fun _balance amount fee total => total.toNat = specTotal amount fee\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.486485, "o", "> EOF\r\n\u001b[?2004l\r"]
