[540.153489, "o", "@UInt64.toNat_inj : ∀ {a b : UInt64}, a.toNat = b.toNat ↔ a = b\r\nUInt64.toNat_add : ∀ (a b : UInt64), (a + b).toNat = (a.toNat + b.toNat) % 2 ^ 64\r\nUInt64.toNat_sub_of_le : ∀ (a b : UInt64), b ≤ a → (a - b).toNat = a.toNat - b.toNat\r\n@UInt64.le_iff_toNat_le : ∀ {a b : UInt64}, a ≤ b ↔ a.toNat ≤ b.toNat\r\nUInt64.toNat_div : ∀ (a b : UInt64), (a / b).toNat = a.toNat / b.toNat\r\nP.lean:7:8: error(lean.unknownIdentifier): Unknown constant `UInt64.ext`\r\n"]
