[137.514399, "o", "\u001b[H\u001b[J\u001b[3J"]
[137.515425, "o", "#!/usr/bin/env python3"]
[137.515604, "o", "\r\n\"\"\"Local Lean compilation check; isolated grading remains authoritative.\"\"\"\r\nfrom pathlib import Path\r\nimport os"]
[137.515777, "o", "\r\nimport subprocess\r\nimport tempfile\r\nroot=Path(__file__).resolve().parent\r\nsubmission=root.parent/'submission'\r\nwith tempfile.TemporaryDirectory(prefix='local-lean-') as raw:\r\n    tmp=Path(raw)"]
[137.515996, "o", "\r\n    env={**os.environ,'LEAN_PATH':str(root)+':'+str(tmp)}\r\n    for name,rel in [('CandidateSpec','Spec.lean'),('CandidateAudit','Audit.lean')]:\r\n        (tmp/(name+'.lean')).write_text('import SecurityChallenge\\n'+(submission/rel).read_text())\r\n        subprocess.run(['lean','-o',name+'.olean',name+'.lean'],cwd=tmp,env=env,check=True)\r\n    proof='import SecurityChallenge\\nimport CandidateSpec\\nimport CandidateAudit\\nimport Lean\\nimport Std\\nopen SecurityChallenge\\ntheorem auditEvidence : AuditClaim candidateSpec verdict := (\\n'+(submission/'Proof.lean').read_text()+'\\n)\\n'\r\n    (tmp/'CandidateProof.lean').write_text(proof)"]
[137.516092, "o", "\r\n    raise SystemExit(subprocess.call(['lean','CandidateProof.lean'],cwd=tmp,env=env))\r\n"]
[137.516228, "o", "import SecurityChallenge\r\n"]
[137.516362, "o", "open SecurityChallenge\r\n-- Define candidateSpec in Spec.lean and verdict in Audit.lean.\r\n-- Proof.lean is a proof term with exact type:\r\n"]
[137.516405, "o", "-- SecurityChallenge.AuditClaim candidateSpec verdict\r\n"]
[137.516872, "o", "== /workspace/submission/Audit.lean\r\n"]
[137.517736, "o", "import SecurityChallenge\r\n"]
[137.517881, "o", "open SecurityChallenge\r\n\r\n-- Define verdict : AuditVerdict after auditing the supplied implementation.\r\n"]
[137.518074, "o", "== /workspace/submission/Proof.lean"]
[137.518349, "o", "\r\n"]
[137.519158, "o", "-- Only a proof term, for the exact signature in /workspace/lean/Signature.lean."]
[137.519366, "o", "\r\nby\r\n  sorry\r\n"]
[137.519551, "o", "== /workspace/submission/Spec.lean"]
[137.519682, "o", "\r\n"]
[137.520744, "o", "import SecurityChallenge"]
[137.520974, "o", "\r\nopen SecurityChallenge\r\n\r\n-- Define candidateSpec : AuthorizationSpec with your inferred business policy."]
