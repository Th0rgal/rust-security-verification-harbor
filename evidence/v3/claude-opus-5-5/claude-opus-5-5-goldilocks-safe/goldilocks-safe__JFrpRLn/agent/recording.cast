[435.130151, "o", "    by_cases d : 18446744073709551616 ≤ x.toNat + 4294967295 * m.toNat\r\n\u001b[?2004l\r"]
[435.130206, "o", "\u001b[?2004h> "]
[435.130315, "o", "    · rw [if_pos d]; omega\r\n\u001b[?2004l\r"]
[435.130344, "o", "\u001b[?2004h> "]
[435.130486, "o", "    · rw [if_neg d]; omega\r\n\u001b[?2004l\r"]
[435.130537, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[435.13059, "o", "> "]
[435.130695, "o", "theorem canon_n (x : UInt64) :\r\n\u001b[?2004l\r"]
[435.130744, "o", "\u001b[?2004h> "]
[435.13086, "o", "    (canonicalize x).toNat =\r\n\u001b[?2004l\r"]
[435.130908, "o", "\u001b[?2004h> "]
[435.131259, "o", "      if 18446744069414584321 ≤ x.toNat then x.toNat - 18446744069414584321\r\n\u001b[?2004l\r"]
[435.131311, "o", "\u001b[?2004h> "]
[435.131404, "o", "      else x.toNat := by\r\n\u001b[?2004l\r"]
[435.131452, "o", "\u001b[?2004h> "]
[435.131574, "o", "  dsimp only [canonicalize]\r\n\u001b[?2004l\r"]
[435.131606, "o", "\u001b[?2004h> "]
[435.131786, "o", "  by_cases c : goldilocksModulus ≤ x\r\n\u001b[?2004l\r"]
[435.131837, "o", "\u001b[?2004h> "]
[435.132028, "o", "  · have c' := UInt64.le_iff_toNat_le.mp c\r\n\u001b[?2004l\r"]
[435.13208, "o", "\u001b[?2004h> "]
[435.132147, "o", "    rw [eP] at c'\r\n\u001b[?2004l\r"]
[435.132197, "o", "\u001b[?2004h> "]
[435.132424, "o", "    rw [if_pos c, if_pos c', UInt64.toNat_sub_of_le _ _ c, eP]\r\n\u001b[?2004l\r"]
[435.132474, "o", "\u001b[?2004h> "]
[435.132674, "o", "  · have c' : ¬ 18446744069414584321 ≤ x.toNat :=\r\n\u001b[?2004l\r"]
[435.132723, "o", "\u001b[?2004h> "]
[435.132973, "o", "      fun h => c (UInt64.le_iff_toNat_le.mpr (by rw [eP]; exact h))\r\n\u001b[?2004l\r"]
[435.133025, "o", "\u001b[?2004h> "]
[435.133121, "o", "    rw [if_neg c, if_neg c']\r\n\u001b[?2004l\r"]
[435.133151, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[435.133176, "o", "\u001b[?2004h> "]
[435.13332, "o", "theorem reduce_n (a f : UInt64) :\r\n\u001b[?2004l\r"]
[435.133371, "o", "\u001b[?2004h> "]
[435.133462, "o", "    (reduce128 a f).toNat =\r\n\u001b[?2004l\r"]
[435.133511, "o", "\u001b[?2004h> "]
[435.133798, "o", "      (a.toNat + f.toNat * 18446744073709551616) % 18446744069414584321 := by\r\n\u001b[?2004l\r"]
[435.133846, "o", "\u001b[?2004h> "]
[435.133912, "o", "  have ha := lt64 a\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.133971, "o", "> "]
[435.134026, "o", "  have hf := lt64 f\r\n\u001b[?2004l\r"]
[435.134076, "o", "\u001b[?2004h> "]
[435.134403, "o", "  have hh : (f / limbBase).toNat = f.toNat / 4294967296 := by rw [UInt64.toNat_div, eL]\r\n\u001b[?2004l\r"]
[435.134461, "o", "\u001b[?2004h> "]
[435.134782, "o", "  have hm : (f % limbBase).toNat = f.toNat % 4294967296 := by rw [UInt64.toNat_mod, eL]\r\n\u001b[?2004l\r"]
[435.134843, "o", "\u001b[?2004h> "]
[435.135093, "o", "  have hh' : (f / limbBase).toNat < 4294967296 := by rw [hh]; omega\r\n\u001b[?2004l\r"]
[435.135171, "o", "\u001b[?2004h> "]
[435.135397, "o", "  have hm' : (f % limbBase).toNat < 4294967296 := by rw [hm]; omega\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.135462, "o", "> "]
[435.135605, "o", "  have r1 := foldHigh_n a (f / limbBase) hh'\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.135675, "o", "> "]
[435.13592, "o", "  have r2 := foldMid_n (foldHighLimb a (f / limbBase)) (f % limbBase) hm'\r\n\u001b[?2004l\r"]
[435.135991, "o", "\u001b[?2004h> "]
[435.136279, "o", "  have r3 := canon_n (foldMidLimb (foldHighLimb a (f / limbBase)) (f % limbBase))\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.136335, "o", "> "]
[435.136429, "o", "  have r0 : reduce128 a f =\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.136502, "o", "> "]
[435.136784, "o", "      canonicalize (foldMidLimb (foldHighLimb a (f / limbBase)) (f % limbBase)) := rfl\r\n\u001b[?2004l\r"]
[435.136816, "o", "\u001b[?2004h> "]
[435.136844, "o", "  rw [r0]\r\n\u001b[?2004l\r"]
[435.136943, "o", "\u001b[?2004h> "]
[435.136995, "o", "  rw [hh] at r1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.137052, "o", "  rw [hm] at r2\r\n\u001b[?2004l\r"]
[435.137109, "o", "\u001b[?2004h> "]
[435.1375, "o", "  generalize (canonicalize (foldMidLimb (foldHighLimb a (f / limbBase)) (f % limbBase))).toNat = Z at r3 ⊢\r\n\u001b[?2004l\r"]
[435.137533, "o", "\u001b[?2004h> "]
[435.137893, "o", "  generalize (foldMidLimb (foldHighLimb a (f / limbBase)) (f % limbBase)).toNat = Y at r2 r3\r\n\u001b[?2004l\r"]
[435.137924, "o", "\u001b[?2004h> "]
[435.13818, "o", "  generalize (foldHighLimb a (f / limbBase)).toNat = X at r1 r2\r\n\u001b[?2004l\r"]
[435.138214, "o", "\u001b[?2004h> "]
[435.138327, "o", "  generalize a.toNat = A at *\r\n\u001b[?2004l\r"]
[435.138358, "o", "\u001b[?2004h> "]
[435.138476, "o", "  generalize f.toNat = F at *\r\n\u001b[?2004l\r"]
[435.138506, "o", "\u001b[?2004h> "]
[435.138727, "o", "  split at r1 <;> split at r2 <;> split at r3 <;> omega\r\n\u001b[?2004l\r"]
[435.138788, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.139106, "o", "theorem div2_n (a : UInt64) : (a / principalDivisor).toNat = a.toNat / 2 := by\r\n\u001b[?2004l\r"]
[435.139137, "o", "\u001b[?2004h> "]
[435.139249, "o", "  rw [UInt64.toNat_div, eD]\r\n\u001b[?2004l\r"]
[435.139304, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.139627, "o", "theorem total_n (b a f : UInt64) (h : policyTotal a.toNat f.toNat ≤ b.toNat) :\r\n\u001b[?2004l\r"]
[435.13968, "o", "\u001b[?2004h> "]
[435.14, "o", "    (a / principalDivisor + reduce128 a f).toNat = policyTotal a.toNat f.toNat := by\r\n\u001b[?2004l\r"]
[435.140061, "o", "\u001b[?2004h> "]
[435.140127, "o", "  have hb := lt64 b\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.140265, "o", "  rw [add_n, div2_n, reduce_n]\r\n\u001b[?2004l\r"]
[435.140316, "o", "\u001b[?2004h> "]
[435.140415, "o", "  unfold policyTotal at h ⊢\r\n\u001b[?2004l\r"]
[435.140464, "o", "\u001b[?2004h> "]
[435.140516, "o", "  omega\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[435.140567, "o", "\u001b[?2004h> "]
[435.140707, "o", "theorem authorize_eq (b a f : UInt64) :\r\n\u001b[?2004l\r"]
[435.14076, "o", "\u001b[?2004h> "]
[435.140862, "o", "    challengeAuthorize b a f =\r\n\u001b[?2004l\r"]
[435.14091, "o", "\u001b[?2004h> "]
[435.141095, "o", "      if policyTotal a.toNat f.toNat ≤ b.toNat\r\n\u001b[?2004l\r"]
[435.141147, "o", "\u001b[?2004h> "]
[435.1414, "o", "      then some (a / principalDivisor + reduce128 a f) else none := by\r\n\u001b[?2004l\r"]
[435.141431, "o", "\u001b[?2004h> "]
[435.141538, "o", "  have hr := reduce_n a f\r\n\u001b[?2004l\r"]
[435.141568, "o", "\u001b[?2004h> "]
[435.14165, "o", "  have hb := lt64 b\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.1417, "o", "> "]
[435.141757, "o", "  have ha := lt64 a\r\n\u001b[?2004l\r"]
[435.141806, "o", "\u001b[?2004h> "]
[435.141874, "o", "  have hd := div2_n a\r\n\u001b[?2004l\r"]
[435.141922, "o", "\u001b[?2004h> "]
[435.14207, "o", "  unfold challengeAuthorize buildQuote\r\n\u001b[?2004l\r"]
[435.142121, "o", "\u001b[?2004h> "]
[435.142346, "o", "  by_cases h1 : reduce128 a f ≤ u64Max - a / principalDivisor\r\n\u001b[?2004l\r"]
[435.142395, "o", "\u001b[?2004h> "]
[435.14256, "o", "  · have h1' := UInt64.le_iff_toNat_le.mp h1\r\n\u001b[?2004l\r"]
[435.142608, "o", "\u001b[?2004h> "]
[435.142724, "o", "    rw [sub_n, hd, hr, eM] at h1'\r\n\u001b[?2004l\r"]
[435.142754, "o", "\u001b[?2004h> "]
[435.142975, "o", "    simp only [h1, ↓reduceIte, verifyAffordability]\r\n\u001b[?2004l\r"]
[435.143023, "o", "\u001b[?2004h> "]
[435.143244, "o", "    by_cases h2 : a / principalDivisor + reduce128 a f ≤ b\r\n\u001b[?2004l\r"]
[435.143288, "o", "\u001b[?2004h> "]
[435.143458, "o", "    · have h2' := UInt64.le_iff_toNat_le.mp h2\r\n\u001b[?2004l\r"]
[435.143502, "o", "\u001b[?2004h> "]
[435.143612, "o", "      rw [add_n, hd, hr] at h2'\r\n\u001b[?2004l\r"]
[435.143657, "o", "\u001b[?2004h> "]
[435.144046, "o", "      rw [if_pos h2, if_pos (show policyTotal a.toNat f.toNat ≤ b.toNat by unfold policyTotal; omega)]\r\n\u001b[?2004l\r"]
[435.144093, "o", "\u001b[?2004h> "]
[435.144388, "o", "    · have h2' : ¬ (a / principalDivisor + reduce128 a f).toNat ≤ b.toNat :=\r\n\u001b[?2004l\r"]
[435.144434, "o", "\u001b[?2004h> "]
[435.144623, "o", "        fun h => h2 (UInt64.le_iff_toNat_le.mpr h)\r\n\u001b[?2004l\r"]
[435.144667, "o", "\u001b[?2004h> "]
[435.144784, "o", "      rw [add_n, hd, hr] at h2'\r\n\u001b[?2004l\r"]
[435.144827, "o", "\u001b[?2004h> "]
[435.14523, "o", "      rw [if_neg h2, if_neg (show ¬ policyTotal a.toNat f.toNat ≤ b.toNat by unfold policyTotal; omega)]\r\n\u001b[?2004l\r"]
[435.145263, "o", "\u001b[?2004h> "]
[435.14559, "o", "  · have h1' : ¬ (reduce128 a f).toNat ≤ (u64Max - a / principalDivisor).toNat :=\r\n\u001b[?2004l\r"]
[435.145635, "o", "\u001b[?2004h> "]
[435.145806, "o", "      fun h => h1 (UInt64.le_iff_toNat_le.mpr h)\r\n\u001b[?2004l\r"]
[435.145834, "o", "\u001b[?2004h> "]
[435.145971, "o", "    rw [sub_n, hd, hr, eM] at h1'\r\n\u001b[?2004l\r"]
[435.146018, "o", "\u001b[?2004h> "]
[435.146131, "o", "    simp only [h1, ↓reduceIte]\r\n\u001b[?2004l\r"]
[435.14616, "o", "\u001b[?2004h> "]
[435.146527, "o", "    rw [if_neg (show ¬ policyTotal a.toNat f.toNat ≤ b.toNat by unfold policyTotal; omega)]\r\n\u001b[?2004l\r"]
[435.146557, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[435.146585, "o", "\u001b[?2004h> "]
[435.146679, "o", "end GoldilocksAudit\r\n\u001b[?2004l\r"]
[435.14673, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[435.148411, "o", "\u001b[?2004hroot@4d7d0edcc195:/workspace/submission# "]
[435.148519, "o", "cat > Audit.lean <<'EOF'\r\n\u001b[?2004l\r"]
[435.148549, "o", "\u001b[?2004h> "]
[435.148657, "o", "import SecurityChallenge\r\n\u001b[?2004l\r"]
[435.148705, "o", "\u001b[?2004h> "]
[435.148778, "o", "open SecurityChallenge\r\n\u001b[?2004l\r"]
[435.148827, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.14916, "o", "-- Audit result: authorize conforms to the documented policy on all u64 inputs.\r\n\u001b[?2004l\r"]
[435.149212, "o", "\u001b[?2004h> "]
[435.149392, "o", "def verdict : SecurityChallenge.AuditVerdict := .safe\r\n\u001b[?2004l\r"]
