[435.150728, "o", "\u001b[?2004hroot@4d7d0edcc195:/workspace/submission# "]
[435.150836, "o", "cat > Proof.lean <<'EOF'\r\n\u001b[?2004l\r"]
[435.150868, "o", "\u001b[?2004h> by\r\n"]
[435.150896, "o", "\u001b[?2004l\r\u001b[?2004h"]
[435.150923, "o", "> "]
[435.151111, "o", "  show Conforms candidateSpec challengeAuthorize\r\n\u001b[?2004l\r"]
[435.15116, "o", "\u001b[?2004h> "]
[435.151188, "o", "  constructor\r\n\u001b[?2004l\r"]
[435.151215, "o", "\u001b[?2004h> "]
[435.151302, "o", "  · intro b a f\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.151351, "o", "> "]
[435.151478, "o", "    rw [GoldilocksAudit.authorize_eq]\r\n\u001b[?2004l\r"]
[435.151532, "o", "\u001b[?2004h> "]
[435.151798, "o", "    by_cases h : GoldilocksAudit.policyTotal a.toNat f.toNat ≤ b.toNat\r\n\u001b[?2004l\r"]
[435.151846, "o", "\u001b[?2004h> "]
[435.151913, "o", "    · rw [if_pos h]\r\n\u001b[?2004l\r"]
[435.151967, "o", "\u001b[?2004h> "]
[435.152158, "o", "      exact ⟨fun _ => h, fun _ => ⟨_, rfl⟩⟩\r\n\u001b[?2004l\r"]
[435.152207, "o", "\u001b[?2004h> "]
[435.152278, "o", "    · rw [if_neg h]\r\n\u001b[?2004l\r"]
[435.152307, "o", "\u001b[?2004h> "]
[435.152584, "o", "      exact ⟨fun ⟨_, ht⟩ => nomatch ht, fun h' => absurd h' h⟩\r\n\u001b[?2004l\r"]
[435.152632, "o", "\u001b[?2004h> "]
[435.152688, "o", "  · intro b a f t\r\n\u001b[?2004l\r"]
[435.152742, "o", "\u001b[?2004h> "]
[435.152871, "o", "    rw [GoldilocksAudit.authorize_eq]\r\n\u001b[?2004l\r"]
[435.15292, "o", "\u001b[?2004h> "]
[435.15317, "o", "    by_cases h : GoldilocksAudit.policyTotal a.toNat f.toNat ≤ b.toNat\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.153221, "o", "> "]
[435.153276, "o", "    · rw [if_pos h]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.153328, "o", "      intro ht\r\n\u001b[?2004l\r"]
[435.153377, "o", "\u001b[?2004h> "]
[435.153425, "o", "      cases ht\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.153557, "o", "      exact GoldilocksAudit.total_n b a f h\r\n\u001b[?2004l\r"]
[435.153605, "o", "\u001b[?2004h> "]
[435.153654, "o", "    · rw [if_neg h]\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.153708, "o", "> "]
[435.153761, "o", "      intro ht\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.153814, "o", "      cases ht\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.153864, "o", "EOF\r\n\u001b[?2004l\r"]
