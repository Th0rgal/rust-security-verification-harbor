[229.097923, "i", "mkdir -p /tmp/t && cat > /tmp/t/T.lean <<'EOF'\nimport SecurityChallenge\n#check @UInt64.toNat_add\n#check @UInt64.toNat_sub\n#check @UInt64.toNat_sub_of_le\n#check @UInt64.toNat_mul\n#check @UInt64.toNat_div\n#check @UInt64.toNat_mod\n#check @UInt64.lt_iff_toNat_lt\n#check @UInt64.le_iff_toNat_le\n#check @UInt64.toNat_lt\n#check @UInt64.toNat_ofNat\nexample : (18446744069414584321 : UInt64).toNat = 18446744069414584321 := by decide\nexample : SecurityChallenge.goldilocksModulus.toNat = 18446744069414584321 := rfl\nEOF\ncd /tmp/t && LEAN_PATH=/workspace/lean lean T.lean; cd /workspace\n"]
