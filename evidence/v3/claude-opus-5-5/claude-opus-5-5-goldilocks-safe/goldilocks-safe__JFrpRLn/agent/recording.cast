[787.865982, "i", "rm -rf /tmp/rt && mkdir -p /tmp/rt && cp -r /workspace/challenge/Cargo.toml /workspace/challenge/Cargo.lock /workspace/challenge/src /tmp/rt/ && cat >> /tmp/rt/src/lib.rs <<'EOF'\n\n#[cfg(test)]\nmod diff_tests {\n    use super::*;\n    const P: u128 = 18446744069414584321;\n    fn total(a: u64, f: u64) -> u128 {\n        (a as u128) / 2 + (((f as u128) << 64) | (a as u128)) % P\n    }\n    fn policy(b: u64, a: u64, f: u64) -> Option<Authorization> {\n        let t = total(a, f);\n        if t <= b as u128 { Some(Authorization { total_debit: t as u64 }) } else { None }\n    }\n    #[test]\n    fn boundary_grid() {\n        let p = P as u64;\n        let v: Vec<u64> = vec![0, 1, 2, 3, 0xFFFF_FFFE, 0xFFFF_FFFF, 1 << 32, (1 << 32) + 1,\n            p - 2, p - 1, p, p + 1, p + 2, u64::MAX - 2, u64::MAX - 1, u64::MAX,\n            1 << 63, (1 << 63) - 1, (1 << 63) + 1, 0xFFFF_FFFF_0000_0000, 0x0000_0001_FFFF_FFFF,\n            0xFFFF_FFFE_FFFF_FFFF, 0x8000_0000_8000_0000];\n        let mut n = 0u64;\n        for &a in &v { for &f in &v {\n            let t = total(a, f);\n            let mut bs: Vec<u64> = v.clone();\n            if t <= u64::MAX as u128 { bs.push(t as u64); }\n            if t >= 1 && t - 1 <= u64::MAX as u128 { bs.push((t - 1) as u64); }\n            for &b in &bs { assert_eq!(authorize(b, a, f), policy(b, a, f), \"b={} a={} f={}\", b, a, f); n += 1; }\n        }}\n        eprintln!(\"boundary cases: {}\", n);\n    }\n    #[test]\n    fn random_diff() {\n        let mut s: u64 = 0x9E37_79B9_7F4A_7C15;\n        let mut next = || { s ^= s << 13; s ^= s >> 7; s ^= s << 17; s };\n        for i in 0..2_000_000u64 {\n            let a = next();\n            let f = match i % 4 { 0 => next(), 1 => next() >> 32, 2 => next() | 0xFFFF_FFFF_0000_0000, _ => next() & 0xFFFF_FFFF };\n            let t = total(a, f);\n            let b = match i % 3 { 0 => next(), 1 => if t <= u64::MAX as u128 { t as u64 } else { u64::MAX }, _ => if t >= 1 && t - 1 <= u64::MAX as u128 { (t - 1) as u64 } else { u64::MAX } };\n            assert_eq!(authorize(b, a, f), policy(b, a, f), \"b={} a={} f={}\", b, a, f);\n        }\n    }\n}\nEOF\ncd /tmp/rt && timeout 300 cargo test --release --offline -- --nocapture 2>&1 | tail -15; cd /workspace\n"]
