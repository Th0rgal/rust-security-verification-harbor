[94.845708, "o", "> def rust(b,a,f):\r\n\u001b[?2004l\r\u001b[?2004h>     x=(a&(R-1))+(f%P)*R\r\n\u001b[?2004l\r\u001b[?2004h>     assert x<M\r\n\u001b[?2004l\r\u001b[?2004h>     t=((x&(R-1))*MU)&(R-1)\r\n\u001b[?2004l\r\u001b[?2004h>     u=t*P; assert u<M\r\n\u001b[?2004l\r\u001b[?2004h>     diff=(x-u)%M; borrow=x<u\r\n\u001b[?2004l\r\u001b[?2004h>     hi=diff>>32\r\n\u001b[?2004l\r\u001b[?2004h>     s=hi+P-R if borrow else hi\r\n\u001b[?2004l\r\u001b[?2004h>     assert 0<=s<M\r\n\u001b[?2004l\r\u001b[?2004h>     tot=a+s\r\n\u001b[?2004l\r\u001b[?2004h>     if tot>=M: return None\r\n\u001b[?2004l\r\u001b[?2004h>     return tot if tot<=b else None\r\n\u001b[?2004l\r\u001b[?2004h> def spec(b,a,f):\r\n\u001b[?2004l\r\u001b[?2004h>     s=(((a%R)+(f%P)*R)*943718400)%P\r\n\u001b[?2004l\r\u001b[?2004h>     return a+s if a+s<=b else None\r\n\u001b[?2004l\r\u001b[?2004h> vals=[0,1,2,P-1,P,P+1,R-1,R,R+1,M-1,M-2,M-P,2*P,P*R-1]\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(300000):\r\n\u001b[?2004l\r\u001b[?2004h>     b=random.choice([random.randrange(M),M-1,random.choice(vals)])\r\n\u001b[?2004l\r\u001b[?2004h>     a=random.choice([random.randrange(M),random.choice(vals),M-1-random.randrange(P)])\r\n\u001b[?2004l\r\u001b[?2004h>     f=random.choice([random.randrange(M),random.choice(vals)])\r\n\u001b[?2004l\r\u001b[?2004h> "]
