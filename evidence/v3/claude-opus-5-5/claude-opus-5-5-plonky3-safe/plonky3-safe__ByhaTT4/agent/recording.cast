[1028.724135, "o", "theorem candidateSpec_conforms : Conforms candidateSpec challengeAuthorize := by\r\n\u001b[?2004l\r\u001b[?2004h"]
[1028.724168, "o", "> "]
[1028.724425, "o", "  refine ⟨fun b a f => ⟨?_, ?_⟩, fun b a f t h => ((auth_iff b a f t).mp h).2⟩\r\n\u001b[?2004l\r\u001b[?2004h"]
[1028.724458, "o", "> "]
[1028.724627, "o", "  · rintro ⟨t, h⟩; exact ((auth_iff b a f t).mp h).1\r\n\u001b[?2004l\r\u001b[?2004h"]
[1028.724667, "o", "> "]
[1028.7247, "o", "  · intro h\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1028.724883, "o", "    change a.toNat + surcharge a f ≤ b.toNat at h\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1028.724978, "o", "    have hb := b.toNat_lt\r\n\u001b[?2004l\r\u001b[?2004h"]
[1028.725054, "o", "> "]
[1028.725183, "o", "    have hn : a.toNat + surcharge a f < 2 ^ 64 := by omega\r\n\u001b[?2004l\r\u001b[?2004h"]
[1028.725255, "o", "> "]
[1028.725482, "o", "    refine ⟨UInt64.ofNat (a.toNat + surcharge a f), (auth_iff _ _ _ _).mpr ⟨h, ?_⟩⟩\r\n\u001b[?2004l\r\u001b[?2004h"]
[1028.725517, "o", ">     first\r\n\u001b[?2004l\r"]
[1028.725549, "o", "\u001b[?2004h> "]
[1028.725709, "o", "      | exact UInt64.toNat_ofNat_of_lt' hn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1028.72579, "o", "      | (simp <;> omega)\r\n\u001b[?2004l\r"]
[1028.725849, "o", "\u001b[?2004h> "]
[1028.726009, "o", "      | (rw [UInt64.toNat_ofNat']; exact Nat.mod_eq_of_lt hn)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1028.726045, "o", "> "]
[1028.726147, "o", "      | simp [Nat.mod_eq_of_lt hn]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1028.726234, "o", "EOF\r\n\u001b[?2004l\r"]
