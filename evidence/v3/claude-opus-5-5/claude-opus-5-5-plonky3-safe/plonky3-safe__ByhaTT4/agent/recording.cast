[902.168329, "o", "    generalize A - B = m at *\r\n\u001b[?2004l\r\u001b[?2004h>     clear hAB hd hr hPT hx hc htl\r\n\u001b[?2004l\r\u001b[?2004h>     omega\r\n\u001b[?2004l\r\u001b[?2004h>   · obtain ⟨hd, hqP, hr⟩ := nbRes _ _ _ (nbQ _ _ _ _ hAB hc) hx\r\n\u001b[?2004l\r\u001b[?2004h>     rw [hd, hr]\r\n\u001b[?2004l\r\u001b[?2004h>     generalize B - A = q at *\r\n\u001b[?2004l\r\u001b[?2004h> "]
[902.16849, "o", "    clear hAB hd hr hPT hx hc htl\r\n\u001b[?2004l\r\u001b[?2004h>     omega\r\n\u001b[?2004l\r\u001b[?2004h"]
[902.168523, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[902.168673, "o", "def surcharge (a f : UInt64) : Nat :=\r\n\u001b[?2004l\r\u001b[?2004h"]
[902.168712, "o", "> "]
[902.169001, "o", "  ((a.toNat % 4294967296 + (f.toNat % 2013265921) * 4294967296) * 943718400) % 2013265921\r\n\u001b[?2004l\r\u001b[?2004h"]
[902.169133, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[902.169372, "o", "theorem surcharge_lt (a f : UInt64) : surcharge a f < 2013265921 := Nat.mod_lt _ (by decide)\r\n\u001b[?2004l\r\u001b[?2004h"]
[902.169408, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[902.169697, "o", "theorem auth_iff (b a f t : UInt64) : challengeAuthorize b a f = some t ↔\r\n\u001b[?2004l\r\u001b[?2004h"]
[902.169809, "o", "> "]
[902.170032, "o", "    (a.toNat + surcharge a f ≤ b.toNat ∧ t.toNat = a.toNat + surcharge a f) := by\r\n\u001b[?2004l\r"]
[902.170183, "o", "\u001b[?2004h> "]
[902.170322, "o", "  have hx : (packTranscript a f).toNat < 2013265921 * 4294967296 := by\r\n\u001b[?2004l\r"]
[902.17042, "o", "\u001b[?2004h> "]
[902.17063, "o", "    rw [tp]; have := f.toNat_lt; omega\r\n\u001b[?2004l\r"]
[902.170687, "o", "\u001b[?2004h> "]
[902.170859, "o", "  have hm := mr _ hx\r\n\u001b[?2004l\r"]
[902.173053, "o", "\u001b[?2004h>   rw [tp] at hm\r\n\u001b[?2004l\r\u001b[?2004h>   have hs := surcharge_lt a f\r\n\u001b[?2004l\r\u001b[?2004h>   unfold surcharge at *\r\n\u001b[?2004l\r\u001b[?2004h>   unfold challengeAuthorize buildQuote verifyAffordability\r\n\u001b[?2004l\r\u001b[?2004h>   generalize montyReduce (packTranscript a f) = s at *\r\n\u001b[?2004l\r\u001b[?2004h>   generalize ((a.toNat % 4294967296 + (f.toNat % 2013265921) * 4294967296) * 943718400) % 2013265921 = S at *\r\n\u001b[?2004l\r\u001b[?2004h>   subst hm\r\n\u001b[?2004l\r\u001b[?2004h>   have ha := a.toNat_lt\r\n\u001b[?2004l\r\u001b[?2004h>   have hb := b.toNat_lt\r\n\u001b[?2004l\r\u001b[?2004h>   have ht := t.toNat_lt\r\n\u001b[?2004l\r\u001b[?2004h>   dsimp only\r\n\u001b[?2004l\r\u001b[?2004h>   by_cases h1 : s ≤ u64Max - a\r\n\u001b[?2004l\r\u001b[?2004h>   · rw [if_pos h1]\r\n\u001b[?2004l\r\u001b[?2004h>     dsimp only\r\n\u001b[?2004l\r\u001b[?2004h>     have h1' := h1\r\n\u001b[?2004l\r\u001b[?2004h>     simp only [UInt64.le_iff_toNat_le, UInt64.toNat_sub, u64Max] at h1'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[902.173176, "o", "    simp at h1'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[902.173374, "o", "    have hsum : (a + s).toNat = a.toNat + s.toNat := by simp; omega\r\n\u001b[?2004l\r"]
