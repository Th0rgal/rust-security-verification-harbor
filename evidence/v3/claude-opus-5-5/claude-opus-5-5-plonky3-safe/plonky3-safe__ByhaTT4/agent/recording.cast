[902.175272, "o", "    simp only [UInt64.le_iff_toNat_le, UInt64.toNat_sub, u64Max] at h1\r\n\u001b[?2004l\r\u001b[?2004h"]
[902.175341, "o", "> "]
[902.175382, "o", "    simp at h1\r\n\u001b[?2004l\r"]
[902.175454, "o", "\u001b[?2004h>     simp\r\n\u001b[?2004l\r"]
[902.175559, "o", "\u001b[?2004h>     omega\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[902.175626, "o", "\u001b[?2004h> "]
[902.175756, "o", "def candidateSpec : AuthorizationSpec where\r\n\u001b[?2004l\r"]
[902.175825, "o", "\u001b[?2004h> "]
[902.17597, "o", "  accepts b a f := a.toNat + surcharge a f ≤ b.toNat\r\n\u001b[?2004l\r"]
[902.176007, "o", "\u001b[?2004h> "]
