[1028.711707, "o", "\u001b[?2004h>     0 < m ∧ m < 2013265921 ∧ X * 943718400 % 2013265921 = 2013265921 - m := by\r\n\u001b[?2004l\r\u001b[?2004h>   have hm0 : 0 < m := by omega\r\n\u001b[?2004l\r\u001b[?2004h>   have hmP : m < 2013265921 := by omega\r\n\u001b[?2004l\r\u001b[?2004h>   have hK : X * 943718400 + 2013265921 * (2013265919 * m) + m = 2013265921 * (943718400 * T) := by omega\r\n\u001b[?2004l\r\u001b[?2004h>   have hr : (X * 943718400 + 2013265921 * (2013265919 * m)) % 2013265921 = 2013265921 - m := modP2 _ _ _ hK hm0 hmP\r\n\u001b[?2004l\r\u001b[?2004h>   rw [Nat.add_mul_mod_self_left] at hr\r\n\u001b[?2004l\r\u001b[?2004h>   have hd : (18446744073709551616 - 2013265921 * T + X) % 18446744073709551616 = 18446744073709551616 - 4294967296 * m := by omega\r\n\u001b[?2004l\r\u001b[?2004h>   exact ⟨hd, hm0, hmP, hr⟩\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
