[1028.71592, "o", "  have hAB := keyAB x.toNat t.toNat (x.toNat % 4294967296) (x.toNat / 4294967296) (2281701377 * (x.toNat % 4294967296) / 4294967296) (by omega) (by omega)\r\n\u001b[?2004l\r\u001b[?2004h"]
