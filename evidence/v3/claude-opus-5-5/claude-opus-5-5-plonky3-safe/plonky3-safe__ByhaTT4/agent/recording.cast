[902.174555, "o", "\u001b[?2004h>     · rw [if_neg h2]\r\n"]
[902.174628, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[902.174785, "o", "      rw [UInt64.le_iff_toNat_le, hsum] at h2\r\n\u001b[?2004l\r"]
