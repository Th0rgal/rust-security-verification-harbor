[94.84268, "i", "cat > /tmp/chk.py <<'EOF'\nimport random\nP=2013265921;MU=2281701377;R=2**32;M=2**64\ndef rust(b,a,f):\n    x=(a&(R-1))+(f%P)*R\n    assert x<M\n    t=((x&(R-1))*MU)&(R-1)\n    u=t*P; assert u<M\n    diff=(x-u)%M; borrow=x<u\n    hi=diff>>32\n    s=hi+P-R if borrow else hi\n    assert 0<=s<M\n    tot=a+s\n    if tot>=M: return None\n    return tot if tot<=b else None\ndef spec(b,a,f):\n    s=(((a%R)+(f%P)*R)*943718400)%P\n    return a+s if a+s<=b else None\nvals=[0,1,2,P-1,P,P+1,R-1,R,R+1,M-1,M-2,M-P,2*P,P*R-1]\nfor i in range(300000):\n    b=random.choice([random.randrange(M),M-1,random.choice(vals)])\n    a=random.choice([random.randrange(M),random.choice(vals),M-1-random.randrange(P)])\n    f=random.choice([random.randrange(M),random.choice(vals)])\n    if random.random()<0.3: b=a+(((a%R)+(f%P)*R)*943718400)%P - random.choice([0,1]) ; b=min(max(b,0),M-1)\n    assert rust(b,a,f)==spec(b,a,f),(b,a,f)\nprint('ok')\nEOF\npython3 /tmp/chk.py\n"]
[94.842937, "o", "cat > /tmp/chk.py <<'EOF'\r\n\u001b[?2004l\r"]
[94.843015, "o", "\u001b[?2004h> "]
