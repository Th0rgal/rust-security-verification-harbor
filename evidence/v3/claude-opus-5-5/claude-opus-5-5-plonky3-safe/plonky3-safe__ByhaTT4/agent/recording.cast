[902.176603, "o", "\u001b[?2004h> "]
[902.176863, "o", "  refine ⟨fun b a f => ⟨?_, ?_⟩, fun b a f t h => ((auth_iff b a f t).mp h).2⟩\r\n\u001b[?2004l\r"]
[902.176935, "o", "\u001b[?2004h> "]
[902.177119, "o", "  · rintro ⟨t, h⟩; exact ((auth_iff b a f t).mp h).1\r\n\u001b[?2004l\r\u001b[?2004h"]
[902.177201, "o", ">   · intro h\r\n\u001b[?2004l\r\u001b[?2004h"]
[902.17727, "o", "> "]
