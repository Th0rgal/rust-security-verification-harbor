[902.177391, "o", "\u001b[?2004h> "]
[902.177676, "o", "    refine ⟨UInt64.ofNat (a.toNat + surcharge a f), (auth_iff _ _ _ _).mpr ⟨h, ?_⟩⟩\r\n\u001b[?2004l\r"]
[902.177749, "o", "\u001b[?2004h> "]
[902.177872, "o", "    simp only [UInt64.toNat_ofNat]\r\n\u001b[?2004l\r\u001b[?2004h> "]
