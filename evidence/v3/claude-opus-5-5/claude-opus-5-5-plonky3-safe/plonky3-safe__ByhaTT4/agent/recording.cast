[1028.719404, "o", "  have hx : (packTranscript a f).toNat < 2013265921 * 4294967296 := by\r\n\u001b[?2004l\r"]
[1028.719441, "o", "\u001b[?2004h> "]
[1028.719552, "o", "    rw [tp]; have := f.toNat_lt; omega\r\n\u001b[?2004l\r\u001b[?2004h"]
[1028.719585, "o", "> "]
[1028.719695, "o", "  have hm := mr _ hx\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1028.71975, "o", "  rw [tp] at hm\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1028.71983, "o", "  have hs := surcharge_lt a f\r\n\u001b[?2004l\r\u001b[?2004h"]
[1028.719896, "o", "> "]
[1028.719962, "o", "  unfold surcharge at *\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1028.720134, "o", "  unfold challengeAuthorize buildQuote verifyAffordability\r\n\u001b[?2004l\r"]
[1028.720192, "o", "\u001b[?2004h> "]
[1028.720244, "o", "  try dsimp only\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1028.720409, "o", "  generalize montyReduce (packTranscript a f) = s at *\r\n\u001b[?2004l\r\u001b[?2004h"]
[1028.720444, "o", "> "]
[1028.720795, "o", "  generalize ((a.toNat % 4294967296 + (f.toNat % 2013265921) * 4294967296) * 943718400) % 2013265921 = S at *\r\n\u001b[?2004l\r\u001b[?2004h"]
[1028.720829, "o", "> "]
[1028.720868, "o", "  subst hm\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1028.720962, "o", "  have ha := a.toNat_lt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1028.721043, "o", "  have hb := b.toNat_lt\r\n\u001b[?2004l\r\u001b[?2004h"]
[1028.721075, "o", "> "]
[1028.721154, "o", "  have ht := t.toNat_lt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1028.721263, "o", "  by_cases h1 : s ≤ u64Max - a\r\n\u001b[?2004l\r\u001b[?2004h"]
[1028.721328, "o", "> "]
[1028.721377, "o", "  · rw [if_pos h1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1028.721435, "o", "    try dsimp only\r\n\u001b[?2004l\r"]
[1028.72151, "o", "\u001b[?2004h>     have h1' := h1\r\n\u001b[?2004l\r"]
[1028.721568, "o", "\u001b[?2004h> "]
[1028.721788, "o", "    simp only [UInt64.le_iff_toNat_le, UInt64.toNat_sub, u64Max] at h1'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1028.721927, "o", "    simp at h1'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1028.722101, "o", "    have hsum : (a + s).toNat = a.toNat + s.toNat := by simp; omega\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1028.722224, "o", "    by_cases h2 : a + s ≤ b\r\n\u001b[?2004l\r\u001b[?2004h"]
[1028.722297, "o", ">     · rw [if_pos h2]\r\n\u001b[?2004l\r"]
[1028.722332, "o", "\u001b[?2004h> "]
[1028.722475, "o", "      rw [UInt64.le_iff_toNat_le, hsum] at h2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1028.722608, "o", "      simp only [Option.some.injEq]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1028.722642, "o", "> "]
