[1028.723402, "o", "  · rw [if_neg h1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1028.723475, "o", "> "]
[1028.723644, "o", "    simp only [UInt64.le_iff_toNat_le, UInt64.toNat_sub, u64Max] at h1\r\n\u001b[?2004l\r"]
[1028.723682, "o", "\u001b[?2004h> "]
[1028.72376, "o", "    simp at h1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1028.723814, "o", "    simp\r\n\u001b[?2004l\r\u001b[?2004h> "]
