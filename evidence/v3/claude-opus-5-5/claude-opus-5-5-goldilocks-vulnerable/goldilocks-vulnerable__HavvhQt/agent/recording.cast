[139.856595, "o", "def policyDebit (amount fee : UInt64) : Nat :=\r\n\u001b[?2004l\r\u001b[?2004h>   amount.toNat / 2 + (amount.toNat + fee.toNat * 18446744073709551616) % 18446744069414584321\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
