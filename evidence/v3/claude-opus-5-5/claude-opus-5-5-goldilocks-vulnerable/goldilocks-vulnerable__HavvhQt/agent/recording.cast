[337.598169, "i", "python3 - <<'PY'\nimport random\nM=2**64; P=M-2**32+1; E=2**32-1\ndef red(a,f):\n    lo,mid,hi=a,f&E,f>>32\n    l2=(lo-hi)%M\n    if lo<hi: l2=(l2-E)%M\n    prod=mid*E; assert prod<M\n    s=l2+prod\n    if s>=M: s=(s-M+E)%M\n    return s-P if s>=P else s\ndef auth(b,a,f):\n    t=a//2+red(a,f)\n    if t>=M: return None\n    return t if t<=b else None\ndef pol(b,a,f):\n    t=a//2+(a+f*M)%P\n    return t if t<=b else None\nedge=[0,1,2,E-1,E,E+1,2**32,P-1,P,P+1,M-2,M-1,2**63,2**63-1]\nbad=0\nfor a in edge:\n  for f in edge+[E*2**32, (E<<32)|E]:\n    for b in edge:\n      if auth(b,a,f)!=pol(b,a,f): bad+=1\nfor _ in range(300000):\n    a,f=random.getrandbits(64),random.getrandbits(64)\n    t=a//2+(a+f*M)%P\n    for b in (random.getrandbits(64), min(t,M-1), max(t-1,0)):\n        if auth(b,a,f)!=pol(b,a,f): bad+=1\nprint('mismatches',bad)\nPY\n"]
