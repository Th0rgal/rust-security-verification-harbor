[139.878371, "o", "\u001b[32m\u001b[K29\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    pub \u001b[01;31m\u001b[Kfn fold_high_limb\u001b[m\u001b[K(low: u64, high: u64) -> u64 {\r\n\u001b[32m\u001b[K30\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        let (low2, borrow) = low.overflowing_sub(high);\r\n\u001b[32m\u001b[K31\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        // On borrow, low2 = low - high + 2^64; the canonical residue is\r\n\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        // low - high + P = low2 - EPSILON (no underflow since high < 2^32).\r\n\u001b[32m\u001b[K33\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if borrow {\r\n\u001b[32m\u001b[K34\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            low2.wrapping_sub(GOLDILOCKS_EPSILON)\r\n\u001b[32m\u001b[K35\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        } else {\r\n\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            low2\r\n\u001b[32m\u001b[K37\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        }\r\n"]
