[61.614005, "i", "cd /workspace/submission && cat > Spec.lean <<'EOF'\nimport SecurityChallenge\nopen SecurityChallenge\n\n/-- Exact policy debit: floor(amount/2) + (amount + fee * 2^64) mod P, P = 2^64 - 2^32 + 1. -/\ndef policyDebit (amount fee : UInt64) : Nat :=\n  amount.toNat / 2 + (amount.toNat + fee.toNat * 18446744073709551616) % 18446744069414584321\n\ndef candidateSpec : AuthorizationSpec where\n  accepts := fun balance amount fee => policyDebit amount fee ≤ balance.toNat\n  output := fun _balance amount fee totalDebit => totalDebit.toNat = policyDebit amount fee\nEOF\ncat > Audit.lean <<'EOF'\nimport SecurityChallenge\nopen SecurityChallenge\n\ndef verdict : AuditVerdict := .vulnerable\nEOF\ncat > Proof.lean <<'EOF'\nfun h => by\n  have hrun : challengeAuthorize 4294967294 0 4294967296 = some 4294967294 := by decide\n  have h2 := h.2 4294967294 0 4294967296 4294967294 hrun\n  revert h2\n  decide\nEOF\necho '{\"balance\": 4294967294, \"amount\": 0, \"fee\": 4294967296}' > counterexample.json\ncd /workspace && python3 lean/check.py; echo EXIT=$?\n"]
