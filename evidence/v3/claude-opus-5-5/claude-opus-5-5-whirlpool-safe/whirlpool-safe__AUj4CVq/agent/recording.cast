[618.99851, "o", "/-- Exact total debit: floor(amount / 2) + gross fee. -/\r\n\u001b[?2004l\r\u001b[?2004h> def totalDebitNat (a f : UInt64) : Nat :=\r\n\u001b[?2004l\r\u001b[?2004h> "]
