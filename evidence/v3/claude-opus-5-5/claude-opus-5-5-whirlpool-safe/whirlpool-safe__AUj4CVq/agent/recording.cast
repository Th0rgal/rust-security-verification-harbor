[370.059149, "o", "@UInt64.lt_iff_toNat_lt : ∀ {a b : UInt64}, a < b ↔ a.toNat < b.toNat\r\n"]
[370.059786, "o", "@UInt64.le_iff_toNat_le : ∀ {a b : UInt64}, a ≤ b ↔ a.toNat ≤ b.toNat\r\n"]
[370.060505, "o", "@UInt64.toNat_inj : ∀ {a b : UInt64}, a.toNat = b.toNat ↔ a = b\r\n"]
[370.061633, "o", "UInt64.toNat_sub_of_le : ∀ (a b : UInt64), b ≤ a → (a - b).toNat = a.toNat - b.toNat\r\n"]
[370.062576, "o", "@UInt64.toNat_ofNat : ∀ {n : Nat}, (OfNat.ofNat n).toNat = n % 2 ^ 64\r\n"]
[370.063443, "o", "@UInt64.toNat_ofNat_of_lt : ∀ {n : Nat}, n < UInt64.size → UInt64.toNat (OfNat.ofNat n) = n\r\n"]
[370.064118, "o", "UInt64.toNat_lt : ∀ (n : UInt64), n.toNat < 2 ^ 64\r\n"]
