[205.97091, "i", "mkdir -p /tmp/t && cd /tmp/t && cat > /workspace/submission/Spec.lean << 'EOF'\nimport SecurityChallenge\nopen SecurityChallenge\n\ndef totalDebitNat (a f : UInt64) : Nat :=\n  a.toNat / 2 + (a.toNat + f.toNat * 18446744073709551616 + 999999) / 1000000\n\ndef candidateSpec : AuthorizationSpec where\n  accepts b a f := totalDebitNat a f ≤ b.toNat\n  output b a f t := totalDebitNat a f ≤ b.toNat ∧ t.toNat = totalDebitNat a f\n\nnamespace CandidateAux\n\ntheorem divStep_spec (r w : UInt64) (hr : r.toNat < 1000000) (hw : w.toNat < 4294967296) :\n    (divStep r w).quot.toNat = (4294967296 * r.toNat + w.toNat) / 1000000 ∧\n    (divStep r w).rem.toNat = (4294967296 * r.toNat + w.toNat) % 1000000 := by\n  have h1 : (4294967296 : UInt64).toNat = 4294967296 := rfl\n  have h2 : (1000000 : UInt64).toNat = 1000000 := rfl\n  simp only [divStep, limbBase, feeRateMulValue, UInt64.toNat_div, UInt64.toNat_mod,\n    UInt64.toNat_add, UInt64.toNat_mul, h1, h2]\n  constructor <;> omega\n\nend CandidateAux\nEOF\nprintf 'import SecurityChallenge\\nopen SecurityChallenge\\n\\ndef verdict : AuditVerdict := .safe\\n' > /workspace/submission/Audit.lean\nprintf 'by\\n  sorry\\n' > /workspace/submission/Proof.lean\n(echo 'import SecurityChallenge'; tail -n +2 /workspace/submission/Spec.lean) > S.lean; time LEAN_PATH=/workspace/lean lean S.lean\n"]
