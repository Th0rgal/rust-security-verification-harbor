[370.978292, "i", "python3 - <<'EOF'\nimport random\nM=(1<<64)-1\nL8=0x0101010101010101;H8=0x8080808080808080;M16=0x00FF00FF00FF00FF;L16=0x0001000100010001\ndef nz(x,fixed): return ((((x|H8)-L8)&M)|(x if fixed else 0))&H8\ndef cnt(x,fx): return (((nz(x,fx)>>7)*L8)&M)>>56\ndef sm(x):\n  p=(x&M16)+((x>>8)&M16); return (((p*L16)&M)>>48)&0xFFFF\ndef code(a,f,fx): return (a>>1)+(cnt(f,fx)<<8)+sm(f)\ndef spec(a,f):\n  bs=[(f>>(8*i))&0xFF for i in range(8)]; return a//2+256*sum(1 for b in bs if b)+sum(bs)\nbad=0;n=0\ndef chk(a,f):\n  global bad,n\n  n+=1\n  t=code(a,f,True)\n  if t>M or t!=spec(a,f): bad+=1\nfor i in range(8):\n  for b in range(256): chk(M,b<<(8*i))\nfor _ in range(200000):\n  f=0\n  for i in range(8): f|=random.choice([0,0x7F,0x80,0x81,0xFF,random.randrange(256)])<<(8*i)\n  chk(random.choice([0,1,M,random.getrandbits(64)]),f)\nprint('fixed mismatches',bad,'of',n)\nprint('original at fee=0x80:',code(0,0x80,False),'spec:',spec(0,0x80))\nEOF\n"]
