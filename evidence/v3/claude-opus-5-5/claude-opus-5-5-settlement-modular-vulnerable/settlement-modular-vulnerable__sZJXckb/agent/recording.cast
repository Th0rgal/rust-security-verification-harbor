[270.276319, "i", "python3 - <<'EOF'\nimport random\nM=2**64;Q=1844674407370955;R=1616\ndef ceil_fold(a,f,fixed):\n    low=(a+f)%M; w=low<a\n    if w: return (Q+low//10000+((low%10000+R+9999)//10000))%M\n    b=(low+9999)%M\n    if b<low: return ((Q if fixed else low//10000)+(b+R)//10000)%M\n    return b//10000\ndef impl(bal,a,f,fixed):\n    g=ceil_fold(a,f,fixed); n=g-g//10\n    t=a+n\n    if t>=M: return None\n    return t if t<=bal else None\ndef spec(bal,a,f):\n    g=(a+f+9999)//10000; t=a+g-g//10\n    return t if t<=bal else None\nprint('orig cex:',impl(1660206966633859,0,M-9999,False),spec(1660206966633859,0,M-9999))\nedges=[0,1,9999,10000,M-1,M-2,M-9999,M-10000,M-1617,M-1616,M//2,10**12]\nbad=0\nfor _ in range(300000):\n    a=random.choice(edges+[random.randrange(M)]); f=random.choice(edges+[random.randrange(M)])\n    if random.random()<0.3: f=(random.randrange(M-20000,M)-a)%M\n    g=(a+f+9999)//10000; t=a+g-g//10\n    for bal in [random.randrange(M), min(t,M-1), max(t-1,0), M-1]:\n        if impl(bal,a,f,True)!=spec(bal,a,f): bad+=1\nprint('fixed"]
[270.276355, "i", " mismatches:',bad)\nEOF\n"]
