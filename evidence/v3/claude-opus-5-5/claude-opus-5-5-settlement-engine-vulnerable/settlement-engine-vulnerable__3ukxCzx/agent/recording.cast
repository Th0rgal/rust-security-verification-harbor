[297.914461, "i", "').write(s)\n\nM=2**64\ndef impl(b,a,f):\n    low=(a+f)%M; carry=a+f>=M\n    if carry:\n        fr=low%10000+1616; g=1844674407370955+low//10000+(fr+9999)//10000\n    else:\n        bi=(low+9999)%M\n        if bi<low: g=low//10000+((low%10000)+9999)//10000\n        else: g=bi//10000\n    net=g-g//10\n    if a+net>=M: return None\n    t=a+net\n    return t if t<=b else None\ndef spec(b,a,f):\n    g=(a+f+9999)//10000; t=a+g-g//10\n    return t if t<=b else None\nimport random\nvals=[0,1,9999,10000,10001,M-1,M-2,M-1616,M-1617,M-2000,M-9999,M-10000,M-10001]+[M-k for k in range(1,12000)]\nbad=0\nfor _ in range(200000):\n    a=random.choice(vals+[random.randrange(M)]); f=random.choice(vals+[random.randrange(M)])\n    t=a+((a+f+9999)//10000)-((a+f+9999)//10000)//10\n    for b in [t-1,t,t+1,M-1,0]:\n        if 0<=b<M and impl(b,a,f)!=spec(b,a,f): bad+=1\nfor k in range(0,20000):\n    for a in [0,1,5000]:\n        f=M-1-k-a\n        if f<0: continue\n        t=a+((a+f+9999)//10000)-((a+f+9999)//10000)//10\n        for b in [t-1,t]:\n            if i"]
