[1241.994793, "o", "  rw [← hN]\r\n\u001b[?2004l\r\u001b[?2004h>   unfold div2x1Mg10\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1241.99495, "o", "  dsimp only\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1241.995189, "o", "  generalize (u1 * mg10Reciprocal + u1 <<< 16 + u0 + 1 <<< 16) = X at hqf ⊢"]
[1241.997992, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   rw [← hqf]\r\n\u001b[?2004l\r\u001b[?2004h>   have hq1 : (X >>> 16).toNat = X.toNat / 65536 := by\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1241.99843, "o", "    simp [UInt64.toNat_shiftRight, Nat.shiftRight_eq_div_pow]"]
[1241.99853, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   have hq0 := mask_toNat X\r\n"]
[1241.998766, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1241.998922, "o", "  rw [← hq1, ← hq0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1241.999115, "o", "  generalize X >>> 16 = Q1 at hq1 ⊢\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1241.999202, "o", "  generalize X &&& limbMask = Q0 at hq0 ⊢"]
[1242.00007, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   have hQ1b : Q1.toNat ≤ 65536 := by omega\r\n\u001b[?2004l\r\u001b[?2004h>   have hm : (Q1 * mg10Divisor).toNat = Q1.toNat * 32771 := by\r\n\u001b[?2004l\r\u001b[?2004h>     rw [UInt64.toNat_mul, hD]; omega\r\n\u001b[?2004l\r\u001b[?2004h"]
[1242.000156, "o", "> "]
[1242.000321, "o", "  have hs : (subBias + u0).toNat = 3221225472 + u0.toNat := by\r\n\u001b[?2004l\r"]
[1242.000986, "o", "\u001b[?2004h>     rw [UInt64.toNat_add]; have : subBias.toNat = 3221225472 := rfl\r\n\u001b[?2004l\r\u001b[?2004h>     rw [this]; omega\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1242.001199, "o", "  have hsub : (subBias + u0 - Q1 * mg10Divisor).toNat = 3221225472 + u0.toNat - Q1.toNat * 32771 := by\r\n\u001b[?2004l\r\u001b[?2004h"]
[1242.001287, "o", "> "]
[1242.001423, "o", "    rw [UInt64.toNat_sub, hs, hm]; omega\r\n\u001b[?2004l\r"]
