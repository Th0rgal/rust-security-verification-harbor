[1242.003569, "o", "    have hadd : (R + mg10Divisor).toNat = R.toNat + 32771 := by\r\n\u001b[?2004l\r"]
[1242.003631, "o", "\u001b[?2004h> "]
[1242.00375, "o", "      rw [UInt64.toNat_add, hD]; omega\r\n\u001b[?2004l\r"]
