[1242.0017, "o", "  have hr := mask_toNat (subBias + u0 - Q1 * mg10Divisor)\r\n\u001b[?2004l\r"]
[1242.002098, "o", "\u001b[?2004h>   rw [hsub] at hr\r\n\u001b[?2004l\r\u001b[?2004h>   rw [← hr]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1242.002287, "o", "  generalize (subBias + u0 - Q1 * mg10Divisor &&& limbMask) = R at hr ⊢\r\n\u001b[?2004l\r\u001b[?2004h> "]
