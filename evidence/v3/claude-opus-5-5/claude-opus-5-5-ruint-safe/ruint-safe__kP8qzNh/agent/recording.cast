[48.283778, "i", "cat > /tmp/bf.c <<'EOF'\n#include <stdio.h>\n#include <stdint.h>\nint main(){uint64_t D=0x8003,V=0xFFF4,M=0xFFFF,S=0xC0000000ULL;long bad=0;\nfor(uint64_t u1=0;u1<D;u1++)for(uint64_t u0=0;u0<65536;u0++){\nuint64_t qf=u1*V+(u1<<16)+u0+(1ULL<<16);uint64_t q1=qf>>16,q0=qf&M;uint64_t r=(S+u0-q1*D)&M;uint64_t qc,rc;\nif(q0<r){qc=q1-1;rc=(r+D)&M;}else{qc=q1;rc=r;}\nuint64_t q=rc>=D?qc+1:qc;uint64_t t=((u1<<16)+u0)/D;\nif(q!=t){if(bad<10)printf(\"u1=%lu u0=%lu got=%lu want=%lu\\n\",u1,u0,q,t);bad++;}}\nprintf(\"bad=%ld\\n\",bad);}\nEOF\ngcc -O2 -o /tmp/bf /tmp/bf.c && time /tmp/bf\n"]
