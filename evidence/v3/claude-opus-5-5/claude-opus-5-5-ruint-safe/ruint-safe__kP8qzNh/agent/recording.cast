[1241.994046, "o", "\u001b[?2004hroot@22c379524544:/tmp/lt# cat >> U.lean <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> theorem div_correct (u1 u0 : UInt64) (h1 : u1.toNat < 32771) (h0 : u0.toNat < 65536) :\r\n\u001b[?2004l\r\u001b[?2004h>     (div2x1Mg10 u1 u0).toNat = (u1.toNat * 65536 + u0.toNat) / 32771 := by\r\n\u001b[?2004l\r\u001b[?2004h>   have hD : mg10Divisor.toNat = 32771 := rfl\r\n\u001b[?2004l\r\u001b[?2004h>   have hqf : (u1 * mg10Reciprocal + u1 <<< 16 + u0 + 1 <<< 16).toNat = 131060 * u1.toNat + u0.toNat + 65536 := by\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1241.994318, "o", "    simp [mg10Reciprocal, UInt64.toNat_add, UInt64.toNat_mul, UInt64.toNat_shiftLeft, Nat.shiftLeft_eq]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1241.994467, "o", "    omega\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1241.994615, "o", "  have hN := nat_core u1.toNat u0.toNat h1 h0\r\n\u001b[?2004l\r\u001b[?2004h> "]
