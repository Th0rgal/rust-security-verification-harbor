[1242.006519, "o", "    · have hoN : ¬ (32771 ≤ (R + mg10Divisor &&& limbMask).toNat) := fun h => ho (UInt64.le_iff_toNat_le.mpr (by rw [hD]; exact h))\r\n\u001b[?2004l\r"]
[1242.006556, "o", "\u001b[?2004h"]
[1242.006657, "o", "> "]
