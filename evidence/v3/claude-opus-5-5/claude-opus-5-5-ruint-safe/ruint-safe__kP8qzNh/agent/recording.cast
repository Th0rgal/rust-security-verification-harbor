[200.987213, "i", "mkdir -p /tmp/lt && cd /tmp/lt && cat > T.lean <<'EOF'\nimport SecurityChallenge\nopen SecurityChallenge\n\ntheorem mask_toNat (x : UInt64) : (x &&& 0xFFFF).toNat = x.toNat % 65536 := by\n  rw [UInt64.toNat_and]\n  have h : (0xFFFF : UInt64).toNat = 2^16 - 1 := rfl\n  rw [h, Nat.and_two_pow_sub_one_eq_mod]\n\ntheorem shl_toNat (x : UInt64) : (x <<< 16).toNat = (x.toNat * 65536) % 2^64 := by\n  simp [UInt64.toNat_shiftLeft, Nat.shiftLeft_eq]\n\ntheorem shr_toNat (x : UInt64) : (x >>> 16).toNat = x.toNat / 65536 := by\n  simp [UInt64.toNat_shiftRight, Nat.shiftRight_eq_div_pow]\n\nexample (a b : UInt64) : (a - b).toNat = (2^64 - b.toNat + a.toNat) % 2^64 := by\n  simp [UInt64.toNat_sub]\nEOF\nLEAN_PATH=/workspace/lean time lean T.lean\n"]
