[?2004lUInt64.toNat_add : ∀ (a b : UInt64), (a + b).toNat = (a.toNat + b.toNat) % 2 ^ 64
UInt64.toNat_sub : ∀ (a b : UInt64), (a - b).toNat = (2 ^ 64 - b.toNat + a.toNat) % 2 ^ 64
UInt64.toNat_mul : ∀ (a b : UInt64), (a * b).toNat = a.toNat * b.toNat % 2 ^ 64
UInt64.toNat_div : ∀ (a b : UInt64), (a / b).toNat = a.toNat / b.toNat
UInt64.toNat_mod : ∀ (a b : UInt64), (a % b).toNat = a.toNat % b.toNat
UInt64.toNat_and : ∀ (a b : UInt64), (a &&& b).toNat = a.toNat &&& b.toNat
UInt64.toNat_or : ∀ (a b : UInt64), (a ||| b).toNat = a.toNat ||| b.toNat
UInt64.toNat_shiftRight : ∀ (a b : UInt64), (a >>> b).toNat = a.toNat >>> (b.toNat % 64)
UInt64.toNat_shiftLeft : ∀ (a b : UInt64), (a <<< b).toNat = a.toNat <<< (b.toNat % 64) % 2 ^ 64
@UInt64.lt_iff_toNat_lt : ∀ {a b : UInt64}, a < b ↔ a.toNat < b.toNat
@UInt64.le_iff_toNat_le : ∀ {a b : UInt64}, a ≤ b ↔ a.toNat ≤ b.toNat
UInt64.toNat_lt : ∀ (n : UInt64), n.toNat < 2 ^ 64
@UInt64.toNat_inj : ∀ {a b : UInt64}, a.toNat = b.toNat ↔ a = b
@UInt64.toNat_ofNat : ∀ {n : Nat}, (OfNat.ofNat n).toNat = n % 2 ^ 64
@Nat.or_mod_two_pow : ∀ {a b n : Nat}, (a ||| b) % 2 ^ n = a % 2 ^ n ||| b % 2 ^ n
@Nat.and_mod_two_pow : ∀ {a b n : Nat}, (a &&& b) % 2 ^ n = a % 2 ^ n &&& b % 2 ^ n
@Nat.shiftRight_or_distrib : ∀ {i a b : Nat}, (a ||| b) >>> i = a >>> i ||| b >>> i
@Nat.shiftRight_and_distrib : ∀ {i a b : Nat}, (a &&& b) >>> i = a >>> i &&& b >>> i
Nat.and_two_pow_sub_one_eq_mod : ∀ (x n : Nat), x &&& 2 ^ n - 1 = x % 2 ^ n
Nat.shiftRight_eq_div_pow : ∀ (m n : Nat), m >>> n = m / 2 ^ n
Nat.shiftLeft_eq : ∀ (a b : Nat), a <<< b = a * 2 ^ b
