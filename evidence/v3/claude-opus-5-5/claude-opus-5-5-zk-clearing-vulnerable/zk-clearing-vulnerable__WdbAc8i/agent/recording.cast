[85.744742, "o", "\u001b[32m\u001b[K34\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kpub \u001b[01;31m\u001b[Kfn \u001b[m\u001b[Ku_nz8(x: u64) -> u64 {\r\n\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kpub \u001b[01;31m\u001b[Kfn \u001b[m\u001b[Kcount_nz_bytes(x: u64) -> u64 {\r\n\u001b[32m\u001b[K48\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kpub \u001b[01;31m\u001b[Kfn \u001b[m\u001b[Kcount_zero_bytes_swar(x: u64) -> u64 {"]
[85.744885, "o", "\r\n\u001b[32m\u001b[K54\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kpub \u001b[01;31m\u001b[Kfn \u001b[m\u001b[Khas_high_bit_byte(x: u64) -> bool {\r\n\u001b[32m\u001b[K62\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kpub \u001b[01;31m\u001b[Kfn \u001b[m\u001b[Ksum_bytes(x: u64) -> u64 {\r\n\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kpub \u001b[01;31m\u001b[Kfn \u001b[m\u001b[Ksum_even_bytes_swar(x: u64) -> u64 {\r\n\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kpub \u001b[01;31m\u001b[Kfn \u001b[m\u001b[Ksum_odd_bytes_swar(x: u64) -> u64 {\r\n"]
[85.74497, "o", "\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kpub \u001b[01;31m\u001b[Kfn \u001b[m\u001b[Kquote_calldata_lane_surcharge(fee: u64) -> CalldataLaneQuote {\r\n"]
[85.745098, "o", "\u001b[32m\u001b[K100\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kfn \u001b[m\u001b[Kswar_zero_and_single_byte_lanes() {\r\n\u001b[32m\u001b[K114\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kfn \u001b[m\u001b[Kswar_high_bit_0x80_bytes_detected_as_nonzero() {\r\n\u001b[32m\u001b[K130\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kfn \u001b[m\u001b[Kswar_all_0xff_max_word() {\r\n\u001b[32m\u001b[K139\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kfn \u001b[m\u001b[Kswar_mixed_byte_pattern_and_even_odd_partition() {\r\n"]
[85.748179, "o", "pub fn count_zero_bytes_swar(x: u64) -> u64 {\r\n    8u64 - count_nz_bytes(x)\r\n}\r\n"]
[85.749937, "o", "\r\n/// Checks whether any byte lane of `x` has its most significant bit (`0x80`) set.\r\n#[inline]\r\npub fn has_high_bit_byte(x: u64) -> bool {\r\n"]
[85.750337, "o", "    (x & H8_MASK) != 0u64\r\n}\r\n\r\n/// Computes the exact sum of all 8 bytes `b_0 + b_1 + ... + b_7` (`0..=2040`) of `x`\r\n/// using two-lane 16-bit SWAR accumulation (`M16_MASK`) followed by `L16_MASK`\r\n/// multiplication into the top 16-bit lane (`>> 48`).\r\n#[inline]\r\npub fn sum_bytes(x: u64) -> u64 {\r\n"]
[85.752111, "o", "pub fn canonical_sub_babybear(a: u64, b: u64) -> u64 {\r\n    if a >= b {\r\n        a - b\r\n"]
[85.752154, "o", "    } else {\r\n        (a + BABYBEAR_P) - b\r\n    }\r\n}"]
[85.752182, "o", "\r\n\r\n/// Quotes the STARK prover transcript commitment levy for `(amount, fee)`:\r\n"]
[85.752737, "o", "/// `prover_levy = monty_reduce(pack_transcript(amount, fee))`.\r\n#[inline]\r\npub fn quote_prover_transcript_levy(amount: u64, fee: u64) -> ProverLevyQuote {\r\n    let packed_transcript: u64 = pack_transcript(amount, fee);\r\n    let monty_t: u64 = monty_quotient(packed_transcript);\r\n    let prover_levy: u64 = monty_reduce(packed_transcript);\r\n    ProverLevyQuote {\r\n        packed_transcript,\r\n        monty_t,\r\n        prover_levy,\r\n    }\r\n}\r\n\r\n#[cfg(test)]\r\nmod tests {\r\n    use super::*;\r\n\r\n    #[test]\r\n    fn monty_reduce_zero_and_multiples_of_p() {\r\n        assert_eq!(monty_reduce(0u64), 0u64);\r\n        assert_eq!(monty_reduce(BABYBEAR_P), 0u64);\r\n        assert_eq!(monty_reduce(BABYBEAR_P * 42u64), 0u64);\r\n\u001b[?2004h"]
