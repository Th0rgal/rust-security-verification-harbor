[1128.719576, "o", "UInt64.toNat_add : ∀ (a b : UInt64), (a + b).toNat = (a.toNat + b.toNat) % 2 ^ 64\r\n"]
[1129.447926, "o", "UInt64.toNat_sub : ∀ (a b : UInt64), (a - b).toNat = (2 ^ 64 - b.toNat + a.toNat) % 2 ^ 64\r\n"]
[1129.450084, "o", "UInt64.toNat_mul : ∀ (a b : UInt64), (a * b).toNat = a.toNat * b.toNat % 2 ^ 64\r\n"]
[1129.452775, "o", "UInt64.toNat_div : ∀ (a b : UInt64), (a / b).toNat = a.toNat / b.toNat\r\n"]
[1129.453495, "o", "UInt64.toNat_mod : ∀ (a b : UInt64), (a % b).toNat = a.toNat % b.toNat\r\n"]
[1129.454441, "o", "UInt64.toNat_and : ∀ (a b : UInt64), (a &&& b).toNat = a.toNat &&& b.toNat\r\n"]
[1129.454945, "o", "UInt64.toNat_or : ∀ (a b : UInt64), (a ||| b).toNat = a.toNat ||| b.toNat\r\n"]
[1129.455685, "o", "UInt64.toNat_shiftRight : ∀ (a b : UInt64), (a >>> b).toNat = a.toNat >>> (b.toNat % 64)\r\n"]
[1129.456578, "o", "UInt64.toNat_shiftLeft : ∀ (a b : UInt64), (a <<< b).toNat = a.toNat <<< (b.toNat % 64) % 2 ^ 64\r\n"]
[1129.457182, "o", "@UInt64.lt_iff_toNat_lt : ∀ {a b : UInt64}, a < b ↔ a.toNat < b.toNat\r\n"]
[1129.457766, "o", "@UInt64.le_iff_toNat_le : ∀ {a b : UInt64}, a ≤ b ↔ a.toNat ≤ b.toNat\r\n"]
[1129.458279, "o", "UInt64.toNat_lt : ∀ (n : UInt64), n.toNat < 2 ^ 64\r\n"]
[1129.458847, "o", "@UInt64.toNat_inj : ∀ {a b : UInt64}, a.toNat = b.toNat ↔ a = b\r\n"]
[1129.459508, "o", "@UInt64.toNat_ofNat : ∀ {n : Nat}, (OfNat.ofNat n).toNat = n % 2 ^ 64\r\n"]
[1129.460418, "o", "@Nat.or_mod_two_pow : ∀ {a b n : Nat}, (a ||| b) % 2 ^ n = a % 2 ^ n ||| b % 2 ^ n\r\n"]
[1129.461316, "o", "@Nat.and_mod_two_pow : ∀ {a b n : Nat}, (a &&& b) % 2 ^ n = a % 2 ^ n &&& b % 2 ^ n\r\n"]
[1129.462003, "o", "@Nat.shiftRight_or_distrib : ∀ {i a b : Nat}, (a ||| b) >>> i = a >>> i ||| b >>> i\r\n"]
[1129.462698, "o", "@Nat.shiftRight_and_distrib : ∀ {i a b : Nat}, (a &&& b) >>> i = a >>> i &&& b >>> i\r\n"]
[1129.463392, "o", "Nat.and_two_pow_sub_one_eq_mod : ∀ (x n : Nat), x &&& 2 ^ n - 1 = x % 2 ^ n\r\n"]
[1129.463952, "o", "Nat.shiftRight_eq_div_pow : ∀ (m n : Nat), m >>> n = m / 2 ^ n\r\n"]
[1129.464538, "o", "Nat.shiftLeft_eq : ∀ (a b : Nat), a <<< b = a * 2 ^ b\r\n"]
[1129.586768, "o", "\u001b[?2004hroot@b6a024795075:/workspace# "]
