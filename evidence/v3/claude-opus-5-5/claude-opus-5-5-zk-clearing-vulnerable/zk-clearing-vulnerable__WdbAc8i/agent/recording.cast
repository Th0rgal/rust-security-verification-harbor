[172.938133, "o", "\u001b[0m\u001b[01;34mCli\u001b[0m  \u001b[01;34mLeanSearchClient\u001b[0m  \u001b[01;34mQq\u001b[0m  \u001b[01;34maeneas\u001b[0m  \u001b[01;34maesop\u001b[0m  \u001b[01;34mbatteries\u001b[0m  \u001b[01;34mhax\u001b[0m  \u001b[01;34mimportGraph\u001b[0m  \u001b[01;34mmathlib\u001b[0m  \u001b[01;34mplausible\u001b[0m  \u001b[01;34mproofwidgets\u001b[0m\r\n"]
[172.939429, "o", "\r\ndef challengeAuthorize (balance amount fee : UInt64) : Option UInt64 :=\r\n  authorizeBreakdown balance amount (computeClearingBreakdown amount fee)\r\n\r\nend LeanModel.ClearingPipeline\r\n"]
[172.941953, "o", "5:def bpsDenom : UInt64 := 10000\r\n6:def bpsMaxRem : UInt64 := 9999\r\n7:def u64ModBpsQuot : UInt64 := 1844674407370955\r\n8:def u64ModBpsRem : UInt64 := 1616\r\n9:def rebateDivisor : UInt64 := 10\r\n10:def makerRebateCapDivisor : UInt64 := 5\r\n11:def treasuryCutDivisor : UInt64 := 4\r\n12:def flashDenom : UInt64 := 5000\r\n13:def flashMaxRem : UInt64 := 4999\r\n14:def u64ModFlashQuot : UInt64 := 3689348814741910\r\n15:def u64ModFlashRem : UInt64 := 1616\r\n16:def institutionalBandMin : UInt64 := 10000000000000\r\n18:def mg10Divisor : UInt64 := 0x8003\r\n19:def mg10Reciprocal : UInt64 := 0xFFF4\r\n20:def limbMask : UInt64 := 0xFFFF\r\n21:def subBias : UInt64 := 0xC0000000\r\n22:def blobGasPerSlot : UInt64 := 131072\r\n24:def l8Mask : UInt64 := 0x0101010101010101\r\n25:def h8Mask : UInt64 := 0x8080808080808080\r\n26:def m16Mask : UInt64 := 0x00FF00FF00FF00FF\r\n27:def l16Mask : UInt64 := 0x0001000100010001\r\n28:def calldataNzByteShift : UInt64 := 8\r\n30:def babyBearP : UInt64 := 2013265921\r\n31:def babyBearMu : UInt64 := 2281701377\r\n32:def limbBase : UInt64 := 4294967296\r\n33:def low32Mask : UInt64 := 0xFFFFFFFF\r\n35:def goldilocksP : UInt64 := 0xFFFFFFFF00000001\r\n36:def goldilocksEps : UInt64 := 0xFFFFFFFF\r\n38:def codecTagMask : UInt64 := 0xFF\r\n39:def codecVersionV3 : UInt64 := 3\r\n40:def sequencerDomainTag : UInt64 := 0x5A\r\n42:def u64Max : UInt64 := 18446744073709551615\r\n"]
