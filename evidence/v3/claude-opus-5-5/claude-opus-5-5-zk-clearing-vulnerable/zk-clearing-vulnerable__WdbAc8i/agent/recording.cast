[809.046076, "o", "\u001b[?2004h> static uint64_t unz8(uint64_t x){uint64_t H=0x8080808080808080ULL,L=0x0101010101010101ULL;return (((x|H)-L)|x)&H;}\r\n\u001b[?2004l\r\u001b[?2004h> static uint64_t cnz(uint64_t x){return ((unz8(x)>>7)*0x0101010101010101ULL)>>56;}\r\n\u001b[?2004l\r\u001b[?2004h> static uint64_t sumb(uint64_t x){uint64_t m=0x00FF00FF00FF00FFULL;uint64_t ps=(x&m)+((x>>8)&m);return ((ps*0x0001000100010001ULL)>>48)&0xFFFF;}\r\n\u001b[?2004l\r\u001b[?2004h> "]
