[809.042591, "i", "clear; cat > /tmp/w/mg.c << 'EOF'\n#include <stdio.h>\n#include <stdint.h>\n#include <stdlib.h>\nstatic uint64_t mg(uint64_t u1,uint64_t u0){uint64_t qf=u1*0xFFF4ULL+(u1<<16)+u0+(1ULL<<16);uint64_t q1=qf>>16,q0=qf&0xFFFF;uint64_t r=(0xC0000000ULL+u0-q1*0x8003ULL)&0xFFFF;uint64_t qc,rc;if(q0<r){qc=q1-1;rc=(r+0x8003)&0xFFFF;}else{qc=q1;rc=r;}return rc>=0x8003?qc+1:qc;}\nstatic uint64_t unz8(uint64_t x){uint64_t H=0x8080808080808080ULL,L=0x0101010101010101ULL;return (((x|H)-L)|x)&H;}\nstatic uint64_t cnz(uint64_t x){return ((unz8(x)>>7)*0x0101010101010101ULL)>>56;}\nstatic uint64_t sumb(uint64_t x){uint64_t m=0x00FF00FF00FF00FFULL;uint64_t ps=(x&m)+((x>>8)&m);return ((ps*0x0001000100010001ULL)>>48)&0xFFFF;}\nint main(){long bad=0;for(uint64_t u1=0;u1<32771;u1++)for(uint64_t u0=0;u0<65536;u0++){uint64_t n=u1*65536+u0;if(mg(u1,u0)!=n/32771)bad++;}printf(\"mg bad %ld\\n\",bad);\nbad=0;uint64_t s=88172645463325252ULL;for(long i=0;i<200000000;i++){s^=s<<13;s^=s>>7;s^=s<<17;uint64_t x=s;if(i&1){uint64_t m=s*0x9E3779B97F4A7C15ULL;for(int k=0;k<8;k++)if((m>>(k*8))&1)x&=~(0xFFULL<<(8*k));}uint64_t c=0,t=0;for(int k=0;k<8;k++){uint64_t b=(x>>(8*k))&255;c+=b!=0;t+=b;}if(cnz(x)!=c||sumb(x)!=t)bad++;}printf(\"swar bad %ld\\n\",bad);return 0;}\nEOF\ngcc -O2 -o /tmp/w/mg /tmp/w/mg.c && time /tmp/w/mg\n"]
[809.042965, "o", "clear; cat > /tmp/w/mg.c << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
