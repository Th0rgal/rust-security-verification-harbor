[237.342459, "i", "mkdir -p /tmp/w && cat > /tmp/w/model.py << 'EOF'\nM=1<<64\nMASK=M-1\nD=10000;Q=1844674407370955;R=1616\ndef ceil_bps(a,f,fixed=False):\n    low=(a+f)&MASK; carry=low<a\n    if carry:\n        fr=(low%D)+R\n        return Q+low//D+(fr+9999)//D\n    b=(low+9999)&MASK\n    if b<low:\n        if fixed: return low//D+((low%D)+9999)//D\n        return low//D+((b+R)//D)\n    return b//D\ndef div_mg(u1,u0):\n    qf=(u1*0xFFF4+(u1<<16)+u0+(1<<16))&MASK\n    q1=qf>>16;q0=qf&0xFFFF\n    r=((0xC0000000+u0-q1*0x8003)&MASK)&0xFFFF\n    if q0<r: qc,rc=q1-1,(r+0x8003)&0xFFFF\n    else: qc,rc=q1,r\n    return qc+1 if rc>=0x8003 else qc\ndef unz8(x):\n    H=0x8080808080808080;L=0x0101010101010101\n    return ((((x|H)-L)&MASK)|x)&H\ndef cnz(x): return ((((unz8(x)>>7)*0x0101010101010101)&MASK)>>56)\ndef sumb(x):\n    m=0x00FF00FF00FF00FF\n    ps=(x&m)+((x>>8)&m)\n    return (((ps*0x0001000100010001)&MASK)>>48)&0xFFFF\nP=2013265921;MU=2281701377;LB=1<<32\ndef monty(x):\n    t=((x%LB)*MU)%LB\n    u=(P*t)&MASK\n    diff=(x-u)&MASK\n    hi=diff//LB\n    return (P+hi-LB)&MASK if x<u else hi\ndef rust(bal,a,f,fixed=False):\n    g=ceil_bps(a,f,fixed); net=g-g//10\n    blob=div_mg(f%0x8003,a&0xFFFF)\n    cd=(cnz(f)<<8)+sumb(f)\n    lev=monty((a%LB)+(f%P)*LB)\n    s=net+blob+cd+lev\n    assert s<M\n    if a+s>MASK: return None\n    t=a+s\n    return t if t<=bal else None\ndef spec_total(a,f):\n    g=(a+f+9999)//10000; net=g-g//10\n    blob=((f%32771)*65536+(a%65536))//32771\n    bs=[(f>>(8*i))&255 for i in range(8)]\n    cd=sum(256 for b in bs if b>0)+sum(bs)\n    lev=((a%LB)*pow(LB,-1,P)+f%P)%P\n    return a+net+blob+cd+lev\nEOF\ncd /tmp/w && python3 -c \"\nfrom model import *\nimport random\nprint(pow(LB,-1,P))\nbad=0\nfor i in range(200000):\n    k=random.choice([64,40,20,63,16])\n    a=random.getrandbits(k)%M; f=random.getrandbits(random.choice([64,33,8,60]))\n    if random.random()<0.3: a=(M-random.randint(1,20000)-f)%M\n    T=spec_total(a,f)\n    for fixed in (False,True):\n      r=rust(MASK,a,f,fixed)\n      exp=T if T<=MASK else None\n      if r!=exp:\n        if fixed: print('FIXED MISMATCH',a,f,r,exp)\n        else: bad+=1\nprint('orig mismatches',bad)\n\"\n"]
