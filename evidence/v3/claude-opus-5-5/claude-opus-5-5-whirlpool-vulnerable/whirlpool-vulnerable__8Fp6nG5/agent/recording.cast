[5.503828, "o", "challenge:\r\nCargo.lock\r\nCargo.toml\r\nsrc\r\ntarget\r\n\r\nchallenge/src:\r\nlib.rs\r\n\r\nchallenge/target:\r\nCACHEDIR.TAG\r\nrelease\r\n\r\nchallenge/target/release:\r\nbuild\r\ndeps\r\nexamples\r\nincremental\r\n\r\nchallenge/target/release/build:\r\n\r\nchallenge/target/release/deps:\r\nlibsettlement_gate-0aba5e1fc59a671e.rlib\r\nlibsettlement_gate-0aba5e1fc59a671e.rmeta\r\nsettlement_gate-0aba5e1fc59a671e.d\r\nsettlement_gate-ebd00f5d27994bc9\r\nsettlement_gate-ebd00f5d27994bc9.d\r\n\r\nchallenge/target/release/examples:\r\n\r\nchallenge/target/release/incremental:\r\n\r\nlean:\r\nSecurityChallenge.lean\r\nSecurityChallenge.olean\r\nSignature.lean\r\ncheck.py\r\nlean-toolchain\r\n\r\nsubmission:\r\nAudit.lean\r\nProof.lean\r\nSpec.lean\r\nsrc\r\n\r\nsubmission/src:\r\n"]
