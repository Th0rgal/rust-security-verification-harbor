[277.188565, "i", "python3 - <<'EOF'\nimport random\nM=(1<<64)-1;B=1<<32;D=10**6\ndef w(x):\n    assert x<=M, 'overflow'\n    return x\ndef fixed(b,a,f):\n    ws=[a&(B-1),a>>32,f&(B-1),f>>32]\n    r=0;q=[0]*4\n    for i in (3,2,1,0):\n        n=w(w(r*B)+ws[i]);q[i]=n//D;r=n%D\n    inc=1 if r>0 else 0\n    s0=w(q[0]+inc);r0=s0&(B-1);c0=s0>>32\n    s1=w(q[1]+c0);r1=s1&(B-1);c1=s1>>32\n    s2=w(q[2]+c1);r2=s2&(B-1);c2=s2>>32\n    r3=w(q[3]+c2)\n    if r2 or r3: return None\n    g=w(w(r1*B)+r0);p=a//2\n    if p+g>M: return None\n    t=p+g\n    return t if t<=b else None\ndef spec(b,a,f):\n    t=a//2+(a+f*2**64+D-1)//D\n    return t if t<=b else None\nedge=[0,1,2,D-1,D,D+1,B-1,B,B+1,M,M-1,M//2,999999,(M+1)//D,D*(B-1)+1]\nn=0\nfor a in edge:\n  for f in edge:\n    for b in edge+[a//2+(a+f*2**64+D-1)//D] if a//2+(a+f*2**64+D-1)//D<=M else edge:\n      assert fixed(b,a,f)==spec(b,a,f),(b,a,f);n+=1\nfor _ in range(300000):\n    a=random.getrandbits(random.choice([8,32,64]));f=random.getrandbits(random.choice([1,4,8,13]))\n    t=a//2+(a+f*2**64+D-1)//D\n    b=random.choice([random.getrandbits(64),min(t,M),max(t-1,0)])\n    assert fixed(b,a,f)==spec(b,a,f),(b,a,f);n+=1\nprint('OK',n)\nEOF\n"]
