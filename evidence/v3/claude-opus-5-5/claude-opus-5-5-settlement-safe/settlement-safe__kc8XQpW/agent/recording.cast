[318.70242, "o", "UInt64.toNat_add : ∀ (a b : UInt64), (a + b).toNat = (a.toNat + b.toNat) % 2 ^ 64\r\nUInt64.toNat_sub : ∀ (a b : UInt64), (a - b).toNat = (2 ^ 64 - b.toNat + a.toNat) % 2 ^ 64\r\nUInt64.toNat_sub_of_le : ∀ (a b : UInt64), b ≤ a → (a - b).toNat = a.toNat - b.toNat\r\nUInt64.toNat_div : ∀ (a b : UInt64), (a / b).toNat = a.toNat / b.toNat\r\nUInt64.toNat_mod : ∀ (a b : UInt64), (a % b).toNat = a.toNat % b.toNat\r\n@UInt64.le_iff_toNat_le : ∀ {a b : UInt64}, a ≤ b ↔ a.toNat ≤ b.toNat\r\n"]
[318.702704, "o", "@UInt64.lt_iff_toNat_lt : ∀ {a b : UInt64}, a < b ↔ a.toNat < b.toNat\r\n@UInt64.toNat_inj : ∀ {a b : UInt64}, a.toNat = b.toNat ↔ a = b\r\n@UInt64.toNat_ofNat : ∀ {n : Nat}, (OfNat.ofNat n).toNat = n % 2 ^ 64\r\n@UInt64.toNat_ofNat' : ∀ {n : Nat}, (UInt64.ofNat n).toNat = n % 2 ^ 64\r\n@UInt64.toNat_ofNat_of_lt : ∀ {n : Nat}, n < UInt64.size → UInt64.toNat (OfNat.ofNat n) = n\r\n@UInt64.ofNat_toNat : ∀ {x : UInt64}, UInt64.ofNat x.toNat = x\r\nC.lean:14:96: error: omega could not prove the goal:\r\na possible counterexample may satisfy the constraints\r\n  e ≥ 0\r\n  d ≥ 0\r\n  c ≥ 0\r\n  c + d ≤ 18446744073709551615\r\n  c + d - e ≥ 1\r\nwhere\r\n c := ↑a.toNat\r\n d := ↑b.toNat\r\n e := ↑(a + b).toNat\r\n"]
