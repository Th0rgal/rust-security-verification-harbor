[75.573402, "i", "mkdir -p /tmp/t && cd /tmp/t && cat > T.lean <<'EOF'\nimport SecurityChallenge\nopen SecurityChallenge\n\ntheorem tail (b a g : UInt64) :\n  (if g - g / 10 ≤ (18446744073709551615 : UInt64) - a then\n     (if a + (g - g / 10) ≤ b then some (a + (g - g / 10)) else none) else none)\n  = (if a.toNat + (g.toNat - g.toNat / 10) ≤ b.toNat then some (UInt64.ofNat (a.toNat + (g.toNat - g.toNat / 10))) else none) := by\n  have ha := a.toNat_lt\n  have hb := b.toNat_lt\n  have hg := g.toNat_lt\n  have hd : (g / 10).toNat = g.toNat / 10 := UInt64.toNat_div g 10\n  have hs : (g - g / 10).toNat = g.toNat - g.toNat / 10 := by\n    rw [UInt64.toNat_sub_of_le]; · rw [hd]\n    rw [UInt64.le_iff_toNat_le, hd]; omega\n  by_cases c1 : g.toNat - g.toNat / 10 ≤ 18446744073709551615 - a.toNat\n  · have e1 : g - g / 10 ≤ (18446744073709551615 : UInt64) - a := by\n      rw [UInt64.le_iff_toNat_le, hs, UInt64.toNat_sub_of_le] <;> simp <;> omega\n    have ht : (a + (g - g / 10)).toNat = a.toNat + (g.toNat - g.toNat / 10) := by\n      rw [UInt"]
[75.573445, "i", "64.toNat_add, hs]; omega\n    rw [if_pos e1]\n    by_cases c2 : a.toNat + (g.toNat - g.toNat / 10) ≤ b.toNat\n    · rw [if_pos (by rw [UInt64.le_iff_toNat_le, ht]; exact c2), if_pos c2]\n      congr 1; apply UInt64.toNat_inj.mp; rw [ht, UInt64.toNat_ofNat]; omega\n    · rw [if_neg (by rw [UInt64.le_iff_toNat_le, ht]; exact c2), if_neg c2]\n  · have e1 : ¬ g - g / 10 ≤ (18446744073709551615 : UInt64) - a := by\n      rw [UInt64.le_iff_toNat_le, hs, UInt64.toNat_sub_of_le] <;> simp <;> omega\n    rw [if_neg e1, if_neg (by omega)]\nEOF\nLEAN_PATH=/workspace/lean lean T.lean\n"]
