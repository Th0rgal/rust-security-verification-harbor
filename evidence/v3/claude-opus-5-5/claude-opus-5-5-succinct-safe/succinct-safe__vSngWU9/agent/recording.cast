[855.846184, "o", "\u001b[?2004h> "]
[855.846519, "o", "      + 2^64 * ((z1+z2+z3+z4+z5+z6+z7) + 256*(z2+z3+z4+z5+z6+z7) + 65536*(z3+z4+z5+z6+z7)\r\n\u001b[?2004l\r"]
