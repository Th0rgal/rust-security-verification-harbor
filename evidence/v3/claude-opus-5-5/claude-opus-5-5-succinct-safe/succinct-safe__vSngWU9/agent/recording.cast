[855.842341, "o", "\u001b[?2004h> "]
[855.842686, "o", "    (or256 (by omega) h0) (or256 (by omega) h1) (or256 (by omega) h2) (or256 (by omega) h3)\r\n\u001b[?2004l\r"]
