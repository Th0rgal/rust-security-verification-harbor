[794.108642, "o", "  unfold pk\r\n\u001b[?2004l\r"]
[794.109109, "o", "\u001b[?2004h>   rw [and_split a0 _ c0 _ ha0 hc0, and_split a1 _ c1 _ ha1 hc1, and_split a2 _ c2 _ ha2 hc2,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[794.109322, "o", "    and_split a3 _ c3 _ ha3 hc3, and_split a4 _ c4 _ ha4 hc4, and_split a5 _ c5 _ ha5 hc5,\r\n\u001b[?2004l\r\u001b[?2004h"]
