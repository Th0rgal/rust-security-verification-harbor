[207.353209, "o", "\r\n@Nat.and_mod_two_pow : ∀ {a b n : Nat}, (a &&& b) % 2 ^ n = a % 2 ^ n &&& b % 2 ^ n\r\n@Nat.shiftRight_or_distrib : ∀ {i a b : Nat}, (a ||| b) >>> i = a >>> i ||| b >>> i\r\n@Nat.shiftRight_and_distrib : ∀ {i a b : Nat}, (a &&& b) >>> i = a >>> i &&& b >>> i\r\nNat.and_two_pow_sub_one_eq_mod : ∀ (x n : Nat), x &&& 2 ^ n - 1 = x % 2 ^ n\r\n"]
