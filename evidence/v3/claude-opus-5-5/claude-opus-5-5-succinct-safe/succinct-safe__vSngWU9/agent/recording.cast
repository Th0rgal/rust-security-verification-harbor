[855.837256, "o", "        - pk 1 1 1 1 1 1 1 1) ||| pk x0 x1 x2 x3 x4 x5 x6 x7) &&& pk 128 128 128 128 128 128 128 128\r\n\u001b[?2004l\r\u001b[?2004h"]
[855.837298, "o", "> "]
