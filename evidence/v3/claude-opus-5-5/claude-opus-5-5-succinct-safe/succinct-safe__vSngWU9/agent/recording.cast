[794.107897, "o", "> "]
[794.108007, "o", "    pk a0 a1 a2 a3 a4 a5 a6 a7 &&& pk c0 c1 c2 c3 c4 c5 c6 c7 =\r\n\u001b[?2004l\r"]
[794.108144, "o", "\u001b[?2004h> "]
[794.108321, "o", "      pk (a0 &&& c0) (a1 &&& c1) (a2 &&& c2) (a3 &&& c3) (a4 &&& c4) (a5 &&& c5)\r\n\u001b[?2004l\r\u001b[?2004h"]
[794.108404, "o", "> "]
