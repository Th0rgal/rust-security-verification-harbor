[855.845454, "o", "\u001b[?2004h> "]
[855.845699, "o", "        + 4294967296*(z0+z1+z2+z3+z4) + 1099511627776*(z0+z1+z2+z3+z4+z5)\r\n\u001b[?2004l\r"]
