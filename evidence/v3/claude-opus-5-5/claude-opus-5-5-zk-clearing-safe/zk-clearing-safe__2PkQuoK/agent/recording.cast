[758.443347, "o", "UInt64.toNat_add : ∀ (a b : UInt64), (a + b).toNat = (a.toNat + b.toNat) % 2 ^ 64\r\nUInt64.toNat_sub : ∀ (a b : UInt64), (a - b).toNat = (2 ^ 64 - b.toNat + a.toNat) % 2 ^ 64\r\nUInt64.toNat_mul : ∀ (a b : UInt64), (a * b).toNat = a.toNat * b.toNat % 2 ^ 64\r\nUInt64.toNat_div : ∀ (a b : UInt64), (a / b).toNat = a.toNat / b.toNat\r\nUInt64.toNat_mod : ∀ (a b : UInt64), (a % b).toNat = a.toNat % b.toNat\r\nUInt64.toNat_or : ∀ (a b : UInt64), (a ||| b).toNat = a.toNat ||| b.toNat\r\nUInt64.toNat_and : ∀ (a b : UInt64), (a &&& b).toNat = a.toNat &&& b.toNat\r\nUInt64.toNat_shiftRight : ∀ (a b : UInt64), (a >>> b).toNat = a.toNat >>> (b.toNat % 64)\r\nUInt64.toNat_shiftLeft : ∀ (a b : UInt64), (a <<< b).toNat = a.toNat <<< (b.toNat % 64) % 2 ^ 64\r\n@UInt64.le_iff_toNat_le : ∀ {a b : UInt64}, a ≤ b ↔ a.toNat ≤ b.toNat\r\n@UInt64.lt_iff_toNat_lt : ∀ {a b : UInt64}, a < b ↔ a.toNat < b.toNat\r\nUInt64.toNat_lt : ∀ (n : UInt64), n.toNat < 2 ^ 64\r\nt.lean:14:8: error(lean.unknownIdentifier): Unknown constant `Nat.testBit_mul_pow_two_add`\r\n@Nat.eq_of_testBit_eq : ∀ {x y : Nat}, (∀ (i : Nat), x.testBit i = y.testBit i) → x = y\r\nNat.testBit_or : ∀ (x y i : Nat), (x ||| y).testBit i = (x.testBit i || y.testBit i)\r\nNat.testBit_and : ∀ (x y i : Nat), (x &&& y).testBit i = (x.testBit i && y.testBit i)\r\n@Nat.or_lt_two_pow : ∀ {x y n : Nat}, x < 2 ^ n → y < 2 ^ n → x ||| y < 2 ^ n\r\nNat.and_lt_two_pow : ∀ (x : Nat) {y n : Nat}, y < 2 ^ n → x &&& y < 2 ^ n\r\nNat.shiftRight_eq_div_pow : ∀ (m n : Nat), m >>> n = m / 2 ^ n\r\nNat.shiftLeft_eq : ∀ (a b : Nat), a <<< b = a * 2 ^ b\r\nNat.and_two_pow_sub_one_eq_mod : ∀ (x n : Nat), x &&& 2 ^ n - 1 = x % 2 ^ n\r\n@UInt64.toNat_ofNat : ∀ {n : Nat}, (OfNat.ofNat n).toNat = n % 2 ^ 64\r\nt.lean:24:8: error(lean.unknownIdentifier): Unknown constant `UInt64.ext_iff`\r\n"]
