[51.799582, "o", "\u001b[35m\u001b[Kchallenge/src/goldilocks_field.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K reduce_goldilocks_step1(x_lo: u64, x_hi: u64) -> (u64, bool) {\r\n\u001b[35m\u001b[Kchallenge/src/goldilocks_field.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K reduce_goldilocks_128(x_lo: u64, x_hi: u64) -> u64 {\r\n\u001b[35m\u001b[Kchallenge/src/goldilocks_field.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K56\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K canonicalize_goldilocks_u64(x: u64) -> u64 {\r\n\u001b[35m\u001b[Kchallenge/src/goldilocks_field.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K add_goldilocks_mod(a: u64, b: u64) -> u64 {\r\n\u001b[35m\u001b[Kchallenge/src/goldilocks_field.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K72\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K sub_goldilocks_mod(a: u64, b: u64) -> u64 {\r\n\u001b[35m\u001b[Kchallenge/src/goldilocks_field.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K fold_goldilocks_challenge(commitment: u64, challenge_u32: u64) -> u64 {\r\n\u001b[35m\u001b[Kchallenge/src/goldilocks_field.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K98\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K quote_bridge_verifier_fee(amount: u64, fee: u64) -> GoldilocksQuote {\r\n\u001b[35m\u001b[Kchallenge/src/liquidity_pool.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K4\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kuse crate\u001b[m\u001b[K::constants::*;\r\n\u001b[35m\u001b[Kchallenge/src/liquidity_pool.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K5\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kuse crate\u001b[m\u001b[K::fee_schedule::FeeQuote;\r\n\u001b[35m\u001b[Kchallenge/src/liquidity_pool.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K6\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kuse crate\u001b[m\u001b[K::word_math::{add_u64_with_carry, ceil_div_flash_u64, floor_div_flash_u64};\r\n\u001b[35m\u001b[Kchallenge/src/liquidity_pool.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K26\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K split_pool_reserve(quote: FeeQuote) -> PoolReserveQuote {\r\n\u001b[35m\u001b[Kchallenge/src/liquidity_pool.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K37\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K quote_lp_retention(quote: FeeQuote) -> u64 {\r\n\u001b[35m\u001b[Kchallenge/src/liquidity_pool.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K assess_flash_fee_ceil(principal: u64, surcharge: u64) -> u64 {\r\n\u001b[35m\u001b[Kchallenge/src/liquidity_pool.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K53\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K assess_flash_fee_floor(principal: u64, surcharge: u64) -> u64 {\r\n\u001b[35m\u001b[Kchallenge/src/liquidity_pool.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K60\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K quote_flash_repayment(principal: u64, surcharge: u64) -> Option<FlashLoanReceipt> {\r\n\u001b[35m\u001b[Kchallenge/src/liquidity_pool.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K73\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K check_pool_reserve_solvency(current_reserve: u64, quote: FeeQuote, min_reserve: u64) -> bool {\r\n\u001b[35m\u001b[Kchallenge/src/liquidity_pool.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kuse crate\u001b[m\u001b[K::fee_schedule::evaluate_settlement_fee;\r\n\u001b[35m\u001b[Kchallenge/src/transcript_codec.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K3\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kuse crate\u001b[m\u001b[K::constants::*;\r\n\u001b[35m\u001b[Kchallenge/src/transcript_codec.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K4\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kuse crate\u001b[m\u001b[K::word_math::{extract_high_u32, extract_low_u32};\r\n\u001b[35m\u001b[Kchallenge/src/transcript_codec.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K18\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K decode_domain_tag(word: u64) -> u64 {\r\n\u001b[35m\u001b[Kchallenge/src/transcript_codec.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K29\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K build_transcript_header(amount: u64, fee: u64) -> TranscriptHeader {\r\n\u001b[35m\u001b[Kchallenge/src/transcript_codec.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K verify_header_version(header: TranscriptHeader) -> bool {\r\n\u001b[35m\u001b[Kchallenge/src/transcript_codec.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K51\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K fold_header_digest(header: TranscriptHeader) -> u64 {\r\n\u001b[35m\u001b[Kchallenge/src/transcript_codec.rs\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K57\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kpub fn\u001b[m\u001b[K mix_batch_header_digests(left"]
