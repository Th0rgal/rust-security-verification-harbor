[1571.489903, "i", "cat > mg.lean <<'EOF'\nimport SecurityChallenge\nset_option linter.unusedSimpArgs false\nset_option maxRecDepth 100000\nopen SecurityChallenge LeanModel.Constants LeanModel.ReciprocalDiv\n\ntheorem and_ffff (x : UInt64) : (x &&& 65535).toNat = x.toNat % 65536 := by\n  rw [UInt64.toNat_and]\n  have : (65535 : UInt64).toNat = 2 ^ 16 - 1 := rfl\n  rw [this, Nat.and_two_pow_sub_one_eq_mod]\n\ntheorem mg_eq (u1 u0 : UInt64) (h1 : u1.toNat < 32771) (h0 : u0.toNat < 65536) :\n    (div2x1Mg10 u1 u0).toNat = (u1.toNat * 65536 + u0.toNat) / 32771 := by\n  simp only [div2x1Mg10, mg10Reciprocal, mg10Divisor, limbMask, subBias]\n  split <;> rename_i hc <;> split <;> rename_i hd <;>\n    simp only [UInt64.lt_iff_toNat_lt, UInt64.le_iff_toNat_le, and_ffff, UInt64.toNat_sub, UInt64.toNat_add,\n      UInt64.toNat_mul, UInt64.toNat_shiftRight, UInt64.toNat_shiftLeft, UInt64.toNat_ofNat,\n      Nat.shiftRight_eq_div_pow, Nat.shiftLeft_eq, Nat.reducePow, Nat.reduceMod, Nat.reduceMul] at * <;>\n    omega\nEOF\ntime LEAN_PATH=/workspace/lean lean mg.lean 2>&1 | head -30; echo DONE\n"]
