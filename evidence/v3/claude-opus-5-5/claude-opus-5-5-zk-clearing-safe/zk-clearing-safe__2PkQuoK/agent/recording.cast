[444.986186, "o", "fn reference(b:u64,a:u64,f:u64)->Option<u64>{"]
[444.986893, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[444.987123, "o", "  let s=a as u128+f as u128; let g=(s+9999)/10000; let net=g-g/10;\r\n\u001b[?2004l\r"]
[444.987241, "o", "\u001b[?2004h> "]
[444.987462, "o", "  let h=(f%32771) as u128; let l=(a&0xFFFF) as u128; let blob=(h*65536+l)/32771;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[444.9878, "o", "  let mut cd:u128=0; for i in 0..8 { let by=((f>>(8*i))&0xFF) as u128; if by>0 {cd+=256;} cd+=by; }\r\n\u001b[?2004l\r"]
[444.98792, "o", "\u001b[?2004h> "]
[444.9881, "o", "  let p:u128=2013265921; let rinv:u128=943718400;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[444.98838, "o", "  let x=(a as u128 % 4294967296)+(f as u128 % p)*4294967296; let lev=(x%p)*rinv%p;\r\n\u001b[?2004l\r"]
[444.988418, "o", "\u001b[?2004h"]
[444.988589, "o", "> "]
[444.988716, "o", "  let t=a as u128+net+blob+cd+lev;\r\n\u001b[?2004l\r"]
[444.988801, "o", "\u001b[?2004h> "]
[444.988999, "o", "  if t<=b as u128 {Some(t as u64)} else {None}\r\n\u001b[?2004l\r"]
[444.989157, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[444.989203, "o", "\u001b[?2004h> "]
[444.989335, "o", "struct R(u64);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[444.989656, "o", "impl R{fn n(&mut self)->u64{self.0^=self.0<<13;self.0^=self.0>>7;self.0^=self.0<<17;self.0}}\r\n\u001b[?2004l\r"]
[444.989714, "o", "\u001b[?2004h> "]
[444.990443, "o", "fn pick(r:&mut R)->u64{ let v=r.n(); match v%8 {0=>v,1=>u64::MAX-(r.n()%100000),2=>r.n()%100000,3=>r.n()&0xFFFF_FFFF,4=>v&0x8080_8080_8080_8080,5=>(r.n()%65536)*32771+(r.n()%3),6=>u64::MAX/2+(r.n()%1000)-500,_=>r.n()>>(r.n()%64)} }\r\n\u001b[?2004l\r\u001b[?2004h"]
[444.990532, "o", "> fn main(){\r\n\u001b[?2004l\r"]
[444.990593, "o", "\u001b[?2004h> "]
[444.990739, "o", "  let args:Vec<String>=std::env::args().collect();\r\n\u001b[?2004l\r"]
[444.990836, "o", "\u001b[?2004h> "]
[444.992333, "o", "  if args.len()>1 && args[1]==\"mg\" {\r\n\u001b[?2004l\r\u001b[?2004h>     let mut bad=0u64;\r\n\u001b[?2004l\r\u001b[?2004h>     for u1 in 0..32771u64 { for u0 in 0..65536u64 { let q=reciprocal_div::div_2x1_mg10(u1,u0); if q!=((u1<<16)+u0)/32771 { if bad<5 {println!(\"MG bad u1={} u0={} got {} want {}\",u1,u0,q,((u1<<16)+u0)/32771);} bad+=1; } } }\r\n\u001b[?2004l\r\u001b[?2004h>     println!(\"mg mismatches {}\",bad); return;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   let mut r=R(0x9E3779B97F4A7C15); let mut bad=0u64;\r\n\u001b[?2004l\r\u001b[?2004h>   for _ in 0..30_000_000u64 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[444.992431, "o", "    let a=pick(&mut r); let f=pick(&mut r);\r\n\u001b[?2004l\r\u001b[?2004h"]
[444.992493, "o", "> "]
[444.992739, "o", "    let rf=reference(u64::MAX,a,f); let got=authorize(u64::MAX,a,f).map(|z|z.total_debit);\r\n\u001b[?2004l\r"]
[444.992817, "o", "\u001b[?2004h> "]
[444.99325, "o", "    let rb=match rf {Some(t)=>t, None=>{ if got.is_some(){ println!(\"ACCEPT-OVF a={} f={} got={:?}\",a,f,got); bad+=1;} continue; }};\r\n\u001b[?2004l\r\u001b[?2004h"]
[444.993295, "o", "> "]
[444.99344, "o", "    for b in [rb, rb.wrapping_sub(1), 0u64] {\r\n\u001b[?2004l\r\u001b[?2004h"]
[444.99347, "o", "> "]
[444.993721, "o", "      let e=reference(b,a,f); let g=authorize(b,a,f).map(|z|z.total_debit);\r\n\u001b[?2004l\r"]
[444.99375, "o", "\u001b[?2004h> "]
[444.994101, "o", "      if e!=g { if bad<20 {println!(\"MISMATCH b={} a={} f={} exp={:?} got={:?}\",b,a,f,e,g);} bad+=1; }\r\n\u001b[?2004l\r"]
[444.994131, "o", "\u001b[?2004h> "]
[444.994163, "o", "    }\r\n\u001b[?2004l\r"]
[444.994195, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[444.994312, "o", "\u001b[?2004h> "]
[444.994395, "o", "  println!(\"fuzz mismatches {}\",bad);\r\n\u001b[?2004l\r"]
[444.994461, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[444.994529, "o", "> EOF\r\n\u001b[?2004l\r"]
[444.995962, "o", "\u001b[?2004hroot@07b8edb2de26:/tmp/fz# "]
