[340.326433, "o", "\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K bpsDenom : UInt64 := 10000\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K bpsMaxRem : UInt64 := 9999\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K u64ModBpsQuot : UInt64 := 1844674407370955\r\n"]
[340.326565, "o", "\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K u64ModBpsRem : UInt64 := 1616\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K rebateDivisor : UInt64 := 10\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K makerRebateCapDivisor : UInt64 := 5\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K treasuryCutDivisor : UInt64 := 4\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K flashDenom : UInt64 := 5000\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K flashMaxRem : UInt64 := 4999\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K u64ModFlashQuot : UInt64 := 3689348814741910\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K u64ModFlashRem : UInt64 := 1616\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K institutionalBandMin : UInt64 := 10000000000000\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K mg10Divisor : UInt64 := 0x8003\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K mg10Reciprocal : UInt64 := 0xFFF4\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K limbMask : UInt64 := 0xFFFF\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K subBias : UInt64 := 0xC0000000\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K blobGasPerSlot : UInt64 := 131072\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K l8Mask : UInt64 := 0x0101010101010101\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K h8Mask : UInt64 := 0x8080808080808080\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K m16Mask : UInt64 := 0x00FF00FF00FF00FF\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K l16Mask : UInt64 := 0x0001000100010001\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K calldataNzByteShift : UInt64 := 8\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K babyBearP : UInt64 := 2013265921\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K babyBearMu : UInt64 := 2281701377\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K limbBase : UInt64 := 4294967296\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K low32Mask : UInt64 := 0xFFFFFFFF\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K goldilocksP : UInt64 := 0xFFFFFFFF00000001\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K goldilocksEps : UInt64 := 0xFFFFFFFF\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K codecTagMask : UInt64 := 0xFF\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K codecVersionV3 : UInt64 := 3\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K sequencerDomainTag : UInt64 := 0x5A\r\n\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K u64Max : UInt64 := 18446744073709551615\r\n"]
