[444.984751, "i", "cat > src/main.rs <<'EOF'\nuse settlement_gate::*;\nfn reference(b:u64,a:u64,f:u64)->Option<u64>{\n  let s=a as u128+f as u128; let g=(s+9999)/10000; let net=g-g/10;\n  let h=(f%32771) as u128; let l=(a&0xFFFF) as u128; let blob=(h*65536+l)/32771;\n  let mut cd:u128=0; for i in 0..8 { let by=((f>>(8*i))&0xFF) as u128; if by>0 {cd+=256;} cd+=by; }\n  let p:u128=2013265921; let rinv:u128=943718400;\n  let x=(a as u128 % 4294967296)+(f as u128 % p)*4294967296; let lev=(x%p)*rinv%p;\n  let t=a as u128+net+blob+cd+lev;\n  if t<=b as u128 {Some(t as u64)} else {None}\n}\nstruct R(u64);\nimpl R{fn n(&mut self)->u64{self.0^=self.0<<13;self.0^=self.0>>7;self.0^=self.0<<17;self.0}}\nfn pick(r:&mut R)->u64{ let v=r.n(); match v%8 {0=>v,1=>u64::MAX-(r.n()%100000),2=>r.n()%100000,3=>r.n()&0xFFFF_FFFF,4=>v&0x8080_8080_8080_8080,5=>(r.n()%65536)*32771+(r.n()%3),6=>u64::MAX/2+(r.n()%1000)-500,_=>r.n()>>(r.n()%64)} }\nfn main(){\n  let args:Vec<String>=std::env::args().collect();\n  if args.len()>1 && args[1]==\"mg\" {\n    let mut bad=0u64;\n    for u1 in 0..32771u64 { for u0 in 0..65536u64 { let q=reciprocal_div::div_2x1_mg10(u1,u0); if q!=((u1<<16)+u0)/32771 { if bad<5 {println!(\"MG bad u1={} u0={} got {} want {}\",u1,u0,q,((u1<<16)+u0)/32771);} bad+=1; } } }\n    println!(\"mg mismatches {}\",bad); return;\n  }\n  let mut r=R(0x9E3779B97F4A7C15); let mut bad=0u64;\n  for _ in 0..30_000_000u64 {\n    let a=pick(&mut r); let f=pick(&mut r);\n    let rf=reference(u64::MAX,a,f); let got=authorize(u64::MAX,a,f).map(|z|z.total_debit);\n    let rb=match rf {Some(t)=>t, None=>{ if got.is_some(){ println!(\"ACCEPT-OVF a={} f={} got={:?}\",a,f,got); bad+=1;} continue; }};\n    for b in [rb, rb.wrapping_sub(1), 0u64] {\n      let e=reference(b,a,f); let g=authorize(b,a,f).map(|z|z.total_debit);\n      if e!=g { if bad<20 {println!(\"MISMATCH b={} a={} f={} exp={:?} got={:?}\",b,a,f,e,g);} bad+=1; }\n    }\n  }\n  println!(\"fuzz mismatches {}\",bad);\n}\nEOF\n"]
[444.985248, "o", "cat > src/main.rs <<'EOF'"]
