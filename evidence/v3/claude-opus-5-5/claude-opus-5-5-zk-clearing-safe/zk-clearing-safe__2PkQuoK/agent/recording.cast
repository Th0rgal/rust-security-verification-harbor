[757.484428, "i", "cat > t.lean <<'EOF'\nimport SecurityChallenge\n#check @UInt64.toNat_add\n#check @UInt64.toNat_sub\n#check @UInt64.toNat_mul\n#check @UInt64.toNat_div\n#check @UInt64.toNat_mod\n#check @UInt64.toNat_or\n#check @UInt64.toNat_and\n#check @UInt64.toNat_shiftRight\n#check @UInt64.toNat_shiftLeft\n#check @UInt64.le_iff_toNat_le\n#check @UInt64.lt_iff_toNat_lt\n#check @UInt64.toNat_lt\n#check @Nat.testBit_mul_pow_two_add\n#check @Nat.eq_of_testBit_eq\n#check @Nat.testBit_or\n#check @Nat.testBit_and\n#check @Nat.or_lt_two_pow\n#check @Nat.and_lt_two_pow\n#check @Nat.shiftRight_eq_div_pow\n#check @Nat.shiftLeft_eq\n#check @Nat.and_two_pow_sub_one_eq_mod\n#check @UInt64.toNat_ofNat\n#check @UInt64.ext_iff\nEOF\nLEAN_PATH=/workspace/lean lean t.lean 2>&1 | head -60\n"]
[757.484704, "o", "cat > t.lean <<'EOF'\r\n\u001b[?2004l\r"]
[757.484744, "o", "\u001b[?2004h> "]
[757.485051, "o", "import SecurityChallenge\r\n\u001b[?2004l\r\u001b[?2004h> #check @UInt64.toNat_add\r\n\u001b[?2004l\r\u001b[?2004h> "]
[757.485093, "o", "#check @UInt64.toNat_sub\r\n\u001b[?2004l\r\u001b[?2004h> "]
