[889.347294, "i", "cat > fee.lean <<'EOF'\nimport SecurityChallenge\nopen SecurityChallenge LeanModel.Constants LeanModel.WordMath LeanModel.FeeSchedule LeanModel.MontgomeryField\n\ntheorem fee_eq (a f : UInt64) :\n    (evaluateSettlementFee (addU64WithCarry a f)).netFee.toNat =\n      (a.toNat + f.toNat + 9999) / 10000 - (a.toNat + f.toNat + 9999) / 10000 / 10 := by\n  have ha := a.toNat_lt; have hf := f.toNat_lt\n  simp only [evaluateSettlementFee, computeTierRebate, ceilDivBpsU64, addU64WithCarry, bpsDenom, bpsMaxRem, u64ModBpsQuot, u64ModBpsRem, rebateDivisor]\n  split <;> rename_i h <;> simp only [decide_eq_true_eq, UInt64.lt_iff_toNat_lt, UInt64.toNat_add] at h\n  · simp only [UInt64.toNat_sub, UInt64.toNat_add, UInt64.toNat_div, UInt64.toNat_mod, UInt64.toNat_ofNat] at *\n    omega\n  · split <;> rename_i h2 <;> simp only [UInt64.lt_iff_toNat_lt, UInt64.toNat_sub, UInt64.toNat_add, UInt64.toNat_div, UInt64.toNat_mod, UInt64.toNat_ofNat] at * <;> omega\n\ntheorem monty_eq (x : UInt64) (hx : x.toNat < 2013265921 * 4294967296) :\n    (montyReduce x).toNat = x.toNat * 943718400 % 2013265921 := by\n  have h := x.toNat_lt\n  simp only [montyReduce, montyQuotient, babyBearP, babyBearMu, limbBase]\n  split <;> rename_i h1 <;> simp only [UInt64.lt_iff_toNat_lt, UInt64.toNat_sub, UInt64.toNat_add, UInt64.toNat_mul, UInt64.toNat_div, UInt64.toNat_mod, UInt64.toNat_ofNat] at * <;> omega\nEOF\ntime LEAN_PATH=/workspace/lean lean fee.lean 2>&1 | head -40\n"]
