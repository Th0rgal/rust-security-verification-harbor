[184.562685, "o", "clear; grep -n 'def ' /workspace/lean/LeanModel/LiquidityPool.lean; sed -n '/def splitPoolReserve/,/def assessFlashFeeFloor/p' /workspace/lean/LeanModel/LiquidityPool.lean | head -40"]
[184.57227, "o", "\r\n\u001b[?2004l\r"]
[184.573786, "o", "\u001b[H\u001b[J\u001b[3J"]
[184.598741, "o", "\u001b[32m\u001b[K21\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[KsplitPoolReserve (quote : FeeQuote) : PoolReserveQuote :=\r\n\u001b[32m\u001b[K29\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[KquoteLpRetention (quote : FeeQuote) : UInt64 :="]
[184.598851, "o", "\r\n\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[KassessFlashFeeCeil (principal surcharge : UInt64) : UInt64 :=\r\n\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[KquoteFlashLpRetention (principal surcharge : UInt64) : PoolReserveQuote :=\r\n\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[KassessFlashFeeFloor (principal surcharge : UInt64) : UInt64 :=\r\n\u001b[32m\u001b[K49\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[KquoteFlashRepayment (principal surcharge : UInt64) : Option FlashLoanReceipt :=\r\n\u001b[32m\u001b[K60\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[KcheckPoolReserveSolvency (currentReserve : UInt64) (quote : FeeQuote) (minReserve : UInt64) : Bool :=\r\n"]
[184.623912, "o", "def splitPoolReserve (quote : FeeQuote) : PoolReserveQuote :=\r\n"]
[184.624204, "o", "  let treasuryCut : UInt64 := quote.netFee / treasuryCutDivisor\r\n  let lpRetention : UInt64 := quote.netFee - treasuryCut\r\n  {\r\n    treasuryCut := treasuryCut\r\n    lpRetention := lpRetention\r\n  }\r\n\r\ndef quoteLpRetention (quote : FeeQuote) : UInt64 :=\r\n  (splitPoolReserve quote).lpRetention\r\n\r\ndef assessFlashFeeCeil (principal surcharge : UInt64) : UInt64 :=\r\n  let sum := addU64WithCarry principal surcharge\r\n  ceilDivFlashU64 sum\r\n"]
[184.647679, "o", "\r\ndef quoteFlashLpRetention (principal surcharge : UInt64) : PoolReserveQuote :=\r\n  let flashLevy : UInt64 := assessFlashFeeCeil principal surcharge\r\n  let treasuryCut : UInt64 := flashLevy / treasuryCutDivisor\r\n  let lpRetention : UInt64 := flashLevy - treasuryCut\r\n  {\r\n    treasuryCut := treasuryCut\r\n    lpRetention := lpRetention\r\n  }\r\n\r\ndef assessFlashFeeFloor (principal surcharge : UInt64) : UInt64 :=\r\n\u001b[?2004hroot@e10f09192ef2:/workspace# "]
