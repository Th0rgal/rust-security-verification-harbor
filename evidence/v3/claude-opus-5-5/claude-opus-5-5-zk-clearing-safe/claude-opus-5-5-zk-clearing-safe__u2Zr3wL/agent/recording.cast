rget/release/deps/settlement_gate-ebd00f5d27994bc9\r\n/workspace/challenge/target/release/deps/settlement_gate-0aba5e1fc59a671e.d\r\n/workspace/challenge/target/release/.cargo-lock\r\n/workspace/challenge/target/release/.fingerprint/settlement-gate-0aba5e1fc59a671e/lib-settlement_gate.json\r\n/workspace/challenge/target/release/.fingerprint/settlement-gate-0aba5e1fc59a671e/invoked.timestamp\r\n/workspace/challenge/target/release/.fingerprint/settlement-gate-0aba5e1fc59a671e/lib-settlement_gate\r\n/workspace/challenge/target/release/.fingerprint/settlement-gate-0aba5e1fc59a671e/dep-lib-settlement_gate\r\n/workspace/challenge/target/release/.fingerprint/settlement-gate-ebd00f5d27994bc9/test-lib-settlement_gate\r\n/workspace/challenge/target/release/.fingerprint/settlement-gate-ebd00f5d27994bc9/dep-test-lib-settlement_gate\r\n/workspace/challenge/target/release/.fingerprint/settlement-gate-ebd00f5d27994bc9/invoked.timestamp\r\n/workspace/challenge/target/release/.fingerprint/settlement-gate-ebd00f5d27994bc9/test-lib-settlement_gate.json\r\n/workspace/challenge/target/.rustc_info.json\r\n/workspace/challenge/target/CACHEDIR.TAG\r\n/workspace/harness/checkpoint.py\r\n/workspace/submission/Proof.lean\r\n/workspace/submission/Spec.lean\r\n/workspace/submission/Audit.lean\r\n\u001b[?2004h"]
