[191.282824, "o", "\u001b[H\u001b[J\u001b[3J"]
[191.297982, "o", "def decodeDomainTag (word : UInt64) : UInt64 :="]
[191.298229, "o", "\r\n  let rawTag : UInt64 := word &&& codecTagMask\r\n  if rawTag = 0 then\r\n    sequencerDomainTag\r\n  else\r\n    rawTag\r\n\r\ndef buildTranscriptHeader (amount fee : UInt64) : TranscriptHeader :="]
[191.301836, "o", "\r\n"]
[191.321942, "o", "1://! Rollup batch transcript framing and header digest helpers for sequencer telemetry.\r\n6:/// Framed batch transcript header metadata.\r\n15:/// Extracts the 8-bit domain tag from a parameter word, defaulting to\r\n16:/// `SEQUENCER_DOMAIN_TAG` when the low byte is zero.\r\n27:/// Builds a framed `TranscriptHeader` from `(amount, fee)` for batch indexing.\r\n43:/// Checks whether a `TranscriptHeader` carries the canonical v3 version tag.\r\n49:/// Folds a `TranscriptHeader` into a 64-bit diagnostic digest word.\r\n55:/// Mixes two `TranscriptHeader` digests for two-leaf Merkle batch telemetry.\r\n"]
