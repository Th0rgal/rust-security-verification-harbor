[142.74009, "o", "\u001b[H\u001b[J\u001b[3J"]
[142.749597, "o", "import Lean"]
[142.752841, "o", "\r\nimport LeanModel.Constants\r\n\r\nnamespace LeanModel.MontgomeryField\r\n\r\nopen LeanModel.Constants\r\n"]
[142.75333, "o", "\r\nstructure ProverLevyQuote where\r\n  packedTranscript : UInt64\r\n  montyT : UInt64\r\n"]
[142.753459, "o", "  proverLevy : UInt64\r\n\r\n"]
[142.768792, "o", "29:pub fn pack_transcript(amount: u64, fee: u64) -> u64 {\r\n30-    (amount % LIMB_BASE) + (fee % BABYBEAR_P) * LIMB_BASE\r\n31-}\r\n32-\r\n33-/// Computes the 32-bit Montgomery reduction multiplier `t = ((x mod 2^32) * MU) mod 2^32`.\r\n"]
[142.769728, "o", "34-#[inline]\r\n35:pub fn monty_quotient(x: u64) -> u64 {\r\n36-    ((x % LIMB_BASE) * BABYBEAR_MU) % LIMB_BASE\r\n37-}\r\n38-\r\n39-/// Performs 64-bit BabyBear Montgomery reduction on `x < BABYBEAR_P * 2^32`,\r\n40-/// returning `(x * 943_718_400) mod 2_013_265_921` in pure `u64` arithmetic.\r\n41-#[inline]\r\n42-pub fn monty_reduce(x: u64) -> u64 {\r\n43-    let t: u64 = monty_quotient(x);\r\n"]
[142.769985, "o", "\u001b[?2004hroot@e10f09192ef2:/workspace# "]
