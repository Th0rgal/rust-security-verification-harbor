def ceilDivBpsU64 (sum : WordSum) : UInt64 :=
  if sum.highCarry then
    let foldedRem := (sum.lowWord % bpsDenom) + u64ModBpsRem
    u64ModBpsQuot + (sum.lowWord / bpsDenom) + ((foldedRem + bpsMaxRem) / bpsDenom)
