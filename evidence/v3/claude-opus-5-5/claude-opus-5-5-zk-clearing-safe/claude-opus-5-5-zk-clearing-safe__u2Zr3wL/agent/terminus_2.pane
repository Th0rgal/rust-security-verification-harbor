  let bridgeQuote : GoldilocksQuote := quoteBridgeVerifierFee amount fee
  let domainSurcharge : UInt64 := decodeDomainTag fee
  let netBpsFee : UInt64 := feeQuote.netFee
  let flashLpFee : UInt64 := flashQuote.lpRetention
