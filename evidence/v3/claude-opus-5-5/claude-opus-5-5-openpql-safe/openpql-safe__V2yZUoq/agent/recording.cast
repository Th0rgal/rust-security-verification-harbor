[156.711885, "o", "  have q0 : (d0 * (b1 * (b2 * b3))).toNat = d0.toNat * (b1.toNat * (b2.toNat * b3.toNat)) := by\r\n\u001b[?2004l\r"]
[156.712603, "o", "\u001b[?2004h> "]
