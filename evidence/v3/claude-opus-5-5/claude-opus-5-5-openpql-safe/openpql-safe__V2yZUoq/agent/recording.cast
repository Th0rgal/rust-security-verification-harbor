[156.716025, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> theorem clamp_toNat (a b : UInt64) (hb : 1 ≤ b.toNat) :\r\n\u001b[?2004l\r"]
[156.716065, "o", "\u001b[?2004h> "]
[156.716446, "o", "    (clampDigit a b).toNat = clampN a.toNat b.toNat := by\r\n\u001b[?2004l\r\u001b[?2004h>   unfold clampDigit clampN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.717006, "o", "  by_cases h : a < b\r\n\u001b[?2004l\r\u001b[?2004h>   · have h' : a.toNat < b.toNat := UInt64.lt_iff_toNat_lt.mp h\r\n\u001b[?2004l\r\u001b[?2004h>     simp [h, h']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.71744, "o", "  · have h' : ¬ a.toNat < b.toNat := fun x => h (UInt64.lt_iff_toNat_lt.mpr x)\r\n\u001b[?2004l\r"]
[156.717476, "o", "\u001b[?2004h> "]
[156.717784, "o", "    simp only [h, h', if_false]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.718285, "o", "    rw [UInt64.toNat_sub_of_le _ _ (UInt64.le_iff_toNat_le.mpr (by simpa using hb))]\r\n\u001b[?2004l\r"]
[156.718391, "o", "\u001b[?2004h>     simp\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.718728, "o", "theorem encode_toNat (a f : UInt64) :\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.719296, "o", "    (encodeMixedRadix a f).toNat = encN a.toNat f.toNat := by\r\n\u001b[?2004l\r\u001b[?2004h>   have hr : radixBase.toNat = 65536 := rfl\r\n\u001b[?2004l\r"]
[156.719608, "o", "\u001b[?2004h>   have h16 : shift16.toNat = 65536 := rfl\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.71988, "o", ">   have h32 : shift32.toNat = 4294967296 := rfl\r\n\u001b[?2004l\r\u001b[?2004h> "]
