[156.720205, "o", "\u001b[?2004h> "]
[156.720539, "o", "  have one : (1 : UInt64).toNat = 1 := rfl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.722019, "o", "  have B0 : ((f % radixBase) + 1).toNat = radB0 f.toNat := by\r\n\u001b[?2004l\r\u001b[?2004h>     rw [add_toNat_of_lt, UInt64.toNat_mod, hr, one] <;> simp only [UInt64.toNat_mod, hr, one, radB0] <;> omega\r\n\u001b[?2004l\r\u001b[?2004h>   have B1 : (((f / shift16) % radixBase) + 1).toNat = radB1 f.toNat := by\r\n\u001b[?2004l\r\u001b[?2004h>     rw [add_toNat_of_lt, UInt64.toNat_mod, UInt64.toNat_div, hr, h16, one] <;>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.7223, "o", "      simp only [UInt64.toNat_mod, UInt64.toNat_div, hr, h16, one, radB1] <;> omega\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.722334, "o", "> "]
[156.722589, "o", "  have B2 : (((f / shift32) % radixBase) + 1).toNat = radB2 f.toNat := by\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.722622, "o", "> "]
