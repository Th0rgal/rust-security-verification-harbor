[156.723862, "o", "\u001b[?2004h> "]
[156.724153, "o", "      simp only [UInt64.toNat_mod, UInt64.toNat_div, hr, h48, one, radB3] <;> omega\r\n\u001b[?2004l\r"]
[156.724186, "o", "\u001b[?2004h> "]
[156.724389, "o", "  have A0 : (a % radixBase).toNat = digA0 a.toNat := by\r\n\u001b[?2004l\r"]
[156.724428, "o", "\u001b[?2004h> "]
[156.724613, "o", "    simp only [UInt64.toNat_mod, hr, digA0]\r\n\u001b[?2004l\r"]
[156.724682, "o", "\u001b[?2004h> "]
[156.724888, "o", "  have A1 : ((a / shift16) % radixBase).toNat = digA1 a.toNat := by\r\n\u001b[?2004l\r"]
[156.724967, "o", "\u001b[?2004h> "]
[156.725171, "o", "    simp only [UInt64.toNat_mod, UInt64.toNat_div, hr, h16, digA1]\r\n\u001b[?2004l\r"]
[156.725213, "o", "\u001b[?2004h> "]
[156.725448, "o", "  have A2 : ((a / shift32) % radixBase).toNat = digA2 a.toNat := by\r\n\u001b[?2004l\r"]
[156.725481, "o", "\u001b[?2004h> "]
