[156.734686, "o", "  rw [UInt64.toNat_div, UInt64.toNat_div, h2]\r\n\u001b[?2004l\r"]
[156.734727, "o", "\u001b[?2004h> "]
[156.737816, "o", "  omega\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> theorem candidate_conforms : Conforms candidateSpec challengeAuthorize := by\r\n\u001b[?2004l\r\u001b[?2004h>   constructor\r\n\u001b[?2004l\r\u001b[?2004h>   · intro b a f\r\n\u001b[?2004l\r\u001b[?2004h>     show (∃ total, challengeAuthorize b a f = some total) ↔ debitN a.toNat f.toNat ≤ b.toNat\r\n\u001b[?2004l\r\u001b[?2004h>     rw [auth_eq]\r\n\u001b[?2004l\r\u001b[?2004h>     constructor\r\n\u001b[?2004l\r\u001b[?2004h>     · rintro ⟨t, ht⟩\r\n\u001b[?2004l\r\u001b[?2004h>       split at ht\r\n\u001b[?2004l\r\u001b[?2004h>       · rename_i h\r\n\u001b[?2004l\r\u001b[?2004h>         rw [← debit_toNat]; exact UInt64.le_iff_toNat_le.mp h\r\n\u001b[?2004l\r\u001b[?2004h>       · cases ht\r\n\u001b[?2004l\r\u001b[?2004h>     · intro h\r\n\u001b[?2004l\r\u001b[?2004h>       refine ⟨quoteDebit a f, ?_⟩\r\n\u001b[?2004l\r\u001b[?2004h>       rw [if_pos (UInt64.le_iff_toNat_le.mpr (by rw [debit_toNat]; exact h))]\r\n\u001b[?2004l\r\u001b[?2004h>   · intro b a f t ht\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.737952, "o", "    show t.toNat = debitN a.toNat f.toNat\r\n\u001b[?2004l\r"]
[156.738072, "o", "\u001b[?2004h> "]
[156.738156, "o", "    rw [auth_eq] at ht\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.738261, "o", "    split at ht\r\n\u001b[?2004l\r"]
[156.738295, "o", "\u001b[?2004h> "]
[156.738474, "o", "    · cases ht; exact debit_toNat a f\r\n\u001b[?2004l\r"]
[156.738523, "o", "\u001b[?2004h> "]
