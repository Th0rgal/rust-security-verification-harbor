[61.134863, "o", "\u001b[?2004l\r\u001b[?2004h> #check @UInt64.toNat_add\r\n\u001b[?2004l\r\u001b[?2004h> #check @UInt64.toNat_mul\r\n\u001b[?2004l\r\u001b[?2004h> #check @UInt64.toNat_div\r\n\u001b[?2004l\r\u001b[?2004h> #check @UInt64.toNat_mod\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.136056, "o", "#check @UInt64.toNat_sub_of_le"]
[61.136781, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> #check @UInt64.le_iff_toNat_le\r\n\u001b[?2004l\r\u001b[?2004h> #check @UInt64.lt_iff_toNat_lt\r\n\u001b[?2004l\r\u001b[?2004h> #check @UInt64.toNat_ofNat\r\n\u001b[?2004l\r\u001b[?2004h> "]
