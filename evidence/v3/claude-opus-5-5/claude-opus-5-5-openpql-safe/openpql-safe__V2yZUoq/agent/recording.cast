[156.727062, "o", "\u001b[?2004h> "]
[156.727284, "o", "  have rb2 : 1 ≤ radB2 f.toNat ∧ radB2 f.toNat ≤ 65536 := by unfold radB2; omega\r\n\u001b[?2004l\r"]
[156.7274, "o", "\u001b[?2004h> "]
[156.727628, "o", "  have rb3 : 1 ≤ radB3 f.toNat ∧ radB3 f.toNat ≤ 65536 := by unfold radB3; omega\r\n\u001b[?2004l\r"]
[156.72775, "o", "\u001b[?2004h> "]
[156.727902, "o", "  have cl : ∀ x y : Nat, 1 ≤ y → clampN x y < y := by\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.728017, "o", "> "]
[156.728264, "o", "    intro x y hy; unfold clampN; split <;> omega\r\n\u001b[?2004l\r\u001b[?2004h>   unfold encodeMixedRadix\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.728358, "o", "  simp only []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.728661, "o", "  have D0 := clamp_toNat (a % radixBase) ((f % radixBase) + 1) (by rw [B0]; exact rb0.1)\r\n\u001b[?2004l\r"]
[156.728708, "o", "\u001b[?2004h> "]
[156.729466, "o", "  have D1 := clamp_toNat ((a / shift16) % radixBase) (((f / shift16) % radixBase) + 1) (by rw [B1]; exact rb1.1)\r\n\u001b[?2004l\r\u001b[?2004h>   have D2 := clamp_toNat ((a / shift32) % radixBase) (((f / shift32) % radixBase) + 1) (by rw [B2]; exact rb2.1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.729929, "o", "  have D3 := clamp_toNat ((a / shift48) % radixBase) (((f / shift48) % radixBase) + 1) (by rw [B3]; exact rb3.1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.730247, "o", ">   rw [B0, A0] at D0\r\n\u001b[?2004l\r\u001b[?2004h>   rw [B1, A1] at D1\r\n\u001b[?2004l\r\u001b[?2004h>   rw [B2, A2] at D2\r\n\u001b[?2004l\r"]
[156.730665, "o", "\u001b[?2004h>   rw [B3, A3] at D3\r\n\u001b[?2004l\r\u001b[?2004h>   rw [enc_core _ _ _ _ _ _ _ _ (by rw [B0]; exact rb0.2) (by rw [B1]; exact rb1.2)\r\n\u001b[?2004l\r"]
[156.730755, "o", "\u001b[?2004h> "]
[156.731142, "o", "    (by rw [B2]; exact rb2.2) (by rw [B3]; exact rb3.2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.731253, "o", ">     (by rw [D0, B0]; exact cl _ _ rb0.1) (by rw [D1, B1]; exact cl _ _ rb1.1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.731521, "o", "    (by rw [D2, B2]; exact cl _ _ rb2.1) (by rw [D3, B3]; exact cl _ _ rb3.1)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.732884, "o", ">   rw [D0, D1, D2, D3, B1, B2, B3]\r\n\u001b[?2004l\r\u001b[?2004h>   rfl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def quoteDebit (a f : UInt64) : UInt64 :=\r\n\u001b[?2004l\r\u001b[?2004h>   a / halfDivisor + encodeMixedRadix a f / halfDivisor\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> theorem auth_eq (b a f : UInt64) :\r\n\u001b[?2004l\r\u001b[?2004h>     challengeAuthorize b a f = if quoteDebit a f ≤ b then some (quoteDebit a f) else none := rfl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.733205, "o", "theorem debit_toNat (a f : UInt64) : (quoteDebit a f).toNat = debitN a.toNat f.toNat := by\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.733366, "o", "> "]
[156.733587, "o", "  have h2 : halfDivisor.toNat = 2 := rfl\r\n\u001b[?2004l\r\u001b[?2004h>   have ha := a.toNat_lt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.733764, "o", "  have he := (encodeMixedRadix a f).toNat_lt\r\n\u001b[?2004l\r"]
[156.733845, "o", "\u001b[?2004h> "]
[156.733953, "o", "  rw [two64] at ha he\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.734089, "o", "  unfold quoteDebit debitN\r\n\u001b[?2004l\r"]
[156.734134, "o", "\u001b[?2004h> "]
[156.734446, "o", "  rw [add_toNat_of_lt, UInt64.toNat_div, UInt64.toNat_div, h2, encode_toNat]\r\n\u001b[?2004l\r"]
