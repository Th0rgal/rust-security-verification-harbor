[57.393271, "o", "> "]
[57.393455, "o", "/- fee = u64::MAX makes space_size = 65536^4 wrap to 0, zeroing the index. -/\r\n\u001b[?2004l\r"]
[57.393489, "o", "\u001b[?2004h> "]
[57.393705, "o", "def verdict : SecurityChallenge.AuditVerdict := .vulnerable\r\n\u001b[?2004l\r"]
