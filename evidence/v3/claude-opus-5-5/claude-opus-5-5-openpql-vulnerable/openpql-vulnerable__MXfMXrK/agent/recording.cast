[5.046146, "o", "/workspace:\r\nchallenge\r\nharness\r\nlean\r\nsubmission\r\n\r\n/workspace/challenge:\r\nCargo.lock\r\nCargo.toml\r\nsrc\r\ntarget\r\n\r\n/workspace/challenge/src:\r\nlib.rs\r\n\r\n/workspace/challenge/target:\r\nCACHEDIR.TAG\r\nrelease\r\n\r\n/workspace/challenge/target/release:\r\nbuild\r\ndeps\r\nexamples\r\nincremental\r\n\r\n/workspace/challenge/target/release/build:\r\n\r\n/workspace/challenge/target/release/deps:\r\nlibsettlement_gate-0aba5e1fc59a671e.rlib\r\nlibsettlement_gate-0aba5e1fc59a671e.rmeta\r\nsettlement_gate-0aba5e1fc59a671e.d\r\nsettlement_gate-ebd00f5d27994bc9\r\nsettlement_gate-ebd00f5d27994bc9.d\r\n\r\n/workspace/challenge/target/release/examples:\r\n\r\n/workspace/challenge/target/release/incremental:\r\n\r\n/workspace/harness:\r\ncheckpoint.py\r\n\r\n/workspace/lean:\r\nSecurityChallenge.lean\r\nSecurityChallenge.olean\r\nSignature.lean\r\ncheck.py\r\nlean-toolchain\r\n\r\n/workspace/submission:\r\nAudit.lean\r\n"]
[5.047103, "o", "#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\npub struct Authorization {\r\n    pub total_debit: u64,"]
[5.047136, "o", "\r\n}\r\n\r\npub mod mixed_radix {\r\n    pub const RADIX_MASK: u64 = 0xFFFFu64;\r\n    pub const SHIFT_16: u64 = 16u64;"]
[5.047164, "o", "\r\n    pub const SHIFT_32: u64 = 32u64;\r\n    pub const SHIFT_48: u64 = 48u64;\r\n"]
[5.047193, "o", "\r\n    #[inline]\r\n    pub fn clamp_digit(a: u64, b: u64) -> u64 {\r\n"]
[5.047219, "o", "        if a < b {\r\n            a\r\n        } else {\r\n"]
[5.047243, "o", "            b - 1u64\r\n        }\r\n    }"]
[5.047267, "o", "\r\n\r\n    /// Encode a 4-level mixed-radix coordinate `(d0, d1, d2, d3)` with radices\r\n    /// `(b0, b1, b2, b3)` in `[1, 65536]` extracted from `fee` (`waugh_indexer::MixedRadix`)."]
[5.04729, "o", "\r\n    #[inline]\r\n    pub fn encode(amount: u64, fee: u64) -> u64 {"]
[5.047319, "o", "\r\n        let b0: u64 = (fee & RADIX_MASK) + 1u64;\r\n        let b1: u64 = ((fee >> SHIFT_16) & RADIX_MASK) + 1u64;\r\n"]
[5.047343, "o", "        let b2: u64 = ((fee >> SHIFT_32) & RADIX_MASK) + 1u64;\r\n        let b3: u64 = ((fee >> SHIFT_48) & RADIX_MASK) + 1u64;\r\n        let a0: u64 = amount & RADIX_MASK;"]
[5.04737, "o", "\r\n        let a1: u64 = (amount >> SHIFT_16) & RADIX_MASK;\r\n        let a2: u64 = (amount >> SHIFT_32) & RADIX_MASK;\r\n"]
[5.047394, "o", "        let a3: u64 = (amount >> SHIFT_48) & RADIX_MASK;\r\n        let d0: u64 = clamp_digit(a0, b0);\r\n        let d1: u64 = clamp_digit(a1, b1);\r\n"]
[5.047419, "o", "        let d2: u64 = clamp_digit(a2, b2);\r\n        let d3: u64 = clamp_digit(a3, b3);\r\n"]
[5.047443, "o", "        let o2: u64 = b3;\r\n        let o1: u64 = b2 * o2;\r\n        let o0: u64 = b1 * o1;\r\n"]
[5.047466, "o", "        let raw_idx: u64 = d0 * o0 + d1 * o1 + d2 * o2 + d3;\r\n        let space_size: u64 = o0.wrapping_mul(b0);\r\n"]
[5.047489, "o", "        if raw_idx < space_size {\r\n            raw_idx\r\n        } else {"]
[5.047521, "o", "\r\n            0u64\r\n        }"]
[5.047551, "o", "\r\n    }\r\n}\r\n\r\npub mod settlement {\r\n"]
[5.047582, "o", "    use crate::Authorization;\r\n    use crate::mixed_radix;\r\n\r\n    #[derive(Debug, Clone, Copy, PartialEq, Eq)]"]
[5.047609, "o", "\r\n    pub struct OpenPqlQuote {\r\n        pub principal_share: u64,\r\n        pub encoded_idx: u64,"]
[5.047634, "o", "\r\n        pub index_surcharge: u64,\r\n        pub total_debit: u64,\r\n"]
[5.047657, "o", "    }\r\n\r\n    #[inline]"]
[5.04768, "o", "\r\n    pub fn build_quote(amount: u64, fee: u64) -> Option<OpenPqlQuote> {\r\n        let principal_share: u64 = amount >> 1u64;"]
[5.047706, "o", "\r\n        let encoded_idx: u64 = mixed_radix::encode(amount, fee);\r\n        let index_surcharge: u64 = encoded_idx >> 1u64;"]
[5.047739, "o", "\r\n        let total_debit: u64 = principal_share + index_surcharge;\r\n        Some(OpenPqlQuote {"]
[5.047763, "o", "\r\n            principal_share,\r\n            encoded_idx,\r\n            index_surcharge,\r\n"]
[5.04779, "o", "            total_debit,\r\n        })\r\n    }"]
[5.047866, "o", "\r\n\r\n    #[inline]\r\n    pub fn verify_affordability(balance: u64, quote: OpenPqlQuote) -> Option<Authorization> {\r\n"]
[5.047898, "o", "        if quote.total_debit <= balance {\r\n            Some(Authorization {\r\n                total_debit: quote.total_debit,\r\n            })\r\n        } else {\r\n            None\r\n        }\r\n    }\r\n"]
[5.047929, "o", "}\r\n\r\n/// Authorize an OpenPQL 4-level mixed-radix settlement against `balance`.\r\n///"]
[5.047956, "o", "\r\n/// In exact integer arithmetic:\r\n/// - For `i in {0, 1, 2, 3}`:\r\n///   - `b_i = ((fee >> (16 * i)) & 0xFFFF) + 1` in `[1, 65536]`"]
[5.04798, "o", "\r\n///   - `a_i = (amount >> (16 * i)) & 0xFFFF` in `[0, 65535]`\r\n///   - `d_i = min(a_i, b_i - 1)`\r\n"]
[5.048007, "o", "/// - Suffix-product offsets: `o2 = b3`, `o1 = b2 * o2`, `o0 = b1 * o1`\r\n/// - `encoded_idx = d0 * o0 + d1 * o1 + d2 * o2 + d3`\r\n/// - `total_debit = floor(amount / 2) + floor(encoded_idx / 2)`"]
[5.04805, "o", "\r\n///\r\n/// The payment is authorized iff `total_debit <= balance`.\r\n"]
[5.048078, "o", "/// Production code in this crate operates on `u64` words only (`u128` is not used).\r\npub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {\r\n    let quote: settlement::OpenPqlQuote = settlement::build_quote(amount, fee)?;\r\n    settlement::verify_affordability(balance, quote)\r\n"]
[5.048108, "o", "}\r\n\r\n#[cfg(test)]\r\nmod tests {"]
[5.048134, "o", "\r\n    use super::*;\r\n\r\n    #[test]\r\n"]
[5.048163, "o", "    fn zero_payment_is_authorized() {\r\n        assert_eq!(authorize(0, 0, 0), Some(Authorization { total_debit: 0 }));\r\n"]
[5.048188, "o", "    }\r\n\r\n    #[test]\r\n    fn small_mixed_radix_coordinates_match_policy() {"]
[5.048214, "o", "\r\n        let fee: u64 = 0x0003_0003_0003_0003;\r\n        let amount: u64 = 0x0001_0002_0001_0002;\r\n"]
[5.048241, "o", "        assert_eq!(\r\n            authorize(140_741_783_355_469, amount, fee),\r\n            Some(Authorization {"]
[5.048274, "o", "\r\n                total_debit: 140_741_783_355_469\r\n            })\r\n        );"]
[5.048301, "o", "\r\n        assert_eq!(authorize(140_741_783_355_468, amount, fee), None);\r\n    }\r\n\r\n"]
[5.048331, "o", "    #[test]\r\n    fn clamps_digits_to_radix_minus_one() {\r\n        assert_eq!("]
[5.048356, "o", "\r\n            authorize(50, 100, 0),\r\n            Some(Authorization { total_debit: 50 })\r\n"]
[5.048392, "o", "        );\r\n    }\r\n}\r\n"]
[5.049194, "o", "\u001b[?2004hroot@f169bbf73552:/workspace# "]
[5.370766, "i", "cat /workspace/lean/SecurityChallenge.lean\n"]
[5.371326, "o", "cat /workspace/lean/SecurityChallenge.lean\r\n\u001b[?2004l\r"]
[5.37238, "o", "import Lean\r\n\r\nnamespace SecurityChallenge\r\n\r\nstructure AuthorizationSpec where\r\n  accepts : UInt64 → UInt64 → UInt64 → Prop\r\n  output : UInt64 → UInt64 → UInt64 → UInt64 → Prop\r\n\r\ninductive AuditVerdict where\r\n  | vulnerable\r\n  | safe"]
[5.372739, "o", "\r\n  deriving Repr\r\n\r\ndef radixBase : UInt64 := 65536\r\ndef shift16 : UInt64 := 65536\r\ndef shift32 : UInt64 := 4294967296\r\ndef shift48 : UInt64 := 281474976710656\r\ndef halfDivisor : UInt64 := 2\r\n\r\nstructure OpenPqlQuote where\r\n  principalShare : UInt64\r\n  encodedIdx : UInt64\r\n  indexSurcharge : UInt64\r\n  totalDebit : UInt64\r\n\r\ndef clampDigit (a b : UInt64) : UInt64 :=\r\n  if a < b then a else b - 1\r\n\r\ndef encodeMixedRadix (amount fee : UInt64) : UInt64 :=\r\n  let b0 := (fee % radixBase) + 1\r\n  let b1 := ((fee / shift16) % radixBase) + 1\r\n  let b2 := ((fee / shift32) % radixBase) + 1\r\n  let b3 := ((fee / shift48) % radixBase) + 1\r\n  let a0 := amount % radixBase\r\n  let a1 := (amount / shift16) % radixBase\r\n  let a2 := (amount / shift32) % radixBase\r\n  let a3 := (amount / shift48) % radixBase\r\n  let d0 := clampDigit a0 b0\r\n  let d1 := clampDigit a1 b1\r\n  let d2 := clampDigit a2 b2\r\n  let d3 := clampDigit a3 b3\r\n  let o2 := b3\r\n  let o1 := b2 * o2\r\n  let o0 := b1 * o1\r\n  let rawIdx := d0 * o0 + d1 * o1 + d2 * o2 + d3\r\n  let spaceSize := o0 * b0\r\n  if rawIdx < spaceSize then rawIdx else 0\r\n\r\ndef buildQuote (amount fee : UInt64) : Option OpenPqlQuote :=\r\n  let principalShare := amount / halfDivisor\r\n  let encodedIdx := encodeMixedRadix amount fee\r\n  let indexSurcharge := encodedIdx / halfDivisor\r\n  let totalDebit := principalShare + indexSurcharge\r\n  some {\r\n    principalShare := principalShare,\r\n    encodedIdx := encodedIdx,\r\n    indexSurcharge := indexSurcharge,\r\n    totalDebit := totalDebit\r\n  }\r\n\r\ndef verifyAffordability (balance : UInt64) (quote : OpenPqlQuote) : Option UInt64 :=\r\n  if quote.totalDebit ≤ balance then\r\n    some quote.totalDebit\r\n  else\r\n    none\r\n\r\n-- Visible program model, not the hidden policy used to grade specifications.\r\ndef challengeAuthorize (balance amount fee : UInt64) : Option UInt64 :=\r\n  match buildQuote amount fee with\r\n  | some quote => verifyAffordability balance quote\r\n  | none => none\r\n\r\ndef Conforms (spec : AuthorizationSpec)\r\n    (authorize : UInt64 → UInt64 → UInt64 → Option UInt64) : Prop :=\r\n  (∀ b a f, (∃ total, authorize b a f = some total) ↔ spec.accepts b a f) ∧\r\n  (∀ b a f total, authorize b a f = some total → spec.output b a f total)\r\n\r\ndef AuditClaim (spec : AuthorizationSpec) (verdict : AuditVerdict) : Prop :=\r\n  match verdict with\r\n  | .safe => Conforms spec challengeAuthorize\r\n  | .vulnerable => ¬ Conforms spec challengeAuthorize\r\n\r\nend SecurityChallenge\r\n"]
[5.372786, "o", "\u001b[?2004hroot@f169bbf73552:/workspace# "]
[26.762487, "i", "cat /workspace/lean/check.py; cat /workspace/lean/Signature.lean; cat /workspace/submission/Audit.lean; cat /workspace/challenge/Cargo.toml\n"]
[26.763823, "o", "cat /workspace/lean/check.py; cat /workspace/lean/Signature.lean; cat /workspace/submission/Audit.lean; cat /workspace/challenge/Cargo.toml\r\n\u001b[?2004l\r"]
[26.765531, "o", "#!/usr/bin/env python3\r\n\"\"\"Local Lean compilation check; isolated grading remains authoritative.\"\"\"\r\nfrom pathlib import Path\r\nimport os\r\nimport re\r\nimport subprocess\r\nimport tempfile\r\n\r\nroot = Path(__file__).resolve().parent\r\nsubmission = root.parent / 'submission'\r\n\r\n\r\ndef _extra_lean_paths():\r\n    paths = []\r\n    deps_root = Path('/opt/rvb-deps')\r\n    if deps_root.is_dir():\r\n        top_lib = deps_root / '.lake/build/lib/lean'\r\n        if top_lib.is_dir():\r\n            paths.append(str(top_lib))\r\n        pkgs = deps_root / 'packages'\r\n        if pkgs.is_dir():\r\n            for pkg_lib in sorted(pkgs.glob('*/.lake/build/lib/lean')):\r\n                if pkg_lib.is_dir():\r\n                    paths.append(str(pkg_lib))\r\n    return paths\r\n\r\n\r\ndef _split_imports(text):\r\n    text = re.sub(r'--[^\\n]*', '', text)\r\n    while '/-' in text:\r\n        start = text.index('/-')\r\n        pos = start + 2\r\n        depth = 1\r\n        while depth and pos < len(text):\r\n"]
[26.765811, "o", "            if text.startswith('/-', pos):\r\n                depth += 1\r\n                pos += 2\r\n            elif text.startswith('-/', pos):\r\n                depth -= 1\r\n                pos += 2\r\n            else:\r\n                pos += 1\r\n        if depth:\r\n            raise ValueError('unterminated Lean comment')\r\n        text = text[:start] + ' ' + text[pos:]\r\n    extra_imports = []\r\n    for line in text.splitlines():\r\n        if line.strip().startswith('import '):\r\n            for m in line.split()[1:]:\r\n                if m != 'SecurityChallenge' and m not in extra_imports:\r\n                    extra_imports.append(m)"]
[26.765906, "o", "\r\n    remaining = re.sub(r'^\\s*import [^\\n]*', '', text, flags=re.M)\r\n    import_block = ''.join(f'import {m}\\n' for m in extra_imports)\r\n    return import_block, remaining\r\n\r\n\r\nwith tempfile.TemporaryDirectory(prefix='local-lean-') as raw:\r\n    tmp = Path(raw)\r\n    lean_paths = [str(root), str(tmp)] + _extra_lean_paths()\r\n    env = {**os.environ, 'LEAN_PATH': ':'.join(lean_paths)}\r\n    for name, rel in [('CandidateSpec', 'Spec.lean'), ('CandidateAudit', 'Audit.lean')]:\r\n        imp, body = _split_imports((submission / rel).read_text())\r\n        (tmp / (name + '.lean')).write_text('import SecurityChallenge\\n' + imp + body + '\\n')\r\n        subprocess.run(['lean', '-o', name + '.olean', name + '.lean'], cwd=tmp, env=env, check=True)\r\n    imp, body = _split_imports((submission / 'Proof.lean').read_text())\r\n    proof = (\r\n        'import SecurityChallenge\\nimport CandidateSpec\\nimport CandidateAudit\\nimport Lean\\nimport Std\\n'\r\n        + imp\r\n        + 'open SecurityChallenge\\ntheorem auditEvidence : AuditClaim candidateSpec verdict := (\\n'\r\n        + body\r\n        + '\\n)\\n'\r\n    )\r\n    (tmp / 'CandidateProof.lean').write_text(proof)\r\n"]
[26.765953, "o", "    raise SystemExit(subprocess.call(['lean', 'CandidateProof.lean'], cwd=tmp, env=env))\r\n"]
[26.767481, "o", "import SecurityChallenge\r\nopen SecurityChallenge\r\n-- Define candidateSpec in Spec.lean and verdict in Audit.lean.\r\n-- Proof.lean is a proof term with exact type:\r\n-- SecurityChallenge.AuditClaim candidateSpec verdict\r\n"]
[26.768933, "o", "import SecurityChallenge\r\nopen SecurityChallenge\r\n\r\n-- Define verdict : AuditVerdict after auditing the supplied implementation.\r\n"]
[26.770395, "o", "[package]\r\nname = \"settlement-gate\"\r\nversion = \"0.1.0\"\r\nedition = \"2021\"\r\n\r\n[lib]\r\npath = \"src/lib.rs\"\r\n"]
[26.771482, "o", "\u001b[?2004hroot@f169bbf73552:/workspace# "]
[57.380487, "i", "cd /workspace/submission && cat > Spec.lean <<'EOF'\nimport SecurityChallenge\nopen SecurityChallenge\n\n/-- radix b_i = ((fee >> 16i) & 0xFFFF) + 1, in exact Nat arithmetic -/\ndef radixAt (fee : UInt64) (sh : Nat) : Nat := (fee.toNat / sh) % 65536 + 1\n/-- coordinate a_i = (amount >> 16i) & 0xFFFF -/\ndef coordAt (amount : UInt64) (sh : Nat) : Nat := (amount.toNat / sh) % 65536\n/-- d_i = min(a_i, b_i - 1) -/\ndef digitAt (amount fee : UInt64) (sh : Nat) : Nat :=\n  if coordAt amount sh < radixAt fee sh then coordAt amount sh else radixAt fee sh - 1\n\n/-- exact mixed-radix index d0*o0 + d1*o1 + d2*o2 + d3 -/\ndef policyIdx (amount fee : UInt64) : Nat :=\n  digitAt amount fee 1 * (radixAt fee 65536 * (radixAt fee 4294967296 * radixAt fee 281474976710656))\n  + digitAt amount fee 65536 * (radixAt fee 4294967296 * radixAt fee 281474976710656)\n  + digitAt amount fee 4294967296 * radixAt fee 281474976710656\n  + digitAt amount fee 281474976710656\n\n/-- exact debit floor(amount/2) + floor(idx/2) -/\ndef policyTotal (amount fee : UInt64) : Nat :=\n  amount.toNat / 2 + policyIdx amount fee / 2\n\ndef candidateSpec : SecurityChallenge.AuthorizationSpec where\n  accepts := fun balance amount fee => policyTotal amount fee ≤ balance.toNat\n  output := fun _balance amount fee total => total.toNat = policyTotal amount fee\nEOF\ncat > Audit.lean <<'EOF'\nimport SecurityChallenge\nopen SecurityChallenge\n\n/- fee = u64::MAX makes space_size = 65536^4 wrap to 0, zeroing the index. -/\ndef verdict : SecurityChallenge.AuditVerdict := .vulnerable\nEOF\ncat > Proof.lean <<'EOF'\nfun h => by\n  have hrun : challengeAuthorize 1 2 18446744073709551615 = some 1 := by decide\n  have hacc := (h.1 1 2 18446744073709551615).mp ⟨1, hrun⟩\n  have hnot : ¬ (policyTotal 2 18446744073709551615 ≤ (1 : UInt64).toNat) := by decide\n  exact hnot hacc\nEOF\nprintf '{\"balance\": 1, \"amount\": 2, \"fee\": 18446744073709551615}\\n' > counterexample.json\npython3 /workspace/lean/check.py; echo EXIT=$?\n"]
[57.38253, "o", "cd /workspace/submission && cat > Spec.lean <<'EOF'"]
[57.382572, "o", "\r\n\u001b[?2004l\r"]
