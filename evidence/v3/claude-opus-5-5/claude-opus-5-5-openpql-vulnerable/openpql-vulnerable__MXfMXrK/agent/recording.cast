[57.38667, "o", "> def digitAt (amount fee : UInt64) (sh : Nat) : Nat :="]
[57.386862, "o", "\r\n"]
[57.388035, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[57.388205, "o", "  if coordAt amount sh < radixAt fee sh then coordAt amount sh else radixAt fee sh - 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> /-- exact mixed-radix index d0*o0 + d1*o1 + d2*o2 + d3 -/\r\n\u001b[?2004l\r\u001b[?2004h> def policyIdx (amount fee : UInt64) : Nat :=\r\n\u001b[?2004l\r\u001b[?2004h> "]
