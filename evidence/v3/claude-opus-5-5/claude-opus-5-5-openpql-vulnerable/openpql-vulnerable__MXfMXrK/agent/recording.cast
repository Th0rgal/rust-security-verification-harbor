[201.039714, "i", "cd /workspace/challenge && cp src/lib.rs /tmp/lib.rs.orig && python3 - <<'EOF'\nimport re\np='src/lib.rs'\ns=open(p).read()\nold='''        let raw_idx: u64 = d0 * o0 + d1 * o1 + d2 * o2 + d3;\n        let space_size: u64 = o0.wrapping_mul(b0);\n        if raw_idx < space_size {\n            raw_idx\n        } else {\n            0u64\n        }\n'''\nnew='''        // d_i <= b_i - 1, so the exact index is at most b0*b1*b2*b3 - 1 <= 2^64 - 1:\n        // every partial product/sum fits in u64. No wrapped range guard is needed\n        // (the old `o0.wrapping_mul(b0)` guard wrapped to 0 when all radices were 65536).\n        d0 * o0 + d1 * o1 + d2 * o2 + d3\n'''\nassert old in s\ns=s.replace(old,new)\nt_old='''    #[test]\n    fn clamps_digits_to_radix_minus_one() {'''\nt_new='''    #[test]\n    fn full_radix_space_is_not_zeroed() {\n        // fee = u64::MAX => all radices 65536; idx = 2 * 2^48, debit = 1 + 2^48\n        assert_eq!(authorize(1, 2, u64::MAX), None);\n        assert_eq!(\n            authorize(u64::MAX, 2, u64::MAX),\n            Some(Authorization { total_debit: 281_474_976_710_657 })\n        );\n        assert_eq!(\n            authorize(u64::MAX, u64::MAX, u64::MAX),\n            Some(Authorization { total_debit: u64::MAX - 1 })\n        );\n    }\n\n    #[test]\n    fn clamps_digits_to_radix_minus_one() {'''\nassert t_old in s\ns=s.replace(t_old,t_new)\nopen(p,'w').write(s)\nEOF\ncargo test --release 2>&1 | tail -15; cp src/lib.rs /workspace/submission/lib.rs; mkdir -p /workspace/submission/src && cp src/lib.rs /workspace/submission/src/lib.rs; ls -la /workspace/submission\n"]
