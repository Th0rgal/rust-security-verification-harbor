[141.09622, "i", "cat > Spec.lean <<'EOF'\nimport SecurityChallenge\nopen SecurityChallenge\n\n-- radix b_i = ((fee >> 16i) & 0xFFFF) + 1, in exact Nat arithmetic\ndef radixAt (fee : UInt64) (sh : Nat) : Nat := (fee.toNat / sh) % 65536 + 1\n-- coordinate a_i = (amount >> 16i) & 0xFFFF\ndef coordAt (amount : UInt64) (sh : Nat) : Nat := (amount.toNat / sh) % 65536\n-- d_i = min(a_i, b_i - 1)\ndef digitAt (amount fee : UInt64) (sh : Nat) : Nat :=\n  if coordAt amount sh < radixAt fee sh then coordAt amount sh else radixAt fee sh - 1\n\n-- exact mixed-radix index d0*o0 + d1*o1 + d2*o2 + d3 (no wraparound)\ndef policyIdx (amount fee : UInt64) : Nat :=\n  digitAt amount fee 1 * (radixAt fee 65536 * (radixAt fee 4294967296 * radixAt fee 281474976710656))\n  + digitAt amount fee 65536 * (radixAt fee 4294967296 * radixAt fee 281474976710656)\n  + digitAt amount fee 4294967296 * radixAt fee 281474976710656\n  + digitAt amount fee 281474976710656\n\n-- exact debit floor(amount/2) + floor(idx/2)\ndef policyTotal (amount fee : UInt64) : Nat :=\n  amount.toNat / 2 + policyIdx amount fee / 2\n\ndef candidateSpec : SecurityChallenge.AuthorizationSpec where\n  accepts := fun balance amount fee => policyTotal amount fee ≤ balance.toNat\n  output := fun _balance amount fee total => total.toNat = policyTotal amount fee\nEOF\npython3 /workspace/lean/check.py; echo EXIT=$?\n"]
[141.0988, "o", "cat > Spec.lean <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import SecurityChallenge\r\n\u001b[?2004l\r\u001b[?2004h> open SecurityChallenge\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> -- radix b_i = ((fee >> 16i) & 0xFFFF) + 1, in exact Nat arithmetic\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.110508, "o", "def radixAt (fee : UInt64) (sh : Nat) : Nat := (fee.toNat / sh) % 65536 + 1\r\n\u001b[?2004l\r\u001b[?2004h> -- coordinate a_i = (amount >> 16i) & 0xFFFF\r\n\u001b[?2004l\r\u001b[?2004h> def coordAt (amount : UInt64) (sh : Nat) : Nat := (amount.toNat / sh) % 65536\r\n\u001b[?2004l\r\u001b[?2004h> -- d_i = min(a_i, b_i - 1)\r\n\u001b[?2004l\r\u001b[?2004h> def digitAt (amount fee : UInt64) (sh : Nat) : Nat :=\r\n\u001b[?2004l\r\u001b[?2004h>   if coordAt amount sh < radixAt fee sh then coordAt amount sh else radixAt fee sh - 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> -- exact mixed-radix index d0*o0 + d1*o1 + d2*o2 + d3 (no wraparound)\r\n\u001b[?2004l\r\u001b[?2004h> def policyIdx (amount fee : UInt64) : Nat :=\r\n\u001b[?2004l\r\u001b[?2004h>   digitAt amount fee 1 * (radixAt fee 65536 * (radixAt fee 4294967296 * radixAt fee 281474976710656))\r\n\u001b[?2004l\r\u001b[?2004h>   + digitAt amount fee 65536 * (radixAt fee 4294967296 * radixAt fee 281474976710656)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.111115, "o", "  + digitAt amount fee 4294967296 * radixAt fee 281474976710656\r\n\u001b[?2004l\r\u001b[?2004h>   + digitAt amount fee 281474976710656\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> -- exact debit floor(amount/2) + floor(idx/2)\r\n\u001b[?2004l\r\u001b[?2004h> def policyTotal (amount fee : UInt64) : Nat :=\r\n\u001b[?2004l\r\u001b[?2004h>   amount.toNat / 2 + policyIdx amount fee / 2\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def candidateSpec : SecurityChallenge.AuthorizationSpec where\r\n\u001b[?2004l\r\u001b[?2004h>   accepts := fun balance amount fee => policyTotal amount fee ≤ balance.toNat\r\n\u001b[?2004l\r\u001b[?2004h>   output := fun _balance amount fee total => total.toNat = policyTotal amount fee\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r\u001b[?2004hroot@f169bbf73552:/workspace/submission# python3 /workspace/lean/check.py; echo EXIT=$?\r\n\u001b[?2004l\r"]
