[57.395665, "o", "cat > Proof.lean <<'EOF'\r\n\u001b[?2004l\r"]
[57.395706, "o", "\u001b[?2004h> "]
[57.395841, "o", "fun h => by\r\n\u001b[?2004l\r"]
[57.395867, "o", "\u001b[?2004h> "]
[57.396264, "o", "  have hrun : challengeAuthorize 1 2 18446744073709551615 = some 1 := by decide\r\n"]
