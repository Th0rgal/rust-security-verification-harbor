[6.344972, "o", "cat challenge/src/lib.rs"]
[6.345525, "o", "\r\n\u001b[?2004l\r"]
[6.346658, "o", "//! Word-level concentrated-liquidity fee and rebate settlement authorization."]
[6.346806, "o", "\r\n\r\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\npub struct Authorization {\r\n    pub total_debit: u64,\r\n}\r\n\r\nconst BPS_DENOM: u64 = 10_000;\r\nconst BPS_MAX_REM: u64 = 9_999;\r\nconst U64_MOD_BPS_QUOT: u64 = 1_844_674_407_370_955;\r\nconst U64_MOD_BPS_REM: u64 = 1_616;\r\nconst REBATE_DIVISOR: u64 = 10;\r\n\r\n/// Authorize a liquidity transfer in pure `u64` arithmetic before settlement.\r\n///"]
[6.346913, "o", "\r\n/// Policy over exact unbounded integers (`balance`, `amount`, `fee`):\r\n/// 1. The gross protocol fee is the combined basis `amount + fee` divided by\r\n///    `BPS_DENOM` (`10_000`), rounded up (`ceil((amount + fee) / 10_000)`).\r\n"]
[6.347024, "o", "/// 2. The tier rebate is `gross_fee` divided by `REBATE_DIVISOR` (`10`),\r\n///    rounded down (`floor(gross_fee / 10)`)."]
[6.347148, "o", "\r\n/// 3. The net settlement debit is `amount + (gross_fee - rebate)`.\r\n///\r\n/// Authorize every affordable transfer (`total_debit <= balance`) and return\r\n/// the exact net settlement debit; reject every unaffordable transfer (`None`).\r\n/// Target word constraint: production code must use `u64` only (no `u128`)."]
[6.347179, "o", "\r\npub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {\r\n    let raw_sum = amount.wrapping_add(fee);\r\n    let gross_fee = if raw_sum < amount {\r\n        let folded_rem = (raw_sum % BPS_DENOM) + U64_MOD_BPS_REM;\r\n        U64_MOD_BPS_QUOT + (raw_sum / BPS_DENOM) + ((folded_rem + BPS_MAX_REM) / BPS_DENOM)\r\n    } else {\r\n        let biased = raw_sum.wrapping_add(BPS_MAX_REM);\r\n        if biased < raw_sum {"]
[6.347277, "o", "\r\n            (raw_sum / BPS_DENOM) + ((biased + U64_MOD_BPS_REM) / BPS_DENOM)"]
[6.347405, "o", "\r\n        } else {\r\n            biased / BPS_DENOM\r\n        }"]
[6.347451, "o", "\r\n    };\r\n    let rebate = gross_fee / REBATE_DIVISOR;\r\n    let net_fee = gross_fee - rebate;\r\n    let total_debit = amount.checked_add(net_fee)?;\r\n"]
[6.347618, "o", "    (total_debit <= balance).then_some(Authorization { total_debit })\r\n}\r\n\r\n#[cfg(test)]"]
[6.34779, "o", "\r\nmod tests {\r\n    use super::*;"]
[6.347808, "o", "\r\n\r\n    #[test]\r\n    fn ordinary_settlement() {\r\n        assert_eq!(authorize(100_012, 100_000, 25_000).unwrap().total_debit, 100_012);\r\n        assert_eq!(authorize(100_011, 100_000, 25_000), None);\r\n    }\r\n\r\n    #[test]\r\n    fn ceiling_rounding_and_rebate() {\r\n        assert_eq!(authorize(2, 1, 0).unwrap().total_debit, 2);\r\n        assert_eq!(authorize(9, 0, 99_991).unwrap().total_debit, 9);\r\n        assert_eq!(authorize(8, 0, 99_991), None);\r\n    }\r\n\r\n    #[test]\r\n"]
[6.347954, "o", "    fn wide_basis_carry_folding() {\r\n        let expected = 1_660_206_966_643_862;\r\n        assert_eq!(authorize(expected, 10_000, u64::MAX).unwrap().total_debit, expected);\r\n        assert_eq!(authorize(expected - 1, 10_000, u64::MAX), None);\r\n    }\r\n\r\n"]
[6.347974, "o", "    #[test]"]
[6.347991, "o", "\r\n"]
[6.348035, "o", "    fn ceiling_bias_wrap_at_u64_max() {"]
[6.348114, "o", "\r\n        let expected = 1_660_206_966_633_861;\r\n        assert_eq!(authorize(expected, 0, u64::MAX).unwrap().total_debit, expected);\r\n"]
[6.348249, "o", "        assert_eq!(authorize(expected - 1, 0, u64::MAX), None);\r\n    }\r\n\r\n    #[test]"]
[6.34838, "o", "\r\n    fn total_debit_overflow_rejected() {\r\n        assert_eq!(authorize(u64::MAX, u64::MAX, 1), None);\r\n        assert_eq!(authorize(u64::MAX, u64::MAX, u64::MAX), None);\r\n    }\r\n}"]
[6.348457, "o", "\r\n"]
[6.349002, "o", "\u001b[?2004hroot@319acaa7605f:/workspace# "]
[6.554937, "i", "cat lean/SecurityChallenge.lean\n"]
[6.555874, "o", "cat lean/SecurityChallenge.lean\r\n\u001b[?2004l\r"]
[6.560923, "o", "import Lean\r\n\r\nnamespace SecurityChallenge\r\n\r\nstructure AuthorizationSpec where\r\n  accepts : UInt64 → UInt64 → UInt64 → Prop\r\n  output : UInt64 → UInt64 → UInt64 → UInt64 → Prop\r\n\r\ninductive AuditVerdict where\r\n  | vulnerable\r\n  | safe\r\n  deriving Repr\r\n\r\ndef bpsDenom : UInt64 := 10000\r\ndef bpsMaxRem : UInt64 := 9999\r\ndef u64ModBpsQuot : UInt64 := 1844674407370955\r\ndef u64ModBpsRem : UInt64 := 1616\r\ndef rebateDivisor : UInt64 := 10\r\ndef u64Max : UInt64 := 18446744073709551615\r\n\r\n-- Visible program model, not the hidden policy used to grade specifications.\r\ndef challengeAuthorize (balance amount fee : UInt64) : Option UInt64 :=\r\n  let rawSum := amount + fee\r\n  let grossFee :=\r\n    if rawSum < amount then\r\n      let foldedRem := (rawSum % bpsDenom) + u64ModBpsRem\r\n      u64ModBpsQuot + (rawSum / bpsDenom) + ((foldedRem + bpsMaxRem) / bpsDenom)\r\n    else\r\n      let biased := rawSum + bpsMaxRem\r\n      if biased < rawSum then\r\n        (rawSum / bpsDenom) + ((biased + u64ModBpsRem) / bpsDenom)\r\n      "]
[6.561111, "o", "else\r\n        biased / bpsDenom\r\n  let rebate := grossFee / rebateDivisor\r\n  let netFee := grossFee - rebate\r\n  if netFee ≤ u64Max - amount then\r\n    let total := amount + netFee\r\n    if total ≤ balance then\r\n      some total\r\n    else\r\n      none\r\n  else\r\n    none\r\n\r\ndef Conforms (spec : AuthorizationSpec)\r\n    (authorize : UInt64 → UInt64 → UInt64 → Option UInt64) : Prop :=\r\n  (∀ b a f, (∃ total, authorize b a f = some total) ↔ spec.accepts b a f) ∧\r\n  (∀ b a f total, authorize b a f = some total → spec.output b a f total)\r\n\r\ndef AuditClaim (spec : AuthorizationSpec) (verdict : AuditVerdict) : Prop :=\r\n  match verdict with\r\n  | .safe => Conforms spec challengeAuthorize\r\n  | .vulnerable => ¬ Conforms spec challengeAuthorize\r\n\r\nend SecurityChallenge\r\n\u001b[?2004hroot@319acaa7605f:/workspace# "]
[33.508717, "i", "cat lean/Signature.lean; cat lean/check.py; cat lean/lean-toolchain; head -50 submission/*.lean\n"]
[33.509314, "o", "cat lean/Signature.lean; cat lean/check.py; cat lean/lean-toolchain; head -50 submission/*.lean"]
[33.509407, "o", "\r\n"]
[33.509871, "o", "\u001b[?2004l\r"]
[33.510819, "o", "import SecurityChallenge\r\nopen SecurityChallenge"]
[33.510866, "o", "\r\n-- Define candidateSpec in Spec.lean and verdict in Audit.lean.\r\n-- Proof.lean is a proof term with exact type:\r\n"]
[33.510883, "o", "-- SecurityChallenge.AuditClaim candidateSpec verdict\r\n"]
[33.511923, "o", "#!/usr/bin/env python3\r\n\"\"\"Local Lean compilation check; isolated grading remains authoritative.\"\"\"\r\nfrom pathlib import Path\r\nimport os\r\nimport subprocess\r\nimport tempfile\r\nroot=Path(__file__).resolve().parent\r\nsubmission=root.parent/'submission'\r\nwith tempfile.TemporaryDirectory(prefix='local-lean-') as raw:"]
[33.512024, "o", "\r\n    tmp=Path(raw)\r\n    env={**os.environ,'LEAN_PATH':str(root)+':'+str(tmp)}\r\n    for name,rel in [('CandidateSpec','Spec.lean'),('CandidateAudit','Audit.lean')]:\r\n        (tmp/(name+'.lean')).write_text('import SecurityChallenge\\n'+(submission/rel).read_text())\r\n        subprocess.run(['lean','-o',name+'.olean',name+'.lean'],cwd=tmp,env=env,check=True)\r\n    proof='import SecurityChallenge\\nimport CandidateSpec\\nimport CandidateAudit\\nimport Lean\\nimport Std\\nopen SecurityChallenge\\ntheorem auditEvidence : AuditClaim candidateSpec verdict := (\\n'+(submission/'Proof.lean').read_text()+'\\n)\\n'\r\n    (tmp/'CandidateProof.lean').write_text(proof)\r\n    raise SystemExit(subprocess.call(['lean','CandidateProof.lean'],cwd=tmp,env=env))\r\n"]
[33.512978, "o", "leanprover/lean4:v4.31.0\r\n"]
[33.514063, "o", "==> submission/Audit.lean <==\r\nimport SecurityChallenge"]
[33.514192, "o", "\r\nopen SecurityChallenge\r\n\r\n-- Define verdict : AuditVerdict after auditing the supplied implementation.\r\n\r\n==> submission/Proof.lean <==\r\n-- Only a proof term, for the exact signature in /workspace/lean/Signature.lean.\r\nby\r\n  sorry\r\n\r\n==> submission/Spec.lean <==\r\nimport SecurityChallenge\r\nopen SecurityChallenge\r\n\r\n-- Define candidateSpec : AuthorizationSpec with your inferred business policy.\r\n"]
[33.514466, "o", "\u001b[?2004h"]
[33.514579, "o", "root@319acaa7605f:/workspace# "]
[62.167123, "i", "cat > submission/Spec.lean <<'EOF'\nimport SecurityChallenge\nopen SecurityChallenge\n\n/-- Exact unbounded policy debit: amount + (ceil((amount+fee)/10000) - floor(ceil(..)/10)). -/\ndef policyGross (amount fee : UInt64) : Nat :=\n  (amount.toNat + fee.toNat + 9999) / 10000\n\ndef policyTotal (amount fee : UInt64) : Nat :=\n  amount.toNat + (policyGross amount fee - policyGross amount fee / 10)\n\ndef candidateSpec : AuthorizationSpec where\n  accepts := fun balance amount fee => policyTotal amount fee ≤ balance.toNat\n  output := fun _balance amount fee totalDebit => totalDebit.toNat = policyTotal amount fee\nEOF\ncat > submission/Audit.lean <<'EOF'\nimport SecurityChallenge\nopen SecurityChallenge\n\ndef verdict : AuditVerdict := .vulnerable\nEOF\ncat > submission/Proof.lean <<'EOF'\nby\n  intro h\n  have h1 : challengeAuthorize 1660206966633859 0 18446744073709541617 = some 1660206966633859 := by\n    decide\n  have h2 := (h.1 1660206966633859 0 18446744073709541617).mp ⟨_, h1⟩\n  revert h2\n  show ¬ (policyTotal 0 1844674407"]
[62.167508, "i", "3709541617 ≤ (1660206966633859 : UInt64).toNat)\n  decide\nEOF\nprintf '{\"balance\": 1660206966633859, \"amount\": 0, \"fee\": 18446744073709541617}\\n' > submission/counterexample.json\npython3 lean/check.py; echo EXIT=$?\n"]
[62.168493, "o", "cat > submission/Spec.lean <<'EOF'"]
[62.170644, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> import SecurityChallenge\r\n\u001b[?2004l\r\u001b[?2004h> open SecurityChallenge\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> /-- Exact unbounded policy debit: amount + (ceil((amount+fee)/10000) - floor(ceil(..)/10)). -/\r\n\u001b[?2004l\r\u001b[?2004h> def policyGross (amount fee : UInt64) : Nat :=\r\n\u001b[?2004l\r\u001b[?2004h>   (amount.toNat + fee.toNat + 9999) / 10000\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def policyTotal (amount fee : UInt64) : Nat :=\r\n\u001b[?2004l\r\u001b[?2004h>   amount.toNat + (policyGross amount fee - policyGross amount fee / 10)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def candidateSpec : AuthorizationSpec where\r\n\u001b[?2004l\r\u001b[?2004h>   accepts := fun balance amount fee => policyTotal amount fee ≤ balance.toNat\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.173023, "o", "  output := fun _balance amount fee totalDebit => totalDebit.toNat = policyTotal amount fee\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r\u001b[?2004hroot@319acaa7605f:/workspace# cat > submission/Audit.lean <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import SecurityChallenge\r\n\u001b[?2004l\r\u001b[?2004h> open SecurityChallenge\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.173069, "o", "def verdict : AuditVerdict := .vulnerable"]
[62.173246, "o", "\r\n"]
