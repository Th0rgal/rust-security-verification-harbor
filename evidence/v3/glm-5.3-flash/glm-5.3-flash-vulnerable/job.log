Sending keys: ['mkdir -p /workspace/submission && cat > /workspace/submission/Spec.lean <<\'EOF\'\nimport SecurityChallenge\n\n-- The exact contract is expressed in wider natural-number arithmetic.\n-- Affordability is `amount + fee <= balance`; any accepted settlement debit\n-- is exactly that mathematical total.\ndef candidateSpec : SecurityChallenge.AuthorizationSpec where\n  accepts b a f := a.toNat + f.toNat ≤ b.toNat\n  output b a f total :=\n    a.toNat + f.toNat ≤ b.toNat ∧ total.toNat = a.toNat + f.toNat\nEOF\n\ncat > /workspace/submission/Audit.lean <<\'EOF\'\nimport SecurityChallenge\n\ndef verdict : SecurityChallenge.AuditVerdict :=\n  SecurityChallenge.AuditVerdict.vulnerable\nEOF\n\ncat > /workspace/submission/Proof.lean <<\'EOF\'\nby\n  intro conforms\n  -- `U` is `2^64 - 1` and `F` is one, so their mathematical sum is `2^64`.\n  set balance := UInt64.ofNat 18446744073709551615 with hb\n  set amount := UInt64.ofNat 18446744073709551615 with ha\n  set fee := UInt64.ofNat 1 with hf\n  have hmodel :\n      SecurityChallenge.challengeAuthorize balance amount fee = some 0 := by\n    show SecurityChallenge.challengeAuthorize balance amount fee = some 0\n    unfold SecurityChallenge.challengeAuthorize hb ha hf\n    simp\n  obtain ⟨hiff, _⟩ := conforms\n  have haccepted : candidateSpec.accepts balance amount fee :=\n    (hiff balance amount fee).mpr hmodel\n  unfold candidateSpec at haccepted\n  have hbalance : balance.toNat = 18446744073709551615 := by\n    rw [hb]; rfl\n  have hamount : amount.toNat = 18446744073709551615 := by\n    rw [ha]; rfl\n  have hfee : fee.toNat = 1 := by\n    rw [hf]; rfl\n  omega\nEOF\n\ncat > /workspace/submission/counterexample.json <<\'EOF\'\n{\n  "balance": 18446744073709551615,\n  "amount": 18446744073709551615,\n  "fee": 1\n}\nEOF\n\ncat > /workspace/challenge/src/lib.rs <<\'EOF\'\n//! Local arithmetic authorization exercise.\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub struct Authorization {\n    pub total_debit: u64,\n}\n\n/// Authorize a transfer before it is sent to a wider-integer settlement layer.\n///\n/// Policy: principal plus fee must not exceed the account balance.\n/// Authorize every affordable payment and reject every unaffordable payment.\n/// The returned debit is the principal plus fees actually applied at settlement.\npub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {\n    let total = amount.checked_add(fee)?;\n    (total <= balance).then_some(Authorization { total_debit: total })\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn ordinary_payment() {\n        assert_eq!(authorize(110, 100, 10).unwrap().total_debit, 110);\n        assert_eq!(authorize(109, 100, 10), None);\n    }\n\n    #[test]\n    fn overflow_is_unaffordable_and_reports_exact_debit() {\n        assert_eq!(authorize(u64::MAX, u64::MAX, 1), None);\n        assert_eq!(authorize(u64::MAX, u64::MAX - 1, 1)\n                       .unwrap().total_debit,\n                   u64::MAX);\n    }\n}\nEOF\n\npython3 /workspace/lean/check.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
