[75.151539, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[75.151571, "o", "> "]
[75.15181, "o", "/// Authorize a transfer before it is sent to a wider-integer settlement layer.\r\n\u001b[?2004l\r"]
[75.151853, "o", "\u001b[?2004h"]
[75.151887, "o", "> ///\r\n\u001b[?2004l\r"]
[75.151919, "o", "\u001b[?2004h> "]
[75.152136, "o", "/// Policy: principal plus fee must not exceed the account balance.\r\n\u001b[?2004l\r"]
[75.152178, "o", "\u001b[?2004h> "]
[75.152459, "o", "/// Authorize every affordable payment and reject every unaffordable payment.\r\n\u001b[?2004l\r"]
[75.152501, "o", "\u001b[?2004h> "]
[75.152768, "o", "/// The returned debit is the principal plus fees actually applied at settlement.\r\n\u001b[?2004l\r"]
[75.15281, "o", "\u001b[?2004h> "]
[75.153116, "o", "pub fn authorize(balance: u64, amount: u64, fee: u64) -> Option<Authorization> {\r\n\u001b[?2004l\r"]
[75.153162, "o", "\u001b[?2004h> "]
[75.153316, "o", "    let total = amount.checked_add(fee)?;\r\n\u001b[?2004l\r"]
[75.153359, "o", "\u001b[?2004h> "]
[75.1536, "o", "    (total <= balance).then_some(Authorization { total_debit: total })\r\n\u001b[?2004l\r"]
[75.153644, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[75.153682, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[75.153726, "o", "\u001b[?2004h> "]
[75.153776, "o", "#[cfg(test)]\r\n\u001b[?2004l\r"]
[75.153811, "o", "\u001b[?2004h> "]
[75.153867, "o", "mod tests {\r\n\u001b[?2004l\r"]
[75.153905, "o", "\u001b[?2004h> "]
[75.153971, "o", "    use super::*;\r\n\u001b[?2004l\r"]
[75.154008, "o", "\u001b[?2004h> "]
[75.154046, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.154083, "o", "> "]
[75.154114, "o", "    #[test]\r\n\u001b[?2004l\r"]
[75.154164, "o", "\u001b[?2004h> "]
[75.154256, "o", "    fn ordinary_payment() {\r\n\u001b[?2004l\r"]
[75.154291, "o", "\u001b[?2004h> "]
[75.15452, "o", "        assert_eq!(authorize(110, 100, 10).unwrap().total_debit, 110);\r\n\u001b[?2004l\r"]
[75.154562, "o", "\u001b[?2004h> "]
[75.154723, "o", "        assert_eq!(authorize(109, 100, 10), None);\r\n\u001b[?2004l\r"]
[75.154759, "o", "\u001b[?2004h> "]
[75.154801, "o", "    }\r\n\u001b[?2004l\r"]
[75.154853, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[75.154891, "o", "> "]
[75.154925, "o", "    #[test]\r\n\u001b[?2004l\r"]
[75.154955, "o", "\u001b[?2004h"]
[75.154984, "o", "> "]
[75.155167, "o", "    fn overflow_is_unaffordable_and_reports_exact_debit() {\r\n\u001b[?2004l\r"]
[75.155244, "o", "\u001b[?2004h> "]
[75.155465, "o", "        assert_eq!(authorize(u64::MAX, u64::MAX, 1), None);\r\n\u001b[?2004l\r"]
[75.155542, "o", "\u001b[?2004h> "]
[75.155732, "o", "        assert_eq!(authorize(u64::MAX, u64::MAX - 1, 1)\r\n\u001b[?2004l\r"]
[75.15581, "o", "\u001b[?2004h> "]
[75.155975, "o", "                       .unwrap().total_debit,\r\n\u001b[?2004l\r"]
[75.156014, "o", "\u001b[?2004h> "]
[75.156179, "o", "                   u64::MAX);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.156239, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.156276, "o", "> }\r\n\u001b[?2004l\r"]
[75.156341, "o", "\u001b[?2004h> "]
[75.156395, "o", "EOF\r\n\u001b[?2004l\r"]
