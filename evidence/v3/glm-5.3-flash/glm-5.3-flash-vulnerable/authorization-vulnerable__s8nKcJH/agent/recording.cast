[75.151056, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.151189, "o", "#[derive(Debug, Clone, Copy, PartialEq, Eq)]\r\n\u001b[?2004l\r"]
[75.151227, "o", "\u001b[?2004h"]
[75.151265, "o", "> "]
[75.151315, "o", "pub struct Authorization {\r\n\u001b[?2004l\r"]
