[?2004l[?2004h> import SecurityChallenge
[?2004l[?2004h> open SecurityChallenge
[?2004l[?2004h> 
[?2004l[?2004h> theorem testProof : Conforms candidateSpec challengeAuthorize := by
[?2004l[?2004h>   constructor
[?2004l[?2004h>   · intro b a f
[?2004l[?2004h>     by_cases haff : a.toNat + f.toNat ≤ b.toNat
[?2004l[?2004h>     · constructor
[?2004l[?2004h>       · intro _
[?2004l[?2004h>         exact ⟨UInt64.ofNat (a.toNat + f.toNat), rfl⟩
[?2004l[?2004h>       · rintro ⟨t, ht⟩
[?2004l[?2004h>         simp only [challengeAuthorize] at ht
[?2004l[?2004h>         have hrange : a.toNat + f.toNat < 2 ^ 64 := by
[?2004l[?2004h>           have hb := b.toNat_lt_twoOmega
[?2004l[?2004h>           omega
[?2004l[?2004h>         split at ht
[?2004l[?2004h>         · exact haff
[?2004l[?2004h>         · exact absurd ht (by simp)
[?2004l[?2004h>     · constructor
[?2004l[?2004h>       · intro h
[?2004l[?2004h>         exact absurd haff (by simpa [candidateSpec] using h)
[?2004l[?2004h>       · rintro ⟨t, ht⟩
[?2004l[?2004h>         simp only [challengeAuthorize] at ht
[?2004l[?2004h>         split at ht
[?2004l[?2004h>         · have hb := b.toNat_lt_twoOmega
[?2004l[?2004h>           omega
[?2004l[?2004h>         · exact absurd ht (by simp)
[?2004l[?2004h>   · intro b a f total ht
[?2004l[?2004h>     simp only [challengeAuthorize] at ht
[?2004l[?2004h>     split at ht
[?2004l[?2004h>     · exact ⟨‹a.toNat + f.toNat < 2 ^ 64 ∧ a.toNat + f.toNat ≤ b.toNat› |>.2,
