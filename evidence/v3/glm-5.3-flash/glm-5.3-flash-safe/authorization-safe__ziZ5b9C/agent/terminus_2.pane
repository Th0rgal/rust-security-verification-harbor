[?2004l--- Spec.lean ---
import SecurityChallenge

open SecurityChallenge

def candidateSpec : AuthorizationSpec where
  accepts b a f :=
    a.toNat + f.toNat ≤ b.toNat
  output b a f t :=
    a.toNat + f.toNat ≤ b.toNat ∧ t.toNat = a.toNat + f.toNat
--- Audit.lean ---
import SecurityChallenge

open SecurityChallenge

def verdict : AuditVerdict := .safe
--- Proof.lean ---
by
  constructor
  · intro b a f
    have hb : b.toNat < 2 ^ 64 := b.toNat_lt_size
    have hsize : UInt64.size = 2 ^ 64 := rfl
    simp [challengeAuthorize, candidateSpec, hsize]
    omega
  · intro b a f total h
    simp only [challengeAuthorize] at h
    split at h
    · rename_i hcond
      refine ⟨hcond.2, ?_⟩
      cases h
      simpa using hcond.1
    · exact absurd h (by simp)
--- artifacts ---
Audit.lean
Proof.lean
Spec.lean
