{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["property", "arithmetic", "on_overflow"],
  "properties": {
    "property": {"type": "string", "description": "Invariant guaranteed whenever Some is returned"},
    "arithmetic": {"enum": ["rust_u64", "mathematical_unsigned"]},
    "on_overflow": {"enum": ["authorize_wrapped", "reject", "panic"]}
  },
  "additionalProperties": false
}
